	ВыборкаКоды = РезультатЗапросаКоды.Выбрать();
	
	МассивКиз = Новый Массив;
	
	Пока ВыборкаКоды.Следующий() Цикл
		СтруктураКиз = ПолучитьСтруктуруКиз(ВыборкаКоды);
		МассивКиз.Добавить(СтруктураКиз);
	КонецЦикла;
	
	Для Каждого Строка Из ДанныеКВыгрузке Цикл 
				
	    ЭлементМассива = НайтиКиз(МассивКиз, Строка);
		
		Если ЭлементМассива <> Неопределено Тогда
			
			Строка.ШтрихкодУпаковки = ЭлементМассива.ШтрихкодУпаковки;
			
			Если ЗначениеЗаполнено(ЭлементМассива.ЗначениеШтрихкода) Тогда
				
				КодМаркировки = ИС_MP_Маркировка.ПолучитьКизНоменклатуры(ЭлементМассива);     
				
				Строка.КодМаркировки = КодМаркировки;

			КонецЕсли;
			
			ЭлементМассива = МассивКиз.Найти(ЭлементМассива);
			МассивКиз.Удалить(ЭлементМассива);
		
		КонецЕсли;
		
	КонецЦикла;
		
КонецПроцедуры //- ИнфоСофт Сумин Д.В. 05.02.2024 УА #69650 

//+ ИнфоСофт Сумин Д.В. 05.02.2024 УА #69650
&НаСервере
Функция ПолучитьСтруктуруКиз(Выборка)  
	
	СтруктураКиз = Новый Структура;  
	
	СтруктураКиз.Вставить("ШтрихкодУпаковки", 	Выборка.ШтрихкодУпаковки);
	СтруктураКиз.Вставить("ЗначениеШтрихкода", 	Выборка.ЗначениеШтрихкода);
	СтруктураКиз.Вставить("Номенклатура", 		Выборка.Номенклатура);
	СтруктураКиз.Вставить("Характеристика",		Выборка.Характеристика);
	
	Возврат СтруктураКиз;
	
КонецФункции //- ИнфоСофт Сумин Д.В. 05.02.2024 УА #69650

//+ ИнфоСофт Сумин Д.В. 05.02.2024 УА #69650
&НаСервере
Функция НайтиКиз(МассивКиз, Строка)
	
	Результат = Неопределено;
	
	Для Каждого Элемент Из МассивКиз Цикл
				
		Если Элемент.Номенклатура = Строка.Номенклатура И Элемент.Характеристика = Строка.Характеристика Тогда  
			//+ ИнфоСофт Стояк Ю.К. 16.09.2024 УА #83542			
			Отбор = Новый Структура;
			Отбор.Вставить("ШтрихкодУпаковки", Элемент.ШтрихкодУпаковки); 
			
			НайденныеСтроки = ДанныеКВыгрузке.НайтиСтроки(Отбор);
			
			Если НайденныеСтроки.Количество() = 0 Тогда
				Возврат Элемент;
			КонецЕсли;
			
			Продолжить;
			//- ИнфоСофт Стояк Ю.К. 16.09.2024 УА #83542
			
		КонецЕсли;	
	
	КонецЦикла;	
	
	Возврат Результат;


КонецФункции //- ИнфоСофт Сумин Д.В. 05.02.2024 УА #69650	

