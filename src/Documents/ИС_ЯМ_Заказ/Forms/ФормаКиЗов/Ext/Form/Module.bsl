						//+ ИнфоСофт Власова И.С. 10.12.24 УА #85294
						//Если ВыборкаКиЗов.КодМаркировки <> "" Тогда
						Если ВыборкаКиЗов.ПолныйКодМаркировки <> "" Тогда
							
						    //+ ИнфоСофт Заварин К.В. 04.04.25 УА #95143
							//МассивCIS.Добавить(Новый Структура("cis", ВыборкаКиЗов.ПолныйКодМаркировки));
							КодМаркировкиGS1 = СтрЗаменить(ВыборкаКиЗов.ПолныйКодМаркировки, ЭкранированныйСимволGS1, РазделительGS1);
							МассивCIS.Добавить(Новый Структура("cis", КодМаркировкиGS1));
							//- ИнфоСофт Заварин К.В. 04.04.25 УА #95143
							
							СтруктураДанных.Вставить("instances", МассивCIS);
						ИначеЕсли ВыборкаКиЗов.КодМаркировки <> "" Тогда
						//- ИнфоСофт Власова И.С. 10.12.24 УА #85294
							МассивCIS.Добавить(Новый Структура("cis", ВыборкаКиЗов.КодМаркировки));
						КонецЕсли;
						//МассивCIS.Добавить(Новый Структура("cis", ВыборкаКиЗов.КодМаркировки));					
					КонецЕсли;
					//- ИнфоСофт Стояк Ю.К. 02.08.2024 УА #79514  				
				КонецЦикла;
				
				//+ ИнфоСофт Стояк Ю.К. 02.08.2024 УА #79514
				Если МассивCIS.Количество() <> 0 Тогда
					СтруктураДанных.Вставить("instances", МассивCIS);
				КонецЕсли;                                           
				//СтруктураДанных.Вставить("instances", МассивCIS); 
				Если СтруктураДанных.Свойство("id")Тогда            
					МассивItems.Добавить(СтруктураДанных);
				КонецЕсли;
				//МассивItems.Добавить(СтруктураДанных);
				
				
			КонецЦикла;
			
			СтруктураItems.items = МассивItems;
			МассивДанныхНаВыгрузку.Добавить(СтруктураItems);
			
			Для Каждого Элемент Из БуферДляВыгрузки Цикл
				
				СтруктураДанных = Новый Структура;					
				МассивCIS = Новый Массив;
				
				Для Итератор = Элемент.НомерЧасти + 1 По Элемент.ВсегоЧастей Цикл  
					СтруктураItems = Новый Структура("items", Неопределено);
					МассивItems = Новый Массив;
					
					СтруктураДанных.Вставить("id", Элемент.IDТовараВЗаказе); 
					
					partialCount = Новый Структура;
					partialCount.Вставить("current", Итератор);
					partialCount.Вставить("total", Элемент.ВсегоЧастей);
					
					СтруктураДанных.Вставить("partialCount", partialCount); 
					
					Если Элемент.КИЗ <> "" Тогда
						МассивCIS.Добавить(Новый Структура("cis", Элемент.КИЗ));							
						СтруктураДанных.Вставить("instances", МассивCIS);
					КонецЕсли;
					
					МассивItems.Добавить(СтруктураДанных);
					
					СтруктураItems.items = МассивItems;
					МассивДанныхНаВыгрузку.Добавить(СтруктураItems);
					
				КонецЦикла;
				
			КонецЦикла;
			
			
			//- ИнфоСофт Стояк Ю.К. 02.08.2024 УА #79514						
			
		КонецЦикла;
		
		//+ ИнфоСофт Стояк Ю.К. 05.08.2024 УА #7951		
		Результат = ИС_ЯМ_Сервер.ПрикрепитьКиз(Профиль, ВыборкаНомерОтправления.НомерОтправления, МассивДанныхНаВыгрузку);
		//Результат = ИС_ЯМ_Сервер.ПрикрепитьКиз(Профиль, ВыборкаНомерОтправления.НомерОтправления, МассивItems);
		//- ИнфоСофт Стояк Ю.К. 05.08.2024 УА #79514
		
		Если Результат = Неопределено Тогда
			Продолжить;
		Иначе
			
			Отбор = Новый Структура("НомерОтправления", ВыборкаНомерОтправления.НомерОтправления);
			НайденныеСтроки = ДанныеКВыгрузке.НайтиСтроки(Отбор);
			
			Для Каждого Строка Из НайденныеСтроки Цикл
				Строка.Выгружен = Истина;
				
				//+ ИнфоСофт Заварин К.В. 20.02.25 УА #73904
				
				МассивКодов = Новый Массив;
				
				МассивКодов.Добавить(Строка);
				
				ЗаказМП = Документы.ИС_ЯМ_Заказ.НайтиПоНомеру(ВыборкаНомерОтправления.НомерОтправления);
				ИС_MP_Сервер.ЗаписатьДанныеКИЗ(Профиль, Перечисления.ИС_МП_Маркетплейсы.ЯМ, ЗаказМП, МассивКодов); 	
				//- ИнфоСофт Заварин К.В. 20.02.25 УА #73904
				
			КонецЦикла;
				
		КонецЕсли;
	
	КонецЦикла;
		
КонецПроцедуры //- ИнфоСофт Ивонин К.А. 17.05.24 УА #75485

//+ ИнфоСофт Власова И.С. 10.12.24 УА #85294
//+ ИнфоСофт Заварин К.В. 04.04.25 УА #95143
//&НаСервере 
&НаКлиенте
 //- ИнфоСофт Заварин К.В. 04.04.25 УА #95143
Процедура ОбработатьШтрихкоды(Данные)
	
	СчитанныйШтрихкод = Данные.Штрихкод;
	
	РазделительGS1 = МенеджерОборудованияМаркировкаКлиентСервер.РазделительGS1();
    ЭкранированныйСимволGS1 = "\u001d";
	
	//+ ИнфоСофт Заварин К.В. 04.04.25 УА #95143
	//КодМаркировки = ИС_MP_Маркировка.ПолучитьКизНоменклатуры(СчитанныйШтрихкод);
	//- ИнфоСофт Заварин К.В. 04.04.25 УА #95143
	
    ПолныйКодМаркировки = СтрЗаменить(СчитанныйШтрихкод, РазделительGS1, ЭкранированныйСимволGS1);
	
	//+ ИнфоСофт Заварин К.В. 03.04.25 УА #95143
	ЭкранированныйСимволGS1 = "";
	КодМаркировки = СтрЗаменить(СчитанныйШтрихкод, РазделительGS1, ЭкранированныйСимволGS1);  	
		
	КодМаркировки = ОбработатьШтрихкодыНаСервере(КодМаркировки);
	//- ИнфоСофт Заварин К.В. 03.04.25 УА #95143
	
	Отбор = Новый Структура("КодМаркировки", КодМаркировки);
	НайденныеСтроки = ДанныеКВыгрузке.НайтиСтроки(Отбор);
	
	Для Каждого Строка Из НайденныеСтроки Цикл
		Строка.ПолныйКодМаркировки = ПолныйКодМаркировки;
	КонецЦикла;
	
КонецПроцедуры //- ИнфоСофт Власова И.С. 10.12.24 УА #85294

//+ ИнфоСофт Заварин К.В. 03.04.25 УА #95143
&НаСервере
Функция ОбработатьШтрихкодыНаСервере(ДанныеШтрихкода)
			
	Данные = Новый Структура; 
	
	Данные.Вставить("ЗначениеШтрихкода", ДанныеШтрихкода);
	
	КодМаркировки = ИС_MP_Маркировка.ПолучитьКизНоменклатуры(Данные);
	
	Возврат	КодМаркировки;  
	
КонецФункции //- ИнфоСофт Заварин К.В. 03.04.25 УА #95143


