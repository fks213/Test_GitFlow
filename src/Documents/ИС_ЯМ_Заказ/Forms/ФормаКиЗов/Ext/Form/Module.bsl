
#Область ОбработчикиСобытийФормы

//+ ИнфоСофт Ивонин К.А. 20.05.24 УА #75485
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Если Не Параметры.Свойство("Профиль") Тогда
		Возврат;
	КонецЕсли;
	
	Если Не Параметры.Свойство("СборочныеЗадания") Тогда
		Возврат;
	КонецЕсли;
	
	Профиль = Параметры.Профиль;
		
	ЗаполнитьДанныеКВыгрузке(Параметры.СборочныеЗадания);
	
	//+ ИнфоСофт Власова И.С. 10.12.24 УА #85294
	ОбщегоНазначенияУТ.НастроитьПодключаемоеОборудование(ЭтаФорма);
	//- ИнфоСофт Власова И.С. 10.12.24 УА #85294
	
КонецПроцедуры //- ИнфоСофт Ивонин К.А. 20.05.24 УА #75485 

//+ ИнфоСофт Власова И.С. 10.12.24 УА #85294
&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	ЭтаФорма.ИспользоватьПодключаемоеОборудование = Истина;
	МенеджерОборудованияКлиент.НачатьПодключениеОборудованиеПриОткрытииФормы(Неопределено, ЭтаФорма, "СканерШтрихкода");
	
КонецПроцедуры //- ИнфоСофт Власова И.С. 10.12.24 УА #85294

//+ ИнфоСофт Власова И.С. 10.12.24 УА #85294
&НаКлиенте
Процедура ПриЗакрытии(ЗавершениеРаботы)
	
	МенеджерОборудованияКлиент.НачатьОтключениеОборудованиеПриЗакрытииФормы(Неопределено, ЭтаФорма);
	
КонецПроцедуры //- ИнфоСофт Власова И.С. 10.12.24 УА #85294

//+ ИнфоСофт Власова И.С. 10.12.24 УА #85294
&НаКлиенте
Процедура ОбработкаОповещения(ИмяСобытия, Параметр, Источник)
	
	Если Источник = "ПодключаемоеОборудование" И ВводДоступен() Тогда
		Если ИмяСобытия = "ScanData" И МенеджерОборудованияУТКлиент.ЕстьНеобработанноеСобытие() Тогда
			СтруктураШтрихкод = МенеджерОборудованияУТКлиент.ПреобразоватьДанныеСоСканераВСтруктуру(Параметр);
			ОбработатьШтрихкоды(СтруктураШтрихкод);
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры //- ИнфоСофт Власова И.С. 10.12.24 УА #85294

#КонецОбласти

#Область ОбработчикиКомандФормы 

//+ ИнфоСофт Сумин Д.В. 05.02.2024 УА #69650
&НаКлиенте
Процедура ВыгрузитьКиЗы(Команда)
	
	ОчиститьСообщения();
	
	Если Не ЗначениеЗаполнено(Профиль) Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю("Не выбран профиль", , , "Профиль");
		Возврат;
	КонецЕсли;
	
	Если ДанныеКВыгрузке.Количество() = 0 Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю("Нет данных для выгрузки");
		Возврат;
	КонецЕсли;
	
	//+ ИнфоСофт Стояк Ю.К. 05.08.2024 УА #79514	
	//Для Каждого Строка Из ДанныеКВыгрузке Цикл
	//	Если Не ЗначениеЗаполнено(Строка.КодМаркировки) Тогда
	//		ОбщегоНазначенияКлиент.СообщитьПользователю(СтрШаблон("В строке заказа %1 не заполнен КиЗ", Строка.НомерОтправления));
	//		Возврат;
	//   	КонецЕсли;
	//КонецЦикла;                                 
	//- ИнфоСофт Стояк Ю.К. 05.08.2024 УА #79514
    
	ВыгрузитьКиЗыНаСервере();
	
КонецПроцедуры //- ИнфоСофт Сумин Д.В. 05.02.2024 УА #69650

#КонецОбласти

#Область СлужебныеПроцедурыИФункции 

//+ ИнфоСофт Сумин Д.В. 05.02.2024 УА #69650
&НаСервере
Процедура ЗаполнитьДанныеКВыгрузке(МассивЗаказов)
	
	//+ ИнфоСофт Заварин К.В. 23.09.24 УА #73485
	МассивСтатусов = Новый Массив;
	МассивСтатусов.Добавить(Перечисления.ИС_ЯМ_СтатусыЗаказов.PROCESSING); 
	МассивСтатусов.Добавить(Перечисления.ИС_ЯМ_СтатусыЗаказов.UNPAID); 
	МассивСтатусов.Добавить(Перечисления.ИС_ЯМ_СтатусыЗаказов.PLACING);
	МассивСтатусов.Добавить(Перечисления.ИС_ЯМ_СтатусыЗаказов.RESERVED); 
	МассивСтатусов.Добавить(Перечисления.ИС_ЯМ_СтатусыЗаказов.PENDING);
	МассивСтатусов.Добавить(Перечисления.ИС_ЯМ_СтатусыЗаказов.UNKNOWN);
	//- ИнфоСофт Заварин К.В. 23.09.24 УА #73485
	
	//Получим основные данные
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ИС_ЯМ_Заказ.Профиль КАК Профиль,
	|	ИС_ЯМ_Заказ.Номер КАК НомерОтправления,
	|	ИС_ЯМ_Заказ.Заказ КАК Заказ,
	|	ИС_ЯМ_Заказ.Ссылка КАК Ссылка,
	|	ИС_ЯМ_Заказitems.НоменклатураЯМ.shopSku КАК Sku,
	|	ИС_ЯМ_Заказitems.count КАК count,
	|	ИС_ЯМ_СоответствиеХарактеристик.Номенклатура КАК Номенклатура,
	|	ИС_ЯМ_СоответствиеХарактеристик.Характеристика КАК Характеристика,
	|	ИС_ЯМ_Заказitems.id КАК id
	|ПОМЕСТИТЬ ВТ_ОсновныеДанные
	|ИЗ
	|	Документ.ИС_ЯМ_Заказ КАК ИС_ЯМ_Заказ
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ИС_ЯМ_Заказ.items КАК ИС_ЯМ_Заказitems
	|			ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ИС_ЯМ_СоответствиеХарактеристик КАК ИС_ЯМ_СоответствиеХарактеристик
	|			ПО ИС_ЯМ_Заказitems.НоменклатураЯМ = ИС_ЯМ_СоответствиеХарактеристик.НоменклатураЯМ
	|		ПО ИС_ЯМ_Заказ.Ссылка = ИС_ЯМ_Заказitems.Ссылка
	//+ ИнфоСофт Заварин К.В. 23.09.24 УА #73485
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ИС_ЯМ_СтатусыСборочныхЗаданий КАК ИС_ЯМ_СтатусыСборочныхЗаданий
	|		ПО (ИС_ЯМ_СтатусыСборочныхЗаданий.Заказ = ИС_ЯМ_Заказ.Ссылка)
	//- ИнфоСофт Заварин К.В. 23.09.24 УА #73485
	|ГДЕ
	|	ИС_ЯМ_Заказ.Ссылка В(&МассивСсылок)
	//+ ИнфоСофт Заварин К.В. 23.09.24 УА #73485
	|	И ИС_ЯМ_СтатусыСборочныхЗаданий.status В(&МассивСтатусов)
	//- ИнфоСофт Заварин К.В. 23.09.24 УА #73485
	//+ ИнфоСофт Стояк Ю.К. 29.08.2024 УА #81381	
	//|	И НЕ ИС_ЯМ_СоответствиеХарактеристик.Номенклатура.ВидНоменклатуры.ОсобенностьУчета = ЗНАЧЕНИЕ(Перечисление.ОсобенностиУчетаНоменклатуры.БезОсобенностейУчета)
	//- ИнфоСофт Стояк Ю.К. 29.08.2024 УА #81381
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ИС_ЯМ_Заказitems.Ссылка КАК Ссылка,
	|	СУММА(ИС_ЯМ_Заказitems.count) КАК ВсегоТоваров
	|ПОМЕСТИТЬ ВТ_Количество
	|ИЗ
	|	Документ.ИС_ЯМ_Заказ.items КАК ИС_ЯМ_Заказitems
	//+ ИнфоСофт Заварин К.В. 23.09.24 УА #73485
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ИС_ЯМ_Заказ КАК ИС_ЯМ_Заказ
	|		ПО ИС_ЯМ_Заказitems.Ссылка = ИС_ЯМ_Заказ.Ссылка
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ИС_ЯМ_СтатусыСборочныхЗаданий КАК ИС_ЯМ_СтатусыСборочныхЗаданий
	|		ПО (ИС_ЯМ_СтатусыСборочныхЗаданий.Заказ = ИС_ЯМ_Заказ.Ссылка)
	//- ИнфоСофт Заварин К.В. 23.09.24 УА #73485
	|ГДЕ
	|	ИС_ЯМ_Заказitems.Ссылка В(&МассивСсылок)
	//+ ИнфоСофт Заварин К.В. 23.09.24 УА #73485
	|	И ИС_ЯМ_СтатусыСборочныхЗаданий.status В(&МассивСтатусов)
	//- ИнфоСофт Заварин К.В. 23.09.24 УА #73485
	|
	|СГРУППИРОВАТЬ ПО
	|	ИС_ЯМ_Заказitems.Ссылка
	|;
	|                                                                                
	//+ ИнфоСофт Стояк Ю.К. 29.08.2024 УА #81381	
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ИС_ЯМ_Заказitems.Ссылка КАК Ссылка,
	|	ИС_ЯМ_Заказitems.НоменклатураЯМ КАК НоменклатураЯМ,
	|	СУММА(ИС_ЯМ_Заказitems.count) КАК ВсегоПоАртикулу
	|ПОМЕСТИТЬ ВТ_КоличествоАртикул
	|ИЗ
	|	Документ.ИС_ЯМ_Заказ.items КАК ИС_ЯМ_Заказitems 
	//+ ИнфоСофт Заварин К.В. 23.09.24 УА #73485
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ИС_ЯМ_Заказ КАК ИС_ЯМ_Заказ
	|		ПО ИС_ЯМ_Заказitems.Ссылка = ИС_ЯМ_Заказ.Ссылка
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ИС_ЯМ_СтатусыСборочныхЗаданий КАК ИС_ЯМ_СтатусыСборочныхЗаданий
	|		ПО (ИС_ЯМ_СтатусыСборочныхЗаданий.Заказ = ИС_ЯМ_Заказ.Ссылка)
	//- ИнфоСофт Заварин К.В. 23.09.24 УА #73485
	|ГДЕ
	|	ИС_ЯМ_Заказitems.Ссылка В(&МассивСсылок) 
	//+ ИнфоСофт Заварин К.В. 23.09.24 УА #73485
	|	И ИС_ЯМ_СтатусыСборочныхЗаданий.status В(&МассивСтатусов)
	//- ИнфоСофт Заварин К.В. 23.09.24 УА #73485
	|
	|СГРУППИРОВАТЬ ПО
	|	ИС_ЯМ_Заказitems.Ссылка,
	|	ИС_ЯМ_Заказitems.НоменклатураЯМ
	|;
	|                                           
	//- ИнфоСофт Стояк Ю.К. 29.08.2024 УА #81381
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_ОсновныеДанные.Профиль КАК Профиль,
	|	ВТ_ОсновныеДанные.НомерОтправления КАК НомерОтправления,
	|	ВТ_ОсновныеДанные.Заказ КАК Заказ,
	|	ВТ_ОсновныеДанные.Ссылка КАК Ссылка,
	|	ВТ_ОсновныеДанные.Sku КАК Sku,
	|	ВТ_ОсновныеДанные.count КАК count,
	//+ ИнфоСофт Стояк Ю.К. 29.08.2024 УА #81381
	|	ВТ_КоличествоАртикул.ВсегоПоАртикулу КАК ВсегоПоАртикулу,
	//- ИнфоСофт Стояк Ю.К. 29.08.2024 УА #81381
	|	ВТ_ОсновныеДанные.Номенклатура КАК Номенклатура,
	|	ВТ_ОсновныеДанные.Характеристика КАК Характеристика, 
	|	ВТ_ОсновныеДанные.id КАК IDТовараВЗаказе,
	|	ВТ_Количество.ВсегоТоваров КАК ВсегоТоваровВЗаказе
	|ИЗ
	|	ВТ_ОсновныеДанные КАК ВТ_ОсновныеДанные
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_Количество КАК ВТ_Количество
	|		ПО ВТ_ОсновныеДанные.Ссылка = ВТ_Количество.Ссылка
	//+ ИнфоСофт Стояк Ю.К. 29.08.2024 УА #81381	
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_КоличествоАртикул КАК ВТ_КоличествоАртикул
	|		ПО ВТ_ОсновныеДанные.Ссылка = ВТ_КоличествоАртикул.Ссылка
	|			И ВТ_ОсновныеДанные.Sku = ВТ_КоличествоАртикул.НоменклатураЯМ.shopSku";
	//- ИнфоСофт Стояк Ю.К. 29.08.2024 УА #81381
	
	Запрос.УстановитьПараметр("МассивСсылок", МассивЗаказов);
	
	//+ ИнфоСофт Заварин К.В. 23.09.24 УА #73485
	Запрос.УстановитьПараметр("МассивСтатусов", МассивСтатусов);
	//- ИнфоСофт Заварин К.В. 23.09.24 УА #73485
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Выборка = РезультатЗапроса.Выбрать();
	
	Пока Выборка.Следующий() Цикл	
	
		Итератор = 0;
		Пока Выборка.count > Итератор Цикл  
	
			НоваяСтрока = ДанныеКВыгрузке.Добавить();
			//+ ИнфоСофт Стояк Ю.К. 02.08.2024 УА #79514
			НоваяСтрока.КоличествоКоробок = 1;
			НоваяСтрока.IDКоробки = 1;
			//- ИнфоСофт Стояк Ю.К. 02.08.2024 УА #79514
			ЗаполнитьЗначенияСвойств(НоваяСтрока, Выборка);
			Итератор = Итератор + 1;
	
		КонецЦикла;
	
	КонецЦикла;
	
	//Получим Коды маркировки. Учтена функциональность пакетного создания реализаций, поэтому данные по Киз получаем в отдельном запросе	
	ЗапросКоды = Новый Запрос;

	//+ ИнфоСофт Заварин К.В. 03.02.25 УА #92764
	//+ ИнфоСофт Ивонин К.А. 04.02.25 УА #92887
	//Если ИС_MP_Сервер.ПолучитьВерсиюБезРедакции() >= "5.19.44" Тогда
	ВерсияБезРедации = ИС_МП_Сервер.ВерсияБезРедакции();
	
	Если ОбщегоНазначенияКлиентСервер.СравнитьВерсииБезНомераСборки(ВерсияБезРедации, "5.19.44") >= 0 Тогда
	//- ИнфоСофт Ивонин К.А. 04.02.25 УА #92887
		
		ЗапросКоды.Текст = 
		"ВЫБРАТЬ
		|	РеализацияТоваровУслугТовары.Номенклатура КАК Номенклатура,
		|	РеализацияТоваровУслугТовары.Характеристика КАК Характеристика,
		|	РеализацияТоваровУслугТовары.Ссылка КАК Реализация
		|ПОМЕСТИТЬ ВТ_РТУ
		|ИЗ
		|	Документ.ИС_ЯМ_Заказ КАК ИС_ЯМ_Заказ
		|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.РеализацияТоваровУслуг.Товары КАК РеализацияТоваровУслугТовары
		|		ПО (ИС_ЯМ_Заказ.Заказ = РеализацияТоваровУслугТовары.ЗаказКлиента)
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ИС_ЯМ_СтатусыСборочныхЗаданий КАК ИС_ЯМ_СтатусыСборочныхЗаданий
		|		ПО (ИС_ЯМ_СтатусыСборочныхЗаданий.Заказ = ИС_ЯМ_Заказ.Ссылка)
		|ГДЕ
		|	ИС_ЯМ_Заказ.Ссылка В(&МассивСсылок)
		|	И ИС_ЯМ_СтатусыСборочныхЗаданий.status В(&МассивСтатусов)
		|	И НЕ РеализацияТоваровУслугТовары.Ссылка ЕСТЬ NULL
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	ПередачаТоваровХранителюТовары.Номенклатура,
		|	ПередачаТоваровХранителюТовары.Характеристика,
		|	ПередачаТоваровХранителюТовары.Ссылка
		|ИЗ
		|	Документ.ИС_ЯМ_Заказ КАК ИС_ЯМ_Заказ
		|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ПередачаТоваровХранителю.Товары КАК ПередачаТоваровХранителюТовары
		|		ПО ИС_ЯМ_Заказ.Заказ = ПередачаТоваровХранителюТовары.ЗаказКлиента
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ИС_ЯМ_СтатусыСборочныхЗаданий КАК ИС_ЯМ_СтатусыСборочныхЗаданий
		|		ПО (ИС_ЯМ_СтатусыСборочныхЗаданий.Заказ = ИС_ЯМ_Заказ.Ссылка)
		|ГДЕ
		|	ИС_ЯМ_Заказ.Ссылка В(&МассивСсылок)
		|	И ИС_ЯМ_СтатусыСборочныхЗаданий.status В(&МассивСтатусов)
		|	И НЕ ПередачаТоваровХранителюТовары.Ссылка ЕСТЬ NULL
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	РеализацияТоваровУслугШтрихкодыУпаковок.ШтрихкодУпаковки КАК ШтрихкодУпаковки,
		|	РеализацияТоваровУслугШтрихкодыУпаковок.ШтрихкодУпаковки.ЗначениеШтрихкода КАК ЗначениеШтрихкода,
		|	РеализацияТоваровУслугШтрихкодыУпаковок.ШтрихкодУпаковки.Номенклатура КАК Номенклатура,
		|	РеализацияТоваровУслугШтрихкодыУпаковок.ШтрихкодУпаковки.Характеристика КАК Характеристика
		|ИЗ
		|	ВТ_РТУ КАК ВТ_РТУ
		|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.РеализацияТоваровУслуг.ШтрихкодыУпаковок КАК РеализацияТоваровУслугШтрихкодыУпаковок
		|		ПО ВТ_РТУ.Реализация = РеализацияТоваровУслугШтрихкодыУпаковок.Ссылка
		|			И ВТ_РТУ.Номенклатура = РеализацияТоваровУслугШтрихкодыУпаковок.ШтрихкодУпаковки.Номенклатура
		|			И ВТ_РТУ.Характеристика = РеализацияТоваровУслугШтрихкодыУпаковок.ШтрихкодУпаковки.Характеристика
		|ГДЕ
		|	НЕ РеализацияТоваровУслугШтрихкодыУпаковок.ШтрихкодУпаковки ЕСТЬ NULL
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	ПередачаТоваровХранителюШтрихкодыУпаковок.ШтрихкодУпаковки,
		|	ПередачаТоваровХранителюШтрихкодыУпаковок.ШтрихкодУпаковки.ЗначениеШтрихкода,
		|	ПередачаТоваровХранителюШтрихкодыУпаковок.ШтрихкодУпаковки.Номенклатура,
		|	ПередачаТоваровХранителюШтрихкодыУпаковок.ШтрихкодУпаковки.Характеристика
		|ИЗ
		|	ВТ_РТУ КАК ВТ_РТУ
		|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ПередачаТоваровХранителю.ШтрихкодыУпаковок КАК ПередачаТоваровХранителюШтрихкодыУпаковок
		|		ПО ВТ_РТУ.Реализация = ПередачаТоваровХранителюШтрихкодыУпаковок.Ссылка
		|			И ВТ_РТУ.Номенклатура = ПередачаТоваровХранителюШтрихкодыУпаковок.ШтрихкодУпаковки.Номенклатура
		|			И ВТ_РТУ.Характеристика = ПередачаТоваровХранителюШтрихкодыУпаковок.ШтрихкодУпаковки.Характеристика
		|ГДЕ
		|	НЕ ПередачаТоваровХранителюШтрихкодыУпаковок.ШтрихкодУпаковки ЕСТЬ NULL";
	Иначе
		ЗапросКоды.Текст = 
		"ВЫБРАТЬ
		|	РеализацияТоваровУслугТовары.Номенклатура КАК Номенклатура,
		|	РеализацияТоваровУслугТовары.Характеристика КАК Характеристика,
		|	РеализацияТоваровУслугТовары.Ссылка КАК Реализация
		|ПОМЕСТИТЬ ВТ_РТУ
		|ИЗ
		|	Документ.ИС_ЯМ_Заказ КАК ИС_ЯМ_Заказ
		|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.РеализацияТоваровУслуг.Товары КАК РеализацияТоваровУслугТовары
		|		ПО (ИС_ЯМ_Заказ.Заказ = РеализацияТоваровУслугТовары.ЗаказКлиента) 
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ИС_ЯМ_СтатусыСборочныхЗаданий КАК ИС_ЯМ_СтатусыСборочныхЗаданий
		|		ПО (ИС_ЯМ_СтатусыСборочныхЗаданий.Заказ = ИС_ЯМ_Заказ.Ссылка)
		|ГДЕ
		|	ИС_ЯМ_Заказ.Ссылка В (&МассивСсылок)  
		|	И ИС_ЯМ_СтатусыСборочныхЗаданий.status В(&МассивСтатусов)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	РеализацияТоваровУслугШтрихкодыУпаковок.ШтрихкодУпаковки КАК ШтрихкодУпаковки,
		|	РеализацияТоваровУслугШтрихкодыУпаковок.ШтрихкодУпаковки.ЗначениеШтрихкода КАК ЗначениеШтрихкода,
		|	РеализацияТоваровУслугШтрихкодыУпаковок.ШтрихкодУпаковки.Номенклатура КАК Номенклатура,
		|	РеализацияТоваровУслугШтрихкодыУпаковок.ШтрихкодУпаковки.Характеристика КАК Характеристика
		|ИЗ
		|	ВТ_РТУ КАК ВТ_РТУ
		|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.РеализацияТоваровУслуг.ШтрихкодыУпаковок КАК РеализацияТоваровУслугШтрихкодыУпаковок
		|		ПО (ВТ_РТУ.Реализация = РеализацияТоваровУслугШтрихкодыУпаковок.Ссылка
		|				И ВТ_РТУ.Номенклатура = РеализацияТоваровУслугШтрихкодыУпаковок.ШтрихкодУпаковки.Номенклатура
		|				И ВТ_РТУ.Характеристика = РеализацияТоваровУслугШтрихкодыУпаковок.ШтрихкодУпаковки.Характеристика)";	
	КонецЕсли;
	//- ИнфоСофт Заварин К.В. 03.02.25 УА #92764
	
	ЗапросКоды.УстановитьПараметр("МассивСсылок", МассивЗаказов); 
	
