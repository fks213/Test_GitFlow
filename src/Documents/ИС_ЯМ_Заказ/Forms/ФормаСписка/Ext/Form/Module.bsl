	ПараметрыФормы.Вставить("СборочныеЗадания", ВыделенныеСтроки);
	
	ОткрытьФорму("Документ.ИС_ЯМ_Заказ.Форма.ФормаКиЗов", ПараметрыФормы, ЭтотОбъект);  
	
