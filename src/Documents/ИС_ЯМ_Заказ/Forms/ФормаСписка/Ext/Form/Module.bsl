//+ ИнфоСофт Стояк Ю.К. 21.03.2023 УА #54628
&НаКлиенте
Процедура ПечатьЭтикеток(Команда)
	
	ВыделенныеСтроки = Элементы.Список.ВыделенныеСтроки;
	МассивФайлов = ПечатьЭтикетокНаСервере(ВыделенныеСтроки); 
	
	Если Не ЗначениеЗаполнено(МассивФайлов) Тогда
		Возврат;
	КонецЕсли;
	
	ИмяКаталогаВременныхФайлов = КаталогВременныхФайлов();  
	
	ИндексФайла = 1;
	
	Для Каждого Файл Из МассивФайлов Цикл                                                          
		
		Если Файл = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		ИмяВременногоФайла = ИмяКаталогаВременныхФайлов + Строка(ИндексФайла) + "stickersFile.pdf";
		ИндексФайла = ИндексФайла + 1;
		Файл.Записать(ИмяВременногоФайла);
		
		НачатьЗапускПриложения(Новый ОписаниеОповещения, ИмяВременногоФайла);
		
	КонецЦикла;
	
КонецПроцедуры //- ИнфоСофт Стояк Ю.К. 21.03.2023 УА #54628

