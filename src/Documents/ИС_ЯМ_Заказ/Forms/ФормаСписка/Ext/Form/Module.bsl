//+ ИнфоСофт Конышев А.Е. 12.12.24 УА #78004
&НаКлиенте
Процедура УстановитьОтборыОтправлений()
    
    ВсеОтправления = Ложь;
	ВидимостьПечатьЭтикеток = Ложь;
	ВидимостьПрикрепитьКИЗ = Ложь;
	ВидимостьУпаковкаТоваров = Ложь;
	
	Статусы = Новый Массив;

	Если ОтборОтправлений = "В ожидании" Тогда                                                  		

		Статусы.Добавить(ПредопределенноеЗначение("Перечисление.ИС_ЯМ_СтатусыЗаказов.PENDING"));
		
	ИначеЕсли ОтборОтправлений = "Не оплачен" Тогда
		
		Статусы.Добавить(ПредопределенноеЗначение("Перечисление.ИС_ЯМ_СтатусыЗаказов.UNPAID"));	
		
	ИначеЕсли ОтборОтправлений = "Размещен" Тогда
		
		Статусы.Добавить(ПредопределенноеЗначение("Перечисление.ИС_ЯМ_СтатусыЗаказов.PLACING"));
		
		ВидимостьПечатьЭтикеток = Истина;
		ВидимостьПрикрепитьКИЗ = Истина;
		ВидимостьУпаковкаТоваров = Истина;
		
	ИначеЕсли ОтборОтправлений = "Зарезервирован" Тогда
		
		Статусы.Добавить(ПредопределенноеЗначение("Перечисление.ИС_ЯМ_СтатусыЗаказов.RESERVED"));
		
		ВидимостьПечатьЭтикеток = Истина;
		ВидимостьПрикрепитьКИЗ = Истина;
		ВидимостьУпаковкаТоваров = Истина;
		
	ИначеЕсли ОтборОтправлений = "В процессе" Тогда
		
		Статусы.Добавить(ПредопределенноеЗначение("Перечисление.ИС_ЯМ_СтатусыЗаказов.PROCESSING"));
				
		ВидимостьПечатьЭтикеток = Истина;
		ВидимостьПрикрепитьКИЗ = Истина;
		ВидимостьУпаковкаТоваров = Истина;
					
	ИначеЕсли ОтборОтправлений = "В доставке" Тогда
			
		Статусы.Добавить(ПредопределенноеЗначение("Перечисление.ИС_ЯМ_СтатусыЗаказов.DELIVERY"));
		Статусы.Добавить(ПредопределенноеЗначение("Перечисление.ИС_ЯМ_СтатусыЗаказов.PICKUP"));
						
	ИначеЕсли ОтборОтправлений = "Доставлены" Тогда
			
		Статусы.Добавить(ПредопределенноеЗначение("Перечисление.ИС_ЯМ_СтатусыЗаказов.DELIVERED"));
		
	ИначеЕсли ОтборОтправлений = "Возвращены" Тогда
		
		Статусы.Добавить(ПредопределенноеЗначение("Перечисление.ИС_ЯМ_СтатусыЗаказов.RETURNED"));
		Статусы.Добавить(ПредопределенноеЗначение("Перечисление.ИС_ЯМ_СтатусыЗаказов.PARTIALLY_RETURNED"));	
				
	ИначеЕсли ОтборОтправлений = "Отменены" Тогда
		
		Статусы.Добавить(ПредопределенноеЗначение("Перечисление.ИС_ЯМ_СтатусыЗаказов.CANCELLED")); 
		Статусы.Добавить(ПредопределенноеЗначение("Перечисление.ИС_ЯМ_СтатусыЗаказов.CANCELLED_WITHOUT_REFUND"));
		
	ИначеЕсли ОтборОтправлений = "Спорные" Тогда
		
		Статусы.Добавить(ПредопределенноеЗначение("Перечисление.ИС_ЯМ_СтатусыЗаказов.REJECTED"));		
		Статусы.Добавить(ПредопределенноеЗначение("Перечисление.ИС_ЯМ_СтатусыЗаказов.UNKNOWN"));
				
	Иначе // Все
	
		ВсеОтправления = Истина;
		Статусы.Добавить(ПредопределенноеЗначение("Перечисление.ИС_ЯМ_СтатусыЗаказов.ПустаяСсылка")); 
		ВидимостьПечатьЭтикеток = Истина;
		ВидимостьПрикрепитьКИЗ = Истина;
		ВидимостьУпаковкаТоваров = Истина;
		
	КонецЕсли;
	
	Список.Параметры.УстановитьЗначениеПараметра("ВсеОтправления", ВсеОтправления); 
	Список.Параметры.УстановитьЗначениеПараметра("Статусы", Статусы);
	Элементы.ПечатьЭтикеток.Видимость = ВидимостьПечатьЭтикеток;
	Элементы.ПрикрепитьКиз.Видимость = ВидимостьПрикрепитьКИЗ;
	Элементы.ОткрытьФормуСборкиЗаказов.Видимость = ВидимостьУпаковкаТоваров;
	
КонецПроцедуры //- ИнфоСофт Конышев А.Е. 12.12.24 УА #78004

