//+ ИнфоСофт Заварин К.В. 20.03.24 УА #66299
&НаКлиенте
Процедура ПечатьЛистаПодбора(Команда)
    
		ВыделенныеСтроки = Элементы.Список.ВыделенныеСтроки;
			
		Если ВыделенныеСтроки = Неопределено Или ВыделенныеСтроки.Количество() = 0 Тогда
			Возврат;
		КонецЕсли;
 	
	ТабДок = ПолучитьЛистПодбораНаСервере(ВыделенныеСтроки);
	КоллекцияПечатныхФорм = УправлениеПечатьюКлиент.НоваяКоллекцияПечатныхФорм("Лист Подбора Яндекс Маркет");
	
	КоллекцияПечатныхФорм[0].ТабличныйДокумент = ТабДок;
	КоллекцияПечатныхФорм[0].Экземпляров = 1;
	КоллекцияПечатныхФорм[0].СинонимМакета = "Лист Подбора Яндекс Маркет";
	
	УправлениеПечатьюКлиент.ПечатьДокументов(КоллекцияПечатныхФорм, Неопределено, ЭтотОбъект);

КонецПроцедуры //- ИнфоСофт Заварин К.В. 20.03.24 УА #66299

//+ ИнфоСофт Стояк Ю.К. 03.06.2024 УА #76167
&НаКлиенте
Процедура ОткрытьФормуСборкиЗаказов(Команда)
	
	ВыделенныеСтроки = Элементы.Список.ВыделенныеСтроки;
	
	ПараметрыОткрытия = Новый Структура;
	ПараметрыОткрытия.Вставить("Профиль", Профиль);
	
	Если ВыделенныеСтроки.Количество() <> 0 Тогда
		ПараметрыОткрытия.Вставить("ВыделенныеСтроки", ВыделенныеСтроки);
	КонецЕсли;
	
	//+ ИнфоСофт Янгиров Р.Р. 14.11.2024 УА #86762
	//Если в настройках маркетплейса Ozon установлен флаг РазнестиЗаказыНаКоличество, при создании документа "УпаковкаТоваров"
	//создается два документа, в один попадают заказы с единичным количеством позиций, в другой документ с множественным количеством.
	РазнестиЗаказыПоКоличеству = ПолучитьЗначениеПараметра();
	
	Если РазнестиЗаказыПоКоличеству Тогда
		ЭтоОшибка = ИзменитьСтатусыЗаказовЯМ();
		Если ЭтоОшибка Тогда 
			ВызватьИсключение НСтр("ru= 'Не найдены заказы с подходящими параметрами.Перепроверьте статус заказов, и дату их отгрузки'");
		Иначе                          		
			СоздатьДокументыУпаковкиТоваровЯМ(ПараметрыОткрытия);
		КонецЕсли;
	Иначе
		ОткрытьФорму("Документ.ИС_ЯМ_УпаковкаТоваров.Форма.ФормаДокумента", ПараметрыОткрытия, ЭтотОбъект);
	КонецЕсли;                                    
	//ОткрытьФорму("Документ.ИС_ЯМ_УпаковкаТоваров.Форма.ФормаДокумента", ПараметрыОткрытия, ЭтотОбъект);
	//- ИнфоСофт Янгиров Р.Р. 14.11.2024 УА #86762	
	
КонецПроцедуры //- ИнфоСофт Стояк Ю.К. 03.06.2024 УА #76167

