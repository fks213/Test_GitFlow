	КонецЕсли;
	
	ПометитьНаУдалениеПривязанныеДокументыНаСервере();
	Элементы.Список.Обновить();	
	
	ОбщегоНазначенияКлиент.СообщитьПользователю("Документы успешно помечены на удаление");

	
