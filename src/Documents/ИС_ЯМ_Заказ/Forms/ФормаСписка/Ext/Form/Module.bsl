//+ ИнфоСофт Сумин Д.В. 15.04.2023 УА #57537  
&Насервере
Функция ПолучитьДатуПоследнегоОтправленияНаСервере();
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	ИС_ЯМ_Заказ.Дата КАК Дата
	|ИЗ
	|	Документ.ИС_ЯМ_Заказ КАК ИС_ЯМ_Заказ
	|ГДЕ
	|	ИС_ЯМ_Заказ.Профиль = &Профиль
	|
	|УПОРЯДОЧИТЬ ПО
	|	Дата УБЫВ";
	
	Запрос.УстановитьПараметр("Профиль", Профиль);
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	ВыборкаДетальныеЗаписи.Следующий();

	ДатаНачала = ВыборкаДетальныеЗаписи.Дата;
		
	Если Не ЗначениеЗаполнено(ДатаНачала) Тогда
		ДатаНачала = НачалоДня(ТекущаяДатаСеанса());	
	КонецЕсли;
	
	Возврат ДатаНачала;
	
КонецФункции //- ИнфоСофт Сумин Д.В. 15.04.2023 УА #57537 	

