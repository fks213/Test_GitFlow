&НаСервере
Функция ПолучитьЛистПодбораНаСервере(ВыделенныеСтроки) 
	
	Табдок = Новый ТабличныйДокумент;
	
	Табдок.ИмяПараметровПечати = "ИС_ЯМ_ПечатьЛистаПодбора";
	ТабДок.ОриентацияСтраницы = ОриентацияСтраницы.Портрет;  
	ТабДок.АвтоМасштаб = Истина;
	
	ТабДок.ПолеСправа = 7;
	
	МакетОбработки = УправлениеПечатью.МакетПечатнойФормы("Документ.ИС_ЯМ_Заказ.ПФ_MXL_ЛистПодбора");	
		
	МассивЗначений = Новый Массив;	
	МассивЗначений.Добавить("ПечататьНомерСтроки");       	
	МассивЗначений.Добавить("ПечататьНомерСборочного");
	МассивЗначений.Добавить("ПечататьНомерЗаказа"); 
	МассивЗначений.Добавить("ПечататьНомерРеализации");   		
	МассивЗначений.Добавить("ПечататьНазвание");	    
	МассивЗначений.Добавить("ПечататьРазмер");	
	МассивЗначений.Добавить("ПечататьАртикулЯМ");
	МассивЗначений.Добавить("ПечататьАртикул1С");	
	МассивЗначений.Добавить("ПечататьШтрихкод");
	МассивЗначений.Добавить("ПечататьКоличество");   	
	МассивЗначений.Добавить("ПечататьФото");
	
	НастройкиПечати = ИС_МП_Печать.ПолучитьНастройкиПечатиЛистаПодбора(Профиль, МассивЗначений, Перечисления.ИС_МП_Маркетплейсы.ЯМ);	
	
	ОбластьШапка = МакетОбработки.ПолучитьОбласть("Шапка|ОсновнойЛист");
	ОбластьШапка.Параметры.Дата = ТекущаяДатаСеанса();
	ОбластьШапка.Параметры.Профиль = Профиль;		
	
	Если ЗначениеЗаполнено(СортировкаПечати) Тогда	
		ОбластьШапка.Параметры.Сорт = Элементы.СортировкаПечати.СписокВыбора.НайтиПоЗначению(СортировкаПечати).Представление;
	Иначе
		СортировкаПечати = "НомерЗадания";
		ОбластьШапка.Параметры.Сорт = Элементы.СортировкаПечати.СписокВыбора.НайтиПоЗначению(СортировкаПечати).Представление;
	КонецЕсли;                                  	
	
	Табдок.Вывести(ОбластьШапка);
	
	ИС_МП_Печать.ЗаполнитьШапкуТаблицыЛистаПодбора(Табдок, МакетОбработки, НастройкиПечати, МассивЗначений);	
	
	Запрос = Новый Запрос;
	Запрос.Текст =	
	"ВЫБРАТЬ
	|	ИС_ЯМ_Заказ.Ссылка КАК Ссылка,
	|	ПередачаТоваровХранителюТовары.Ссылка.Номер КАК НомерРеализации
	|ПОМЕСТИТЬ ВТ_РТУ
	|ИЗ
	|	Документ.ИС_ЯМ_Заказ КАК ИС_ЯМ_Заказ
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ПередачаТоваровХранителю.Товары КАК ПередачаТоваровХранителюТовары
	|		ПО (ИС_ЯМ_Заказ.Заказ = ПередачаТоваровХранителюТовары.ЗаказКлиента)
	|			И (НЕ ИС_ЯМ_Заказ.Заказ = ЗНАЧЕНИЕ(Документ.ЗаказКлиента.ПустаяСсылка))
	|ГДЕ
	|	НЕ ИС_ЯМ_Заказ.Заказ = ЗНАЧЕНИЕ(Документ.ЗаказКлиента.ПустаяСсылка)
	|	И НЕ ПередачаТоваровХранителюТовары.Ссылка ЕСТЬ NULL
	|	И ИС_ЯМ_Заказ.Ссылка В(&МассивСсылок)
	|
	|ОБЪЕДИНИТЬ
	|
	|ВЫБРАТЬ
	|	ИС_ЯМ_Заказ.Ссылка,
	|	РеализацияТоваровУслугТовары.Ссылка.Номер
	|ИЗ
	|	Документ.ИС_ЯМ_Заказ КАК ИС_ЯМ_Заказ
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.РеализацияТоваровУслуг.Товары КАК РеализацияТоваровУслугТовары
	|		ПО ИС_ЯМ_Заказ.Заказ = РеализацияТоваровУслугТовары.ЗаказКлиента
	|			И (НЕ ИС_ЯМ_Заказ.Заказ = ЗНАЧЕНИЕ(Документ.ЗаказКлиента.ПустаяСсылка))
	|ГДЕ
	|	НЕ ИС_ЯМ_Заказ.Заказ = ЗНАЧЕНИЕ(Документ.ЗаказКлиента.ПустаяСсылка)
	|	И НЕ РеализацияТоваровУслугТовары.Ссылка ЕСТЬ NULL
	|	И ИС_ЯМ_Заказ.Ссылка В(&МассивСсылок)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ИС_ЯМ_Заказitems.Ссылка.Номер КАК НомерЗадания,
	|	ИС_ЯМ_Заказitems.Ссылка.Дата КАК Дата,
	|	ИС_ЯМ_Заказitems.НоменклатураЯМ.Наименование КАК Наименование,
	|	ИС_ЯМ_СоответствиеХарактеристик.Характеристика КАК Размер,
	|	ЕСТЬNULL(ИС_ЯМ_СоответствиеХарактеристик.НоменклатураЯМ.shopSku, ""Отсутствует сопоставление"") КАК Артикул,
	|	ИС_ЯМ_Заказitems.ШтрихкодЯМ.Штрихкод КАК Штрихкод,
	|	ИС_ЯМ_СоответствиеХарактеристик.Номенклатура.ФайлКартинки КАК ФайлКартинки,
	|	ИС_ЯМ_СоответствиеХарактеристик.Номенклатура КАК Номенклатура,             	
	|	ИС_ЯМ_Заказitems.count КАК Количество,
	|	ИС_ЯМ_СоответствиеХарактеристик.Номенклатура.Артикул КАК НоменклатураАртикул,
	|	ИС_ЯМ_Заказitems.Ссылка.Заказ.Номер КАК НомерЗаказа,
	|	ВЫБОР
	|		КОГДА ИС_ЯМ_Заказitems.Ссылка.Заказ = ЗНАЧЕНИЕ(Документ.ЗаказКлиента.ПустаяСсылка)
	|			ТОГДА """"""""
	|		ИНАЧЕ МИНИМУМ(ВТ_РТУ.НомерРеализации)
	|	КОНЕЦ КАК НомерРеализации               	
	|ИЗ
	|	Документ.ИС_ЯМ_Заказ.items КАК ИС_ЯМ_Заказitems
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ИС_ЯМ_СоответствиеХарактеристик КАК ИС_ЯМ_СоответствиеХарактеристик
	|		ПО (ИС_ЯМ_Заказitems.НоменклатураЯМ.Ссылка = ИС_ЯМ_СоответствиеХарактеристик.НоменклатураЯМ.Ссылка)
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ИС_ЯМ_СтатусыСборочныхЗаданий КАК ИС_ЯМ_СтатусыСборочныхЗаданий
	|		ПО (ИС_ЯМ_Заказitems.Ссылка.Номер = ИС_ЯМ_СтатусыСборочныхЗаданий.Заказ.Номер)	
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_РТУ КАК ВТ_РТУ
	|		ПО ИС_ЯМ_Заказitems.Ссылка = ВТ_РТУ.Ссылка
	|ГДЕ
	|	ИС_ЯМ_Заказitems.Ссылка В (&МассивСсылок)
	|	И ИС_ЯМ_СтатусыСборочныхЗаданий.status <> ЗНАЧЕНИЕ(Перечисление.ИС_ЯМ_СтатусыЗаказов.CANCELLED)
	|	И ИС_ЯМ_СтатусыСборочныхЗаданий.status <> ЗНАЧЕНИЕ(Перечисление.ИС_ЯМ_СтатусыЗаказов.CANCELLED_WITHOUT_REFUND)
	|
	|СГРУППИРОВАТЬ ПО
	|	ИС_ЯМ_Заказitems.Ссылка.Номер,
	|	ИС_ЯМ_Заказitems.Ссылка.Дата,
	|	ИС_ЯМ_Заказitems.НоменклатураЯМ.Наименование,
	|	ИС_ЯМ_СоответствиеХарактеристик.Характеристика,
	|	ИС_ЯМ_Заказitems.ШтрихкодЯМ.Штрихкод,
	|	ИС_ЯМ_СоответствиеХарактеристик.Номенклатура.ФайлКартинки,
	|	ИС_ЯМ_СоответствиеХарактеристик.Номенклатура,	
	|	ИС_ЯМ_Заказitems.count,
	|	ИС_ЯМ_СоответствиеХарактеристик.Номенклатура.Артикул,
	|	ИС_ЯМ_Заказitems.Ссылка.Заказ.Номер,
	|	ЕСТЬNULL(ИС_ЯМ_СоответствиеХарактеристик.НоменклатураЯМ.shopSku, ""Отсутствует сопоставление""),
	|	ИС_ЯМ_Заказitems.Ссылка.Заказ           	
	|
	|УПОРЯДОЧИТЬ ПО
	|	%1";
		
	БуферСортировкаПечати = СортировкаПечати;  
	Если БуферСортировкаПечати = "Наименование" Тогда
		БуферСортировкаПечати = "Наименование, Размер";
	ИначеЕсли БуферСортировкаПечати = "SKU" Тогда		
		БуферСортировкаПечати = "Артикул";
	КонецЕсли;
	
	Запрос.Текст = СтрШаблон(Запрос.Текст, БуферСортировкаПечати);
	
	Запрос.УстановитьПараметр("МассивСсылок", ВыделенныеСтроки);

	РезультатЗапроса = Запрос.Выполнить();
	
	Если РезультатЗапроса.Пустой() Тогда
		ОбщегоНазначения.СообщитьПользователю("Не удалось сформировать лист подбора");
		Возврат Табдок;	
	КонецЕсли;
	
	Эталон = УправлениеПечатью.МакетПечатнойФормы("ОбщийМакет.ИС_МП_Эталон");
	
	КоличествоМиллиметровВПикселе = Эталон.Рисунки.Квадрат100Пикселей.Высота / 100;
	
	Выборка = РезультатЗапроса.Выбрать();
	
	ВысотаОбластей = Табдок.ВысотаТаблицы;
	
	Если ВыводитьКомплектующие Тогда
		
		Запрос = Новый Запрос;
		Запрос.Текст =	
		"ВЫБРАТЬ
		|	ВТ.НомерЗадания КАК НомерЗадания,
		|	ВТ.Номенклатура КАК Номенклатура,		
		|	ВТ.Размер КАК Размер,
		|	ВТ.Штрихкод КАК Штрихкод		
		|	ПОМЕСТИТЬ ВТ_Номенклатура
		|ИЗ
		|	&ВТ КАК ВТ
		|;
		|		
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ВТ_Номенклатура.НомерЗадания КАК НомерЗадания,
		|	ВТ_Номенклатура.Номенклатура КАК Номенклатура,		
		|	ВТ_Номенклатура.Размер КАК Размер,
		|	ВТ_Номенклатура.Штрихкод КАК Штрихкод,
		|	ВариантыКомплектацииНоменклатурыТовары.Номенклатура КАК НоменклатураНабора,
		|	ВариантыКомплектацииНоменклатурыТовары.Характеристика КАК ХарактеристикаНабора,
		|	ВариантыКомплектацииНоменклатурыТовары.КоличествоУпаковок КАК КоличествоУпаковок,
		|	ВариантыКомплектацииНоменклатурыТовары.Номенклатура.ФайлКартинки КАК ФайлКартинки,
		|	ВариантыКомплектацииНоменклатурыТовары.Номенклатура.Артикул КАК Артикул
		|ИЗ
		|	СоставНаборов.НоменклатураНабора <> ЗНАЧЕНИЕ(Справочник.Номенклатура.ПустаяСсылка)
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ВариантыКомплектацииНоменклатуры.Товары КАК ВариантыКомплектацииНоменклатурыТовары
		|		ПО ВТ_Номенклатура.Номенклатура = ВариантыКомплектацииНоменклатурыТовары.Ссылка.Владелец
		|			И ВТ_Номенклатура.Размер = ВариантыКомплектацииНоменклатурыТовары.Ссылка.Характеристика
		|ГДЕ
		|	ВариантыКомплектацииНоменклатурыТовары.Ссылка.Владелец <> ЗНАЧЕНИЕ(Справочник.Номенклатура.ПустаяСсылка)
		|
		|УПОРЯДОЧИТЬ ПО
		|	ВариантыКомплектацииНоменклатурыТовары.Номенклатура.Наименование";    
		
		Запрос.УстановитьПараметр("ВТ", РезультатЗапроса.Выгрузить());
		
		РезультатЗапроса = Запрос.Выполнить();
		
		ВыгрузкаНаборы = РезультатЗапроса.Выгрузить(); 
		
	КонецЕсли;
			
	НомерСтроки = 0;	
	
	Пока Выборка.Следующий() Цикл 
		
		ОбластьВыведена = Ложь; 
		
		Для Каждого Параметр Из МассивЗначений Цикл
			
			Если НастройкиПечати[Параметр] Тогда
				
				ОбластьСтроки = МакетОбработки.ПолучитьОбласть("ДанныеСтроки|" + Сред(Параметр, 9));
				
				ЗаполнитьЗначенияСвойств(ОбластьСтроки.Параметры, Выборка);
				
				Если Параметр = "ПечататьНомерСтроки" Тогда             
					НомерСтроки = НомерСтроки + 1;
					ОбластьСтроки.Параметры.НомерСтроки = НомерСтроки;						
				КонецЕсли;
				
				Если Параметр = "ПечататьНазвание" Тогда
					ОбластьСтроки.Параметры.Название = СтрШаблон("%1 %2", Выборка.Номенклатура, Выборка.Размер);	
				КонецЕсли; 
				
				Если Параметр = "ПечататьШтрихкод" Тогда
					
					ПараметрыШК = ИС_MP_ГенерацияШтрихкода.ПараметрыГенерацииШтрихкода();
					
					ПараметрыШК.Ширина = Окр(ОбластьСтроки.Рисунки.КартинкаШК.Ширина / КоличествоМиллиметровВПикселе);
					ПараметрыШК.Высота = Окр(ОбластьСтроки.Рисунки.КартинкаШК.Высота / КоличествоМиллиметровВПикселе);
					ПараметрыШК.РазмерШрифта = 10;
					ПараметрыШК.ТипКода = 4;
					ПараметрыШК.Штрихкод = Выборка.Штрихкод;
					ПараметрыШК.Масштабировать = Истина;
					ПараметрыШК.СохранятьПропорции = Истина;
					ПараметрыШК.ВертикальноеВыравнивание = 2; 
					
					СтруктураКартинки = ИС_MP_ГенерацияШтрихкода.ИзображениеШтрихкода(ПараметрыШК);
					
					Если СтруктураКартинки.Результат Тогда	
						ОбластьСтроки.Рисунки.КартинкаШК.Картинка = СтруктураКартинки.Картинка;
					КонецЕсли; 
					
				КонецЕсли;
				
				Если Параметр = "ПечататьФото" И ЗначениеЗаполнено(Выборка.ФайлКартинки) Тогда
					ОбластьСтроки.Рисунки.КартинкаТовара.Картинка = Новый Картинка(РаботаСФайлами.ДвоичныеДанныеФайла(Выборка.ФайлКартинки));
				КонецЕсли;
				
				Если ОбластьВыведена Тогда
					ТабДок.Присоединить(ОбластьСтроки);	
				Иначе  
					ТабДок.Вывести(ОбластьСтроки);
					ВысотаОбластей = ВысотаОбластей + ОбластьСтроки.ВысотаТаблицы;
					ОбластьВыведена = Истина;
				КонецЕсли; 
				
				Если ВысотаОбластей + ОбластьСтроки.ВысотаТаблицы >= 71 Тогда 					
					Табдок.ВывестиГоризонтальныйРазделительСтраниц();
					ВысотаОбластей = 0;
				КонецЕсли;
				
			КонецЕсли;
			
		КонецЦикла;
						
		Если ВыводитьКомплектующие И ВыгрузкаНаборы.Количество() > 0 Тогда                    
			
			НайденныеСтроки = ВыгрузкаНаборы.НайтиСтроки(Новый Структура("Номенклатура, Характеристика", Выборка.Номенклатура, Выборка.Размер));
			
			Если НайденныеСтроки.Количество() > 0 Тогда
				
				Для Каждого Строка Из НайденныеСтроки Цикл
					
					Для Каждого Строка Из НайденныеСтроки Цикл
						
						ОбластьВыведена = Ложь; 
						
						Для Каждого Параметр Из МассивЗначений Цикл
							
							Если НастройкиПечати[Параметр] Тогда
								
								ОбластьСтроки = МакетОбработки.ПолучитьОбласть("ДанныеСтроки|" + Сред(Параметр, 9));
								
								ЗаполнитьЗначенияСвойств(ОбластьСтроки.Параметры, Строка);  
								
								Если Параметр = "ПечататьНазвание" Тогда
									ОбластьСтроки.Параметры.Название     = СтрШаблон("Комплектующая набора: %1 %2 в количестве %3", Строка.НоменклатураНабора, Строка.ХарактеристикаНабора, Строка.КоличествоУпаковок);
								КонецЕсли; 
								
								Если Параметр = "ПечататьФото" И ЗначениеЗаполнено(Строка.ФайлКартинки) Тогда								
									ОбластьСтроки.Рисунки.КартинкаТовараНабор.Картинка = Новый Картинка(РаботаСФайлами.ДвоичныеДанныеФайла(Строка.ФайлКартинки));								
								КонецЕсли;
								
								Если ОбластьВыведена Тогда
									ТабДок.Присоединить(ОбластьСтроки);	
								Иначе  
									ТабДок.Вывести(ОбластьСтроки);
									ВысотаОбластей = ВысотаОбластей + ОбластьСтроки.ВысотаТаблицы;
									ОбластьВыведена = Истина;
								КонецЕсли; 
								
								Если ВысотаОбластей + ОбластьСтроки.ВысотаТаблицы >= 71 Тогда 					
									Табдок.ВывестиГоризонтальныйРазделительСтраниц();
									ВысотаОбластей = 0;
								КонецЕсли;
								
							КонецЕсли;
							
						КонецЦикла;
						
						ВыгрузкаНаборы.Удалить(Строка);
						
					КонецЦикла; 
					
				КонецЦикла;
				
			КонецЕсли; 	    
			
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат Табдок;
	
КонецФункции //- ИнфоСофт Стояк Ю.К. 10.02.2025 УА #77168

//+ ИнфоСофт Стояк Ю.К. 04.04.2024 УА #67207
&НаКлиенте
Функция ПараметрыОжидания()

	ПараметрыОжидания = ДлительныеОперацииКлиент.ПараметрыОжидания(ЭтотОбъект);	
	ПараметрыОжидания.ВыводитьОкноОжидания = Ложь;
	ПараметрыОжидания.ВыводитьСообщения = Истина;
	Возврат ПараметрыОжидания;

КонецФункции //- ИнфоСофт Стояк Ю.К. 04.04.2024 УА #67207

//+ ИнфоСофт Стояк Ю.К. 04.04.2024 УА #67207
&НаКлиенте
Процедура ПолучениеЗаказовЗавершение(Результат, ДополнительныеПараметры) Экспорт
    
    Элементы["КартинкаОжидание"].Видимость = Ложь;
    
    Если Результат = Неопределено Тогда  // отменено пользователем
		Возврат;
	КонецЕсли;
	
	Если Результат.Статус = "Ошибка" Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю(Результат.ПодробноеПредставлениеОшибки);	
	КонецЕсли;
	
	Если Результат.Сообщения.Количество() > 0 Тогда
		
		Для Каждого Элемент Из Результат.Сообщения Цикл
			ОбщегоНазначенияКлиент.СообщитьПользователю(Элемент.Текст);
		КонецЦикла;
		
	КонецЕсли; 
	
	ДатаПоследнегоОтправления = ПолучитьДатуПоследнегоОтправленияНаСервере();
	
	Элементы.Список.Обновить();
	
	УдалитьИзВременногоХранилища(Результат.АдресРезультата);
	
КонецПроцедуры //- ИнфоСофт Стояк Ю.К. 04.04.2024 УА #67207

//+ ИнфоСофт Стояк Ю.К. 04.04.2024 УА #67207
&НаКлиенте
Процедура ОбновитьСтатусыЗавершение(Результат, ДополнительныеПараметры) Экспорт
    
    Элементы["КартинкаОжиданиеСтатусы"].Видимость = Ложь;
    
    Если Результат = Неопределено Тогда  // отменено пользователем
		Возврат;
	КонецЕсли;
	
	Если Результат.Статус = "Ошибка" Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю(Результат.ПодробноеПредставлениеОшибки);	
	КонецЕсли;
	
	Если Результат.Сообщения.Количество() > 0 Тогда
		
		Для Каждого Элемент Из Результат.Сообщения Цикл
			ОбщегоНазначенияКлиент.СообщитьПользователю(Элемент.Текст);
		КонецЦикла;
		
	КонецЕсли;
	
	Элементы.Список.Обновить();
	
	УдалитьИзВременногоХранилища(Результат.АдресРезультата);
	
КонецПроцедуры //- ИнфоСофт Стояк Ю.К. 04.04.2024 УА #67207

//+ ИнфоСофт Стояк Ю.К. 04.04.2024 УА #67207
&НаСервереБезКонтекста
Функция ПроверитьРегламетноеЗаданиеНаСервере(Профиль, ИмяКоманды)
	
	РеглАктивен = Ложь;
	
	Если Не РегламентныеЗаданияСервер.РаботаСВнешнимиРесурсамиЗаблокирована() Тогда
		
		УникальныйИдентификатор = ИС_MP_РаботаСРегламентнымиЗаданиями.ПолучитьУникальныйИдентификаторРегламентогоЗадания(Профиль, ИмяКоманды);
		
		Если ЗначениеЗаполнено(УникальныйИдентификатор) Тогда
			
			Попытка
				УстановитьПривилегированныйРежим(Истина);
				РегламентноеЗадание = РегламентныеЗаданияСервер.ПолучитьРегламентноеЗадание(УникальныйИдентификатор);
				
				РеглАктивен = ИС_MP_РаботаСРегламентнымиЗаданиями.ФоновоеЗаданиеАктивно(РегламентноеЗадание);
				УстановитьПривилегированныйРежим(Ложь);	 
			Исключение
				РеглАктивен = Ложь;
			КонецПопытки;	
			
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат РеглАктивен;
	
КонецФункции //- ИнфоСофт Стояк Ю.К. 04.04.2024 УА #67207  

