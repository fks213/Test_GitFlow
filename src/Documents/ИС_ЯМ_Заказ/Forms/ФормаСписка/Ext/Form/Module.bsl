&НаСервере
Функция ПолучитьЗначениеПараметра()
	
	МассивНаименованийПараметров = Новый Массив;  	
	МассивНаименованийПараметров.Добавить("РазнестиЗаказыПоКоличеству");
		
	Настройки = ИС_МП_Сервер.ПолучитьЗначениеНастроек(Профиль, Перечисления.ИС_МП_Маркетплейсы.ЯМ, МассивНаименованийПараметров);
	
	Если Настройки.Свойство("РазнестиЗаказыПоКоличеству") И ТипЗнч(Настройки.РазнестиЗаказыПоКоличеству) = Тип("Булево") Тогда
		Возврат Настройки.РазнестиЗаказыПоКоличеству;
	Иначе
		Возврат Ложь;
	КонецЕсли;	
	
КонецФункции //- ИнфоСофт Янгиров Р.Р. 14.11.2024 УА #86762

//+ ИнфоСофт Янгиров Р.Р. 14.11.2024 УА #86762
&НаСервере
Функция ПреобразоватьДеревоВТаблицуЗначений(ДеревоЗначений, ТекущийОбъект)
	
	Для Каждого Строка Из ДеревоЗначений.Строки Цикл
		
		Если Строка.Строки.Количество() = 0 Тогда
			
			НоваяСтрока = ТекущийОбъект.Товары.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, Строка);
				
		ИначеЕсли Строка.Строки.Количество() > 0 Тогда
			
			ПреобразоватьДеревоВТаблицуЗначений(Строка, ТекущийОбъект);
			
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат ТекущийОбъект;	
КонецФункции //- ИнфоСофт Янгиров Р.Р. 14.11.2024 УА #86762

//+ ИнфоСофт Янгиров Р.Р. 14.11.2024 УА #86762
&НаСервере
Функция ЗаполнитьДанныеЗаказаНаСервере(Итератор)

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ИС_ЯМ_СтатусыСборочныхЗаданий.Заказ КАК Заказ
	|ПОМЕСТИТЬ ВТ_СборочныеЗадания
	|ИЗ
	|	РегистрСведений.ИС_ЯМ_СтатусыСборочныхЗаданий КАК ИС_ЯМ_СтатусыСборочныхЗаданий
	|ГДЕ
	|	ИС_ЯМ_СтатусыСборочныхЗаданий.Профиль = &Профиль
	|	И ИС_ЯМ_СтатусыСборочныхЗаданий.status = ЗНАЧЕНИЕ(Перечисление.ИС_ЯМ_СтатусыЗаказов.PROCESSING)
	|	И ИС_ЯМ_СтатусыСборочныхЗаданий.substatus = ЗНАЧЕНИЕ(Перечисление.ИС_ЯМ_ДетальныеСтатусы.READY_TO_SHIP)
	|	И ИС_ЯМ_СтатусыСборочныхЗаданий.Заказ.shipmentDate МЕЖДУ &ДатаОт И &ДатаДо
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ИС_ЯМ_Заказ_items.Ссылка КАК СборочноеЗадание,
	|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ ИС_ЯМ_СоответствиеХарактеристик.Номенклатура) КАК Номенклатура,
	|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ ИС_ЯМ_СоответствиеХарактеристик.Характеристика) КАК Характеристика,
	|	СУММА(ИС_ЯМ_Заказ_items.count) КАК КоличествоЗаказ
	|ПОМЕСТИТЬ ВТ_Заказы
	|ИЗ
	|	Документ.ИС_ЯМ_Заказ.items КАК ИС_ЯМ_Заказ_items
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ИС_ЯМ_СоответствиеХарактеристик КАК ИС_ЯМ_СоответствиеХарактеристик
	|		ПО ИС_ЯМ_Заказ_items.НоменклатураЯМ = ИС_ЯМ_СоответствиеХарактеристик.НоменклатураЯМ
	|			И ИС_ЯМ_Заказ_items.Ссылка.Профиль = ИС_ЯМ_СоответствиеХарактеристик.НоменклатураЯМ.Профиль
	|ГДЕ
	|	ИС_ЯМ_Заказ_items.Ссылка В
	|			(ВЫБРАТЬ
	|				ВТ_СборочныеЗадания.Заказ КАК Ссылка
	|			ИЗ
	|				ВТ_СборочныеЗадания КАК ВТ_СборочныеЗадания)
	|
	|СГРУППИРОВАТЬ ПО
	|	ИС_ЯМ_Заказ_items.Ссылка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ИС_ЯМ_Заказ_items.Ссылка КАК СборочноеЗадание,
	|	ИС_ЯМ_СоответствиеХарактеристик.Номенклатура КАК Номенклатура,
	|	ИС_ЯМ_СоответствиеХарактеристик.Характеристика КАК Характеристика,
	|	СУММА(ИС_ЯМ_Заказ_items.count) КАК КоличествоЗаказ
	|ПОМЕСТИТЬ ВТ_Номенклатура
	|ИЗ
	|	Документ.ИС_ЯМ_Заказ.items КАК ИС_ЯМ_Заказ_items
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ИС_ЯМ_СоответствиеХарактеристик КАК ИС_ЯМ_СоответствиеХарактеристик
	|		ПО ИС_ЯМ_Заказ_items.НоменклатураЯМ = ИС_ЯМ_СоответствиеХарактеристик.НоменклатураЯМ
	|			И ИС_ЯМ_Заказ_items.Ссылка.Профиль = ИС_ЯМ_СоответствиеХарактеристик.НоменклатураЯМ.Профиль
	|ГДЕ
	|	ИС_ЯМ_Заказ_items.Ссылка В
	|			(ВЫБРАТЬ
	|				ВТ_Заказы.СборочноеЗадание КАК Ссылка
	|			ИЗ
	|				ВТ_Заказы КАК ВТ_Заказы
	|			ГДЕ
	|				&УсловиеНаКоличество)
	|
	|СГРУППИРОВАТЬ ПО
	|	ИС_ЯМ_Заказ_items.Ссылка,
	|	ИС_ЯМ_СоответствиеХарактеристик.Номенклатура,
	|	ИС_ЯМ_СоответствиеХарактеристик.Характеристика
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_Номенклатура.СборочноеЗадание КАК Заказ,
	|	ВТ_Номенклатура.Номенклатура КАК Номенклатура,
	|	ВТ_Номенклатура.Характеристика КАК Характеристика,
	|	ВТ_Номенклатура.КоличествоЗаказ КАК КоличествоЗаказ,
	|	0 КАК КоличествоФакт,
	|	""Ложь"" КАК ЭтикеткаРаспечатана
	|ИЗ
	|	ВТ_Номенклатура КАК ВТ_Номенклатура
	|
	|УПОРЯДОЧИТЬ ПО
	|	Заказ
	|ИТОГИ
	|	СУММА(КоличествоЗаказ)
	|ПО
	|	Заказ";
	
	Если Итератор = 0 Тогда
		УсловиеНаКоличество = " ВТ_Заказы.КоличествоЗаказ = 1";
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеНаКоличество", УсловиеНаКоличество);
	Иначе
		УсловиеНаКоличество = " ВТ_Заказы.КоличествоЗаказ > 1";
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеНаКоличество", УсловиеНаКоличество);
	КонецЕсли; 

	Запрос.УстановитьПараметр("Профиль", ЭтотОбъект.Профиль);
	Запрос.УстановитьПараметр("ДатаОт", НачалоДня(ТекущаяДатаСеанса()));
	Запрос.УстановитьПараметр("ДатаДо", КонецДня(ТекущаяДатаСеанса()));
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Если НЕ РезультатЗапроса.Пустой() Тогда
		Результат = РезультатЗапроса.Выгрузить(ОбходРезультатаЗапроса.ПоГруппировкамСИерархией);
		Возврат Результат;
	Иначе
		Возврат Ложь
	КонецЕсли;
	                                     
КонецФункции //- ИнфоСофт Янгиров Р.Р. 14.11.2024 УА #86762

//+ ИнфоСофт Янгиров Р.Р. 14.11.2024 УА #86762
&НаСервере
Функция ИзменитьСтатусыЗаказовЯМ()
	
	Запрос = Новый запрос;
	Запрос.Текст = "ВЫБРАТЬ
	|	ИС_ЯМ_СтатусыСборочныхЗаданий.Профиль КАК Профиль,
	|	ИС_ЯМ_СтатусыСборочныхЗаданий.Заказ КАК Заказ,
	|	ИС_ЯМ_СтатусыСборочныхЗаданий.status КАК status
	|ИЗ
	|	РегистрСведений.ИС_ЯМ_СтатусыСборочныхЗаданий КАК ИС_ЯМ_СтатусыСборочныхЗаданий
	|ГДЕ
	|	ИС_ЯМ_СтатусыСборочныхЗаданий.Заказ.shipmentDate МЕЖДУ &ДатаНачала И &ДатаОкончания
	|	И ИС_ЯМ_СтатусыСборочныхЗаданий.status = &status
	|	И ИС_ЯМ_СтатусыСборочныхЗаданий.substatus = &substatus";
	
	Запрос.УстановитьПараметр("ДатаНачала", НачалоДня(ТекущаяДатаСеанса()));
	Запрос.УстановитьПараметр("ДатаОкончания", КонецДня(ТекущаяДатаСеанса()));
	Запрос.УстановитьПараметр("status",  Перечисления.ИС_ЯМ_СтатусыЗаказов.PROCESSING);
	Запрос.УстановитьПараметр("substatus", Перечисления.ИС_ЯМ_ДетальныеСтатусы.STARTED);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Если Не РезультатЗапроса.Пустой() Тогда
		Результат = РезультатЗапроса.Выгрузить();
		Запись = РегистрыСведений.ИС_ЯМ_СтатусыСборочныхЗаданий.СоздатьМенеджерЗаписи();
		Для Каждого Стр из Результат Цикл
			Запись.Профиль= Стр.Профиль;
			Запись.Заказ = Стр.Заказ;
			Запись.Прочитать();
			
			Если Запись.Выбран() Тогда
				Запись.substatus = Перечисления.ИС_ЯМ_ДетальныеСтатусы.READY_TO_SHIP;
				Запись.Записать();
			КонецЕсли	
		КонецЦикла;
		//+ ИнфоСофт Власова И.С. 24.01.25 УА #91984
		Возврат Ложь;
		//- ИнфоСофт Власова И.С. 24.01.25 УА #91984
	Иначе
		Возврат Истина
	КонецЕсли;

КонецФункции //- ИнфоСофт Янгиров Р.Р. 14.11.2024 УА #86762

//+ ИнфоСофт Янгиров Р.Р. 14.11.2024 УА #86762
&НаСервере
Процедура СоздатьДокументыУпаковкиТоваровЯМ(ПараметрыОткрытия)
	
	Итератор = 0;
	
	Пока Итератор < 2 Цикл // два цикла так как один документ с кол-во 1 второй с кол-вом больше 2 
		
		РезультатЗапроса 						= ЗаполнитьДанныеЗаказаНаСервере(Итератор);
		
		Если РезультатЗапроса = Неопределено или РезультатЗапроса = Ложь Тогда
			Итератор = Итератор + 1;
			Текст = НСтр("ru='По заказам с количеством товара" + ?(Итератор < 2, " 1 ", " 2 и более ") + " документ не был создан.'");			
			ОбщегоНазначения.СообщитьПользователю(Текст);
			Продолжить;
		Иначе
			//+ ИнфоСофт Власова И.С. 24.01.25 УА #91984
			//ДокументУпаковки 					= Документы.ИС_Ozon_УпаковкаТоваров.СоздатьДокумент();
			ДокументУпаковки 					= Документы.ИС_ЯМ_УпаковкаТоваров.СоздатьДокумент();
			//- ИнфоСофт Власова И.С. 24.01.25 УА #91984
			ДокументУпаковки.Дата 				= ТекущаяДатаСеанса();
			ДокументУпаковки.Ответственный 		= Пользователи.ТекущийПользователь();
			ДокументУпаковки.Профиль            = ПараметрыОткрытия.Профиль;
			РезультатЗапроса 					= ПреобразоватьДеревоВТаблицуЗначений(РезультатЗапроса,ДокументУпаковки);
			
			ДокументУпаковки.Записать(РежимЗаписиДокумента.Запись);
			Текст = НСтр("ru='По заказам с количеством товара" + ?(Итератор < 2, " 1 ", " 2 и более ") + " был сознад документ упаковки товаров.'");			
			ОбщегоНазначения.СообщитьПользователю(Текст);
		КонецЕсли;		
		
		Итератор = Итератор + 1;
		
	КонецЦикла; 
	
