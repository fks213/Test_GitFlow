&НаСервереБезКонтекста
Функция  ЗагрузитьЗаказыНаСервере(Профиль, ДатаПоследнегоОтправления, УникальныйИдентификатор)
	
	Если ДатаПоследнегоОтправления = Дата(1, 1, 1) Тогда
		ДатаПоследнегоОтправления = НачалоДня(ТекущаяДатаСеанса());
	КонецЕсли; 
	
	//+ ИнфоСофт Стояк Ю.К. 04.04.2024 УА #67207	
	ПараметрыВыполнения = ДлительныеОперации.ПараметрыВыполненияВФоне(УникальныйИдентификатор);
	ПараметрыВыполнения.ЗапуститьВФоне = Истина;
	ПараметрыВыполнения.ОжидатьЗавершение = 0;
	
	Возврат ДлительныеОперации.ВыполнитьПроцедуру(ПараметрыВыполнения, 
	"ИС_ЯМ_Сервер.ПолучитьСписокЗаказов", Профиль, ДатаПоследнегоОтправления);
	
	//ИС_ЯМ_Сервер.ПолучитьСписокЗаказов(Профиль, ДатаПоследнегоОтправления);
	//- ИнфоСофт Стояк Ю.К. 04.04.2024 УА #67207		
	
КонецФункции //- ИнфоСофт Стояк Ю.К. 20.03.2023 УА #54628

//+ ИнфоСофт Стояк Ю.К. 20.03.2023 УА #54628
Процедура СписокПриАктивизацииСтрокиНаСервере(ВыделенныеСтроки)
	
	СоставЗаказов.Очистить();
	
	Для Каждого Строка Из ВыделенныеСтроки Цикл
		Если ТипЗнч(Строка) = Тип("СтрокаГруппировкиДинамическогоСписка") Тогда
			Возврат;
		КонецЕсли;
	КонецЦикла;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	//+ ИнфоСофт Сумин Д.В. 15.04.2023 УА #57537
	"ВЫБРАТЬ
	|	ИС_ЯМ_Заказproducts.Ссылка КАК Ссылка,
	|	ИС_ЯМ_Заказproducts.НоменклатураЯМ КАК Номенклатура,
	|	ИС_ЯМ_Заказproducts.ШтрихкодЯМ КАК Штрихкод,
	|	ИС_ЯМ_Заказproducts.count КАК Количество,
	|	ИС_ЯМ_Заказproducts.Сумма КАК Сумма,
	|	ИС_ЯМ_Заказproducts.price КАК Цена,
	|	ИС_ЯМ_Заказproducts.shipmentDate КАК shipmentDate
	|ИЗ
	|	Документ.ИС_ЯМ_Заказ.items КАК ИС_ЯМ_Заказproducts
	|ГДЕ
	|	ИС_ЯМ_Заказproducts.Ссылка В(&ВыделенныеСтроки)
	|
	|УПОРЯДОЧИТЬ ПО
	|	ИС_ЯМ_Заказproducts.Ссылка.Дата УБЫВ";
	//- ИнфоСофт Сумин Д.В. 15.04.2023 УА #57537
	
	Запрос.УстановитьПараметр("ВыделенныеСтроки", ВыделенныеСтроки);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		НоваяСтрока = СоставЗаказов.Добавить();
		НоваяСтрока.Заказ = ВыборкаДетальныеЗаписи.Ссылка;
		НоваяСтрока.Номенклатура = ВыборкаДетальныеЗаписи.Номенклатура;		
		НоваяСтрока.Штрихкод = ВыборкаДетальныеЗаписи.Штрихкод;
		НоваяСтрока.Количество = ВыборкаДетальныеЗаписи.Количество;		
		НоваяСтрока.Цена = ВыборкаДетальныеЗаписи.Цена;	
		НоваяСтрока.Сумма = ВыборкаДетальныеЗаписи.Сумма;
		//+ ИнфоСофт Сумин Д.В. 15.04.2023 УА #57537
		НоваяСтрока.ДатаОтгрузки = ВыборкаДетальныеЗаписи.shipmentDate; 
		//- ИнфоСофт Сумин Д.В. 15.04.2023 УА #57537
	КонецЦикла;		
	
КонецПроцедуры //- ИнфоСофт Стояк Ю.К. 20.03.2023 УА #54628

