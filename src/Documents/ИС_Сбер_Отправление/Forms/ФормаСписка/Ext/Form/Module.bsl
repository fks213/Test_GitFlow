//+ ИнфоСофт Ивонин К.А. 17.02.24 УА #67209
&НаКлиенте
Процедура ВыпонитьДействиеНадЛотами(Команда)

	ВыделенныеСтроки = Элементы.Список.ВыделенныеСтроки;
	
	Если ВыделенныеСтроки.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;	
	
	Если Команда.Имя = "ПодтвердитьЛоты" Тогда
		Действие = "Подтвердить";
	ИначеЕсли Команда.Имя = "ОтменитьЛоты" Тогда
		Действие = "Отменить";
	ИначеЕсли Команда.Имя = "КомплектоватьЛоты" Тогда
		Действие = "Скомплектовать";
	ИначеЕсли Команда.Имя = "ОтгрузитьЛоты" Тогда
		Действие = "Отгрузить";
	КонецЕсли;

    ПараметрыФормы = Новый Структура;
    ПараметрыФормы.Вставить("Действие", Действие);
    ПараметрыФормы.Вставить("Профиль", Профиль);
    ПараметрыФормы.Вставить("МассивОтправлений", ВыделенныеСтроки);
	
	ОткрытьФорму("Документ.ИС_Сбер_Отправление.Форма.ФормаДействийПоОтправлениям", ПараметрыФормы, ЭтотОбъект);
	
КонецПроцедуры //- ИнфоСофт Ивонин К.А. 17.02.24 УА #67209

//+ ИнфоСофт Заварин К.В. 20.03.24 УА #66299
&НаКлиенте
Процедура ПечатьЛистаПодбора(Команда)
    
		ВыделенныеСтроки = Элементы.Список.ВыделенныеСтроки;
			
		Если ВыделенныеСтроки = Неопределено Или ВыделенныеСтроки.Количество() = 0 Тогда
			Возврат;
		КонецЕсли;
 	
	ТабДок = ПолучитьЛистПодбораНаСервере(ВыделенныеСтроки);
	КоллекцияПечатныхФорм = УправлениеПечатьюКлиент.НоваяКоллекцияПечатныхФорм("Лист Подбора МегаМаркет");
	
	КоллекцияПечатныхФорм[0].ТабличныйДокумент = ТабДок;
	КоллекцияПечатныхФорм[0].Экземпляров = 1;
	КоллекцияПечатныхФорм[0].СинонимМакета = "Лист Подбора МегаМаркет";
	
	УправлениеПечатьюКлиент.ПечатьДокументов(КоллекцияПечатныхФорм, Неопределено, ЭтотОбъект);

КонецПроцедуры //- ИнфоСофт Заварин К.В. 20.03.24 УА #66299

//+ ИнфоСофт Стояк Ю.К. 03.06.2024 УА #76167
&НаКлиенте
Процедура ОткрытьФормуСборкиЗаказов(Команда)
	
	ВыделенныеСтроки = Элементы.Список.ВыделенныеСтроки;
	
	ПараметрыОткрытия = Новый Структура;
	ПараметрыОткрытия.Вставить("Профиль", Профиль);
	
	Если ВыделенныеСтроки.Количество() <> 0 Тогда
