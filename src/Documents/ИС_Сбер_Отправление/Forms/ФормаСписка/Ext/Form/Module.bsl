//+ ИнфоСофт Ивонин К.А. 12.11.23 УА #55166
&НаКлиенте
Процедура ПечатьЭтикетки(Команда)
    
    ОчиститьСообщения();
    
	Если Не ЗначениеЗаполнено(Профиль) Тогда 
		ОбщегоНазначенияКлиент.СообщитьПользователю("Не выбран ""Профиль""", , , "Профиль");
		Возврат;
	КонецЕсли;
	
	МассивЗаказов = Элементы.Список.ВыделенныеСтроки;
	
	Если МассивЗаказов = Неопределено Или МассивЗаказов.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;	

	Результат = ПечатьЭтикеткиНаСервере(Профиль, МассивЗаказов);
	
	Если Результат = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ДанныеЭтикетки = ПолучитьИзВременногоХранилища(Результат);
	
	НачатьПолучениеКаталогаВременныхФайлов(Новый ОписаниеОповещения("ПечатьЭтикеткиЗавершение", ЭтотОбъект, ДанныеЭтикетки));
			
КонецПроцедуры //- ИнфоСофт Ивонин К.А. 12.11.23 УА #55166

