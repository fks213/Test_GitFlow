//+ ИнфоСофт Заварин К.В. 20.03.24 УА #66299
&НаСервере
Функция ПолучитьЛистПодбораНаСервере(ВыделенныеСтроки) 
	Табдок = Новый ТабличныйДокумент;
	
	Табдок.ИмяПараметровПечати = "ИС_Сбер_ПечатьЛистаПодбора";
	ТабДок.ОриентацияСтраницы = ОриентацияСтраницы.Портрет;  
	ТабДок.АвтоМасштаб = Истина;
	
	ТабДок.ПолеСправа = 7;
	
	МакетОбработки = УправлениеПечатью.МакетПечатнойФормы("Документ.ИС_Сбер_Отправление.ПФ_MXL_ЛистПодбора");
	
	ОбластьШапка = МакетОбработки.ПолучитьОбласть("Шапка|ОсновнойЛист");
	ОбластьШапка.Параметры.Дата = ТекущаяДатаСеанса();
	ОбластьШапка.Параметры.Профиль = Профиль;
	ОбластьШапка.Параметры.Сорт = Элементы.СортировкаПечати.СписокВыбора.НайтиПоЗначению(СортировкаПечати).Представление;
	
	Табдок.Вывести(ОбластьШапка);
	
	Если ВыводитьФото Тогда
		ОбластьШапка = МакетОбработки.ПолучитьОбласть("Шапка|Фото");	
		Табдок.Присоединить(ОбластьШапка); 	
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст =	
	"ВЫБРАТЬ
	|	ИС_Сбер_Отправлениеitems.Ссылка.Номер КАК Номер,
	|	ИС_Сбер_Отправлениеitems.Ссылка.Дата КАК Дата,
	|	ИС_Сбер_Отправлениеitems.НоменклатураМегаМаркета.Наименование КАК Наименование,
	|	ИС_Сбер_Товары.Характеристика КАК Характеристика,
	|	ЕСТЬNULL(ИС_Сбер_Товары.offerID,""Отсутствует сопоставление"") КАК offerID,
	|	ИС_Сбер_Отправлениеitems.НоменклатураМегаМаркета.Штрихкод КАК Штрихкод,
	|	ИС_Сбер_Товары.Номенклатура.ФайлКартинки КАК ФайлКартинки,
	|	ИС_Сбер_Товары.Номенклатура КАК Номенклатура
	|ИЗ
	|	Документ.ИС_Сбер_Отправление.items КАК ИС_Сбер_Отправлениеitems
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ИС_Сбер_Товары КАК ИС_Сбер_Товары
	|		ПО ИС_Сбер_Отправлениеitems.НоменклатураМегаМаркета.offer_id = ИС_Сбер_Товары.offerID
	|ГДЕ
	|	ИС_Сбер_Отправлениеitems.Ссылка В(&МассивСсылок)
	|	И ИС_Сбер_Отправлениеitems.status <> ЗНАЧЕНИЕ(Перечисление.ИС_Сбер_СтатусыОтправлений.MERCHANT_CANCELED)    
	|	И ИС_Сбер_Отправлениеitems.status <> ЗНАЧЕНИЕ(Перечисление.ИС_Сбер_СтатусыОтправлений.CUSTOMER_CANCELED)   
	|
	|УПОРЯДОЧИТЬ ПО
	|	%1";
	
    Запрос.Текст = СтрШаблон(Запрос.Текст, ?(СортировкаПечати = "Наименование", "Наименование, Характеристика", СортировкаПечати));

	Запрос.УстановитьПараметр("МассивСсылок", ВыделенныеСтроки);

	РезультатЗапроса = Запрос.Выполнить();
	
	Если РезультатЗапроса.Пустой() Тогда
		ОбщегоНазначения.СообщитьПользователю("Не удалось сформировать лист подбора");
		Возврат Табдок;	
	КонецЕсли;
	
	Эталон = УправлениеПечатью.МакетПечатнойФормы("ОбщийМакет.ИС_МП_Эталон");

	КоличествоМиллиметровВПикселе = Эталон.Рисунки.Квадрат100Пикселей.Высота / 100;
					
	Выборка = РезультатЗапроса.Выбрать();
	
	ВысотаОбластей = Табдок.ВысотаТаблицы;
	
	Если ВыводитьКомплектующие Тогда
		
		Запрос = Новый Запрос;
		Запрос.Текст =	
		"ВЫБРАТЬ
		|			ВТ.Номер КАК Номер,
		|			ВТ.Номенклатура КАК Номенклатура,
		|			ВТ.Характеристика КАК Характеристика,
		|			ВТ.Штрихкод КАК Штрихкод		
		|			ПОМЕСТИТЬ ВТ_Номенклатура
		|		ИЗ
		|			&ВТ КАК ВТ
		|		;
		|		
		|		////////////////////////////////////////////////////////////////////////////////
		|		ВЫБРАТЬ
		|			ВТ_Номенклатура.Номер КАК Номер,
		|			ВТ_Номенклатура.Номенклатура КАК Номенклатура,
		|			ВТ_Номенклатура.Характеристика КАК Характеристика,
		|			ВТ_Номенклатура.Штрихкод КАК Штрихкод,
		|			ВариантыКомплектацииНоменклатурыТовары.Номенклатура КАК НоменклатураНабора,
		|			ВариантыКомплектацииНоменклатурыТовары.Характеристика КАК ХарактеристикаНабора,
		|			ВариантыКомплектацииНоменклатурыТовары.КоличествоУпаковок КАК КоличествоУпаковок
		|		ПОМЕСТИТЬ ВТ_СоставНаборов
		|		ИЗ
		|			ВТ_Номенклатура КАК ВТ_Номенклатура
		|				ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ВариантыКомплектацииНоменклатуры.Товары КАК ВариантыКомплектацииНоменклатурыТовары
		|				ПО ВТ_Номенклатура.Номенклатура = ВариантыКомплектацииНоменклатурыТовары.Ссылка.Владелец
		|					И ВТ_Номенклатура.Характеристика = ВариантыКомплектацииНоменклатурыТовары.Ссылка.Характеристика
		|		ГДЕ
		|			ВариантыКомплектацииНоменклатурыТовары.Ссылка.Владелец <> ЗНАЧЕНИЕ(Справочник.Номенклатура.ПустаяСсылка)
		|		;
		|		
		|		////////////////////////////////////////////////////////////////////////////////
		|		ВЫБРАТЬ
		|			ВТ_СоставНаборов.Номер КАК Номер,
		|			ВТ_СоставНаборов.Номенклатура КАК Номенклатура,
		|			ВТ_СоставНаборов.Характеристика КАК Характеристика,
		|			ВТ_СоставНаборов.Штрихкод КАК Штрихкод,
		|			ВТ_СоставНаборов.НоменклатураНабора КАК НоменклатураНабора,
		|			ВТ_СоставНаборов.ХарактеристикаНабора КАК ХарактеристикаНабора,
		|			ВТ_СоставНаборов.КоличествоУпаковок КАК КоличествоУпаковок,
		|			ВТ_СоставНаборов.НоменклатураНабора.ФайлКартинки КАК ФайлКартинки,
		|			ВТ_СоставНаборов.НоменклатураНабора.Марка КАК Бренд,
		|			ВТ_СоставНаборов.НоменклатураНабора.Артикул КАК Артикул
		|		ИЗ
		|			ВТ_СоставНаборов КАК ВТ_СоставНаборов
		|		
		|		УПОРЯДОЧИТЬ ПО
		|			ВТ_СоставНаборов.НоменклатураНабора.Наименование";     
		
		Запрос.УстановитьПараметр("ВТ", РезультатЗапроса.Выгрузить());
		
		РезультатЗапроса = Запрос.Выполнить();
		
		ВыгрузкаНаборы = РезультатЗапроса.Выгрузить(); 
		
	КонецЕсли;
	
	Пока Выборка.Следующий() Цикл 
		
		ОбластьСтроки = МакетОбработки.ПолучитьОбласть("ДанныеСтроки|ОсновнойЛист");
		
		ОбластьСтроки.Параметры.НомерЗадания = Выборка.Номер;
		ОбластьСтроки.Параметры.Название     = СтрШаблон("%1 %2", Выборка.Наименование, Выборка.Характеристика);
		ОбластьСтроки.Параметры.Размер       = Выборка.Характеристика;
		ОбластьСтроки.Параметры.Артикул    = Выборка.offerID;
		
		ПараметрыШК = ИС_MP_ГенерацияШтрихкода.ПараметрыГенерацииШтрихкода();
		
		ПараметрыШК.Ширина = Окр(ОбластьСтроки.Рисунки.КартинкаШК.Ширина / КоличествоМиллиметровВПикселе);
		ПараметрыШК.Высота = Окр(ОбластьСтроки.Рисунки.КартинкаШК.Высота / КоличествоМиллиметровВПикселе);
		ПараметрыШК.РазмерШрифта = 10;
		ПараметрыШК.ТипКода = 4;
		ПараметрыШК.Штрихкод = Выборка.Штрихкод;
		ПараметрыШК.Масштабировать = Истина;
		ПараметрыШК.СохранятьПропорции = Истина;
		ПараметрыШК.ВертикальноеВыравнивание = 2; 
		
		СтруктураКартинки = ИС_MP_ГенерацияШтрихкода.ИзображениеШтрихкода(ПараметрыШК);
		
		Если СтруктураКартинки.Результат Тогда	
			ОбластьСтроки.Рисунки.КартинкаШК.Картинка = СтруктураКартинки.Картинка;
		КонецЕсли; 
		
		Если ВысотаОбластей + ОбластьСтроки.ВысотаТаблицы >= 71 Тогда 
			Табдок.ВывестиГоризонтальныйРазделительСтраниц();
			ВысотаОбластей = 0;
		КонецЕсли;
		
		
		Табдок.Вывести(ОбластьСтроки);
		
		Если ВыводитьФото Тогда
			
			ОбластьСтрокиФото = МакетОбработки.ПолучитьОбласть("ДанныеСтроки|Фото");
			Если ЗначениеЗаполнено(Выборка.ФайлКартинки) Тогда
				ОбластьСтрокиФото.Рисунки.КартинкаТовара.Картинка = Новый Картинка(РаботаСФайлами.ДвоичныеДанныеФайла(Выборка.ФайлКартинки));
			КонецЕсли;
			Табдок.Присоединить(ОбластьСтрокиФото);
			
		КонецЕсли;
		
		ВысотаОбластей = ВысотаОбластей + ОбластьСтроки.ВысотаТаблицы;
		
		Если ВыводитьКомплектующие Тогда                    
			
			Если ВыгрузкаНаборы.Количество() > 0 Тогда
				
				ОбластьСтроки = МакетОбработки.ПолучитьОбласть("ДанныеСтрокиНабора|ОсновнойЛист");
				
				НайденныеСтроки = ВыгрузкаНаборы.НайтиСтроки(Новый Структура("Номенклатура, Характеристика", Выборка.Номенклатура, Выборка.Характеристика));
				
				Если НайденныеСтроки.Количество() > 0 Тогда
					
					Для Каждого Строка Из НайденныеСтроки Цикл
						
						ОбластьСтроки.Параметры.НомерЗадания = Строка.Номер;
						ОбластьСтроки.Параметры.Название     = СтрШаблон("Комплектующая набора: %1 %2 в количестве %3", Строка.НоменклатураНабора, Строка.ХарактеристикаНабора, Строка.КоличествоУпаковок);					
						ОбластьСтроки.Параметры.Артикул      = Строка.Артикул;																				
						
						Если ВысотаОбластей + ОбластьСтроки.ВысотаТаблицы >= 71 Тогда
							Табдок.ВывестиГоризонтальныйРазделительСтраниц();
							ВысотаОбластей = 0;
						КонецЕсли;
						
						Табдок.Вывести(ОбластьСтроки);  
						
						ВысотаОбластей = ВысотаОбластей + ОбластьСтроки.ВысотаТаблицы;
						
						Если ВыводитьФото Тогда
							
							ОбластьСтрокиФото = МакетОбработки.ПолучитьОбласть("ДанныеСтрокиНабора|Фото");
							Если ЗначениеЗаполнено(Строка.ФайлКартинки) Тогда
								ОбластьСтрокиФото.Рисунки.КартинкаТовараНабор.Картинка = Новый Картинка(РаботаСФайлами.ДвоичныеДанныеФайла(Строка.ФайлКартинки));
							КонецЕсли;
							Табдок.Присоединить(ОбластьСтрокиФото);
							
						КонецЕсли;
						
						ВыгрузкаНаборы.Удалить(Строка);
						
					КонецЦикла;
					
				КонецЕсли; 
				
			КонецЕсли;	    
			
		КонецЕсли;			
	КонецЦикла;
	
	Возврат Табдок;
	
КонецФункции //- ИнфоСофт Заварин К.В. 20.03.24 УА #66299

