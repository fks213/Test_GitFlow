&НаКлиенте
Процедура УстановитьОтборыОтправлений()
    
    ВсеОтправления = Ложь;
    
    ВидимостьПодтверждения = Ложь;
    ВидимостьУпаковки = Ложь;
    ВидимостьДоставки = Ложь;
    ВидимостьДоставкиДоПокупателя = Ложь;
	
	ВидимостьПечатьЭтикеток = Ложь;
	
	ВидимостьПодтверждения = Ложь;
	ВидимостьКомплектации = Ложь;
	ВидимостьОтгрузки = Ложь;
	ВидимостьОтмены = Ложь; 
	
	//+ ИнфоСофт Стояк Ю.К. 03.06.2024 УА #76167
	ВидимостьУпаковкаТоваров = Ложь;		
	ВидимостьРеестрПриемаПередачи = Ложь;
	//- ИнфоСофт Стояк Ю.К. 03.06.2024 УА #76167
	
	Статусы = Новый Массив;

	Если ОтборОтправлений = "Подтверждение" Тогда                                                  		

		Статусы.Добавить(ПредопределенноеЗначение("Перечисление.ИС_Сбер_СтатусыОтправлений.NEW"));
		
		ВидимостьПодтверждения = Истина;
		ВидимостьОтмены = Истина;
	
	ИначеЕсли ОтборОтправлений = "Комплектация" Тогда
	
		Статусы.Добавить(ПредопределенноеЗначение("Перечисление.ИС_Сбер_СтатусыОтправлений.CONFIRMED"));
			
		ВидимостьПечатьЭтикеток = Истина;
		
		ВидимостьКомплектации = Истина;
		ВидимостьОтмены = Истина;
		
		//+ ИнфоСофт Стояк Ю.К. 03.06.2024 УА #76167
		ВидимостьУпаковкаТоваров = Истина;		
		ВидимостьРеестрПриемаПередачи = Истина;
		//- ИнфоСофт Стояк Ю.К. 03.06.2024 УА #76167
							
	ИначеЕсли ОтборОтправлений = "Отгрузка" Тогда
			
		Статусы.Добавить(ПредопределенноеЗначение("Перечисление.ИС_Сбер_СтатусыОтправлений.PACKED"));
		Статусы.Добавить(ПредопределенноеЗначение("Перечисление.ИС_Сбер_СтатусыОтправлений.SHIPPED"));
		
        ВидимостьПечатьЭтикеток = Истина;
        
        ВидимостьОтгрузки = Истина;
		ВидимостьОтмены = Истина; 
		
		//+ ИнфоСофт Стояк Ю.К. 03.06.2024 УА #76167
		ВидимостьУпаковкаТоваров = Истина;		
		ВидимостьРеестрПриемаПередачи = Истина;
		//- ИнфоСофт Стояк Ю.К. 03.06.2024 УА #76167
			
	ИначеЕсли ОтборОтправлений = "НеОтгруженные" Тогда
			
		Статусы.Добавить(ПредопределенноеЗначение("Перечисление.ИС_Сбер_СтатусыОтправлений.SHIPPING_EXPIRED"));
						
	ИначеЕсли ОтборОтправлений = "Отменены" Тогда
		
		Статусы.Добавить(ПредопределенноеЗначение("Перечисление.ИС_Сбер_СтатусыОтправлений.CUSTOMER_CANCELED"));
				
	Иначе // Все
	
		ВсеОтправления = Истина;
		Статусы.Добавить(ПредопределенноеЗначение("Перечисление.ИС_Сбер_СтатусыОтправлений.ПустаяСсылка")); 
		
		ВидимостьПодтверждения = Истина;
		ВидимостьУпаковки = Истина;
		ВидимостьДоставки = Истина;
		ВидимостьДоставкиДоПокупателя = Истина;
		
		ВидимостьПечатьЭтикеток = Истина;
		
		ВидимостьПодтверждения = Истина;
		ВидимостьКомплектации = Истина;
		ВидимостьОтгрузки = Истина;
		ВидимостьОтмены = Истина;
	
	КонецЕсли;
	
	Список.Параметры.УстановитьЗначениеПараметра("ВсеОтправления", ВсеОтправления); 
	Список.Параметры.УстановитьЗначениеПараметра("Статусы", Статусы);
	
	Элементы.ФормаПечатьЭтикетки.Видимость = ВидимостьПечатьЭтикеток;
	
	Элементы.confirmedTimeLimit.Видимость = ВидимостьПодтверждения;
	Элементы.packingTimeLimit.Видимость = ВидимостьУпаковки;
	Элементы.shippingTimeLimit.Видимость = ВидимостьДоставки;
	Элементы.deliveryDate.Видимость = ВидимостьДоставкиДоПокупателя;
	
	Элементы.СписокПодменюДействия.Видимость = ВидимостьОтмены;
	Элементы.СписокПодтвердитьЛоты.Видимость = ВидимостьПодтверждения;
	Элементы.СписокКомплектоватьЛоты.Видимость = ВидимостьКомплектации;
	Элементы.СписокОтгрузитьЛоты.Видимость = ВидимостьОтгрузки;
	Элементы.СписокОтменитьЛоты.Видимость = ВидимостьОтмены;
	//+ ИнфоСофт Стояк Ю.К. 03.06.2024 УА #76167
	Элементы.ОткрытьФормуСборкиЗаказов.Видимость = ВидимостьУпаковкаТоваров;
	Элементы.ПечатьРеестраПриемаПередачи.Видимость = ВидимостьРеестрПриемаПередачи;
	//- ИнфоСофт Стояк Ю.К. 03.06.2024 УА #76167

КонецПроцедуры //- ИнфоСофт Ивонин К.А. 12.11.23 УА #55166

