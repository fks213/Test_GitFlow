&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	ИС_MP_Сервер.ПриСозданииНаСервере(ЭтотОбъект);
	
	Список.ТекстЗапроса = ИС_Сбер_СерверЛокализация.ПолучитьЗапросСпискаОтправлений();
	Список.ОсновнаяТаблица = "Документ.ИС_Сбер_Отправление";
	
	ОтборОтправлений = "Все";                                
	
	//+ ИнфоСофт Мурсалимов Д.Р. 05.04.24 УА #73236
	СортировкаПечати = "Номер";
	//- ИнфоСофт Мурсалимов Д.Р. 05.04.24 УА #73236
	
	//+ ИнфоСофт Конышев А.Е. 09.12.24 УА #77940
	Если Не ПолучитьФункциональнуюОпцию("ИспользоватьОрдерныеСклады") Тогда	
		Элементы.РасходныйОрдер.Видимость = Ложь;	
	КонецЕсли;                               
	//- ИнфоСофт Конышев А.Е. 09.12.24 УА #77940
	
	// СтандартныеПодсистемы.ПодключаемыеКоманды
	ПодключаемыеКоманды.ПриСозданииНаСервере(ЭтотОбъект);
	// Конец СтандартныеПодсистемы.ПодключаемыеКоманды
	
КонецПроцедуры //- ИнфоСофт Ивонин К.А. 12.11.23 УА #55166

