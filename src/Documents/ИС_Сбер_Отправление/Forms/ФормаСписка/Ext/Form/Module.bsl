//+ ИнфоСофт Стояк Ю.К. 03.06.2024 УА #76167
&НаСервере
Функция ПолучитьРеестрПриемаПередачи(ВыделенныеСтроки)
	
	ДанныеТабЧасти = Новый Массив;
	
	ТабДок = Новый ТабличныйДокумент;
	
	ТабДок.ИмяПараметровПечати = "ИС_Сбер_ПечатьРеестраПриемаПередачи";
	ТабДок.ОриентацияСтраницы = ОриентацияСтраницы.Портрет;  
	ТабДок.АвтоМасштаб = Истина;
	
	Макет = УправлениеПечатью.МакетПечатнойФормы("Документ.ИС_Сбер_Отправление.ПФ_MXL_РеестрПриемаПередачи");
	
	МассивПараметров = Новый Массив;
	МассивПараметров.Добавить("СберИдКабинета");
	МассивПараметров.Добавить("СберКонтрагент");
	МассивПараметров.Добавить("СберДоговор");
	
	ДанныеПрофиля = ИС_MP_Сервер.ПолучитьНастройки(Профиль, МассивПараметров);  
	
	ДанныеШапки = Новый Структура("НомерДокумента, ДатаДокумента, Исполнитель, Заказчик, Договор");
	
	ДанныеШапки.ДатаДокумента  = Формат(ТекущаяДата(),"ДФ=dd.MM.yyyy") + ".г";
	ДанныеШапки.НомерДокумента = Формат(ДанныеПрофиля["СберИдКабинета"], "ЧГ=0") + Формат(ТекущаяДата(),"ДФ=ддММгггг"); 
	ДанныеШапки.Исполнитель    = ДанныеПрофиля["СберКонтрагент"].Наименование;
	ДанныеШапки.Заказчик       = Профиль.Организация.Наименование;
	ДанныеШапки.Договор        = ДанныеПрофиля["СберДоговор"].Наименование;
	
	ОбластьМакета = Макет.ПолучитьОбласть("Шапка");
	ОбластьМакета.Параметры.Заполнить(ДанныеШапки);
	
	ТабДок.Вывести(ОбластьМакета); 
	
	ОбластьМакета = Макет.ПолучитьОбласть("ШапкаТаблицы");
	ТабДок.Вывести(ОбластьМакета);
	
	ОбластьМакетаОтправление   = Макет.ПолучитьОбласть("Строка|ОбластьОтправление");
	ОбластьМакетаГрузовоеМесто = Макет.ПолучитьОбласть("Строка|ОбластьГрузовоеМесто");
	ОбластьМакетаЕдиница       = Макет.ПолучитьОбласть("Строка|ОбластьЕдиницаОтправления");
	ОбластьМакетаСтоимость     = Макет.ПолучитьОбласть("Строка|ОбластьСтоимостьОтправления");
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ИС_Сбер_Отправление.Ссылка.Номер КАК НомерОтправления
		|ИЗ
		|	Документ.ИС_Сбер_Отправление КАК ИС_Сбер_Отправление
		|ГДЕ
		|	ИС_Сбер_Отправление.Ссылка В(&МассивОтправлений)
		|
		|УПОРЯДОЧИТЬ ПО
		|	НомерОтправления";
	
	Запрос.УстановитьПараметр("МассивОтправлений", ВыделенныеСтроки);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Выборка = РезультатЗапроса.Выбрать(); 
	
	МассивОтправлений = Новый Массив;
	
	Пока Выборка.Следующий() Цикл
		МассивОтправлений.Добавить(Выборка.НомерОтправления);
	КонецЦикла;

	ДанныеОтправлений = ИС_Сбер_Сервер.ПолучитьДанныеОтправлений(Профиль, МассивОтправлений); 

	Если ДанныеОтправлений = Неопределено Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не удалось получить данные отправлений с сервера!");
		Возврат Неопределено;
	КонецЕсли;	
	
	ДанныеПодвалаТаблицы = Новый Структура("ИтогоСтрок, ИтогоКоличество, ИтогоСтоимость, ИтогоСтоимостьСоСкидкой", 0, 0, 0, 0);
	
	НомерПП = 0;
	
	Для Каждого Отправление Из ДанныеОтправлений Цикл     
		
		НомерПП = НомерПП + 1;
		
		СтоимостьОтправленияСоСкидкой = 0;
		
		ОбластьМакетаОтправление   = Макет.ПолучитьОбласть("Строка|ОбластьОтправление");
		ОбластьМакетаГрузовоеМесто = Макет.ПолучитьОбласть("Строка|ОбластьГрузовоеМесто");
		ОбластьМакетаЕдиница       = Макет.ПолучитьОбласть("Строка|ОбластьЕдиницаОтправления");
		ОбластьМакетаСтоимость     = Макет.ПолучитьОбласть("Строка|ОбластьСтоимостьОтправления");
		
		ОбластьМакетаОтправление.Параметры.НомерПП             = НомерПП;
		ОбластьМакетаОтправление.Параметры.НомерДоставки       = Отправление.deliveryId;
		ОбластьМакетаОтправление.Параметры.НомерОтправления    = Отправление.shipmentId;
		ОбластьМакетаОтправление.Параметры.НомерЗаказаПродавца = Отправление.orderCode;
		
		НаборЛотов = Отправление.items;
		
		ТаблицаГрузовыхМест = ПолучитьКоличествоГрузовыхМест(НаборЛотов);
		
		СписокГрузовыхМест = ТаблицаГрузовыхМест.Скопировать(,"ИдентификаторГрузовогоМеста");
		СписокГрузовыхМест.Свернуть("ИдентификаторГрузовогоМеста");
		
		ТабДокОтправление = Новый ТабличныйДокумент;
		ТабДокОтправление.Вывести(ОбластьМакетаОтправление);
		
		КоличествоСтрок = 0;
		
		ТабДокГрузовыеМеста = Новый ТабличныйДокумент;
		
		Для Каждого ГрузовоеМесто Из СписокГрузовыхМест Цикл
			
			ИдентификаторГрузовогоМеста = Формат(ДанныеПрофиля["СберИдКабинета"], "ЧГ=0") + "*" + Отправление.orderCode 
				+ "*" + ГрузовоеМесто.ИдентификаторГрузовогоМеста;
			
			ОбластьМакетаГрузовоеМесто.Параметры.ИдентификаторГрузовогоМеста = ИдентификаторГрузовогоМеста;
			
			ЕдиницыГрузовогоМеста = ТаблицаГрузовыхМест.НайтиСтроки(Новый Структура("ИдентификаторГрузовогоМеста", ГрузовоеМесто.ИдентификаторГрузовогоМеста));
			
			КоличествоЕдиниц = 0;
			
			ТабДокЕдиницы = Новый ТабличныйДокумент;
			
			Для Каждого Единица Из ЕдиницыГрузовогоМеста Цикл 
				
				КоличествоЕдиниц = КоличествоЕдиниц + 1;
				
				ОбластьМакетаЕдиница.Параметры.Количество = Единица.Количество;
				ОбластьМакетаЕдиница.Параметры.Стоимость  = Единица.Стоимость;
				
				ДанныеПодвалаТаблицы.ИтогоКоличество = ДанныеПодвалаТаблицы.ИтогоКоличество + Единица.Количество;
				ДанныеПодвалаТаблицы.ИтогоСтоимость  = ДанныеПодвалаТаблицы.ИтогоСтоимость + Единица.Стоимость;
				
				СтоимостьОтправленияСоСкидкой = СтоимостьОтправленияСоСкидкой + Единица.СтоимостьСоСкидкой;
				
				ТабДокЕдиницы.Вывести(ОбластьМакетаЕдиница); 
				
			КонецЦикла;
			
			КоличествоСтрок = КоличествоСтрок + КоличествоЕдиниц;
			
			ОбластьМакетаГрузовоеМесто.Область("R1C1:R" + КоличествоЕдиниц + "C1").Объединить();
			
			ТабДокГрузовыеМеста.Вывести(ОбластьМакетаГрузовоеМесто);
			ТабДокГрузовыеМеста.Присоединить(ТабДокЕдиницы);
			
		КонецЦикла;
		
		ДанныеПодвалаТаблицы.ИтогоСтоимостьСоСкидкой = ДанныеПодвалаТаблицы.ИтогоСтоимостьСоСкидкой + СтоимостьОтправленияСоСкидкой;
		
		ТабДокОтправление.Присоединить(ТабДокГрузовыеМеста);
		
		ОбластьМакетаСтоимость.Параметры.СтоимостьСоСкидкой = СтоимостьОтправленияСоСкидкой;
		ТабДокОтправление.Присоединить(ОбластьМакетаСтоимость);
		
		ТабДокОтправление.Область("R1C1:R" + КоличествоСтрок + "C1").Объединить();
		ТабДокОтправление.Область("R1C2:R" + КоличествоСтрок + "C2").Объединить();
		ТабДокОтправление.Область("R1C3:R" + КоличествоСтрок + "C3").Объединить();
		ТабДокОтправление.Область("R1C4:R" + КоличествоСтрок + "C4").Объединить();
		ТабДокОтправление.Область("R1C5:R" + КоличествоСтрок + "C5").Объединить();
		ТабДокОтправление.Область("R1C9:R" + КоличествоСтрок + "C9").Объединить();
		
		ТабДокОтправление.Область("R1C9:R1C9").ГраницаСправа = Новый Линия(ТипЛинииЯчейкиТабличногоДокумента.Сплошная);
		
		ТабДок.Вывести(ТабДокОтправление);
		
	КонецЦикла;
	
	ДанныеПодвалаТаблицы.ИтогоСтрок = НомерПП;
	
	ОбластьМакета = Макет.ПолучитьОбласть("ПодвалТаблицы");
	ОбластьМакета.Параметры.Заполнить(ДанныеПодвалаТаблицы); 
	ТабДок.Вывести(ОбластьМакета);
	
	ОбластьМакета = Макет.ПолучитьОбласть("Подвал");
	ОбластьМакета.Параметры.Заполнить(ДанныеШапки); 
	ТабДок.Вывести(ОбластьМакета);
	
	Возврат ТабДок;
	
КонецФункции //- ИнфоСофт Стояк Ю.К. 03.06.2024 УА #76167

//+ ИнфоСофт Стояк Ю.К. 03.06.2024 УА #76167
&НаСервере
Функция ПолучитьКоличествоГрузовыхМест(НаборЛотов);
	
	ТаблицаГрузовыхМест = Новый ТаблицаЗначений;
	ТаблицаГрузовыхМест.Колонки.Добавить("ИдентификаторГрузовогоМеста");
	ТаблицаГрузовыхМест.Колонки.Добавить("Количество");
	ТаблицаГрузовыхМест.Колонки.Добавить("Стоимость");
	ТаблицаГрузовыхМест.Колонки.Добавить("СтоимостьСоСкидкой");
	
	Для Каждого Лот Из НаборЛотов Цикл
		
		НоваяСтрока = ТаблицаГрузовыхМест.Добавить();
		НоваяСтрока.ИдентификаторГрузовогоМеста = ?(Лот.boxIndex = "", "1", Лот.boxIndex);
		НоваяСтрока.Количество                  = Лот.quantity;
		НоваяСтрока.Стоимость                   = Лот.price;
		НоваяСтрока.СтоимостьСоСкидкой          = Лот.finalPrice;
		
	КонецЦикла;
	
	ТаблицаГрузовыхМест.Сортировать("ИдентификаторГрузовогоМеста Возр");
	
	Возврат ТаблицаГрузовыхМест;
	
КонецФункции //- ИнфоСофт Стояк Ю.К. 03.06.2024 УА #76167

//+ ИнфоСофт Стояк Ю.К. 05.11.2024 УА #70035
&НаСервере
Функция ПолучитьТоварныйЧек(ВыделенныеСтроки)
	
	ТабДок = Новый ТабличныйДокумент;
	
	ТабДок.ИмяПараметровПечати = "ИС_Сбер_ПечатьТоварногоЧека";
	ТабДок.ОриентацияСтраницы = ОриентацияСтраницы.Портрет;  
	ТабДок.АвтоМасштаб = Истина;
	
	Макет = УправлениеПечатью.МакетПечатнойФормы("Документ.ИС_Сбер_Отправление.ПФ_MXL_ТоварныйЧек"); 
	
	ОбластьМакетаШапка			= Макет.ПолучитьОбласть("Шапка");
	ОбластьМакетаЗаголовок		= Макет.ПолучитьОбласть("Заголовок");
	ОбластьМакетаШапкаТаблицы   = Макет.ПолучитьОбласть("ШапкаТаблицы");
	ОбластьМакетаСтрокаТаблицы  = Макет.ПолучитьОбласть("СтрокаТаблицы");
	ОбластьМакетаИтого	        = Макет.ПолучитьОбласть("Итого");
	ОбластьМакетаИнформация     = Макет.ПолучитьОбласть("ИнформацияОВозврате");
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ИС_Сбер_Отправлениеitems.НоменклатураМегаМаркета КАК Товар,
		|	ИС_Сбер_Отправлениеitems.quantity КАК Количество,
		|	ИС_Сбер_Отправлениеitems.finalPrice КАК Цена,
		|	ИС_Сбер_Отправлениеitems.quantity * ИС_Сбер_Отправлениеitems.finalPrice КАК Сумма,
		|	ИС_Сбер_Отправлениеitems.offerId КАК Артикул,
		|	ИС_Сбер_Отправлениеitems.Ссылка.customerAddress КАК АдресПокупателя,
		|	ИС_Сбер_Отправлениеitems.Ссылка.customerFullName КАК ФИОПокупателя,
		|	ИС_Сбер_Отправлениеitems.Ссылка.Профиль.Организация КАК Организация,
		|	ИС_Сбер_Отправлениеitems.Ссылка.orderCode КАК НомерЧека
		|ИЗ
		|	Документ.ИС_Сбер_Отправление.items КАК ИС_Сбер_Отправлениеitems
		|ГДЕ
		|	ИС_Сбер_Отправлениеitems.Ссылка В(&МассивОтправлений)
		|ИТОГИ ПО
		|	НомерЧека";
	
	Запрос.УстановитьПараметр("МассивОтправлений", ВыделенныеСтроки);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаНомерОтправления = РезультатЗапроса.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам, "НомерЧека");
	
	МассивОтправлений = Новый Массив;
	
	Пока ВыборкаНомерОтправления.Следующий() Цикл 
		
		ВыборкаСтрок = ВыборкаНомерОтправления.Выбрать();
		ДанныеПодвалаТаблицы = Новый Структура("КоличествоСтрок, СуммаИтого", 0, 0);
		НомерСтроки = 1;
		
		ЗаполнениеОсновныхПараметров = Истина;
		
		Пока ВыборкаСтрок.Следующий() Цикл   
			
			Если ЗаполнениеОсновныхПараметров Тогда
				
				ЗаполнитьЗначенияСвойств(ОбластьМакетаЗаголовок.Параметры, ВыборкаСтрок); 
				ОбластьМакетаЗаголовок.Параметры.Дата = ТекущаяДатаСеанса();	
				ТабДок.Вывести(ОбластьМакетаЗаголовок);			
				
				ЗаполнитьЗначенияСвойств(ОбластьМакетаШапка.Параметры, ВыборкаСтрок); 				
				ТабДок.Вывести(ОбластьМакетаШапкаТаблицы);  
				
				ЗаполнитьЗначенияСвойств(ОбластьМакетаИтого.Параметры, ВыборкаСтрок); 												
				ЗаполнениеОсновныхПараметров = Ложь;
				
			КонецЕсли;
			
			ЗаполнитьЗначенияСвойств(ОбластьМакетаСтрокаТаблицы.Параметры, ВыборкаСтрок); 
			ОбластьМакетаСтрокаТаблицы.Параметры.НомерСтроки = НомерСтроки;
			НомерСтроки = НомерСтроки + 1;
			ТабДок.Вывести(ОбластьМакетаСтрокаТаблицы);
			
			ДанныеПодвалаТаблицы.КоличествоСтрок = ДанныеПодвалаТаблицы.КоличествоСтрок + 1;
			ДанныеПодвалаТаблицы.СуммаИтого  = ДанныеПодвалаТаблицы.СуммаИтого + ВыборкаСтрок.Сумма;						
						
		КонецЦикла;                                                                                 
		
		ЗаполнитьЗначенияСвойств(ОбластьМакетаИтого.Параметры, ДанныеПодвалаТаблицы); 
		ФормСтрока = "Л = ru_RU; ДП = Истина";
		ПарПредмета="рубль, рубля, рублей, м, копейка, копейки, копеек, ж";
		
		ОбластьМакетаИтого.Параметры.ТекстовоеПредставлениеСуммы = ЧислоПрописью(ДанныеПодвалаТаблицы.СуммаИтого, ФормСтрока, ПарПредмета);
		
		ТабДок.Вывести(ОбластьМакетаИтого);
		
		ТабДок.Вывести(ОбластьМакетаИнформация);
		
		ТабДок.ВывестиГоризонтальныйРазделительСтраниц();
			
	КонецЦикла;

		
	Возврат ТабДок; 
	
КонецФункции //- ИнфоСофт Стояк Ю.К. 05.11.2024 УА #70035

//+ ИнфоСофт Заварин К.В. 13.11.24 УА #85881
&НаСервере
Процедура ПометитьНаУдалениеПривязанныеДокументыНаСервере()
	
	Событие = "ИС_Сбер_Отправление.ПометитьНаУдалениеПривязанныеДокументыНаСервере";
	
	ВыделенныеСтроки = Элементы.Список.ВыделенныеСтроки;
	
	Для Каждого Строка Из ВыделенныеСтроки Цикл
		
		ИС_MP_РаботаСЗаказами.ПометитьНаУдалениеПривязанныеДокументы(Строка.Заказ);
		
		СтрокаСборочноеЗадание = Строка.ПолучитьОбъект();
		
		СтрокаСборочноеЗадание.ПометкаУдаления = Истина; 			
		
		Попытка	
			СтрокаСборочноеЗадание.Записать();
		Исключение 
			
			Текст = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
			ИС_MP_Сервер.ЗаписатьВЖРИСообщитьПользователю(Событие, Текст);
			
		КонецПопытки;
		
	КонецЦикла;
	
КонецПроцедуры //- ИнфоСофт Заварин К.В. 13.11.24 УА #85881

#КонецОбласти
