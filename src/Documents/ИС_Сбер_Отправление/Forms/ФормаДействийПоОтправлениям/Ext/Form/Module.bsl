

#Область ОбработчикиСобытийФормы

//+ ИнфоСофт Ивонин К.А. 13.02.24 УА #67209
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	Если Не Параметры.Свойство("Действие") Тогда
		ОбщегоНазначения.СообщитьПользователю("Не заполнено действие");
		Возврат;
	КонецЕсли;
	
	Действие = Параметры.Действие;
	
	Если Параметры.Свойство("Профиль") Тогда
		Профиль = Параметры.Профиль;
	КонецЕсли;
	
	Если Параметры.Свойство("МассивОтправлений") И ТипЗнч(Параметры.МассивОтправлений) = Тип("Массив") Тогда
		ЗаполнитьТаблицуЛотов(Параметры.МассивОтправлений);
	КонецЕсли;
	
КонецПроцедуры //- ИнфоСофт Ивонин К.А. 13.02.24 УА #67209

