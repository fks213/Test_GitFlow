//+ ИнфоСофт Ивонин К.А. 17.02.24 УА #67209
&НаСервере   
Процедура ЗаполнитьТаблицуЛотов(МассивОтправлений)
	                                             	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ИС_MP_Настройки.Значение КАК Значение
	|ПОМЕСТИТЬ ВТ_ИдКабинета
	|ИЗ
	|	Справочник.ИС_MP_Настройки КАК ИС_MP_Настройки
	|ГДЕ
	|	ИС_MP_Настройки.ЛичныйКабинет = &Профиль
	|	И ИС_MP_Настройки.Наименование = ""СберИдКабинета""
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ИС_Сбер_Отправлениеitems.Ссылка КАК Отправление,
	|	ИС_Сбер_Отправлениеitems.Ссылка.Номер КАК Номер,
	|	ИС_Сбер_Отправлениеitems.itemIndex КАК ПорядковыйНомер,
	|	ИС_Сбер_Отправлениеitems.offerId КАК Артикул,
	|	ИС_Сбер_Отправлениеitems.НоменклатураМегаМаркета КАК НоменклатураМегаМаркета,
	|	ИС_Сбер_Отправлениеitems.Ссылка.Заказ.Номер КАК ЗаказНомер,
	|	ИС_Сбер_Отправлениеitems.Ссылка.orderCode КАК orderCode,
	|   ИС_Сбер_Отправлениеitems.itemIndex КАК НомерКороба,
	|	ВТ_ИдКабинета.Значение КАК ИдКабинета
	|ИЗ
	|	Документ.ИС_Сбер_Отправление.items КАК ИС_Сбер_Отправлениеitems
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_ИдКабинета КАК ВТ_ИдКабинета
	|		ПО (ИСТИНА)
	|ГДЕ
	|	ИС_Сбер_Отправлениеitems.Ссылка В(&Ссылка)";
	
	Запрос.УстановитьПараметр("Профиль", Профиль);
	Запрос.УстановитьПараметр("Ссылка", МассивОтправлений);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаОтправлений = РезультатЗапроса.Выбрать(); 
	
	//+ ИнфоСофт Сумин Д.В. 19.02.2024 УА #62568	
	Если Действие = "Скомплектовать" Тогда
		КодыМаркировкиТЗ = ПолучитьКодыМаркировкиОтправлений(МассивОтправлений);	
	КонецЕсли;	
	//- ИнфоСофт Сумин Д.В. 19.02.2024 УА #62568
	
	Пока ВыборкаОтправлений.Следующий() Цикл
    
    	НоваяСтрока = ТаблицаЛотов.Добавить();
    	ЗаполнитьЗначенияСвойств(НоваяСтрока, ВыборкаОтправлений);
    	
    	Если Действие = "Скомплектовать" Или Действие = "Отгрузить" Тогда
		
			НоваяСтрока.НомерЗаказа = ВыборкаОтправлений.orderCode;
			НоваяСтрока.КодКороба = СтрШаблон("%1*%2*%3", ВыборкаОтправлений.ИдКабинета, 
				ВыборкаОтправлений.orderCode, ВыборкаОтправлений.НомерКороба);
			
			//+ ИнфоСофт Сумин Д.В. 19.02.2024 УА #62568	
			Если Действие = "Скомплектовать" Тогда
				Для Каждого Строка Из КодыМаркировкиТЗ Цикл
					Если Строка.СберОтправление = НоваяСтрока.Отправление И Строка.НоменклатураМегаМаркета = НоваяСтрока.НоменклатураМегаМаркета Тогда
						НоваяСтрока.КодМаркировки = Строка.ЗначениеШтрихкода; 
						КодыМаркировкиТЗ.Удалить(Строка);
						Прервать;
					КонецЕсли;	
				КонецЦикла;	
			КонецЕсли;	
			//- ИнфоСофт Сумин Д.В. 19.02.2024 УА #62568
		
		Иначе
			
			Если ЗначениеЗаполнено(ВыборкаОтправлений.ЗаказНомер) Тогда
				МассивЭлементов = СтрРазделить(ВыборкаОтправлений.ЗаказНомер, "-");
				НоваяСтрока.НомерЗаказа = СтрШаблон("%1%2", 
				Формат(Год(ТекущаяДатаСеанса()), "ЧГ=0"), МассивЭлементов[МассивЭлементов.ВГраница()]);
	    	КонецЕсли;
    	
    	КонецЕсли;
    	
	КонецЦикла;
	
	ДатаОтгрузки = ТекущаяДатаСеанса();
	
КонецПроцедуры //- ИнфоСофт Ивонин К.А. 17.02.24 УА #67209

//+ ИнфоСофт Ивонин К.А. 20.05.24 УА #75485
&НаКлиенте
Процедура ОбновитьНомерКороба(ТекДанные)

	ТекДанные.КодКороба = СтрШаблон("%1*%2*%3", ТекДанные.ИдКабинета, 
		ТекДанные.НомерЗаказа, ТекДанные.НомерКороба);

КонецПроцедуры //- ИнфоСофт Ивонин К.А. 20.05.24 УА #75485

//+ ИнфоСофт Ивонин К.А. 17.02.24 УА #67209
&НаКлиенте
Процедура УправлениеФормой()
    
    Элементы.ПричинаОтмены.Видимость = Ложь;
    Элементы.ТаблицаЛотовНомерЗаказа.Видимость = Ложь;
    Элементы.ТаблицаЛотовНомерКороба.Видимость = Ложь;
    Элементы.ТаблицаЛотовКодКороба.Видимость = Ложь;
    Элементы.ТаблицаЛотовКодМаркировки.Видимость = Ложь;
    Элементы.ТаблицаЛотовРазбитьНаКороба.Видимость = Ложь;
    Элементы.ДатаОтгрузки.Видимость = Ложь;
    
	Если Действие = "Подтвердить" Тогда
		Заголовок = "Подтверждение лотов";
		Элементы.ТаблицаЛотовНомерЗаказа.Видимость = Истина;
		Элементы.ФормаВыполнитьДействие.Заголовок = "Подтвердить лоты";
	ИначеЕсли Действие = "Скомплектовать" Тогда
		Заголовок = "Комлектация лотов";
		Элементы.ТаблицаЛотовНомерЗаказа.Видимость = Истина;
		Элементы.ТаблицаЛотовНомерКороба.Видимость = Истина;
		Элементы.ТаблицаЛотовКодКороба.Видимость = Истина;
		Элементы.ТаблицаЛотовКодМаркировки.Видимость = Истина;
		Элементы.ТаблицаЛотовРазбитьНаКороба.Видимость = Истина;
		Элементы.ФормаВыполнитьДействие.Заголовок = "Комплектовать лоты";		
	ИначеЕсли Действие = "Отгрузить" Тогда
		Заголовок = "Отгрузка лотов";
		Элементы.ДатаОтгрузки.Видимость = Истина;
		Элементы.ФормаВыполнитьДействие.Заголовок = "Отгрузить лоты";
	ИначеЕсли Действие = "Отменить" Тогда
		Заголовок = "Отмена лотов";
		Элементы.ПричинаОтмены.Видимость = Истина;
		Элементы.ФормаВыполнитьДействие.Заголовок = "Отменить лоты";
	КонецЕсли;

КонецПроцедуры //- ИнфоСофт Ивонин К.А. 17.02.24 УА #67209

//+ ИнфоСофт Ивонин К.А. 17.02.24 УА #67209
&НаСервере   
Процедура ВыполнитьДействиеНаСервере()

	Если Действие = "Подтвердить" Тогда
		
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	ТЧ.Номер КАК Номер,
		|	ТЧ.НомерЗаказа КАК НомерЗаказа,
		|	ТЧ.ПорядковыйНомер КАК ПорядковыйНомер,
		|	ТЧ.Артикул КАК Артикул
		|ПОМЕСТИТЬ ВТ_ТЧ
		|ИЗ
		|	&ТЧ КАК ТЧ
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ВТ_ТЧ.Номер КАК Номер,
		|	ВТ_ТЧ.НомерЗаказа КАК НомерЗаказа,
		|	ВТ_ТЧ.ПорядковыйНомер КАК ПорядковыйНомер,
		|	ВТ_ТЧ.Артикул КАК Артикул
		|ИЗ
		|	ВТ_ТЧ КАК ВТ_ТЧ
		|ИТОГИ ПО
		|	Номер,
		|	НомерЗаказа";

		Запрос.УстановитьПараметр("ТЧ", ТаблицаЛотов.Выгрузить(, "Номер, ПорядковыйНомер, Артикул, НомерЗаказа"));
				
		РезультатЗапроса = Запрос.Выполнить();
		
		ВыборкаНомер = РезультатЗапроса.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
		
		МассивShipments = Новый Массив;
		
		Пока ВыборкаНомер.Следующий() Цикл
            
            СтруктураShipment = Новый Структура;
		    СтруктураShipment.Вставить("shipmentId", ВыборкаНомер.Номер);
		
			ВыборкаНомерЗаказа = ВыборкаНомер.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
		
			Пока ВыборкаНомерЗаказа.Следующий() Цикл
				
				СтруктураShipment.Вставить("orderCode", ВыборкаНомерЗаказа.НомерЗаказа);
						
				МассивItems = Новый Массив;
				ВыборкаЛотов = ВыборкаНомерЗаказа.Выбрать();
		
				Пока ВыборкаЛотов.Следующий() Цикл
                
	                СтруктураItem = Новый Структура;
	                СтруктураItem.Вставить("itemIndex", ВыборкаЛотов.ПорядковыйНомер);
	                СтруктураItem.Вставить("offerId", ВыборкаЛотов.Артикул);
	            
	            	МассивItems.Добавить(СтруктураItem);
            
				КонецЦикла;
			
				СтруктураShipment.Вставить("items", МассивItems);
			
			КонецЦикла;
		
			МассивShipments.Добавить(СтруктураShipment);
			
		КонецЦикла;
				
		ИС_Сбер_Сервер.ПодтвердитьЛоты(Профиль, МассивShipments);
		
	ИначеЕсли Действие = "Скомплектовать" Тогда	
	
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	ТЧ.Номер КАК Номер,
		|	ТЧ.НомерЗаказа КАК НомерЗаказа,
		|	ТЧ.ПорядковыйНомер КАК ПорядковыйНомер,
		|	ТЧ.Артикул КАК Артикул,
		|	ТЧ.НомерКороба КАК НомерКороба,
		|	ТЧ.КодКороба КАК КодКороба,
		|	ТЧ.КодМаркировки КАК КодМаркировки
		|ПОМЕСТИТЬ ВТ_ТЧ
		|ИЗ
		|	&ТЧ КАК ТЧ
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ВТ_ТЧ.Номер КАК Номер,
		|	ВТ_ТЧ.НомерЗаказа КАК НомерЗаказа,
		|	ВТ_ТЧ.ПорядковыйНомер КАК ПорядковыйНомер,
		|	ВТ_ТЧ.Артикул КАК Артикул,
		|	ВТ_ТЧ.НомерКороба КАК НомерКороба,
		|	ВТ_ТЧ.КодКороба КАК КодКороба,
		|	ВТ_ТЧ.КодМаркировки КАК КодМаркировки
		|ИЗ
		|	ВТ_ТЧ КАК ВТ_ТЧ
		|ИТОГИ ПО
		|	Номер,
		|	НомерЗаказа";

		Запрос.УстановитьПараметр("ТЧ", ТаблицаЛотов.Выгрузить( , 
			"Номер, ПорядковыйНомер, Артикул, НомерЗаказа, НомерКороба, КодКороба, КодМаркировки"));
				
		РезультатЗапроса = Запрос.Выполнить();
		
		ВыборкаНомер = РезультатЗапроса.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
		
		МассивShipments = Новый Массив;
		
		Пока ВыборкаНомер.Следующий() Цикл
            
            СтруктураShipment = Новый Структура;
		    СтруктураShipment.Вставить("shipmentId", ВыборкаНомер.Номер);
		
			ВыборкаНомерЗаказа = ВыборкаНомер.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
		
			Пока ВыборкаНомерЗаказа.Следующий() Цикл
				
				СтруктураShipment.Вставить("orderCode", ВыборкаНомерЗаказа.НомерЗаказа);
						
				МассивItems = Новый Массив;
				ВыборкаЛотов = ВыборкаНомерЗаказа.Выбрать();
		
				Пока ВыборкаЛотов.Следующий() Цикл
                
	                СтруктураItem = Новый Структура;
	                СтруктураItem.Вставить("itemIndex", ВыборкаЛотов.ПорядковыйНомер);
					
					МассивBoxes = Новый Массив;
					
					СтруктураBoxes = Новый Структура;
					СтруктураBoxes.Вставить("boxIndex", Формат(ВыборкаЛотов.НомерКороба, "ЧГ=0"));
					СтруктураBoxes.Вставить("boxCode", ВыборкаЛотов.КодКороба);
					
					МассивBoxes.Добавить(СтруктураBoxes);
					СтруктураItem.Вставить("boxes", МассивBoxes);
					
					Если ЗначениеЗаполнено(ВыборкаЛотов.КодМаркировки) Тогда
						СтруктураItem.Вставить("digitalMark", ВыборкаЛотов.КодМаркировки);
					КонецЕсли;
						            
	            	МассивItems.Добавить(СтруктураItem);
            
				КонецЦикла;
			
				СтруктураShipment.Вставить("items", МассивItems);
			
			КонецЦикла;
		
			МассивShipments.Добавить(СтруктураShipment);
			
		КонецЦикла;
				
		ИС_Сбер_Сервер.СкомплектоватьЛоты(Профиль, МассивShipments);
		
	ИначеЕсли Действие = "Отгрузить" Тогда	
	
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	ТЧ.Номер КАК Номер,
		|	ТЧ.НомерКороба КАК НомерКороба,
		|	ТЧ.КодКороба КАК КодКороба
		|ПОМЕСТИТЬ ВТ_ТЧ
		|ИЗ
		|	&ТЧ КАК ТЧ
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ВТ_ТЧ.Номер КАК Номер,
		|	ВТ_ТЧ.НомерКороба КАК НомерКороба,
		|	ВТ_ТЧ.КодКороба КАК КодКороба
		|ИЗ
		|	ВТ_ТЧ КАК ВТ_ТЧ
		|ИТОГИ ПО
		|	Номер";

		Запрос.УстановитьПараметр("ТЧ", ТаблицаЛотов.Выгрузить( , 
			"Номер, НомерКороба, КодКороба"));
				
		РезультатЗапроса = Запрос.Выполнить();
		
		ВыборкаНомер = РезультатЗапроса.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
		
		МассивShipments = Новый Массив;
		
		Пока ВыборкаНомер.Следующий() Цикл
            
            СтруктураShipment = Новый Структура;
		    СтруктураShipment.Вставить("shipmentId", ВыборкаНомер.Номер);
						
			ВыборкаЛотов = ВыборкаНомер.Выбрать();
			
			//+ ИнфоСофт Стояк Ю.К. 03.10.2024 УА #84840
			МассивBoxes = Новый Массив;
			//- ИнфоСофт Стояк Ю.К. 03.10.2024 УА #84840
	
			Пока ВыборкаЛотов.Следующий() Цикл							
				
				//+ ИнфоСофт Стояк Ю.К. 03.10.2024 УА #84840				
				//МассивBoxes = Новый Массив;               
				//- ИнфоСофт Стояк Ю.К. 03.10.2024 УА #84840
				
				СтруктураBoxes = Новый Структура;
				СтруктураBoxes.Вставить("boxIndex", Формат(ВыборкаЛотов.НомерКороба, "ЧГ=0"));
				СтруктураBoxes.Вставить("boxCode", ВыборкаЛотов.КодКороба);
				
				МассивBoxes.Добавить(СтруктураBoxes);
				        
			КонецЦикла;
			
			СтруктураShipment.Вставить("boxes", МассивBoxes);
			
			СтруктураShipping = Новый Структура;
			СтруктураShipping.Вставить("shippingDate", 
				ИС_MP_РаботаСHTTPЗапросамиСервер.ЗаписатьДатуВJSON(ДатаОтгрузки, ФорматДатыJSON.ISO, ВариантЗаписиДатыJSON.УниверсальнаяДата));
			СтруктураShipment.Вставить("shipping", СтруктураShipping);
			
			МассивShipments.Добавить(СтруктураShipment);
			
		КонецЦикла;
				
		ИС_Сбер_Сервер.ОтгрузитьЛоты(Профиль, МассивShipments);
	
	ИначеЕсли Действие = "Отменить" Тогда
		
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	ТЧ.Номер КАК Номер,
		|	ТЧ.ПорядковыйНомер КАК ПорядковыйНомер,
		|	ТЧ.Артикул КАК Артикул
		|ПОМЕСТИТЬ ВТ_ТЧ
		|ИЗ
		|	&ТЧ КАК ТЧ
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ВТ_ТЧ.Номер КАК Номер,
		|	ВТ_ТЧ.ПорядковыйНомер КАК ПорядковыйНомер,
		|	ВТ_ТЧ.Артикул КАК Артикул
		|ИЗ
		|	ВТ_ТЧ КАК ВТ_ТЧ
		|ИТОГИ ПО
		|	Номер";
		
		Запрос.УстановитьПараметр("ТЧ", ТаблицаЛотов.Выгрузить(, "Номер, ПорядковыйНомер, Артикул"));
		
		РезультатЗапроса = Запрос.Выполнить();
		
		ВыборкаНомер = РезультатЗапроса.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
		
		МассивShipments = Новый Массив;
		
		Пока ВыборкаНомер.Следующий() Цикл
		    
		    СтруктураShipment = Новый Структура;
		    СтруктураShipment.Вставить("shipmentId", ВыборкаНомер.Номер);
		    
		    МассивItems = Новый Массив;
		    
			ВыборкаЛотов = ВыборкаНомер.Выбрать();
		
			Пока ВыборкаЛотов.Следующий() Цикл
                
                СтруктураItem = Новый Структура;
                СтруктураItem.Вставить("itemIndex", ВыборкаЛотов.ПорядковыйНомер);
                СтруктураItem.Вставить("offerId", ВыборкаЛотов.Артикул);
            
            	МассивItems.Добавить(СтруктураItem);
            
			КонецЦикла;
			
			СтруктураShipment.Вставить("items", МассивItems);
			МассивShipments.Добавить(СтруктураShipment);
			
		КонецЦикла;
		
		СтруктураReason = Новый Структура;
		СтруктураReason.Вставить("type", Строка(XMLСтрока(ПричинаОтмены)));
		
		ИС_Сбер_Сервер.ОтменитьЛоты(Профиль, МассивShipments, СтруктураReason);
		
	КонецЕсли;	
	
КонецПроцедуры //- ИнфоСофт Ивонин К.А. 17.02.24 УА #67209

//+ ИнфоСофт Ивонин К.А. 19.02.24 УА #67029
&НаКлиенте
Процедура РазбитьНаКоробаЗавершение(Результат, ДопПараметры) Экспорт

	Если Результат = Неопределено Или Результат < 2 Тогда
		Возврат;
	КонецЕсли;
	
	ТекДанные = Элементы.ТаблицаЛотов.ТекущиеДанные;
	
	Для Итер = 2 По Результат Цикл
		
		НоваяСтрока = ТаблицаЛотов.Вставить(Элементы.ТаблицаЛотов.ТекущаяСтрока);
		ЗаполнитьЗначенияСвойств(НоваяСтрока, ТекДанные);
		НоваяСтрока.НомерКороба	= Итер;
    	НоваяСтрока.КодКороба = СтрШаблон("%1*%2*%3", НоваяСтрока.ИдКабинета, 
			НоваяСтрока.orderCode, НоваяСтрока.НомерКороба);
		
	КонецЦикла;
                   
	ТаблицаЛотов.Сортировать("НомерЗаказа, НомерКороба");
                   
КонецПроцедуры //- ИнфоСофт Ивонин К.А. 19.02.24 УА #67029

