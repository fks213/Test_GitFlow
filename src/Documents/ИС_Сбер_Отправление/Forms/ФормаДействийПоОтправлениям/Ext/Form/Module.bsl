//+ ИнфоСофт Ивонин К.А. 17.02.24 УА #67209
&НаКлиенте
Процедура ВыполнитьДействие(Команда)
	
	ОчиститьСообщения();
	
	Если Не ЗначениеЗаполнено(Профиль) Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю("Не выбран ""Профиль""", , , "Профиль");
		Возврат;
	КонецЕсли;
	
	Если Действие = "Подтвердить" Тогда
	    
	    // На этапе подтверждения можно не указывать номера заказов
		//Для Каждого Строка Из ТаблицаЛотов Цикл          		
		//	Если Не ЗначениеЗаполнено(Строка.НомерЗаказа) Тогда
		//	    ОбщегоНазначенияКлиент.СообщитьПользователю("Не заполнен ""Номер заказа""", , "ТаблицаЛотов[" + Строка.ПолучитьИдентификатор() + "].НомерЗаказа");
		//		Возврат;
		//	КонецЕсли;
		//
		//КонецЦикла;
		
	ИначеЕсли Действие = "Скомплектовать" Тогда
	
		Для Каждого Строка Из ТаблицаЛотов Цикл          		
			
			Если Не ЗначениеЗаполнено(Строка.НомерЗаказа) Тогда
			    ОбщегоНазначенияКлиент.СообщитьПользователю("Не заполнен ""Номер заказа""", , "ТаблицаЛотов[" + Строка.ПолучитьИдентификатор() + "].НомерЗаказа");
				Возврат;
			КонецЕсли;
			
			Если Не ЗначениеЗаполнено(Строка.НомерКороба) Тогда
			    ОбщегоНазначенияКлиент.СообщитьПользователю("Не заполнен ""Номер короба""", , "ТаблицаЛотов[" + Строка.ПолучитьИдентификатор() + "].НомерКороба");
				Возврат;
			КонецЕсли;
		
		КонецЦикла; 
		
	ИначеЕсли Действие = "Отгрузить" Тогда
	
		Если Не ЗначениеЗаполнено(ДатаОтгрузки) Тогда
			ОбщегоНазначенияКлиент.СообщитьПользователю("Не заполнена ""Дата отгрузки""", , , "ДатаОтгрузки");
			Возврат;
		КонецЕсли;
	
	ИначеЕсли Действие = "Отменить" Тогда
	
		Если Не ЗначениеЗаполнено(ПричинаОтмены) Тогда
			ОбщегоНазначенияКлиент.СообщитьПользователю("Не заполнена ""Причина Отмены""", , , "ПричинаОтмены");
			Возврат;
		КонецЕсли;	

	КонецЕсли;
	
	ВыполнитьДействиеНаСервере();
	
КонецПроцедуры //- ИнфоСофт Ивонин К.А. 17.02.24 УА #67209

