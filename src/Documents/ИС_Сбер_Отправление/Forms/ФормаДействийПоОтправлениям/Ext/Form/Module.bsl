	ВерсияБезРедации = ИС_МП_Сервер.ВерсияБезРедакции();
	
	Если ОбщегоНазначенияКлиентСервер.СравнитьВерсииБезНомераСборки(ВерсияБезРедации, "5.19.44") >= 0 Тогда
	//- ИнфоСофт Ивонин К.А. 04.02.25 УА #92887
		
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	ИС_Сбер_Отправление.Ссылка КАК СберОтправление,
		|	ЗаказКлиентаТовары.Ссылка КАК ЗаказКлиента,
