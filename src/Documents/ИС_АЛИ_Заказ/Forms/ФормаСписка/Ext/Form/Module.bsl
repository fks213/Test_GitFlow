Процедура ПрофильПриИзменении(Элемент)
	ПрименитьНастрокиПрофиля();
КонецПроцедуры //- ИнфоСофт Стояк Ю.К. 04.03.2024 УА #56408

//+ ИнфоСофт Стояк Ю.К. 04.03.2024 УА #56408
&НаКлиенте
Процедура СписокПриАктивизацииСтроки(Элемент)
	
	// СтандартныеПодсистемы.ПодключаемыеКоманды
    ПодключаемыеКомандыКлиент.НачатьОбновлениеКоманд(ЭтотОбъект);
    // Конец СтандартныеПодсистемы.ПодключаемыеКоманды
	
	ТекДанные = Элементы.Список.ТекущиеДанные;
	
	Если ТекДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если ОтображатьСоставОтправлений Тогда
		
		МассивСтрок = Элементы.Список.ВыделенныеСтроки;
		
		Если МассивСтрок = Неопределено Или МассивСтрок.Количество() = 0 Тогда 
			ЗаполнитьОтборОтправлений();                                       
			Возврат;
		КонецЕсли;
		
		ЗаполнитьОтборОтправлений(МассивСтрок);
		
	КонецЕсли;
	
КонецПроцедуры //- ИнфоСофт Стояк Ю.К. 04.03.2024 УА #56408

//+ ИнфоСофт Стояк Ю.К. 04.03.2024 УА #56408
&НаКлиенте
Процедура ОтображатьСоставОтправленийПриИзменении(Элемент)
	
	Элементы.СписокТоваров.Видимость = ОтображатьСоставОтправлений;
	
	Если ОтображатьСоставОтправлений Тогда
		
		МассивСтрок = Элементы.Список.ВыделенныеСтроки;
		
		Если МассивСтрок = Неопределено Или МассивСтрок.Количество() = 0 Тогда 
			ЗаполнитьОтборОтправлений();                                       
			Возврат;
		КонецЕсли;
		
		ЗаполнитьОтборОтправлений(МассивСтрок);
		
	КонецЕсли;
	
КонецПроцедуры //- ИнфоСофт Стояк Ю.К. 04.03.2024 УА #56408

//+ ИнфоСофт Стояк Ю.К. 04.03.2024 УА #56408
&НаКлиенте
Процедура ОтборОтправленийПриИзменении(Элемент)
	УстановитьОтборыОтправлений();
КонецПроцедуры //- ИнфоСофт Стояк Ю.К. 04.03.2024 УА #56408

//+ ИнфоСофт Стояк Ю.К. 04.03.2024 УА #56408
&НаКлиенте
Процедура СписокВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	ТекДанные = Элемент.ТекущиеДанные; 
	
	Если ТекДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если Поле = Элементы.Заказ Тогда
		
		СтандартнаяОбработка = Ложь;
		
		Если Элемент.ТекущиеДанные.Заказ.Пустая() Тогда
			Возврат;
		КонецЕсли;
		
		ПоказатьЗначение(, Элемент.ТекущиеДанные.Заказ);
	
	ИначеЕсли Поле = Элементы.Реализация Тогда
		
		СтандартнаяОбработка = Ложь;
		
		Если Не ЗначениеЗаполнено(Элемент.ТекущиеДанные.Реализация) Тогда
			Возврат;
		ИначеЕсли ТипЗнч(Элемент.ТекущиеДанные.Реализация) = Тип("ДокументСсылка.РеализацияТоваровУслуг") Тогда
			ПоказатьЗначение(, Элемент.ТекущиеДанные.Реализация);
		Иначе
			ПараметрыФормы = Новый Структура;
			ПараметрыФормы.Вставить("Заказ", Элемент.ТекущиеДанные.Заказ);
			ОткрытьФорму("ОбщаяФорма.ИС_WB_ФормаРТУ", ПараметрыФормы);
		КонецЕсли
		
	//+ ИнфоСофт Конышев А.Е. 10.12.24 УА #77940
	ИначеЕсли Поле = Элементы.РасходныйОрдер Тогда
		
		СтандартнаяОбработка = Ложь;
		
		Если Не ЗначениеЗаполнено(Элемент.ТекущиеДанные.РасходныйОрдер) Тогда
			Возврат;
		ИначеЕсли ТипЗнч(Элемент.ТекущиеДанные.РасходныйОрдер) = Тип("ДокументСсылка.РасходныйОрдер") Тогда
			ПоказатьЗначение(, Элемент.ТекущиеДанные.РасходныйОрдер);
		КонецЕсли
		
	//- ИнфоСофт Конышев А.Е. 10.12.24 УА #77940
	
	КонецЕсли;
	
КонецПроцедуры //- ИнфоСофт Ивонин К.А. 21.11.23 УА #55166

#КонецОбласти

