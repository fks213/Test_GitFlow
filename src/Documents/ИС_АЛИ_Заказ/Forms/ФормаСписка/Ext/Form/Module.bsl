//+ ИнфоСофт Стояк Ю.К. 04.03.2024 УА #56408
&НаКлиенте
Процедура УстановитьОтборыОтправлений()
    
    ВсеОтправления = Ложь;
    
	Статусы = Новый Массив;

	Если ОтборОтправлений = "Создан" Тогда                                                  		

		Статусы.Добавить(ПредопределенноеЗначение("Перечисление.ИС_АЛИ_СтатусыЗаказов.Created"));
	
	ИначеЕсли ОтборОтправлений = "Обрабатывается" Тогда
	
		Статусы.Добавить(ПредопределенноеЗначение("Перечисление.ИС_АЛИ_СтатусыЗаказов.InProgress"));
			
	ИначеЕсли ОтборОтправлений = "Завершен" Тогда
			
		Статусы.Добавить(ПредопределенноеЗначение("Перечисление.ИС_АЛИ_СтатусыЗаказов.Finished"));
						
	ИначеЕсли ОтборОтправлений = "Отменен" Тогда
		
		Статусы.Добавить(ПредопределенноеЗначение("Перечисление.ИС_АЛИ_СтатусыЗаказов.Cancelled"));
				
	Иначе // Все
	
		ВсеОтправления = Истина;
		Статусы.Добавить(ПредопределенноеЗначение("Перечисление.ИС_АЛИ_СтатусыЗаказов.ПустаяСсылка")); 
			
	КонецЕсли;
	
	Список.Параметры.УстановитьЗначениеПараметра("ВсеОтправления", ВсеОтправления); 
	Список.Параметры.УстановитьЗначениеПараметра("Статусы", Статусы);
	
