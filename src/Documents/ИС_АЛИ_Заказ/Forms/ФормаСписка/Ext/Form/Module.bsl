//+ ИнфоСофт Стояк Ю.К. 14.06.2024 УА #62573
&НаКлиенте
Процедура ПрикрепитьКиз(Команда)
	
	ОчиститьСообщения();
    
	Если Не ЗначениеЗаполнено(Профиль) Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю("Не выбран Профиль", , , "Профиль");
		Возврат;
	КонецЕсли;
	
	ВыделенныеСтроки = Элементы.Список.ВыделенныеСтроки;
			
	Если ВыделенныеСтроки = Неопределено Или ВыделенныеСтроки.Количество() = 0 Тогда
	 	ОбщегоНазначенияКлиент.СообщитьПользователю(
	 		"Для прикрепления КиЗов нужно выделить необходимые заказы");
		Возврат;
	КонецЕсли;
		
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("Профиль", Профиль);
	ПараметрыФормы.Вставить("СборочныеЗадания", ВыделенныеСтроки);
	
	ОткрытьФорму("Документ.ИС_АЛИ_Заказ.Форма.ФормаКиЗов", ПараметрыФормы, ЭтотОбъект);	 
	
