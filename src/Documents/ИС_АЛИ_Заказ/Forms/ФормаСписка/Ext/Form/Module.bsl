//+ ИнфоСофт Стояк Ю.К. 04.03.2024 УА #56408
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	ИС_MP_Сервер.ПриСозданииНаСервере(ЭтотОбъект);
	
	Список.ТекстЗапроса = ИС_АЛИ_Сервер.ПолучитьТекстЗапросаСборочныхЗаданий();
	Список.ОсновнаяТаблица = "Документ.ИС_АЛИ_Заказ";
	
	ОтборОтправлений = "Все";
	
	//+ ИнфоСофт Конышев А.Е. 09.12.24 УА #77940
	Если Не ПолучитьФункциональнуюОпцию("ИспользоватьОрдерныеСклады") Тогда	
		Элементы.РасходныйОрдер.Видимость = Ложь;	
	КонецЕсли;                               
	//- ИнфоСофт Конышев А.Е. 09.12.24 УА #77940
		
КонецПроцедуры //- ИнфоСофт Стояк Ю.К. 04.03.2024 УА #56408

//+ ИнфоСофт Стояк Ю.К. 04.03.2024 УА #56408
&НаКлиенте
Процедура ПриОткрытии(Отказ)
    
	ПрименитьНастрокиПрофиля();
	УстановитьОтборыОтправлений();
    ЗаполнитьОтборОтправлений();
	УстановитьДатуПоследнегоЗаказа();
    Элементы.СписокТоваров.Видимость = ОтображатьСоставОтправлений;

КонецПроцедуры //- ИнфоСофт Стояк Ю.К. 04.03.2024 УА #56408

//+ ИнфоСофт Стояк Ю.К. 04.03.2024 УА #56408
