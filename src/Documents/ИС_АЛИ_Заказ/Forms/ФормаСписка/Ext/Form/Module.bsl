&НаКлиенте
Процедура СоздатьЗаказы(Команда)
	
	ОчиститьСообщения();
    
	Если Не ЗначениеЗаполнено(Профиль) Тогда 
		ОбщегоНазначенияКлиент.СообщитьПользователю("Не выбран ""Профиль""", , , "Профиль");
		Возврат;
	КонецЕсли;
	
	ВыделенныеСтроки = Элементы.Список.ВыделенныеСтроки;
	
	Если ВыделенныеСтроки = Неопределено Или ВыделенныеСтроки.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	СоздатьЗаказыНаСервере(Профиль, ВыделенныеСтроки);
	
	Элементы.Список.Обновить();
	
КонецПроцедуры //- ИнфоСофт Стояк Ю.К. 04.03.2024 УА #56408

