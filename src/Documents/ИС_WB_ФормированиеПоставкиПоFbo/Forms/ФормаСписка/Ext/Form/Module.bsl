&НаСервере
Функция СформироватьТабличныйДокумент(ТаблицаВыгрузки) 
	
	ТабличныйДокумент = Новый ТабличныйДокумент; 
	
	ТабличныйДокумент.ОриентацияСтраницы = ОриентацияСтраницы.Портрет;
	ТабличныйДокумент.ИмяПараметровПечати = "Формирование поставки Fbo";
	
	Построитель = Новый ПостроительОтчета;
	Построитель.ИсточникДанных = Новый ОписаниеИсточникаДанных(ТаблицаВыгрузки); 
	Построитель.ВыводитьЗаголовокОтчета = Ложь;
	Построитель.Вывести(ТабличныйДокумент);
	
	ТабличныйДокумент.АвтоМасштаб = Истина;
	ТабличныйДокумент.УдалитьОбласть(ТабличныйДокумент.Область("R1C1:R1000C1"), ТипСмещенияТабличногоДокумента.ПоГоризонтали);
	ТабличныйДокумент.Область("R1C1:R1000C1").ШиринаКолонки = 20;
	ТабличныйДокумент.Область("R1C2:R1000C2").ШиринаКолонки = 20;
	
	Возврат ТабличныйДокумент;  
	
КонецФункции //- ИнфоСофт Сумин Д.В. 19.05.23 УА #56286

//+ ИнфоСофт Сумин Д.В. 19.05.23 УА #56286
&НаСервере
Функция СформироватьТабличныйДокументЭтикетки(МассивОбъектов)  
		
	Макет = ПолучитьОбщийМакет("ПФ_MXL_ИС_MP_ЭтикеткаТовараFbo");
	
	ТабличныйДокумент = Новый ТабличныйДокумент;
	
	// Зададим параметры макета по-умолчанию
	ТабличныйДокумент.ОриентацияСтраницы = ОриентацияСтраницы.Портрет;
	ТабличныйДокумент.ИмяПараметровПечати = "Этикетки";
	
	Для Каждого ЭлементМассива Из МассивОбъектов Цикл 
		
		ДокОбъект = ЭлементМассива.Ссылка.ПолучитьОбъект();
		
		ДанныеВбТЗ = ПолучитьДаныеДляФормированияЭтикетки(ЭлементМассива.Ссылка);
		
		// Вывод таблицы
		Для Каждого ЭлементТЗ Из ДанныеВбТЗ Цикл
			
			Для Итератор = 1 По ЭлементТЗ.Количество Цикл
				
				ОбластьМакетаОсновныеДанные = Макет.ПолучитьОбласть("ОсновныеДанные"); 
				
				ОбластьМакетаОсновныеДанные.Параметры.Состав = ЭлементТЗ.Состав;
				
				ОбластьМакетаОсновныеДанные.Параметры.Дата = Формат(ТекущаяДатаСеанса(), "ДЛФ=Д"); 
				
				ОбластьМакетаОсновныеДанные.Параметры.Бренд = ЭлементТЗ.Бренд;
				
				ОбластьМакетаОсновныеДанные.Параметры.Предмет = ЭлементТЗ.Предмет;
				
				ОбластьМакетаОсновныеДанные.Параметры.Цвет = ЭлементТЗ.Цвет;
				
				ОбластьМакетаОсновныеДанные.Параметры.Размер = ЭлементТЗ.Размер; 
				
				ОбластьМакетаОсновныеДанные.Параметры.Артикул = ЭлементТЗ.Артикул;
				
				ПараметрыШтрихкода = ПолучитьСтруктуруФормированияШтрихкода(ЭлементТЗ.Штрихкод);
				
				СтруктураКартинки = ИС_MP_ГенерацияШтрихкода.ИзображениеШтрихкода(ПараметрыШтрихкода);
	
				Если СтруктураКартинки.Результат Тогда 
					ОбластьМакетаОсновныеДанные.Параметры.ШтрихкодКартинка = СтруктураКартинки.Картинка;
				КонецЕсли;
				
				ТабличныйДокумент.Вывести(ОбластьМакетаОсновныеДанные);   
				
				ТабличныйДокумент.ВывестиГоризонтальныйРазделительСтраниц(); 
								
			КонецЦикла;
			
		КонецЦикла;
		
	КонецЦикла;
	
	Возврат ТабличныйДокумент;
	
КонецФункции //- ИнфоСофт Сумин Д.В. 19.05.23 УА #56286

//+ ИнфоСофт Сумин Д.В. 19.05.23 УА #56286
&НаСервере
Функция СформироватьТабличныйДокументШкКоробки(МассивОбъектов) 
	
	Макет = ПолучитьОбщийМакет("ПФ_MXL_ИС_MP_ШтрихкодКоробки");
	
	ТабличныйДокумент = Новый ТабличныйДокумент;
	
	// Зададим параметры макета по-умолчанию
	ТабличныйДокумент.ОриентацияСтраницы = ОриентацияСтраницы.Портрет;
	ТабличныйДокумент.ИмяПараметровПечати = "Штрихкоды коробок";
	
	Для Каждого ЭлементМассива Из МассивОбъектов Цикл 
		
		ДокОбъект = ЭлементМассива.Ссылка.ПолучитьОбъект(); 
		
		ШкКоробокТЗ = ДокОбъект.Товары.Выгрузить();
		
		ШкКоробокТЗ.Свернуть("ШтрихкодКоробки");
		
		// Вывод таблицы
		Для Каждого СтрокаТЧ Из ШкКоробокТЗ Цикл
			
			ОбластьМакетаОсновныеДанные = Макет.ПолучитьОбласть("ОсновныеДанные"); 
			
			ПараметрыШтрихкода = ПолучитьСтруктуруФормированияШтрихкода(СтрокаТЧ.ШтрихкодКоробки);
			
			СтруктураКартинки = ИС_MP_ГенерацияШтрихкода.ИзображениеШтрихкода(ПараметрыШтрихкода);
			
			Если СтруктураКартинки.Результат Тогда 
				ОбластьМакетаОсновныеДанные.Параметры.ШтрихкодКартинка = СтруктураКартинки.Картинка;
			КонецЕсли;
			
			ТабличныйДокумент.Вывести(ОбластьМакетаОсновныеДанные);   
			
			ТабличныйДокумент.ВывестиГоризонтальныйРазделительСтраниц(); 
			
		КонецЦикла;
		
	КонецЦикла;
	
	Возврат ТабличныйДокумент;
	
КонецФункции //- ИнфоСофт Сумин Д.В. 19.05.23 УА #56286	

//+ ИнфоСофт Сумин Д.В. 20.05.23 УА #56286
&НаСервере
Функция ПолучитьДаныеДляФормированияЭтикетки(Документ)
	Запрос = Новый Запрос;
	Запрос.Текст =
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	Штрихкоды.Штрихкод КАК Штрихкод,
	|	Штрихкоды.Количество КАК Количество
	|ПОМЕСТИТЬ ВТ_Штрихкоды
	|ИЗ
	|	&Штрихкоды КАК Штрихкоды
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ЕСТЬNULL(ИС_WB_ШтрихкодыРазмеров.Размер, ЗНАЧЕНИЕ(Справочник.ИС_WB_РазмерыНоменклатур.ПустаяСсылка)) КАК Размер,
	|	СУММА(ВТ_Штрихкоды.Количество) КАК Количество,
	|	ВТ_Штрихкоды.Штрихкод КАК Штрихкод
	|ИЗ
	|	РегистрСведений.ИС_WB_ШтрихкодыРазмеров КАК ИС_WB_ШтрихкодыРазмеров
	|		ПРАВОЕ СОЕДИНЕНИЕ ВТ_Штрихкоды КАК ВТ_Штрихкоды
	|		ПО (ВТ_Штрихкоды.Штрихкод = ИС_WB_ШтрихкодыРазмеров.Штрихкод)
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ИС_WB_СоответствиеРазмеров КАК ИС_WB_СоответствиеРазмеров
	|		ПО (ИС_WB_ШтрихкодыРазмеров.Размер = ИС_WB_СоответствиеРазмеров.РазмерWB
	|				И ИС_WB_СоответствиеРазмеров.Профиль = &Профиль)
	|
	|СГРУППИРОВАТЬ ПО
	|	ИС_WB_ШтрихкодыРазмеров.Размер,
	|	ВТ_Штрихкоды.Штрихкод";
	
	Запрос.УстановитьПараметр("Штрихкоды", Документ.Товары.Выгрузить());
	Запрос.УстановитьПараметр("Профиль", Документ.Профиль);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	РезультатТЗ = Новый ТаблицаЗначений;   
	
	РезультатТЗ.Колонки.Добавить("Состав", Новый ОписаниеТипов("Строка"));
	РезультатТЗ.Колонки.Добавить("Бренд", Новый ОписаниеТипов("Строка"));
	РезультатТЗ.Колонки.Добавить("Предмет", Новый ОписаниеТипов("Строка"));
	РезультатТЗ.Колонки.Добавить("Цвет", Новый ОписаниеТипов("Строка"));
    РезультатТЗ.Колонки.Добавить("Размер", Новый ОписаниеТипов("Строка"));
	РезультатТЗ.Колонки.Добавить("Артикул", Новый ОписаниеТипов("Строка"));
	РезультатТЗ.Колонки.Добавить("Штрихкод", Новый ОписаниеТипов("Строка"));
	РезультатТЗ.Колонки.Добавить("Количество", Новый ОписаниеТипов("Число"));
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл 
		
		СтрокаТЗ = РезультатТЗ.Добавить();
		СтрокаТЗ.Количество = ВыборкаДетальныеЗаписи.Количество; 
		СтрокаТЗ.Штрихкод = ВыборкаДетальныеЗаписи.Штрихкод;
		СтрокаТЗ.Артикул = ВыборкаДетальныеЗаписи.Размер.Владелец.VendorCode; 
		СтрокаТЗ.Предмет = ВыборкаДетальныеЗаписи.Размер.Владелец.object;
		СтрокаТЗ.Размер = ВыборкаДетальныеЗаписи.Размер.techSize;
		СтрокаТЗ.Состав = ПолучитьЗначенияПолейНоменклатурыВБ(ВыборкаДетальныеЗаписи.Размер.Владелец, "Состав"); 
		СтрокаТЗ.Бренд = ПолучитьЗначенияПолейНоменклатурыВБ(ВыборкаДетальныеЗаписи.Размер.Владелец, "Бренд");
        СтрокаТЗ.Цвет = ПолучитьЗначенияПолейНоменклатурыВБ(ВыборкаДетальныеЗаписи.Размер.Владелец, "Цвет");  
		
	КонецЦикла;  
	
	Возврат РезультатТЗ;
	
КонецФункции //- ИнфоСофт Сумин Д.В. 20.05.23 УА #56286	

