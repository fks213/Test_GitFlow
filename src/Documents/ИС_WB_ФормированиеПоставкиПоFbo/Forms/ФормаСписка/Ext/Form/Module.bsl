	Возврат ДанныеНоменклатура;
	
КонецФункции //- ИнфоСофт Сумин Д.В. 04.09.2023 УА #61961

//+ ИнфоСофт Сумин Д.В. 05.09.2023 УА #61961
&НаСервере
Функция ПолучитьДанныеДокумента() 
	
	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	ТоварыТЧ.Номенклатура КАК Номенклатура,
	|	ТоварыТЧ.Характеристика КАК Характеристика,
	|	СУММА(ТоварыТЧ.КоличествоУпаковок) КАК Количество
	|ИЗ
	|	&ИмяДокумента КАК ТоварыТЧ
	|ГДЕ
	|	ТоварыТЧ.Ссылка = &Ссылка
	|
	|СГРУППИРОВАТЬ ПО
	|	ТоварыТЧ.Номенклатура,
	|	ТоварыТЧ.Характеристика
	|
	|УПОРЯДОЧИТЬ ПО
	|	Номенклатура,
	|	Характеристика"); 
	
	Если ТипЗнч(ДокументПередачиТоваровНаКомиссиию) = Тип("ДокументСсылка.ПередачаТоваровХранителю") Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&ИмяДокумента", "Документ.ПередачаТоваровХранителю.Товары");	
	Иначе	
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&ИмяДокумента", "Документ.РеализацияТоваровУслуг.Товары");
	КонецЕсли;
	
	Запрос.УстановитьПараметр("Ссылка", ДокументПередачиТоваровНаКомиссиию);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Выборка = РезультатЗапроса.Выбрать();
	
	ДанныеДокумента = Новый ТаблицаЗначений;	
	ДанныеДокумента.Колонки.Добавить("Количество", Новый ОписаниеТипов("Число",,,Новый КвалификаторыЧисла(10)));
	ДанныеДокумента.Колонки.Добавить("Номенклатура", Новый ОписаниеТипов("СправочникСсылка.Номенклатура"));
	ДанныеДокумента.Колонки.Добавить("Характеристика", Новый ОписаниеТипов("СправочникСсылка.ХарактеристикиНоменклатуры"));
	
	Пока Выборка.Следующий() Цикл
		НоваяСтрока					= ДанныеДокумента.Добавить();
		НоваяСтрока.Количество 		= Выборка.Количество;
		НоваяСтрока.Номенклатура 	= Выборка.Номенклатура;
		НоваяСтрока.Характеристика	= Выборка.Характеристика;
	КонецЦикла;
	
	Возврат ДанныеДокумента;
		
КонецФункции //- ИнфоСофт Сумин Д.В. 05.09.2023 УА #61961

//+ ИнфоСофт Сумин Д.В. 05.09.2023 УА #61961
&НаСервере
Процедура ВыполнитьСравнениеДанных(ДанныеАкта, ДанныеДокумента) 

	//Выполним поиск соответсвий данных документа к данным акта 
	ДанныеДокументаОбработка = ДанныеДокумента; 
	
	Для Каждого СтрокаАкта Из ДанныеАкта Цикл
		
		СоответствияНайдены = Ложь;	
		
		Для Каждого СтрокаДокумента Из ДанныеДокументаОбработка Цикл  
			
			Если СтрокаАкта.Номенклатура = СтрокаДокумента.Номенклатура И СтрокаАкта.Характеристика = СтрокаДокумента.Характеристика Тогда
				Разница = СтрокаАкта.Количество - СтрокаДокумента.Количество;	
				//Добавим данные о расхождениях
				//+ ИнфоСофт Сумин Д.В. 26.10.2023 УА #65006
				Если Разница = 0 Тогда 
				ИначеЕсли Разница > 0 Тогда
					ДобавитьСтрокуИзбыток(СтрокаАкта, Разница);	
				Иначе
					ДобавитьСтрокуНедостача(СтрокаАкта, Разница);	
				КонецЕсли;
				//Если Разница > 0 Тогда
				//	ДобавитьСтрокуИзбыток(СтрокаАкта, Разница);	
				//Иначе
				//	ДобавитьСтрокуНедостача(СтрокаАкта, Разница);	
				//КонецЕсли;  
				//- ИнфоСофт Сумин Д.В. 26.10.2023 УА #65006  
				
				ДанныеДокументаОбработка.Удалить(СтрокаДокумента); 
				
				СоответствияНайдены = Истина;
				
			КонецЕсли;  
			
		КонецЦикла;	
		
		Если Не СоответствияНайдены И ЗначениеЗаполнено(СтрокаАкта.Номенклатура) Тогда
			ДобавитьСтрокуИзбыток(СтрокаАкта, СтрокаАкта.Количество);	
		КонецЕсли;
		
	КонецЦикла;
	
	//Выполним поиск соответсвий данных акта к данным документа
	ДанныеАктаОбработка = ДанныеАкта; 
	
	Для Каждого СтрокаДокумента Из ДанныеДокумента Цикл
				 	
		СоответствияНайдены = Ложь;	
		
		Для Каждого СтрокаАкта Из ДанныеАктаОбработка Цикл   	
			Если СтрокаАкта.Номенклатура = СтрокаДокумента.Номенклатура И СтрокаАкта.Характеристика = СтрокаДокумента.Характеристика Тогда
				ДанныеАктаОбработка.Удалить(СтрокаАкта); 
				СоответствияНайдены = Истина;	
			КонецЕсли;			
		КонецЦикла;
		
		Если Не СоответствияНайдены И ЗначениеЗаполнено(СтрокаАкта.Номенклатура) Тогда
			ДобавитьСтрокуНедостача(СтрокаДокумента, СтрокаДокумента.Количество);	
		КонецЕсли;
		
	КонецЦикла;
		
КонецПроцедуры //- ИнфоСофт Сумин Д.В. 05.09.2023 УА #61961

//+ ИнфоСофт Сумин Д.В. 05.09.2023 УА #61961
&НаСервере
Процедура ДобавитьСтрокуИзбыток(СтрокаАкта, Количество) 
	
	НоваяСтрока 					= Избыток.Добавить();
	НоваяСтрока.Номенклатура 		= СтрокаАкта.Номенклатура;
	НоваяСтрока.Характеристика 		= СтрокаАкта.Характеристика;
	Если Количество < 0 Тогда
		Количество = -Количество;
	КонецЕсли;	
	НоваяСтрока.Количество 			= Количество;
	
