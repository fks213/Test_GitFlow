&НаСервере
Функция СформироватьТабличныйДокументПервыйЭтап(Массив) 
	
	ТаблицаВыгрузки = Новый ТаблицаЗначений;
	
	ТаблицаВыгрузки.Колонки.Добавить("баркод", Новый ОписаниеТипов("Строка"));
	ТаблицаВыгрузки.Колонки.Добавить("количество", Новый ОписаниеТипов("Число"));	
	
	Для Каждого Документ Из Массив Цикл
		Для Каждого Строка Из Документ.Товары Цикл
			СтрокаТЗ = ТаблицаВыгрузки.Добавить();
			СтрокаТЗ.баркод = Строка.Штрихкод;
			СтрокаТЗ.количество = Строка.Количество;
		КонецЦикла;
	КонецЦикла;	
	
	ТаблицаВыгрузки.Свернуть("баркод", "количество");
	
	ТабДок = СформироватьТабличныйДокумент(ТаблицаВыгрузки);
	
	Возврат ТабДок
	
КонецФункции //- ИнфоСофт Сумин Д.В. 19.05.23 УА #56286

