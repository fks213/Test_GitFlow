&НаСервере
Функция ПолучитьЗначенияПолейНоменклатурыВБ(ОбъектДанных, Поле)
	
	Значение = ""; 
	
	Итератор = 0;
	
	Для Каждого Элемент Из ОбъектДанных.Характеристики Цикл 
		
		Если СокрЛП(Элемент.Поле) = Поле Тогда
			
			Если Итератор = 0 Тогда
				Значение = Элемент.Значение;
				Итератор = Итератор + 1;
			Иначе
				Значение = Значение + ", " + Элемент.Значение; 
			КонецЕсли;	
			
		КонецЕсли;	
		
	КонецЦикла;
	
	Возврат Значение;

КонецФункции //- ИнфоСофт Сумин Д.В. 20.05.23 УА #56286	

