&НаСервере
Процедура ВыполнитьПроверкуАктаНаСервере()

	ФайлВременногоХранилища = ПолучитьИзВременногоХранилища(АдресОтчетаВоВременномХранилище);
	Имя = ПолучитьИмяВременногоФайла("xlsx");
	ФайлВременногоХранилища.Записать(Имя);  
	
	ТабличныйДокумент = Новый ТабличныйДокумент; 
	ТабличныйДокумент.Прочитать(Имя);
	
	КоличествоСтрок = ТабличныйДокумент.ВысотаТаблицы;
	
	ДанныеАкта = Новый ТаблицаЗначений;
	ДанныеАкта.Колонки.Добавить("Баркод", Новый ОписаниеТипов("Строка",,,Новый КвалификаторыСтроки(50)));
	ДанныеАкта.Колонки.Добавить("Количество", Новый ОписаниеТипов("Число",,,Новый КвалификаторыЧисла(10)));
	
	Для сч = 13 По КоличествоСтрок Цикл 	
		Попытка
			Баркод  = Строка(ТабличныйДокумент.ПолучитьОбласть("R" + Формат(сч, "ЧГ=0;") + "C" + 4).ТекущаяОбласть.Текст);
			
			Если Баркод = "" Тогда
				Прервать;
			КонецЕсли;
			
			//+ ИнфоСофт Сумин Д.В. 26.10.2023 УА #65006
			Количество  = Строка(ТабличныйДокумент.ПолучитьОбласть("R" + Формат(сч, "ЧГ=0;") + "C" + 9).ТекущаяОбласть.Текст);
			//Количество  = Строка(ТабличныйДокумент.ПолучитьОбласть("R" + Формат(сч, "ЧГ=0;") + "C" + 8).ТекущаяОбласть.Текст); 
			//- ИнфоСофт Сумин Д.В. 26.10.2023 УА #65006 
			
			НоваяСтрока 			= ДанныеАкта.Добавить();
			НоваяСтрока.Баркод 		= Баркод;
			НоваяСтрока.Количество 	= Количество;
			
		Исключение
			ОбщегоНазначения.СообщитьПользователю("Не удалось загрузить строку " + Строка(сч)); 	
		КонецПопытки;
	КонецЦикла;
	
	Попытка
		УдалитьФайлы(Имя);
	Исключение
		ОбщегоНазначения.СообщитьПользователю(ПодробноеПредставлениеОшибки(ИнформацияОбОшибке())); 
	КонецПопытки;
	
	Если ДанныеАкта.Количество() = 0 Тогда
		ОбщегоНазначения.СообщитьПользователю("Выбран некорректный файл. Выберите акт приемкм товаров.");
		Возврат;
	КонецЕсли;
	
	ДанныеАктаНоменклатура = ПолучитьСоответствияНоменклатуры(ДанныеАкта);
	
	ВыполнитьПроверкуНаНеизвестныеШтрихкоды(ДанныеАкта);
	
	ДанныеДокумента = ПолучитьДанныеДокумента();
	
	Если ДанныеДокумента.Количество() = 0 Тогда
		ОбщегоНазначения.СообщитьПользователю("Товары не найдены в документе. Проверьте выбранный документ.");
		Возврат;
	КонецЕсли;
	
	ВыполнитьСравнениеДанных(ДанныеАктаНоменклатура, ДанныеДокумента);
	
	Если Избыток.Количество() = 0 И Избыток.Количество() = 0 И НеНайденныеШтрихкоды.Количество() = 0 Тогда
		ОбщегоНазначения.СообщитьПользователю("Расхождений не найдено.");
		Возврат;
	КонецЕсли;
	
	Если Избыток.Количество() > 0 Тогда
		ОбщегоНазначения.СообщитьПользователю("Найдены товары отсутствующие в документе передачи.");
		Элементы.ГруппаИзбыток.Показать();
	КонецЕсли;
	
	Если Недостача.Количество() > 0 Тогда
		ОбщегоНазначения.СообщитьПользователю("Найдены товары отсутствующие в акте.");
		Элементы.ГруппаНедостача.Показать();
	КонецЕсли;
	
	Если НеНайденныеШтрихкоды.Количество() > 0 Тогда
		ОбщегоНазначения.СообщитьПользователю("Найдены не идентифицированные штрихкоды.");
		Элементы.ГруппаНеНайденныеШтрихкоды.Показать();
	КонецЕсли;
	
КонецПроцедуры //- ИнфоСофт Сумин Д.В. 04.09.2023 УА #61961

//+ ИнфоСофт Сумин Д.В. 04.09.2023 УА #61961
&НаСервере
Функция ПолучитьСоответствияНоменклатуры(ДанныеАкта) 
	
	Запрос = Новый Запрос("ВЫБРАТЬ
	|	ДанныеАкта.Баркод КАК Баркод,
	|	ДанныеАкта.Количество КАК Количество
	|ПОМЕСТИТЬ ВТ_ДанныеАкта
	|ИЗ
	|	&ДанныеАкта КАК ДанныеАкта
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_ДанныеАкта.Баркод КАК Баркод,
	|	МАКСИМУМ(ИС_WB_СоответствиеРазмеров.Номенклатура) КАК Номенклатура,
	|	МАКСИМУМ(ИС_WB_СоответствиеРазмеров.Характеристика) КАК Характеристика,
	|	МАКСИМУМ(ВЫБОР
	|			КОГДА ИС_WB_СоответствиеРазмеров.Номенклатура.ТипНоменклатуры = ЗНАЧЕНИЕ(Перечисление.ТипыНоменклатуры.Набор)
	|				ТОГДА ИСТИНА
	|			ИНАЧЕ ЛОЖЬ
	|		КОНЕЦ) КАК ЭтоНабор
	|ПОМЕСТИТЬ ВТ_Номенклатура
	|ИЗ
	|	ВТ_ДанныеАкта КАК ВТ_ДанныеАкта
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ИС_WB_ШтрихкодыРазмеров КАК ИС_WB_ШтрихкодыРазмеров
	|			ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ИС_WB_СоответствиеРазмеров КАК ИС_WB_СоответствиеРазмеров
	|			ПО ИС_WB_ШтрихкодыРазмеров.Размер = ИС_WB_СоответствиеРазмеров.РазмерWB
	|		ПО ВТ_ДанныеАкта.Баркод = ИС_WB_ШтрихкодыРазмеров.Штрихкод
	|			И (ИС_WB_ШтрихкодыРазмеров.Профиль = &Профиль)
	|
	|СГРУППИРОВАТЬ ПО
	|	ВТ_ДанныеАкта.Баркод
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_Номенклатура.Баркод КАК Баркод,
	|	ВариантыКомплектацииНоменклатурыТовары.Номенклатура КАК Номенклатура,
	|	ВариантыКомплектацииНоменклатурыТовары.Характеристика КАК Характеристика,
	|	ВариантыКомплектацииНоменклатурыТовары.Количество КАК Количество
	|ПОМЕСТИТЬ ВТ_Набор
	|ИЗ
	|	ВТ_Номенклатура КАК ВТ_Номенклатура
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ВариантыКомплектацииНоменклатуры.Товары КАК ВариантыКомплектацииНоменклатурыТовары
	|		ПО ВТ_Номенклатура.Номенклатура = ВариантыКомплектацииНоменклатурыТовары.Ссылка.Владелец
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВЫБОР
	|		КОГДА ВТ_Номенклатура.ЭтоНабор = ИСТИНА
	|			ТОГДА ВТ_Набор.Номенклатура
	|		ИНАЧЕ ЕСТЬNULL(ВТ_Номенклатура.Номенклатура, ЗНАЧЕНИЕ(Справочник.Номенклатура.ПустаяСсылка))
	|	КОНЕЦ КАК Номенклатура,
	|	ВЫБОР
	|		КОГДА ВТ_Номенклатура.ЭтоНабор = ИСТИНА
	|			ТОГДА ВТ_Набор.Характеристика
	|		ИНАЧЕ ЕСТЬNULL(ВТ_Номенклатура.Характеристика, ЗНАЧЕНИЕ(Справочник.ХарактеристикиНоменклатуры.ПустаяСсылка))
	|	КОНЕЦ КАК Характеристика,
	|	ВЫБОР
	|		КОГДА ВТ_Номенклатура.ЭтоНабор = ИСТИНА
	|			ТОГДА ВТ_ДанныеАкта.Количество * ВТ_Набор.Количество
	|		ИНАЧЕ ВТ_ДанныеАкта.Количество
	|	КОНЕЦ КАК Количество,
	|	ВТ_ДанныеАкта.Баркод КАК Баркод
	|ПОМЕСТИТЬ ВТ_Результат
	|ИЗ
	|	ВТ_ДанныеАкта КАК ВТ_ДанныеАкта
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_Номенклатура КАК ВТ_Номенклатура
	|		ПО (ВТ_ДанныеАкта.Баркод = ВТ_Номенклатура.Баркод)
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_Набор КАК ВТ_Набор
	|		ПО (ВТ_ДанныеАкта.Баркод = ВТ_Набор.Баркод)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_Результат.Номенклатура КАК Номенклатура,
	|	ВТ_Результат.Характеристика КАК Характеристика,
	|	СУММА(ВТ_Результат.Количество) КАК Количество,
	|	ВТ_Результат.Баркод КАК Баркод
	|ИЗ
	|	ВТ_Результат КАК ВТ_Результат
	|
	|СГРУППИРОВАТЬ ПО
	|	ВТ_Результат.Номенклатура,
	|	ВТ_Результат.Характеристика,
	|	ВТ_Результат.Баркод");
	
	Запрос.УстановитьПараметр("ДанныеАкта", ДанныеАкта); 
	Запрос.УстановитьПараметр("Профиль", Профиль);
	
	РезультатЗапроса = запрос.Выполнить();
	
	Выборка = РезультатЗапроса.Выбрать();
	
	ДанныеНоменклатура = Новый ТаблицаЗначений;
	ДанныеНоменклатура.Колонки.Добавить("Количество", Новый ОписаниеТипов("Число",,,Новый КвалификаторыЧисла(10)));
	ДанныеНоменклатура.Колонки.Добавить("Номенклатура", Новый ОписаниеТипов("СправочникСсылка.Номенклатура"));
	ДанныеНоменклатура.Колонки.Добавить("Характеристика", Новый ОписаниеТипов("СправочникСсылка.ХарактеристикиНоменклатуры"));
	ДанныеНоменклатура.Колонки.Добавить("Баркод", Новый ОписаниеТипов("Строка",,,Новый КвалификаторыСтроки(50)));
	
	Пока Выборка.Следующий() Цикл
		НоваяСтрока 				= ДанныеНоменклатура.Добавить();
		НоваяСтрока.Количество 		= Выборка.Количество;
		НоваяСтрока.Номенклатура 	= Выборка.Номенклатура;
		НоваяСтрока.Характеристика 	= Выборка.Характеристика;	
		НоваяСтрока.Баркод		 	= Выборка.Баркод;
