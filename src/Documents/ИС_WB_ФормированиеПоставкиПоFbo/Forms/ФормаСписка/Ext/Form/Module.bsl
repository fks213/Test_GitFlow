&НаКлиенте
Процедура ПутьКФайлуНачалоВыбора(Элемент, ДанныеВыбора, ВыборДобавлением, СтандартнаяОбработка) 
	
	ОчиститьСообщения(); 
	
	//+ ИнфоСофт Стояк Ю.К. 01.12.2023 УА #61163	
	Элементы.НоменклатураКСозданию.Видимость = Ложь;
	//- ИнфоСофт Стояк Ю.К. 01.12.2023 УА #61163
	
	ДиалогВыбораФайла = Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.Открытие);
	ДиалогВыбораФайла.Заголовок = "Выберите файл отчета комиссионера";
	ДиалогВыбораФайла.МножественныйВыбор =  Ложь;
	ДиалогВыбораФайла.ПроверятьСуществованиеФайла = Истина;
	ДиалогВыбораФайла.Фильтр = "Excel файлы(*.xls;*.xlsx)|*.xls;*.xlsx";
	
	ДополнительныеПараметры = Новый Структура;
	ДополнительныеПараметры.Вставить("Реквизит", "ПутьКФайлу");
	ДополнительныеПараметры.Вставить("Адрес", "АдресОтчетаВоВременномХранилище");  
	ДополнительныеПараметры.Вставить("ДиалогВыбораФайла", ДиалогВыбораФайла);
	
	ДиалогВыбораФайла.Показать(Новый ОписаниеОповещения("ПутьКФайлуНачалоВыбораЗавершение", ЭтотОбъект, ДополнительныеПараметры));

КонецПроцедуры //- ИнфоСофт Сумин Д.В. 04.09.2023 УА #61961

//+ ИнфоСофт Сумин Д.В. 04.09.2023 УА #61961
&НаКлиенте
Процедура ВыполнитьПроверкуАкта(Команда)  
	
	Если НЕ ЗначениеЗаполнено(Профиль) Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю("Не выбран файл.", , , "Профиль");
		Возврат;
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(ПутьКФайлу) Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю("Не выбран файл.", , , "ПутьКФайлу");
		Возврат;
	КонецЕсли;

	Если НЕ ЗначениеЗаполнено(ДокументПередачиТоваровНаКомиссиию) Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю("Не выбран документ передачи товаров на комиссию.", , , "ДокументПередачиТоваровНаКомиссиию");
		Возврат;
	КонецЕсли;
	
	УстановитьНачальноеОформление();
		
	ВыполнитьПроверкуАктаНаСервере(); 
	
КонецПроцедуры //- ИнфоСофт Сумин Д.В. 04.09.2023 УА #61961

//+ ИнфоСофт Стояк Ю.К. 01.12.2023 УА #61163
&НаКлиенте
Процедура СоздатьДокументОтгрузки(Команда)   
	
	Если НЕ ЗначениеЗаполнено(Профиль) Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю("Не выбран файл.", , , "Профиль");
		Возврат;
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(ПутьКФайлу) Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю("Не выбран файл.", , , "ПутьКФайлу");
		Возврат;
	КонецЕсли; 
	
	ОшибкаСопоставления = Ложь;
	
	Если Не Элементы.НоменклатураКСозданию.Видимость Тогда
		ЗаполнитьТаблицуДаннымиДокумента();
	КонецЕсли;
	
	Для Каждого Строка Из НоменклатураКСозданию Цикл
		Если Не ЗначениеЗаполнено(Строка.Номенклатура) Тогда
			ОшибкаСопоставления = Истина;			
		КонецЕсли;
	КонецЦикла;
	
	Если ОшибкаСопоставления Тогда
		Элементы.НоменклатураКСозданию.Видимость = Истина;
		ОбщегоНазначенияКлиент.СообщитьПользователю("Проверьте сопоставление для создания документов!");
		Возврат;
	КонецЕсли;
	
	Комиссия25 = ИспользуетсяСхемаКомиссии25();
	
	Если Комиссия25 Тогда
		ФормаНовогоДокумента = ПолучитьФорму("Документ.ПередачаТоваровХранителю.Форма.ФормаДокумента");	
	Иначе	
		ФормаНовогоДокумента = ПолучитьФорму("Документ.РеализацияТоваровУслуг.Форма.ФормаДокумента");
	КонецЕсли; 
	
	ДанныеФормы = ФормаНовогоДокумента.Объект;
	
	ЗаполнитьДанныеНаСервере(ДанныеФормы, Комиссия25);
	
	КопироватьДанныеФормы(ДанныеФормы, ФормаНовогоДокумента.Объект);

    ФормаНовогоДокумента.Модифицированность = Истина;
	
    ФормаНовогоДокумента.Открыть();  
	
КонецПроцедуры //- ИнфоСофт Стояк Ю.К. 01.12.2023 УА #61163

