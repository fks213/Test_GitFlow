&НаСервере
Процедура ПолучитьТоварыПоQrКоду(ДанныеШтрихкода) 
	
	//+ ИнфоСофт Сумин Д.В. 14.02.2024 УА #62253
	qrКод = ДанныеШтрихкода.Штрихкод; 
	//- ИнфоСофт Сумин Д.В. 14.02.2024 УА #62253 
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ШтрихкодыУпаковокТоваров.Номенклатура КАК Номенклатура,
	|	ШтрихкодыУпаковокТоваров.Характеристика КАК Характеристика
	|ПОМЕСТИТЬ ВТ_Номенклатура
	|ИЗ
	|	Справочник.ШтрихкодыУпаковокТоваров КАК ШтрихкодыУпаковокТоваров
	|ГДЕ
	|	ШтрихкодыУпаковокТоваров.ЗначениеШтрихкода = &ЗначениеШтрихкода
	|
	|СГРУППИРОВАТЬ ПО
	|	ШтрихкодыУпаковокТоваров.Номенклатура,
	|	ШтрихкодыУпаковокТоваров.Характеристика
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ ПЕРВЫЕ 1
	|	ВТ_Номенклатура.Номенклатура КАК Номенклатура,
	|	ВТ_Номенклатура.Характеристика КАК Характеристика
	|ПОМЕСТИТЬ ВТ_НоменклатураГруппировка
	|ИЗ
	|	ВТ_Номенклатура КАК ВТ_Номенклатура
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_НоменклатураГруппировка.Номенклатура КАК Номенклатура,
	|	ВТ_НоменклатураГруппировка.Характеристика КАК Характеристика,
	|	Истина КАК МаркированныйТовар,
	|	ИС_WB_ШтрихкодыРазмеров.Штрихкод КАК Штрихкод
	|ИЗ
	|	ВТ_НоменклатураГруппировка КАК ВТ_НоменклатураГруппировка
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ИС_WB_СоответствиеРазмеров КАК ИС_WB_СоответствиеРазмеров
	|			ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ИС_WB_ШтрихкодыРазмеров КАК ИС_WB_ШтрихкодыРазмеров
	|			ПО ИС_WB_СоответствиеРазмеров.РазмерWB = ИС_WB_ШтрихкодыРазмеров.Размер
	|		ПО ВТ_НоменклатураГруппировка.Номенклатура = ИС_WB_СоответствиеРазмеров.Номенклатура
	|			И ВТ_НоменклатураГруппировка.Характеристика = ИС_WB_СоответствиеРазмеров.Характеристика
	|ГДЕ
	|	ИС_WB_СоответствиеРазмеров.Профиль = &Профиль";
	
	Запрос.УстановитьПараметр("ЗначениеШтрихкода", qrКод);
	Запрос.УстановитьПараметр("Профиль", Объект.Профиль);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Если РезультатЗапроса.Пустой() Тогда
		ОбщегоНазначения.СообщитьПользователю("Не найдены данные по qr коду " + qrКод); 
		//+ ИнфоСофт Стояк Ю.К. 22.08.2023 УА #62254		
		ДанныеНайдены = Ложь;                       
		//- ИнфоСофт Стояк Ю.К. 22.08.2023 УА #62254
		Возврат;		
	КонецЕсли;	
	
	//+ ИнфоСофт Стояк Ю.К. 22.08.2023 УА #62254
	ДанныеНайдены = Истина;
	//- ИнфоСофт Стояк Ю.К. 22.08.2023 УА #62254	
	
	//+ ИнфоСофт Сумин Д.В. 14.02.2024 УА #62253
	НайденныеТовары = Новый ТаблицаЗначений;
	НайденныеТовары.Колонки.Добавить("Номенклатура", Новый ОписаниеТипов("СправочникСсылка.Номенклатура"));
	НайденныеТовары.Колонки.Добавить("Характеристика", Новый ОписаниеТипов("СправочникСсылка.ХарактеристикиНоменклатуры"));
	НайденныеТовары.Колонки.Добавить("МаркированныйТовар", Новый ОписаниеТипов("Булево"));
	НайденныеТовары.Колонки.Добавить("Штрихкод", Новый ОписаниеТипов("Строка", Новый КвалификаторыСтроки(50)));
	
	Выборка = РезультатЗапроса.Выбрать();
	
	Пока Выборка.Следующий() Цикл
		НоваяСтрока = НайденныеТовары.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, Выборка);	
	КонецЦикла;	
	
	ДобавитьТоварыПоШтрихкоду(НайденныеТовары);
	//ДобавитьТоварыПоШтрихкоду(РезультатЗапроса.Выгрузить());
	//+ ИнфоСофт Сумин Д.В. 14.02.2024 УА #62253 
	
	//+ ИнфоСофт Сумин Д.В. 14.02.2024 УА #62253
	Если АвтоПроверкаМаркированногоТовара Тогда
		Если НайденныеТовары.Количество() < 1 Тогда
			Возврат;	
		КонецЕсли;	
		ВыполнитьПроверкуКодаМаркировки(qrКод, НайденныеТовары[0].Номенклатура);		
	КонецЕсли;	
	//- ИнфоСофт Сумин Д.В. 14.02.2024 УА #62253
	
КонецПроцедуры //- ИнфоСофт Сумин Д.В. 18.05.23 УА #56286

