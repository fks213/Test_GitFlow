//+ ИнфоСофт Стояк Ю.К. 24.10.2024 УА #76489
&НаКлиенте
Процедура КоробкиПриАктивизацииСтроки(Элемент)          
	
	ВыделенныеСтроки = Элементы.Коробки.ВыделенныеСтроки;
	
	Если ВыделенныеСтроки.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	ДанныеСтроки = Элементы.Коробки.ДанныеСтроки(ВыделенныеСтроки[0]);
	
	ШККоробки = ДанныеСтроки.ШтрихкодКоробки;
	
	Элементы.Товары.ОтборСтрок = Новый ФиксированнаяСтруктура("ШтрихкодКоробки", ШККоробки);
	
	УстановитьАктивныйШкНаСервере(ШККоробки);
	
КонецПроцедуры //- ИнфоСофт Стояк Ю.К. 24.10.2024 УА #76489

