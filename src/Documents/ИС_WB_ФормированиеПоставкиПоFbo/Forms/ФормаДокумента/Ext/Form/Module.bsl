&НаСервере
Функция ПечатьШтрихкода(Штрихкод)
	
	Данные = ПолучитьДанныеДляФормированияЭтикетки(Штрихкод);
	
	Макет = ПолучитьОбщийМакет("ЭтикеткаТовараFbo");
	
	ТабличныйДокумент = Новый ТабличныйДокумент;
	ТабличныйДокумент.ОриентацияСтраницы = ОриентацияСтраницы.Портрет;
	ТабличныйДокумент.ИмяПараметровПечати = "Этикетка";		
	
	ОбластьМакетаОсновныеДанные = Макет.ПолучитьОбласть("ОсновныеДанные"); 
	
	ОбластьМакетаОсновныеДанные.Параметры.Состав = Данные.Состав;
	
	ОбластьМакетаОсновныеДанные.Параметры.Дата = Формат(ТекущаяДатаСеанса(), "ДЛФ=Д"); 
	
	ОбластьМакетаОсновныеДанные.Параметры.Бренд = Данные.Бренд;
	
	ОбластьМакетаОсновныеДанные.Параметры.Предмет = Данные.Предмет;
	
	ОбластьМакетаОсновныеДанные.Параметры.Цвет = Данные.Цвет;
	
	ОбластьМакетаОсновныеДанные.Параметры.Размер = Данные.Размер; 
	
	ОбластьМакетаОсновныеДанные.Параметры.Артикул = Данные.Артикул;
	
	ПараметрыШтрихкода = ПолучитьСтруктуруФормированияШтрихкода(Данные.Штрихкод);
	
	СтруктураКартинки = ИС_MP_ГенерацияШтрихкода.ИзображениеШтрихкода(ПараметрыШтрихкода);
	
	Если СтруктураКартинки.Результат Тогда 
		ОбластьМакетаОсновныеДанные.Параметры.ШтрихкодКартинка = СтруктураКартинки.Картинка;
	КонецЕсли;

	ТабличныйДокумент.Вывести(ОбластьМакетаОсновныеДанные); 
	
	//+ ИнфоСофт Заварин К.В 15.02.24 УА #65734  
	ВыполнитьНастройкуТабличногоДокумента(ТабличныйДокумент,НастройкаПечатиШтрихкодов);
	 //- ИнфоСофт Заварин К.В 15.02.24 УА #65734
	
	Возврат ТабличныйДокумент;
	
КонецФункции //- ИнфоСофт Стояк Ю.К. 22.08.2023 УА #62254

//+ ИнфоСофт Заварин К.В 15.02.24 УА #65734 
&НаСервере
Процедура ВыполнитьНастройкуТабличногоДокумента(Этикетка, НастройкиПечати)
	
	Этикетка.ИмяПринтера = НастройкиПечати.ИмяПринтера; 
	Этикетка.ПолеСлева = НастройкиПечати.Слева;
	Этикетка.ПолеСправа = НастройкиПечати.Справа;
	Этикетка.ПолеСнизу = НастройкиПечати.Снизу;
	Этикетка.ПолеСверху = НастройкиПечати.Сверху;	
	Этикетка.РазмерКолонтитулаСверху = НастройкиПечати.КолонтитулыСверху;
	Этикетка.РазмерКолонтитулаСнизу = НастройкиПечати.КолонтитулыСнизу; 
	Этикетка.ЭкземпляровНаСтранице = НастройкиПечати.ЭкземпляровНаСтраницу; 	
	
	Если НастройкиПечати.ОриентацияСтраницы = 0 Тогда 
		Этикетка.ОриентацияСтраницы = ОриентацияСтраницы.Портрет;
	Иначе 
		Этикетка.ОриентацияСтраницы = ОриентацияСтраницы.Ландшафт;
	КонецЕсли;
	
	//+ ИнфоСофт Заварин К.В. 03.12.24 УА #72698
	Если НастройкиПечати.Масштаб = 0 Тогда 
		Этикетка.АвтоМасштаб = Истина;
	Иначе 
		Этикетка.АвтоМасштаб = Ложь;
		Этикетка.МасштабПечати = НастройкиПечати.МасштабЗначение;	
	КонецЕсли;
	//- ИнфоСофт Заварин К.В. 03.12.24 УА #72698
	
КонецПроцедуры //- ИнфоСофт Заварин К.В 15.02.24 УА #65734 

//+ ИнфоСофт Стояк Ю.К. 22.08.2023 УА #62254
Функция ПолучитьСтруктуруФормированияШтрихкода(Штрихкод)
	
	СтруктураШтрихкода = Новый Структура;
	
	СтруктураШтрихкода.Вставить("Ширина", 280);
	СтруктураШтрихкода.Вставить("Высота", 100);
	СтруктураШтрихкода.Вставить("ТипКода", 2);
	СтруктураШтрихкода.Вставить("ОтображатьТекст", Истина);
	СтруктураШтрихкода.Вставить("Штрихкод", Штрихкод);
	
	Возврат СтруктураШтрихкода;

КонецФункции //- ИнфоСофт Стояк Ю.К. 22.08.2023 УА #62254

//+ ИнфоСофт Стояк Ю.К. 22.08.2023 УА #62254
Функция ПолучитьДанныеДляФормированияЭтикетки(Штрихкод) 
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ЕСТЬNULL(ИС_WB_ШтрихкодыРазмеров.Размер, ЗНАЧЕНИЕ(Справочник.ИС_WB_РазмерыНоменклатур.ПустаяСсылка)) КАК Размер,
	|	ИС_WB_ШтрихкодыРазмеров.Штрихкод КАК Штрихкод
	|ПОМЕСТИТЬ ВТ_Данные
	|ИЗ
	|	РегистрСведений.ИС_WB_ШтрихкодыРазмеров КАК ИС_WB_ШтрихкодыРазмеров
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ИС_WB_СоответствиеРазмеров КАК ИС_WB_СоответствиеРазмеров
	|		ПО ИС_WB_ШтрихкодыРазмеров.Размер = ИС_WB_СоответствиеРазмеров.РазмерWB
	|			И (ИС_WB_СоответствиеРазмеров.Профиль = &Профиль)
	|ГДЕ
	|	ИС_WB_ШтрихкодыРазмеров.Штрихкод = &Штрихкод
	|
	|СГРУППИРОВАТЬ ПО
	|	ИС_WB_ШтрихкодыРазмеров.Размер,
	|	ИС_WB_ШтрихкодыРазмеров.Штрихкод
	//+ ИнфоСофт Стояк Ю.К. 25.06.2024 УА #77969
	|
	|ОБЪЕДИНИТЬ
	|
	|ВЫБРАТЬ
	|	ЕСТЬNULL(ИС_WB_СоответствиеРазмеров.РазмерWB, ЗНАЧЕНИЕ(Справочник.ИС_WB_РазмерыНоменклатур.ПустаяСсылка)),
	|	ШтрихкодыНоменклатуры.Штрихкод
	|ИЗ
	|	РегистрСведений.ШтрихкодыНоменклатуры КАК ШтрихкодыНоменклатуры
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ИС_WB_СоответствиеРазмеров КАК ИС_WB_СоответствиеРазмеров
	|		ПО ШтрихкодыНоменклатуры.Номенклатура = ИС_WB_СоответствиеРазмеров.Номенклатура
	|			И ШтрихкодыНоменклатуры.Характеристика = ИС_WB_СоответствиеРазмеров.Характеристика
	|ГДЕ
	|	ШтрихкодыНоменклатуры.Штрихкод = &Штрихкод
	|	И ИС_WB_СоответствиеРазмеров.Профиль = &Профиль
	|
	|СГРУППИРОВАТЬ ПО
	|	ЕСТЬNULL(ИС_WB_СоответствиеРазмеров.РазмерWB, ЗНАЧЕНИЕ(Справочник.ИС_WB_РазмерыНоменклатур.ПустаяСсылка)),
	|	ШтрихкодыНоменклатуры.Штрихкод
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ ПЕРВЫЕ 1
	|	ВТ_Данные.Размер КАК Размер,
	|	ВТ_Данные.Штрихкод КАК Штрихкод
	|ИЗ
	|	ВТ_Данные КАК ВТ_Данные
	|ГДЕ
	|	ВТ_Данные.Размер <> ЗНАЧЕНИЕ(Справочник.ИС_WB_РазмерыНоменклатур.ПустаяСсылка)";
	//- ИнфоСофт Стояк Ю.К. 25.06.2024 УА #77969
	
	Запрос.УстановитьПараметр("Штрихкод", Штрихкод);
	Запрос.УстановитьПараметр("Профиль", Объект.Профиль);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Результат = Новый Структура;   
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл 
		
		Результат.Вставить("Штрихкод", ВыборкаДетальныеЗаписи.Штрихкод);
		Результат.Вставить("Артикул", ВыборкаДетальныеЗаписи.Размер.Владелец.VendorCode); 
		Результат.Вставить("Предмет", ВыборкаДетальныеЗаписи.Размер.Владелец.object);
		Результат.Вставить("Размер", ВыборкаДетальныеЗаписи.Размер.techSize);
		Результат.Вставить("Состав", ПолучитьЗначенияПолейНоменклатурыВБ(ВыборкаДетальныеЗаписи.Размер.Владелец, "Состав")); 
		Результат.Вставить("Бренд", ПолучитьЗначенияПолейНоменклатурыВБ(ВыборкаДетальныеЗаписи.Размер.Владелец, "Бренд"));
        Результат.Вставить("Цвет", ПолучитьЗначенияПолейНоменклатурыВБ(ВыборкаДетальныеЗаписи.Размер.Владелец, "Цвет"));  
		
	КонецЦикла;  
	
	Возврат Результат;
	
КонецФункции //- ИнфоСофт Стояк Ю.К. 22.08.2023 УА #62254

//+ ИнфоСофт Стояк Ю.К. 22.08.2023 УА #62254
&НаСервере
Функция ПолучитьЗначенияПолейНоменклатурыВБ(ОбъектДанных, Поле)
	
	Значение = ""; 
	
	Итератор = 0;
	
	Для Каждого Элемент Из ОбъектДанных.Характеристики Цикл 
		
		Если СокрЛП(Элемент.Поле) = Поле Тогда
			
			Если Итератор = 0 Тогда
				Значение = Элемент.Значение;
				Итератор = Итератор + 1;
			Иначе
				Значение = Значение + ", " + Элемент.Значение; 
			КонецЕсли;	
			
		КонецЕсли;	
		
	КонецЦикла;
	
	Возврат Значение;

КонецФункции //- ИнфоСофт Стояк Ю.К. 22.08.2023 УА #62254

