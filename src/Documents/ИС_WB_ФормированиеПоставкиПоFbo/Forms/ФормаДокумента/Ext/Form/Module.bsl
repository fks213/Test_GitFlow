	Если Не ЗначениеЗаполнено(Номенклатура) Тогда
		Номенклатура = Справочники.Номенклатура.ПустаяСсылка();
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(Характеристика) Тогда
		Характеристика = Справочники.ХарактеристикиНоменклатуры.ПустаяСсылка();
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	ЛОЖЬ КАК МаркированныйТовар,
	|	ИС_WB_СоответствиеРазмеров.Номенклатура КАК Номенклатура,
	|	ИС_WB_СоответствиеРазмеров.Характеристика КАК Характеристика,
	|	МАКСИМУМ(ИС_WB_ШтрихкодыРазмеров.Штрихкод) КАК Штрихкод
	|ИЗ
	|	РегистрСведений.ИС_WB_СоответствиеРазмеров КАК ИС_WB_СоответствиеРазмеров
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ИС_WB_ШтрихкодыРазмеров КАК ИС_WB_ШтрихкодыРазмеров
	|		ПО ИС_WB_СоответствиеРазмеров.РазмерWB = ИС_WB_ШтрихкодыРазмеров.Размер
	|ГДЕ
	|	ИС_WB_СоответствиеРазмеров.Номенклатура = &Номенклатура
	|	И ИС_WB_СоответствиеРазмеров.Характеристика = &Характеристика
	|	И ИС_WB_СоответствиеРазмеров.Профиль = &Профиль
	|
	|СГРУППИРОВАТЬ ПО
	|	ИС_WB_СоответствиеРазмеров.Номенклатура,
	|	ИС_WB_СоответствиеРазмеров.Характеристика";
	
	Запрос.УстановитьПараметр("Профиль", Объект.Профиль);  
	Запрос.УстановитьПараметр("Номенклатура", Номенклатура); 
	Запрос.УстановитьПараметр("Характеристика", Характеристика); 
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Если РезультатЗапроса.Пустой() Тогда		
		ОбщегоНазначения.СообщитьПользователю("Не найдены данные по указанной позиции"); 		
		ДанныеНайдены = Ложь;                       
		Возврат Неопределено;		
	КонецЕсли;
	
	ТЗ = РезультатЗапроса.Выгрузить(); 
	Структура = Новый Структура;
	
	Для Каждого ИмяКолонки Из ТЗ.Колонки Цикл		
		Структура.Вставить(ИмяКолонки.Имя, ТЗ[0][ИмяКолонки.Имя]);
	КонецЦикла;
		
	ДанныеНайдены = Истина;	
	
	Возврат Структура;
	
КонецФункции //- ИнфоСофт Стояк Ю.К. 24.10.2024 УА #76340

#КонецОбласти
