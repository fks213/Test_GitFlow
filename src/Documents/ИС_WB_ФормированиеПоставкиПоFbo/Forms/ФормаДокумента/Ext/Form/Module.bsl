&НаКлиенте
Процедура ВнешнееСобытие(Источник, Событие, Данные) 
	
	Если Не ЗначениеЗаполнено(Объект.Профиль) Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю("Не выбран Профиль", , , "Профиль");
		Возврат;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(Объект.АктивныйШтрихкод) Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю("Не выбран Штрихкод", , , "АктивныйШтрихкод");
		Возврат;
	КонецЕсли;
	
	ШкПринадлежитКоробке = ПолучитьРезультатАктивизацииСтроки(Данные); 
	
	Если ШкПринадлежитКоробке Тогда
		Возврат;	
	КонецЕсли;
	
	ДанныеШтрихкода = Новый Структура; 
	
	ДанныеШтрихкода.Вставить("ФорматBase64", Ложь); 
	ДанныеШтрихкода.Вставить("Штрихкод", СокрЛП(Данные));
	ДанныеШтрихкода.Вставить("Количество", 1);

	//+ ИнфоСофт Стояк Ю.К. 16.08.2024 УА #81842
	ИС_MP_МаркировкаКлиентСервер.ЗакодироватьШтрихкодДанныхBase64(ДанныеШтрихкода); 
	
	ПараметрыСканирования = ИС_MP_МаркировкаКлиент.ПараметрыСканирования(ЭтаФорма);  
	
	РезультатОбработкиШтрихкода = ОбработатьШтрихкод(ДанныеШтрихкода, ПараметрыСканирования);
	
	ОбработатьШтрихкодыЗавершение(РезультатОбработкиШтрихкода.ДанныеШтрихкода, Неопределено);
			                                                  
	//ИС_MP_МаркировкаКлиент.ОбработатьДанныеШтрихкода("ОбработатьШтрихкодыЗавершение", ЭтаФорма, ДанныеШтрихкода);
	//- ИнфоСофт Стояк Ю.К. 16.08.2024 УА #81842

КонецПроцедуры //- ИнфоСофт Сумин Д.В. 15.05.23 УА #56286 

