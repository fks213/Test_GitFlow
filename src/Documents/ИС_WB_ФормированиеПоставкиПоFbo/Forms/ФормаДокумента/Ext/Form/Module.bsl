//+ ИнфоСофт Мурсалимов Д.Р. 09.07.24 УА #79189
&НаКлиенте
Функция ОписаниеОповещенияОбработкиКодаМаркировки()	
	Возврат Новый ОписаниеОповещения("ОбработатьШтрихкодыЗавершение", ЭтотОбъект);	
КонецФункции //- ИнфоСофт Мурсалимов Д.Р. 09.07.24 УА #79189

//+ ИнфоСофт Мурсалимов Д.Р. 09.07.24 УА #79189
&НаКлиенте
Процедура ОбработатьШтрихкодыЗавершение(Результат, Параметры) Экспорт 	
	
	ДанныеШтрихкода = Результат;
		
	Если ДанныеШтрихкода.ДанныеРазбора <> Неопределено И 
			ДанныеШтрихкода.ДанныеРазбора.ТипШтрихкода = ПредопределенноеЗначение("Перечисление.ТипыШтрихкодов.GS1_DataMatrix") Тогда 	
		ПолучитьТоварыПоQrКоду(ДанныеШтрихкода);			
	Иначе
		
		Тип = НайтиПроверочныйШК(ДанныеШтрихкода.Штрихкод);		

		Если ЗначениеЗаполнено(Тип) Тогда        
						
			Если Тип = ПредопределенноеЗначение("Перечисление.ИС_MP_ТипУниверсальногоШтрихкода.ДляСозданияНовойКоробки") Тогда		       
				СгенерироватьШтрихкодКоробки();	
			КонецЕсли; 
			
			ТабДок = ПечатьШтрихкодаКоробки();
			ТабДок.Напечатать(РежимИспользованияДиалогаПечати.НеИспользовать);			
			
		Иначе                                           
			
			ПолучитьТоварыПоШтрихкоду(ДанныеШтрихкода.Штрихкод);

		КонецЕсли;                                  
	
	КонецЕсли;
	
	КоллекцияЭлементовДерева = Товары.ПолучитьЭлементы();
	
	//Найдем строку с активным ШК коробки
	ИдентификаторСтроки = Неопределено;
	Для Каждого Строка Из КоллекцияЭлементовДерева Цикл
		Если Строка.ШтрихкодКоробки = Объект.АктивныйШтрихкод Тогда
			ИдентификаторСтроки = Строка.ПолучитьИдентификатор();	
		КонецЕсли;	
	КонецЦикла;	
	
	Элементы.Товары.Развернуть(ИдентификаторСтроки);
	
	Если АвтоПечать И ДанныеНайдены Тогда
		ТабДок = ПечатьШтрихкода(ПоследнийШтрихкод);
		ТабДок.Напечатать(РежимИспользованияДиалогаПечати.НеИспользовать);
	КонецЕсли;
	
КонецПроцедуры //- ИнфоСофт Мурсалимов Д.Р. 09.07.24 УА #79189

//+ ИнфоСофт Сумин Д.В. 18.08.23 УА #56286
&НаСервере
Функция ПолучитьРезультатПроверкиЗаполненияШК() 
	
	Если Объект.Товары.Количество() < 1 Тогда
		Возврат Истина;	      
	Иначе 
		ШККоробок = Объект.Товары.Выгрузить(,"ШтрихкодКоробки").ВыгрузитьКолонку("ШтрихкодКоробки"); 
		//+ ИнфоСофт Стояк Ю.К. 21.01.2025 УА #91163
		ШККоробок.Добавить("");
		Коробки.Очистить();
		//- ИнфоСофт Стояк Ю.К. 21.01.2025 УА #91163
		Для Каждого ШК Из ШККоробок Цикл 
			
			НайденныеСтроки = Коробки.НайтиСтроки(Новый Структура("ШтрихкодКоробки", ШК));
			
			Если НайденныеСтроки.Количество() = 0 Тогда
				НСтр = Коробки.Добавить();
				НСтр.ШтрихкодКоробки = ШК;
			КонецЕсли;
			
		КонецЦикла;
			
