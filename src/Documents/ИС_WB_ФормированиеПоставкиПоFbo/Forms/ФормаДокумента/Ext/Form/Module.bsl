&НаСервере   
Процедура ВыполнитьПроверкуКодаМаркировки(qrКод, Номенклатура) 
	
	МодульИнтерфейсИСМПКлиентСервер = ОбщегоНазначения.ОбщийМодуль("ИнтерфейсИСМПКлиентСервер");
	
	Если МодульИнтерфейсИСМПКлиентСервер = Неопределено Тогда
		ОбщегоНазначения.СообщитьПользователю("Метод Api был изменен. Проверка не выполнена.");
		Возврат;
	КонецЕсли;
	
	КлючСессии = ИнтерфейсАвторизацииИСМПСлужебный.ПроверитьОбновитьКлючСессии(МодульИнтерфейсИСМПКлиентСервер.ПараметрыЗапросаКлючаСессии());
	
	Если КлючСессии = Неопределено Тогда
		ОбщегоНазначения.СообщитьПользователю("Данные по коду не получены. Проверьте настройки интеграции ИС МП.");
		Возврат;
	КонецЕсли;	
	
	URLЗапроса = "api/v3/true-api/cises/info";
	
	ДанныеЗапроса = Новый Массив;
	ДанныеЗапроса.Добавить(qrКод);
	
	МодульИнтерфейсМОТПКлиентСервер = ОбщегоНазначения.ОбщийМодуль("ИнтерфейсМОТПКлиентСервер");
	
	Если МодульИнтерфейсМОТПКлиентСервер = Неопределено Тогда
		ОбщегоНазначения.СообщитьПользователю("Метод Api был изменен. Проверка не выполнена.");
		Возврат;
	КонецЕсли;

	РезультатЗапроса = ИнтеграцияИСМП.ОтправитьДанныеВСервис(URLЗапроса, ДанныеЗапроса, КлючСессии, "POST",
		МодульИнтерфейсМОТПКлиентСервер.ПараметрыОтправкиHTTPЗапросов("", Истина));
	
	РезультатОтправкиЗапроса = ИнтерфейсМОТПСлужебный.ОбработатьРезультатОтправкиHTTPЗапросаКакJSON(РезультатЗапроса);
	
	JSON = ИС_MP_РаботаСHTTPЗапросамиСервер.ПолучитьОбъектJSON(РезультатОтправкиЗапроса.ТекстВходящегоСообщения);
	
	Если JSON[0].Свойство("cisInfo") Тогда
		Если JSON[0].cisInfo.status <> "INTRODUCED" Тогда
			ОбщегоНазначения.СообщитьПользователю(СтрШаблон("Код маркировки не находится в обороте. Статус кода %1", JSON[0].cisInfo.status));	
		КонецЕсли;
		
		ИНН = JSON[0].cisInfo.ownerInn;
		
		ОрганизацияПоиска = Справочники.Организации.НайтиПоРеквизиту("ИНН", ИНН);
		
		Если ОрганизацияПоиска <> Объект.Профиль.Организация Тогда
			ОбщегоНазначения.СообщитьПользователю(СтрШаблон("Отсканированный код принадлежит другой организации. Владелец %1, инн владельца: %2.", JSON[0].cisInfo.ownerName, ИНН)); 		
		КонецЕсли;
	Иначе
		ОбщегоНазначения.СообщитьПользователю("Метод Api был изменен. Проверка не выполнена.");	
	КонецЕсли;	
	
КонецПроцедуры //- ИнфоСофт Сумин Д.В. 14.02.2024 УА #62253	

