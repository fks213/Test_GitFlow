//+ ИнфоСофт Ивонин К.А. 10.04.25 УА #96894
&НаКлиенте
Процедура ПокупательПринялЗавершение(Результат, ДопПараметры) Экспорт

	Если Результат = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Результат = ПодтвердитьВыдачуЗаказаDBS(Профиль, ДопПараметры.Номер, Результат);
	
	Если Результат Тогда
		ОбновитьВыделенныеСтатусы(Неопределено);
		ОбщегоНазначенияКлиент.СообщитьПользователю("Подтверждение выполнено");
		Элементы.Список.Обновить();
	КонецЕсли;
	
КонецПроцедуры //- ИнфоСофт Ивонин К.А. 10.04.25 УА #96894

