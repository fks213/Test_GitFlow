//+ ИнфоСофт Ивонин К.А. 07.04.25 УА #96894
&НаСервереБезКонтекста
Функция УдалитьНедопустимыеТипыЭтикеток(МассивЗаказов)
	
	ТипыДоставки = Новый Массив;
	ТипыДоставки.Добавить(Перечисления.ИС_ВБ_ТипыДоставки.FBS);
	ТипыДоставки.Добавить(Перечисления.ИС_ВБ_ТипыДоставки.DBW);
	ТипыДоставки.Добавить(Перечисления.ИС_ВБ_ТипыДоставки.DBS);
	ТипыДоставки.Добавить(Перечисления.ИС_ВБ_ТипыДоставки.EDBS);
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ИС_WB_СборочноеЗадание.Ссылка КАК Ссылка
	|ИЗ
	|	Документ.ИС_WB_СборочноеЗадание КАК ИС_WB_СборочноеЗадание
	|ГДЕ
	|	ИС_WB_СборочноеЗадание.Ссылка В(&Ссылка)
	|	И ИС_WB_СборочноеЗадание.ТипДоставки В(&ТипДоставки)";
	
	Запрос.УстановитьПараметр("Ссылка", МассивЗаказов);
	Запрос.УстановитьПараметр("ТипДоставки", ТипыДоставки);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Результат = Новый Массив;
	
	ВыборкаЗаказов = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаЗаказов.Следующий() Цикл
		Результат.Добавить(ВыборкаЗаказов.Ссылка);
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции //- ИнфоСофт Ивонин К.А. 07.04.25 УА #96894

//+ ИнфоСофт Ивонин К.А. 08.04.25 УА #96894
&НаСервере   
Процедура ОпределитьСписокДоступныхДействий()
	
	Элементы.ПеревестиНаСборку.Видимость = Ложь;
	Элементы.ПеревестиВДоставку.Видимость = Ложь;
	Элементы.ГотовКВыдаче.Видимость = Ложь;
	Элементы.ПокупательПринял.Видимость = Ложь;
	Элементы.ПокупательОтказался.Видимость = Ложь;
	Элементы.ОтменитьЗаказ.Видимость = Ложь;
	
	Если Не ЗначениеЗаполнено(Профиль) Тогда
		Возврат;
	КонецЕсли;
	
	Маркетплейс = Перечисления.ИС_МП_Маркетплейсы.ВБ;
	
	МассивНастроек = ИС_ВБ_Сервер.МассивНастроекСхемРаботы();
	
	СтруктураНастроек = ИС_МП_Сервер.ПолучитьЗначениеНастроек(Профиль, Маркетплейс, МассивНастроек); 
		
	ЗаголовокПеревестиНаСборку = "Перевести на сборку (";
	ЗаголовокПеревестиВДоставку = "Перевести в доставку (";
	ЗаголовокПокупательПринял = "Покупатель принял (";
	ЗаголовокПокупательОтказался = "Покупатель отказался (";
	
	Если СтруктураНастроек.ЗаказыFBS <> Неопределено И СтруктураНастроек.ЗаказыFBS Тогда
		Элементы.ПеревестиНаСборку.Видимость = Истина;
		Элементы.ПеревестиВДоставку.Видимость = Истина;
		Элементы.ОтменитьЗаказ.Видимость = Истина;
		ЗаголовокПеревестиНаСборку = ЗаголовокПеревестиНаСборку + "DBW / ";
		ЗаголовокПеревестиВДоставку = ЗаголовокПеревестиВДоставку + "DBW / ";
	КонецЕсли;
	
	Если СтруктураНастроек.ЗаказыDBS <> Неопределено И СтруктураНастроек.ЗаказыDBS Тогда
		Элементы.ПеревестиНаСборку.Видимость = Истина;
		Элементы.ПеревестиВДоставку.Видимость = Истина;
		Элементы.ПокупательПринял.Видимость = Истина;
		Элементы.ПокупательОтказался.Видимость = Истина;
		Элементы.ОтменитьЗаказ.Видимость = Истина;
		ЗаголовокПеревестиНаСборку = ЗаголовокПеревестиНаСборку + "DBS / ";
		ЗаголовокПеревестиВДоставку = ЗаголовокПеревестиВДоставку + "DBS";
		ЗаголовокПокупательПринял = ЗаголовокПокупательПринял + "DBS / ";
		ЗаголовокПокупательОтказался = ЗаголовокПокупательОтказался + "DBS / ";
	КонецЕсли;
		
	Если СтруктураНастроек.ЗаказыCnC <> Неопределено И СтруктураНастроек.ЗаказыCnC Тогда
		Элементы.ПеревестиНаСборку.Видимость = Истина;
		Элементы.ГотовКВыдаче.Видимость = Истина;
		Элементы.ПокупательПринял.Видимость = Истина;
		Элементы.ПокупательОтказался.Видимость = Истина;
		Элементы.ОтменитьЗаказ.Видимость = Истина;
		ЗаголовокПеревестиНаСборку = ЗаголовокПеревестиНаСборку + "C&&C";
		ЗаголовокПокупательПринял = ЗаголовокПокупательПринял + "C&&C";
		ЗаголовокПокупательОтказался = ЗаголовокПокупательОтказался + "C&&C";
	КонецЕсли;
	
	Если Прав(ЗаголовокПеревестиНаСборку, 1) = " " Тогда
		ЗаголовокПеревестиНаСборку = Лев(ЗаголовокПеревестиНаСборку, СтрДлина(ЗаголовокПеревестиНаСборку) - 3);	
	КонецЕсли;
	
	Если Прав(ЗаголовокПеревестиВДоставку, 1) = " " Тогда
		ЗаголовокПеревестиВДоставку = Лев(ЗаголовокПеревестиВДоставку, СтрДлина(ЗаголовокПеревестиВДоставку) - 3);	
	КонецЕсли;
	
	Если Прав(ЗаголовокПокупательПринял, 1) = " " Тогда
		ЗаголовокПокупательПринял = Лев(ЗаголовокПокупательПринял, СтрДлина(ЗаголовокПокупательПринял) - 3);	
	КонецЕсли;
	
	Если Прав(ЗаголовокПокупательОтказался, 1) = " " Тогда
		ЗаголовокПокупательОтказался = Лев(ЗаголовокПокупательОтказался, СтрДлина(ЗаголовокПокупательОтказался) - 3);	
	КонецЕсли;
	
	ЗаголовокПеревестиНаСборку = ЗаголовокПеревестиНаСборку + ")";
	ЗаголовокПеревестиВДоставку = ЗаголовокПеревестиВДоставку + ")";
	ЗаголовокПокупательПринял = ЗаголовокПокупательПринял + ")";
	ЗаголовокПокупательОтказался = ЗаголовокПокупательОтказался + ")";
	
	Элементы.ПеревестиНаСборку.Заголовок = ЗаголовокПеревестиНаСборку;
	Элементы.ПеревестиВДоставку.Заголовок = ЗаголовокПеревестиВДоставку;
	Элементы.ПокупательПринял.Заголовок = ЗаголовокПокупательПринял;
	Элементы.ПокупательОтказался.Заголовок = ЗаголовокПокупательОтказался;
	
КонецПроцедуры //- ИнфоСофт Ивонин К.А. 08.04.25 УА #96894

