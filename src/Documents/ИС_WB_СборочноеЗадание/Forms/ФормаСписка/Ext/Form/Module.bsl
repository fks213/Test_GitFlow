&НаСервере
Функция ПолучитьЛистПодбораНаСервере(ВыделенныеСтроки)

	Табдок = Новый ТабличныйДокумент;
	
	Табдок.ИмяПараметровПечати = "ИС_WB_ПечатьЛистаПодбора";
	ТабДок.ОриентацияСтраницы = ОриентацияСтраницы.Портрет;
	ТабДок.АвтоМасштаб = Истина; 
		
	ТабДок.ПолеСправа = 7;	
	
	МакетОбработки = УправлениеПечатью.МакетПечатнойФормы("Документ.ИС_WB_СборочноеЗадание.ПФ_MXL_ЛистПодбора");
		
	МассивЗначений = Новый Массив;
	МассивЗначений.Добавить("ПечататьНомерСтроки");       
	МассивЗначений.Добавить("ПечататьНомерСборочного"); 
	МассивЗначений.Добавить("ПечататьНомерЗаказа"); 	
	МассивЗначений.Добавить("ПечататьНомерРеализации");   	
	МассивЗначений.Добавить("ПечататьБренд");               
	МассивЗначений.Добавить("ПечататьНазвание");	    
	МассивЗначений.Добавить("ПечататьРазмер");
	МассивЗначений.Добавить("ПечататьЦвет");
	МассивЗначений.Добавить("ПечататьАртикулВБ");
	МассивЗначений.Добавить("ПечататьАртикулПоставщика");
	МассивЗначений.Добавить("ПечататьАртикул1С");
	МассивЗначений.Добавить("ПечататьQR");	  		
	МассивЗначений.Добавить("ПечататьШтрихкод");
	МассивЗначений.Добавить("ПечататьКоличество");   	
	МассивЗначений.Добавить("ПечататьФото");
	
	НастройкиПечати = ИС_МП_Печать.ПолучитьНастройкиПечатиЛистаПодбора(Профиль, МассивЗначений, Перечисления.ИС_МП_Маркетплейсы.ВБ);	
	
	ОбластьШапка = МакетОбработки.ПолучитьОбласть("Шапка|ОсновнойЛист");

	
	ОбластьШапка.Параметры.Дата = ТекущаяДатаСеанса();
	ОбластьШапка.Параметры.Профиль = Профиль;   
		
	Если ЗначениеЗаполнено(СортировкаПечати) Тогда	
		ОбластьШапка.Параметры.Сорт = Элементы.СортировкаПечати.СписокВыбора.НайтиПоЗначению(СортировкаПечати).Представление;
	Иначе
		СортировкаПечати = "Код";
		ОбластьШапка.Параметры.Сорт = Элементы.СортировкаПечати.СписокВыбора.НайтиПоЗначению(СортировкаПечати).Представление;
	КонецЕсли;                                  		
	
	Табдок.Вывести(ОбластьШапка);
		
	ИС_МП_Печать.ЗаполнитьШапкуТаблицыЛистаПодбора(Табдок, МакетОбработки, НастройкиПечати, МассивЗначений);  
	
	МассивСтатусов = Новый Массив;
	МассивСтатусов.Добавить(Перечисления.ИС_WB_СтатусыСборочныхЗаданийВСистемеWildBerries.waiting);
	МассивСтатусов.Добавить(Перечисления.ИС_WB_СтатусыСборочныхЗаданийВСистемеWildBerries.sorted);
	МассивСтатусов.Добавить(Перечисления.ИС_WB_СтатусыСборочныхЗаданийВСистемеWildBerries.sold);
	МассивСтатусов.Добавить(Перечисления.ИС_WB_СтатусыСборочныхЗаданийВСистемеWildBerries.ready_for_pickup);
	МассивСтатусов.Добавить(Перечисления.ИС_WB_СтатусыСборочныхЗаданийВСистемеWildBerries.postponed_delivery);	
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	ИС_WB_ХарактеристикиКатегорий.Ссылка КАК Ссылка
	|ПОМЕСТИТЬ ВТ_Бренд
	|ИЗ
	|	Справочник.ИС_WB_ХарактеристикиКатегорий КАК ИС_WB_ХарактеристикиКатегорий
	|ГДЕ
	|	ИС_WB_ХарактеристикиКатегорий.Наименование = ""Бренд""
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ ПЕРВЫЕ 1
	|	ИС_WB_ХарактеристикиКатегорий.Ссылка КАК Ссылка
	|ПОМЕСТИТЬ ВТ_Цвет
	|ИЗ
	|	Справочник.ИС_WB_ХарактеристикиКатегорий КАК ИС_WB_ХарактеристикиКатегорий
	|ГДЕ
	|	ИС_WB_ХарактеристикиКатегорий.Наименование = ""Цвет""
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ИС_WB_СборочноеЗадание.Ссылка КАК Ссылка,
	|	ПередачаТоваровХранителюТовары.Ссылка.Номер КАК НомерРеализации
	|ПОМЕСТИТЬ ВТ_РТУ
	|ИЗ
	|	Документ.ИС_WB_СборочноеЗадание КАК ИС_WB_СборочноеЗадание
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ПередачаТоваровХранителю.Товары КАК ПередачаТоваровХранителюТовары
	|		ПО (ИС_WB_СборочноеЗадание.Заказ = ПередачаТоваровХранителюТовары.ЗаказКлиента)
	|			И (НЕ ИС_WB_СборочноеЗадание.Заказ = ЗНАЧЕНИЕ(Документ.ЗаказКлиента.ПустаяСсылка))
	|ГДЕ
	|	НЕ ИС_WB_СборочноеЗадание.Заказ = ЗНАЧЕНИЕ(Документ.ЗаказКлиента.ПустаяСсылка)
	|	И НЕ ПередачаТоваровХранителюТовары.Ссылка ЕСТЬ NULL
	|	И ИС_WB_СборочноеЗадание.Ссылка В(&МассивСсылок)
	|
	|ОБЪЕДИНИТЬ
	|
	|ВЫБРАТЬ
	|	ИС_WB_СборочноеЗадание.Ссылка,
	|	РеализацияТоваровУслугТовары.Ссылка.Номер
	|ИЗ
	|	Документ.ИС_WB_СборочноеЗадание КАК ИС_WB_СборочноеЗадание
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.РеализацияТоваровУслуг.Товары КАК РеализацияТоваровУслугТовары
	|		ПО ИС_WB_СборочноеЗадание.Заказ = РеализацияТоваровУслугТовары.ЗаказКлиента
	|			И (НЕ ИС_WB_СборочноеЗадание.Заказ = ЗНАЧЕНИЕ(Документ.ЗаказКлиента.ПустаяСсылка))
	|ГДЕ
	|	НЕ ИС_WB_СборочноеЗадание.Заказ = ЗНАЧЕНИЕ(Документ.ЗаказКлиента.ПустаяСсылка)
	|	И НЕ РеализацияТоваровУслугТовары.Ссылка ЕСТЬ NULL
	|	И ИС_WB_СборочноеЗадание.Ссылка В(&МассивСсылок)
	|;
	|	
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ИС_WB_СборочноеЗадание.Номер КАК Номер,
	|	ИС_WB_СборочноеЗадание.Дата КАК Дата,
	|	МАКСИМУМ(ЕСТЬNULL(ИС_WB_НоменклатураХарактеристикиБренд.Значение, """")) КАК Бренд,
	|	МАКСИМУМ(ИС_WB_СоответствиеРазмеров.Номенклатура) КАК Номенклатура,
	|	МАКСИМУМ(ИС_WB_СоответствиеРазмеров.Характеристика) КАК Характеристика,
	|	ИС_WB_СборочноеЗадание.НоменклатураWB.Код КАК Код,
	|	ИС_WB_СборочноеЗадание.НоменклатураWB.vendorCode КАК vendorCode,
	|	ЕСТЬNULL(ИС_WB_СтатусыИЭтикеткиСборочныхЗаданий.partA, """") КАК partA,
	|	ЕСТЬNULL(ИС_WB_СтатусыИЭтикеткиСборочныхЗаданий.partB, """") КАК partB,
	|	ЕСТЬNULL(ИС_WB_СтатусыИЭтикеткиСборочныхЗаданий.barcode, """") КАК barcode,
	|	ИС_WB_СборочноеЗадание.РазмерWB.techSize КАК techSize,
	|	МАКСИМУМ(ЕСТЬNULL(ИС_WB_НоменклатураХарактеристикиЦвет.Значение, """")) КАК Цвет,
	|	МАКСИМУМ(ЕСТЬNULL(ИС_WB_ШтрихкодыРазмеров.Штрихкод, """")) КАК Штрихкод,
	|	ИС_WB_СоответствиеРазмеров.Номенклатура.Артикул КАК НоменклатураАртикул,
	|	ИС_WB_СборочноеЗадание.Заказ.Номер КАК НомерЗаказа,
	|	ВЫБОР
	|		КОГДА ИС_WB_СборочноеЗадание.Заказ = ЗНАЧЕНИЕ(Документ.ЗаказКлиента.ПустаяСсылка)
	|			ТОГДА """"
	|		ИНАЧЕ МИНИМУМ(ВТ_РТУ.НомерРеализации)
	|	КОНЕЦ КАК НомерРеализации
	|ПОМЕСТИТЬ ВТ
	|ИЗ
	|	Документ.ИС_WB_СборочноеЗадание КАК ИС_WB_СборочноеЗадание
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ИС_WB_СтатусыИЭтикеткиСборочныхЗаданий КАК ИС_WB_СтатусыИЭтикеткиСборочныхЗаданий
	|		ПО ИС_WB_СборочноеЗадание.Ссылка = ИС_WB_СтатусыИЭтикеткиСборочныхЗаданий.СборочноеЗадание
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ИС_WB_СоответствиеРазмеров КАК ИС_WB_СоответствиеРазмеров
	|		ПО ИС_WB_СборочноеЗадание.РазмерWB = ИС_WB_СоответствиеРазмеров.РазмерWB
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ИС_WB_Номенклатура.Характеристики КАК ИС_WB_НоменклатураХарактеристикиБренд
	|		ПО ИС_WB_СборочноеЗадание.НоменклатураWB = ИС_WB_НоменклатураХарактеристикиБренд.Ссылка
	|			И (ИС_WB_НоменклатураХарактеристикиБренд.Поле В
	|				(ВЫБРАТЬ
	|					ВТ.Ссылка
	|				ИЗ
	|					ВТ_Бренд КАК ВТ))
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ИС_WB_Номенклатура.Характеристики КАК ИС_WB_НоменклатураХарактеристикиЦвет
	|		ПО ИС_WB_СборочноеЗадание.НоменклатураWB = ИС_WB_НоменклатураХарактеристикиЦвет.Ссылка
	|			И (ИС_WB_НоменклатураХарактеристикиЦвет.Поле В
	|				(ВЫБРАТЬ
	|					ВТ.Ссылка
	|				ИЗ
	|					ВТ_Цвет КАК ВТ))
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ИС_WB_СборочноеЗадание.skus КАК ИС_WB_СборочноеЗаданиеskus
	|		ПО ИС_WB_СборочноеЗадание.Ссылка = ИС_WB_СборочноеЗаданиеskus.Ссылка
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_РТУ КАК ВТ_РТУ
	|		ПО ИС_WB_СборочноеЗадание.Ссылка = ВТ_РТУ.Ссылка
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ИС_WB_ШтрихкодыРазмеров КАК ИС_WB_ШтрихкодыРазмеров
	|		ПО (ИС_WB_ШтрихкодыРазмеров.Размер = ИС_WB_СборочноеЗадание.РазмерWB)
	|ГДЕ
	|	ИС_WB_СборочноеЗадание.Ссылка В(&МассивСсылок)
	|	И ИС_WB_СтатусыИЭтикеткиСборочныхЗаданий.СтатусWB В(&Статусы)
	|
	|СГРУППИРОВАТЬ ПО
	|	ИС_WB_СборочноеЗадание.Номер,
	|	ИС_WB_СборочноеЗадание.Дата,
	|	ИС_WB_СборочноеЗадание.НоменклатураWB.Код,
	|	ИС_WB_СборочноеЗадание.НоменклатураWB.vendorCode,
	|	ЕСТЬNULL(ИС_WB_СтатусыИЭтикеткиСборочныхЗаданий.partA, """"),
	|	ЕСТЬNULL(ИС_WB_СтатусыИЭтикеткиСборочныхЗаданий.partB, """"),
	|	ЕСТЬNULL(ИС_WB_СтатусыИЭтикеткиСборочныхЗаданий.barcode, """"),
	|	ИС_WB_СборочноеЗадание.РазмерWB.techSize,
	|	ИС_WB_СоответствиеРазмеров.Номенклатура.Артикул,
	|	ИС_WB_СборочноеЗадание.Заказ.Номер,
	|	ИС_WB_СборочноеЗадание.Заказ
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ.Номер КАК НомерЗадания,
	|	ВТ.Дата КАК Дата,
	|	ВТ.Бренд КАК Бренд,
	|	ЕСТЬNULL(ВТ.Номенклатура, ""Отсутствует"") КАК Номенклатура,
	|	ЕСТЬNULL(ВТ.Характеристика, ""Сопоставление"") КАК Характеристика,
	|	ВТ.Код КАК Код,
	|	ВТ.vendorCode КАК Артикул,
	|	ВТ.partA КАК partA,
	|	ВТ.partB КАК partB,
	|	ВТ.barcode КАК barcode,
	|	ВТ.techSize КАК Размер,
	|	ВТ.Цвет КАК Цвет,
	|	ВТ.Штрихкод КАК Штрихкод,
	|	ЕСТЬNULL(ВТ.Номенклатура.Наименование, """") КАК Наименование,
	|	ВТ.Номенклатура.ФайлКартинки КАК ФайлКартинки,
	|	ВТ.НоменклатураАртикул КАК Артикул1С,
	|	ВТ.НомерЗаказа КАК НомерЗаказа,
	|	ВТ.НомерРеализации КАК НомерРеализации
	|ИЗ
	|	ВТ КАК ВТ
	|
	|УПОРЯДОЧИТЬ ПО
	|	%1";
	
	Запрос.Текст = СтрШаблон(Запрос.Текст, ?(СортировкаПечати = "Наименование", "Наименование, Характеристика, Номер, Цвет, Код", СортировкаПечати));
	
	Запрос.УстановитьПараметр("МассивСсылок", ВыделенныеСтроки); 
		
	Запрос.УстановитьПараметр("Статусы", МассивСтатусов);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Если РезультатЗапроса.Пустой() Тогда
		ОбщегоНазначения.СообщитьПользователю("Не удалось сформировать лист подбора");
		Возврат Табдок;	
	КонецЕсли;
		
	ОбластьСтроки = МакетОбработки.ПолучитьОбласть("ДанныеСтроки");
	
	Эталон = УправлениеПечатью.МакетПечатнойФормы("Документ.ИС_WB_СборочноеЗадание.Эталон"); 
	КоличествоМиллиметровВПикселе = Эталон.Рисунки.Квадрат100Пикселей.Высота / 100;
					
	Выборка = РезультатЗапроса.Выбрать();
	
	ВысотаОбластей = Табдок.ВысотаТаблицы;
		
	Если ВыводитьКомплектующие Тогда
		
		Запрос = Новый Запрос;
		Запрос.Текст =	
		"ВЫБРАТЬ
		|	ВТ.НомерЗадания КАК НомерЗадания,
		|	ВТ.Номенклатура КАК Номенклатура,
		|	ВТ.Характеристика КАК Характеристика,
		|	ВТ.partA КАК partA,
		|	ВТ.partB КАК partB,
		|	ВТ.barcode КАК barcode
		|ПОМЕСТИТЬ ВТ_Номенклатура
		|ИЗ
		|	&ВТ КАК ВТ
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ВТ_Номенклатура.НомерЗадания КАК НомерЗадания,
		|	ВТ_Номенклатура.Номенклатура КАК Номенклатура,
		|	ВТ_Номенклатура.Характеристика КАК Характеристика,
		|	ВТ_Номенклатура.partA КАК partA,
		|	ВТ_Номенклатура.partB КАК partB,
		|	ВТ_Номенклатура.barcode КАК barcode,
		|	ВариантыКомплектацииНоменклатурыТовары.Номенклатура КАК НоменклатураНабора,
		|	ВариантыКомплектацииНоменклатурыТовары.Характеристика КАК ХарактеристикаНабора,
		|	ВариантыКомплектацииНоменклатурыТовары.КоличествоУпаковок КАК КоличествоУпаковок
		|ПОМЕСТИТЬ ВТ_СоставНаборов
		|ИЗ
		|	ВТ_Номенклатура КАК ВТ_Номенклатура
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ВариантыКомплектацииНоменклатуры.Товары КАК ВариантыКомплектацииНоменклатурыТовары
		|		ПО ВТ_Номенклатура.Номенклатура = ВариантыКомплектацииНоменклатурыТовары.Ссылка.Владелец
		|			И ВТ_Номенклатура.Характеристика = ВариантыКомплектацииНоменклатурыТовары.Ссылка.Характеристика
		|ГДЕ
		|	ВариантыКомплектацииНоменклатурыТовары.Ссылка.Владелец <> ЗНАЧЕНИЕ(Справочник.Номенклатура.ПустаяСсылка)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ВТ_СоставНаборов.НомерЗадания КАК НомерЗадания,
		|	ВТ_СоставНаборов.Номенклатура КАК Номенклатура,
		|	ВТ_СоставНаборов.Характеристика КАК Характеристика,
		|	ВТ_СоставНаборов.partA КАК partA,
		|	ВТ_СоставНаборов.partB КАК partB,
		|	ВТ_СоставНаборов.barcode КАК barcode,
		|	ВТ_СоставНаборов.НоменклатураНабора КАК НоменклатураНабора,
		|	ВТ_СоставНаборов.ХарактеристикаНабора КАК ХарактеристикаНабора,
		|	ВТ_СоставНаборов.КоличествоУпаковок КАК КоличествоУпаковок,
		|	ВТ_СоставНаборов.НоменклатураНабора.ФайлКартинки КАК ФайлКартинки,
		|	ВТ_СоставНаборов.НоменклатураНабора.Марка КАК Бренд,
		|	ВТ_СоставНаборов.НоменклатураНабора.Артикул КАК Артикул
		|ИЗ
		|	ВТ_СоставНаборов КАК ВТ_СоставНаборов
		|
		|УПОРЯДОЧИТЬ ПО
		|	ВТ_СоставНаборов.НоменклатураНабора.Наименование";		  
		
		Запрос.УстановитьПараметр("ВТ", РезультатЗапроса.Выгрузить());
		
		РезультатЗапроса = Запрос.Выполнить();
		
		ВыгрузкаНаборы = РезультатЗапроса.Выгрузить(); 
		
	КонецЕсли;
	
	НомерСтроки = 0;
	
	Пока Выборка.Следующий() Цикл  
		
		ОбластьВыведена = Ложь; 
		
		Для Каждого Параметр Из МассивЗначений Цикл
			
			Если НастройкиПечати[Параметр] Тогда
				
				ОбластьСтроки = МакетОбработки.ПолучитьОбласть("ДанныеСтроки|" + Сред(Параметр, 9));
				
				ЗаполнитьЗначенияСвойств(ОбластьСтроки.Параметры, Выборка);
				
				Если Параметр = "ПечататьНомерСтроки" Тогда             
					НомерСтроки = НомерСтроки + 1;
					ОбластьСтроки.Параметры.НомерСтроки = НомерСтроки;						
				КонецЕсли;
				
				Если Параметр = "ПечататьНазвание" Тогда
					ОбластьСтроки.Параметры.Название = СтрШаблон("%1 %2", Выборка.Номенклатура, Выборка.Характеристика);	
				КонецЕсли; 
				
				Если Параметр = "ПечататьАртикулВБ" Тогда
					ОбластьСтроки.Параметры.АртикулWB = Формат(Выборка.Код, "ЧГ=");	
				КонецЕсли; 
				
				Если Параметр = "ПечататьQR" Тогда
					
					Размер = Окр(ОбластьСтроки.Рисунки.КартинкаQR.Ширина / КоличествоМиллиметровВПикселе);					
					ДвоичныеДанныеКартинки = ИС_MP_ГенерацияШтрихкода.ДанныеQRКода(Выборка.barcode, 0, Размер);					
					ОбластьСтроки.Рисунки.КартинкаQR.Картинка = Новый Картинка(ДвоичныеДанныеКартинки); 
					
				КонецЕсли;
				
				Если Параметр = "ПечататьШтрихкод" Тогда
					
					ПараметрыШК = ИС_MP_ГенерацияШтрихкода.ПараметрыГенерацииШтрихкода();
					
					ПараметрыШК.Ширина = Окр(ОбластьСтроки.Рисунки.КартинкаШК.Ширина / КоличествоМиллиметровВПикселе);
					ПараметрыШК.Высота = Окр(ОбластьСтроки.Рисунки.КартинкаШК.Высота / КоличествоМиллиметровВПикселе);
					ПараметрыШК.РазмерШрифта = 10;
					ПараметрыШК.Штрихкод = Выборка.Штрихкод;
					ПараметрыШК.Масштабировать = Истина;
					ПараметрыШК.СохранятьПропорции = Истина;
					ПараметрыШК.ВертикальноеВыравнивание = 2; 
					
					СтруктураКартинки = ИС_MP_ГенерацияШтрихкода.ИзображениеШтрихкода(ПараметрыШК);
					
					Если СтруктураКартинки.Результат Тогда	
						ОбластьСтроки.Рисунки.КартинкаШК.Картинка = СтруктураКартинки.Картинка;
					КонецЕсли; 
					
				КонецЕсли;
				
				Если Параметр = "ПечататьФото" И ЗначениеЗаполнено(Выборка.ФайлКартинки) Тогда
					ОбластьСтроки.Рисунки.КартинкаТовара.Картинка = Новый Картинка(РаботаСФайлами.ДвоичныеДанныеФайла(Выборка.ФайлКартинки));
				КонецЕсли;
				
				//+ ИнфоСофт Стояк Ю.К. 18.04.2025 УА #98648
				Если Не ТабДок.ПроверитьВывод(ОбластьСтроки) Тогда 					
					Табдок.ВывестиГоризонтальныйРазделительСтраниц();					
				КонецЕсли;
				//- ИнфоСофт Стояк Ю.К. 18.04.2025 УА #98648
				
				Если ОбластьВыведена Тогда
					ТабДок.Присоединить(ОбластьСтроки);	
				Иначе  
					ТабДок.Вывести(ОбластьСтроки);
					ВысотаОбластей = ВысотаОбластей + ОбластьСтроки.ВысотаТаблицы;
					ОбластьВыведена = Истина;
				КонецЕсли; 
				
				//+ ИнфоСофт Стояк Ю.К. 18.04.2025 УА #98648				
				//Если ВысотаОбластей + ОбластьСтроки.ВысотаТаблицы >= 102 Тогда 					
				//	Табдок.ВывестиГоризонтальныйРазделительСтраниц();
				//	ВысотаОбластей = 0;
				//КонецЕсли;                                  
				//- ИнфоСофт Стояк Ю.К. 18.04.2025 УА #98648
				
			КонецЕсли;
			
		КонецЦикла;
		
		Если ВыводитьКомплектующие И ВыгрузкаНаборы.Количество() > 0 Тогда                    
			
			ОбластьСтроки = МакетОбработки.ПолучитьОбласть("ДанныеСтрокиНабора|ОсновнойЛист");
			
			НайденныеСтроки = ВыгрузкаНаборы.НайтиСтроки(Новый Структура("Номенклатура, Характеристика", Выборка.Номенклатура, Выборка.Характеристика));
			
			Если НайденныеСтроки.Количество() > 0 Тогда
				
				Для Каждого Строка Из НайденныеСтроки Цикл
					
					ОбластьВыведена = Ложь; 
					
					Для Каждого Параметр Из МассивЗначений Цикл
						
						Если НастройкиПечати[Параметр] Тогда
							
							ОбластьСтроки = МакетОбработки.ПолучитьОбласть("ДанныеСтроки|" + Сред(Параметр, 9));
							
							ЗаполнитьЗначенияСвойств(ОбластьСтроки.Параметры, Строка);  
							
							Если Параметр = "ПечататьНазвание" Тогда
								ОбластьСтроки.Параметры.Название     = СтрШаблон("Комплектующая набора: %1 %2 в количестве %3", Строка.НоменклатураНабора, Строка.ХарактеристикаНабора, Строка.КоличествоУпаковок);
							КонецЕсли; 
							
							Если Параметр = "ПечататьQR" Тогда								
								ОбластьСтроки.Рисунки.КартинкаQRНабор.Картинка = Новый Картинка(ДвоичныеДанныеКартинки); 								
							КонецЕсли;
														
							Если Параметр = "ПечататьФото" И ЗначениеЗаполнено(Строка.ФайлКартинки) Тогда								
								ОбластьСтроки.Рисунки.КартинкаТовараНабор.Картинка = Новый Картинка(РаботаСФайлами.ДвоичныеДанныеФайла(Строка.ФайлКартинки));								
							КонецЕсли;
							
							//+ ИнфоСофт Стояк Ю.К. 18.04.2025 УА #98648
							Если Не ТабДок.ПроверитьВывод(ОбластьСтроки) Тогда 					
								Табдок.ВывестиГоризонтальныйРазделительСтраниц();								
							КонецЕсли;
							//- ИнфоСофт Стояк Ю.К. 18.04.2025 УА #98648
							
							Если ОбластьВыведена Тогда
								ТабДок.Присоединить(ОбластьСтроки);	
							Иначе  
								ТабДок.Вывести(ОбластьСтроки);
								ВысотаОбластей = ВысотаОбластей + ОбластьСтроки.ВысотаТаблицы;
								ОбластьВыведена = Истина;
							КонецЕсли; 
							
							//+ ИнфоСофт Стояк Ю.К. 18.04.2025 УА #98648							
							//Если ВысотаОбластей + ОбластьСтроки.ВысотаТаблицы >= 104 Тогда 					
							//	Табдок.ВывестиГоризонтальныйРазделительСтраниц();
							//	ВысотаОбластей = 0;
							//КонецЕсли;                                  
							//- ИнфоСофт Стояк Ю.К. 18.04.2025 УА #98648
							
						КонецЕсли;
						
					КонецЦикла;
																							 					
					ВыгрузкаНаборы.Удалить(Строка);
					
				КонецЦикла;
				
			КонецЕсли; 
						
		КонецЕсли;				
			
	КонецЦикла;    
	
	Возврат Табдок;
	
КонецФункции //- ИнфоСофт Стояк Ю.К. 09.02.2025 УА #77168

//+ ИнфоСофт Стояк Ю.К. 09.02.2025 УА #77168
//Тело функции пркатически полностью заменено переносом доработок из УНФ3, старые комментарии удалены 
//+ ИнфоСофт Ивонин К.А. 20.03.23 УА #55822
&НаСервере
Функция ПолучитьЛистПодбораКомпактныйНаСервере(ВыделенныеСтроки)
	
	Табдок = Новый ТабличныйДокумент;
	
	Табдок.ИмяПараметровПечати = "ИС_WB_ПечатьЛистаПодбораКомпактный";
	ТабДок.ОриентацияСтраницы = ОриентацияСтраницы.Портрет;
	ТабДок.АвтоМасштаб = Истина;
	Табдок.ОтображатьСетку = Истина;
	
	МакетОбработки = УправлениеПечатью.МакетПечатнойФормы("Документ.ИС_WB_СборочноеЗадание.ПФ_MXL_ЛистПодбораКомпактный");
	
	МассивЗначений = Новый Массив;
	МассивЗначений.Добавить("ПечататьНомерРеализации");   	              
	МассивЗначений.Добавить("ПечататьНазвание");	    
	МассивЗначений.Добавить("ПечататьРазмер");
	МассивЗначений.Добавить("ПечататьАртикулВБ");
	МассивЗначений.Добавить("ПечататьАртикул1С");
	МассивЗначений.Добавить("ПечататьQR");	  		
	МассивЗначений.Добавить("ПечататьШтрихкод");
	МассивЗначений.Добавить("ПечататьКоличество");   	
	
	НастройкиПечати = ИС_МП_Печать.ПолучитьНастройкиПечатиЛистаПодбора(Профиль, МассивЗначений, Перечисления.ИС_МП_Маркетплейсы.ВБ);	
	ОбластьРазделитель = МакетОбработки.ПолучитьОбласть("Разделитель|ОсновныеДанные");
	
	МассивСтатусов = Новый Массив;
	МассивСтатусов.Добавить(Перечисления.ИС_WB_СтатусыСборочныхЗаданийВСистемеWildBerries.waiting);
	МассивСтатусов.Добавить(Перечисления.ИС_WB_СтатусыСборочныхЗаданийВСистемеWildBerries.sorted);
	МассивСтатусов.Добавить(Перечисления.ИС_WB_СтатусыСборочныхЗаданийВСистемеWildBerries.sold);
	МассивСтатусов.Добавить(Перечисления.ИС_WB_СтатусыСборочныхЗаданийВСистемеWildBerries.ready_for_pickup);
	МассивСтатусов.Добавить(Перечисления.ИС_WB_СтатусыСборочныхЗаданийВСистемеWildBerries.postponed_delivery);

	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ИС_WB_СборочноеЗадание.Ссылка КАК Ссылка,
	|	ПередачаТоваровХранителюТовары.Ссылка.Номер КАК НомерРеализации
	|ПОМЕСТИТЬ ВТ_РТУ
	|ИЗ
	|	Документ.ИС_WB_СборочноеЗадание КАК ИС_WB_СборочноеЗадание
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ПередачаТоваровХранителю.Товары КАК ПередачаТоваровХранителюТовары
	|		ПО (ИС_WB_СборочноеЗадание.Заказ = ПередачаТоваровХранителюТовары.ЗаказКлиента)
	|			И (НЕ ИС_WB_СборочноеЗадание.Заказ = ЗНАЧЕНИЕ(Документ.ЗаказКлиента.ПустаяСсылка))
	|ГДЕ
	|	НЕ ИС_WB_СборочноеЗадание.Заказ = ЗНАЧЕНИЕ(Документ.ЗаказКлиента.ПустаяСсылка)
	|	И НЕ ПередачаТоваровХранителюТовары.Ссылка ЕСТЬ NULL
	|	И ИС_WB_СборочноеЗадание.Ссылка В(&МассивСсылок)
	|
	|ОБЪЕДИНИТЬ
	|
	|ВЫБРАТЬ
	|	ИС_WB_СборочноеЗадание.Ссылка,
	|	РеализацияТоваровУслугТовары.Ссылка.Номер
	|ИЗ
	|	Документ.ИС_WB_СборочноеЗадание КАК ИС_WB_СборочноеЗадание
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.РеализацияТоваровУслуг.Товары КАК РеализацияТоваровУслугТовары
	|		ПО ИС_WB_СборочноеЗадание.Заказ = РеализацияТоваровУслугТовары.ЗаказКлиента
	|			И (НЕ ИС_WB_СборочноеЗадание.Заказ = ЗНАЧЕНИЕ(Документ.ЗаказКлиента.ПустаяСсылка))
	|ГДЕ
	|	НЕ ИС_WB_СборочноеЗадание.Заказ = ЗНАЧЕНИЕ(Документ.ЗаказКлиента.ПустаяСсылка)
	|	И НЕ РеализацияТоваровУслугТовары.Ссылка ЕСТЬ NULL
	|	И ИС_WB_СборочноеЗадание.Ссылка В(&МассивСсылок)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ИС_WB_СборочноеЗадание.Номер КАК Номер,
