Функция ЗагрузитьСборочныеЗаданияНаСервере(Профиль, ДатаПоследнегоСборочногоЗадания, УникальныйИдентификатор)
	
	Если ДатаПоследнегоСборочногоЗадания = Дата(1, 1, 1) Тогда
		ДатаПоследнегоСборочногоЗадания = НачалоДня(ТекущаяДатаСеанса());
	КонецЕсли;
	
	//+ ИнфоСофт Стояк Ю.К. 04.04.2024 УА #67207
	ПараметрыВыполнения = ДлительныеОперации.ПараметрыВыполненияВФоне(УникальныйИдентификатор);
	ПараметрыВыполнения.ЗапуститьВФоне = Истина;
	ПараметрыВыполнения.ОжидатьЗавершение = 0;
	
	Возврат ДлительныеОперации.ВыполнитьПроцедуру(ПараметрыВыполнения, 
		"ИС_ВБ_Сервер.ВыполнитьЗагрузкуЗаказов", Профиль, ДатаПоследнегоСборочногоЗадания + 1);
		
	//ИС_WB_Сервер.ПолучитьСписокСборочныхЗаданий(Профиль, ДатаПоследнегоСборочногоЗадания + 1);
	//- ИнфоСофт Стояк Ю.К. 04.04.2024 УА #67207
	
КонецФункции //- ИнфоСофт Ивонин К.А. 13.07.22 УА #46999

//+ ИнфоСофт Ивонин К.А. 11.02.23 УА #53535
&НаСервереБезКонтекста
//+ ИнфоСофт Стояк Ю.К. 04.03.2025 УА #93469
//Процедура ПолучитьДатуПоследнегоСборочногоЗадания(Профиль, Дата)
Процедура ПолучитьДатуПоследнегоСборочногоЗадания(Профиль, Дата, ДатаФБО)
//- ИнфоСофт Стояк Ю.К. 04.03.2025 УА #93469
	
	Запрос = Новый Запрос;
	Запрос.Текст =	
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	ИС_WB_СборочноеЗадание.Дата КАК Дата
	|ИЗ
	|	Документ.ИС_WB_СборочноеЗадание КАК ИС_WB_СборочноеЗадание
	|ГДЕ
	|	ИС_WB_СборочноеЗадание.Профиль = &Профиль
	|
	|УПОРЯДОЧИТЬ ПО
	|	Дата УБЫВ";
	
	Запрос.УстановитьПараметр("Профиль", Профиль);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Выборка = РезультатЗапроса.Выбрать();
	
	Если Выборка.Следующий() Тогда
		Дата = Выборка.Дата;
	Иначе
		Дата = НачалоДня(ТекущаяДатаСеанса());
	КонецЕсли;  
	
КонецПроцедуры //- ИнфоСофт Ивонин К.А. 11.02.23 УА #53535

//+ ИнфоСофт Заварин К.В. 06.05.24 УА #68658
&НаСервереБезКонтекста
//+ ИнфоСофт Ивонин К.А. 12.02.23 УА #53535
//Функция ОбновитьСтатусыНаСервере(Профиль, УникальныйИдентификатор)   
Функция ОбновитьСтатусыНаСервере(Профиль, УникальныйИдентификатор, ВыделенныеСтроки = Неопределено)  
//- ИнфоСофт Заварин К.В. 06.05.24 УА #68658
	
	//+ ИнфоСофт Стояк Ю.К. 08.04.2024 УА #68800         
	ФукнциональныеОпции = ИС_WB_СерверПовтИсп.ПолучитьНастройкиФункциональностиСборочныхЗвданий(Профиль);
	
	//+ ИнфоСофт Мурсалимов Д.Р. 23.04.25 УА #99629
	АктивныйЗаказКлиента = ИС_WB_Сервер.ПолучитьАктивныйЗаказКлиента(Профиль);
	
	Если АктивныйЗаказКлиента <> Неопределено Тогда	
		ФукнциональныеОпции.Вставить("АктивныйЗаказКлиента", АктивныйЗаказКлиента);	
	КонецЕсли;
	//- ИнфоСофт Мурсалимов Д.Р. 23.04.25 УА #99629
	
	Если ФукнциональныеОпции.КоличествоДнейОбновлениеСтатусов = 0 Тогда
		Период = 30 * 86400;
	Иначе
		Период = ФукнциональныеОпции.КоличествоДнейОбновлениеСтатусов * 86400;
	КонецЕсли;  
	
	ПараметрыВыполнения = ДлительныеОперации.ПараметрыВыполненияВФоне(УникальныйИдентификатор);
	ПараметрыВыполнения.ЗапуститьВФоне = Истина;
	ПараметрыВыполнения.ОжидатьЗавершение = 0;
	
	//+ ИнфоСофт Заварин К.В. 06.05.24 УА #68658
	//Возврат ДлительныеОперации.ВыполнитьПроцедуру(ПараметрыВыполнения, 
	//"ИС_WB_Сервер.ОбновитьСтатусыСборочныхЗаданий", Профиль, , Период);
	Возврат ДлительныеОперации.ВыполнитьПроцедуру(ПараметрыВыполнения, 
		"ИС_ВБ_Сервер.ОбновитьСтатусыЗаказов", Профиль, ВыделенныеСтроки, Период);
	//- ИнфоСофт Заварин К.В. 06.05.24 УА #68658
		
	//ИС_WB_Сервер.ОбновитьСтатусыСборочныхЗаданий(Профиль);
	//- ИнфоСофт Стояк Ю.К. 08.04.2024 УА #68800
	
КонецФункции //- ИнфоСофт Ивонин К.А. 12.02.23 УА #53535

