	|	МАКСИМУМ(ЕСТЬNULL(ИС_WB_ШтрихкодыРазмеров.Штрихкод, """")) КАК ШтрихкодСМаркетплейса,
	//- ИнфоСофт Заварин К.В. 26.12.24 УА #89436
	|	ИС_WB_СборочноеЗадание.НоменклатураWB.Наименование КАК НаименованиеНоменклатурыСМаркетплейса,
	|	ИС_WB_СборочноеЗадание.Заказ КАК Заказ,
	|	ИС_WB_СоответствиеРазмеров.Номенклатура КАК Номенклатура1С,
	|	ИС_WB_СоответствиеРазмеров.Характеристика КАК Характеристика1С
	|ПОМЕСТИТЬ ВТ_ДанныеМаркетплейса
	|ИЗ
	|	Документ.ИС_WB_СборочноеЗадание КАК ИС_WB_СборочноеЗадание
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ИС_WB_СтатусыИЭтикеткиСборочныхЗаданий КАК ИС_WB_СтатусыИЭтикеткиСборочныхЗаданий
	|		ПО (ИС_WB_СборочноеЗадание.Ссылка = ИС_WB_СтатусыИЭтикеткиСборочныхЗаданий.СборочноеЗадание)
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ИС_WB_Номенклатура.Характеристики КАК ИС_WB_НоменклатураХарактеристикиЦвет
	|		ПО (ИС_WB_СборочноеЗадание.НоменклатураWB = ИС_WB_НоменклатураХарактеристикиЦвет.Ссылка)
	|			И (ИС_WB_НоменклатураХарактеристикиЦвет.Поле В
	|				(ВЫБРАТЬ
	|					ВТ.Ссылка
	|				ИЗ
	|					ВТ_Цвет КАК ВТ))
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ИС_WB_СборочноеЗадание.skus КАК ИС_WB_СборочноеЗаданиеskus
	|		ПО (ИС_WB_СборочноеЗадание.Ссылка = ИС_WB_СборочноеЗаданиеskus.Ссылка)
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ИС_WB_СоответствиеРазмеров КАК ИС_WB_СоответствиеРазмеров
	|		ПО (ИС_WB_СборочноеЗадание.РазмерWB = ИС_WB_СоответствиеРазмеров.РазмерWB)
	//+ ИнфоСофт Заварин К.В. 26.12.24 УА #89436
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ИС_WB_ШтрихкодыРазмеров КАК ИС_WB_ШтрихкодыРазмеров
	|		ПО (ИС_WB_ШтрихкодыРазмеров.Размер = ИС_WB_СборочноеЗадание.РазмерWB)
	//- ИнфоСофт Заварин К.В. 26.12.24 УА #89436	
	|ГДЕ
	|	ИС_WB_СборочноеЗадание.Ссылка В(&МассивСсылок)
	|	И ИС_WB_СтатусыИЭтикеткиСборочныхЗаданий.СтатусWB В (&Статусы)  
	|
	|СГРУППИРОВАТЬ ПО
	|	ИС_WB_СборочноеЗадание.Номер,
	|	ИС_WB_СборочноеЗадание.Дата,
	|	ИС_WB_СборочноеЗадание.НоменклатураWB.Код,
	|	ИС_WB_СборочноеЗадание.НоменклатураWB.vendorCode,
	|	ИС_WB_СборочноеЗадание.РазмерWB.techSize,
	|	ИС_WB_СборочноеЗадание.НоменклатураWB.Наименование,
	|	ИС_WB_СборочноеЗадание.Заказ,
	|	ИС_WB_СоответствиеРазмеров.Номенклатура,
	|	ИС_WB_СоответствиеРазмеров.Характеристика
	|;
	|" + ИС_МП_Печать.ТекстЗапросаПараметровПечатиШтрихкодов() + "
	|УПОРЯДОЧИТЬ ПО
	|	%1";
	
	//Метод деревянный. Используется пока что для быстрой обратной совместимости, чтобы в случае изменения/отката не переделывать вызовы печати
	//с сортировкой везде
	//+ ИнфоСофт Стояк Ю.К. 23.12.2024 УА #89956	
	КопияСортировкаПечати = СортировкаПечати;
	
	Если КопияСортировкаПечати = "vendorCode" Тогда
		КопияСортировкаПечати = "АртикулПоставщикаНоменклатурыСМаркетплейса"; 
	ИначеЕсли КопияСортировкаПечати = "Код" Тогда
		КопияСортировкаПечати = "КодНоменклатурыСМаркетплейса"; 
	ИначеЕсли КопияСортировкаПечати = "Наименование" Тогда                      
		КопияСортировкаПечати = "НаименованиеНоменклатурыСМаркетплейса"; 
	ИначеЕсли КопияСортировкаПечати = "Номер" Тогда                      
		КопияСортировкаПечати = "НомерЗаказаСМаркетплейса"; 
	КонецЕсли;
	//- ИнфоСофт Стояк Ю.К. 29.10.2024 УА #67816
	
	Запрос.Текст = СтрШаблон(Запрос.Текст, КопияСортировкаПечати);
	//- ИнфоСофт Стояк Ю.К. 23.12.2024 УА #89956
	
	Запрос.УстановитьПараметр("МассивСсылок", ВыделенныеСтроки); 
	
	//+ ИнфоСофт Заварин К.В. 30.03.24 УА #67778
	Запрос.УстановитьПараметр("Статусы", МассивСтатусов);
	//- ИнфоСофт Заварин К.В. 30.03.24 УА #67778
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Если РезультатЗапроса.Пустой() Тогда
		ОбщегоНазначения.СообщитьПользователю("Не удалось сформировать штрихкоды WildBerries");
		Возврат Табдок;	
	КонецЕсли;
		
	ОбластьЭтикетка = МакетОбработки.ПолучитьОбласть("Этикетка");
	
	Эталон = УправлениеПечатью.МакетПечатнойФормы("ОбщийМакет.ИС_МП_Эталон");
	КоличествоМиллиметровВПикселе = Эталон.Рисунки.Квадрат100Пикселей.Высота / 100;
					
	Выборка = РезультатЗапроса.Выбрать();
	
	Первый = Истина;	
	Пока Выборка.Следующий() Цикл
	    
	    //+ ИнфоСофт Стояк Ю.К. 29.10.2024 УА #67816		
		//ОбластьЭтикетка.Параметры.Наименование  = Выборка.Наименование;
		//ОбластьЭтикетка.Параметры.Артикул = Выборка.vendorCode;
		//ОбластьЭтикетка.Параметры.Цвет	  = Выборка.Цвет;
		//ОбластьЭтикетка.Параметры.Размер  = Выборка.techSize;
		ЗаполнитьЗначенияСвойств(ОбластьЭтикетка.Параметры, Выборка);
		//- ИнфоСофт Стояк Ю.К. 29.10.2024 УА #67816
		    
		ПараметрыШК = ИС_MP_ГенерацияШтрихкода.ПараметрыГенерацииШтрихкода();
				
		ПараметрыШК.Ширина = Окр(ОбластьЭтикетка.Рисунки.Штрихкод.Ширина / КоличествоМиллиметровВПикселе);
		ПараметрыШК.Высота = Окр(ОбластьЭтикетка.Рисунки.Штрихкод.Высота / КоличествоМиллиметровВПикселе);
		//+ ИнфоСофт Мурсалимов Д.Р. 05.10.23 УА #62139
		//ПараметрыШК.ТипКода = 1;
		//- ИнфоСофт Мурсалимов Д.Р. 05.10.23 УА #62139
		ПараметрыШК.РазмерШрифта = 10;
		//+ ИнфоСофт Стояк Ю.К. 29.10.2024 УА #67816		
		//ПараметрыШК.Штрихкод = Выборка.Штрихкод;
		ПараметрыШК.Штрихкод = Выборка.ШтрихкодСМаркетплейса;
		//- ИнфоСофт Стояк Ю.К. 29.10.2024 УА #67816
		ПараметрыШК.Масштабировать = Истина;
		ПараметрыШК.СохранятьПропорции = Истина;
		ПараметрыШК.ВертикальноеВыравнивание = 2; 
		
		СтруктураКартинки = ИС_MP_ГенерацияШтрихкода.ИзображениеШтрихкода(ПараметрыШК);
		
		Если СтруктураКартинки.Результат Тогда	
			ОбластьЭтикетка.Рисунки.Штрихкод.Картинка = СтруктураКартинки.Картинка;
		КонецЕсли;  
		
		Если Не Первый Тогда
			Табдок.ВывестиГоризонтальныйРазделительСтраниц();
		КонецЕсли;
		
		Первый = Ложь;
			
		Табдок.Вывести(ОбластьЭтикетка);
			
	КонецЦикла;    
			
	Возврат Табдок;
	
КонецФункции //- ИнфоСофт Ивонин К.А. 13.02.23 УА #53535

//+ ИнфоСофт Ивонин К.А. 14.02.23 УА #53535
&НаСервере 
Функция ПолучитьQRПоставкиНаСервере()
    
    ИС_ВБ_Сервер.ОбновитьИнформациюОПоставках(Профиль);
    
	Табдок = Новый ТабличныйДокумент;
	
	Табдок.ИмяПараметровПечати = "ИС_WB_ПечатьQRПоставки";
	ТабДок.ОриентацияСтраницы = ОриентацияСтраницы.Портрет;
	ТабДок.АвтоМасштаб = Истина;
	
	МакетОбработки = УправлениеПечатью.МакетПечатнойФормы("Документ.ИС_WB_СборочноеЗадание.ПФ_MXL_QR58х40");
	
	ВыделенныеСтроки = Элементы.СписокПоставок.ВыделенныеСтроки;
			
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ИС_ВБ_ПоставкиFBS.QR КАК QR
	|ИЗ
	|	Справочник.ИС_ВБ_ПоставкиFBS КАК ИС_ВБ_ПоставкиFBS
	|ГДЕ
	|	ИС_ВБ_ПоставкиFBS.Ссылка В(&МассивСсылок)
	|	И ИС_ВБ_ПоставкиFBS.done";
	
	Запрос.УстановитьПараметр("МассивСсылок", ВыделенныеСтроки); 
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Если РезультатЗапроса.Пустой() Тогда
		ОбщегоНазначения.СообщитьПользователю("Не удалось сформировать QR поставки WildBerries.
											  |Поставка должна быть закрыта перед получением QR кода.");
		Возврат Неопределено;	
	КонецЕсли;
		
	ОбластьЭтикетка = МакетОбработки.ПолучитьОбласть("Этикетка");
						
	Выборка = РезультатЗапроса.Выбрать();
	
	Первый = Истина;	
	Пока Выборка.Следующий() Цикл  
				
		ОбластьЭтикетка.Рисунки.КартинкаQR.Картинка = Новый Картинка(Выборка.QR.Получить()); 
		
		Если Не Первый Тогда
			Табдок.ВывестиГоризонтальныйРазделительСтраниц();
		КонецЕсли;
		
		Первый = Ложь;
			
		Табдок.Вывести(ОбластьЭтикетка);
			
	КонецЦикла;    
			
	Возврат Табдок;

КонецФункции //- ИнфоСофт Ивонин К.А. 14.02.23 УА #53535

//+ ИнфоСофт Заварин К.В. 28.06.24 УА #69703
&НаСервере 
Функция ПолучитьQRКоробаНаСервере()
    
    ИС_ВБ_Сервер.ОбновитьИнформациюОПоставках(Профиль);
	
	Табдок = Новый ТабличныйДокумент;
	
	Табдок.ИмяПараметровПечати = "ИС_WB_ПечатьQRКороба";
	ТабДок.ОриентацияСтраницы = ОриентацияСтраницы.Портрет;
	ТабДок.АвтоМасштаб = Истина;
	
	МакетОбработки = УправлениеПечатью.МакетПечатнойФормы("Документ.ИС_WB_СборочноеЗадание.ПФ_MXL_QR58х40");
	
	ВыделенныеСтроки = Элементы.СписокПоставок.ВыделенныеСтроки;
	
	МассивQRКоробов = Новый Массив;
	
	Для Каждого	ВыделеннаяСтрока из ВыделенныеСтроки  Цикл
		
		МассивКоробов = ИС_ВБ_Сервер.СписокКоробовПоставки(Профиль, ВыделеннаяСтрока.Код);
		
		Если МассивКоробов = Неопределено Тогда
			Продолжить;	
		КонецЕсли;
		
		Если МассивКоробов.Количество() = 0 Тогда
			ОбщегоНазначения.СообщитьПользователю("Не найдены короба по поставке: " + ВыделеннаяСтрока.Код);
			Продолжить;	
		КонецЕсли;
				
		КартинкиQRКороба = ИС_ВБ_Сервер.ПолучитьСтикерыКоробов(Профиль, ВыделеннаяСтрока.Код, МассивКоробов);
		
		Если КартинкиQRКороба = Неопределено Тогда
			Продолжить;	
		КонецЕсли;
		
		Если КартинкиQRКороба.Количество() = 0 Тогда
			ОбщегоНазначения.СообщитьПользователю("Не найдены QR коробов по поставке: " + ВыделеннаяСтрока.Код);
			Продолжить;	
		КонецЕсли; 
		
		Для каждого КартинкаQRКороба из КартинкиQRКороба  Цикл
			МассивQRКоробов.Добавить(КартинкаQRКороба);  		
		КонецЦикла;	
	КонецЦикла;
	
	ОбластьЭтикетка = МакетОбработки.ПолучитьОбласть("Этикетка");
	
	Для каждого КартинкаQRКороба из МассивQRКоробов  Цикл
		ОбластьЭтикетка.Рисунки.КартинкаQR.Картинка = Новый Картинка(КартинкаQRКороба);
		Табдок.ВывестиГоризонтальныйРазделительСтраниц();
		Табдок.Вывести(ОбластьЭтикетка); 		
	КонецЦикла;			
	
	Если Табдок.ВысотаТаблицы = 0 Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Возврат Табдок;

КонецФункции //- ИнфоСофт Заварин К.В. 28.06.24 УА #69703

//+ ИнфоСофт Ивонин К.А. 13.02.23 УА #53535
&НаСервере
Процедура ПолучитьСписокСборочныхЗаданийВПоставке(КодПоставки)
    
    СписокСборочныхЗаданийВПоставке.Очистить();
        
	МассивНомеровСборочныхЗаданий = ИС_ВБ_Сервер.СписокСборочныхЗаданийВПоставке(Профиль, КодПоставки);
	
	Если МассивНомеровСборочныхЗаданий = Неопределено Тогда
		Возврат;
	КонецЕсли;
			
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ИС_WB_СборочноеЗадание.Ссылка КАК Ссылка,
	|	ИС_WB_СборочноеЗадание.Номер КАК Номер
	|ИЗ
	|	Документ.ИС_WB_СборочноеЗадание КАК ИС_WB_СборочноеЗадание
	|ГДЕ
	|	ИС_WB_СборочноеЗадание.Номер В(&СписокНомеров)";
	
	Запрос.УстановитьПараметр("СписокНомеров", МассивНомеровСборочныхЗаданий);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Выборка = РезультатЗапроса.Выбрать();
	
	Пока Выборка.Следующий() Цикл
	
		Элемент = МассивНомеровСборочныхЗаданий.Найти(Выборка.Номер);
		Если Элемент <> Неопределено Тогда
			МассивНомеровСборочныхЗаданий.Удалить(Элемент);
		КонецЕсли;
		
		НоваяСтрока = СписокСборочныхЗаданийВПоставке.Добавить();
		НоваяСтрока.Номер = Выборка.Номер;
		НоваяСтрока.СборочноеЗадание = Выборка.Ссылка;
		
	КонецЦикла;
	
	Для Каждого Элемент Из МассивНомеровСборочныхЗаданий Цикл
	
		НоваяСтрока = СписокСборочныхЗаданийВПоставке.Добавить();
		НоваяСтрока.Номер = Элемент;
		 
	КонецЦикла;

КонецПроцедуры //- ИнфоСофт Ивонин К.А. 13.02.23 УА #53535

//+ ИнфоСофт Ивонин К.А. 15.02.23 УА #53535
&НаСервереБезКонтекста
Функция ПроверитьВозможностьПрикрепления(ВыделенныеСтроки)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ ИС_WB_СборочноеЗадание.ТипТовара) КАК ТипТовара,              
	|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ ИС_WB_СтатусыИЭтикеткиСборочныхЗаданий.Поставка) КАК Поставка
	|ИЗ
	|	Документ.ИС_WB_СборочноеЗадание КАК ИС_WB_СборочноеЗадание
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ИС_WB_СтатусыИЭтикеткиСборочныхЗаданий КАК ИС_WB_СтатусыИЭтикеткиСборочныхЗаданий
	|		ПО (ИС_WB_СтатусыИЭтикеткиСборочныхЗаданий.СборочноеЗадание = ИС_WB_СборочноеЗадание.Ссылка)
	|ГДЕ
	|	ИС_WB_СборочноеЗадание.Ссылка В(&МассивСсылок)";
	
	Запрос.УстановитьПараметр("МассивСсылок", ВыделенныеСтроки);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Выборка = РезультатЗапроса.Выбрать();
	
	Если Выборка.Следующий() Тогда   
		
		Если Выборка.ТипТовара > 1 Тогда
			ОбщегоНазначения.СообщитьПользователю(
	 		"Нельзя прикрепить к одной поставке сборочные задания с разными типами товаров.
	 		|Пожалуйста, проверьте чтобы все выделенные сборочные задания имели одинаковые типы товаров.
	 		|При необходимости повторите прикрепление сборочных заданий с другими типами товаров в другую поставку.");
			Возврат Неопределено;
		КонецЕсли;
		
		ТипТовара = ВыделенныеСтроки[0].ТипТовара;
		
		Если Выборка.Поставка > 1 Тогда
			ОбщегоНазначения.СообщитьПользователю(
	 		"В выделенном списке найдены заданий закрепленные за поставкой, они будут переприкреплены к далее выбранной");
		КонецЕсли;
		
		Возврат ТипТовара;
	
	КонецЕсли;
		
КонецФункции //- ИнфоСофт Ивонин К.А. 15.02.23 УА #53535

//+ ИнфоСофт Ивонин К.А. 19.02.23 УА #53535
&НаКлиенте
Процедура ПрикреплениеКПоставкеЗавершение(Результат, Параметры) Экспорт
    
    Если Результат = КодВозвратаДиалога.Нет Тогда
        Возврат;
    КонецЕсли;

    ПрикрепитьЗаказыКПоставкеНаСервере(Параметры.Поставка);
	//+ ИнфоСофт Конышев А.Е. 27.11.24 УА #73042
	ОбновитьВыделенныеСтатусы(Неопределено);
	//- ИнфоСофт Конышев А.Е. 27.11.24 УА #73042
    Элементы.Список.Обновить();
	
	ОбщегоНазначенияКлиент.СообщитьПользователю("Прикрепление завершено");

КонецПроцедуры //- ИнфоСофт Ивонин К.А. 19.02.23 УА #53535

//+ ИнфоСофт Ивонин К.А. 19.02.23 УА #53535
&НаСервере
Процедура ПрикрепитьЗаказыКПоставкеНаСервере(Поставка)	
	ВыделенныеСтроки = Элементы.Список.ВыделенныеСтроки;
	ИС_ВБ_Сервер.ДобавитьСборочныеЗаданияВПоставку(Профиль, Поставка, ВыделенныеСтроки);	
КонецПроцедуры //- ИнфоСофт Ивонин К.А. 19.02.23 УА #53535

//+ ИнфоСофт Ивонин К.А. 19.02.23 УА #53535
&НаСервере
Процедура СоздатьЗаказыНаСервере()

	ВыделенныеСтроки = Элементы.Список.ВыделенныеСтроки;
	
	ИС_WB_Сервер.СоздатьЗаказы(Профиль, ВыделенныеСтроки);
	
КонецПроцедуры //- ИнфоСофт Ивонин К.А. 19.02.23 УА #53535  

//+ ИнфоСофт Власова И.С. 07.02.25 УА #92584
&НаСервереБезКонтекста
Функция СоздатьРеализацииНаСервере(Профиль, УникальныйИдентификатор, ВыделенныеСтроки = Неопределено)
	
	ПараметрыВыполнения = ДлительныеОперации.ПараметрыВыполненияВФоне(УникальныйИдентификатор);
	ПараметрыВыполнения.ЗапуститьВФоне = Истина;
	ПараметрыВыполнения.ОжидатьЗавершение = 0;
	
	Возврат ДлительныеОперации.ВыполнитьПроцедуру(ПараметрыВыполнения, 
		"ИС_WB_Сервер.СоздатьРеализации", Профиль, ВыделенныеСтроки);
	
КонецФункции //- ИнфоСофт Власова И.С. 07.02.25 УА #92584

//+ ИнфоСофт Власова И.С. 07.02.25 УА #92584
&НаКлиенте
Процедура СоздатьРеализацииЗавершение(Результат, ДополнительныеПараметры) Экспорт
    
    Элементы["КартинкаОжиданиеРеализации"].Видимость = Ложь;	
	
    Если Результат = Неопределено Тогда  // отменено пользователем
		Возврат;
	КонецЕсли;
	
	Если Результат.Статус = "Ошибка" Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю(Результат.ПодробноеПредставлениеОшибки);	
	КонецЕсли;
	
	Если Результат.Сообщения.Количество() > 0 Тогда
		
		Для Каждого Элемент Из Результат.Сообщения Цикл
			ОбщегоНазначенияКлиент.СообщитьПользователю(Элемент.Текст);
		КонецЦикла;
		
	КонецЕсли;
	
	Элементы.Список.Обновить();
	
	УдалитьИзВременногоХранилища(Результат.АдресРезультата);				
	
КонецПроцедуры //- ИнфоСофт Власова И.С. 07.02.25 УА #92584

//+ ИнфоСофт Власова И.С. 07.02.25 УА #92584
&НаСервере
Функция ПолучитьФункциональныеОпции(Профиль)
	
	ФукнциональныеОпции = ИС_WB_СерверПовтИсп.ПолучитьНастройкиФункциональностиСборочныхЗвданий(Профиль);
	
	//+ ИнфоСофт Мурсалимов Д.Р. 23.04.25 УА #99629
	АктивныйЗаказКлиента = ИС_WB_Сервер.ПолучитьАктивныйЗаказКлиента(Профиль);
	
	Если АктивныйЗаказКлиента <> Неопределено Тогда	
		ФукнциональныеОпции.Вставить("АктивныйЗаказКлиента", АктивныйЗаказКлиента);	
	КонецЕсли;
	
	Возврат ФукнциональныеОпции;
	//- ИнфоСофт Мурсалимов Д.Р. 23.04.25 УА #99629
	
КонецФункции //- ИнфоСофт Власова И.С. 07.02.25 УА #92584

//+ ИнфоСофт Ивонин К.А. 07.05.23 УА #58360
&НаКлиенте
Процедура ДействияНадСборочнымиЗаданиямиЗавершение(Результат, Параметры) Экспорт

	Если Результат = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ДействияНадСборочнымиЗаданиямиНаСервере(Результат);
	Элементы.Список.Обновить();
	
КонецПроцедуры //- ИнфоСофт Ивонин К.А. 07.05.23 УА #58360

//+ ИнфоСофт Ивонин К.А. 07.05.23 УА #58360
&НаСервере
Процедура ДействияНадСборочнымиЗаданиямиНаСервере(СтруктураДействий)

	ВыделенныеСтроки = Элементы.Список.ВыделенныеСтроки;
		
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ИС_WB_СборочноеЗадание.Ссылка КАК Ссылка,
	|	ИС_WB_СборочноеЗадание.Заказ КАК Заказ
	|ПОМЕСТИТЬ ВТ_Заказы
	|ИЗ
	|	Документ.ИС_WB_СборочноеЗадание КАК ИС_WB_СборочноеЗадание
	|ГДЕ
	|	ИС_WB_СборочноеЗадание.Ссылка В(&МассивСсылок)
	|	И НЕ ИС_WB_СборочноеЗадание.Заказ = ЗНАЧЕНИЕ(Документ.ЗаказКлиента.ПустаяСсылка)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_Заказы.Ссылка КАК Ссылка,
	|	ВТ_Заказы.Заказ КАК Заказ,
	|	РеализацияТоваровУслуг.Ссылка КАК РТУ
	|ИЗ
	|	ВТ_Заказы КАК ВТ_Заказы
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.РеализацияТоваровУслуг КАК РеализацияТоваровУслуг
	|		ПО ВТ_Заказы.Заказ = РеализацияТоваровУслуг.ЗаказКлиента
	|
	|СГРУППИРОВАТЬ ПО
	|	ВТ_Заказы.Заказ,
	|	РеализацияТоваровУслуг.Ссылка,
	|	ВТ_Заказы.Ссылка
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ВТ_Заказы.Ссылка,
	|	ВТ_Заказы.Заказ,
	|	РеализацияТоваровУслугТовары.Ссылка
	|ИЗ
	|	ВТ_Заказы КАК ВТ_Заказы
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.РеализацияТоваровУслуг.Товары КАК РеализацияТоваровУслугТовары
	|		ПО ВТ_Заказы.Заказ = РеализацияТоваровУслугТовары.ЗаказКлиента
	|		
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ВТ_Заказы.Ссылка,
	|	ВТ_Заказы.Заказ,
	|	ПередачаТоваровХранителю.Ссылка
	|ИЗ
	|	ВТ_Заказы КАК ВТ_Заказы
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ПередачаТоваровХранителю КАК ПередачаТоваровХранителю
	|		ПО ВТ_Заказы.Заказ = ПередачаТоваровХранителю.ЗаказКлиента
	|		
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ВТ_Заказы.Ссылка,
	|	ВТ_Заказы.Заказ,
	|	ПередачаТоваровХранителюТовары.Ссылка
	|ИЗ
	|	ВТ_Заказы КАК ВТ_Заказы
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ПередачаТоваровХранителю.Товары КАК ПередачаТоваровХранителюТовары
	|		ПО ВТ_Заказы.Заказ = ПередачаТоваровХранителюТовары.ЗаказКлиента";
	
	Запрос.УстановитьПараметр("МассивСсылок", ВыделенныеСтроки);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаСборочных = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаСборочных.Следующий() Цикл
    
    	Если СтруктураДействий.ПометитьСвязанныеОбъектыНаУдаление Тогда
    			
			ЗапросСвязанных = Новый Запрос;
			ЗапросСвязанных.Текст = 
			"ВЫБРАТЬ
			|	СвязанныеДокументы.Ссылка КАК Ссылка
			|ИЗ
			|	КритерийОтбора.СвязанныеДокументы(&Заказ) КАК СвязанныеДокументы";			
			
			ЗапросСвязанных.УстановитьПараметр("Заказ", ВыборкаСборочных.Заказ);
			РезультатЗапросаСвязанных = ЗапросСвязанных.Выполнить();
			
			ВыборкаСвязанных = РезультатЗапроса.Выбрать();
			
			Пока ВыборкаСвязанных.Следующий() Цикл
			
				Попытка
				
					ДокОбъект = ВыборкаСвязанных.Ссылка.ПолучитьОбъект();	
					ДокОбъект.УстановитьПометкуУдаления(Истина);				
					
				Исключение
					ОбщегоНазначения.СообщитьПользователю(ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
				КонецПопытки;
			
			КонецЦикла;
		
    	ИначеЕсли СтруктураДействий.ПометитьРеализацииНаУдаление И ВыборкаСборочных.РТУ <> NULL Тогда
    	    
    		Попытка
			
				ДокОбъект = ВыборкаСборочных.РТУ.ПолучитьОбъект();	
				ДокОбъект.УстановитьПометкуУдаления(Истина);				
				
			Исключение
				ОбщегоНазначения.СообщитьПользователю(ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
			КонецПопытки;
    	
    	КонецЕсли;

    	Если СтруктураДействий.ПометитьЗаказыНаУдаление Тогда
    		   
    		Попытка
			
				ДокОбъект = ВыборкаСборочных.Заказ.ПолучитьОбъект();	
				ДокОбъект.УстановитьПометкуУдаления(Истина);				
				
			Исключение
				ОбщегоНазначения.СообщитьПользователю(ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
			КонецПопытки;
			
    	КонецЕсли;

    	Если СтруктураДействий.ОтвязатьЗаказы Тогда
    		
    		Попытка
			
				ДокОбъект = ВыборкаСборочных.Ссылка.ПолучитьОбъект();	
				ДокОбъект.Заказ = Документы.ЗаказКлиента.ПустаяСсылка();
				ДокОбъект.Записать();				
				
			Исключение
				ОбщегоНазначения.СообщитьПользователю(ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
			КонецПопытки;
			
    	КонецЕсли;
   
	КонецЦикла;	 
	
КонецПроцедуры //- ИнфоСофт Ивонин К.А. 07.05.23 УА #58360

//+ ИнфоСофт Сумин Д.В. 07.09.2023 УА #61972 
&НаСервере
Функция ПолучитьЗаказыМаркированногоТовара(ВыделенныеСтроки)
	
	Запрос = Новый Запрос(
	//+ ИнфоСофт Сумин Д.В. 31.01.2024 УА #69810
	"ВЫБРАТЬ
	|	ИС_WB_СборочноеЗадание.Ссылка КАК Ссылка,
	|	ИС_WB_СборочноеЗадание.РазмерWB КАК РазмерWB,
	|	ИС_WB_СоответствиеРазмеров.Номенклатура КАК Номенклатура,
	|	ИС_WB_СоответствиеРазмеров.Номенклатура.ВидНоменклатуры.ТипНоменклатуры КАК НоменклатураВидНоменклатурыТипНоменклатуры,
	|	ИС_WB_СоответствиеРазмеров.Номенклатура.ВидНоменклатуры.ОсобенностьУчета КАК НоменклатураВидНоменклатурыОсобенностьУчета
	|ИЗ
	|	Документ.ИС_WB_СборочноеЗадание КАК ИС_WB_СборочноеЗадание
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ИС_WB_СоответствиеРазмеров КАК ИС_WB_СоответствиеРазмеров
	|		ПО (ИС_WB_СборочноеЗадание.РазмерWB = ИС_WB_СоответствиеРазмеров.РазмерWB)
	|ГДЕ
	|	ИС_WB_СборочноеЗадание.Ссылка В(&МассивСборочныхЗаданий)
	|	И ИС_WB_СоответствиеРазмеров.Номенклатура.ВидНоменклатуры.ОсобенностьУчета <> ЗНАЧЕНИЕ(Перечисление.ОсобенностиУчетаНоменклатуры.БезособенностейУчета)
	|	И ИС_WB_СоответствиеРазмеров.Номенклатура.ВидНоменклатуры.ОсобенностьУчета <> ЗНАЧЕНИЕ(Перечисление.ОсобенностиУчетаНоменклатуры.ПустаяСсылка)");
	//"ВЫБРАТЬ
	//|	ИС_WB_СборочноеЗадание.Ссылка КАК Ссылка,
	//|	ИС_WB_СборочноеЗадание.РазмерWB КАК РазмерWB,
	//|	ИС_WB_СоответствиеРазмеров.Номенклатура КАК Номенклатура
	//|ИЗ
	//|	Документ.ИС_WB_СборочноеЗадание КАК ИС_WB_СборочноеЗадание
	//|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ИС_WB_СоответствиеРазмеров КАК ИС_WB_СоответствиеРазмеров
	//|		ПО (ИС_WB_СборочноеЗадание.РазмерWB = ИС_WB_СоответствиеРазмеров.РазмерWB)
	//|ГДЕ
	//|	ИС_WB_СборочноеЗадание.Ссылка В (&МассивСборочныхЗаданий)
	//|	И (ИС_WB_СоответствиеРазмеров.Номенклатура.ВидНоменклатуры.ОсобенностьУчета = ЗНАЧЕНИЕ(Перечисление.ОсобенностиУчетаНоменклатуры.ЛегкаяПромышленность)
	//|			ИЛИ ИС_WB_СоответствиеРазмеров.Номенклатура.ВидНоменклатуры.ОсобенностьУчета = ЗНАЧЕНИЕ(Перечисление.ОсобенностиУчетаНоменклатуры.ОбувнаяПродукция)
	//|			ИЛИ ИС_WB_СоответствиеРазмеров.Номенклатура.ВидНоменклатуры.ОсобенностьУчета = ЗНАЧЕНИЕ(Перечисление.ОсобенностиУчетаНоменклатуры.Шины)
	//|			ИЛИ ИС_WB_СоответствиеРазмеров.Номенклатура.ВидНоменклатуры.ОсобенностьУчета = ЗНАЧЕНИЕ(Перечисление.ОсобенностиУчетаНоменклатуры.Фотоаппараты))");
    //- ИнфоСофт Сумин Д.В. 31.01.2024 УА #69810
	Запрос.УстановитьПараметр("МассивСборочныхЗаданий", ВыделенныеСтроки);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Выборка = РезультатЗапроса.Выбрать();
	
	РезультатМассив = Новый Массив;
	
	Пока Выборка.Следующий() Цикл
		РезультатМассив.Добавить(Выборка.Ссылка);	
	КонецЦикла;
	
	Возврат РезультатМассив;
	
КонецФункции //- ИнфоСофт Сумин Д.В. 07.09.2023 УА #61972

//+ ИнфоСофт Мурсалимов Д.Р. 03.10.23 УА #59537
&НаКлиенте
Процедура ПечатьШтрихкодов1С(Команда)
	
	МассивТовары = Новый Массив;
	
	Для Каждого ВыделеннаяСтрока Из Элементы.Список.ВыделенныеСтроки Цикл
		
		//+ ИнфоСофт Мурсалимов Д.Р. 01.07.24 УА #78714
		СтрокаДС = Элементы.Список.ДанныеСтроки(ВыделеннаяСтрока);
		
		Если Не ЗначениеЗаполнено(СтрокаДС.Номенклатура) Тогда
			ОбщегоНазначенияКлиент.СообщитьПользователю("В сборочном задании с номером " + СтрокаДС.Номер + " отсутствует номенклатура из 1С. Сопоставьте товары!");
			Возврат;
		КонецЕсли;
		
		СтруктураТовары = Новый Структура;
		
		СтруктураТовары.Вставить("Номенклатура", 		СтрокаДС.Номенклатура);
		
		Если СтрокаДС.Свойство("Характеристика") Тогда
			СтруктураТовары.Вставить("Характеристика", 	СтрокаДС.Характеристика);
		КонецЕсли;
		
		Если СтрокаДС.Свойство("Упаковка") Тогда
			СтруктураТовары.Вставить("Упаковка", 		СтрокаДС.Упаковка);
		КонецЕсли;
	
		МассивТовары.Добавить(СтруктураТовары);
		//- ИнфоСофт Мурсалимов Д.Р. 01.07.24 УА #78714
		
	КонецЦикла;
	
	Товары = ЗаполнитьТоварыПодготовитьПараметрыЗаполнения(МассивТовары);
	
	ПараметрыФормы = Новый Структура;
	
	ПараметрыЗаполнения = Новый Структура;
	ПараметрыЗаполнения.Вставить("Товары", Товары);  
	
	СтруктураДействий = Новый Структура; 
	СтруктураДействий.Вставить("ЗаполнитьТаблицуТоваров", Истина);
	СтруктураДействий.Вставить("ЗаполнитьКоличествоЭтикетокПоДокументу", Истина);
	СтруктураДействий.Вставить("УстановитьРежим", "ПечатьЭтикеток");	
	
	ПараметрыЗаполнения.Вставить("СтруктураДействий", СтруктураДействий);
	
	ПараметрыФормы.Вставить("ПараметрыЗаполнения", ПараметрыЗаполнения);

	ОткрытьФорму("Обработка.ПечатьЭтикетокИЦенников.Форма", ПараметрыФормы);
	
КонецПроцедуры //- ИнфоСофт Мурсалимов Д.Р. 03.10.23 УА #59537

//+ ИнфоСофт Мурсалимов Д.Р. 01.07.24 УА #78714   
&НаСервере
Функция ЗаполнитьТоварыПодготовитьПараметрыЗаполнения(Данные)	

	Порядок = 1;	
	Товары 	= Новый Массив;
	     	
	Для Каждого Элемент Из Данные Цикл	
		
		ТекТовар = Новый Структура;
		
		ТекТовар.Вставить("Номенклатура", 		Элемент.Номенклатура); 
		
		Если Элемент.Свойство("Характеристика") Тогда
			ТекТовар.Вставить("Характеристика", Элемент.Характеристика);
		КонецЕсли;
		
		Если Элемент.Свойство("Упаковка") Тогда
			ТекТовар.Вставить("Упаковка", 		Элемент.Упаковка);
		КонецЕсли;
		
		ТекТовар.Вставить("Порядок", 			Порядок);
		ТекТовар.Вставить("Количество", 		1.000);
		
		Товары.Добавить(ТекТовар);

		Порядок = Порядок + 1;
		
	КонецЦикла;
	
	Возврат Товары;
	
КонецФункции //- ИнфоСофт Мурсалимов Д.Р. 01.07.24 УА #78714

