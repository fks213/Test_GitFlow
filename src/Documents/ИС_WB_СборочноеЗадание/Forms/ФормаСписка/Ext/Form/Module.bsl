//+ ИнфоСофт Ивонин К.А. 13.02.23 УА #53535
&НаКлиенте
Процедура СписокПоставокПриАктивизацииСтроки(Элемент)
	
	ТекДанные = Элементы.СписокПоставок.ТекущиеДанные;
	Если ТекДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(Профиль) Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю("Не выбран Профиль", , , "Профиль");
	КонецЕсли;
	
	ПолучитьСписокСборочныхЗаданийВПоставке(ТекДанные.Код);

КонецПроцедуры //- ИнфоСофт Ивонин К.А. 13.02.23 УА #53535

	//+ ИнфоСофт Ивонин К.А. 13.02.23 УА #53535
&НаКлиенте
Процедура СписокВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	ТекДанные = Элемент.ТекущиеДанные; 
	
	Если ТекДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если Поле = Элементы.Заказ Тогда
		
		СтандартнаяОбработка = Ложь;
		
		Если Элемент.ТекущиеДанные.Заказ.Пустая() Тогда
			Возврат;
		КонецЕсли;
		
		ПоказатьЗначение(, Элемент.ТекущиеДанные.Заказ);
	
	ИначеЕсли Поле = Элементы.Реализация Тогда
		
		СтандартнаяОбработка = Ложь;
		
		Если Не ЗначениеЗаполнено(Элемент.ТекущиеДанные.Реализация) Тогда
			Возврат;
		ИначеЕсли ТипЗнч(Элемент.ТекущиеДанные.Реализация) = Тип("ДокументСсылка.РеализацияТоваровУслуг") Тогда
			ПоказатьЗначение(, Элемент.ТекущиеДанные.Реализация);
		Иначе
			ПараметрыФормы = Новый Структура;
			ПараметрыФормы.Вставить("Заказ", Элемент.ТекущиеДанные.Заказ);
			//+ ИнфоСофт Стояк Ю.К. 26.12.2024 УА #90201
			ПараметрыФормы.Вставить("ДокументыРеализации", Истина);
			//- ИнфоСофт Стояк Ю.К. 26.12.2024 УА #90201
			ОткрытьФорму("ОбщаяФорма.ИС_WB_ФормаРТУ", ПараметрыФормы);
		КонецЕсли 
		
	//+ ИнфоСофт Конышев А.Е. 10.12.24 УА #77940
	ИначеЕсли Поле = Элементы.РасходныйОрдер Тогда
		
		СтандартнаяОбработка = Ложь;
		
		Если Не ЗначениеЗаполнено(Элемент.ТекущиеДанные.РасходныйОрдер) Тогда
			Возврат;
		//+ ИнфоСофт Стояк Ю.К. 26.12.2024 УА #90201			
		//ИначеЕсли ТипЗнч(Элемент.ТекущиеДанные.РасходныйОрдер) = Тип("ДокументСсылка.РасходныйОрдер") Тогда
		ИначеЕсли ТипЗнч(Элемент.ТекущиеДанные.РасходныйОрдер) = Тип("ДокументСсылка.РасходныйОрдерНаТовары") Тогда
		//- ИнфоСофт Стояк Ю.К. 26.12.2024 УА #90201
			ПоказатьЗначение(, Элемент.ТекущиеДанные.РасходныйОрдер);
		//+ ИнфоСофт Стояк Ю.К. 26.12.2024 УА #90201
		Иначе
			ПараметрыФормы = Новый Структура;
			ПараметрыФормы.Вставить("Заказ", Элемент.ТекущиеДанные.Заказ);
			ПараметрыФормы.Вставить("ДокументыРеализации", Ложь);
			ОткрытьФорму("ОбщаяФорма.ИС_WB_ФормаРТУ", ПараметрыФормы);
		//- ИнфоСофт Стояк Ю.К. 26.12.2024 УА #90201
		КонецЕсли
		
	//- ИнфоСофт Конышев А.Е. 10.12.24 УА #77940	
		
	КонецЕсли;
	
КонецПроцедуры //- ИнфоСофт Ивонин К.А. 13.02.23 УА #53535

//+ ИнфоСофт Ивонин К.А. 14.02.23 УА #53535
&НаКлиенте
Процедура ГруппаСтраницыПриСменеСтраницы(Элемент, ТекущаяСтраница)

	Если ТекущаяСтраница = Элементы.ГруппаУправлениеСборочнымиЗаданиями Тогда
		Элементы.ПечатьQRПоставки.Видимость = Ложь;
		//+ ИнфоСофт Заварин К.В. 27.06.24 УА #69703
		Элементы.ПечатьQRКороба.Видимость = Ложь;	
		//- ИнфоСофт Заварин К.В. 27.06.24 УА #69703
		//+ ИнфоСофт Заварин К.В. 05.09.24 УА #79742
		Элементы.КоличествоСборочныхЗаданий.Видимость = Истина;
		Элементы.ОтборОтправлений.Видимость = Истина;
		//- ИнфоСофт Заварин К.В. 05.09.24 УА #79742
	ИначеЕсли ТекущаяСтраница = Элементы.ГруппаУправлениеПоставками Тогда 
		Элементы.ПечатьQRПоставки.Видимость = Истина;
		//+ ИнфоСофт Заварин К.В. 27.06.24 УА #69703
		Элементы.ПечатьQRКороба.Видимость = Истина;	
		//- ИнфоСофт Заварин К.В. 27.06.24 УА #69703
		//+ ИнфоСофт Заварин К.В. 05.09.24 УА #79742
		Элементы.КоличествоСборочныхЗаданий.Видимость = Ложь;
		Элементы.ОтборОтправлений.Видимость = Ложь;
		//- ИнфоСофт Заварин К.В. 05.09.24 УА #79742
	КонецЕсли;

КонецПроцедуры //- ИнфоСофт Ивонин К.А. 14.02.23 УА #53535

//+ ИнфоСофт Ивонин К.А. 19.02.23 УА #53535
&НаКлиенте
Процедура ОбработкаВыбора(ВыбранноеЗначение, ИсточникВыбора)
		
	Режим = РежимДиалогаВопрос.ДаНет;
	
	ДопПараметры = Новый Структура("Поставка", ВыбранноеЗначение);
	Оповещение = Новый ОписаниеОповещения("ПрикреплениеКПоставкеЗавершение", ЭтотОбъект, ДопПараметры);
	Текст = СтрШаблон("Прикрепить выделенные задания к поставке: %1?", ВыбранноеЗначение); 
	ПоказатьВопрос(Оповещение, Текст, Режим, 0);

КонецПроцедуры //- ИнфоСофт Ивонин К.А. 19.02.23 УА #53535

