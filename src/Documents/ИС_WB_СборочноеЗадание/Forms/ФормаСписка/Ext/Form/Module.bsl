&НаКлиенте
Процедура ПечатьЛистПодбораКомпактныйАльтернативный(Команда)
   
    Если Элементы.ГруппаСтраницы.ТекущаяСтраница = Элементы.ГруппаУправлениеСборочнымиЗаданиями Тогда
    
		ВыделенныеСтроки = Элементы.Список.ВыделенныеСтроки;
			
		Если ВыделенныеСтроки = Неопределено Или ВыделенныеСтроки.Количество() = 0 Тогда
			Возврат;
		КонецЕсли;
		
	ИначеЕсли Элементы.ГруппаСтраницы.ТекущаяСтраница = Элементы.ГруппаУправлениеПоставками Тогда
		
		ВыделенныеСтроки = Элементы.СписокПоставок.ВыделенныеСтроки;
			
		Если ВыделенныеСтроки = Неопределено Или ВыделенныеСтроки.Количество() = 0 Тогда
			Возврат;
		КонецЕсли;
		
		ВыделенныеСтроки = Новый Массив;
		
		Для Каждого Строка Из СписокСборочныхЗаданийВПоставке Цикл
			ВыделенныеСтроки.Добавить(Строка.СборочноеЗадание);	
		КонецЦикла;
						
		Если ВыделенныеСтроки.Количество() = 0 Тогда
			Возврат;
		КонецЕсли;
		
	Иначе
		Возврат;			
	КонецЕсли; 
		
	ПолучитьЭтикеткиСборочныхЗаданийНаСервере(Профиль);
		
	ТабДок = ПолучитьЛистПодбораКомпактныйАльтертативныйНаСервере(ВыделенныеСтроки);
	КоллекцияПечатныхФорм = УправлениеПечатьюКлиент.НоваяКоллекцияПечатныхФорм("Лист Подбора WildBerries");
	
	КоллекцияПечатныхФорм[0].ТабличныйДокумент = ТабДок;
	КоллекцияПечатныхФорм[0].Экземпляров = 1;
	КоллекцияПечатныхФорм[0].СинонимМакета = "Лист Подбора WildBerries";
	
	УправлениеПечатьюКлиент.ПечатьДокументов(КоллекцияПечатныхФорм, Неопределено, ЭтотОбъект);

КонецПроцедуры //- ИнфоСофт Стояк Ю.К. 23.11.2024 УА #86844

