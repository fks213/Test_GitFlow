//+ ИнфоСофт Стояк Ю.К. 23.11.2024 УА #86844
&НаСервере
Функция ПолучитьЛистПодбораКомпактныйАльтертативныйНаСервере(ВыделенныеСтроки)
	
	Табдок = Новый ТабличныйДокумент;
	
	Табдок.ИмяПараметровПечати = "ИС_WB_ПечатьЛистаПодбораКомпактныйАльтернативный";
	ТабДок.ОриентацияСтраницы = ОриентацияСтраницы.Портрет;
	ТабДок.АвтоМасштаб = Истина;
	Табдок.ОтображатьСетку = Истина;
	
	МакетОбработки = УправлениеПечатью.МакетПечатнойФормы("Документ.ИС_WB_СборочноеЗадание.ПФ_MXL_ЛистПодбораКомпактныйАльтернативный");

	ОбластьСтрока = МакетОбработки.ПолучитьОбласть("СтрокаQR");
	ОбластьРазделитель = МакетОбработки.ПолучитьОбласть("Разделитель");
		
	Запрос = Новый Запрос;
	
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ИС_WB_СоответствиеРазмеров.Номенклатура КАК Номенклатура,
	|	ИС_WB_СборочноеЗадание.Заказ.Склад КАК Склад,
	|	ИС_WB_СоответствиеРазмеров.Номенклатура.Код КАК КодНоменклатуры,
	|	ИС_WB_СоответствиеРазмеров.Номенклатура.Артикул КАК АртикулНоменклатуры,
	|	ЕСТЬNULL(РазмещениеНоменклатурыПоСкладскимЯчейкам.Ячейка.Наименование + ЕСТЬNULL(""/"" + РазмещениеНоменклатурыПоСкладскимЯчейкамДополнительная.Ячейка.Наименование, """"), """") КАК Ячейка,
	|	ИС_WB_СборочноеЗадание.Заказ КАК Ссылка,
	|	ИС_WB_СборочноеЗадание.Номер КАК НомерСборочного,
	|	ИС_WB_СборочноеЗадание.Дата КАК Дата,
	|	ИС_WB_СборочноеЗадание.Ссылка КАК ЗаказКлиента,
	|	ИС_WB_СборочноеЗадание.НоменклатураWB.Код КАК Код,
	|	ИС_WB_СборочноеЗадание.НоменклатураWB.vendorCode КАК vendorCode,
	|	ИС_WB_СоответствиеРазмеров.Номенклатура.Наименование КАК Наименование,
	|	ЕСТЬNULL(ИС_WB_СтатусыИЭтикеткиСборочныхЗаданий.partA, """") КАК partA,
	|	ЕСТЬNULL(ИС_WB_СтатусыИЭтикеткиСборочныхЗаданий.partB, """") КАК partB,
	|	ИС_WB_СборочноеЗадание.РазмерWB.techSize КАК techSize
	|ИЗ
	|	Документ.ИС_WB_СборочноеЗадание КАК ИС_WB_СборочноеЗадание
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ИС_WB_СтатусыИЭтикеткиСборочныхЗаданий КАК ИС_WB_СтатусыИЭтикеткиСборочныхЗаданий
	|		ПО (ИС_WB_СборочноеЗадание.Ссылка = ИС_WB_СтатусыИЭтикеткиСборочныхЗаданий.СборочноеЗадание)
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ИС_WB_СоответствиеРазмеров КАК ИС_WB_СоответствиеРазмеров
	|		ПО (ИС_WB_СборочноеЗадание.РазмерWB = ИС_WB_СоответствиеРазмеров.РазмерWB)		
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.РазмещениеНоменклатурыПоСкладскимЯчейкам КАК РазмещениеНоменклатурыПоСкладскимЯчейкам
	|		ПО (РазмещениеНоменклатурыПоСкладскимЯчейкам.Номенклатура = ИС_WB_СоответствиеРазмеров.Номенклатура)
	|			И (РазмещениеНоменклатурыПоСкладскимЯчейкам.Склад = ИС_WB_СборочноеЗадание.Заказ.Склад)
	|			И (РазмещениеНоменклатурыПоСкладскимЯчейкам.ОсновнаяЯчейка)
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.РазмещениеНоменклатурыПоСкладскимЯчейкам КАК РазмещениеНоменклатурыПоСкладскимЯчейкамДополнительная
	|		ПО (РазмещениеНоменклатурыПоСкладскимЯчейкамДополнительная.Номенклатура = ИС_WB_СоответствиеРазмеров.Номенклатура)
	|			И (РазмещениеНоменклатурыПоСкладскимЯчейкамДополнительная.Склад = ИС_WB_СборочноеЗадание.Заказ.Склад)
	|			И (НЕ РазмещениеНоменклатурыПоСкладскимЯчейкамДополнительная.ОсновнаяЯчейка)
	|ГДЕ
	|	ИС_WB_СборочноеЗадание.Ссылка В (&МассивСсылок)
	|
	|УПОРЯДОЧИТЬ ПО
	|	РазмещениеНоменклатурыПоСкладскимЯчейкам.Ячейка.Наименование,
	|	%1,
	|	ИС_WB_СтатусыИЭтикеткиСборочныхЗаданий.partA,
	|	ИС_WB_СтатусыИЭтикеткиСборочныхЗаданий.partB
	|ИТОГИ
	|	МАКСИМУМ(Номенклатура),
	|	МАКСИМУМ(Склад),
	|	МАКСИМУМ(КодНоменклатуры),
	|	МАКСИМУМ(АртикулНоменклатуры),
	|	МАКСИМУМ(Ячейка),
	|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ Номер),
	|	МАКСИМУМ(ЗаказКлиента),
	|	МАКСИМУМ(Код)
	|ПО
	|	vendorCode";
	
	//+ ИнфоСофт Стояк Ю.К. 23.12.2024 УА #89956	
	КопияСортировкаПечати = СортировкаПечати;
	
	Если КопияСортировкаПечати = "Номер" Тогда                      
		КопияСортировкаПечати = "НомерСборочного"; 
	КонецЕсли;	
	
	Запрос.Текст = СтрШаблон(Запрос.Текст, КопияСортировкаПечати);
	//- ИнфоСофт Стояк Ю.К. 23.12.2024 УА #89956
	
	Запрос.УстановитьПараметр("МассивСсылок", ВыделенныеСтроки); 
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Если РезультатЗапроса.Пустой() Тогда
		ОбщегоНазначения.СообщитьПользователю("Не удалось сформировать лист подбора");
		Возврат Табдок;	
	КонецЕсли;  
	
	Область = МакетОбработки.ПолучитьОбласть("Шапка");						
	Табдок.Вывести(Область);
	
	ВыборкаАртикулов = РезультатЗапроса.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	НомерСтроки = 1;
	
	Пока ВыборкаАртикулов.Следующий() Цикл  
		
		Выборка = ВыборкаАртикулов.Выбрать(); 
		
		Область = МакетОбработки.ПолучитьОбласть("СтрокаДанные"); 
		
		ЗаполнитьЗначенияСвойств(Область.Параметры,ВыборкаАртикулов);
		
		Область.Параметры.Количество = ВыборкаАртикулов.НомерСборочного;
		Область.Параметры.Штрихкоды = ПолучитьВсеШтрихкоды(ВыборкаАртикулов.Номенклатура);
		Область.Параметры.Ячейка = ПолучитьВсеЯчейки(ВыборкаАртикулов.Номенклатура, ВыборкаАртикулов.Склад);  
		
		Табдок.Вывести(Область);        
		
		Пока Выборка.Следующий() Цикл
		
			ОбластьСтрока.Параметры.Номер = НомерСтроки;
			ЗаполнитьЗначенияСвойств(ОбластьСтрока.Параметры, Выборка);			
			
			Если Выборка.PartA + Выборка.PartB = "" Тогда
				Сообщить("Внимание! Не определен QR-код для товара " + Выборка.Наименование + ", артикул " + Выборка.techSize + 
				", проверьте заказ " + Строка(Выборка.ЗаказКлиента) + ", id " + Выборка.ЗаказКлиента.rid);
			КонецЕсли; 
			
			Табдок.Вывести(ОбластьСтрока);
			НомерСтроки = НомерСтроки +1; 
			
		КонецЦикла;

		Табдок.Вывести(ОбластьРазделитель);
	
	КонецЦикла;    
			
	Возврат Табдок;
	
КонецФункции //- ИнфоСофт Стояк Ю.К. 23.11.2024 УА #86844

//+ ИнфоСофт Стояк Ю.К. 21.11.2024 УА #87826
&НаСервере
Функция ПечатьЭтикеткиЗоныСборкиНаСервере(ВыделенныеСтроки)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ИС_WB_СборочноеЗадание.Заказ КАК Заказ
	|ПОМЕСТИТЬ ВТ_Заказы
	|ИЗ
	|	Документ.ИС_WB_СборочноеЗадание КАК ИС_WB_СборочноеЗадание
	|ГДЕ
	|	ИС_WB_СборочноеЗадание.Ссылка В(&Ссылка)
	|	И ИС_WB_СборочноеЗадание.Заказ <> ЗНАЧЕНИЕ(Документ.ЗаказКлиента.ПустаяСсылка)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	РасходныйОрдерНаТоварыТоварыПоРаспоряжениям.Ссылка КАК Ссылка
	|ПОМЕСТИТЬ ВТ_РасходныеНакладные
	|ИЗ
	|	ВТ_Заказы КАК ВТ_Заказы
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.РасходныйОрдерНаТовары.ТоварыПоРаспоряжениям КАК РасходныйОрдерНаТоварыТоварыПоРаспоряжениям
	|		ПО ВТ_Заказы.Заказ = РасходныйОрдерНаТоварыТоварыПоРаспоряжениям.Распоряжение
	|ГДЕ
	|	РасходныйОрдерНаТоварыТоварыПоРаспоряжениям.Ссылка <> ЗНАЧЕНИЕ(Документ.РасходныйОрдерНаТовары.ПустаяСсылка)
	|
	|СГРУППИРОВАТЬ ПО
	|	РасходныйОрдерНаТоварыТоварыПоРаспоряжениям.Ссылка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ОтборРазмещениеТоваров.Ссылка КАК Ссылка
	|ИЗ
	|	ВТ_РасходныеНакладные КАК ВТ_РасходныеНакладные
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ОтборРазмещениеТоваров КАК ОтборРазмещениеТоваров
	|		ПО (ВТ_РасходныеНакладные.Ссылка = ОтборРазмещениеТоваров.Распоряжение)
	|ГДЕ
	|	ОтборРазмещениеТоваров.Ссылка <> ЗНАЧЕНИЕ(Документ.ОтборРазмещениеТоваров.ПустаяСсылка)
	|
	|СГРУППИРОВАТЬ ПО
	|	ОтборРазмещениеТоваров.Ссылка
	|
	|УПОРЯДОЧИТЬ ПО
	|	Ссылка";     
	
	Запрос.УстановитьПараметр("Ссылка", ВыделенныеСтроки);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	МассивОбъектов = Новый Массив;
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл  
		
		Если ЗначениеЗаполнено(ВыборкаДетальныеЗаписи.Ссылка) Тогда
			
			НайденныйЭлемент = МассивОбъектов.Найти(ВыборкаДетальныеЗаписи.Ссылка);  
			
			Если НайденныйЭлемент = Неопределено Тогда
				МассивОбъектов.Добавить(ВыборкаДетальныеЗаписи.Ссылка);
			КонецЕсли;
			
		КонецЕсли;     
		
	КонецЦикла;  
	
	Если МассивОбъектов.Количество() = 0 Тогда
		ОбщегоНазначения.СообщитьПользователю("Не найдено документов на отбор товаров для печати этикетки зоны размещения");	
	КонецЕсли;

	ПараметрыПечати = Новый Структура;
	ПараметрыПечати.Вставить("ВыводитьГоризонтальныйРазделитель", ВыводитьГоризонтальныйРазделитель);
	ПараметрыПечати.Вставить("СортироватьЯчейкиПо", СортироватьЯчейкиПо); 
		
	ТабДок = ИС_МП_Печать.ПечатьЭтикеткиЗоныСборки(МассивОбъектов, ПараметрыПечати);
	
	Возврат ТабДок;
	
КонецФункции //- ИнфоСофт Стояк Ю.К. 21.11.2024 УА #87826

//+ ИнфоСофт Стояк Ю.К. 23.11.2024 УА #86844
&НаСервере
Функция ПолучитьВсеШтрихкоды(Номенклатура)
	
	Запрос = Новый Запрос("ВЫБРАТЬ
	                      |	ШтрихкодыНоменклатуры.Штрихкод КАК Штрихкод,
	                      |	ШтрихкодыНоменклатуры.Номенклатура КАК Номенклатура
	                      |ИЗ
	                      |	РегистрСведений.ШтрихкодыНоменклатуры КАК ШтрихкодыНоменклатуры
	                      |ГДЕ
	                      |	ШтрихкодыНоменклатуры.Номенклатура = &Номенклатура"); 
	
	Запрос.УстановитьПараметр("Номенклатура", Номенклатура);
	Выборка = Запрос.Выполнить().Выбрать();
	Штрихкод = ""; 
	
	Пока Выборка.Следующий() цикл
		Штрихкод = Штрихкод + Выборка.Штрихкод + Символы.ПС;		
	КонецЦикла;
	
	Возврат СокрЛП(Штрихкод);
	
КонецФункции //- ИнфоСофт Стояк Ю.К. 23.11.2024 УА #86844

//+ ИнфоСофт Стояк Ю.К. 23.11.2024 УА #86844
&НаСервере
Функция ПолучитьВсеЯчейки(Номенклатура, Склад) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст =	
	"ВЫБРАТЬ
	|	РазмещениеНоменклатурыПоСкладскимЯчейкам.Номенклатура КАК Номенклатура,
	|	РазмещениеНоменклатурыПоСкладскимЯчейкам.Склад КАК Склад,
	|	РазмещениеНоменклатурыПоСкладскимЯчейкам.Помещение КАК Помещение,
	|	РазмещениеНоменклатурыПоСкладскимЯчейкам.Ячейка КАК Ячейка,
	|	РазмещениеНоменклатурыПоСкладскимЯчейкам.ОсновнаяЯчейка КАК ОсновнаяЯчейка
	|ИЗ
	|	РегистрСведений.РазмещениеНоменклатурыПоСкладскимЯчейкам КАК РазмещениеНоменклатурыПоСкладскимЯчейкам
	|ГДЕ
	|	РазмещениеНоменклатурыПоСкладскимЯчейкам.Номенклатура = &Номенклатура
	|	И РазмещениеНоменклатурыПоСкладскимЯчейкам.Склад = &Склад
	|
	|УПОРЯДОЧИТЬ ПО
	|	РазмещениеНоменклатурыПоСкладскимЯчейкам.ОсновнаяЯчейка УБЫВ";

	Запрос.УстановитьПараметр("Номенклатура", Номенклатура);
	Запрос.УстановитьПараметр("Склад", Склад); 
	
	ТаблицаЗначений = Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("ячейка");
	
	Возврат СтрСоединить(ТаблицаЗначений, "/" + Символы.ПС);
	
КонецФункции //- ИнфоСофт Стояк Ю.К. 23.11.2024 УА #86844

