//+ ИнфоСофт Ивонин К.А. 13.07.22 УА #46999
&НаКлиенте
Процедура ЗагрузитьСборочныеЗадания(Команда)

	Если Не ЗначениеЗаполнено(Профиль) Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю("Не выбран Профиль", , , "Профиль");
		Возврат;
	КонецЕсли; 
	
	//+ ИнфоСофт Стояк Ю.К. 04.04.2024 УА #67207
	РеглРаботает = ПроверитьРегламетноеЗаданиеНаСервере(Профиль, "ПолучениеСборочныхЗаданий");
	
	Если Не РеглРаботает Тогда    
		
		ДлительнаяОперация = ЗагрузитьСборочныеЗаданияНаСервере(Профиль, ДатаПоследнегоСборочногоЗадания, УникальныйИдентификатор);
		
		ОповещениеОЗавершении = Новый ОписаниеОповещения("ПолучениеЗаказовЗавершение", ЭтотОбъект);
		ДлительныеОперацииКлиент.ОжидатьЗавершение(ДлительнаяОперация, ОповещениеОЗавершении, ПараметрыОжидания());
		
		Элементы["КартинкаОжидание"].Видимость = Истина;		
		
		//ЗагрузитьСборочныеЗаданияНаСервере(Профиль, ДатаПоследнегоСборочногоЗадания);		
		
	Иначе
		ОбщегоНазначенияКлиент.СообщитьПользователю("Уже выполняется регламентное задание по загрузке заказов, обновите форму чуть позже");
	КонецЕсли;                                      
	//Элементы.Список.Обновить();
	//- ИнфоСофт Стояк Ю.К. 04.04.2024 УА #67207	
	
КонецПроцедуры //- ИнфоСофт Ивонин К.А. 13.07.22 УА #46999 

//+ ИнфоСофт Ивонин К.А. 12.02.23 УА #53535
&НаКлиенте
Процедура ОбновитьСтатусы(Команда)
		
	Если Не ЗначениеЗаполнено(Профиль) Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю("Не выбран Профиль", , , "Профиль");
