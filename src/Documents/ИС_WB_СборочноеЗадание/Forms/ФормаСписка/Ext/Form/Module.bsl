//+ ИнфоСофт Заварин К.В. 06.05.24 УА #68658
&НаКлиенте
Процедура ОбновитьВыделенныеСтатусы(Команда)

	Если Не ЗначениеЗаполнено(Профиль) Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю("Не выбран Профиль", , , "Профиль");
		Возврат;
	КонецЕсли;

	РеглРаботает = ПроверитьРегламетноеЗаданиеНаСервере(Профиль, "ОбновлениеСтатусовСборочныхЗаданий");
	
	Если Не РеглРаботает Тогда  
		
		Если Элементы.ГруппаСтраницы.ТекущаяСтраница = Элементы.ГруппаУправлениеСборочнымиЗаданиями Тогда
			
			ВыделенныеСтроки = Элементы.Список.ВыделенныеСтроки;
			
