&НаСервереБезКонтекста
Функция УдалитьНедопустимыеТипыДоставки(МассивЗаказов)
	
	ТипДоставки = Перечисления.ИС_ВБ_ТипыДоставки.FBS;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ИС_WB_СборочноеЗадание.Ссылка КАК Ссылка
	|ИЗ
	|	Документ.ИС_WB_СборочноеЗадание КАК ИС_WB_СборочноеЗадание
	|ГДЕ
	|	ИС_WB_СборочноеЗадание.Ссылка В(&Ссылка)
	|	И ИС_WB_СборочноеЗадание.ТипДоставки = &ТипДоставки";
	
	Запрос.УстановитьПараметр("Ссылка", МассивЗаказов);
	Запрос.УстановитьПараметр("ТипДоставки", ТипДоставки);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Результат = Новый Массив;
	
	ВыборкаЗаказов = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаЗаказов.Следующий() Цикл
		Результат.Добавить(ВыборкаЗаказов.Ссылка);
	КонецЦикла;
	
	Возврат Результат;
	
