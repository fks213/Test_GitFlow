&НаКлиенте
Процедура ОткрытьФормуУдалениеСборочныхЗаданийЗавершение(Результат, ДополнительныеПараметры) Экспорт
		
	Если Результат = Неопределено Тогда  // отменено пользователем
		Возврат;
	КонецЕсли;
	
	Если Результат.Статус = "Ошибка" Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю(Результат.ПодробноеПредставлениеОшибки);
		Возврат;
	КонецЕсли;
	
	ДлительнаяОперация = УдалениеСборочныхЗаданийНаСервере(Результат, Профиль, УникальныйИдентификатор);
	
	ОповещениеОЗавершении = Новый ОписаниеОповещения("УдалениеСборочныхЗаданийЗавершение", ЭтотОбъект);
	ДлительныеОперацииКлиент.ОжидатьЗавершение(ДлительнаяОперация, ОповещениеОЗавершении, ПараметрыОжидания());
	
КонецПроцедуры //- ИнфоСофт Конышев А.Е. 28.11.24 УА #72929

