&НаКлиенте
Процедура УстановитьОтборыОтправлений()
	
	ВсеОтправления = Ложь;
	ВидимостьФормаПрикрепитьКПоставке = Ложь;	
	
	Статусы = Новый Массив;
	//+ ИнфоСофт Стояк Ю.К. 02.03.2025 УА #87461
	СтатусыВБ = Новый Массив;
	ИсключающиесяСтатусыВБ = Новый Массив;
	//- ИнфоСофт Стояк Ю.К. 02.03.2025 УА #87461
	
	Если ОтборОтправлений = "Новые" Тогда
		
		Статусы.Добавить(ПредопределенноеЗначение("Перечисление.ИС_WB_СтатусыСборочныхЗаданий.new"));
		
		//+ ИнфоСофт Стояк Ю.К. 02.03.2025 УА #87461
		ИсключающиесяСтатусыВБ.Добавить(ПредопределенноеЗначение("Перечисление.ИС_WB_СтатусыСборочныхЗаданийВСистемеWildBerries.declined_by_client"));
		ИсключающиесяСтатусыВБ.Добавить(ПредопределенноеЗначение("Перечисление.ИС_WB_СтатусыСборочныхЗаданийВСистемеWildBerries.canceled_by_client"));
		//- ИнфоСофт Стояк Ю.К. 02.03.2025 УА #87461
		
		ВидимостьФормаПрикрепитьКПоставке = Истина;
		
	ИначеЕсли ОтборОтправлений = "Сборка" Тогда
		
		Статусы.Добавить(ПредопределенноеЗначение("Перечисление.ИС_WB_СтатусыСборочныхЗаданий.confirm"));
		
		ВидимостьФормаПрикрепитьКПоставке = Ложь;
		
	ИначеЕсли ОтборОтправлений = "Доставка" Тогда
		
		Статусы.Добавить(ПредопределенноеЗначение("Перечисление.ИС_WB_СтатусыСборочныхЗаданий.complete"));
		//+ ИнфоСофт Стояк Ю.К. 02.03.2025 УА #87461
		ИсключающиесяСтатусыВБ.Добавить(ПредопределенноеЗначение("Перечисление.ИС_WB_СтатусыСборочныхЗаданийВСистемеWildBerries.sold"));
		ИсключающиесяСтатусыВБ.Добавить(ПредопределенноеЗначение("Перечисление.ИС_WB_СтатусыСборочныхЗаданийВСистемеWildBerries.canceled_by_client"));
		ИсключающиесяСтатусыВБ.Добавить(ПредопределенноеЗначение("Перечисление.ИС_WB_СтатусыСборочныхЗаданийВСистемеWildBerries.defect"));
		//- ИнфоСофт Стояк Ю.К. 02.03.2025 УА #87461
		
		ВидимостьФормаПрикрепитьКПоставке = Ложь;
		
	ИначеЕсли ОтборОтправлений = "Доставлены" Тогда
		
		Статусы.Добавить(ПредопределенноеЗначение("Перечисление.ИС_WB_СтатусыСборочныхЗаданий.receive"));
		//+ ИнфоСофт Стояк Ю.К. 02.03.2025 УА #87461
		СтатусыВБ.Добавить(ПредопределенноеЗначение("Перечисление.ИС_WB_СтатусыСборочныхЗаданийВСистемеWildBerries.sold"));
		
		ИсключающиесяСтатусыВБ.Добавить(ПредопределенноеЗначение("Перечисление.ИС_WB_СтатусыСборочныхЗаданийВСистемеWildBerries.canceled_by_client"));
		ИсключающиесяСтатусыВБ.Добавить(ПредопределенноеЗначение("Перечисление.ИС_WB_СтатусыСборочныхЗаданийВСистемеWildBerries.defect"));
		//- ИнфоСофт Стояк Ю.К. 02.03.2025 УА #87461
		
		ВидимостьФормаПрикрепитьКПоставке = Ложь;
		
	ИначеЕсли ОтборОтправлений = "Отменены" Тогда
		
		Статусы.Добавить(ПредопределенноеЗначение("Перечисление.ИС_WB_СтатусыСборочныхЗаданий.cancel"));
		//+ ИнфоСофт Стояк Ю.К. 02.03.2025 УА #87461
		СтатусыВБ.Добавить(ПредопределенноеЗначение("Перечисление.ИС_WB_СтатусыСборочныхЗаданийВСистемеWildBerries.canceled_by_client"));
		СтатусыВБ.Добавить(ПредопределенноеЗначение("Перечисление.ИС_WB_СтатусыСборочныхЗаданийВСистемеWildBerries.defect"));
		СтатусыВБ.Добавить(ПредопределенноеЗначение("Перечисление.ИС_WB_СтатусыСборочныхЗаданийВСистемеWildBerries.declined_by_client"));
		//- ИнфоСофт Стояк Ю.К. 02.03.2025 УА #87461
		
		ВидимостьФормаПрикрепитьКПоставке = Ложь;
		
	Иначе // Все 
		
		ВсеОтправления = Истина;
		
		Статусы.Добавить(ПредопределенноеЗначение("Перечисление.ИС_WB_СтатусыСборочныхЗаданий.ПустаяСсылка")); 
		
		ВидимостьФормаПрикрепитьКПоставке = Истина;
		
	КонецЕсли;
	
	Список.Параметры.УстановитьЗначениеПараметра("ВсеОтправления", ВсеОтправления); 
	Список.Параметры.УстановитьЗначениеПараметра("Статусы", Статусы);
	//+ ИнфоСофт Стояк Ю.К. 02.03.2025 УА #87461
	Список.Параметры.УстановитьЗначениеПараметра("СтатусыВБ", СтатусыВБ);
	Список.Параметры.УстановитьЗначениеПараметра("ИсключающиесяСтатусыВБ", ИсключающиесяСтатусыВБ);
	//- ИнфоСофт Стояк Ю.К. 02.03.2025 УА #87461
	Элементы.ФормаПрикрепитьКПоставке.Видимость = ВидимостьФормаПрикрепитьКПоставке;
	
	КоличествоЭлементовСписка = КоличествоДинамическогоСписка();
	
	КоличествоСборочныхЗаданий = СтрШаблон("%1", КоличествоЭлементовСписка);
	
КонецПроцедуры //- ИнфоСофт Заварин К.В. 05.09.24 УА #79742

