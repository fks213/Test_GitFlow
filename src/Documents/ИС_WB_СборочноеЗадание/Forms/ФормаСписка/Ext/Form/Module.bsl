&НаКлиенте
Процедура ПрикрепитьКПоставке(Команда)

	Если Не ЗначениеЗаполнено(Профиль) Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю("Не выбран Профиль", , , "Профиль");
		Возврат;
	КонецЕсли;
	
	ВыделенныеСтроки = Элементы.Список.ВыделенныеСтроки;
			
	Если ВыделенныеСтроки = Неопределено Или ВыделенныеСтроки.Количество() = 0 Тогда
	 	ОбщегоНазначенияКлиент.СообщитьПользователю(
	 		"Перед прикреплением к поставке нужно выделить необходимые сборочные задания");
		Возврат;
	КонецЕсли;
	
	ВыделенныеСтроки = УдалитьНедопустимыеТипыДоставки(ВыделенныеСтроки);
	
	Если ВыделенныеСтроки.Количество() = 0 Тогда 
		ОбщегоНазначенияКлиент.СообщитьПользователю("В выделенном списке нет заказов схемы FBS");
		Возврат;	
	КонецЕсли;
	
	ТипТовара = ПроверитьВозможностьПрикрепления(ВыделенныеСтроки);
	
	Если ТипТовара = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	МассивТиповТовара = Новый Массив;
	МассивТиповТовара.Добавить(ТипТовара);
	МассивТиповТовара.Добавить(ПредопределенноеЗначение("Перечисление.ИС_ВБ_ТипыТоваров.ПустаяСсылка"));
	
	ПараметрыОтбора = Новый Структура("Профиль", Профиль);
	ПараметрыОтбора.Вставить("ТипТовара", МассивТиповТовара);
	ПараметрыОтбора.Вставить("done", Ложь);
	ПараметрыОтбора.Вставить("ПометкаУдаления", Ложь);
	
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("РежимВыбора", Истина);
	ПараметрыФормы.Вставить("МножественныйВыбор", Ложь);
	ПараметрыФормы.Вставить("ЗакрыватьПриВыборе", Истина);
	ПараметрыФормы.Вставить("Отбор", ПараметрыОтбора);
	
	ОткрытьФорму("Справочник.ИС_ВБ_ПоставкиFBS.ФормаВыбора", ПараметрыФормы, ЭтотОбъект);
		
КонецПроцедуры //- ИнфоСофт Ивонин К.А. 15.02.23 УА #53535

