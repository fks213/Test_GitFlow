	КонецЕсли;
							
	ВыборкаАртикулов = РезультатЗапроса.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
		
	Если ВыводитьКомплектующие Тогда
		
		Запрос = Новый Запрос;
