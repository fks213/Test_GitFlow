&НаСервере
Процедура ПометитьНаУдалениеПривязанныеДокументыНаСервере()
	
	Событие = "ИС_WB_СборочноеЗадание.ПометитьНаУдалениеПривязанныеДокументыНаСервере";
	
	ВыделенныеСтроки = Элементы.Список.ВыделенныеСтроки;
	
	Для Каждого Строка Из ВыделенныеСтроки Цикл
		
		ИС_MP_РаботаСЗаказами.ПометитьНаУдалениеПривязанныеДокументы(Строка.Заказ);	
		
		СтрокаСборочноеЗадание = Строка.ПолучитьОбъект();
		
		СтрокаСборочноеЗадание.ПометкаУдаления = Истина; 			
		
		Попытка	
			СтрокаСборочноеЗадание.Записать();
		Исключение 
			
			Текст = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
			ИС_MP_Сервер.ЗаписатьВЖРИСообщитьПользователю(Событие, Текст);
			
		КонецПопытки;
		
	КонецЦикла;	
	
КонецПроцедуры //- ИнфоСофт Заварин К.В. 13.11.24 УА #85881

