КонецПроцедуры //- ИнфоСофт Сумин Д.В. 21.07.2023 УА #57893

//+ ИнфоСофт Сумин Д.В. 21.07.2023 УА #57893
&НаСервере
Процедура ЗаполнитьДанныеСборкиНаСервере()
	//+ ИнфоСофт Сумин Д.В. 01.02.2024 УА #69810
    ДанныеСборки.Очистить();
	//- ИнфоСофт Сумин Д.В. 01.02.2024 УА #69810

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ИС_WB_СтатусыИЭтикеткиСборочныхЗаданий.СборочноеЗадание КАК СборочноеЗадание,
	|	ИС_WB_СтатусыИЭтикеткиСборочныхЗаданий.СборочноеЗадание.РазмерWB КАК СборочноеЗаданиеРазмерWB
	|ПОМЕСТИТЬ ВТ_СборочныеЗадания
	|ИЗ
	|	РегистрСведений.ИС_WB_СтатусыИЭтикеткиСборочныхЗаданий КАК ИС_WB_СтатусыИЭтикеткиСборочныхЗаданий
	|ГДЕ
	|	ИС_WB_СтатусыИЭтикеткиСборочныхЗаданий.Поставка = &Поставка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_СборочныеЗадания.СборочноеЗадание КАК СборочноеЗадание,
	|	МАКСИМУМ(ИС_WB_СоответствиеРазмеров.Номенклатура) КАК Номенклатура,
	|	МАКСИМУМ(ИС_WB_СоответствиеРазмеров.Характеристика) КАК Характеристика
	|ПОМЕСТИТЬ ВТ_Номенклатура
	|ИЗ
	|	ВТ_СборочныеЗадания КАК ВТ_СборочныеЗадания
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ИС_WB_СоответствиеРазмеров КАК ИС_WB_СоответствиеРазмеров
	|		ПО ВТ_СборочныеЗадания.СборочноеЗаданиеРазмерWB = ИС_WB_СоответствиеРазмеров.РазмерWB
	|
	|СГРУППИРОВАТЬ ПО
	|	ВТ_СборочныеЗадания.СборочноеЗадание
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_СборочныеЗадания.СборочноеЗадание КАК СборочноеЗадание,
	|	ВТ_СборочныеЗадания.СборочноеЗадание.Номер КАК НомерОтправления,
	|	ВТ_Номенклатура.Номенклатура КАК Номенклатура,
	|	ВТ_Номенклатура.Характеристика КАК Характеристика
	|ИЗ
	|	ВТ_СборочныеЗадания КАК ВТ_СборочныеЗадания
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_Номенклатура КАК ВТ_Номенклатура
	|		ПО ВТ_СборочныеЗадания.СборочноеЗадание = ВТ_Номенклатура.СборочноеЗадание";
	
	Запрос.УстановитьПараметр("Поставка", Поставка);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Выборка = РезультатЗапроса.Выбрать();
	
	Пока Выборка.Следующий() Цикл
		СтрокаТЗ = ДанныеСборки.Добавить();
		ЗаполнитьЗначенияСвойств(СтрокаТЗ, Выборка);
	КонецЦикла;	
	
КонецПроцедуры //- ИнфоСофт Сумин Д.В. 21.07.2023 УА #57893	

//+ ИнфоСофт Сумин Д.В. 08.02.2024 УА #70157
&НаКлиенте
Процедура ВыполнитьПроверкуНаПечать(РезультатОбработкиШтрихкода)
	
	//+ ИнфоСофт Стояк Ю.К. 13.08.2024 УА #81686
	//ДанныеШтрихкода = РезультатОбработкиШтрихкода;
	ДанныеШтрихкода = РезультатОбработкиШтрихкода.ДанныеШтрихкода;
	//- ИнфоСофт Стояк Ю.К. 13.08.2024 УА #81686 
	
	//На момент сканирования нет понимния какой вид маркированной продукции сканируется. Поэтому стандартный механизм не используется. 
	//+ ИнфоСофт Мурсалимов Д.Р. 05.03.24 УА #70747 
	РезультатРазбора = РазборКодаМаркировкиНаСервере(ДанныеШтрихкода.НормализованныйШтрихкод);
	//РезультатРазбора = РазборКодаМаркировкиИССлужебныйКлиент.РазобратьКодМаркировки(ДанныеШтрихкода.НормализованныйШтрихкод);
	//- ИнфоСофт Мурсалимов Д.Р. 05.03.24 УА #70747
	
	Если РезультатРазбора <> Неопределено Тогда
		ДанныеШтрихкодаУпаковки = ПолучитьДанныеШтрихкодаУпаковки(РезультатРазбора);
		ДанныеШтрихкода = ДанныеШтрихкодаУпаковки;
	Иначе
		ДанныеШтрихкодаУпаковки = Неопределено;
	КонецЕсли;
	
	//+ ИнфоСофт Заварин К.В. 16.09.24 УА #83473
	//Если ДанныеШтрихкодаУпаковки = Неопределено И Не ЗначениеЗаполнено(ДанныеШтрихкода.Номенклатура) Тогда
	Если ДанныеШтрихкодаУпаковки = Неопределено И ДанныеШтрихкода = Неопределено Тогда		
		//ОбщегоНазначенияКлиент.СообщитьПользователю("Не найдены данные по коду " + ДанныеШтрихкода.Штрихкод);
		ОбщегоНазначенияКлиент.СообщитьПользователю("Не найдены данные по коду ");
	//- ИнфоСофт Заварин К.В. 16.09.24 УА #83473
		Возврат;		
	КонецЕсли;	
	
	СтрокаТЗДанныеСборки = Неопределено;   
	
	Для Каждого Строка Из ДанныеСборки Цикл
		Если Строка.Номенклатура = ДанныеШтрихкода.Номенклатура И Строка.Характеристика = ДанныеШтрихкода.Характеристика И Не Строка.ЭтикеткаРаспечатана Тогда
			СтрокаТЗДанныеСборки = Строка;
			Прервать;
		КонецЕсли;	
	КонецЦикла;	
	
	Если СтрокаТЗДанныеСборки = Неопределено Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю("По отсканированному штрихкоду не найдено доступного заказа для печати этикетки.");
		Возврат;
	КонецЕсли;	
	
	Попытка
		ВыполнитьПечатьЭтикетки(СтрокаТЗДанныеСборки); 
		
		СтрокаТЗДанныеСборки.ЭтикеткаРаспечатана = Истина;
		СтрокаТЗДанныеСборки.ШтрихкодУпаковки = ДанныеШтрихкода.ШтрихкодУпаковки;
		
		Если ЗначениеЗаполнено(СтрокаТЗДанныеСборки.ШтрихкодУпаковки) Тогда 
			СтрокаТЗДанныеСборки.Киз = ДанныеШтрихкода.НормализованныйШтрихкод; 
		КонецЕсли;
		
	Исключение
		ОбщегоНазначенияКлиент.СообщитьПользователю(ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;
	
КонецПроцедуры //- ИнфоСофт Сумин Д.В. 08.02.2024 УА #70157

//+ ИнфоСофт Сумин Д.В. 21.07.2023 УА #57893
&НаКлиенте
Процедура ВыполнитьПечатьЭтикетки(СтрокаТЗДанныеСборки) 
	
	Если ПечататьЭтикеткиЗаказа Тогда
		ЭтикеткаЗаказа = ПолучитьЭтикеткиНаСервере(СтрокаТЗДанныеСборки.СборочноеЗадание);
						
		Если ЗначениеЗаполнено(НастройкиПечатиЭтикеток) Тогда 		
			ВыполнитьНастройкуТабличногоДокумента(ЭтикеткаЗаказа, НастройкиПечатиЭтикеток);			
		КонецЕсли;
		
		ЭтикеткаЗаказа.Напечатать(); 
						
	КонецЕсли; 
	
	Если ПечататьШтрихкоды Тогда
		ЭтикеткаШтрихкода = ПолучитьШтрихкодовНаСервере(СтрокаТЗДанныеСборки.СборочноеЗадание);  
						
		Если ЗначениеЗаполнено(НастройкиПечатиШтрихкодов) Тогда 	
			ВыполнитьНастройкуТабличногоДокумента(ЭтикеткаШтрихкода, НастройкиПечатиШтрихкодов);	
		КонецЕсли;
		
		ЭтикеткаШтрихкода.Напечатать();
		
	КонецЕсли;	
	
КонецПроцедуры //- ИнфоСофт Сумин Д.В. 21.07.2023 УА #57893

//+ ИнфоСофт Сумин Д.В. 21.07.2023 УА #57893
&НаСервере
Функция ПолучитьЭтикеткиНаСервере(ВыделенныеСтроки)

	Табдок = Новый ТабличныйДокумент;
	
	Табдок.ИмяПараметровПечати = "ИС_WB_ПечатьЭтикеток";
	ТабДок.ОриентацияСтраницы = ОриентацияСтраницы.Портрет;
	ТабДок.АвтоМасштаб = Истина;
	
	МакетОбработки = УправлениеПечатью.МакетПечатнойФормы("Документ.ИС_WB_СборочноеЗадание.ПФ_MXL_QR58х40");
			
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ИС_WB_СтатусыИЭтикеткиСборочныхЗаданий.СборочноеЗадание.Номер КАК СборочноеЗаданиеНомер,
	|	ИС_WB_СтатусыИЭтикеткиСборочныхЗаданий.Этикетка КАК Этикетка,
	|	ИС_WB_СтатусыИЭтикеткиСборочныхЗаданий.СборочноеЗадание.НоменклатураWB.vendorCode КАК СборочноеЗаданиеНоменклатураWBvendorCode,
	|	ИС_WB_СтатусыИЭтикеткиСборочныхЗаданий.СборочноеЗадание.НоменклатураWB.Наименование КАК СборочноеЗаданиеНоменклатураWBНаименование,
	|	ИС_WB_СтатусыИЭтикеткиСборочныхЗаданий.СборочноеЗадание.НоменклатураWB.Код КАК СборочноеЗаданиеНоменклатураWBКод
	|ИЗ
	|	РегистрСведений.ИС_WB_СтатусыИЭтикеткиСборочныхЗаданий КАК ИС_WB_СтатусыИЭтикеткиСборочныхЗаданий
	|ГДЕ
	|	ИС_WB_СтатусыИЭтикеткиСборочныхЗаданий.СборочноеЗадание В(&МассивСсылок)";
	
	Запрос.Текст = СтрШаблон(Запрос.Текст);
	
	Запрос.УстановитьПараметр("МассивСсылок", ВыделенныеСтроки); 
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Если РезультатЗапроса.Пустой() Тогда
		ОбщегоНазначения.СообщитьПользователю("Не удалось сформировать этикетки WildBerries");
		Возврат Табдок;	
	КонецЕсли;
		
	ОбластьЭтикетка = МакетОбработки.ПолучитьОбласть("Этикетка");
						
	Выборка = РезультатЗапроса.Выбрать();
	
	Первый = Истина;	
	Пока Выборка.Следующий() Цикл  
				
		ОбластьЭтикетка.Рисунки.КартинкаQR.Картинка = Новый Картинка(Выборка.Этикетка.Получить()); 
		
		Если Не Первый Тогда
			Табдок.ВывестиГоризонтальныйРазделительСтраниц();
		КонецЕсли;
		
		Первый = Ложь;
			
		Табдок.Вывести(ОбластьЭтикетка);
			
	КонецЦикла;    
			
	Возврат Табдок;
	
КонецФункции //- ИнфоСофт Сумин Д.В. 21.07.2023 УА #57893

//+ ИнфоСофт Сумин Д.В. 11.08.2023 УА #57893
&НаКлиенте
Процедура ПрикрепитьКиЗы(Команда)  

	
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("Профиль", ПолучитьПрофиль(Поставка));
	ПараметрыФормы.Вставить("Товары", ДанныеСборки);
	
	ОткрытьФорму("Документ.ИС_WB_СборочноеЗадание.Форма.ФормаКиЗов", ПараметрыФормы, ЭтотОбъект);  
	
КонецПроцедуры //- ИнфоСофт Сумин Д.В. 11.08.2023 УА #57893

