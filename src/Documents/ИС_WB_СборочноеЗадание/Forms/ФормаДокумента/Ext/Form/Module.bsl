//+ ИнфоСофт Ивонин К.А. 19.02.23 УА #53535
&НаКлиенте
Процедура ОбработкаВыбора(ВыбранноеЗначение, ИсточникВыбора)
		
	Режим = РежимДиалогаВопрос.ДаНет;
	
	ДопПараметры = Новый Структура("Поставка", ВыбранноеЗначение);
	Оповещение = Новый ОписаниеОповещения("ПрикреплениеКПоставкеЗавершение", ЭтотОбъект, ДопПараметры);
	Текст = СтрШаблон("Прикрепить выделенные задания к поставке: %1?", ВыбранноеЗначение); 
	ПоказатьВопрос(Оповещение, Текст, Режим, 0);

КонецПроцедуры //- ИнфоСофт Ивонин К.А. 19.02.23 УА #53535

