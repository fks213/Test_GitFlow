//+ ИнфоСофт Ивонин К.А. 04.07.22 УА #46999
&НаКлиенте
Процедура УстановитьОформление()
		
	Если Не Объект.Ссылка.Пустая() Тогда
	   
	   	ШрифтПолужирный = ПолучитьШрифтПолужирный();
	   	
		Элементы.Номер.Вид = ВидПоляФормы.ПолеНадписи;
		Элементы.Номер.Шрифт = ШрифтПолужирный;
		Элементы.Номер.Формат = "ЧГ=0";
		Элементы.Дата.Вид = ВидПоляФормы.ПолеНадписи; 
		Элементы.Дата.Шрифт = ШрифтПолужирный; 
		Элементы.Профиль.Вид = ВидПоляФормы.ПолеНадписи; 
		Элементы.Профиль.Шрифт = ШрифтПолужирный;
		
		Если ЗначениеЗаполнено(Объект.Склад) Тогда
			Элементы.Склад.Вид = ВидПоляФормы.ПолеНадписи; 
			Элементы.Склад.Шрифт = ШрифтПолужирный;
		КонецЕсли;
		
		Если ЗначениеЗаполнено(Объект.Валюта) Тогда
			Элементы.Валюта.Вид = ВидПоляФормы.ПолеНадписи; 
			Элементы.Валюта.Шрифт = ШрифтПолужирный;
		КонецЕсли;
		
	КонецЕсли;
	
	//+ ИнфоСофт Сумин Д.В. 26.04.2024 УА #70825 
	Если ЗначениеЗаполнено(Объект.ВалютаПродажи) тогда
		Элементы.ВалютаПродажи.Вид = ВидПоляФормы.ПолеНадписи; 
		Элементы.ВалютаПродажи.Шрифт = ШрифтПолужирный;	
	КонецЕсли;
	
	Если Объект.price = Объект.convertedPrice Тогда
		Элементы.convertedPrice.Видимость = Ложь;
		Элементы.Валюта.Видимость = Ложь;
		Элементы.ДекорацияЦенаПоставщика.Видимость = Ложь;
		Элементы.ДекорацияВалюта.Видимость = Ложь;
	КонецЕсли;
	//Если Объект.price = Объект.convertedPrice Тогда
	//	Элементы.price.Видимость = Ложь;
	//	Элементы.Валюта.Видимость = Ложь;
	//КонецЕсли;
	//- ИнфоСофт Сумин Д.В. 26.04.2024 УА #70825
	
	//+ ИнфоСофт Стояк Ю.К. 03.03.2025 УА #93469
	Если Объект.ТипДоставки = ПредопределенноеЗначение("Перечисление.ИС_ВБ_ТипыДоставки.FBO") Тогда
		Элементы.ПрикрепитьКПоставке.Доступность = Ложь;
		Элементы.ОтменитьЗадание.Доступность = Ложь;
		Элементы.ФормаЗагрузитьСборочноеЗадание.Доступность = Ложь;
	КонецЕсли;
	//- ИнфоСофт Стояк Ю.К. 03.03.2025 УА #93469 
		 
КонецПроцедуры //- ИнфоСофт Ивонин К.А. 04.07.22 УА #46999

