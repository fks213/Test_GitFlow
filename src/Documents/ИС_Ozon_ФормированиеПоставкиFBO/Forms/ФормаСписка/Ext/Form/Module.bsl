	Пока Выборка.Следующий() Цикл
			НоваяСтрока 						= ДанныеНоменклатура.Добавить();
			НоваяСтрока.Количество 				= Выборка.Количество;
			НоваяСтрока.КоличествоЗаявлено 		= Выборка.КоличествоЗаявлено;
			НоваяСтрока.Номенклатура 			= Выборка.Номенклатура;
			НоваяСтрока.Характеристика 			= Выборка.Характеристика;
			НоваяСтрока.Артикул		 			= Выборка.Артикул;
	КонецЦикла;	
	
	Возврат ДанныеНоменклатура;
	
