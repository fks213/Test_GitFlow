	ДополнительныеПараметры.Вставить("Адрес", "АдресОтчетаВоВременномХранилище");  
	ДополнительныеПараметры.Вставить("ДиалогВыбораФайла", ДиалогВыбораФайла);
	
	ДиалогВыбораФайла.Показать(Новый ОписаниеОповещения("ПутьКФайлуНачалоВыбораЗавершение", ЭтотОбъект, ДополнительныеПараметры));

КонецПроцедуры //- ИнфоСофт Стояк Ю.К. 14.11.2024 УА #70275 

//+ ИнфоСофт Стояк Ю.К. 14.11.2024 УА #70275
&НаСервере
Процедура ЗаполнитьТаблицуДаннымиДокумента()
	
	ФайлВременногоХранилища = ПолучитьИзВременногоХранилища(АдресОтчетаВоВременномХранилище);
	Имя = ПолучитьИмяВременногоФайла("xlsx");
	ФайлВременногоХранилища.Записать(Имя);  
	
	ТабличныйДокумент = Новый ТабличныйДокумент; 
	ТабличныйДокумент.Прочитать(Имя);
	
	КоличествоСтрок = ТабличныйДокумент.ВысотаТаблицы;
	
	ДанныеАкта = Новый ТаблицаЗначений;
	ДанныеАкта.Колонки.Добавить("Баркод", Новый ОписаниеТипов("Строка",,,Новый КвалификаторыСтроки(50)));
	ДанныеАкта.Колонки.Добавить("Артикул", Новый ОписаниеТипов("Строка",,,Новый КвалификаторыСтроки(50)));
	ДанныеАкта.Колонки.Добавить("Количество", Новый ОписаниеТипов("Число",,,Новый КвалификаторыЧисла(10)));
	ДанныеАкта.Колонки.Добавить("КоличествоЗаявлено", Новый ОписаниеТипов("Число",,,Новый КвалификаторыЧисла(10)));
	
	Для сч = 4 По КоличествоСтрок Цикл 	
		Попытка
			Баркод  = Строка(ТабличныйДокумент.ПолучитьОбласть("R" + Формат(сч, "ЧГ=0;") + "C" + 2).ТекущаяОбласть.Текст);
			Артикул = Строка(ТабличныйДокумент.ПолучитьОбласть("R" + Формат(сч, "ЧГ=0;") + "C" + 3).ТекущаяОбласть.Текст);
			
			Если Баркод = "" И Артикул = "" Тогда
				Прервать;
			КонецЕсли;
			
			КоличествоЗаявлено  = Строка(ТабличныйДокумент.ПолучитьОбласть("R" + Формат(сч, "ЧГ=0;") + "C" + 5).ТекущаяОбласть.Текст);
			Количество  = Строка(ТабличныйДокумент.ПолучитьОбласть("R" + Формат(сч, "ЧГ=0;") + "C" + 6).ТекущаяОбласть.Текст);			
			
			НоваяСтрока 					= ДанныеАкта.Добавить();
			НоваяСтрока.Баркод 				= Баркод;    
			НоваяСтрока.Артикул 			= Артикул;
			НоваяСтрока.Количество 			= Количество;
			НоваяСтрока.КоличествоЗаявлено 	= КоличествоЗаявлено;
			
		Исключение
			ОбщегоНазначения.СообщитьПользователю("Не удалось загрузить строку " + Строка(сч)); 	
		КонецПопытки;
	КонецЦикла;
	
	Попытка
		УдалитьФайлы(Имя);
	Исключение
		ОбщегоНазначения.СообщитьПользователю(ПодробноеПредставлениеОшибки(ИнформацияОбОшибке())); 
	КонецПопытки;
	
	Если ДанныеАкта.Количество() = 0 Тогда
		ОбщегоНазначения.СообщитьПользователю("Выбран некорректный файл. Выберите акт приемкм товаров.");
		Возврат;
	КонецЕсли;
	
	НоменклатураКСозданию.Загрузить(ПолучитьСоответствияНоменклатуры(ДанныеАкта));	
	
КонецПроцедуры //- ИнфоСофт Стояк Ю.К. 14.11.2024 УА #70275

//+ ИнфоСофт Стояк Ю.К. 14.11.2024 УА #70275
&НаСервере
Процедура ЗаполнитьДанныеНаСервере(ДанныеФормы, Комиссия25)
		
	УстановитьПривилегированныйРежим(Истина);
	
	ФукнциональныеОпции = ИС_Ozon_Сервер.ПолучитьНастройкиФункциональностиСборочныхЗвданий(Профиль);
	Организация = ФукнциональныеОпции.Организация; 
	Партнер = ФукнциональныеОпции.ПартнерOzon; 
	Соглашение = ФукнциональныеОпции.СоглашениеOzon;
	Контрагент = ФукнциональныеОпции.КонтрагентOzon;
	Договор = ФукнциональныеОпции.ДоговорOzon;
	
	Если Не ЗначениеЗаполнено(Партнер) Тогда
		ТекстСообщения = СтрШаблон(
			"Не заполнен контрагент в настройках профиля для аккаунта: %1. Документ отчет комиссионера не создан.",
			Профиль);
		ОбщегоНазначения.СообщитьПользователю(ТекстСообщения);
		Возврат;
	КонецЕсли;

	ИспользоватьДоговорыСКлиентами = ПолучитьФункциональнуюОпцию("ИспользоватьДоговорыСКлиентами");

		Если ЗначениеЗаполнено(Договор) Тогда
			Если Не Общегоназначения.ЗначениеРеквизитаОбъекта(Договор, "ХозяйственнаяОперация") = ПредопределенноеЗначение("Перечисление.ХозяйственныеОперации.ПередачаНаКомиссию") Тогда
				ТекстСообщения = СтрШаблон(
					"В выбранный договор контрагента в настройках профиля для аккаунта: %1 имеет хозяйственную операцию отличающуюся от ""Передача на комиссию"". Документ отчет комиссионера не создан.",
					Профиль);
				ОбщегоНазначения.СообщитьПользователю(ТекстСообщения);
				Возврат;
			КонецЕсли;
				ХозОперация = Договор.ХозяйственнаяОперация;
		Иначе
			ТекстСообщения = СтрШаблон(
				"Не заполнен договор контрагента в настройках для аккаунта: %1. Документ отчет комиссионера не создан.",
				Профиль);
			ОбщегоНазначения.СообщитьПользователю(ТекстСообщения);
			Возврат;
		КонецЕсли;

	ИспользоватьСоглашенияСКлиентами = ПолучитьФункциональнуюОпцию("ИспользоватьСоглашенияСКлиентами");
	Если ИспользоватьСоглашенияСКлиентами Тогда
		Если ЗначениеЗаполнено(Соглашение) Тогда
			Если Не Общегоназначения.ЗначениеРеквизитаОбъекта(Соглашение, "ХозяйственнаяОперация") = ХозОперация Тогда
				ТекстСообщения = СтрШаблон(
					"В выбранное соглашение с клиентом в настройках профиля для аккаунта: %1 имеет хозяйственную операцию отличающуюся от ""Передача на комиссию"". Документ отчет комиссионера не создан.",
					Профиль);
				ОбщегоНазначения.СообщитьПользователю(ТекстСообщения);
				Возврат;
			КонецЕсли; 
			ХозОперация = Соглашение.ХозяйственнаяОперация;
		Иначе
			ТекстСообщения = СтрШаблон(
				"Не заполнено соглашение с клиентом в настройках профиля для аккаунта: %1. Документ отчет комиссионера не создан.",
				Профиль);
			ОбщегоНазначения.СообщитьПользователю(ТекстСообщения);
			Возврат;
		КонецЕсли;
	КонецЕсли;  
	
	Если Комиссия25 Тогда
		НовыйДокумент = ДанныеФормыВЗначение(ДанныеФормы, Тип("ДокументОбъект.ПередачаТоваровХранителю"));	
	Иначе	
		НовыйДокумент = ДанныеФормыВЗначение(ДанныеФормы, Тип("ДокументОбъект.РеализацияТоваровУслуг"));	
	КонецЕсли;
	
	НовыйДокумент.Дата = ТекущаяДатаСеанса();
	
	ДанныеЗаполнения = Новый Структура;
	ДанныеЗаполнения.Вставить("Организация", Организация);
	ДанныеЗаполнения.Вставить("Партнер", Партнер);
	ДанныеЗаполнения.Вставить("Контрагент", Контрагент);
	ДанныеЗаполнения.Вставить("Договор", Договор);
	ДанныеЗаполнения.Вставить("Соглашение", Соглашение);
	ДанныеЗаполнения.Вставить("ЗаполнятьПоСоглашению", Истина);

	НовыйДокумент.Заполнить(ДанныеЗаполнения);
	
	НовыйДокумент.Партнер 				= Партнер;
	НовыйДокумент.Контрагент 			= Контрагент;
	НовыйДокумент.Договор 	 			= Договор;
	НовыйДокумент.Соглашение 			= Соглашение; 

	Если Не Комиссия25 Тогда
		НовыйДокумент.ХозяйственнаяОперация = ХозОперация;
	Иначе
		НовыйДокумент.ХозяйственнаяОперация	= Перечисления.ХозяйственныеОперации.ПередачаНаКомиссию;		
	КонецЕсли;  
	
	ТаблицаТранзакций = ПолучитьСписокТоваров();
	
	ЗаполнитьТЧДокумента(НовыйДокумент, ТаблицаТранзакций);
	
	СтруктураДействий = Новый Структура;
	СтруктураДействий.Вставить("ПересчитатьКоличествоЕдиниц"); 
	
	Если Не Комиссия25 Тогда
		СтруктураДействий.Вставить("ЗаполнитьСтавкуНДС", Новый Структура("Организация, НалогообложениеНДС, Дата",
			НовыйДокумент.Организация, НовыйДокумент.НалогообложениеНДС, НовыйДокумент.Дата));
		СтруктураДействий.Вставить("ПересчитатьСуммуНДС",
			ОбработкаТабличнойЧастиКлиентСервер.ПараметрыПересчетаСуммыНДСВСтрокеТЧ(НовыйДокумент));
		СтруктураДействий.Вставить("ПересчитатьСумму");
		СтруктураДействий.Вставить("ПересчитатьСуммуСНДС", Новый Структура("ЦенаВключаетНДС",
			НовыйДокумент.ЦенаВключаетНДС));
	КонецЕсли;
	
	ОбработкаТабличнойЧастиСервер.ОбработатьТЧ(НовыйДокумент.Товары, СтруктураДействий, Неопределено);
	
	ЗначениеВДанныеФормы(НовыйДокумент, ДанныеФормы);
	
	УстановитьПривилегированныйРежим(Ложь);
	
КонецПроцедуры //- ИнфоСофт Стояк Ю.К. 14.11.2024 УА #70275

//+ ИнфоСофт Стояк Ю.К. 25.01.2024 УА #62645
&НаСервере
Функция СформироватьТабличныйДокументПервыйЭтап(Массив) 
	
	ТаблицаВыгрузки = Новый ТаблицаЗначений;
	
	ТаблицаВыгрузки.Колонки.Добавить("артикул", Новый ОписаниеТипов("Строка",,,,Новый КвалификаторыСтроки(50)));
	ТаблицаВыгрузки.Колонки.Добавить("имя_необязательно_", Новый ОписаниеТипов("Строка",,,,Новый КвалификаторыСтроки(150)), "имя (необязательно)"); 
	ТаблицаВыгрузки.Колонки.Добавить("количество", Новый ОписаниеТипов("число"));
		
	КоличествоНоменклатуры = 0;
	
	Для Каждого Документ Из Массив Цикл
		КоличествоНоменклатуры = КоличествоНоменклатуры + Документ.ИтогоНоменклатуры;
		Для Каждого Строка Из Документ.Товары Цикл
			СтрокаТЗ = ТаблицаВыгрузки.Добавить();
			СтрокаТЗ.артикул = Строка.Артикул;
			СтрокаТЗ.имя_необязательно_ = "";					
			СтрокаТЗ.количество = Строка.Количество;
		КонецЦикла;
	КонецЦикла;	                                     
	
	ТаблицаВыгрузки.Свернуть("артикул, имя_необязательно_", "количество");
		
	ТабДок = СформироватьТабличныйДокумент(ТаблицаВыгрузки);
	
	Возврат ТабДок
		
КонецФункции //- ИнфоСофт Стояк Ю.К. 25.01.2024 УА #62645

//+ ИнфоСофт Стояк Ю.К. 25.01.2024 УА #62645
&НаСервере
Функция СформироватьТабличныйДокумент(ТаблицаВыгрузки) 
	
	ТабличныйДокумент = Новый ТабличныйДокумент;
	
	Построитель = Новый ПостроительОтчета;
	Построитель.ИсточникДанных = Новый ОписаниеИсточникаДанных(ТаблицаВыгрузки); 
	Построитель.ВыводитьЗаголовокОтчета = Ложь;
	Построитель.Вывести(ТабличныйДокумент);

	ТабличныйДокумент.АвтоМасштаб = Истина;
	ТабличныйДокумент.УдалитьОбласть(ТабличныйДокумент.Область("R1C1:R" + Строка(КоличествоНоменклатуры + 2) + "C1"), ТипСмещенияТабличногоДокумента.ПоГоризонтали);
	ТабличныйДокумент.Область("R1C2:R1C2").Текст = "имя (необязательно)"; 
	ТабличныйДокумент.Область("R1C1:R" + Строка(КоличествоНоменклатуры + 1) + "C1").ШиринаКолонки = 20;
	ТабличныйДокумент.Область("R1C2:R" + Строка(КоличествоНоменклатуры + 1) + "C2").ШиринаКолонки = 20;
	ТабличныйДокумент.Область("R1C3:R" + Строка(КоличествоНоменклатуры + 1) + "C3").ШиринаКолонки = 20;
	
	Возврат ТабличныйДокумент;  
	
