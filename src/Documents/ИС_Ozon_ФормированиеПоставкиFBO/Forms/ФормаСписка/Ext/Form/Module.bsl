&НаСервере
Процедура ВыполнитьПроверкуАктаНаСервере()

	ФайлВременногоХранилища = ПолучитьИзВременногоХранилища(АдресОтчетаВоВременномХранилище);
	Имя = ПолучитьИмяВременногоФайла("xlsx");
	ФайлВременногоХранилища.Записать(Имя);  
	
	ТабличныйДокумент = Новый ТабличныйДокумент; 
	ТабличныйДокумент.Прочитать(Имя);
	
	КоличествоСтрок = ТабличныйДокумент.ВысотаТаблицы;
	
	ДанныеАкта = Новый ТаблицаЗначений;
	ДанныеАкта.Колонки.Добавить("Баркод", Новый ОписаниеТипов("Строка",,,Новый КвалификаторыСтроки(50)));
	ДанныеАкта.Колонки.Добавить("Артикул", Новый ОписаниеТипов("Строка",,,Новый КвалификаторыСтроки(50)));
	ДанныеАкта.Колонки.Добавить("Количество", Новый ОписаниеТипов("Число",,,Новый КвалификаторыЧисла(10)));
	ДанныеАкта.Колонки.Добавить("КоличествоЗаявлено", Новый ОписаниеТипов("Число",,,Новый КвалификаторыЧисла(10)));
	
	Для сч = 4 По КоличествоСтрок Цикл 	
		Попытка
			Баркод  = Строка(ТабличныйДокумент.ПолучитьОбласть("R" + Формат(сч, "ЧГ=0;") + "C" + 2).ТекущаяОбласть.Текст);
			Артикул = Строка(ТабличныйДокумент.ПолучитьОбласть("R" + Формат(сч, "ЧГ=0;") + "C" + 3).ТекущаяОбласть.Текст);
			
			Если Артикул = "" Тогда
				Прервать;
			КонецЕсли;
			
			КоличествоЗаявлено  = Строка(ТабличныйДокумент.ПолучитьОбласть("R" + Формат(сч, "ЧГ=0;") + "C" + 5).ТекущаяОбласть.Текст);
			Количество  = Строка(ТабличныйДокумент.ПолучитьОбласть("R" + Формат(сч, "ЧГ=0;") + "C" + 6).ТекущаяОбласть.Текст);			
			
			НоваяСтрока 					= ДанныеАкта.Добавить();
			НоваяСтрока.Баркод 				= Баркод;    
			НоваяСтрока.Артикул 			= Артикул;
			НоваяСтрока.Количество 			= Количество;
			НоваяСтрока.КоличествоЗаявлено 	= КоличествоЗаявлено;
			
		Исключение
			ОбщегоНазначения.СообщитьПользователю("Не удалось загрузить строку " + Строка(сч)); 	
		КонецПопытки;
	КонецЦикла;
	
	Попытка
		УдалитьФайлы(Имя);
	Исключение
		ОбщегоНазначения.СообщитьПользователю(ПодробноеПредставлениеОшибки(ИнформацияОбОшибке())); 
	КонецПопытки;
	
	Если ДанныеАкта.Количество() = 0 Тогда
		ОбщегоНазначения.СообщитьПользователю("Выбран некорректный файл. Выберите акт приемкм товаров.");
		Возврат;
	КонецЕсли;
	
	ДанныеАктаНоменклатура = ПолучитьСоответствияНоменклатуры(ДанныеАкта);
	
	ВыполнитьПроверкуНаНеизвестныеАртикулы(ДанныеАкта);
	
	ДанныеДокумента = ПолучитьДанныеДокумента();
	
	Если ДанныеДокумента.Количество() = 0 Тогда
		ОбщегоНазначения.СообщитьПользователю("Товары не найдены в документе. Проверьте выбранный документ.");
		Возврат;
	КонецЕсли;
	
	ВыполнитьСравнениеДанных(ДанныеАктаНоменклатура, ДанныеДокумента);
	
	Если Избыток.Количество() = 0 И Избыток.Количество() = 0 И НеНайденныеАртикулы.Количество() = 0 Тогда
		ОбщегоНазначения.СообщитьПользователю("Расхождений не найдено.");
		Возврат;
	КонецЕсли;
	
	Если Избыток.Количество() > 0 Тогда
		ОбщегоНазначения.СообщитьПользователю("Найдены товары отсутствующие в документе передачи.");
		Элементы.ГруппаИзбыток.Показать();
	КонецЕсли;
	
	Если Недостача.Количество() > 0 Тогда
		ОбщегоНазначения.СообщитьПользователю("Найдены товары отсутствующие в акте.");
		Элементы.ГруппаНедостача.Показать();
	КонецЕсли;
	
	Если НеНайденныеАртикулы.Количество() > 0 Тогда
		ОбщегоНазначения.СообщитьПользователю("Найдены не идентифицированные штрихкоды.");
		Элементы.ГруппаНеНайденныеАртикулы.Показать();
	КонецЕсли;
	
КонецПроцедуры //- ИнфоСофт Стояк Ю.К. 07.11.2024 УА #70275

//+ ИнфоСофт Стояк Ю.К. 07.11.2024 УА #70275
&НаСервере
Функция ПолучитьСоответствияНоменклатуры(ДанныеАкта) 
	
	Запрос = Новый Запрос("ВЫБРАТЬ
	                      |	ДанныеАкта.Баркод КАК Баркод,
	                      |	ДанныеАкта.Артикул КАК Артикул,
	                      |	ДанныеАкта.Количество КАК Количество,
