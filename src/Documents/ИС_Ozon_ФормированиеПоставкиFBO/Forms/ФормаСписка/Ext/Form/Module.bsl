//+ ИнфоСофт Стояк Ю.К. 05.09.2023 УА #70275
&НаСервере
Процедура ДобавитьСтрокуИзбыток(СтрокаАкта, Количество) 
	
	НоваяСтрока 					= Избыток.Добавить();
	НоваяСтрока.Номенклатура 		= СтрокаАкта.Номенклатура;
	НоваяСтрока.Характеристика 		= СтрокаАкта.Характеристика;
	Если Количество < 0 Тогда
		Количество = -Количество;
	КонецЕсли;	
	НоваяСтрока.Количество 			= Количество;
	
