&НаСервере
Процедура ВыполнитьСравнениеДанных(ДанныеАкта, ДанныеДокумента) 

	//Выполним поиск соответсвий данных документа к данным акта 
	ДанныеДокументаОбработка = ДанныеДокумента;	
	
	Для Каждого СтрокаАкта Из ДанныеАкта Цикл
		
		СоответствияНайдены = Ложь;	           
		
		МассивУдаляемыхСтрок = Новый Массив;  
		
		СтруктураПоиска = Новый Структура("Номенклатура, Характеристика", СтрокаАкта.Номенклатура, СтрокаАкта.Характеристика); 
		МассивНайденныхСтрок = ДанныеДокументаОбработка.НайтиСтроки(СтруктураПоиска);  
		
		Для Каждого Строка Из МассивНайденныхСтрок Цикл 
			
			СоответствияНайдены = Истина;
			
			Разница = СтрокаАкта.Количество - Строка.Количество;	
			
			Если Разница > 0 Тогда
				ДобавитьСтрокуИзбыток(СтрокаАкта, Разница);	
			ИначеЕсли Разница < 0 Тогда 
				ДобавитьСтрокуНедостача(СтрокаАкта, Разница);	
			КонецЕсли;  
			
			МассивУдаляемыхСтрок.Добавить(Строка);
			
		КонецЦикла;
		
		Для Каждого Строка Из МассивУдаляемыхСтрок Цикл
			ДанныеДокументаОбработка.Удалить(Строка);
		КонецЦикла;
			
		//Для Каждого СтрокаДокумента Из ДанныеДокументаОбработка Цикл  
		//	
		//	Если СтрокаАкта.Номенклатура = СтрокаДокумента.Номенклатура И СтрокаАкта.Характеристика = СтрокаДокумента.Характеристика Тогда
		//		Разница = СтрокаАкта.Количество - СтрокаДокумента.Количество;	
		//		
		//		Если Разница > 0 Тогда
		//			ДобавитьСтрокуИзбыток(СтрокаАкта, Разница);	
		//		ИначеЕсли Разница < 0 Тогда 
		//			ДобавитьСтрокуНедостача(СтрокаАкта, Разница);	
		//		КонецЕсли;
		//		
		//		
		//		//ДанныеДокументаОбработка.Удалить(СтрокаДокумента); 
		//		
		//		СоответствияНайдены = Истина;
		//		
		//	КонецЕсли;  
		//	
		//КонецЦикла;
		
		
		
		Если Не СоответствияНайдены И ЗначениеЗаполнено(СтрокаАкта.Номенклатура) Тогда
			ДобавитьСтрокуИзбыток(СтрокаАкта, СтрокаАкта.Количество);	
		КонецЕсли;
		
	КонецЦикла;		
	
	//Выполним поиск соответсвий данных акта к данным документа
	ДанныеАктаОбработка = ДанныеАкта; 
	
	Для Каждого СтрокаДокумента Из ДанныеДокумента Цикл
				 	
		СоответствияНайдены = Ложь;	
		
		МассивУдаляемыхСтрок = Новый Массив;  
		
		СтруктураПоиска = Новый Структура("Номенклатура, Характеристика", СтрокаДокумента.Номенклатура, СтрокаДокумента.Характеристика); 
		МассивНайденныхСтрок = ДанныеАктаОбработка.НайтиСтроки(СтруктураПоиска);  
		
		Для Каждого Строка Из МассивНайденныхСтрок Цикл 			
			СоответствияНайдены = Истина;			
			МассивУдаляемыхСтрок.Добавить(Строка);			
		КонецЦикла;
		
		Для Каждого Строка Из МассивУдаляемыхСтрок Цикл
			ДанныеДокументаОбработка.Удалить(Строка);
		КонецЦикла;
		
		Если Не СоответствияНайдены И ЗначениеЗаполнено(СтрокаДокумента.Номенклатура) Тогда
			ДобавитьСтрокуНедостача(СтрокаДокумента, СтрокаДокумента.Количество);	
		КонецЕсли;
		
	КонецЦикла;
		
