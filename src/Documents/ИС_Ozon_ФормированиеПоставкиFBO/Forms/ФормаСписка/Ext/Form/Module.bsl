//+ ИнфоСофт Стояк Ю.К. 05.09.2023 УА #70275
&НаСервере
Функция ПолучитьДанныеДокумента() 
	
	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	ТоварыТЧ.Номенклатура КАК Номенклатура,
	|	ТоварыТЧ.Характеристика КАК Характеристика,
	|	СУММА(ТоварыТЧ.Количество) КАК Количество
	|ИЗ
	|	Документ.РасходнаяНакладная.Запасы КАК ТоварыТЧ
	|ГДЕ
	|	ТоварыТЧ.Ссылка = &Ссылка
	|
	|СГРУППИРОВАТЬ ПО
	|	ТоварыТЧ.Номенклатура,
	|	ТоварыТЧ.Характеристика
	|
	|УПОРЯДОЧИТЬ ПО
	|	Номенклатура,
	|	Характеристика"); 
	
	
	Запрос.УстановитьПараметр("Ссылка", ДокументПередачиТоваровНаКомиссиию);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Выборка = РезультатЗапроса.Выбрать();
	
	ДанныеДокумента = Новый ТаблицаЗначений;	
	ДанныеДокумента.Колонки.Добавить("Количество", Новый ОписаниеТипов("Число",,,Новый КвалификаторыЧисла(10)));
	ДанныеДокумента.Колонки.Добавить("Номенклатура", Новый ОписаниеТипов("СправочникСсылка.Номенклатура"));
	ДанныеДокумента.Колонки.Добавить("Характеристика", Новый ОписаниеТипов("СправочникСсылка.ХарактеристикиНоменклатуры"));
	
	Пока Выборка.Следующий() Цикл
		НоваяСтрока					= ДанныеДокумента.Добавить();
		НоваяСтрока.Количество 		= Выборка.Количество;
		НоваяСтрока.Номенклатура 	= Выборка.Номенклатура;
		НоваяСтрока.Характеристика	= Выборка.Характеристика;
	КонецЦикла;
	
	Возврат ДанныеДокумента;
		
КонецФункции //- ИнфоСофт Стояк Ю.К. 05.09.2023 УА #70275

