&НаСервере
Функция ПолучитьЗначениеПараметра()
	
	МассивНаименованийПараметров = Новый Массив;  	
	МассивНаименованийПараметров.Добавить("ПроигрыватьЗвукиПриСканировании");
		
	Настройки = ИС_МП_Сервер.ПолучитьЗначениеНастроек(Объект.Профиль, Перечисления.ИС_МП_Маркетплейсы.ВБ, МассивНаименованийПараметров);
	
	//+ ИнфоСофт Власова И.С. 04.02.25 УА #92991
	//Если Настройки.Свойство("ПроигрыватьЗвукиПриСканировании") Тогда
	Если Настройки.Свойство("ПроигрыватьЗвукиПриСканировании") И Не Настройки.ПроигрыватьЗвукиПриСканировании = Неопределено Тогда
	//- ИнфоСофт Власова И.С. 04.02.25 УА #92991
		Возврат Настройки.ПроигрыватьЗвукиПриСканировании;
	Иначе
		Возврат Ложь;
	КонецЕсли;	
	
КонецФункции //- ИнфоСофт Янгиров Р.Р. 14.11.2024 УА #86762


//+ ИнфоСофт Янгиров Р.Р. 20.11.2024 УА #86762 
//Реализован функционал воспроизведения дополнительного звука при сканировании товаров в документе "УпаковкаТоваров"
&НаКлиенте
Процедура ПроигратьЗвук(ИмяФайла) 
	
	СистемнаяИнформация = Новый СистемнаяИнформация;
	
	//+ ИнфоСофт Власова И.С. 27.01.25 УА #91984
	//Если Не СистемнаяИнформация.ТипПлатформы = ТипПлатформы.Windows_x86 
	//	Или Не СистемнаяИнформация.ТипПлатформы = ТипПлатформы.Windows_x86_64 Тогда
	//	Возврат;
	//КонецЕсли;
	
	Если Не СистемнаяИнформация.ТипПлатформы = ТипПлатформы.Windows_x86 
		И Не СистемнаяИнформация.ТипПлатформы = ТипПлатформы.Windows_x86_64 Тогда
		Возврат;
	КонецЕсли;
	//- ИнфоСофт Власова И.С. 27.01.25 УА #91984
	
	Константа = ПолучитьЗначениеПараметра(); 
	
	Если Константа Тогда  
		oVoice = Новый COMObject("SAPI.SpVoice");
		oSpFileStream = Новый COMObject("SAPI.SpFileStream");
		oSpFileStream.Open(ИмяФайла);
		oVoice.SpeakStream(oSpFileStream);
		oSpFileStream.Close();
	Иначе
		Возврат;	
	КонецЕсли;
	
КонецПроцедуры //- ИнфоСофт Янгиров Р.Р. 20.11.2024 УА #86762

