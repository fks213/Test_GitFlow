	|	МАКСИМУМ(ИС_WB_СоответствиеРазмеров.Номенклатура) КАК Номенклатура,
	|	МАКСИМУМ(ИС_WB_СоответствиеРазмеров.Характеристика) КАК Характеристика	
	|ПОМЕСТИТЬ ВТ_Номенклатура
	|ИЗ
	|	ВТ_СборочныеЗадания КАК ВТ_СборочныеЗадания
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ИС_WB_СоответствиеРазмеров КАК ИС_WB_СоответствиеРазмеров
	|		ПО ВТ_СборочныеЗадания.СборочноеЗаданиеРазмерWB = ИС_WB_СоответствиеРазмеров.РазмерWB
	|
	|СГРУППИРОВАТЬ ПО
	|	ВТ_СборочныеЗадания.СборочноеЗадание
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_СборочныеЗадания.СборочноеЗадание КАК Заказ,
	|	ВТ_СборочныеЗадания.СборочноеЗадание.Номер КАК НомерОтправления,
	|	ВТ_Номенклатура.Номенклатура КАК Номенклатура,
	|	ВТ_Номенклатура.Характеристика КАК Характеристика,
	//+ ИнфоСофт Заварин К.В. 22.02.25 УА #73904
	|	ВЫБОР
	|		КОГДА ВТ_Номенклатура.Номенклатура.ВидНоменклатуры.ОсобенностьУчета <> ЗНАЧЕНИЕ(Перечисление.ОсобенностиУчетаНоменклатуры.БезОсобенностейУчета)
	|			ТОГДА ИСТИНА
	|		ИНАЧЕ ЛОЖЬ
	|	КОНЕЦ КАК МаркируемыйТовар,
	|	ВЫБОР
	|		КОГДА ИС_MP_ДанныеВыгрузкиКИЗов.КоличествоВыгруженныхТоваров >= 1
	|			ТОГДА ИСТИНА
	|		ИНАЧЕ ЛОЖЬ
	|	КОНЕЦ КАК МаркировкаПередана,
	//- ИнфоСофт Заварин К.В. 22.02.25 УА #73904
	|	ВТ_СборочныеЗадания.ДанныеQR КАК ДанныеQR,
	|	ВТ_СборочныеЗадания.СтатусWB КАК СтатусWB
	|ИЗ
	|	ВТ_СборочныеЗадания КАК ВТ_СборочныеЗадания
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_Номенклатура КАК ВТ_Номенклатура
	//+ ИнфоСофт Заварин К.В. 22.02.25 УА #73904
	|			ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ИС_MP_ДанныеВыгрузкиКИЗов КАК ИС_MP_ДанныеВыгрузкиКИЗов
	|			ПО ВТ_Номенклатура.Номенклатура = ИС_MP_ДанныеВыгрузкиКИЗов.Номенклатура
	|				И ВТ_Номенклатура.Характеристика = ИС_MP_ДанныеВыгрузкиКИЗов.Характеристика
	|				И ВТ_Номенклатура.СборочноеЗадание = ИС_MP_ДанныеВыгрузкиКИЗов.ЗаказМП
	//- ИнфоСофт Заварин К.В. 22.02.25 УА #73904
	|		ПО ВТ_СборочныеЗадания.СборочноеЗадание = ВТ_Номенклатура.СборочноеЗадание";
	
	Запрос.УстановитьПараметр("Поставка", Объект.Поставка);
	
	РезультатЗапроса = Запрос.Выполнить();
	                                              	
	Выборка = РезультатЗапроса.Выбрать();
	
	Пока Выборка.Следующий() Цикл 
		
		Отбор = Новый Структура("Заказ", Выборка.Заказ);
		НайденныеСтроки = Объект.Товары.НайтиСтроки(Отбор);
		
		Если НайденныеСтроки.Количество() = 0 Тогда
			СтрокаТЗ = Объект.Товары.Добавить();
			СтрокаТЗ.КоличествоЗаказ = 1;
			ЗаполнитьЗначенияСвойств(СтрокаТЗ, Выборка);
		Иначе
			НайденныеСтроки[0].СтатусWB = Выборка.СтатусWB;
			НайденныеСтроки[0].ДанныеQR = Выборка.ДанныеQR;
			НайденныеСтроки[0].Номенклатура = Выборка.Номенклатура;
			НайденныеСтроки[0].Характеристика = Выборка.Характеристика;
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры //- ИнфоСофт Стояк Ю.К. 30.07.2024 УА #76396

//+ ИнфоСофт Стояк Ю.К. 30.07.2024 УА #76396
&НаСервере
Процедура ВыполнитьНастройкуТабличногоДокумента(Этикетка, НастройкиПечати)
	
	Этикетка.ИмяПринтера = НастройкиПечати.ИмяПринтера; 
	Этикетка.ПолеСлева = НастройкиПечати.Слева;
	Этикетка.ПолеСправа = НастройкиПечати.Справа;
	Этикетка.ПолеСнизу = НастройкиПечати.Снизу;
	Этикетка.ПолеСверху = НастройкиПечати.Сверху;	
	Этикетка.РазмерКолонтитулаСверху = НастройкиПечати.КолонтитулыСверху;
	Этикетка.РазмерКолонтитулаСнизу = НастройкиПечати.КолонтитулыСнизу; 
	Этикетка.ЭкземпляровНаСтранице = НастройкиПечати.ЭкземпляровНаСтраницу; 
	
	Если НастройкиПечати.ОриентацияСтраницы = 0 Тогда 
		Этикетка.ОриентацияСтраницы = ОриентацияСтраницы.Портрет;
	Иначе 
		Этикетка.ОриентацияСтраницы = ОриентацияСтраницы.Ландшафт;
	КонецЕсли;
	
	//+ ИнфоСофт Заварин К.В. 03.12.24 УА #72698
	Если НастройкиПечати.Масштаб = 0 Тогда 
		Этикетка.АвтоМасштаб = Истина;
	Иначе 
		Этикетка.АвтоМасштаб = Ложь;
		Этикетка.МасштабПечати = НастройкиПечати.МасштабЗначение;	
	КонецЕсли;
	//- ИнфоСофт Заварин К.В. 03.12.24 УА #72698
	
КонецПроцедуры //- ИнфоСофт Стояк Ю.К. 30.07.2024 УА #76396

