
#Область ОбработчикиСобытийФормы   

//+ ИнфоСофт Стояк Ю.К 22.07.24 УА #76396
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Если Параметры.Ключ.Пустая() Тогда
		
		Если Параметры.Свойство("Профиль") Тогда	
			Объект.Профиль = Параметры.Профиль;
		КонецЕсли;
				
		Объект.Ответственный = Пользователи.ТекущийПользователь();
		
	КонецЕсли;
	
	УстановитьЗначенияПоУмолчанию();     
	
	Если ЗначениеЗаполнено(Объект.Поставка) Тогда
		//+ ИнфоСофт Стояк Ю.К. 16.08.2024 УА #81970		
		ЗаполнитьДанныеСборкиНаСервере(Истина);          
		//ЗаполнитьДанныеСборкиНаСервере();          
		//- ИнфоСофт Стояк Ю.К. 16.08.2024 УА #81970
		ЭтотОбъект.Записать();		
	КонецЕсли;
	
	ОбщегоНазначенияУТ.НастроитьПодключаемоеОборудование(ЭтаФорма);
	
КонецПроцедуры //- ИнфоСофт Стояк Ю.К 22.07.24 УА #76396

//+ ИнфоСофт Стояк Ю.К 22.07.24 УА #76396
&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	ЭтаФорма.ИспользоватьПодключаемоеОборудование = Истина;
	МенеджерОборудованияКлиент.НачатьПодключениеОборудованиеПриОткрытииФормы(Неопределено, ЭтаФорма, "СканерШтрихкода");
	
КонецПроцедуры //- ИнфоСофт Стояк Ю.К 22.07.24 УА #76396

//+ ИнфоСофт Стояк Ю.К 22.07.24 УА #76396
&НаКлиенте
Процедура ПриЗакрытии(ЗавершениеРаботы)
	
	МенеджерОборудованияКлиент.НачатьОтключениеОборудованиеПриЗакрытииФормы(Неопределено, ЭтаФорма);
	
КонецПроцедуры //- ИнфоСофт Стояк Ю.К 22.07.24 УА #76396

//+ ИнфоСофт Стояк Ю.К 22.07.24 УА #76396
&НаКлиенте
Процедура ОбработкаОповещения(ИмяСобытия, Параметр, Источник)
	
	Если Источник = "ПодключаемоеОборудование" И ВводДоступен() Тогда
		Если ИмяСобытия = "ScanData" И МенеджерОборудованияУТКлиент.ЕстьНеобработанноеСобытие() Тогда
			СтруктураШтрихкод = МенеджерОборудованияУТКлиент.ПреобразоватьДанныеСоСканераВСтруктуру(Параметр);
			ОбработатьШтрихкоды(СтруктураШтрихкод.Штрихкод);
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры //- ИнфоСофт Стояк Ю.К 22.07.24 УА #76396

//+ ИнфоСофт Стояк Ю.К. 30.07.2024 УА #76396
&НаКлиенте
Процедура ПоставкаПриИзменении(Элемент)
	
	Если Объект.Товары.Количество() > 0 Тогда
		Оповещение = Новый ОписаниеОповещения("ПоказатьВопросЗавершениеИзмененияПоставки", ЭтотОбъект);
		ТекстВопроса = "Изменить поставку, данные будут утеряны?";
		ПоказатьВопрос(Оповещение, ТекстВопроса, РежимДиалогаВопрос.ДаНетОтмена, 20, КодВозвратаДиалога.Нет,, КодВозвратаДиалога.Нет);
	Иначе
		ЗаполнитьДанныеСборкиНаСервере();
	КонецЕсли;
	
	УстановитьЗначенияПоУмолчанию()
	
КонецПроцедуры //- ИнфоСофт Стояк Ю.К. 30.07.2024 УА #76396

//+ ИнфоСофт Стояк Ю.К. 31.07.2024 УА #76396
&НаКлиенте
Процедура ОбновитьДанныеПоЗаказам(Команда)  
	
	Если Модифицированность Тогда
		Оповещение = Новый ОписаниеОповещения("ПоказатьВопросЗавершениеИзмененияПоставки", ЭтотОбъект);
		ТекстВопроса = "Обновить данные по заказам в поставке? Несохранённые данные в табличной части будут утеряны?";
		ПоказатьВопрос(Оповещение, ТекстВопроса, РежимДиалогаВопрос.ДаНетОтмена, 20, КодВозвратаДиалога.Нет,, КодВозвратаДиалога.Нет);
	Иначе
		ЭтотОбъект.Записать();
		//+ ИнфоСофт Стояк Ю.К. 16.08.2024 УА #81970		
		ЗаполнитьДанныеСборкиНаСервере(Истина);          
		//ЗаполнитьДанныеСборкиНаСервере();          
		//- ИнфоСофт Стояк Ю.К. 16.08.2024 УА #81970
	КонецЕсли;
	
КонецПроцедуры //- ИнфоСофт Стояк Ю.К. 31.07.2024 УА #76396

#КонецОбласти 

