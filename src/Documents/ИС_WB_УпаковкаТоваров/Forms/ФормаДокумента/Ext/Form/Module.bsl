//+ ИнфоСофт Мурсалимов Д.Р. 28.06.24 УА #77997
&НаКлиенте
Процедура ОбработатьШтрихкодыЗавершение(Результат, Параметры) Экспорт 	
	ВыполнитьПроверкуНаПечать(Результат);	
КонецПроцедуры //- ИнфоСофт Мурсалимов Д.Р. 28.06.24 УА #77997

//+ ИнфоСофт Мурсалимов Д.Р. 28.06.24 УА #77997
&НаКлиенте
Процедура ОбработатьШтрихкоды(Штрихкод)
	
	ОчиститьСообщения();
	
	ДанныеШтрихкода = Новый Структура; 
	
	ДанныеШтрихкода.Вставить("ФорматBase64", Ложь); 
	ДанныеШтрихкода.Вставить("Штрихкод", СокрЛП(Штрихкод));
	ДанныеШтрихкода.Вставить("Количество", 1);   	
	
	//+ ИнфоСофт Стояк Ю.К. 16.08.2024 УА #81842
	ИС_MP_МаркировкаКлиентСервер.ЗакодироватьШтрихкодДанныхBase64(ДанныеШтрихкода); 
	//- ИнфоСофт Стояк Ю.К. 16.08.2024 УА #81842
	//+ ИнфоСофт Стояк Ю.К. 13.08.2024 УА #81686	
	ПараметрыСканирования = ИС_MP_МаркировкаКлиент.ПараметрыСканирования(ЭтаФорма);  
	
	//+ ИнфоСофт Заварин К.В. 13.03.25 УА #96054
	ПараметрыСканирования.Вставить("ТребуетсяПроверкаСредствамиККТ", Ложь);
	//- ИнфоСофт Заварин К.В. 13.03.25 УА #96054
	
	РезультатОбработкиШтрихкода = ОбработатьШтрихкод(ДанныеШтрихкода, ПараметрыСканирования);
	
	ВыполнитьПроверкуНаПечать(РезультатОбработкиШтрихкода);
			                                                  
	//ИС_MP_МаркировкаКлиент.ОбработатьДанныеШтрихкода("ОбработатьШтрихкодыЗавершение", ЭтаФорма, ДанныеШтрихкода, ПараметрыСканирования);
	//- ИнфоСофт Стояк Ю.К. 13.08.2024 УА #81686
				
КонецПроцедуры //- ИнфоСофт Мурсалимов Д.Р. 28.06.24 УА #77997

//+ ИнфоСофт Стояк Ю.К 22.07.24 УА #76396
&НаКлиенте
Процедура ПоискПоШтрихкодуЗавершение(Данные, ДополнительныеПараметры) Экспорт
	
	Если Данные.Штрихкод <> "" Тогда
		ОбработатьШтрихкоды(СокрЛП(Данные.Штрихкод));
	КонецЕсли;
	
КонецПроцедуры //- ИнфоСофт Стояк Ю.К 22.07.24 УА #76396

//+ ИнфоСофт Стояк Ю.К 22.07.24 УА #76396
&НаСервере
Процедура УстановитьЗначенияПоУмолчанию()

	Для Каждого Строка Из Объект.Товары Цикл
		Если Строка.СтатусСборки = Перечисления.ИС_MP_СтатусыСборки.ПустаяСсылка() Тогда
			Строка.СтатусСборки = Перечисления.ИС_MP_СтатусыСборки.ОжидаетСборки;
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры
	
//+ ИнфоСофт Стояк Ю.К 22.07.24 УА #76396
&НаКлиенте
Процедура ВыполнитьПроверкуНаПечать(РезультатОбработкиШтрихкода)
	
	//+ ИнфоСофт Стояк Ю.К. 13.08.2024 УА #81686
	//ДанныеШтрихкода = РезультатОбработкиШтрихкода;
	ДанныеШтрихкода = РезультатОбработкиШтрихкода.ДанныеШтрихкода;
	//- ИнфоСофт Стояк Ю.К. 13.08.2024 УА #81686	
	
	РезультатРазбора = РазборКодаМаркировкиНаСервере(ДанныеШтрихкода.НормализованныйШтрихкод);
	
	Если РезультатРазбора <> Неопределено Тогда
		ДанныеШтрихкодаУпаковки = ПолучитьДанныеШтрихкодаУпаковки(РезультатРазбора);
		ДанныеШтрихкода = ДанныеШтрихкодаУпаковки;
	Иначе
		ДанныеШтрихкодаУпаковки = Неопределено;
	КонецЕсли;
	
	Если ДанныеШтрихкодаУпаковки = Неопределено И Не ЗначениеЗаполнено(ДанныеШтрихкода.Номенклатура) Тогда
		//+ ИнфоСофт Янгиров Р.Р. 20.11.2024 УА #86762
		ЗвукШтрихкодОтстутствуетВБазе();
		//- ИнфоСофт Янгиров Р.Р. 20.11.2024 УА #86762
		ОбщегоНазначенияКлиент.СообщитьПользователю("Не найдены данные по коду " + ДанныеШтрихкода.Штрихкод);
		Возврат;		
	КонецЕсли;	
	
	ТекущийЗаказ = Неопределено;
	СтрокаДанныеСборки = Неопределено;   
	
	Для Каждого Заказ Из Объект.Товары Цикл
		
		//+ ИнфоСофт Стояк Ю.К. 12.08.2024 УА #81140
		Если Заказ.СтатусWB = ПредопределенноеЗначение("Перечисление.ИС_WB_СтатусыСборочныхЗаданийВСистемеWildBerries.canceled") Или
			Заказ.СтатусWB = ПредопределенноеЗначение("Перечисление.ИС_WB_СтатусыСборочныхЗаданийВСистемеWildBerries.canceled_by_client") Или
			Заказ.СтатусWB = ПредопределенноеЗначение("Перечисление.ИС_WB_СтатусыСборочныхЗаданийВСистемеWildBerries.declined_by_client") Тогда
			Продолжить;
		КонецЕсли;
		//- ИнфоСофт Стояк Ю.К. 12.08.2024 УА #81140
		
		Если Заказ.Номенклатура = ДанныеШтрихкода.Номенклатура И Заказ.Характеристика = ДанныеШтрихкода.Характеристика И Не Заказ.ЭтикеткаРаспечатана Тогда
			
			ТекущийЗаказ = Заказ;						
			Прервать;
			
		КонецЕсли;
		
		Если ТекущийЗаказ <> Неопределено Тогда
			Прервать;
		КонецЕсли;		
		
	КонецЦикла;	
	
	Если ТекущийЗаказ = Неопределено Тогда
		//+ ИнфоСофт Янгиров Р.Р. 20.11.2024 УА #86762 	 
		ЗвукТоварОтсутствуетВЗаказе();
		//- ИнфоСофт Янгиров Р.Р. 20.11.2024 УА #86762
		ОбщегоНазначенияКлиент.СообщитьПользователю("По отсканированному штрихкоду не найдено доступного заказа для печати этикетки.");
		Возврат;                                                                                                                       
		//+ ИнфоСофт Янгиров Р.Р. 20.11.2024 УА #86762
	Иначе		
		ЗвукТоварНайден();
		//- ИнфоСофт Янгиров Р.Р. 20.11.2024 УА #86762
	КонецЕсли;	
	
	ЭтикеткаРаспечатана = Ложь;
	
	ТекущийЗаказ.КоличествоФакт = ТекущийЗаказ.КоличествоФакт + 1;
	ТекущийЗаказ.ШтрихкодУпаковки = ДанныеШтрихкода.ШтрихкодУпаковки;
	//+ ИнфоСофт Стояк Ю.К. 13.08.2024 УА #81686	
	ТекущийЗаказ.Штрихкод = РезультатОбработкиШтрихкода.ДанныеШтрихкода.Штрихкод;
	//- ИнфоСофт Стояк Ю.К. 13.08.2024 УА #81686
	//+ ИнфоСофт Стояк Ю.К. 09.03.2025 УА #95710
	ТекущийЗаказ.КИЗ = ДанныеШтрихкода.НормализованныйШтрихкод;
	//- ИнфоСофт Стояк Ю.К. 09.03.2025 УА #95710
	
	//+ ИнфоСофт Стояк Ю.К. 13.08.2024 УА #81140
	Если ДобавлятьСканируемыйКИЗВСвязаннуюРТУ Тогда
		ДобавитьКИЗВРТУ(ТекущийЗаказ.Заказ, ТекущийЗаказ.ШтрихкодУпаковки);
	КонецЕсли;
	//- ИнфоСофт Стояк Ю.К. 13.08.2024 УА #81140
	
	//Если РезультатРазбора <> Неопределено Тогда
	//	ТекущийЗаказ.КИЗ = ДанныеШтрихкода.КИЗ;			
	//КонецЕсли;
	
	Если ТекущийЗаказ.КоличествоФакт = ТекущийЗаказ.КоличествоЗаказ Тогда		
							
		Попытка
			
			ВыполнитьПечатьЭтикетки(ТекущийЗаказ); 				
			ТекущийЗаказ.ЭтикеткаРаспечатана = ЭтикеткаРаспечатана; 			
			//+ ИнфоСофт Стояк Ю.К. 13.08.2024 УА #81686
			ТекущийЗаказ.СтатусСборки = ПредопределенноеЗначение("Перечисление.ИС_MP_СтатусыСборки.Собран");
			//- ИнфоСофт Стояк Ю.К. 13.08.2024 УА #81686
			
		Исключение
			ОбщегоНазначенияКлиент.СообщитьПользователю(ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		КонецПопытки; 
		
	КонецЕсли;
	
КонецПроцедуры //- ИнфоСофт Стояк Ю.К 22.07.24 УА #76396

//+ ИнфоСофт Стояк Ю.К 22.07.24 УА #76396
&НаКлиенте
Процедура ВыполнитьПечатьЭтикетки(СтрокаДанныеСборки) 
	
	Если Объект.ПечататьЭтикеткиЗаказа Тогда
		ЭтикеткаЗаказа = ПолучитьЭтикеткиНаСервере(СтрокаДанныеСборки.Заказ);
						
		Если ЗначениеЗаполнено(Объект.НастройкаПечатиЭтикеток) Тогда 		
			ВыполнитьНастройкуТабличногоДокумента(ЭтикеткаЗаказа, Объект.НастройкаПечатиЭтикеток);			
		КонецЕсли;
		
		ЭтикеткаЗаказа.Напечатать(); 
						
	КонецЕсли; 
	
	Если Объект.ПечататьШтрихкоды Тогда
		//+ ИнфоСофт Стояк Ю.К. 15.04.2025 УА #98648		
		//ЭтикеткаШтрихкода = ПолучитьШтрихкодовНаСервере(СтрокаДанныеСборки.Заказ);  
		//				
		//Если ЗначениеЗаполнено(Объект.НастройкиПечатиШтрихкодов) Тогда 	
		//	ВыполнитьНастройкуТабличногоДокумента(ЭтикеткаШтрихкода, Объект.НастройкиПечатиШтрихкодов);	
		//КонецЕсли;
		//
		//ЭтикеткаШтрихкода.Напечатать();
		
		Если ЗначениеЗаполнено(Объект.НастройкиПечатиШтрихкодов) Тогда
			//+ УТ
			КоличествоКопий = ОбщегоНазначенияУТВызовСервера.ЗначениеРеквизитаОбъекта(Объект.НастройкиПечатиШтрихкодов, "КоличествоКопий");
			//- УТ
			Для СЧ = 1 По КоличествоКопий Цикл
				ЭтикеткаШтрихкода = ПолучитьШтрихкодовНаСервере(СтрокаДанныеСборки.Заказ);
				ВыполнитьНастройкуТабличногоДокумента(ЭтикеткаШтрихкода, Объект.НастройкиПечатиШтрихкодов);
				ЭтикеткаШтрихкода.Напечатать();	
			КонецЦикла;
		Иначе
			ЭтикеткаШтрихкода = ПолучитьШтрихкодовНаСервере(СтрокаДанныеСборки.Заказ);
			ЭтикеткаШтрихкода.Напечатать();
		КонецЕсли; 
		//- ИнфоСофт Стояк Ю.К. 15.04.2025 УА #98648
		
	КонецЕсли;
	
	ЭтикеткаРаспечатана = Истина;
	
КонецПроцедуры //- ИнфоСофт Стояк Ю.К 22.07.24 УА #76396

//+ ИнфоСофт Стояк Ю.К 22.07.24 УА #76396
&НаСервере
Функция ПолучитьЭтикеткиНаСервере(СборочноеЗадание)

	Табдок = Новый ТабличныйДокумент;
	
	Табдок.ИмяПараметровПечати = "ИС_WB_ПечатьЭтикеток";
	ТабДок.ОриентацияСтраницы = ОриентацияСтраницы.Портрет;
	ТабДок.АвтоМасштаб = Истина;
	
	МакетОбработки = УправлениеПечатью.МакетПечатнойФормы("Документ.ИС_WB_СборочноеЗадание.ПФ_MXL_QR58х40");
			
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ИС_WB_СтатусыИЭтикеткиСборочныхЗаданий.СборочноеЗадание.Номер КАК СборочноеЗаданиеНомер,
	|	ИС_WB_СтатусыИЭтикеткиСборочныхЗаданий.Этикетка КАК Этикетка,
	|	ИС_WB_СтатусыИЭтикеткиСборочныхЗаданий.СборочноеЗадание.НоменклатураWB.vendorCode КАК СборочноеЗаданиеНоменклатураWBvendorCode,
	|	ИС_WB_СтатусыИЭтикеткиСборочныхЗаданий.СборочноеЗадание.НоменклатураWB.Наименование КАК СборочноеЗаданиеНоменклатураWBНаименование,
	|	ИС_WB_СтатусыИЭтикеткиСборочныхЗаданий.СборочноеЗадание.НоменклатураWB.Код КАК СборочноеЗаданиеНоменклатураWBКод
	|ИЗ
	|	РегистрСведений.ИС_WB_СтатусыИЭтикеткиСборочныхЗаданий КАК ИС_WB_СтатусыИЭтикеткиСборочныхЗаданий
	|ГДЕ
	|	ИС_WB_СтатусыИЭтикеткиСборочныхЗаданий.СборочноеЗадание В(&МассивСсылок)";
	
	Запрос.Текст = СтрШаблон(Запрос.Текст);
	
	Запрос.УстановитьПараметр("МассивСсылок", СборочноеЗадание); 
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Если РезультатЗапроса.Пустой() Тогда
		ОбщегоНазначения.СообщитьПользователю("Не удалось сформировать этикетки WildBerries");
		Возврат Табдок;	
	КонецЕсли;
		
	ОбластьЭтикетка = МакетОбработки.ПолучитьОбласть("Этикетка");
						
	Выборка = РезультатЗапроса.Выбрать();
	
	Первый = Истина;	
	Пока Выборка.Следующий() Цикл  
				
		ОбластьЭтикетка.Рисунки.КартинкаQR.Картинка = Новый Картинка(Выборка.Этикетка.Получить()); 
		
		Если Не Первый Тогда
			Табдок.ВывестиГоризонтальныйРазделительСтраниц();
		КонецЕсли;
		
		Первый = Ложь;
			
		Табдок.Вывести(ОбластьЭтикетка);
			
	КонецЦикла;    
			
	Возврат Табдок;
	
КонецФункции //- ИнфоСофт Стояк Ю.К 22.07.24 УА #76396

//+ ИнфоСофт Стояк Ю.К. 30.07.2024 УА #76396
&НаСервере
Функция ПолучитьШтрихкодовНаСервере(СборочноеЗадание)
	
	Табдок = Новый ТабличныйДокумент;
	
	Табдок.ИмяПараметровПечати = "ИС_WB_ПечатьШтрихкодов";
	ТабДок.ОриентацияСтраницы = ОриентацияСтраницы.Портрет;
	ТабДок.АвтоМасштаб = Истина;
	
	МакетОбработки = УправлениеПечатью.МакетПечатнойФормы("Документ.ИС_WB_СборочноеЗадание.ПФ_MXL_Штрихкод58х40");
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	ИС_WB_ХарактеристикиКатегорий.Ссылка КАК Ссылка
	|ПОМЕСТИТЬ ВТ_Цвет
	|ИЗ
	|	Справочник.ИС_WB_ХарактеристикиКатегорий КАК ИС_WB_ХарактеристикиКатегорий
	|ГДЕ
	|	ИС_WB_ХарактеристикиКатегорий.Наименование = ""Цвет""
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ИС_WB_СборочноеЗадание.Номер КАК НомерЗаказаСМаркетплейса,
	|	ИС_WB_СборочноеЗадание.НоменклатураWB.Код КАК КодНоменклатурыСМаркетплейса,
	|	ИС_WB_СборочноеЗадание.НоменклатураWB.vendorCode КАК АртикулПоставщикаНоменклатурыСМаркетплейса,
	|	ИС_WB_СборочноеЗадание.РазмерWB.techSize КАК РазмерСВБ,
	|	МАКСИМУМ(ЕСТЬNULL(ИС_WB_НоменклатураХарактеристикиЦвет.Значение, """")) КАК ЦветСВБ,
	|	МАКСИМУМ(ЕСТЬNULL(ИС_WB_СборочноеЗаданиеskus.Штрихкод, """")) КАК ШтрихкодСМаркетплейса,
	|	ИС_WB_СборочноеЗадание.НоменклатураWB.Наименование КАК НаименованиеНоменклатурыСМаркетплейса,
	|	ИС_WB_СборочноеЗадание.Заказ КАК Заказ,
	|	ИС_WB_СоответствиеРазмеров.Номенклатура КАК Номенклатура1С,
	|	ИС_WB_СоответствиеРазмеров.Характеристика КАК Характеристика1С
	|ПОМЕСТИТЬ ВТ_ДанныеМаркетплейса
	|ИЗ
	|	Документ.ИС_WB_СборочноеЗадание КАК ИС_WB_СборочноеЗадание
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ИС_WB_СтатусыИЭтикеткиСборочныхЗаданий КАК ИС_WB_СтатусыИЭтикеткиСборочныхЗаданий
	|		ПО (ИС_WB_СборочноеЗадание.Ссылка = ИС_WB_СтатусыИЭтикеткиСборочныхЗаданий.СборочноеЗадание)
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ИС_WB_Номенклатура.Характеристики КАК ИС_WB_НоменклатураХарактеристикиЦвет
	|		ПО (ИС_WB_СборочноеЗадание.НоменклатураWB = ИС_WB_НоменклатураХарактеристикиЦвет.Ссылка)
	|			И (ИС_WB_НоменклатураХарактеристикиЦвет.Поле В
	|				(ВЫБРАТЬ
	|					ВТ.Ссылка
	|				ИЗ
	|					ВТ_Цвет КАК ВТ))
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ИС_WB_СборочноеЗадание.skus КАК ИС_WB_СборочноеЗаданиеskus
	|		ПО (ИС_WB_СборочноеЗадание.Ссылка = ИС_WB_СборочноеЗаданиеskus.Ссылка)
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ИС_WB_СоответствиеРазмеров КАК ИС_WB_СоответствиеРазмеров
	|		ПО (ИС_WB_СборочноеЗадание.РазмерWB = ИС_WB_СоответствиеРазмеров.РазмерWB)
	|ГДЕ
	|	ИС_WB_СборочноеЗадание.Ссылка В(&МассивСсылок)
	|
	|СГРУППИРОВАТЬ ПО
	|	ИС_WB_СборочноеЗадание.Номер,
	|	ИС_WB_СборочноеЗадание.НоменклатураWB.Код,
	|	ИС_WB_СборочноеЗадание.НоменклатураWB.vendorCode,
	|	ИС_WB_СборочноеЗадание.РазмерWB.techSize,
	|	ИС_WB_СборочноеЗадание.НоменклатураWB.Наименование,
	|	ИС_WB_СборочноеЗадание.Заказ,
	|	ИС_WB_СоответствиеРазмеров.Номенклатура,
	|	ИС_WB_СоответствиеРазмеров.Характеристика
	|;
	|" + ИС_МП_Печать.ТекстЗапросаПараметровПечатиШтрихкодов();
	
	Запрос.УстановитьПараметр("МассивСсылок", СборочноеЗадание); 
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Если РезультатЗапроса.Пустой() Тогда
		ОбщегоНазначения.СообщитьПользователю("Не удалось сформировать штрихкоды WildBerries");
		Возврат Табдок;	
	КонецЕсли;
	
	ОбластьЭтикетка = МакетОбработки.ПолучитьОбласть("Этикетка");
	
	Эталон = УправлениеПечатью.МакетПечатнойФормы("ОбщийМакет.ИС_МП_Эталон"); 
 
	КоличествоМиллиметровВПикселе = Эталон.Рисунки.Квадрат100Пикселей.Высота / 100;
	
	Выборка = РезультатЗапроса.Выбрать();
	
	Первый = Истина;	
	Пока Выборка.Следующий() Цикл
		
		//+ ИнфоСофт Стояк Ю.К. 29.10.2024 УА #67816
		//ОбластьЭтикетка.Параметры.Наименование  = Выборка.Наименование;
		//ОбластьЭтикетка.Параметры.Артикул = Выборка.vendorCode;
		//ОбластьЭтикетка.Параметры.Цвет	  = Выборка.Цвет;
		//ОбластьЭтикетка.Параметры.Размер  = Выборка.techSize;
		ЗаполнитьЗначенияСвойств(ОбластьЭтикетка.Параметры, Выборка);
		//- ИнфоСофт Стояк Ю.К. 29.10.2024 УА #67816
		
		ПараметрыШК = ИС_MP_ГенерацияШтрихкода.ПараметрыГенерацииШтрихкода();
		
		ПараметрыШК.Ширина = Окр(ОбластьЭтикетка.Рисунки.Штрихкод.Ширина / КоличествоМиллиметровВПикселе);
		ПараметрыШК.Высота = Окр(ОбластьЭтикетка.Рисунки.Штрихкод.Высота / КоличествоМиллиметровВПикселе);

		ПараметрыШК.РазмерШрифта = 10;
		//+ ИнфоСофт Стояк Ю.К. 29.10.2024 УА #67816		
		//ПараметрыШК.Штрихкод = Выборка.Штрихкод;
		ПараметрыШК.Штрихкод = Выборка.ШтрихкодСМаркетплейса;
		//- ИнфоСофт Стояк Ю.К. 29.10.2024 УА #67816
		ПараметрыШК.Масштабировать = Истина;
		ПараметрыШК.СохранятьПропорции = Истина;
		ПараметрыШК.ВертикальноеВыравнивание = 2; 
		
		СтруктураКартинки = ИС_MP_ГенерацияШтрихкода.ИзображениеШтрихкода(ПараметрыШК);
		
		Если СтруктураКартинки.Результат Тогда	
			ОбластьЭтикетка.Рисунки.Штрихкод.Картинка = СтруктураКартинки.Картинка;
		КонецЕсли;  
		
		Если Не Первый Тогда
			Табдок.ВывестиГоризонтальныйРазделительСтраниц();
		КонецЕсли;
		
		Первый = Ложь;
		
		Табдок.Вывести(ОбластьЭтикетка);
		
	КонецЦикла;    
	
	Возврат Табдок;
	
КонецФункции //- ИнфоСофт Стояк Ю.К. 30.07.2024 УА #76396

//+ ИнфоСофт Стояк Ю.К 22.07.24 УА #76396
&НаСервере
Функция ПолучитьДанныеШтрихкодаУпаковки(РезультатРазбора) 
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ШтрихкодыУпаковокТоваров.Ссылка КАК Ссылка,
	|	ШтрихкодыУпаковокТоваров.Номенклатура КАК Номенклатура,
	|	ШтрихкодыУпаковокТоваров.Характеристика КАК Характеристика
	|ИЗ
	|	Справочник.ШтрихкодыУпаковокТоваров КАК ШтрихкодыУпаковокТоваров
	|ГДЕ
	|	ШтрихкодыУпаковокТоваров.ЗначениеШтрихкода = &ЗначениеШтрихкода
	|
	|СГРУППИРОВАТЬ ПО
	|	ШтрихкодыУпаковокТоваров.Ссылка,
	|	ШтрихкодыУпаковокТоваров.Номенклатура,
	|	ШтрихкодыУпаковокТоваров.Характеристика";
	
	Запрос.УстановитьПараметр("ЗначениеШтрихкода", РезультатРазбора.НормализованныйКодМаркировки);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Если РезультатЗапроса.Пустой() Тогда
		Возврат Неопределено;		
	КонецЕсли;
	
	Выборка = РезультатЗапроса.Выбрать();
	
	Выборка.Следующий();
	
	Результат = Новый Структура;
	
	Результат.Вставить("Номенклатура", Выборка.Номенклатура);
	Результат.Вставить("Характеристика", Выборка.Характеристика);
	Результат.Вставить("НормализованныйШтрихкод", РезультатРазбора.КодМаркировки); 
	Результат.Вставить("ШтрихкодУпаковки", Выборка.Ссылка);
	
	Возврат Результат;
	
КонецФункции //- ИнфоСофт Стояк Ю.К 22.07.24 УА #76396

