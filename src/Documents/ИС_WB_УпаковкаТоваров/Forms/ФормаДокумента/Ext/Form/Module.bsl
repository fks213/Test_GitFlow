	//+ ИнфоСофт Стояк Ю.К. 16.08.2024 УА #81970	
	Если Не Обновление Тогда
		Объект.Товары.Очистить();
	КонецЕсли;                                  
	//Объект.Товары.Очистить();
	//- ИнфоСофт Стояк Ю.К. 16.08.2024 УА #81970
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ИС_WB_СтатусыИЭтикеткиСборочныхЗаданий.СборочноеЗадание КАК СборочноеЗадание,
	|	ИС_WB_СтатусыИЭтикеткиСборочныхЗаданий.СборочноеЗадание.РазмерWB КАК СборочноеЗаданиеРазмерWB,
	|	ИС_WB_СтатусыИЭтикеткиСборочныхЗаданий.partA + "" "" + ИС_WB_СтатусыИЭтикеткиСборочныхЗаданий.partB КАК ДанныеQR,
	|	ИС_WB_СтатусыИЭтикеткиСборочныхЗаданий.СтатусWB КАК СтатусWB
	|ПОМЕСТИТЬ ВТ_СборочныеЗадания
	|ИЗ
	|	РегистрСведений.ИС_WB_СтатусыИЭтикеткиСборочныхЗаданий КАК ИС_WB_СтатусыИЭтикеткиСборочныхЗаданий
	|ГДЕ
	|	ИС_WB_СтатусыИЭтикеткиСборочныхЗаданий.Поставка = &Поставка
	//+ ИнфоСофт Стояк Ю.К. 04.03.2025 УА #93469
	|	И НЕ ИС_WB_СтатусыИЭтикеткиСборочныхЗаданий.СборочноеЗадание.ТипДоставки = ЗНАЧЕНИЕ(Перечисление.ИС_ВБ_ТипыДоставки.FBO)
	//- ИнфоСофт Стояк Ю.К. 04.03.2025 УА #93469
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
