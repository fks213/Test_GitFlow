&НаСервере
Функция ИспользуетсяСхемаКомиссии25()  
	
	ИспользоватьДоговорыСКлиентами = ПолучитьФункциональнуюОпцию("ИспользоватьДоговорыСКлиентами");
	
	Профиль = Объект.Профиль;   
	
	ФукнциональныеОпции = ИС_ЯМ_Сервер.ПолучитьНастройкиФункциональностиСборочныхЗвданий(Профиль);
	//+ ИнфоСофт Стояк Ю.К. 15.12.2024 УА #89598	
	//Соглашение = ФукнциональныеОпции.СоглашениеOzon;
	//Договор = ФукнциональныеОпции.ДоговорOzon;
	Соглашение = ФукнциональныеОпции.СоглашениеЯМ;	
	Договор = ФукнциональныеОпции.ДоговорЯМ;
	//- ИнфоСофт Стояк Ю.К. 15.12.2024 УА #89598
	
	
	Если ИспользоватьДоговорыСКлиентами Тогда
		Если Не ЗначениеЗаполнено(Договор) Тогда
			Возврат Ложь;
		Иначе
			Возврат Договор.КомиссионныеПродажи25;	
		КонецЕсли;
	Иначе
		Если Не ЗначениеЗаполнено(Соглашение) Тогда
			Возврат Ложь;
		Иначе
			Возврат Соглашение.КомиссионныеПродажи25;	
		КонецЕсли;	
	КонецЕсли;
	
КонецФункции //- ИнфоСофт Стояк Ю.К. 25.10.2024 УА #69482

//+ ИнфоСофт Стояк Ю.К. 25.10.24 УА #69482
&НаСервере
Функция ВнешнееСобытиеНаСервере(Данные)
	
	РезультатРазбора = ИС_MP_Маркировка.РазборКодаМаркировки(СокрЛП(Данные));
	
	Если РезультатРазбора <> Неопределено И РезультатРазбора.ТипШтрихкода = ПолучитьТипGS1_DataMatrixНаСервере() Тогда
		ПолучитьТоварыПоQrКоду(РезультатРазбора.НормализованныйКодМаркировки);				
	Иначе
		Тип = НайтиПроверочныйШК(Данные);  
		
		Если ЗначениеЗаполнено(Тип) Тогда        			
			Если Тип = ПредопределенноеЗначение("Перечисление.ИС_MP_ТипУниверсальногоШтрихкода.ПовторнаяПечатьШК") Тогда		       
				ТабДок = ПечатьШтрихкода(ПоследнийШтрихкод);
				ТабДок.Напечатать(РежимИспользованияДиалогаПечати.НеИспользовать);
				//+ ИнфоСофт Стояк Ю.К. 31.03.2025 УА #97269				
				//Возврат;
				Возврат Неопределено;                       
				//- ИнфоСофт Стояк Ю.К. 31.03.2025 УА #97269
			Иначеесли Тип = ПредопределенноеЗначение("Перечисление.ИС_MP_ТипУниверсальногоШтрихкода.ИзменитьТипШкДляПечати") Тогда		       
				ТипШтрихкода = (ТипШтрихкода + 1) % 3; 
				//+ ИнфоСофт Стояк Ю.К. 31.03.2025 УА #97269
				//Возврат;
				Возврат Неопределено;                       
				//- ИнфоСофт Стояк Ю.К. 31.03.2025 УА #97269
			КонецЕсли;						
		Иначе
			ПолучитьТоварыПоШтрихкоду(Данные);	
		КонецЕсли;  
		
	КонецЕсли;
	
	Объект.ИтогоНоменклатуры = Объект.Товары.Количество();
	    	
	Если АвтоПечать И ДанныеНайдены Тогда
		ТабДок = ПечатьШтрихкода(ПоследнийШтрихкод);
		//+ ИнфоСофт Стояк Ю.К. 31.03.2025 УА #97269		
		//ТабДок.Напечатать(РежимИспользованияДиалогаПечати.НеИспользовать);
		Возврат ТабДок;
		//- ИнфоСофт Стояк Ю.К. 31.03.2025 УА #97269
	КонецЕсли;
	
	//+ ИнфоСофт Стояк Ю.К. 31.03.2025 УА #97269
	Возврат Неопределено;
	//- ИнфоСофт Стояк Ю.К. 31.03.2025 УА #97269
	
КонецФункции //- ИнфоСофт Стояк Ю.К. 25.10.24 УА #69482

//+ ИнфоСофт Стояк Ю.К. 24.10.2024 УА #76340
&НаКлиенте
Процедура ПоискПоШтрихкодуЗавершение(Данные, ДополнительныеПараметры) Экспорт
	
	Если Данные.Штрихкод <> "" Тогда
		//+ ИнфоСофт Стояк Ю.К. 31.03.2025 УА #97269		
		//ВнешнееСобытиеНаСервере(СокрЛП(Данные.Штрихкод));		
		ТабДок = ВнешнееСобытиеНаСервере(СокрЛП(Данные.Штрихкод));   
	
		Если ТабДок <> Неопределено Тогда
			ТабДок.Напечатать(РежимИспользованияДиалогаПечати.НеИспользовать);
		КонецЕсли;                                  
		//- ИнфоСофт Стояк Ю.К. 31.03.2025 УА #97269
	КонецЕсли;
	
КонецПроцедуры //- ИнфоСофт Стояк Ю.К. 24.10.2024 УА #76340

//+ ИнфоСофт Стояк Ю.К. 24.10.2024 УА #76340
&НаСервере
Функция ТоварыНоменклатураПриИзмененииНаСервере(Номенклатура = Неопределено, Характеристика = Неопределено)
	
	Если Не ЗначениеЗаполнено(Номенклатура) Тогда
		Номенклатура = Справочники.Номенклатура.ПустаяСсылка();
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(Характеристика) Тогда
		Характеристика = Справочники.ХарактеристикиНоменклатуры.ПустаяСсылка();
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	ЛОЖЬ КАК МаркированныйТовар,
	|	ИС_ЯМ_СоответствиеХарактеристик.Номенклатура КАК Номенклатура,
	|	ИС_ЯМ_СоответствиеХарактеристик.Характеристика КАК Характеристика,
	|	ИС_ЯМ_СоответствиеХарактеристик.НоменклатураЯМ.shopSku КАК Артикул,
	|	МАКСИМУМ(ИС_ЯМ_Штрихкоды.Наименование) КАК Штрихкод
	|ИЗ
	|	РегистрСведений.ИС_ЯМ_СоответствиеХарактеристик КАК ИС_ЯМ_СоответствиеХарактеристик
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ИС_ЯМ_Штрихкоды КАК ИС_ЯМ_Штрихкоды
	|		ПО ИС_ЯМ_СоответствиеХарактеристик.НоменклатураЯМ = ИС_ЯМ_Штрихкоды.Владелец
	|ГДЕ
	|	ИС_ЯМ_СоответствиеХарактеристик.Номенклатура = &Номенклатура
	|	И ИС_ЯМ_СоответствиеХарактеристик.Характеристика = &Характеристика
	|	И ИС_ЯМ_СоответствиеХарактеристик.НоменклатураЯМ.Профиль = &Профиль
	|
	|СГРУППИРОВАТЬ ПО
	|	ИС_ЯМ_СоответствиеХарактеристик.Номенклатура,
	|	ИС_ЯМ_СоответствиеХарактеристик.Характеристика,
	|	ИС_ЯМ_СоответствиеХарактеристик.НоменклатураЯМ.shopSku";
	
	Запрос.УстановитьПараметр("Профиль", Объект.Профиль);  
	Запрос.УстановитьПараметр("Номенклатура", Номенклатура); 
	Запрос.УстановитьПараметр("Характеристика", Характеристика); 
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Если РезультатЗапроса.Пустой() Тогда		
		ОбщегоНазначения.СообщитьПользователю("Не найдены данные по указанной позиции"); 		
		ДанныеНайдены = Ложь;                       
		Возврат Неопределено;		
	КонецЕсли;
	
	ТЗ = РезультатЗапроса.Выгрузить(); 
	Структура = Новый Структура;
	
	Для Каждого ИмяКолонки Из ТЗ.Колонки Цикл		
		Структура.Вставить(ИмяКолонки.Имя, ТЗ[0][ИмяКолонки.Имя]);
	КонецЦикла;
		
	ДанныеНайдены = Истина;	
	
	Возврат Структура;
	
КонецФункции //- ИнфоСофт Стояк Ю.К. 24.10.2024 УА #76340

#КонецОбласти



	

