//+ ИнфоСофт Стояк Ю.К. 25.10.2024 УА #69482
&НаСервере
Процедура ПолучитьТоварыПоQrКоду(qrКод)
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ШтрихкодыУпаковокТоваров.Номенклатура КАК Номенклатура,
	|	ШтрихкодыУпаковокТоваров.Характеристика КАК Характеристика
	|ПОМЕСТИТЬ ВТ_Номенклатура
	|ИЗ
	|	Справочник.ШтрихкодыУпаковокТоваров КАК ШтрихкодыУпаковокТоваров
	|ГДЕ
	|	ШтрихкодыУпаковокТоваров.ЗначениеШтрихкода = &ЗначениеШтрихкода
	|
	|СГРУППИРОВАТЬ ПО
	|	ШтрихкодыУпаковокТоваров.Номенклатура,
	|	ШтрихкодыУпаковокТоваров.Характеристика
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ ПЕРВЫЕ 1
	|	ВТ_Номенклатура.Номенклатура КАК Номенклатура,
	|	ВТ_Номенклатура.Характеристика КАК Характеристика
	|ПОМЕСТИТЬ ВТ_НоменклатураГруппировка
	|ИЗ
	|	ВТ_Номенклатура КАК ВТ_Номенклатура
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_НоменклатураГруппировка.Номенклатура КАК Номенклатура,
	|	ВТ_НоменклатураГруппировка.Характеристика КАК Характеристика,
	|	ИСТИНА КАК МаркированныйТовар,
	|	ИС_ЯМ_Штрихкоды.Наименование КАК Штрихкод,
	|	ИС_ЯМ_СоответствиеХарактеристик.НоменклатураЯМ.vendorCode КАК Артикул
	|ИЗ
	|	ВТ_НоменклатураГруппировка КАК ВТ_НоменклатураГруппировка
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ИС_ЯМ_СоответствиеХарактеристик КАК ИС_ЯМ_СоответствиеХарактеристик
	|			ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ИС_ЯМ_Штрихкоды КАК ИС_ЯМ_Штрихкоды
	|			ПО ИС_ЯМ_СоответствиеХарактеристик.НоменклатураЯМ = ИС_ЯМ_Штрихкоды.Владелец
	|		ПО ВТ_НоменклатураГруппировка.Номенклатура = ИС_ЯМ_СоответствиеХарактеристик.Номенклатура
	|			И ВТ_НоменклатураГруппировка.Характеристика = ИС_ЯМ_СоответствиеХарактеристик.Характеристика
	|ГДЕ
	|	ИС_ЯМ_СоответствиеХарактеристик.НоменклатураЯМ.Профиль = &Профиль";
	
	Запрос.УстановитьПараметр("ЗначениеШтрихкода", qrКод);
	Запрос.УстановитьПараметр("Профиль", Объект.Профиль);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Если РезультатЗапроса.Пустой() Тогда
		ОбщегоНазначения.СообщитьПользователю("Не найдены данные по qr коду " + qrКод); 		
		ДанныеНайдены = Ложь;                       
		Возврат;		
	КонецЕсли;	
		
	ДанныеНайдены = Истина;	
	
	ДобавитьТоварыПоШтрихкоду(РезультатЗапроса.Выгрузить());
	
КонецПроцедуры //- ИнфоСофт Стояк Ю.К. 25.10.2024 УА #69482

//+ ИнфоСофт Стояк Ю.К. 25.10.2024 УА #69482
&НаСервере
Процедура ПолучитьТоварыПоШтрихкоду(Данные)  
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ИС_ЯМ_Штрихкоды.Наименование КАК Штрихкод,
	|	ИС_ЯМ_Штрихкоды.Ссылка КАК Ссылка
	|ПОМЕСТИТЬ ВТ_Размер
	|ИЗ
	|	Справочник.ИС_ЯМ_Штрихкоды КАК ИС_ЯМ_Штрихкоды
	|ГДЕ
	|	ИС_ЯМ_Штрихкоды.Наименование = &Штрихкод
	|	И ИС_ЯМ_Штрихкоды.Профиль = &Профиль
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ЛОЖЬ КАК МаркированныйТовар,
	|	ВТ_Размер.Штрихкод КАК Штрихкод,
	|	ИС_ЯМ_СоответствиеХарактеристик.Номенклатура КАК Номенклатура,
	|	ИС_ЯМ_СоответствиеХарактеристик.Характеристика КАК Характеристика,
	|	ИС_ЯМ_СоответствиеХарактеристик.НоменклатураЯМ.vendorCode КАК Артикул
	|ИЗ
	|	ВТ_Размер КАК ВТ_Размер
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ИС_ЯМ_СоответствиеХарактеристик КАК ИС_ЯМ_СоответствиеХарактеристик
	|		ПО ВТ_Размер.Ссылка.Владелец = ИС_ЯМ_СоответствиеХарактеристик.НоменклатураЯМ";
	
	Запрос.УстановитьПараметр("Профиль", Объект.Профиль);  
	Запрос.УстановитьПараметр("Штрихкод", Данные); 
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Если РезультатЗапроса.Пустой() Тогда
		ОбщегоНазначения.СообщитьПользователю("Не найдены данные по штрихкоду: " + Данные); 		
		ДанныеНайдены = Ложь;                       
		Возврат;		
	КонецЕсли;	
		
	ДанныеНайдены = Истина;	
	
	ДобавитьТоварыПоШтрихкоду(РезультатЗапроса.Выгрузить());
	
КонецПроцедуры //- ИнфоСофт Стояк Ю.К. 25.10.2024 УА #69482

//+ ИнфоСофт Стояк Ю.К. 25.10.2024 УА #69482
&НаСервере
Процедура ДобавитьТоварыПоШтрихкоду(ТоварыДляДобавления) 	
		
	//Выполним проверку на уникальность уже отсканированных позиций
	Отбор = Новый Структура;
	Отбор.Вставить("Номенклатура", ТоварыДляДобавления[0].Номенклатура);
	Отбор.Вставить("Характеристика", ТоварыДляДобавления[0].Характеристика); 
	Отбор.Вставить("Штрихкод", ТоварыДляДобавления[0].Штрихкод);
	
	МассивНайденныхСтрок = Объект.Товары.НайтиСтроки(Отбор);
	
	Если МассивНайденныхСтрок.Количество() > 0 Тогда
		МассивНайденныхСтрок[0].Количество = МассивНайденныхСтрок[0].Количество + 1;
		//ЗначениеВРеквизитФормы(Товары, "Товары");
		Возврат;
	КонецЕсли;	
	
	//Если ранее таких позиций не было, добавим их в дерево			
	Для Каждого Элемент Из ТоварыДляДобавления Цикл
		Стр = Объект.Товары.Добавить();			
		
		Стр.Номенклатура = Элемент.Номенклатура;
		Стр.Характеристика = Элемент.Характеристика; 
		Стр.Штрихкод = Элемент.Штрихкод; 
		Стр.МаркированныйТовар = Элемент.МаркированныйТовар;
		Стр.Артикул = Элемент.Артикул;
		Стр.Количество = 1;
		
	КонецЦикла;   
	
	//ЗначениеВРеквизитФормы(Товары, "Товары");
	
	ПоследнийШтрихкод = ТоварыДляДобавления[0].Штрихкод;	
		
КонецПроцедуры //- ИнфоСофт Стояк Ю.К. 25.10.2024 УА #69482

//+ ИнфоСофт Стояк Ю.К. 25.10.2024 УА #69482
&НаСервере
Функция СформироватьТабличныйДокумент(ТаблицаВыгрузки)
	ТабличныйДокумент = Новый ТабличныйДокумент;
	
	Построитель = Новый ПостроительОтчета;
	Построитель.ИсточникДанных = Новый ОписаниеИсточникаДанных(ТаблицаВыгрузки); 
	Построитель.ВыводитьЗаголовокОтчета = Ложь;
	Построитель.Вывести(ТабличныйДокумент);
	Колво = Объект.Товары.Количество();
	ТабличныйДокумент.АвтоМасштаб = Истина;
	ТабличныйДокумент.УдалитьОбласть(ТабличныйДокумент.Область("R1C1:R" + Строка(Колво + 1) + "C1"), ТипСмещенияТабличногоДокумента.ПоГоризонтали);
	ТабличныйДокумент.Область("R1C2:R1C2").Текст = "имя (необязательно)"; 
	ТабличныйДокумент.Область("R1C1:R" + Строка(Колво + 1) + "C1").ШиринаКолонки = 20;
	ТабличныйДокумент.Область("R1C2:R" + Строка(Колво + 1) + "C2").ШиринаКолонки = 20;
	ТабличныйДокумент.Область("R1C3:R" + Строка(Колво + 1) + "C3").ШиринаКолонки = 20;
	
	Возврат ТабличныйДокумент;
КонецФункции //- ИнфоСофт Стояк Ю.К. 25.10.2024 УА #69482

//+ ИнфоСофт Стояк Ю.К. 25.10.2024 УА #69482
&НаСервере
Функция СформироватьТабличныйДокументOzon()
	ТаблицаВыгрузки = Новый ТаблицаЗначений;
	
	ТаблицаВыгрузки.Колонки.Добавить("артикул", Новый ОписаниеТипов("Строка",,,,Новый КвалификаторыСтроки(50)));
	ТаблицаВыгрузки.Колонки.Добавить("имя_необязательно_", Новый ОписаниеТипов("Строка",,,,Новый КвалификаторыСтроки(150)), "имя (необязательно)"); 
	ТаблицаВыгрузки.Колонки.Добавить("количество", Новый ОписаниеТипов("число"));
		
	Если Объект.Товары.Количество() < 1 Тогда
		ОбщегоНазначения.СообщитьПользователю("Сначала необходимо заполнить таблицу товаров.");
		Возврат Неопределено;	
	КонецЕсли;
	
	Для Каждого Строка Из Объект.Товары Цикл
		СтрокаТЗ = ТаблицаВыгрузки.Добавить();
		СтрокаТЗ.артикул = Строка.Артикул;
		СтрокаТЗ.имя_необязательно_ = "";					
		СтрокаТЗ.количество = Строка.Количество;
	КонецЦикла;	
	
	
	ТабДок = СформироватьТабличныйДокумент(ТаблицаВыгрузки);
	
	Возврат ТабДок
	
КонецФункции //- ИнфоСофт Стояк Ю.К. 25.10.2024 УА #69482	

//+ ИнфоСофт Стояк Ю.К. 25.10.2024 УА #69482
&НаСервере
Процедура ПередЗаписьюНаСервере(Отказ, ТекущийОбъект, ПараметрыЗаписи)   
		
	ТекущийОбъект.Ответственный = ПользователиКлиентСервер.ТекущийПользователь();
