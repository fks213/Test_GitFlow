&НаСервере
Функция ПечатьШтрихкода(Штрихкод)
	
	Данные = ПолучитьДанныеДляФормированияЭтикетки(Штрихкод);  
	
	Макет = УправлениеПечатью.МакетПечатнойФормы("Документ.ИС_ЯМ_ФормированиеПоставкиFBO.ПФ_MXL_Штрихкод58х40_ЯМ");
	
	ТабличныйДокумент = Новый ТабличныйДокумент;
	ТабличныйДокумент.ОриентацияСтраницы = ОриентацияСтраницы.Портрет;
	ТабличныйДокумент.ИмяПараметровПечати = "Этикетка";		
	
	ОбластьМакетаОсновныеДанные = Макет.ПолучитьОбласть("Этикетка"); 
	
	ОбластьМакетаОсновныеДанные.Параметры.Заполнить(Данные);
	
	Эталон = УправлениеПечатью.МакетПечатнойФормы("ОбщийМакет.ИС_МП_Эталон"); 
	КоличествоМиллиметровВПикселе = Эталон.Рисунки.Квадрат100Пикселей.Высота / 100;
	
	ПараметрыШК = ИС_MP_ГенерацияШтрихкода.ПараметрыГенерацииШтрихкода();
	
	ПараметрыШК.Ширина = Окр(ОбластьМакетаОсновныеДанные.Рисунки.Штрихкод.Ширина / КоличествоМиллиметровВПикселе);
	ПараметрыШК.Высота = Окр(ОбластьМакетаОсновныеДанные.Рисунки.Штрихкод.Высота / КоличествоМиллиметровВПикселе);
	ПараметрыШК.РазмерШрифта = 10;
	ПараметрыШК.Штрихкод = Штрихкод;
	ПараметрыШК.Масштабировать = Истина;
	ПараметрыШК.СохранятьПропорции = Истина;
	ПараметрыШК.ВертикальноеВыравнивание = 2;
	
	СтруктураКартинки = ИС_MP_ГенерацияШтрихкода.ИзображениеШтрихкода(ПараметрыШК);
	
	Если СтруктураКартинки.Результат Тогда	
		ОбластьМакетаОсновныеДанные.Рисунки.Штрихкод.Картинка = СтруктураКартинки.Картинка;
	КонецЕсли;  
	
	ТабличныйДокумент.Вывести(ОбластьМакетаОсновныеДанные);   
	
	Возврат ТабличныйДокумент;
	
КонецФункции //- ИнфоСофт Стояк Ю.К. 22.10.2024 УА #69482

//+ ИнфоСофт Стояк Ю.К. 22.10.2024 УА #69482
Функция ПолучитьСтруктуруФормированияШтрихкода(Штрихкод)
	
	СтруктураШтрихкода = Новый Структура;
	
	СтруктураШтрихкода.Вставить("Ширина", 280);
	СтруктураШтрихкода.Вставить("Высота", 100);
	СтруктураШтрихкода.Вставить("ТипКода", 1);
	СтруктураШтрихкода.Вставить("ОтображатьТекст", Истина);
	СтруктураШтрихкода.Вставить("Штрихкод", Штрихкод);
	
	Возврат СтруктураШтрихкода;

КонецФункции //- ИнфоСофт Стояк Ю.К. 22.10.2024 УА #69482

//+ ИнфоСофт Стояк Ю.К. 22.10.2024 УА #69482
Функция ПолучитьДанныеДляФормированияЭтикетки(Штрихкод) 
		
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	ИС_ЯМ_Номенклатура.shopSku КАК shopSku,
	|	ИС_ЯМ_Штрихкоды.Наименование КАК Штрихкод,
	|	ИС_ЯМ_Номенклатура.Ссылка КАК Ссылка,
	|	ИС_ЯМ_Номенклатура.Наименование КАК Наименование
	|ИЗ
	|	Справочник.ИС_ЯМ_Штрихкоды КАК ИС_ЯМ_Штрихкоды
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ИС_ЯМ_Номенклатура КАК ИС_ЯМ_Номенклатура
	|		ПО ИС_ЯМ_Штрихкоды.Владелец = ИС_ЯМ_Номенклатура.Ссылка
	|ГДЕ
	|	ИС_ЯМ_Штрихкоды.Наименование = &Штрихкод
	|	И ИС_ЯМ_Номенклатура.Профиль = &Профиль";
	
	Запрос.УстановитьПараметр("Штрихкод", Штрихкод);
	Запрос.УстановитьПараметр("Профиль", Объект.Профиль);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Результат = Новый Структура;   
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл 
		
		Результат.Вставить("Штрихкод", ВыборкаДетальныеЗаписи.Штрихкод);
		Результат.Вставить("Артикул", ВыборкаДетальныеЗаписи.shopSku); 	

		МассивАртикулов = Новый Массив;
		МассивАртикулов.Добавить(ВыборкаДетальныеЗаписи.shopSku);
		
		ТелоЗапроса = Новый Структура;
		ТелоЗапроса.Вставить("offerIds", МассивАртикулов);
		
		//+ ИнфоСофт Стояк Ю.К. 01.04.2025 УА #97269		
		//Результат = ИС_ЯМ_Сервер.ПолучитьИнформациюОКарточкахПоАртикулу(Объект.Профиль, ТелоЗапроса); 
		ДанныеКарточки = ИС_ЯМ_Сервер.ПолучитьИнформациюОКарточкахПоАртикулу(Объект.Профиль, ТелоЗапроса); 		
		
		//Если Результат = Неопределено Тогда                                                                
		Если ДанныеКарточки = Неопределено Тогда
		//- ИнфоСофт Стояк Ю.К. 01.04.2025 УА #97269
			Результат.Вставить("Наименование", ВыборкаДетальныеЗаписи.Наименование);
			Прервать;
		КонецЕсли;
		
		//+ ИнфоСофт Стояк Ю.К. 01.04.2025 УА #97269		
		//Для Каждого Товар Из Результат.offerMappings Цикл	
		Для Каждого Товар Из ДанныеКарточки.offerMappings Цикл	
		//- ИнфоСофт Стояк Ю.К. 01.04.2025 УА #97269
			Если Товар.Свойство("offer") Тогда 
				Результат.Вставить("Наименование", Товар.offer.name);
			КонецЕсли;			
		КонецЦикла;
		
	КонецЦикла;  
	
	Возврат Результат;
	
КонецФункции //- ИнфоСофт Стояк Ю.К. 22.10.2024 УА #69482

//+ ИнфоСофт Стояк Ю.К. 22.10.2024 УА #69482
Функция НайтиПроверочныйШК(ШК)
 	Элемент = Справочники.ИС_MP_Баркоды.НайтиПоРеквизиту("Штрихкод", ШК); 
	Если ЗначениеЗаполнено(Элемент) Тогда
		Элемент = Элемент.ПолучитьОбъект();
		Возврат Элемент.Тип;
	Иначе
		Возврат Неопределено;
	КонецЕсли;
