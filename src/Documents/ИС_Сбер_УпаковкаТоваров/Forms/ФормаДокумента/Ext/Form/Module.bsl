
#Область ОбработчикиСобытийФормы   

//+ ИнфоСофт Власова И.С. 22.03.24 УА #71520
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Если Параметры.Ключ.Пустая() Тогда
		
		Если Параметры.Свойство("Профиль") Тогда	
			Объект.Профиль = Параметры.Профиль;
		КонецЕсли;
		
		МассивЗаказов = Новый Массив;
		
		Если Параметры.Свойство("ВыделенныеСтроки") Тогда
			МассивЗаказов = Параметры.ВыделенныеСтроки;
		КонецЕсли;
		
		ЗаполнитьДанныеЗаказаНаСервере(МассивЗаказов);
		
		Объект.Ответственный = Пользователи.ТекущийПользователь();
		
	Иначе		
		ЗаполнитьДеревоНоменклатурыПоТЧ();	
	КонецЕсли;
	
	УстановитьУсловноеОформление();
	
	ОбщегоНазначенияУТ.НастроитьПодключаемоеОборудование(ЭтаФорма);
	
КонецПроцедуры //- ИнфоСофт Власова И.С. 22.03.24 УА #71520

//+ ИнфоСофт Власова И.С. 22.03.24 УА #71520
&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	Дерево = ДеревоЗаказы.ПолучитьЭлементы();
	
	Для Каждого Строка Из Дерево Цикл
		Если Строка.ЭтикеткаРаспечатана Тогда
			Элементы.ДеревоЗаказы.Свернуть(Строка.ПолучитьИдентификатор());
		Иначе	
			Элементы.ДеревоЗаказы.Развернуть(Строка.ПолучитьИдентификатор());
		КонецЕсли;
	КонецЦикла;
	
	ЭтаФорма.ИспользоватьПодключаемоеОборудование = Истина;
	МенеджерОборудованияКлиент.НачатьПодключениеОборудованиеПриОткрытииФормы(Неопределено, ЭтаФорма, "СканерШтрихкода");
	
КонецПроцедуры //- ИнфоСофт Власова И.С. 22.03.24 УА #71520

//+ ИнфоСофт Власова И.С. 22.03.24 УА #71520
&НаСервере
Процедура ПередЗаписьюНаСервере(Отказ, ТекущийОбъект, ПараметрыЗаписи)
	
	Если Не Отказ Тогда
		
		ТекущийОбъект.Товары.Очистить();
		
		Дерево = РеквизитФормыВЗначение("ДеревоЗаказы");
		ПреобразоватьДеревоВТаблицуЗначений(Дерево, ТекущийОбъект);
		
	КонецЕсли;
	
КонецПроцедуры //- ИнфоСофт Власова И.С. 22.03.24 УА #71520

//+ ИнфоСофт Власова И.С. 22.03.24 УА #71520
&НаКлиенте
Процедура ПриЗакрытии(ЗавершениеРаботы)
	
	МенеджерОборудованияКлиент.НачатьОтключениеОборудованиеПриЗакрытииФормы(Неопределено, ЭтаФорма);
	
КонецПроцедуры //- ИнфоСофт Власова И.С. 22.03.24 УА #71520

//+ ИнфоСофт Власова И.С. 22.03.24 УА #71520
&НаКлиенте
Процедура ОбработкаОповещения(ИмяСобытия, Параметр, Источник)
	
	Если Источник = "ПодключаемоеОборудование" И ВводДоступен() Тогда
		Если ИмяСобытия = "ScanData" И МенеджерОборудованияУТКлиент.ЕстьНеобработанноеСобытие() Тогда
			СтруктураШтрихкод = МенеджерОборудованияУТКлиент.ПреобразоватьДанныеСоСканераВСтруктуру(Параметр);
			ОбработатьШтрихкоды(СтруктураШтрихкод.Штрихкод);
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры //- ИнфоСофт Власова И.С. 22.03.24 УА #71520

//+ ИнфоСофт Власова И.С. 22.03.24 УА #71520
&НаКлиенте
Процедура ПрофильПриИзменении(Элемент)
	ЗаполнитьДанныеЗаказа();
КонецПроцедуры //- ИнфоСофт Власова И.С. 22.03.24 УА #71520

#КонецОбласти 

