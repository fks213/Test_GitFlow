КонецПроцедуры //- ИнфоСофт Сумин Д.В. 09.01.2023 УА #68183	

//+ ИнфоСофт Сумин Д.В. 09.01.2023 УА #68183
&НаСервере
Функция ПолучитьИскомыеЗаказы(Состав)
	
	Статусы = Новый Массив;

	Если ОтборОтправлений = "Сборка" Тогда                                                  		

		Статусы.Добавить(Перечисления.ИС_Ozon_СтатусыОтправлений.awaiting_packaging);
					
	ИначеЕсли ОтборОтправлений = "Отгрузка" Тогда
	
		Статусы.Добавить(Перечисления.ИС_Ozon_СтатусыОтправлений.awaiting_deliver);
		Статусы.Добавить(Перечисления.ИС_Ozon_СтатусыОтправлений.awaiting_registration);
					
	ИначеЕсли ОтборОтправлений = "Спорные" Тогда
			
		Статусы.Добавить(Перечисления.ИС_Ozon_СтатусыОтправлений.arbitration);
		Статусы.Добавить(Перечисления.ИС_Ozon_СтатусыОтправлений.not_accepted);
		Статусы.Добавить(Перечисления.ИС_Ozon_СтатусыОтправлений.client_arbitration);
			
	ИначеЕсли ОтборОтправлений = "Доставка" Тогда
			
		Статусы.Добавить(Перечисления.ИС_Ozon_СтатусыОтправлений.delivering);
		Статусы.Добавить(Перечисления.ИС_Ozon_СтатусыОтправлений.driver_pickup);
				
	ИначеЕсли ОтборОтправлений = "Доставлены" Тогда
			
		Статусы.Добавить(Перечисления.ИС_Ozon_СтатусыОтправлений.delivered);
		
	ИначеЕсли ОтборОтправлений = "Отменены" Тогда
		
		Статусы.Добавить(Перечисления.ИС_Ozon_СтатусыОтправлений.cancelled);
				
	Иначе // Все
	
		Для Каждого Элемент Из Перечисления.ИС_Ozon_СтатусыОтправлений Цикл
			Статусы.Добавить(Элемент);		
		КонецЦикла;
		
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ИС_Ozon_Заказproducts.Ссылка КАК Ссылка,
	|	ИС_Ozon_Заказproducts.НоменклатураOzon.offer_id КАК offer_id,
	|	ИС_Ozon_Заказproducts.quantity КАК quantity
	|ИЗ
	|	Документ.ИС_Ozon_Заказ.products КАК ИС_Ozon_Заказproducts
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ИС_Ozon_СтатусыСборочныхЗаданий КАК ИС_Ozon_СтатусыСборочныхЗаданий
	|		ПО (ИС_Ozon_Заказproducts.Ссылка = ИС_Ozon_СтатусыСборочныхЗаданий.Заказ)
	|ГДЕ
	|	ИС_Ozon_Заказproducts.Ссылка.Профиль = &Профиль
	|	И ИС_Ozon_СтатусыСборочныхЗаданий.status В (&Статусы)
	|ИТОГИ ПО
	|	Ссылка";
	
	Запрос.УстановитьПараметр("Статусы", Статусы);
	Запрос.УстановитьПараметр("Профиль", Профиль);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Выборка = РезультатЗапроса.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	Заказы = Новый ТаблицаЗначений;
	
	Заказы.Колонки.Добавить("Заказ", Новый ОписаниеТипов("ДокументСсылка.ИС_Ozon_Заказ"));
	
	Пока Выборка.Следующий() Цикл
		ВыборкаДетальныеЗаписи = Выборка.Выбрать();
		СоставСборка = "";
		
		Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
			СоставСборка = СоставСборка + ВыборкаДетальныеЗаписи.offer_id + " - " + ВыборкаДетальныеЗаписи.quantity + " шт." + Символы.ПС;			
		КонецЦикла; 
		
		Если СтрНайти(НРег(СоставСборка), Нрег(Состав)) > 0 Тогда
			НоваяСтрока = Заказы.Добавить();
			НоваяСтрока.Заказ = Выборка.Ссылка; 
		КонецЕсли;
	КонецЦикла;
	
	Возврат Заказы;
	
КонецФункции//- ИнфоСофт Сумин Д.В. 09.01.2023 УА #68183

