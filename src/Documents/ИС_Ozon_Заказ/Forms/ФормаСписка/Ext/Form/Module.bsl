//+ ИнфоСофт Стояк Ю.К. 20.03.2023 УА #54628
&НаСервереБезКонтекста
Процедура ПолучитьДатуПоследнегоЗаказа(Профиль, Дата, ДатаФБО) 
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	//+ ИнфоСофт Стояк Ю.К. 03.03.2025 УА #93469
	//"ВЫБРАТЬ ПЕРВЫЕ 1
	//|	ИС_Ozon_Заказ.Дата КАК Дата
	//|ИЗ
	//|	Документ.ИС_Ozon_Заказ КАК ИС_Ozon_Заказ
	//|ГДЕ
	//|	ИС_Ozon_Заказ.Профиль = &Профиль
	//|
	//|УПОРЯДОЧИТЬ ПО
	//|	Дата УБЫВ";	
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	ИС_Ozon_Заказ.Дата КАК Дата,
	|	ИС_Ozon_Заказ.ЗаказФБО КАК ЗаказФБО
	|ИЗ
	|	Документ.ИС_Ozon_Заказ КАК ИС_Ozon_Заказ
	|ГДЕ
	|	ИС_Ozon_Заказ.Профиль = &Профиль
	|	И НЕ ИС_Ozon_Заказ.ЗаказФБО
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ ПЕРВЫЕ 1
	|	ИС_Ozon_Заказ.Дата,
	|	ИС_Ozon_Заказ.ЗаказФБО
	|ИЗ
	|	Документ.ИС_Ozon_Заказ КАК ИС_Ozon_Заказ
	|ГДЕ
	|	ИС_Ozon_Заказ.ЗаказФБО
	|	И ИС_Ozon_Заказ.Профиль = &Профиль
	|
	|УПОРЯДОЧИТЬ ПО
	|	Дата УБЫВ";
	//- ИнфоСофт Стояк Ю.К. 03.03.2025 УА #93469
	
	Запрос.УстановитьПараметр("Профиль", Профиль);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Выборка = РезультатЗапроса.Выбрать();
	
	Пока Выборка.Следующий() Цикл
		//+ ИнфоСофт Стояк Ю.К. 03.03.2025 УА #93469
		//Дата = Выборка.Дата;
		Если Выборка.ЗаказФБО Тогда
			ДатаФБО = Выборка.Дата; 
		Иначе
			Дата = Выборка.Дата;
		КонецЕсли;                                  
		//- ИнфоСофт Стояк Ю.К. 03.03.2025 УА #93469
	КонецЦикла; 
	
	//+ ИнфоСофт Стояк Ю.К. 03.03.2025 УА #93469
	Если Дата = Дата(1,1,1) Тогда
		Дата = ДатаФБО;
	ИначеЕсли ДатаФБО = Дата(1,1,1) Тогда
		ДатаФБО = Дата;
	Иначе
		Дата = НачалоДня(ТекущаяДатаСеанса());
		ДатаФБО = Дата;
	КонецЕсли;
	//- ИнфоСофт Стояк Ю.К. 03.03.2025 УА #93469
	 
КонецПроцедуры //- ИнфоСофт Стояк Ю.К. 20.03.2023 УА #54628

//+ ИнфоСофт Стояк Ю.К. 03.03.2025 УА #93469 
&НаСервере
Процедура ПолучитьОпциюРаботыСФБО(ВключенаРаботаСоСхемойФБО) 
		
	МассивНаименованийПараметров = Новый Массив;  		
	МассивНаименованийПараметров.Добавить("ЗагружатьЗаказыПоСхемеФБО");
	
