//+ ИнфоСофт Ивонин К.А. 29.09.23 УА #64020
&НаКлиенте
Процедура ОбработкаОповещения(ИмяСобытия, Параметр, Источник)
	
	Если ИмяСобытия = "ВыборСклада" Тогда
		Склад = Параметр.Склад; 
		//+ ИнфоСофт Заварин К.В. 11.04.25 УА #77376
		Грузоместа = Параметр.Грузоместа;
		//- ИнфоСофт Заварин К.В. 11.04.25 УА #77376
		Если Не ЗначениеЗаполнено(Склад) Тогда
			ОбщегоНазначенияКлиент.СообщитьПользователю(
			"Выберите корректный склад");
			Возврат;
		КонецЕсли;
		
		//+ ИнфоСофт Заварин К.В. 11.04.25 УА #77376
		//Файл = АктИНакладнаяНаСервере(Склад);
		Файл = АктИНакладнаяНаСервере(Склад, Грузоместа); 
		//- ИнфоСофт Заварин К.В. 11.04.25 УА #77376
		
		Если Не ЗначениеЗаполнено(Файл) Тогда
			Возврат;
		КонецЕсли;
		
		ИмяКаталогаВременныхФайлов = КаталогВременныхФайлов();  
		
		ИмяВременногоФайла = ИмяКаталогаВременныхФайлов + "ActFile.pdf";
		Файл.Записать(ИмяВременногоФайла);
		
		НачатьЗапускПриложения(Новый ОписаниеОповещения, ИмяВременногоФайла);
		
	КонецЕсли;
	
КонецПроцедуры //- ИнфоСофт Ивонин К.А. 29.09.23 УА #64020

