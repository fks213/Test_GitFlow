&НаСервере
Процедура ПрисвоитьТрекНомерЗавершение(ТрекНомер, СтруктураПараметров) Экспорт

	Если ЗначениеЗаполнено(ТрекНомер) Тогда
		
		СтруктураДанных = Новый Структура;
		СтруктураДанных.Вставить("posting_number", СтруктураПараметров.НомерОтправления);
		СтруктураДанных.Вставить("tracking_number", СокрЛП(ТрекНомер));
			
		Результат = ИС_Ozon_Сервер.УстановитьТрекНомерОтправления(Профиль, СтруктураДанных);
		
		Если Результат = Неопределено Тогда
			Сообщить("Не удалось присвоить трек-номер");
		Иначе
			ЗаказОбъект = СтруктураПараметров.Заказ.ПолучитьОбъект();
			ЗаказОбъект.tracking_number = ТрекНомер;
			ЗаказОбъект.Записать();		
		КонецЕсли;
		
	КонецЕсли;

КонецПроцедуры //- ИнфоСофт Конышев А.Е. 06.12.24 УА #77791

