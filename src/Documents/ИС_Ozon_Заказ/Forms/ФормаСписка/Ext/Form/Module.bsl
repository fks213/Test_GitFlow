&НаКлиенте
Процедура ПечатьКомпактныхЭтикеток(Команда)
		
	ВыделенныеСтроки = Элементы.Список.ВыделенныеСтроки;

	Если ВыделенныеСтроки.Количество() = 0 Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю("Необходимо выбрать отправления");
		Возврат;
	КонецЕсли;
	
	МассивФайлов = ПечатьКомпактныхЭтикетокНаСервере(ВыделенныеСтроки); 
	
	Если Не ЗначениеЗаполнено(МассивФайлов) Тогда
		
		//+ ИнфоСофт Заварин К.В. 20.09.24 УА #84102
		ОбщегоНазначенияКлиент.СообщитьПользователю("Компактные этикетки не были найдены. Проверьте настройку подключения компактных этикеток."); 
		//- ИнфоСофт Заварин К.В. 20.09.24 УА #84102
		
