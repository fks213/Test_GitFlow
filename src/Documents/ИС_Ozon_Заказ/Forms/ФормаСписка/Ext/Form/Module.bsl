//+ ИнфоСофт Стояк Ю.К. 21.03.2023 УА #54628
&НаКлиенте
Процедура СписокВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	ТекДанные = Элемент.ТекущиеДанные; 
	
	Если ТекДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если Поле = Элементы.Заказ Тогда
		
		СтандартнаяОбработка = Ложь;
		
		Если Элемент.ТекущиеДанные.Заказ.Пустая() Тогда
			Возврат;
		КонецЕсли;
		
		ПоказатьЗначение(, Элемент.ТекущиеДанные.Заказ);
	
	ИначеЕсли Поле = Элементы.Реализация Тогда
		
		СтандартнаяОбработка = Ложь;
		
		Если Не ЗначениеЗаполнено(Элемент.ТекущиеДанные.Реализация) Тогда
			Возврат;
		ИначеЕсли ТипЗнч(Элемент.ТекущиеДанные.Реализация) = Тип("ДокументСсылка.РеализацияТоваровУслуг") Тогда
			ПоказатьЗначение(, Элемент.ТекущиеДанные.Реализация);
		Иначе
			ПараметрыФормы = Новый Структура;
			ПараметрыФормы.Вставить("Заказ", Элемент.ТекущиеДанные.Заказ);
			//+ ИнфоСофт Стояк Ю.К. 26.12.2024 УА #90201
			ПараметрыФормы.Вставить("ДокументыРеализации", Истина);
			//- ИнфоСофт Стояк Ю.К. 26.12.2024 УА #90201
			ОткрытьФорму("ОбщаяФорма.ИС_WB_ФормаРТУ", ПараметрыФормы);
		КонецЕсли
		
	//+ ИнфоСофт Конышев А.Е. 10.12.24 УА #77940
	ИначеЕсли Поле = Элементы.РасходныйОрдер Тогда
		
		СтандартнаяОбработка = Ложь;
		
		Если Не ЗначениеЗаполнено(Элемент.ТекущиеДанные.РасходныйОрдер) Тогда
			Возврат;
		ИначеЕсли ТипЗнч(Элемент.ТекущиеДанные.РасходныйОрдер) = Тип("ДокументСсылка.РасходныйОрдерНаТовары") Тогда
			ПоказатьЗначение(, Элемент.ТекущиеДанные.РасходныйОрдер);
		//+ ИнфоСофт Стояк Ю.К. 26.12.2024 УА #90201
		Иначе
			ПараметрыФормы = Новый Структура;
			ПараметрыФормы.Вставить("Заказ", Элемент.ТекущиеДанные.Заказ);
			ПараметрыФормы.Вставить("ДокументыРеализации", Ложь);
			ОткрытьФорму("ОбщаяФорма.ИС_WB_ФормаРТУ", ПараметрыФормы);
		//- ИнфоСофт Стояк Ю.К. 26.12.2024 УА #90201
		КонецЕсли
	
	//- ИнфоСофт Конышев А.Е. 10.12.24 УА #77940
	
	КонецЕсли;
	
КонецПроцедуры //- ИнфоСофт Стояк Ю.К. 21.03.2023 УА #54628

//+ ИнфоСофт Стояк Ю.К. 20.03.2023 УА #54628
&НаКлиенте
Процедура ОтображатьСоставЗаказовПриИзменении(Элемент)         
	
	Если ОтображатьСоставЗаказов Тогда
	
		Элементы.СоставЗаказов.Видимость = Истина;
		
		ВыделенныеСтроки = Элементы.Список.ВыделенныеСтроки;

		Если ВыделенныеСтроки.Количество() = 0 Тогда
			Возврат;
		КонецЕсли;
		
		СформироватьСоставЗаказов(ВыделенныеСтроки);

	Иначе
		Элементы.СоставЗаказов.Видимость = Ложь; 
	КонецЕсли;                                                 
	
КонецПроцедуры //- ИнфоСофт Стояк Ю.К. 20.03.2023 УА #54628

//+ ИнфоСофт Ивонин К.А. 07.08.23 УА #61542
&НаСервереБезКонтекста
Процедура СписокПриПолученииДанныхНаСервере(ИмяЭлемента, Настройки, Строки)

	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ИС_Ozon_Заказproducts.Ссылка КАК Ссылка,
	|	ИС_Ozon_Заказproducts.НоменклатураOzon.offer_id КАК offer_id,
	|	ИС_Ozon_Заказproducts.quantity КАК quantity
	|ИЗ
	|	Документ.ИС_Ozon_Заказ.products КАК ИС_Ozon_Заказproducts
	|ГДЕ
	|	ИС_Ozon_Заказproducts.Ссылка В(&Ссылка)
	|ИТОГИ ПО
	|	Ссылка";
	
	Запрос.УстановитьПараметр("Ссылка", Строки.ПолучитьКлючи());
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаЗаказов = РезультатЗапроса.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	Пока ВыборкаЗаказов.Следующий() Цикл
	
		ВыборкаТоваров = ВыборкаЗаказов.Выбрать();
	
		Пока ВыборкаТоваров.Следующий() Цикл
			СтрокаСписка = Строки[ВыборкаТоваров.Ссылка];
			Попытка
	    	СтрокаСписка.Данные["Состав"] = СтрокаСписка.Данные["Состав"] 
	    		+ ВыборкаТоваров.offer_id + " - " + ВыборкаТоваров.quantity + " шт." + Символы.ПС;
			Исключение
			КонецПопытки;	
	   	КонецЦикла;
	
	КонецЦикла;

КонецПроцедуры //- ИнфоСофт Ивонин К.А. 07.08.23 УА #61542

