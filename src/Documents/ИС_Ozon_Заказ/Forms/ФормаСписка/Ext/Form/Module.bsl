	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ИС_Ozon_Заказproducts.Ссылка.Номер КАК НомерЗаказаСМаркетплейса,
	|	ИС_Ozon_Заказproducts.Ссылка.Дата КАК Дата,
	|	ИС_Ozon_Заказproducts.НоменклатураOzon.Наименование КАК НаименованиеНоменклатурыСМаркетплейса,
	|	ИС_Ozon_Заказproducts.НоменклатураOzon.Код КАК КодНоменклатурыСМаркетплейса,
	|	ИС_Ozon_СоответствиеХарактеристик.Характеристика КАК Характеристика1С,
	|	ЕСТЬNULL(ИС_Ozon_СоответствиеХарактеристик.НоменклатураOzon.offer_id, ""Отсутствует Сопоставление"") КАК АртикулПоставщикаНоменклатурыСМаркетплейса,
