&НаСервере
Функция ПолучитьЛистПодбораНаСервере(ВыделенныеСтроки) 
	
	Табдок = Новый ТабличныйДокумент;
	
	Табдок.ИмяПараметровПечати = "ИС_Ozon_ПечатьЛистаПодбора";
	ТабДок.ОриентацияСтраницы = ОриентацияСтраницы.Портрет;  
	ТабДок.АвтоМасштаб = Истина;
	
	ТабДок.ПолеСправа = 7;
	
	МакетОбработки = УправлениеПечатью.МакетПечатнойФормы("Документ.ИС_Ozon_Заказ.ПФ_MXL_ЛистПодбора");
		
	МассивЗначений = Новый Массив;
	МассивЗначений.Добавить("ПечататьНомерСтроки");       	
	МассивЗначений.Добавить("ПечататьНомерСборочного");
	МассивЗначений.Добавить("ПечататьНомерЗаказа"); 	
	МассивЗначений.Добавить("ПечататьНомерРеализации");   		
	МассивЗначений.Добавить("ПечататьНазвание");	    
	МассивЗначений.Добавить("ПечататьРазмер");	
	МассивЗначений.Добавить("ПечататьАртикулОзон");
	МассивЗначений.Добавить("ПечататьАртикул1С");	
	МассивЗначений.Добавить("ПечататьШтрихкод");
	МассивЗначений.Добавить("ПечататьКоличество");   	
	МассивЗначений.Добавить("ПечататьФото");
	
	НастройкиПечати = ИС_МП_Печать.ПолучитьНастройкиПечатиЛистаПодбора(Профиль, МассивЗначений, Перечисления.ИС_МП_Маркетплейсы.Озон);	
	
	ОбластьШапка = МакетОбработки.ПолучитьОбласть("Шапка|ОсновнойЛист");
	
	ОбластьШапка.Параметры.Дата = ТекущаяДатаСеанса();
	ОбластьШапка.Параметры.Профиль = Профиль;	
	
	Если ЗначениеЗаполнено(СортировкаПечати) Тогда	
		ОбластьШапка.Параметры.Сорт = Элементы.СортировкаПечати.СписокВыбора.НайтиПоЗначению(СортировкаПечати).Представление;
	Иначе
		СортировкаПечати = "НомерЗадания";
		ОбластьШапка.Параметры.Сорт = Элементы.СортировкаПечати.СписокВыбора.НайтиПоЗначению(СортировкаПечати).Представление;
	КонецЕсли;                                  	
	
	//+ ИнфоСофт Стояк Ю.К. 18.04.2025 УА #9864	
	//Табдок.Вывести(ОбластьШапка); 
		
	//ИС_МП_Печать.ЗаполнитьШапкуТаблицыЛистаПодбора(Табдок, МакетОбработки, НастройкиПечати, МассивЗначений);	
	//- ИнфоСофт Стояк Ю.К. 18.04.2025 УА #98648
	
	Запрос = Новый Запрос;
	Запрос.Текст =	
	"ВЫБРАТЬ
	|	ИС_Ozon_Заказ.Ссылка КАК Ссылка,
	|	ПередачаТоваровХранителюТовары.Ссылка.Номер КАК НомерРеализации
	|ПОМЕСТИТЬ ВТ_РТУ
	|ИЗ
	|	Документ.ИС_Ozon_Заказ КАК ИС_Ozon_Заказ
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ПередачаТоваровХранителю.Товары КАК ПередачаТоваровХранителюТовары
	|		ПО (ИС_Ozon_Заказ.Заказ = ПередачаТоваровХранителюТовары.ЗаказКлиента)
	|			И (НЕ ИС_Ozon_Заказ.Заказ = ЗНАЧЕНИЕ(Документ.ЗаказКлиента.ПустаяСсылка))
	|ГДЕ
	|	НЕ ИС_Ozon_Заказ.Заказ = ЗНАЧЕНИЕ(Документ.ЗаказКлиента.ПустаяСсылка)
	|	И НЕ ПередачаТоваровХранителюТовары.Ссылка ЕСТЬ NULL
	|	И ИС_Ozon_Заказ.Ссылка В(&МассивСсылок)
	|
	|ОБЪЕДИНИТЬ
	|
	|ВЫБРАТЬ
	|	ИС_Ozon_Заказ.Ссылка,
	|	РеализацияТоваровУслугТовары.Ссылка.Номер
	|ИЗ
	|	Документ.ИС_Ozon_Заказ КАК ИС_Ozon_Заказ
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.РеализацияТоваровУслуг.Товары КАК РеализацияТоваровУслугТовары
	|		ПО ИС_Ozon_Заказ.Заказ = РеализацияТоваровУслугТовары.ЗаказКлиента
	|			И (НЕ ИС_Ozon_Заказ.Заказ = ЗНАЧЕНИЕ(Документ.ЗаказКлиента.ПустаяСсылка))
	|ГДЕ
	|	НЕ ИС_Ozon_Заказ.Заказ = ЗНАЧЕНИЕ(Документ.ЗаказКлиента.ПустаяСсылка)
	|	И НЕ РеализацияТоваровУслугТовары.Ссылка ЕСТЬ NULL
	|	И ИС_Ozon_Заказ.Ссылка В(&МассивСсылок)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ИС_Ozon_Заказproducts.Ссылка.Номер КАК НомерЗадания,
	|	ИС_Ozon_Заказproducts.Ссылка.Дата КАК Дата,
	|	ИС_Ozon_Заказproducts.НоменклатураOzon.Наименование КАК Наименование,
	|	ИС_Ozon_СоответствиеХарактеристик.Характеристика КАК Размер,
	|	ЕСТЬNULL(ИС_Ozon_СоответствиеХарактеристик.НоменклатураOzon.offer_id, ""Отсутствует Сопоставление"") КАК Артикул,	
	|	Подстрока(ИС_Ozon_Заказproducts.Ссылка.Номер, СтрНайти(ИС_Ozon_Заказproducts.Ссылка.Номер, ""-"") - 4, 4) КАК НомерЭтикетки,	
	|	ЕСТЬNULL(ИС_Ozon_Заказproducts.НоменклатураOzon.Штрихкод, """""""") КАК Штрихкод,
	|	ИС_Ozon_СоответствиеХарактеристик.Номенклатура.ФайлКартинки КАК ФайлКартинки,
	|	ИС_Ozon_СоответствиеХарактеристик.Номенклатура КАК Номенклатура,	
	|	ИС_Ozon_Заказproducts.quantity КАК Количество,
	|	ИС_Ozon_СоответствиеХарактеристик.Номенклатура.Артикул КАК Артикул1С,
	|	ИС_Ozon_Заказproducts.Ссылка.Заказ.Номер КАК НомерЗаказа,
	|	ВЫБОР
	|		КОГДА ИС_Ozon_Заказproducts.Ссылка.Заказ = ЗНАЧЕНИЕ(Документ.ЗаказКлиента.ПустаяСсылка)
	|			ТОГДА """"
	|		ИНАЧЕ МИНИМУМ(ВТ_РТУ.НомерРеализации)
	|	КОНЕЦ КАК НомерРеализации               	
	|ИЗ
	|	Документ.ИС_Ozon_Заказ.products КАК ИС_Ozon_Заказproducts
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ИС_Ozon_СтатусыСборочныхЗаданий КАК ИС_Ozon_СтатусыСборочныхЗаданий
	|		ПО (ИС_Ozon_Заказproducts.Ссылка = ИС_Ozon_СтатусыСборочныхЗаданий.Заказ)
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ИС_Ozon_СоответствиеХарактеристик КАК ИС_Ozon_СоответствиеХарактеристик
	|		ПО (ИС_Ozon_СоответствиеХарактеристик.НоменклатураOzon.Ссылка = ИС_Ozon_Заказproducts.НоменклатураOzon.Ссылка)		
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_РТУ КАК ВТ_РТУ
	|		ПО ИС_Ozon_Заказproducts.Ссылка = ВТ_РТУ.Ссылка
	|ГДЕ
	|	ИС_Ozon_Заказproducts.Ссылка В (&МассивСсылок)
	|	И ИС_Ozon_СтатусыСборочныхЗаданий.status <> ЗНАЧЕНИЕ(Перечисление.ИС_Ozon_СтатусыОтправлений.cancelled)
	|	И ИС_Ozon_СтатусыСборочныхЗаданий.status.Порядок <> ЗНАЧЕНИЕ(Перечисление.ИС_Ozon_СтатусыОтправлений.cancelled_from_split_pending)
	|
	|СГРУППИРОВАТЬ ПО
	|	ИС_Ozon_Заказproducts.Ссылка.Номер,
	|	ИС_Ozon_Заказproducts.Ссылка.Дата,
	|	ИС_Ozon_Заказproducts.НоменклатураOzon.Наименование,
	|	ИС_Ozon_СоответствиеХарактеристик.Характеристика,
	|	ИС_Ozon_СоответствиеХарактеристик.Номенклатура.ФайлКартинки,
	|	ИС_Ozon_СоответствиеХарактеристик.Номенклатура,	
	|	ИС_Ozon_Заказproducts.quantity,
	|	ИС_Ozon_СоответствиеХарактеристик.Номенклатура.Артикул,
	|	ИС_Ozon_Заказproducts.Ссылка.Заказ.Номер,
	|	ЕСТЬNULL(ИС_Ozon_СоответствиеХарактеристик.НоменклатураOzon.offer_id, ""Отсутствует Сопоставление""),
	|	ЕСТЬNULL(ИС_Ozon_Заказproducts.НоменклатураOzon.Штрихкод, """"""""),
	|	ИС_Ozon_Заказproducts.Ссылка.Заказ	
	|
	|УПОРЯДОЧИТЬ ПО
	|	%1";

	БуферСортировкаПечати = СортировкаПечати;  
	Если БуферСортировкаПечати = "Наименование" Тогда
		БуферСортировкаПечати = "Наименование, Размер";
	ИначеЕсли БуферСортировкаПечати = "offer_id" Тогда		
		БуферСортировкаПечати = "Артикул";
	КонецЕсли;
		
	Запрос.Текст = СтрШаблон(Запрос.Текст, БуферСортировкаПечати);
	
	Запрос.УстановитьПараметр("МассивСсылок", ВыделенныеСтроки);

	РезультатЗапроса = Запрос.Выполнить();
	
	Если РезультатЗапроса.Пустой() Тогда
		ОбщегоНазначения.СообщитьПользователю("Не удалось сформировать лист подбора");
		Возврат Табдок;	
	КонецЕсли;
	
	Эталон = УправлениеПечатью.МакетПечатнойФормы("ОбщийМакет.ИС_МП_Эталон");
	
	КоличествоМиллиметровВПикселе = Эталон.Рисунки.Квадрат100Пикселей.Высота / 100;
					
	Выборка = РезультатЗапроса.Выбрать();
	
	//+ ИнфоСофт Стояк Ю.К. 18.04.2025 УА #98648
	ОбластьШапка.Параметры.КоличествоЗаданий = Выборка.Количество();
	Табдок.Вывести(ОбластьШапка); 
	ИС_МП_Печать.ЗаполнитьШапкуТаблицыЛистаПодбора(Табдок, МакетОбработки, НастройкиПечати, МассивЗначений);	
	//- ИнфоСофт Стояк Ю.К. 18.04.2025 УА #98648
	
	ВысотаОбластей = Табдок.ВысотаТаблицы;
	
	Если ВыводитьКомплектующие Тогда
			
		Запрос = Новый Запрос;
		Запрос.Текст =	
		"ВЫБРАТЬ
		|	ВТ.НомерЗадания КАК НомерЗадания,
		|	ВТ.Номенклатура КАК Номенклатура,		
		|	ВТ.Размер КАК Размер,
		|	ВТ.Штрихкод КАК Штрихкод		
		|	ПОМЕСТИТЬ ВТ_Номенклатура
		|ИЗ
		|	&ВТ КАК ВТ
		|;
		|		
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ВТ_Номенклатура.НомерЗадания КАК НомерЗадания,
		|	ВТ_Номенклатура.Номенклатура КАК Номенклатура,		
		|	ВТ_Номенклатура.Размер КАК Размер,
		|	ВТ_Номенклатура.Штрихкод КАК Штрихкод,
		|	ВариантыКомплектацииНоменклатурыТовары.Номенклатура КАК НоменклатураНабора,
		|	ВариантыКомплектацииНоменклатурыТовары.Характеристика КАК ХарактеристикаНабора,
		|	ВариантыКомплектацииНоменклатурыТовары.КоличествоУпаковок КАК КоличествоУпаковок,
		|	ВариантыКомплектацииНоменклатурыТовары.Номенклатура.ФайлКартинки КАК ФайлКартинки,
		|	ВариантыКомплектацииНоменклатурыТовары.Номенклатура.Артикул КАК Артикул
		|ИЗ
		|	СоставНаборов.НоменклатураНабора <> ЗНАЧЕНИЕ(Справочник.Номенклатура.ПустаяСсылка)
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ВариантыКомплектацииНоменклатуры.Товары КАК ВариантыКомплектацииНоменклатурыТовары
		|		ПО ВТ_Номенклатура.Номенклатура = ВариантыКомплектацииНоменклатурыТовары.Ссылка.Владелец
		|			И ВТ_Номенклатура.Размер = ВариантыКомплектацииНоменклатурыТовары.Ссылка.Характеристика
		|ГДЕ
		|	ВариантыКомплектацииНоменклатурыТовары.Ссылка.Владелец <> ЗНАЧЕНИЕ(Справочник.Номенклатура.ПустаяСсылка)
		|
		|УПОРЯДОЧИТЬ ПО
		|	ВариантыКомплектацииНоменклатурыТовары.Номенклатура.Наименование";     
		
		Запрос.УстановитьПараметр("ВТ", РезультатЗапроса.Выгрузить());
		
		РезультатЗапроса = Запрос.Выполнить();
		
		ВыгрузкаНаборы = РезультатЗапроса.Выгрузить(); 
		
	КонецЕсли; 
		
	НомерСтроки = 0; 
	
	//+ ИнфоСофт Стояк Ю.К. 18.04.2025 УА #98648
	МассивВыведенныхЗаказов = Новый Массив;
	//- ИнфоСофт Стояк Ю.К. 18.04.2025 УА #98648
	
	Пока Выборка.Следующий() Цикл 
		
		ОбластьВыведена = Ложь; 
		
