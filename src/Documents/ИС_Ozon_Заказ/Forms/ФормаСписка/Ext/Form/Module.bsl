//+ ИнфоСофт Стояк Ю.К. 20.03.2023 УА #54628
&НаСервере   
Процедура СформироватьСоставЗаказов(ВыделенныеСтроки)
	
	СоставЗаказов.Очистить();
	
	Для Каждого Строка Из ВыделенныеСтроки Цикл
		Если ТипЗнч(Строка) = Тип("СтрокаГруппировкиДинамическогоСписка") Тогда
			Возврат;
		КонецЕсли;
	КонецЦикла;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ИС_Ozon_Заказproducts.Ссылка КАК Ссылка,
	|	ИС_Ozon_Заказproducts.НоменклатураOzon КАК Номенклатура,
	|	ИС_Ozon_Заказproducts.ХарактеристикаOzon КАК Штрихкод,
	|	ИС_Ozon_Заказproducts.quantity КАК Количество,
	|	ИС_Ozon_Заказproducts.Сумма КАК Сумма,
	|	ИС_Ozon_Заказproducts.price КАК Цена
	|ИЗ
	|	Документ.ИС_Ozon_Заказ.products КАК ИС_Ozon_Заказproducts
	|ГДЕ
	|	ИС_Ozon_Заказproducts.Ссылка В(&ВыделенныеСтроки)
	|
	|УПОРЯДОЧИТЬ ПО
	|	ИС_Ozon_Заказproducts.Ссылка.Дата УБЫВ";
	
	Запрос.УстановитьПараметр("ВыделенныеСтроки", ВыделенныеСтроки);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Выборка = РезультатЗапроса.Выбрать();
	
	Пока Выборка.Следующий() Цикл
		НоваяСтрока = СоставЗаказов.Добавить();
		НоваяСтрока.Заказ = Выборка.Ссылка;
		НоваяСтрока.Номенклатура = Выборка.Номенклатура;		
		НоваяСтрока.Штрихкод = Выборка.Штрихкод;
		НоваяСтрока.Количество = Выборка.Количество;		
		НоваяСтрока.Цена = Выборка.Цена;	
		НоваяСтрока.Сумма = Выборка.Сумма;	
	КонецЦикла;		
	
КонецПроцедуры //- ИнфоСофт Стояк Ю.К. 20.03.2023 УА #54628

