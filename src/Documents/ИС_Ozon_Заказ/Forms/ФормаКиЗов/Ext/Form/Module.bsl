#Область ОбработчикиСобытийФормы

//+ ИнфоСофт Мурсалимов Д.Р. 20.04.24 УА #74269
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка) 
	
	Если Параметры.Свойство("Профиль") Тогда
		Профиль = Параметры.Профиль;
	Иначе
		Отказ = Истина;
		ОбщегоНазначения.СообщитьПользователю("Не выбран Профиль");
	КонецЕсли; 
	
	Если Параметры.Свойство("СборочныеЗадания") Тогда
		ЗаполнитьТаблицуВыгрузки(Профиль, Параметры.СборочныеЗадания);
	Иначе
		ОбщегоНазначения.СообщитьПользователю("Нет данных для выгрузки КиЗов");
	КонецЕсли;
	
	//+ ИнфоСофт Заварин К.В. 04.04.25 УА #95143
	ОбщегоНазначенияУТ.НастроитьПодключаемоеОборудование(ЭтаФорма);
	//- ИнфоСофт Заварин К.В. 04.04.25 УА #95143
	
КонецПроцедуры //- ИнфоСофт Мурсалимов Д.Р. 20.04.24 УА #74269 

//+ ИнфоСофт Заварин К.В. 04.04.25 УА #95143
&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	ЭтаФорма.ИспользоватьПодключаемоеОборудование = Истина;
	МенеджерОборудованияКлиент.НачатьПодключениеОборудованиеПриОткрытииФормы(Неопределено, ЭтаФорма, "СканерШтрихкода");
	
КонецПроцедуры //- ИнфоСофт Заварин К.В. 04.04.25 УА #95143

//+ ИнфоСофт Заварин К.В. 04.04.25 УА #95143
&НаКлиенте
Процедура ПриЗакрытии(ЗавершениеРаботы)
	
	МенеджерОборудованияКлиент.НачатьОтключениеОборудованиеПриЗакрытииФормы(Неопределено, ЭтаФорма);
	
КонецПроцедуры //- ИнфоСофт Заварин К.В. 04.04.25 УА #95143

//+ ИнфоСофт Заварин К.В. 04.04.25 УА #95143
&НаКлиенте
Процедура ОбработкаОповещения(ИмяСобытия, Параметр, Источник)
	
	Если Источник = "ПодключаемоеОборудование" И ВводДоступен() Тогда
		Если ИмяСобытия = "ScanData" И МенеджерОборудованияУТКлиент.ЕстьНеобработанноеСобытие() Тогда
			СтруктураШтрихкод = МенеджерОборудованияУТКлиент.ПреобразоватьДанныеСоСканераВСтруктуру(Параметр);
			ОбработатьШтрихкоды(СтруктураШтрихкод);
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры //- ИнфоСофт Заварин К.В. 04.04.25 УА #95143

#КонецОбласти

#Область ОбработчикиКомандФормы 

//+ ИнфоСофт Мурсалимов Д.Р. 20.04.24 УА #74269
&НаКлиенте
Процедура ВыгрузитьКиЗы(Команда)
	
	ОчиститьСообщения();
	
	Если Не ЗначениеЗаполнено(Профиль) Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю("Не выбран профиль", , , "Профиль");
		Возврат;
	КонецЕсли;
	
	Если ДанныеКВыгрузке.Количество() = 0 Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю("Нет данных для выгрузки");
		Возврат;
	КонецЕсли;
	
	НеЗаполненКиз = Ложь;
	
	Для Каждого Строка Из ДанныеКВыгрузке Цикл
		
		Если Не ЗначениеЗаполнено(Строка.КодМаркировки) Тогда
			НеЗаполненКиз = Истина;  
			Прервать;
		КонецЕсли;
		
	КонецЦикла;
	
	Если НеЗаполненКиз Тогда
		
		Оповещение = Новый ОписаниеОповещения("ВыгрузитьКиЗыЗавершение", ЭтотОбъект, Параметры);
		СтандартныеПодсистемыКлиент.ПоказатьВопросПользователю(Оповещение, 
		НСтр("ru = 'В выгружаемых данных КиЗ должен быть заполнен. Уверены что хотите выгрузить КиЗы?'"), 
		РежимДиалогаВопрос.ДаНет);
		
	Иначе
		ВыгрузитьКиЗыНаСервере();
	КонецЕсли;
	
КонецПроцедуры //- ИнфоСофт Мурсалимов Д.Р. 20.04.24 УА #74269

#КонецОбласти

#Область СлужебныеПроцедурыИФункции 

//+ ИнфоСофт Мурсалимов Д.Р. 19.04.24 УА #74269
&НаСервере
Процедура ЗаполнитьТаблицуВыгрузки(Профиль, МассивЗаказов)
	
	ТЗ_Заказы = Новый ТаблицаЗначений;
	
	ТЗ_Заказы.Колонки.Добавить("НомерОтправления");
	
	//+ ИнфоСофт Заварин К.В. 22.03.25 УА #79811
	//ТЗ_Заказы.Колонки.Добавить("Заказ1С");
