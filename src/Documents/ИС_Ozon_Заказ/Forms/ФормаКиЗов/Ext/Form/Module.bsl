	//- ИнфоСофт Ивонин К.А. 04.02.25 УА #92887
		
		ЗапросРТУ.Текст = 
		"ВЫБРАТЬ
		|	ИС_Ozon_Заказ.Заказ КАК Заказ,
		|	ИС_Ozon_Заказ.Номер КАК Номер,
		|	ИС_Ozon_Заказproducts.НоменклатураOzon.offer_id КАК offer_id,
		|	ИС_Ozon_Заказproducts.quantity КАК quantity,
		|	ИС_Ozon_СоответствиеХарактеристик.Номенклатура КАК Номенклатура,
		|	ИС_Ozon_СоответствиеХарактеристик.Характеристика КАК Характеристика,
		|	ИС_Ozon_СоответствиеХарактеристик.НоменклатураOzon.sku КАК product_id,
		//+ ИнфоСофт Заварин К.В. 21.03.25 УА #79811
		|	ИС_Ozon_Заказproducts.requiring_gtd КАК requiring_gtd
		//- ИнфоСофт Заварин К.В. 21.03.25 УА #79811
		|ПОМЕСТИТЬ ВТ_Номенклатура
		|ИЗ
		|	Документ.ИС_Ozon_Заказ.products КАК ИС_Ozon_Заказproducts
		|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ИС_Ozon_Заказ КАК ИС_Ozon_Заказ
