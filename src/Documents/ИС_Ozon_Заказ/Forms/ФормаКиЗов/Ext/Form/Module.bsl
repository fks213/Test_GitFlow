	ТЗ_Заказы.Колонки.Добавить("НеобходимаПередачаГТД");
	//- ИнфоСофт Заварин К.В. 18.03.25 УА #79811
	
	НомерСтр = 1;
	
	ТекНоменклатура = Неопределено;
	ТекХарактеристика = Неопределено;
	ТекРеализацияТоваровУслуг = Неопределено;
	
