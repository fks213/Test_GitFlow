		КонецЕсли;
		
		Для Каждого Элемент Из МассивКизов Цикл 
			
			//+ ИнфоСофт Мурсалимов Д.Р. 05.08.24 УА #80967
			КодМаркировки = ИС_MP_Маркировка.ПолучитьКизНоменклатуры(Элемент);
			
			Строка.КодМаркировки = КодМаркировки;
			//- ИнфоСофт Мурсалимов Д.Р. 05.08.24 УА #80967
						
			ТЗ_КиЗы.Удалить(Элемент);
			
			Прервать;
			
		КонецЦикла;	
		
	КонецЦикла;
	
	Для Каждого Строка Из ТЗ_Заказы Цикл 
		
		СтруктураДанных = Новый Структура;
		СтруктураДанных.Вставить("posting_number", Строка.НомерОтправления);
		
		Результат = ИС_Ozon_Сервер.ПолучитьДанныеСозданныхЭкземпляров(Профиль, СтруктураДанных);  
		
		Если Результат = Неопределено Тогда			
			ОбщегоНазначения.СообщитьПользователю("Получение данных по созданным экземплярам завершилось с ошибкой");
			Продолжить;
		КонецЕсли; 
		
		Для Каждого Product Из Результат.products Цикл 
			
			Отбор = Новый Структура(); 	
			Отбор.Вставить("product_id", Product.product_id); 
			Отбор.Вставить("НомерОтправления", Строка.НомерОтправления);
			
			МассивЗаказов = ТЗ_Заказы.НайтиСтроки(Отбор);                 
			
			Если МассивЗаказов.Количество() = 0 Тогда
				Продолжить;	
			КонецЕсли; 
			
			Для Каждого Экземпляр Из Product.exemplars Цикл
				
				Для Каждого Элемент Из МассивЗаказов Цикл 
					
					Если ЗначениеЗаполнено(Элемент.exemplar_id) Тогда
						Продолжить;
					КонецЕсли;
					
					Элемент.exemplar_id = Экземпляр.exemplar_id;
					Прервать;
					
				КонецЦикла;
				
			КонецЦикла;
			
		КонецЦикла;
		
	КонецЦикла; 
	
	Для Каждого Строка Из ТЗ_Заказы Цикл 
		
		НоваяСтрока = ДанныеКВыгрузке.Добавить();		
		//+ ИнфоСофт Заварин К.В. 18.03.25 УА #79811
		//ЗаполнитьЗначенияСвойств(НоваяСтрока, Строка, "НомерОтправления,Номенклатура,Характеристика,КодМаркировки,offer_id,product_id,exemplar_id");     
		ЗаполнитьЗначенияСвойств(НоваяСтрока, Строка, "НомерОтправления,Номенклатура,Характеристика,КодМаркировки, НеобходимаПередачаГТД, НомерГТД,offer_id,product_id,exemplar_id");    
		//- ИнфоСофт Заварин К.В. 18.03.25 УА #79811
		
	КонецЦикла;
	
КонецПроцедуры //- ИнфоСофт Мурсалимов Д.Р. 19.04.24 УА #74269	

//+ ИнфоСофт Мурсалимов Д.Р. 20.04.24 УА #70514
&НаСервере
Процедура ВыгрузитьКиЗыНаСервере()
	
	Запрос = Новый Запрос;
	
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ВТ_ДанныеПоКизам.product_id КАК product_id,
	|	ВТ_ДанныеПоКизам.exemplar_id КАК exemplar_id,
	|	ВТ_ДанныеПоКизам.НомерОтправления КАК НомерОтправления,
	//+ ИнфоСофт Заварин К.В. 18.03.25 УА #79811              
	|	ВТ_ДанныеПоКизам.НомерГТД КАК НомерГТД,
	|	ВТ_ДанныеПоКизам.НеобходимаПередачаГТД КАК НеобходимаПередачаГТД,
	//- ИнфоСофт Заварин К.В. 18.03.25 УА #79811
	|	ВТ_ДанныеПоКизам.КодМаркировки КАК КодМаркировки
	|ПОМЕСТИТЬ ВТ_ДанныеКиЗов
	|ИЗ
	|	&ВТ_ДанныеПоКизам КАК ВТ_ДанныеПоКизам
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_ДанныеКиЗов.product_id КАК product_id,
	|	ВТ_ДанныеКиЗов.exemplar_id КАК exemplar_id,
	|	ВТ_ДанныеКиЗов.НомерОтправления КАК НомерОтправления,
	//+ ИнфоСофт Заварин К.В. 18.03.25 УА #79811              
	|	ВТ_ДанныеКиЗов.НомерГТД КАК НомерГТД,
	|	ВТ_ДанныеКиЗов.НеобходимаПередачаГТД КАК НеобходимаПередачаГТД,
	//- ИнфоСофт Заварин К.В. 18.03.25 УА #79811
	|	ВТ_ДанныеКиЗов.КодМаркировки КАК КодМаркировки
	|ИЗ
	|	ВТ_ДанныеКиЗов КАК ВТ_ДанныеКиЗов
	|ИТОГИ ПО
	|	НомерОтправления,
	|	product_id";
	
	Запрос.УстановитьПараметр("ВТ_ДанныеПоКизам", ДанныеКВыгрузке.Выгрузить());
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаНомерОтправления = РезультатЗапроса.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	//+ ИнфоСофт Заварин К.В. 04.04.25 УА #95143 
	РазделительGS1 = МенеджерОборудованияМаркировкаКлиентСервер.РазделительGS1();
	ЭкранированныйСимволGS1 = "\u001d";
	//- ИнфоСофт Заварин К.В. 04.04.25 УА #95143
	
	Пока ВыборкаНомерОтправления.Следующий() Цикл
	
		ВыборкаProductId = ВыборкаНомерОтправления.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
		
		МассивProducts = Новый Массив;

		Пока ВыборкаProductId.Следующий() Цикл
			
			СтруктураProducts = Новый Структура;
			
			ВыборкаКиЗов = ВыборкаProductId.Выбрать();   	 
			
			МассивЭкземпляров = Новый Массив;
			
			Пока ВыборкаКиЗов.Следующий() Цикл
				
				СтруктураЭкземпляров = Новый Структура;
				
				СтруктураЭкземпляров.Вставить("exemplar_id", 	ВыборкаКиЗов.exemplar_id);
				//+ ИнфоСофт Заварин К.В. 18.03.25 УА #79811
				Если ВыборкаКиЗов.НеобходимаПередачаГТД И Не ПустаяСтрока(ВыборкаКиЗов.НомерГТД) Тогда
					СтруктураЭкземпляров.Вставить("gtd", 		ВыборкаКиЗов.НомерГТД);
				ИначеЕсли ВыборкаКиЗов.НеобходимаПередачаГТД И ПустаяСтрока(ВыборкаКиЗов.НомерГТД) Тогда
					СтруктураЭкземпляров.Вставить("is_gtd_abscent", Истина);	
				КонецЕсли; 
				
				Если Не ПустаяСтрока(ВыборкаКиЗов.КодМаркировки) Тогда
					//+ ИнфоСофт Заварин К.В. 04.04.25 УА #95143
					//СтруктураЭкземпляров.Вставить("mandatory_mark", ВыборкаКиЗов.КодМаркировки);
					
					КодМаркировкиGS1 = СтрЗаменить(ВыборкаКиЗов.КодМаркировки, ЭкранированныйСимволGS1, РазделительGS1);
					СтруктураЭкземпляров.Вставить("mandatory_mark", КодМаркировкиGS1);
					//- ИнфоСофт Заварин К.В. 04.04.25 УА #95143
				КонецЕсли;	
				
				//СтруктураЭкземпляров.Вставить("mandatory_mark", ВыборкаКиЗов.КодМаркировки);
				//- ИнфоСофт Заварин К.В. 18.03.25 УА #79811
				
				МассивЭкземпляров.Добавить(СтруктураЭкземпляров);	
				
			КонецЦикла;                                           
			
			СтруктураProducts.Вставить("exemplars", 	МассивЭкземпляров);
			СтруктураProducts.Вставить("product_id", 	ВыборкаProductId.product_id); 
			
			МассивProducts.Добавить(СтруктураProducts);
			
		КонецЦикла;
		
		СтруктураДанных = Новый Структура;
			
		СтруктураДанных.Вставить("products", 		МассивProducts);
		СтруктураДанных.Вставить("posting_number", 	ВыборкаНомерОтправления.НомерОтправления);
		
		Результат = ИС_Ozon_Сервер.ПрикрепитьКиз(Профиль, СтруктураДанных);

		Если Результат = Неопределено Тогда
			Продолжить;
		Иначе
			
			Отбор = Новый Структура("НомерОтправления", ВыборкаНомерОтправления.НомерОтправления);
			НайденныеСтроки = ДанныеКВыгрузке.НайтиСтроки(Отбор);
			
			Для Каждого Строка Из НайденныеСтроки Цикл
				Строка.Выгружен = Истина;
				
				//+ ИнфоСофт Заварин К.В. 20.02.25 УА #73904
				МассивКодов = Новый Массив;
				
				МассивКодов.Добавить(Строка);
				
				ЗаказМП = Документы.ИС_Ozon_Заказ.НайтиПоНомеру(ВыборкаНомерОтправления.НомерОтправления);
				ИС_MP_Сервер.ЗаписатьДанныеКИЗ(Профиль, Перечисления.ИС_МП_Маркетплейсы.Озон, ЗаказМП, МассивКодов); 	
				//- ИнфоСофт Заварин К.В. 20.02.25 УА #73904
				
			КонецЦикла;
				
		КонецЕсли;
	
	КонецЦикла;
	
КонецПроцедуры //- ИнфоСофт Мурсалимов Д.Р. 20.04.24 УА #70514 

//+ ИнфоСофт Мурсалимов Д.Р. 01.11.23 УА #62673
&НаКлиенте
Процедура ВыгрузитьКиЗыЗавершение(Результат, Параметры) Экспорт
	
	Если Результат.Значение = КодВозвратаДиалога.Да Тогда 
		ВыгрузитьКиЗыНаСервере();
	Иначе
		ОбщегоНазначенияКлиент.СообщитьПользователю("Выгрузка КиЗов отменена!");
	КонецЕсли;
	
КонецПроцедуры
//- ИнфоСофт Мурсалимов Д.Р. 01.11.23 УА #62673 

//+ ИнфоСофт Заварин К.В. 03.04.25 УА #95143
&НаКлиенте
Процедура ОбработатьШтрихкоды(Данные)
	
	СчитанныйШтрихкод = Данные.Штрихкод;
	
	РазделительGS1 = МенеджерОборудованияМаркировкаКлиентСервер.РазделительGS1();
	ЭкранированныйСимволGS1 = "";
	
	КодМаркировки = СтрЗаменить(СчитанныйШтрихкод, РазделительGS1, ЭкранированныйСимволGS1); 
	
	ПолныйКодМаркировки = КодМаркировки;
	
	КодМаркировки = ОбработатьШтрихкодыНаСервере(КодМаркировки);
	
	Отбор = Новый Структура("КодМаркировки", КодМаркировки);
	НайденныеСтроки = ДанныеКВыгрузке.НайтиСтроки(Отбор);
	
	ЭкранированныйСимволGS1 = "\u001d";
	
	ПолныйКодМаркировки = СтрЗаменить(СчитанныйШтрихкод, РазделительGS1, ЭкранированныйСимволGS1);
	
	Если Не НайденныеСтроки.Количество() = 0 Тогда
		Для Каждого Строка Из НайденныеСтроки Цикл
			Строка.КодМаркировки = ПолныйКодМаркировки;
		КонецЦикла;	   
	Иначе
		Для Каждого Элемент Из Элементы.ДанныеКВыгрузке.ВыделенныеСтроки Цикл 
			ДанныеКВыгрузке[Элемент].КодМаркировки = ПолныйКодМаркировки;
		КонецЦикла;
	КонецЕсли;
	
КонецПроцедуры 	//- ИнфоСофт Заварин К.В. 03.04.25 УА #95143


//+ ИнфоСофт Заварин К.В. 03.04.25 УА #95143
&НаСервере
Функция ОбработатьШтрихкодыНаСервере(ДанныеШтрихкода)
			
	Данные = Новый Структура; 
	
	Данные.Вставить("ЗначениеШтрихкода", ДанныеШтрихкода);
	
	КодМаркировки = ИС_MP_Маркировка.ПолучитьКизНоменклатуры(Данные);
	
	Возврат	КодМаркировки;  
	
КонецФункции //- ИнфоСофт Заварин К.В. 03.04.25 УА #95143

#КонецОбласти
