//+ ИнфоСофт Стояк Ю.К. 15.04.2025 УА #98648
&НаСервере
Функция ВыполнитьПечатьШтрихкода(Штрихкод)
	
	Данные = ПолучитьДанныеДляФормированияШтрихкода(Штрихкод);
	
	Если ТипШтрихкода = 0 Тогда
		Макет = УправлениеПечатью.МакетПечатнойФормы("Документ.ИС_Ozon_УпаковкаТоваров.ПФ_MXL_Штрихкод58х40_Ozon");
	ИначеЕсли ТипШтрихкода = 1 Тогда 
		Макет = УправлениеПечатью.МакетПечатнойФормы("Документ.ИС_Ozon_УпаковкаТоваров.ПФ_MXL_Штрихкод43х25_Ozon");
	ИначеЕсли ТипШтрихкода = 2 Тогда 
		Макет = УправлениеПечатью.МакетПечатнойФормы("Документ.ИС_Ozon_УпаковкаТоваров.ПФ_MXL_Штрихкод30х20_Ozon");
	КонецЕсли;
	
	ТабличныйДокумент = Новый ТабличныйДокумент;
	ТабличныйДокумент.ОриентацияСтраницы = ОриентацияСтраницы.Портрет;
	ТабличныйДокумент.ИмяПараметровПечати = "Этикетка";		
	
	ОбластьМакетаОсновныеДанные = Макет.ПолучитьОбласть("Этикетка"); 
	
	ОбластьМакетаОсновныеДанные.Параметры.Заполнить(Данные);
	
	Эталон = УправлениеПечатью.МакетПечатнойФормы("ОбщийМакет.ИС_МП_Эталон"); 
	КоличествоМиллиметровВПикселе = Эталон.Рисунки.Квадрат100Пикселей.Высота / 100;
	
	ПараметрыШК = ИС_MP_ГенерацияШтрихкода.ПараметрыГенерацииШтрихкода();
	
	ПараметрыШК.Ширина = Окр(ОбластьМакетаОсновныеДанные.Рисунки.Штрихкод.Ширина / КоличествоМиллиметровВПикселе);
	ПараметрыШК.Высота = Окр(ОбластьМакетаОсновныеДанные.Рисунки.Штрихкод.Высота / КоличествоМиллиметровВПикселе);
	ПараметрыШК.РазмерШрифта = 10;
	ПараметрыШК.ТипКода = Кодировка;
	ПараметрыШК.Штрихкод = Штрихкод;
	ПараметрыШК.Масштабировать = Истина;
	ПараметрыШК.СохранятьПропорции = Истина;
	ПараметрыШК.ВертикальноеВыравнивание = 2;
	
	СтруктураКартинки = ИС_MP_ГенерацияШтрихкода.ИзображениеШтрихкода(ПараметрыШК);
	
	Если СтруктураКартинки.Результат Тогда	
		ОбластьМакетаОсновныеДанные.Рисунки.Штрихкод.Картинка = СтруктураКартинки.Картинка;
	КонецЕсли;  
	
	ТабличныйДокумент.Вывести(ОбластьМакетаОсновныеДанные);
	
	Возврат ТабличныйДокумент;
	
КонецФункции //- ИнфоСофт Стояк Ю.К. 15.04.2025 УА #98648

//+ ИнфоСофт Стояк Ю.К. 15.04.2025 УА #98648
&НаСервере
Функция ПолучитьДанныеДляФормированияШтрихкода(Штрихкод)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ИС_Ozon_Номенклатура.offer_id КАК offer_id,
	|	ИС_Ozon_Штрихкоды.Наименование КАК Штрихкод,
	|	ИС_Ozon_Номенклатура.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.ИС_Ozon_Штрихкоды КАК ИС_Ozon_Штрихкоды
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ИС_Ozon_Номенклатура КАК ИС_Ozon_Номенклатура
	|		ПО ИС_Ozon_Штрихкоды.Владелец = ИС_Ozon_Номенклатура.Ссылка
	|ГДЕ
	|	ИС_Ozon_Штрихкоды.Наименование = &Штрихкод
	|	И ИС_Ozon_Штрихкоды.ЛичныйКабинет = &Профиль";
	
	Запрос.УстановитьПараметр("Штрихкод", Штрихкод);
	Запрос.УстановитьПараметр("Профиль", Объект.Профиль);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Результат = Новый Структура;   
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл 
		
		Результат.Вставить("Штрихкод", ВыборкаДетальныеЗаписи.Штрихкод);
		Результат.Вставить("Артикул", ВыборкаДетальныеЗаписи.offer_id); 		
		Результат.Вставить("Наименование", ВыборкаДетальныеЗаписи.Ссылка.Наименование);                                   
		
	КонецЦикла;  
	
	Возврат Результат;
	
КонецФункции //- ИнфоСофт Стояк Ю.К. 15.04.2025 УА #98648

//+ ИнфоСофт Стояк Ю.К. 15.04.2025 УА #98648
&НаСервереБезКонтекста
Процедура ВыполнитьНастройкуТабличногоДокумента(Этикетка, НастройкиПечати)
	
	Этикетка.ИмяПринтера = НастройкиПечати.ИмяПринтера; 
	Этикетка.ПолеСлева = НастройкиПечати.Слева;
	Этикетка.ПолеСправа = НастройкиПечати.Справа;
	Этикетка.ПолеСнизу = НастройкиПечати.Снизу;
	Этикетка.ПолеСверху = НастройкиПечати.Сверху;	
	Этикетка.РазмерКолонтитулаСверху = НастройкиПечати.КолонтитулыСверху;
	Этикетка.РазмерКолонтитулаСнизу = НастройкиПечати.КолонтитулыСнизу; 
	Этикетка.ЭкземпляровНаСтранице = НастройкиПечати.ЭкземпляровНаСтраницу; 
	
	Если НастройкиПечати.ОриентацияСтраницы = 0 Тогда 
		Этикетка.ОриентацияСтраницы = ОриентацияСтраницы.Портрет;
	Иначе 
		Этикетка.ОриентацияСтраницы = ОриентацияСтраницы.Ландшафт;
	КонецЕсли;
		
	Если НастройкиПечати.Масштаб = 0 Тогда 
		Этикетка.АвтоМасштаб = Истина;
	Иначе 
		Этикетка.АвтоМасштаб = Ложь;
		Этикетка.МасштабПечати = НастройкиПечати.МасштабЗначение;	
	КонецЕсли;	
	
КонецПроцедуры //- ИнфоСофт Стояк Ю.К. 15.04.2025 УА #98648

