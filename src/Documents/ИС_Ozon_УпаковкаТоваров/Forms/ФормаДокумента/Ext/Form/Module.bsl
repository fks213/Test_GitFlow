//+ ИнфоСофт Мурсалимов Д.Р. 28.06.24 УА #77997
&НаКлиенте
Процедура ОбработатьШтрихкодыЗавершение(Результат, Параметры) Экспорт 	
	ВыполнитьПроверкуНаПечать(Результат);	
КонецПроцедуры //- ИнфоСофт Мурсалимов Д.Р. 28.06.24 УА #77997

//+ ИнфоСофт Мурсалимов Д.Р. 28.06.24 УА #77997
&НаКлиенте
Процедура ОбработатьШтрихкоды(Штрихкод)
	
	//+ ИнфоСофт Заварин К.В. 13.03.25 УА #89418 
	Если Не СканированиеДоступно Тогда
		Возврат;
	КонецЕсли;
	//- ИнфоСофт Заварин К.В. 13.03.25 УА #89418
	
	ОчиститьСообщения();
	
	ДанныеШтрихкода = Новый Структура; 
	
	ДанныеШтрихкода.Вставить("ФорматBase64", Ложь); 
	ДанныеШтрихкода.Вставить("Штрихкод", СокрЛП(Штрихкод));
	ДанныеШтрихкода.Вставить("Количество", 1);
	
	//+ ИнфоСофт Стояк Ю.К. 03.09.2024 УА #82955
	ИС_MP_МаркировкаКлиентСервер.ЗакодироватьШтрихкодДанныхBase64(ДанныеШтрихкода); 
	
	ПараметрыСканирования = ИС_MP_МаркировкаКлиент.ПараметрыСканирования(ЭтаФорма);  
	
	//+ ИнфоСофт Заварин К.В. 13.03.25 УА #96054
	ПараметрыСканирования.Вставить("ТребуетсяПроверкаСредствамиККТ", Ложь);
	//- ИнфоСофт Заварин К.В. 13.03.25 УА #96054
	
	РезультатОбработкиШтрихкода = ОбработатьШтрихкод(ДанныеШтрихкода, ПараметрыСканирования);
	
	ВыполнитьПроверкуНаПечать(РезультатОбработкиШтрихкода);
	
	//ИС_MP_МаркировкаКлиент.ОбработатьДанныеШтрихкода("ОбработатьШтрихкодыЗавершение", ЭтаФорма, ДанныеШтрихкода);
	//- ИнфоСофт Стояк Ю.К. 03.09.2024 УА #82955
	
КонецПроцедуры //- ИнфоСофт Мурсалимов Д.Р. 28.06.24 УА #77997

//+ ИнфоСофт Власова И.С. 22.03.24 УА #71520
&НаКлиенте
Процедура ПоискПоШтрихкодуЗавершение(Данные, ДополнительныеПараметры) Экспорт
	
	Если Данные.Штрихкод <> "" Тогда
		ОбработатьШтрихкоды(СокрЛП(Данные.Штрихкод));
	КонецЕсли;
	
КонецПроцедуры //- ИнфоСофт Власова И.С. 22.03.24 УА #71520

//+ ИнфоСофт Власова И.С. 22.03.24 УА #71520
&НаСервере
Процедура УстановитьУсловноеОформление()

	УсловноеОформление.Элементы.Очистить();
	
	ЭлементУсловногоОформления = УсловноеОформление.Элементы.Добавить();
	ЭлементУсловногоОформления.Использование = Истина;
	ЭлементУсловногоОформления.Оформление.УстановитьЗначениеПараметра("ЦветФона", WebЦвета.БледноЗеленый);
	
	ЭлементУсловия                = ЭлементУсловногоОформления.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ЭлементУсловия.ЛевоеЗначение  = Новый ПолеКомпоновкиДанных("ДеревоЗаказы.ЭтикеткаРаспечатана");
	ЭлементУсловия.ВидСравнения   = ВидСравненияКомпоновкиДанных.Равно;
	ЭлементУсловия.ПравоеЗначение = Истина;
	ЭлементУсловия.Использование  = Истина;
	
	ОформляемоеПоле      = ЭлементУсловногоОформления.Поля.Элементы.Добавить();
	ОформляемоеПоле.Поле = Новый ПолеКомпоновкиДанных(Элементы.ДеревоЗаказы.Имя);
	ОформляемоеПоле.Использование = Истина;
	
КонецПроцедуры

//+ ИнфоСофт Власова И.С. 22.03.24 УА #71520
&НаСервере
Процедура ПреобразоватьДеревоВТаблицуЗначений(ДеревоЗначений, ТекущийОбъект)
	
	Для Каждого Строка Из ДеревоЗначений.Строки Цикл
		
		Если Строка.Строки.Количество() = 0 Тогда
			
			НоваяСтрока = ТекущийОбъект.Товары.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, Строка);
				
		ИначеЕсли Строка.Строки.Количество() > 0 Тогда
			
			ПреобразоватьДеревоВТаблицуЗначений(Строка, ТекущийОбъект);
			
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры //- ИнфоСофт Власова И.С. 22.03.24 УА #71520

//+ ИнфоСофт Власова И.С. 22.03.24 УА #71520
&НаСервере
Процедура ЗаполнитьДеревоНоменклатурыПоТЧ()
		
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ИС_Ozon_УпаковкаТоваровТовары.Заказ КАК Заказ,
		|	ИС_Ozon_УпаковкаТоваровТовары.Номенклатура КАК Номенклатура,
		|	ИС_Ozon_УпаковкаТоваровТовары.Характеристика КАК Характеристика,
		|	ИС_Ozon_УпаковкаТоваровТовары.КоличествоЗаказ КАК КоличествоЗаказ,
		|	ИС_Ozon_УпаковкаТоваровТовары.КоличествоФакт КАК КоличествоФакт,
		|	ИС_Ozon_УпаковкаТоваровТовары.ЭтикеткаРаспечатана КАК ЭтикеткаРаспечатана
		|ИЗ
		|	Документ.ИС_Ozon_УпаковкаТоваров.Товары КАК ИС_Ozon_УпаковкаТоваровТовары
		|ГДЕ
		|	ИС_Ozon_УпаковкаТоваровТовары.Ссылка = &Ссылка
		|ИТОГИ
		|	СУММА(КоличествоЗаказ),
		|	СУММА(КоличествоФакт),
		|	МИНИМУМ(ЭтикеткаРаспечатана)
		|ПО
		|	Заказ";
	
	Запрос.УстановитьПараметр("Ссылка", Объект.Ссылка);
	
	РезультатЗапроса = Запрос.Выполнить().Выгрузить(ОбходРезультатаЗапроса.ПоГруппировкамСИерархией);
	ЗначениеВРеквизитФормы(РезультатЗапроса, "ДеревоЗаказы");
 
КонецПроцедуры //- ИнфоСофт Власова И.С. 22.03.24 УА #71520

//+ ИнфоСофт Власова И.С. 22.03.24 УА #71520
&НаКлиенте
Процедура ЗаполнитьДанныеЗаказа()
	
	Если ДеревоЗаказы.ПолучитьЭлементы().Количество() > 0 Тогда
		Оповещение = Новый ОписаниеОповещения("ПоказатьВопросЗавершениеЗаполнениеТаблицы", ЭтотОбъект);
		ТекстВопроса = "Перезаполнить таблицу? Данные в табличной части будут утеряны.";
		ПоказатьВопрос(Оповещение, ТекстВопроса, РежимДиалогаВопрос.ДаНетОтмена, 20, КодВозвратаДиалога.Нет,, КодВозвратаДиалога.Нет);
	Иначе
		ЗаполнитьДанныеЗаказаНаСервере();
	КонецЕсли;
	
КонецПроцедуры //- ИнфоСофт Власова И.С. 22.03.24 УА #71520

//+ ИнфоСофт Власова И.С. 22.03.24 УА #71520
&НаКлиенте
Процедура ПоказатьВопросЗавершениеЗаполнениеТаблицы(Результат, Объект) Экспорт
	
	Если Результат = КодВозвратаДиалога.Да Тогда
		ЗаполнитьДанныеЗаказаНаСервере();
	Иначе
		Возврат;	
	КонецЕсли;
	
КонецПроцедуры //- ИнфоСофт Власова И.С. 22.03.24 УА #71520

//+ ИнфоСофт Власова И.С. 22.03.24 УА #71520
&НаСервере
Процедура ЗаполнитьДанныеЗаказаНаСервере(МассивЗаказов = Неопределено)
	
	Объект.Товары.Очистить();
	ДеревоЗаказы.ПолучитьЭлементы().Очистить();

	Запрос = Новый Запрос;
	Запрос.Текст =
	//+ ИнфоСофт Заварин К.В. 21.02.25 УА #73904
	"ВЫБРАТЬ
	|	ИС_Ozon_СтатусыСборочныхЗаданий.Заказ КАК Заказ
	|ПОМЕСТИТЬ ВТ_СборочныеЗадания
	|ИЗ
	|	РегистрСведений.ИС_Ozon_СтатусыСборочныхЗаданий КАК ИС_Ozon_СтатусыСборочныхЗаданий
	|ГДЕ
	|	ИС_Ozon_СтатусыСборочныхЗаданий.Профиль = &Профиль
	|	И ИС_Ozon_СтатусыСборочныхЗаданий.status = ЗНАЧЕНИЕ(Перечисление.ИС_Ozon_СтатусыОтправлений.awaiting_deliver)
	|	И &ОтборЗаказов
	//+ ИнфоСофт Стояк Ю.К. 03.03.2025 УА #93469
	|	И НЕ ИС_Ozon_СтатусыСборочныхЗаданий.Заказ.ЗаказФБО
	//- ИнфоСофт Стояк Ю.К. 03.03.2025 УА #93469
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ИС_Ozon_Заказproducts.Ссылка КАК Заказ,
	|	ИС_Ozon_СоответствиеХарактеристик.Номенклатура КАК Номенклатура,
	|	ИС_Ozon_СоответствиеХарактеристик.Характеристика КАК Характеристика,
	|	СУММА(ИС_Ozon_Заказproducts.quantity) КАК КоличествоЗаказ,
	|	ВЫБОР
	|		КОГДА ИС_Ozon_СоответствиеХарактеристик.Номенклатура.ВидНоменклатуры.ОсобенностьУчета <> ЗНАЧЕНИЕ(Перечисление.ОсобенностиУчетаНоменклатуры.БезОсобенностейУчета)
	|			ТОГДА ИСТИНА
	|		ИНАЧЕ ЛОЖЬ
	|	КОНЕЦ КАК МаркируемыйТовар
	|ПОМЕСТИТЬ ВТ_Номенклатура
	|ИЗ
	|	Документ.ИС_Ozon_Заказ.products КАК ИС_Ozon_Заказproducts
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ИС_Ozon_СоответствиеХарактеристик КАК ИС_Ozon_СоответствиеХарактеристик
	|		ПО ИС_Ozon_Заказproducts.НоменклатураOzon = ИС_Ozon_СоответствиеХарактеристик.НоменклатураOzon
	|			И ИС_Ozon_Заказproducts.Ссылка.Профиль = ИС_Ozon_СоответствиеХарактеристик.НоменклатураOzon.Профиль
	|ГДЕ
	|	ИС_Ozon_Заказproducts.Ссылка В
	|			(ВЫБРАТЬ
	|				ВТ_СборочныеЗадания.Заказ КАК Ссылка
	|			ИЗ
	|				ВТ_СборочныеЗадания КАК ВТ_СборочныеЗадания)
	|
	|СГРУППИРОВАТЬ ПО
	|	ИС_Ozon_Заказproducts.Ссылка,
	|	ИС_Ozon_СоответствиеХарактеристик.Номенклатура,
	|	ИС_Ozon_СоответствиеХарактеристик.Характеристика,
	|	ВЫБОР
	|		КОГДА ИС_Ozon_СоответствиеХарактеристик.Номенклатура.ВидНоменклатуры.ОсобенностьУчета <> ЗНАЧЕНИЕ(Перечисление.ОсобенностиУчетаНоменклатуры.БезОсобенностейУчета)
	|			ТОГДА ИСТИНА
	|		ИНАЧЕ ЛОЖЬ
	|	КОНЕЦ
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_Номенклатура.Заказ КАК Заказ,
	|	ВТ_Номенклатура.Номенклатура КАК Номенклатура,
	|	ВТ_Номенклатура.Характеристика КАК Характеристика,
	|	ВТ_Номенклатура.КоличествоЗаказ КАК КоличествоЗаказ,
	|	0 КАК КоличествоФакт,
	|	""Ложь"" КАК ЭтикеткаРаспечатана,
	|	ВТ_Номенклатура.МаркируемыйТовар КАК МаркируемыйТовар,
	|	ВЫБОР
	|		КОГДА ИС_MP_ДанныеВыгрузкиКИЗов.КоличествоВыгруженныхТоваров >= ВТ_Номенклатура.КоличествоЗаказ
	|			ТОГДА ИСТИНА
	|		ИНАЧЕ ЛОЖЬ
	|	КОНЕЦ КАК МаркировкаПередана
	|ИЗ
	|	ВТ_Номенклатура КАК ВТ_Номенклатура
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ИС_MP_ДанныеВыгрузкиКИЗов КАК ИС_MP_ДанныеВыгрузкиКИЗов
	|		ПО ВТ_Номенклатура.Номенклатура = ИС_MP_ДанныеВыгрузкиКИЗов.Номенклатура
	|			И ВТ_Номенклатура.Характеристика = ИС_MP_ДанныеВыгрузкиКИЗов.Характеристика
	|			И ВТ_Номенклатура.Заказ = ИС_MP_ДанныеВыгрузкиКИЗов.ЗаказМП
	|
	|УПОРЯДОЧИТЬ ПО
	|	Заказ
	|ИТОГИ
	|	СУММА(КоличествоЗаказ)
	|ПО
	|	Заказ";
	//- ИнфоСофт Заварин К.В. 21.02.25 УА #73904
	
	Если МассивЗаказов = Неопределено ИЛИ МассивЗаказов.Количество() = 0 Тогда
		Запрос.УстановитьПараметр("ОтборЗаказов", Истина);
	Иначе
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&ОтборЗаказов", "ИС_Ozon_СтатусыСборочныхЗаданий.Заказ В(&МассивЗаказов)");
		Запрос.УстановитьПараметр("МассивЗаказов", МассивЗаказов);
	КонецЕсли;
	
	Запрос.УстановитьПараметр("Профиль", Объект.Профиль);
	
	РезультатЗапроса = Запрос.Выполнить().Выгрузить(ОбходРезультатаЗапроса.ПоГруппировкамСИерархией);
	ЗначениеВРеквизитФормы(РезультатЗапроса, "ДеревоЗаказы");	
	
КонецПроцедуры //- ИнфоСофт Власова И.С. 22.03.24 УА #71520	

//+ ИнфоСофт Власова И.С. 22.03.24 УА #71520
&НаКлиенте
Процедура ВыполнитьПроверкуНаПечать(РезультатОбработкиШтрихкода)
	
	//+ ИнфоСофт Стояк Ю.К. 03.09.2024 УА #82955	
	ДанныеШтрихкода = РезультатОбработкиШтрихкода.ДанныеШтрихкода;
	//ДанныеШтрихкода = РезультатОбработкиШтрихкода;
	//- ИнфоСофт Стояк Ю.К. 03.09.2024 УА #82955
	
	РезультатРазбора = РазборКодаМаркировкиНаСервере(ДанныеШтрихкода.НормализованныйШтрихкод);
	
	Если РезультатРазбора <> Неопределено Тогда
		ДанныеШтрихкодаУпаковки = ПолучитьДанныеШтрихкодаУпаковки(РезультатРазбора);
		ДанныеШтрихкода = ДанныеШтрихкодаУпаковки;
	Иначе
		ДанныеШтрихкодаУпаковки = Неопределено;
	КонецЕсли;
	
	Если ДанныеШтрихкодаУпаковки = Неопределено И Не ЗначениеЗаполнено(ДанныеШтрихкода.Номенклатура) Тогда
		//+ ИнфоСофт Янгиров Р.Р. 20.11.2024 УА #86762
		ЗвукШтрихкодОтстутствуетВБазе();
		//- ИнфоСофт Янгиров Р.Р. 20.11.2024 УА #86762
		ОбщегоНазначенияКлиент.СообщитьПользователю("Не найдены данные по коду " + ДанныеШтрихкода.Штрихкод);
		Возврат;		
	КонецЕсли;	

	Дерево = ДеревоЗаказы.ПолучитьЭлементы();
	
	ТекущийЗаказ = Неопределено;
	СтрокаДанныеСборки = Неопределено;   
	
	Для Каждого Заказ Из Дерево Цикл
		
		СтрокиЗаказа = Заказ.ПолучитьЭлементы();
		
		Если СтрокиЗаказа.Количество() > 0 Тогда 
			
			Для Каждого Строка Из СтрокиЗаказа Цикл 
				
				Если Строка.Номенклатура = ДанныеШтрихкода.Номенклатура И Строка.Характеристика = ДанныеШтрихкода.Характеристика И Не Строка.ЭтикеткаРаспечатана Тогда
					
					ТекущийЗаказ = Заказ;
					СтрокаДанныеСборки = Строка;
					
					Прервать;
					
				КонецЕсли;
				
			КонецЦикла;
			
			Если СтрокаДанныеСборки <> Неопределено Тогда
				Прервать;
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЦикла;	
	
	Если СтрокаДанныеСборки = Неопределено Тогда
		//+ ИнфоСофт Янгиров Р.Р. 20.11.2024 УА #86762 	 
		ЗвукТоварОтсутствуетВЗаказе();
		//- ИнфоСофт Янгиров Р.Р. 20.11.2024 УА #86762
		ОбщегоНазначенияКлиент.СообщитьПользователю("По отсканированному штрихкоду не найдено доступного заказа для печати этикетки.");
		Возврат;
		//+ ИнфоСофт Янгиров Р.Р. 20.11.2024 УА #86762
	Иначе	
		ЗвукТоварНайден();
		//- ИнфоСофт Янгиров Р.Р. 20.11.2024 УА #86762
	КонецЕсли;	
	
	ЭтикеткаРаспечатана = Ложь;
	
	СтрокаДанныеСборки.КоличествоФакт = СтрокаДанныеСборки.КоличествоФакт + 1;
	ТекущийЗаказ.КоличествоФакт       = ТекущийЗаказ.КоличествоФакт + 1;
	
	//+ ИнфоСофт Заварин К.В. 09.01.25 УА #90553
	Элементы.ДеревоЗаказы.ТекущаяСтрока  = СтрокаДанныеСборки.ПолучитьИдентификатор();
	//- ИнфоСофт Заварин К.В. 09.01.25 УА #90553
	
	//+ ИнфоСофт Заварин К.В. 12.03.25 УА #89418
	Если Объект.СобиратьПозаказно И Не ТекущийЗаказ.КоличествоФакт = ТекущийЗаказ.КоличествоЗаказ Тогда
		
		ДанныеСтроки = Новый Структура;
		
		ДанныеСтроки.Вставить("Заказ", 			СтрокаДанныеСборки.Заказ);
		ДанныеСтроки.Вставить("КоличествоФакт", СтрокаДанныеСборки.КоличествоФакт); 
		ДанныеСтроки.Вставить("Номенклатура", 	СтрокаДанныеСборки.Номенклатура);
		ДанныеСтроки.Вставить("Характеристика", СтрокаДанныеСборки.Характеристика);
		
		НоменклатураОтправлений = ПолучитьНоменклатуруОтправленийНасервере(ДанныеСтроки);
		
		СтрокаДанныеСборки.КоличествоФакт = 0;
		ТекущийЗаказ.КоличествоФакт       = 0;
		
		ДанныеСборки = Новый Структура;
		ДанныеСборки.Вставить("НоменклатураОтправлений", НоменклатураОтправлений);
		
		Оповещение = Новый ОписаниеОповещения("ПолучитьРезультатОбработкиОтправления", ЭтотОбъект); 
		
		СканированиеДоступно = Ложь;
		
		ОткрытьФорму("Документ.ИС_Ozon_УпаковкаТоваров.Форма.ФормаОтправления", ДанныеСборки, ЭтаФорма,,,,Оповещение, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
		
		
	Иначе
		//- ИнфоСофт Заварин К.В. 13.03.25 УА #89418
		
		Если СтрокаДанныеСборки.КоличествоФакт = СтрокаДанныеСборки.КоличествоЗаказ Тогда
			
			НужноПечатать = Истина;
			СтрокаДанныеСборки.ЭтикеткаРаспечатана = Истина;
			
			СтрокиПоЗаказу = ТекущийЗаказ.ПолучитьЭлементы();
			
			Если СтрокиПоЗаказу.Количество() > 1 Тогда
				
				Для Каждого Строка Из СтрокиПоЗаказу Цикл
					
					Если Строка.КоличествоФакт <> Строка.КоличествоЗаказ Тогда				
						НужноПечатать = Ложь;
						Прервать;
					КонецЕсли;
					
				КонецЦикла;
				
			КонецЕсли;
			
			Если НужноПечатать Тогда
				
				Попытка 
					
					//+ ИнфоСофт Стояк Ю.К. 15.04.2025 УА #98648
					Если ПечататьШтрихкоды Тогда  
						
						Если ЗначениеЗаполнено(Объект.НастройкиПечатиШтрихкодов) Тогда
							//+ УТ
							КоличествоКопий = ОбщегоНазначенияУТВызовСервера.ЗначениеРеквизитаОбъекта(Объект.НастройкиПечатиШтрихкодов, "КоличествоКопий");
							//- УТ
							ЭтикеткаШтрихкода = ВыполнитьПечатьШтрихкода(ДанныеШтрихкода.Штрихкод);
							ВыполнитьНастройкуТабличногоДокумента(ЭтикеткаШтрихкода, Объект.НастройкиПечатиШтрихкодов);
							
							Для СЧ = 1 По КоличествоКопий Цикл
								ЭтикеткаШтрихкода.Напечатать();
							КонецЦикла;
							
						Иначе
							ЭтикеткаШтрихкода = ВыполнитьПечатьШтрихкода(ДанныеШтрихкода.Штрихкод);
							ЭтикеткаШтрихкода.Напечатать();
						КонецЕсли; 
						
					КонецЕсли;
					//- ИнфоСофт Стояк Ю.К. 15.04.2025 УА #98648
					
					ВыполнитьПечатьЭтикетки(СтрокаДанныеСборки); 
					
					ТекущийЗаказ.ЭтикеткаРаспечатана = ЭтикеткаРаспечатана;
					
					Элементы.ДеревоЗаказы.Свернуть(ТекущийЗаказ.ПолучитьИдентификатор());
					
				Исключение
					ОбщегоНазначенияКлиент.СообщитьПользователю(ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
				КонецПопытки;
				
			КонецЕсли;
			
		КонецЕсли;
		
		//+ ИнфоСофт Заварин К.В. 13.03.25 УА #89418
	КонецЕсли;
	//- ИнфоСофт Заварин К.В. 12.03.25 УА #89418
	
КонецПроцедуры //- ИнфоСофт Власова И.С. 22.03.24 УА #71520

//+ ИнфоСофт Заварин К.В. 13.03.25 УА #89418
&НаКлиенте
Процедура ПолучитьРезультатОбработкиОтправления(Результат, ДополнительныеПараметры) Экспорт
	
	Дерево = ДеревоЗаказы.ПолучитьЭлементы();
	
	Если Не Результат = Неопределено И Результат.ТоварыПодобраны Тогда
		
		Для Каждого Заказ Из Дерево Цикл
			
			СтрокиЗаказа = Заказ.ПолучитьЭлементы();
			
			Если СтрокиЗаказа.Количество() > 0 Тогда 
				
				Для Каждого Строка Из СтрокиЗаказа Цикл 
					
					Если Строка.Заказ = Результат.Отправление Тогда
						
						Заказ.КоличествоФакт 	   = Заказ.КоличествоЗаказ;
						Заказ.ЭтикеткаРаспечатана  = Истина;
						
						Строка.КоличествоФакт 	   = Строка.КоличествоЗаказ;
						Строка.ЭтикеткаРаспечатана = Истина;
						
						Попытка	
							Элементы.ДеревоЗаказы.Свернуть(Заказ.ПолучитьИдентификатор());
							ВыполнитьПечатьЭтикетки(Строка);	
						Исключение
							ОбщегоНазначенияКлиент.СообщитьПользователю(ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
						КонецПопытки;		
						
					КонецЕсли;
					
				КонецЦикла;
				
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЕсли;
	
	ПодключитьОбработчикОжидания("РазрешитьСканирование", 2, Истина);
	
КонецПроцедуры //- ИнфоСофт Заварин К.В. 13.03.25 УА #89418

//+ ИнфоСофт Заварин К.В. 13.03.25 УА #89418
&НаКлиенте
Процедура РазрешитьСканирование()
	СканированиеДоступно = Истина;	
КонецПроцедуры //- ИнфоСофт Заварин К.В. 13.03.25 УА #89418

//+ ИнфоСофт Заварин К.В. 13.03.25 УА #89418
&НаСервере
Функция ПолучитьНоменклатуруОтправленийНаСервере(ДанныеСтроки)
	
	Запрос = Новый Запрос;
	Запрос.Текст =	
	"ВЫБРАТЬ
	|	ИС_Ozon_СтатусыСборочныхЗаданий.Заказ КАК Заказ
	|ПОМЕСТИТЬ ВТ_СборочныеЗадания
	|ИЗ
	|	РегистрСведений.ИС_Ozon_СтатусыСборочныхЗаданий КАК ИС_Ozon_СтатусыСборочныхЗаданий
	|ГДЕ
	|	ИС_Ozon_СтатусыСборочныхЗаданий.Профиль = &Профиль
	|	И ИС_Ozon_СтатусыСборочныхЗаданий.status = ЗНАЧЕНИЕ(Перечисление.ИС_Ozon_СтатусыОтправлений.awaiting_deliver)
	|	И ИС_Ozon_СтатусыСборочныхЗаданий.Заказ = &Заказ
	|	И НЕ ИС_Ozon_СтатусыСборочныхЗаданий.Заказ.ЗаказФБО
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ИС_Ozon_Заказproducts.Ссылка КАК Отправление,
	|	ИС_Ozon_СоответствиеХарактеристик.Номенклатура КАК Номенклатура,
	|	ИС_Ozon_СоответствиеХарактеристик.Характеристика КАК Характеристика,
	|	ИС_Ozon_Заказproducts.НоменклатураOzon КАК НоменклатураOzon,
	|	ИС_Ozon_Заказproducts.ХарактеристикаOzon КАК ХарактеристикаOzon,
	|	СУММА(ИС_Ozon_Заказproducts.quantity) КАК Количество,
	|	ВЫБОР
	|		КОГДА ИС_Ozon_СоответствиеХарактеристик.Номенклатура = &Номенклатура
	|				И ИС_Ozon_СоответствиеХарактеристик.Характеристика = &Характеристика
	|			ТОГДА &КоличествоФакт
	|		ИНАЧЕ 0
	|	КОНЕЦ КАК КоличествоФакт
	|ИЗ
	|	Документ.ИС_Ozon_Заказ.products КАК ИС_Ozon_Заказproducts
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ИС_Ozon_СоответствиеХарактеристик КАК ИС_Ozon_СоответствиеХарактеристик
	|		ПО ИС_Ozon_Заказproducts.НоменклатураOzon = ИС_Ozon_СоответствиеХарактеристик.НоменклатураOzon
	|			И ИС_Ozon_Заказproducts.Ссылка.Профиль = ИС_Ozon_СоответствиеХарактеристик.НоменклатураOzon.Профиль
	|ГДЕ
	|	ИС_Ozon_Заказproducts.Ссылка В
	|			(ВЫБРАТЬ
	|				ВТ_СборочныеЗадания.Заказ КАК Ссылка
	|			ИЗ
	|				ВТ_СборочныеЗадания КАК ВТ_СборочныеЗадания)
	|
	|СГРУППИРОВАТЬ ПО
	|	ИС_Ozon_Заказproducts.Ссылка,
	|	ИС_Ozon_СоответствиеХарактеристик.Номенклатура,
	|	ИС_Ozon_СоответствиеХарактеристик.Характеристика,
	|	ИС_Ozon_Заказproducts.НоменклатураOzon,
	|	ИС_Ozon_Заказproducts.ХарактеристикаOzon";
	
	Запрос.УстановитьПараметр("Заказ", ДанныеСтроки.Заказ);
	Запрос.УстановитьПараметр("Профиль", Объект.Профиль); 
	Запрос.УстановитьПараметр("КоличествоФакт", ДанныеСтроки.КоличествоФакт);
	Запрос.УстановитьПараметр("Номенклатура", ДанныеСтроки.Номенклатура);
	Запрос.УстановитьПараметр("Характеристика", ДанныеСтроки.Характеристика);
	   
	
	Результат = Запрос.Выполнить().Выгрузить();
	
	Возврат ОбщегоНазначения.ТаблицаЗначенийВМассив(Результат);
	
КонецФункции //- ИнфоСофт Заварин К.В. 13.03.25 УА #89418

//+ ИнфоСофт Власова И.С. 22.03.24 УА #71520
&НаКлиенте
Процедура ВыполнитьПечатьЭтикетки(СтрокаДанныеСборки) 
	
	МассивЭтикеток = ПолучитьЭтикеткиНаСервере(СтрокаДанныеСборки.Заказ);
	
	Если МассивЭтикеток.Количество() = 0 Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю("Не удалось получить этикетки с сервера Ozon!");
		Возврат;
	КонецЕсли;
	
	Этикетка = МассивЭтикеток[0];
	
	Если ЗначениеЗаполнено(Объект.НастройкаПечатиЭтикеток) Тогда 		
		ПринтерДляПечати = """" + ПолучитьПринтерДляПечати() + """";
	Иначе	
		ПринтерДляПечати = "";
	КонецЕсли;
	
	ИмяКаталогаВременныхФайлов = КаталогВременныхФайлов();
	
	ИмяВременногоФайла = ИмяКаталогаВременныхФайлов + "stickersFile.pdf";

	Этикетка.Записать(ИмяВременногоФайла);
	
	ИС_МП_Клиент.НапечататьИзПриложения(ИмяВременногоФайла, ПринтерДляПечати);

	ЭтикеткаРаспечатана = Истина;
	
КонецПроцедуры //- ИнфоСофт Власова И.С. 22.03.24 УА #71520

//+ ИнфоСофт Власова И.С. 22.03.24 УА #71520
&НаСервере
Функция ПолучитьЭтикеткиНаСервере(СборочноеЗадание)

	МассивЗаданий = Новый Массив;
	МассивЗаданий.Добавить(СборочноеЗадание);
	
	Возврат ИС_Ozon_Сервер.НапечататьЭтикетки(Объект.Профиль, МассивЗаданий);
	
КонецФункции //- ИнфоСофт Власова И.С. 22.03.24 УА #71520

//+ ИнфоСофт Власова И.С. 22.03.24 УА #71520
&НаСервере
Функция ПолучитьДанныеШтрихкодаУпаковки(РезультатРазбора) 
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ШтрихкодыУпаковокТоваров.Ссылка КАК Ссылка,
	|	ШтрихкодыУпаковокТоваров.Номенклатура КАК Номенклатура,
	|	ШтрихкодыУпаковокТоваров.Характеристика КАК Характеристика
	|ИЗ
	|	Справочник.ШтрихкодыУпаковокТоваров КАК ШтрихкодыУпаковокТоваров
	|ГДЕ
	|	ШтрихкодыУпаковокТоваров.ЗначениеШтрихкода = &ЗначениеШтрихкода
	|
	|СГРУППИРОВАТЬ ПО
	|	ШтрихкодыУпаковокТоваров.Ссылка,
	|	ШтрихкодыУпаковокТоваров.Номенклатура,
	|	ШтрихкодыУпаковокТоваров.Характеристика";
	
	Запрос.УстановитьПараметр("ЗначениеШтрихкода", РезультатРазбора.НормализованныйКодМаркировки);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Если РезультатЗапроса.Пустой() Тогда
		Возврат Неопределено;		
	КонецЕсли;
	
	Выборка = РезультатЗапроса.Выбрать();
	
	Выборка.Следующий();
	
	Результат = Новый Структура;
	
	Результат.Вставить("Номенклатура", Выборка.Номенклатура);
	Результат.Вставить("Характеристика", Выборка.Характеристика);
	Результат.Вставить("НормализованныйШтрихкод", РезультатРазбора.КодМаркировки); 
	Результат.Вставить("ШтрихкодУпаковки", Выборка.Ссылка);
	
	Возврат Результат;
	
КонецФункции //- ИнфоСофт Власова И.С. 22.03.24 УА #71520

