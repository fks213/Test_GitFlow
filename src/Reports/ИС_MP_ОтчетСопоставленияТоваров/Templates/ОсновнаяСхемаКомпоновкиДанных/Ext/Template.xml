		ПО ВТ_Номенклатура.Номенклатура = ИС_WB_СоответствиеРазмеров.Номенклатура
			И ВТ_Номенклатура.Характеристика = ИС_WB_СоответствиеРазмеров.Характеристика
			И (ИС_WB_СоответствиеРазмеров.Профиль = &amp;Профиль)

