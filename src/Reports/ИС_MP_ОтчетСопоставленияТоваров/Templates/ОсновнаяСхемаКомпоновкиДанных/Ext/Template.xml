		ПО ВТ_Номенклатура.Номенклатура = ИС_Ozon_СоответствиеХарактеристик.Номенклатура
			И ВТ_Номенклатура.Характеристика = ИС_Ozon_СоответствиеХарактеристик.Характеристика
			И (ИС_Ozon_СоответствиеХарактеристик.НоменклатураOzon.Профиль = &amp;Профиль)

