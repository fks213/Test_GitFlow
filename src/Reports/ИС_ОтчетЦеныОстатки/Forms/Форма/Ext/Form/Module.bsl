//+ ИнфоСофт Стояк Ю.К. 03.07.2023 УА #59330
Функция СуммироватьОстаткиWBПоТипу(ТаблицаЗначений)
	
	ФБС = ?(ТаблицаЗначений.Колонки.Найти("ФБС") <> Неопределено, Истина, Ложь);
	
	ТаблицаОстатков = Новый ТаблицаЗначений;  
	
	КвалификаторыЧисла = Новый КвалификаторыЧисла(20, 2, ДопустимыйЗнак.Неотрицательный);
	КвалификаторыСтроки = Новый КвалификаторыСтроки(20);
		
	ТаблицаОстатков.Колонки.Добавить("id", Новый ОписаниеТипов("Число",КвалификаторыЧисла));
	ТаблицаОстатков.Колонки.Добавить("Штрихкод", Новый ОписаниеТипов("Строка",КвалификаторыСтроки));
	ТаблицаОстатков.Колонки.Добавить("stock", Новый ОписаниеТипов("Число", КвалификаторыЧисла)); 
	
	Для Каждого Строка Из ТаблицаЗначений Цикл
		
		НайденныеСтроки = ТаблицаОстатков.НайтиСтроки(Новый Структура("id, Штрихкод", Строка.ИД, Строка.Штрихкод));
		
		Если НайденныеСтроки.Количество() > 0 Тогда
			Если НайденныеСтроки[0].stock <> Строка.НаСкладе И ФБС Тогда
				НайденныеСтроки[0].stock = НайденныеСтроки[0].stock + Строка.НаСкладе;
			ИначеЕсли Не ФБС Тогда
				НайденныеСтроки[0].stock = НайденныеСтроки[0].stock + Строка.НаСкладе;         
			КонецЕсли;
		Иначе
			НоваяСтрока = ТаблицаОстатков.Добавить();
			НоваяСтрока.id = Строка.ИД;
			НоваяСтрока.Штрихкод = Строка.Штрихкод;
			НоваяСтрока.stock = Строка.НаСкладе;                                 
		КонецЕсли;  
		
	КонецЦикла;
	
	Возврат ТаблицаОстатков;
			
КонецФункции //- ИнфоСофт Стояк Ю.К. 03.07.2023 УА #59330

