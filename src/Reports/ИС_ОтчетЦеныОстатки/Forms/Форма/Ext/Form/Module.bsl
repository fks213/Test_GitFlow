//+ ИнфоСофт Стояк Ю.К. 03.07.2023 УА #59330
Процедура ОбъединитьТаблицыЗначений(тзОсновная, тзПрисоединяемая)    
	
	//+ ИнфоСофт Заварин К.В. 25.03.25 УА #90222
	//Отборы = Новый Структура("Номенклатура, Характеристика",);
	Отборы = Новый Структура("Номенклатура, Характеристика, АртикулМП",);
	//- ИнфоСофт Заварин К.В. 25.03.25 УА #90222
	
	Для каждого текПрисоединяемаяЗапись из тзПрисоединяемая цикл  
		
		ЗаполнитьЗначенияСвойств(Отборы, текПрисоединяемаяЗапись);
		НайденыеСтроки = тзОсновная.НайтиСтроки(Отборы);  
		
		Если Не НайденыеСтроки.Количество() > 0 тогда
			
			НовСтрока = тзОсновная.Добавить();
			ЗаполнитьЗначенияСвойств(НовСтрока, текПрисоединяемаяЗапись);	
			
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры //- ИнфоСофт Стояк Ю.К. 03.07.2023 УА #59330

//+ ИнфоСофт Стояк Ю.К. 03.07.2023 УА #59330
Процедура ОбработатьШапку(ТабДок, МакетТД, Структура)    
	
	Если ПолучатьОстатки Тогда		
		
		Если ЗначениеЗаполнено(Склад) Тогда 		
			ОбластьШапка = МакетТД.ПолучитьОбласть("ШапкаТаблицы|Остаток1С");
			ТабДок.Присоединить(ОбластьШапка);
		КонецЕсли;
		
		Если WB Тогда
			
			Если ОстатокПоСкладам Тогда
				
				Если ПолучатьОстаткиFBS И Структура.Свойство("FBSWB") Тогда
					Для Каждого Строка Из Структура.FBSWB Цикл
						ОбластьШапка = МакетТД.ПолучитьОбласть("ШапкаТаблицы|ОстатокСклад"); 
						ОбластьШапка.Параметры.Склад = Строка;
						ТабДок.Присоединить(ОбластьШапка);	
					КонецЦикла;
				КонецЕсли;
				
				Если ПолучатьОстаткиFBO И Структура.Свойство("FBOWB") Тогда
					Для Каждого Строка Из Структура.FBOWB Цикл
						//+ ИнфоСофт Стояк Ю.К. 02.07.2024 УА #68177
						//ОбластьШапка = МакетТД.ПолучитьОбласть("ШапкаТаблицы|ОстатокСклад"); 
						ОбластьШапка = МакетТД.ПолучитьОбласть("ШапкаТаблицы|ОстатокСкладДетальный"); 
						//- ИнфоСофт Стояк Ю.К. 02.07.2024 УА #68177						
						ОбластьШапка.Параметры.Склад = Строка;
						ТабДок.Присоединить(ОбластьШапка);	
					КонецЦикла;               
				КонецЕсли;

			КонецЕсли; 
			
			
			ОбластьШапка = МакетТД.ПолучитьОбласть("ШапкаТаблицы|ОстатокВБ");
			ТабДок.Присоединить(ОбластьШапка); 
			
		КонецЕсли;  
		
		Если Ozon Тогда
			
			Если ОстатокПоСкладам И ПолучатьОстаткиFBS И Структура.Свойство("FBSOzon") Тогда 
				
				Для Каждого Строка Из Структура.FBSOzon Цикл
					ОбластьШапка = МакетТД.ПолучитьОбласть("ШапкаТаблицы|ОстатокСклад"); 
					ОбластьШапка.Параметры.Склад = Строка;
					ТабДок.Присоединить(ОбластьШапка);	
				КонецЦикла; 
				
			КонецЕсли;
			
			//+ ИнфоСофт Стояк Ю.К. 07.11.2024 УА #72455			
			Если ОстатокПоСкладам И ПолучатьОстаткиFBO И Структура.Свойство("FBOOzon") Тогда
				Для Каждого Строка Из Структура.FBOOzon Цикл					
					ОбластьШапка = МакетТД.ПолучитьОбласть("ШапкаТаблицы|ОстатокСкладДетальный"); 					
					ОбластьШапка.Параметры.Склад = Строка;
					ТабДок.Присоединить(ОбластьШапка);	
				КонецЦикла;               
			КонецЕсли;                                  
			//- ИнфоСофт Стояк Ю.К. 07.11.2024 УА #72455
			
			ОбластьШапка = МакетТД.ПолучитьОбласть("ШапкаТаблицы|ОстатокOzon");
			ТабДок.Присоединить(ОбластьШапка);
		КонецЕсли; 
		
		Если ЯМ Тогда
			
			Если ОстатокПоСкладам И ПолучатьОстаткиFBS И Структура.Свойство("FBSЯМ") Тогда 
				
				Для Каждого Строка Из Структура.FBSЯМ Цикл
					ОбластьШапка = МакетТД.ПолучитьОбласть("ШапкаТаблицы|ОстатокСклад"); 
					ОбластьШапка.Параметры.Склад = Строка;
					ТабДок.Присоединить(ОбластьШапка);	
				КонецЦикла; 
				
			КонецЕсли;  
			
			Если ОстатокПоСкладам И ПолучатьОстаткиFBO И Структура.Свойство("FBOЯМ") Тогда 
				
				Для Каждого Строка Из Структура.FBOЯМ Цикл
					ОбластьШапка = МакетТД.ПолучитьОбласть("ШапкаТаблицы|ОстатокСклад"); 
					ОбластьШапка.Параметры.Склад = Строка;
					ТабДок.Присоединить(ОбластьШапка);	
				КонецЦикла; 
				
			КонецЕсли;
			
			ОбластьШапка = МакетТД.ПолучитьОбласть("ШапкаТаблицы|ОстатокЯМ");
			ТабДок.Присоединить(ОбластьШапка);	
		КонецЕсли;
		
		Если Aliexpress Тогда
			ОбластьШапка = МакетТД.ПолучитьОбласть("ШапкаТаблицы|ОстатокАли");
			ТабДок.Присоединить(ОбластьШапка);			
		КонецЕсли;
		
		ОбластьШапка = МакетТД.ПолучитьОбласть("ШапкаТаблицы|СуммаFBO");
		ТабДок.Присоединить(ОбластьШапка);
		
	КонецЕсли;
	
	Если ПолучатьЦены Тогда
		
		Если WB Тогда  						
			ОбластьШапка = МакетТД.ПолучитьОбласть("ШапкаТаблицы|ЦеныВБ");
			ТабДок.Присоединить(ОбластьШапка);
		КонецЕсли;  
		
		Если Ozon Тогда				
			ОбластьШапка = МакетТД.ПолучитьОбласть("ШапкаТаблицы|ЦеныOzon");
			ТабДок.Присоединить(ОбластьШапка);
		КонецЕсли; 
		
		Если ЯМ Тогда	
			ОбластьШапка = МакетТД.ПолучитьОбласть("ШапкаТаблицы|ЦеныЯМ");
			ТабДок.Присоединить(ОбластьШапка);
		КонецЕсли;
		
		Если Aliexpress Тогда 
			
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры //- ИнфоСофт Стояк Ю.К. 03.07.2023 УА #59330  

//+ ИнфоСофт Стояк Ю.К. 24.09.2023 УА #00000
Функция ПолучитьОстатки1С(ТаблицаНоменклатуры)
	
	Запрос = Новый Запрос;
	Запрос.Текст =	
	"ВЫБРАТЬ
	|		ВТ_Товары.Номенклатура КАК Номенклатура,
	|		ВТ_Товары.Характеристика КАК Характеристика
	|	ПОМЕСТИТЬ ВТ_Размеры
	|	ИЗ
	|		&ВТ_Товары КАК ВТ_Товары
	|	;
	|	
	|	////////////////////////////////////////////////////////////////////////////////
	|	ВЫБРАТЬ
	|		РаспределениеЗапасов.Номенклатура КАК Номенклатура,
	|		РаспределениеЗапасов.Характеристика КАК Характеристика,
	|		СУММА(РаспределениеЗапасов.Свободно) КАК Свободно,
	|		СУММА(РаспределениеЗапасов.Резерв) КАК Резерв,
	|		РаспределениеЗапасов.ЗаказНаПоступление КАК ЗаказНаПоступление,
	|		РаспределениеЗапасов.ЗаказНаОтгрузку КАК ЗаказНаОтгрузку
	|	ПОМЕСТИТЬ ВТ_Запасы
	|	ИЗ
	|		РегистрСведений.РаспределениеЗапасов КАК РаспределениеЗапасов
	|	ГДЕ
	|		РаспределениеЗапасов.Склад В(&Склад)
	|		И РаспределениеЗапасов.Состояние = ЗНАЧЕНИЕ(Перечисление.РаспределениеЗапасовСостояния.ОстатокНаСкладе)
	|		И РаспределениеЗапасов.Назначение В(&Назначение)
	|		И (РаспределениеЗапасов.Номенклатура, РаспределениеЗапасов.Характеристика) В
	|				(ВЫБРАТЬ
	|					ВТ.Номенклатура КАК Номенклатура,
	|					ВТ.Характеристика КАК Характеристика
	|				ИЗ
	|					ВТ_Размеры КАК ВТ)
	|	
	|	СГРУППИРОВАТЬ ПО
	|		РаспределениеЗапасов.Номенклатура,
	|		РаспределениеЗапасов.Характеристика,
	|		РаспределениеЗапасов.ЗаказНаПоступление,
	|		РаспределениеЗапасов.ЗаказНаОтгрузку
	|	;
	|	
	|	////////////////////////////////////////////////////////////////////////////////
	|	ВЫБРАТЬ
	|
	|		ВТ_Размеры.Номенклатура КАК Номенклатура,
	|		ВТ_Размеры.Характеристика КАК Характеристика,
	|		ЕСТЬNULL(ВТ_Запасы.Свободно, 0) КАК ВНаличииСоСклада,
	|		ЕСТЬNULL(ВТ_Запасы.Резерв, 0) КАК ВРезервеСоСклада
	|	ПОМЕСТИТЬ ВТ_ФиналДоГруппировки
	|	ИЗ
	|		ВТ_Размеры КАК ВТ_Размеры
	|			ЛЕВОЕ СОЕДИНЕНИЕ ВТ_Запасы КАК ВТ_Запасы
	|			ПО ВТ_Размеры.Характеристика = ВТ_Запасы.Характеристика
	|				И ВТ_Размеры.Номенклатура = ВТ_Запасы.Номенклатура
	|
	|	
	|	СГРУППИРОВАТЬ ПО
	|		ВТ_Размеры.Номенклатура,
	|		ВТ_Размеры.Характеристика,
	|		ЕСТЬNULL(ВТ_Запасы.Свободно, 0),
	|		ЕСТЬNULL(ВТ_Запасы.Резерв, 0)
	|	
	|	ОБЪЕДИНИТЬ ВСЕ
	|	
	|	ВЫБРАТЬ
	|		ВТ_Размеры.Номенклатура,
	|		ВТ_Размеры.Характеристика,
	|		ВЫБОР
	|			КОГДА МИНИМУМ(ВЫРАЗИТЬ(ЕСТЬNULL(РаспределениеЗапасов.Свободно, 0) / ВариантыКомплектацииНоменклатурыТовары.Количество - 0.5 КАК ЧИСЛО(10, 0))) < 0
	|				ТОГДА 0
	|			ИНАЧЕ МИНИМУМ(ВЫРАЗИТЬ(ЕСТЬNULL(РаспределениеЗапасов.Свободно, 0) / ВариантыКомплектацииНоменклатурыТовары.Количество - 0.5 КАК ЧИСЛО(10, 0)))
	|		КОНЕЦ,
	|		ВЫБОР
	|			КОГДА МИНИМУМ(ВЫРАЗИТЬ(ЕСТЬNULL(РаспределениеЗапасов.Резерв, 0) / ВариантыКомплектацииНоменклатурыТовары.Количество - 0.5 КАК ЧИСЛО(10, 0))) < 0
	|				ТОГДА 0
	|			ИНАЧЕ МИНИМУМ(ВЫРАЗИТЬ(ЕСТЬNULL(РаспределениеЗапасов.Резерв, 0) / ВариантыКомплектацииНоменклатурыТовары.Количество - 0.5 КАК ЧИСЛО(10, 0)))
	|		КОНЕЦ
	|	ИЗ
	|		ВТ_Размеры КАК ВТ_Размеры
	|			ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ВариантыКомплектацииНоменклатуры.Товары КАК ВариантыКомплектацииНоменклатурыТовары
	|				ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.РаспределениеЗапасов КАК РаспределениеЗапасов
	|				ПО ВариантыКомплектацииНоменклатурыТовары.Номенклатура = РаспределениеЗапасов.Номенклатура
	|					И (РаспределениеЗапасов.Характеристика = ВариантыКомплектацииНоменклатурыТовары.Характеристика)
	|					И (РаспределениеЗапасов.Склад В (&Склад))
	|					И (РаспределениеЗапасов.Состояние = ЗНАЧЕНИЕ(Перечисление.РаспределениеЗапасовСостояния.ОстатокНаСкладе))
	|			ПО ВТ_Размеры.Номенклатура = ВариантыКомплектацииНоменклатурыТовары.Ссылка.Владелец
	|	ГДЕ
	|		ВариантыКомплектацииНоменклатурыТовары.Ссылка.Владелец.ТипНоменклатуры = ЗНАЧЕНИЕ(Перечисление.ТипыНоменклатуры.Набор)
	|	
	|	СГРУППИРОВАТЬ ПО
	|		ВТ_Размеры.Номенклатура,
	|		ВТ_Размеры.Характеристика
	|	;
	|	
	|	////////////////////////////////////////////////////////////////////////////////
	|	ВЫБРАТЬ
	|		ВТ_ФиналДоГруппировки.Номенклатура КАК НоменклатураКомплект,
	|		ВТ_ФиналДоГруппировки.Характеристика КАК ХарактеристикаКомплект,
	|		ВариантыКомплектацииНоменклатурыТовары.Номенклатура КАК НоменклатураКомплектация,
	|		ВариантыКомплектацииНоменклатурыТовары.Характеристика КАК ХарактеристикаКомплектация,
	|		ВариантыКомплектацииНоменклатурыТовары.КоличествоУпаковок КАК КоличествоКомплектация
	|
	|	ПОМЕСТИТЬ ВТ_Комплект
	|	ИЗ
	|		ВТ_ФиналДоГруппировки КАК ВТ_ФиналДоГруппировки
	|			ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ВариантыКомплектацииНоменклатуры.Товары КАК ВариантыКомплектацииНоменклатурыТовары
	|			ПО ВТ_ФиналДоГруппировки.Номенклатура = ВариантыКомплектацииНоменклатурыТовары.Ссылка.Владелец
	|				И ВТ_ФиналДоГруппировки.Характеристика = ВариантыКомплектацииНоменклатурыТовары.Ссылка.Характеристика
	|	ГДЕ
	|		ВариантыКомплектацииНоменклатурыТовары.Номенклатура <> ЗНАЧЕНИЕ(Справочник.Номенклатура.ПустаяСсылка)
	|	;
	|	
	|	////////////////////////////////////////////////////////////////////////////////
	|	ВЫБРАТЬ
	|		ВТ_Комплект.НоменклатураКомплект КАК НоменклатураКомплект,
	|		ВТ_Комплект.ХарактеристикаКомплект КАК ХарактеристикаКомплект,
	|		ВТ_Комплект.КоличествоКомплектация КАК КоличествоКомплектация,
	|		ВЫБОР
	|			КОГДА РаспределениеЗапасов.Свободно ЕСТЬ NULL
	|				ТОГДА 0
	|			КОГДА РаспределениеЗапасов.Свободно = 0
	|				ТОГДА 0
	|			ИНАЧЕ РаспределениеЗапасов.Свободно / ВТ_Комплект.КоличествоКомплектация
	|		КОНЕЦ КАК СвободноКомплектация,
	|		ВТ_Комплект.НоменклатураКомплектация КАК НоменклатураКомплектация,
	|		ВТ_Комплект.ХарактеристикаКомплектация КАК ХарактеристикаКомплектация
	|	ПОМЕСТИТЬ ВТ_КомплектацияОстаток
	|	ИЗ
	|		ВТ_Комплект КАК ВТ_Комплект
	|			ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.РаспределениеЗапасов КАК РаспределениеЗапасов
	|			ПО ВТ_Комплект.НоменклатураКомплектация = РаспределениеЗапасов.Номенклатура
	|				И ВТ_Комплект.ХарактеристикаКомплектация = РаспределениеЗапасов.Характеристика
	|	ГДЕ
	|		РаспределениеЗапасов.Склад В(&Склад)
	|		И РаспределениеЗапасов.Назначение В(&Назначение)
	|		И РаспределениеЗапасов.Состояние = ЗНАЧЕНИЕ(Перечисление.РаспределениеЗапасовСостояния.ОстатокНаСкладе)
	|	;
	|	
	|	////////////////////////////////////////////////////////////////////////////////
	|	ВЫБРАТЬ
	|		ВТ_Комплект.НоменклатураКомплект КАК НоменклатураКомплект,
	|		ВТ_Комплект.ХарактеристикаКомплект КАК ХарактеристикаКомплект,
	|		МИНИМУМ(ЕСТЬNULL(ВТ_КомплектацияОстаток.СвободноКомплектация, 0)) КАК СвободноКомплектация
	|	ПОМЕСТИТЬ ВТ_ФиналКомплект
	|	ИЗ
	|		ВТ_Комплект КАК ВТ_Комплект
	|			ЛЕВОЕ СОЕДИНЕНИЕ ВТ_КомплектацияОстаток КАК ВТ_КомплектацияОстаток
	|			ПО (ВТ_Комплект.НоменклатураКомплектация = ВТ_КомплектацияОстаток.НоменклатураКомплектация
	|					И ВТ_Комплект.ХарактеристикаКомплектация = ВТ_КомплектацияОстаток.ХарактеристикаКомплектация	
	|					И ВТ_Комплект.НоменклатураКомплект = ВТ_КомплектацияОстаток.НоменклатураКомплект
	|					И ВТ_Комплект.ХарактеристикаКомплект = ВТ_КомплектацияОстаток.ХарактеристикаКомплект)
	|	
	|	СГРУППИРОВАТЬ ПО
	|		ВТ_Комплект.НоменклатураКомплект,
	|		ВТ_Комплект.ХарактеристикаКомплект
	|	;
	|	
	|	////////////////////////////////////////////////////////////////////////////////
	|	ВЫБРАТЬ
	|		ВТ_ФиналДоГруппировки.Номенклатура КАК Номенклатура,
	|		ВТ_ФиналДоГруппировки.Характеристика КАК Характеристика,
	|		МИНИМУМ(ВЫБОР
	|				КОГДА СпрНоменклатура.Ссылка.ТипНоменклатуры = ЗНАЧЕНИЕ(Перечисление.ТипыНоменклатуры.Набор)							
	|					ТОГДА ЕСТЬNULL(ВТ_ФиналКомплект.СвободноКомплектация, 0)
	|				ИНАЧЕ ЕСТЬNULL(ВТ_ФиналДоГруппировки.ВНаличииСоСклада, 0)
	|			КОНЕЦ) КАК ОстатокУТ,
	|		СУММА(ВТ_ФиналДоГруппировки.ВРезервеСоСклада) КАК РезервУТ
	|	ИЗ
	|		ВТ_ФиналДоГруппировки КАК ВТ_ФиналДоГруппировки
	|			ЛЕВОЕ СОЕДИНЕНИЕ ВТ_ФиналКомплект КАК ВТ_ФиналКомплект
	|			ПО ВТ_ФиналДоГруппировки.Номенклатура = ВТ_ФиналКомплект.НоменклатураКомплект
	|				И ВТ_ФиналДоГруппировки.Характеристика = ВТ_ФиналКомплект.ХарактеристикаКомплект
	|			ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Номенклатура КАК СпрНоменклатура
	|			ПО ВТ_ФиналДоГруппировки.Номенклатура = СпрНоменклатура.Ссылка
	|	
	|	СГРУППИРОВАТЬ ПО
	|		ВТ_ФиналДоГруппировки.Номенклатура,
	|		ВТ_ФиналДоГруппировки.Характеристика";

	Запрос.УстановитьПараметр("ВТ_Товары", ТаблицаНоменклатуры); 
	Запрос.УстановитьПараметр("Назначение", Справочники.Назначения.ПустаяСсылка());
	Запрос.УстановитьПараметр("Склад", Склад);


	Возврат Запрос.Выполнить().Выгрузить();
	
КонецФункции //- ИнфоСофт Стояк Ю.К. 24.09.2023 УА #00000

//+ ИнфоСофт Стояк Ю.К. 25.09.2023 УА #62245
&НаКлиенте
Процедура ПолучатьОстаткиПриИзменении(Элемент)
	
	Если ПолучатьОстатки Тогда
		Элементы.Склад.Видимость = Истина;
		Элементы.ОстатокПоСкладам.Видимость = Истина;
	Иначе
		Элементы.Склад.Видимость = Ложь;
		Элементы.ОстатокПоСкладам.Видимость = Ложь;
	КонецЕсли;
	
