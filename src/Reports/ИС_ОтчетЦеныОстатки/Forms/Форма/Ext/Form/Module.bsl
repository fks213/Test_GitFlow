
#Область ОбработчикиСобытийФормы

//+ ИнфоСофт Стояк Ю.К. 03.07.2023 УА #59330
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ИС_WB_Сервер.ПриСозданииНаСервере(ЭтотОбъект);
		
КонецПроцедуры //- ИнфоСофт Стояк Ю.К. 03.07.2023 УА #59330

//+ ИнфоСофт Стояк Ю.К. 16.12.2024 УА #89490
&НаКлиенте
Процедура ПолучатьОстаткиFBOПриИзменении(Элемент)
	Если ПолучатьОстаткиFBO Тогда
		Элементы.ПолучатьОстаткиВРамкахПрофиляFBYЯМ.Видимость = Истина;	
	Иначе
		Элементы.ПолучатьОстаткиВРамкахПрофиляFBYЯМ.Видимость = Ложь;
	КонецЕсли;	
КонецПроцедуры //- ИнфоСофт Стояк Ю.К. 16.12.2024 УА #89490

#КонецОбласти

#Область ОбработчикиКомандФормы

//+ ИнфоСофт Стояк Ю.К. 03.07.2023 УА #59330
&НаКлиенте
Процедура Сформировать(Команда) 
	
	Если Не ЗначениеЗаполнено(Профиль) Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю("Не выбран профиль");
		Возврат;
	КонецЕсли;
	
	Если Не ПолучатьОстатки И Не ПолучатьЦены Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю("Не выбран ни один тип данных для получения");
		Возврат;
	КонецЕсли;
	
	СформироватьНаСервере();
	
КонецПроцедуры //- ИнфоСофт Стояк Ю.К. 03.07.2023 УА #59330

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

//+ ИнфоСофт Стояк Ю.К. 03.07.2023 УА #59330
&НаСервере
Процедура СформироватьНаСервере()	
	
	РезультатЗапроса = СформироватьТаблицуНоменклатуры();
	
	ТаблицаНоменклатуры = РезультатЗапроса.Выгрузить();
	
	Если ПолучатьОстатки Тогда
		
		Остатки1С = Неопределено;
		
		Если ЗначениеЗаполнено(Склад) Тогда
			Остатки1С = ПолучитьОстатки1С(ТаблицаНоменклатуры);
		КонецЕсли;
		
		СтруктураМассивовНаименований = Новый Структура;
		
		Если WB Тогда 
			
			ОстаткиFBSWB = ИС_WB_Сервер.ПолучитьИнфорамциюОбОстаткахFBS(Профиль);
			Если ОстаткиFBSWB = Неопределено Тогда
				ОстаткиFBSWB = Новый ТаблицаЗначений;
			КонецЕсли; 
			
			Если ОстатокПоСкладам И ПолучатьОстаткиFBS Тогда
				ОстаткиПоСкладамFBSWB = ОстаткиFBSWB;
				НаименованияСкладовFBSWB = СвернутьМассив(ОстаткиFBSWB.ВыгрузитьКолонку("Склад"));
				СтруктураМассивовНаименований.Вставить("FBSWB", НаименованияСкладовFBSWB);
				//+ ИнфоСофт Стояк Ю.К. 18.11.2024 УА #87814				
				//ОстаткиПоСкладамFBSWB = ДобавитьНоменклатуруКОстаткам(ОстаткиFBSWB, 11);
				ОстаткиПоСкладамFBSWB = ДобавитьНоменклатуруКОстаткам(ОстаткиFBSWB, 12);
				//- ИнфоСофт Стояк Ю.К. 18.11.2024 УА #87814
			КонецЕсли;
			
			ОстаткиFBSWB = СуммироватьОстаткиWBПоТипу(ОстаткиFBSWB);
			ОстаткиFBSWB = ДобавитьНоменклатуруКОстаткам(ОстаткиFBSWB, 1);
			//+ ИнфоСофт Стояк Ю.К. 04.03.2024 УА #68577			
			ОстаткиFBSWB.Свернуть("Номенклатура, Характеристика, Артикул", "stock"); 
			//- ИнфоСофт Стояк Ю.К. 04.03.2024 УА #68577
			
			ОстаткиFBOWB = ИС_WB_Сервер.ПолучитьИнфорамциюОбОстаткахFBO(Профиль);
			Если ОстаткиFBOWB = Неопределено Тогда
				ОстаткиFBOWB = Новый ТаблицаЗначений;
			КонецЕсли; 
			
			Если ОстатокПоСкладам И ПолучатьОстаткиFBO Тогда
				ОстаткиПоСкладамFBOWB = ОстаткиFBOWB;
				НаименованияСкладовFBOWB = СвернутьМассив(ОстаткиFBOWB.ВыгрузитьКолонку("Склад"));
				СтруктураМассивовНаименований.Вставить("FBOWB",НаименованияСкладовFBOWB);
				ОстаткиПоСкладамFBOWB = ДобавитьНоменклатуруКОстаткам(ОстаткиFBOWB, 11);
			КонецЕсли;
			
			ОстаткиFBOWB = СуммироватьОстаткиWBПоТипу(ОстаткиFBOWB);
			ОстаткиFBOWB = ДобавитьНоменклатуруКОстаткам(ОстаткиFBOWB, 1);
			//+ ИнфоСофт Стояк Ю.К. 04.03.2024 УА #68577
			ОстаткиFBOWB.Свернуть("Номенклатура, Характеристика, Артикул", "stock");
			//- ИнфоСофт Стояк Ю.К. 04.03.2024 УА #68577
			
		КонецЕсли;  
		
		Если Ozon Тогда
			
			ОстаткиOzon = ИС_Ozon_Сервер.ПолучитьИнформациюОбОстатках(Профиль);  
			
			Если ОстаткиOzon = Неопределено Тогда
				ОстаткиOzonFBO = Новый ТаблицаЗначений;
				ОстаткиOzonFBS = Новый ТаблицаЗначений; 
			Иначе                                                              
				
				Если ОстатокПоСкладам И ПолучатьОстаткиFBS Тогда  
					
					ОстаткиПоСкладамOzonFBS = ИС_Ozon_Сервер.ПолучитьОстаткиПоСкладам(Профиль);
					
					Если ЗначениеЗаполнено(ОстаткиПоСкладамOzonFBS) Тогда
												
						НаименованияСкладовFBSOzon = СвернутьМассив(ОстаткиПоСкладамOzonFBS.ВыгрузитьКолонку("Склад"));
						СтруктураМассивовНаименований.Вставить("FBSOzon",НаименованияСкладовFBSOzon);
						ОстаткиПоСкладамOzonFBS = ДобавитьНоменклатуруКОстаткам(ОстаткиПоСкладамOzonFBS, 21);
						
					КонецЕсли;
										
				КонецЕсли;
				
				ОстаткиOzonFBO = СуммироватьОстаткиOzonПоТипу(ОстаткиOzon.FBO); 
				ОстаткиOzonFBO = ДобавитьНоменклатуруКОстаткам(ОстаткиOzonFBO, 2);
				
				ОстаткиOzonFBS = СуммироватьОстаткиOzonПоТипу(ОстаткиOzon.FBS);
				ОстаткиOzonFBS = ДобавитьНоменклатуруКОстаткам(ОстаткиOzonFBS, 2);
				
				//+ ИнфоСофт Стояк Ю.К. 07.11.2024 УА #72455				
				Если ОстатокПоСкладам И ПолучатьОстаткиFBO Тогда  
					
					ОстаткиПоСкладамOzonFBO = ИС_Ozon_Сервер.ПолучитьОстаткиПоСкладамFBO(Профиль);
					
					Если ЗначениеЗаполнено(ОстаткиПоСкладамOzonFBO) Тогда
												
						НаименованияСкладовFBOOzon = СвернутьМассив(ОстаткиПоСкладамOzonFBO.ВыгрузитьКолонку("warehouse_name"));
						СтруктураМассивовНаименований.Вставить("FBOOzon",НаименованияСкладовFBOOzon);
						ОстаткиПоСкладамOzonFBO = ДобавитьНоменклатуруКОстаткам(ОстаткиПоСкладамOzonFBO, 22);
						
					КонецЕсли;  
					
				КонецЕсли;
				//- ИнфоСофт Стояк Ю.К. 07.11.2024 УА #72455
				
			КонецЕсли;					
			
		КонецЕсли; 
		
		Если ЯМ Тогда  
			
			//+ ИнфоСофт Стояк Ю.К. 23.11.2024 УА #87127
			МассивНаименованийПараметров = Новый Массив;  
			МассивНаименованийПараметров.Добавить("ЯМКампанияID");
		
			Настройки = ИС_MP_Сервер.ПолучитьНастройки(Профиль, МассивНаименованийПараметров);
			
			IDКампанииТекущегоПрофиля = Настройки["ЯМКампанияID"];
			
			СписокМагазинов = ИС_ЯМ_Сервер.ПолучитьСписокМагазинов(Профиль); 		 
			
			Если СписокМагазинов = Неопределено Тогда
				Возврат;
			КонецЕсли;
			
			КампанияID = Неопределено;
			МассивID = Новый Массив; 
			ПрофильFBY = Ложь;
						
			Для Каждого Магазин Из СписокМагазинов Цикл
				Если Магазин.placementType = "FBY" Тогда
					
					КампанияID = Формат(Магазин.id, "ЧГ=0");	
					
					Если Число(КампанияID) = IDКампанииТекущегоПрофиля Тогда 
						ПрофильFBY = Истина;
					КонецЕсли;
					
					//+ ИнфоСофт Стояк Ю.К. 16.12.2024 УА #89490			
					Если ПрофильFBY И ПолучатьОстаткиВРамкахПрофиляFBYЯМ Тогда
						МассивID.Добавить(КампанияID);
						Прервать;
					ИначеЕсли Не ПолучатьОстаткиВРамкахПрофиляFBYЯМ Тогда
						МассивID.Добавить(КампанияID);
					КонецЕсли;
					//МассивID.Добавить(КампанияID);
					//- ИнфоСофт Стояк Ю.К. 16.12.2024 УА #89490
					
				КонецЕсли;			
			КонецЦикла;			
			
			Если ПрофильFBY Тогда
				ОстаткиЯМ = Неопределено;
			Иначе
				ОстаткиЯМ = ИС_ЯМ_Сервер.ПолучитьОстатки(Профиль);
			КонецЕсли;
			//ОстаткиЯМ = ИС_ЯМ_Сервер.ПолучитьОстатки(Профиль);
			//- ИнфоСофт Стояк Ю.К. 23.11.2024 УА #87127
			
			Если ОстаткиЯМ = Неопределено Тогда
				ОстаткиЯМ = Новый ТаблицаЗначений; 
			Иначе
				
				Если ОстатокПоСкладам И ПолучатьОстаткиFBS Тогда  															
					
					НаименованияСкладовFBSЯМ = СвернутьМассив(ОстаткиЯМ.ВыгрузитьКолонку("Склад"));
					СтруктураМассивовНаименований.Вставить("FBSЯМ", НаименованияСкладовFBSЯМ);
					ОстаткиПоСкладамFBSЯМ = ДобавитьНоменклатуруКОстаткам(ОстаткиЯМ, 31);
					
				КонецЕсли;
				
				ОстаткиЯМ = СуммироватьОстаткиЯМ(ОстаткиЯМ);
				ОстаткиЯМ = ДобавитьНоменклатуруКОстаткам(ОстаткиЯМ, 3);  	
				
			КонецЕсли;
			
			//+ ИнфоСофт Стояк Ю.К. 23.11.2024 УА #87127			
			//СписокМагазинов = ИС_ЯМ_Сервер.ПолучитьСписокМагазинов(Профиль); 		 
			//
			//Если СписокМагазинов = Неопределено Тогда
			//	Возврат;
			//КонецЕсли;
			//
			//КампанияID = Неопределено;
			//
			//Для Каждого Магазин Из СписокМагазинов Цикл
			//	Если Магазин.placementType = "FBY" Тогда
			//		КампанияID = Формат(Магазин.id, "ЧГ=0");	
			//		Прервать;
			//	КонецЕсли;			
			//КонецЦикла;
			
			ОстаткиЯМFBO = Неопределено;
			
			Для Каждого КампанияID Из МассивID Цикл
				
				ОстаткиЯМFBOБфуер = ИС_ЯМ_Сервер.ПолучитьОстатки(Профиль, КампанияID);		
				
				Если ОстаткиЯМFBO = Неопределено Тогда					
					ОстаткиЯМFBO = ОстаткиЯМFBOБфуер;
				Иначе
					Для каждого СтрокаИсточник Из ОстаткиЯМFBOБфуер Цикл
						НоваяСтрока = ОстаткиЯМFBO.Добавить();						
						ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаИсточник);						
						НоваяСтрока.НомерСтроки = ОстаткиЯМFBO.Количество();
					КонецЦикла;					
				КонецЕсли;
				
			КонецЦикла; 
			
			Если ОстаткиЯМFBO = Неопределено Тогда
				ОстаткиЯМFBO = Новый ТаблицаЗначений;				
			Иначе
				
				Если ОстатокПоСкладам И ПолучатьОстаткиFBO Тогда  															
					
					НаименованияСкладовFBOЯМ = СвернутьМассив(ОстаткиЯМFBO.ВыгрузитьКолонку("Склад"));
					СтруктураМассивовНаименований.Вставить("FBOЯМ", НаименованияСкладовFBOЯМ);
					ОстаткиПоСкладамFBOЯМ = ДобавитьНоменклатуруКОстаткам(ОстаткиЯМFBO, 31);
					
				КонецЕсли;
				
				ОстаткиЯМFBO = СуммироватьОстаткиЯМ(ОстаткиЯМFBO);
				ОстаткиЯМFBO = ДобавитьНоменклатуруКОстаткам(ОстаткиЯМFBO, 3);
				
			КонецЕсли;									
			
			//Если ЗначениеЗаполнено(КампанияID) Тогда

			//	СкладыFBY = ИС_ЯМ_Сервер.ПолучитьСкладыFBY(Профиль); 
			//	
			//	ОстаткиЯМFBO = ИС_ЯМ_Сервер.ПолучитьОстатки(Профиль, КампанияID);		
			//	
			//	Если ОстаткиЯМFBO = Неопределено Тогда
			//		ОстаткиЯМFBO = Новый ТаблицаЗначений;				
			//	Иначе
			//		
			//		Если ОстатокПоСкладам И ПолучатьОстаткиFBO Тогда  															
			//			
			//			НаименованияСкладовFBOЯМ = СвернутьМассив(ОстаткиЯМFBO.ВыгрузитьКолонку("Склад"));
			//			СтруктураМассивовНаименований.Вставить("FBOЯМ", НаименованияСкладовFBOЯМ);
			//			ОстаткиПоСкладамFBOЯМ = ДобавитьНоменклатуруКОстаткам(ОстаткиЯМFBO, 31);
			//			
			//		КонецЕсли;
			//		
			//		ОстаткиЯМFBO = СуммироватьОстаткиЯМ(ОстаткиЯМFBO);
			//		ОстаткиЯМFBO = ДобавитьНоменклатуруКОстаткам(ОстаткиЯМFBO, 3);
			//		
			//	КонецЕсли;
			//	
			//Иначе				
			//	ОстаткиЯМFBO = Новый ТаблицаЗначений;				
			//КонецЕсли;
			//- ИнфоСофт Стояк Ю.К. 23.11.2024 УА #87127
							
		КонецЕсли;
		
		Если Aliexpress Тогда
			
			ОстаткиАли = ИС_АЛИ_Сервер.ПолучитьОстаткиТовара(Профиль);
			
			Если ОстаткиАли = Неопределено Тогда
				ОстаткиАли = Новый ТаблицаЗначений;
			Иначе
				ОстаткиАли = ДобавитьНоменклатуруКОстаткам(ОстаткиАли, 4);
			КонецЕсли;
			
		КонецЕсли;
	
	КонецЕсли;
	
	Если ПолучатьЦены Тогда
		
		Если WB Тогда 
			
			ЦеныWB = ИС_WB_Сервер.ПолучитьИнформациюОСкидках(Профиль, 0);
			Если ЦеныWB = Неопределено Тогда
				ЦеныWB = Новый ТаблицаЗначений;
			Иначе      
				ЦеныWB = ДобавитьНоменклатуруКЦенам(ЦеныWB, 1);		
			КонецЕсли; 						
			
		КонецЕсли;  
		
		Если Ozon Тогда
			
			ЦеныOzon = ИС_Ozon_Сервер.ПолучитьИнформациюОЦенах(Профиль);  
			
			Если ЦеныOzon = Неопределено Тогда
				ЦеныOzon = Новый ТаблицаЗначений;				
			Иначе                                                              						
				ЦеныOzon = ДобавитьНоменклатуруКЦенам(ЦеныOzon, 2);
			КонецЕсли;					
			
		КонецЕсли; 
		
		Если ЯМ Тогда
			
			ЦеныЯМ = ИС_ЯМ_Сервер.ПолучитьСписокЦен(Профиль);
			
			Если ЦеныЯМ = Неопределено Тогда
				ЦеныЯМ = Новый ТаблицаЗначений; 
			Иначе
				ЦеныЯМ = ДобавитьНоменклатуруКЦенам(ЦеныЯМ, 3);	
			КонецЕсли;
			
		КонецЕсли;
		
		Если Aliexpress Тогда 
			
		КонецЕсли;
		
	КонецЕсли; 
	
	Если Не Aliexpress И Не ЯМ И Не WB И Не Ozon Тогда
		ОбщегоНазначения.СообщитьПользователю("Ни один маркетплейс не выбран!");
		Возврат;
	КонецЕсли;
	
	ИспХарактеристики = Константы.ИспользоватьХарактеристикиНоменклатуры.Получить();
	
	ТабДок = Новый ТабличныйДокумент;
	
	МакетТД = ПолучитьОбщийМакет("ОтчетПоМП");
	
	ОбластьШапка = МакетТД.ПолучитьОбласть("ШапкаТаблицы|Номенклатура"); 
			
	ТабДок.Вывести(ОбластьШапка);
	//+ ИнфоСофт Стояк Ю.К. 25.09.2023 УА #62245
	Если ИспХарактеристики Тогда 
		ОбластьШапка = МакетТД.ПолучитьОбласть("ШапкаТаблицы|Характеристика");
		ТабДок.Присоединить(ОбластьШапка);
	КонецЕсли;
	
	ОбластьШапка = МакетТД.ПолучитьОбласть("ШапкаТаблицы|Артикул"); 
	ОбластьШапка.Параметры.АртикулИмя = "Артикул 1C"; 						
	ТабДок.Присоединить(ОбластьШапка);  
	//- ИнфоСофт Стояк Ю.К. 25.09.2023 УА #62245
	
	Если ВыводитьАртикулыМП Тогда
		
		Если WB Тогда
			ОбластьШапка = МакетТД.ПолучитьОбласть("ШапкаТаблицы|Артикул");       
			ОбластьШапка.Параметры.АртикулИмя = "Артикул WB"; 						
			ТабДок.Присоединить(ОбластьШапка);	
		КонецЕсли;
		
		Если Ozon Тогда
			ОбластьШапка = МакетТД.ПолучитьОбласть("ШапкаТаблицы|Артикул"); 
			ОбластьШапка.Параметры.АртикулИмя = "Артикул Ozon"; 						
			ТабДок.Присоединить(ОбластьШапка);	
		КонецЕсли;
		
		Если ЯМ Тогда
			ОбластьШапка = МакетТД.ПолучитьОбласть("ШапкаТаблицы|Артикул"); 
			ОбластьШапка.Параметры.АртикулИмя = "Артикул Яндекс.Маркет"; 						
			ТабДок.Присоединить(ОбластьШапка);	
		КонецЕсли;
		
		Если Aliexpress Тогда
			ОбластьШапка = МакетТД.ПолучитьОбласть("ШапкаТаблицы|Артикул");  
			ОбластьШапка.Параметры.АртикулИмя = "Артикул Aliexpress"; 						
			ТабДок.Присоединить(ОбластьШапка);	
		КонецЕсли;
		
	КонецЕсли;
	
	ОбработатьШапку(ТабДок, МакетТД, СтруктураМассивовНаименований); 
