Функция ДобавитьНоменклатуруКЦенам(ТаблицаЗначений, МП = 0)
	
	Запрос = Новый Запрос;
	
	Если МП = 1 Тогда 
		
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	Данные.nmId КАК nmId,
		//+ ИнфоСофт Мурсалимов Д.Р. 16.05.24 УА #66901 
