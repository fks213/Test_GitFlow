		|	ИС_WB_СоответствиеРазмеров.Номенклатура КАК Номенклатура
		|ПОМЕСТИТЬ ВТ_Сопоставление
		|ИЗ
		|	ВТ_Номенклатура КАК ВТ_Номенклатура
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ИС_WB_СоответствиеРазмеров КАК ИС_WB_СоответствиеРазмеров
		|		ПО ВТ_Номенклатура.Ссылка = ИС_WB_СоответствиеРазмеров.РазмерWB.Владелец
		|
		|СГРУППИРОВАТЬ ПО
		|	ВТ_Номенклатура.Ссылка,
		|	ИС_WB_СоответствиеРазмеров.Номенклатура
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ЕСТЬNULL(Данные.Цена, 0) КАК ЦенаДоСкидок,
		|	ВТ_Сопоставление.Номенклатура КАК Номенклатура,
		|	ВЫБОР
		|		КОГДА НЕ Данные.Цена ЕСТЬ NULL
		|			ТОГДА Данные.Цена * ((100 - ЕСТЬNULL(Данные.Скидка, 0)) / 100)
		|		ИНАЧЕ 0
		|	КОНЕЦ КАК Цена
		|ИЗ
		|	ВТ_Сопоставление КАК ВТ_Сопоставление
		|		ЛЕВОЕ СОЕДИНЕНИЕ Данные КАК Данные
		|		ПО ВТ_Сопоставление.Ссылка.Код = Данные.nmId
		|ГДЕ
		|	НЕ ВТ_Сопоставление.Номенклатура ЕСТЬ NULL
		|
		|УПОРЯДОЧИТЬ ПО
		|	Номенклатура";
		
	ИначеЕсли МП = 2 Тогда		

		Запрос.Текст = 
		"ВЫБРАТЬ
		|	Данные.nmId КАК OfferId,
		|	Данные.product_id КАК product_id,
