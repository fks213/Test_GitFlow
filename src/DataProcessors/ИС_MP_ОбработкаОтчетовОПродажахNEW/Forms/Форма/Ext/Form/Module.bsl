			НоваяСтрока.SKU											= ?(Строка(ПолучитьТекстОбласти(ТабДок, РассчитаннаяСтрока, 4)) = "", 0, Число(СтрЗаменить(ПолучитьТекстОбласти(ТабДок, РассчитаннаяСтрока, 4), Символы.НПП, "")));
			НоваяСтрока.ШтрихКодТовара								= Строка(ПолучитьТекстОбласти(ТабДок, РассчитаннаяСтрока, 5));
			НоваяСтрока.РеализованоНаСумму							= ?(Строка(ПолучитьТекстОбласти(ТабДок, РассчитаннаяСтрока, 6)) = "", 0, Число(СтрЗаменить(ПолучитьТекстОбласти(ТабДок, РассчитаннаяСтрока, 6), Символы.НПП, "")));
			НоваяСтрока.ДоплатаЗаСчетOzon							= ?(Строка(ПолучитьТекстОбласти(ТабДок, РассчитаннаяСтрока, 7)) = "", 0, Число(СтрЗаменить(ПолучитьТекстОбласти(ТабДок, РассчитаннаяСтрока, 7), Символы.НПП, "")));
			НоваяСтрока.Количество									= ?(Строка(ПолучитьТекстОбласти(ТабДок, РассчитаннаяСтрока, 8)) = "", 0, Число(СтрЗаменить(ПолучитьТекстОбласти(ТабДок, РассчитаннаяСтрока, 8), Символы.НПП, "")));
			НоваяСтрока.ЦенаРеализация								= ?(Строка(ПолучитьТекстОбласти(ТабДок, РассчитаннаяСтрока, 9)) = "", 0, Число(СтрЗаменить(ПолучитьТекстОбласти(ТабДок, РассчитаннаяСтрока, 9), Символы.НПП, "")));
			
