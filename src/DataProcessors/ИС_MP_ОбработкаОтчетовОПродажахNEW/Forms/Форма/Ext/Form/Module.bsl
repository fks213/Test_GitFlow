&НаСервере
Функция ВыполнитьПроверкуЗаполненияНастроекПрофиля(Профиль, Маркетплейс, Настройки)
	
	РезультатПроверки = Истина;
	
	ПрефиксНастроек          = ИС_MP_Сервер.ПолучитьПрефиксНастроек(Маркетплейс);
	НаименованиеМаркетплейса = ИС_MP_Сервер.ПолучитьНаименованиеМаркетплейса(Маркетплейс);
	
	Настройка = Настройки.Получить("Контрагент" + ПрефиксНастроек);
	
	Если Настройка = Неопределено Или Настройка.Пустая() Тогда
		
		ТекстСообщения = СтрШаблон("Не заполнен контрагент в настройках профиля %1 для маркетплейса %2.", Профиль, НаименованиеМаркетплейса);
		ОбщегоНазначения.СообщитьПользователю(ТекстСообщения);
		
		РезультатПроверки = Ложь;
		
	КонецЕсли;
	
	ИспользоватьДоговорыСКлиентами = ПолучитьФункциональнуюОпцию("ИспользоватьДоговорыСКлиентами");
	
	Если ИспользоватьДоговорыСКлиентами Тогда
		
		Настройка = Настройки.Получить("Договор" + ПрефиксНастроек);
		
		Если Настройка = Неопределено Или Настройка.Пустая() Тогда
			
			ТекстСообщения = СтрШаблон("Не заполнен договор в настройках профиля %1 для маркетплейса %2.", Профиль, НаименованиеМаркетплейса);
			ОбщегоНазначения.СообщитьПользователю(ТекстСообщения);
			
			РезультатПроверки = Ложь;
			
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат РезультатПроверки;
	
КонецФункции //- ИнфоСофт Власова И.С. 06.08.24 УА #67453	

