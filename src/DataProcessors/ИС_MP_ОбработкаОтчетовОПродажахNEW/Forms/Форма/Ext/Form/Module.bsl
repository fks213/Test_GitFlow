&НаСервере
Процедура СформироватьОтчетаКомиссионераНаСервереСбер()  
	
	Комментарий = "Отчет комисисонера за период с " + ОтчетСбера.ДатаНачала + " по " + ОтчетСбера.ДатаОкончания;
	
	СписокПродажОК = СписокТранзакцийСбер.Выгрузить(); 
	
	Период = Новый СтандартныйПериод(ОтчетСбера.ДатаНачала, ОтчетСбера.ДатаОкончания); 
	
	//+ ИнфоСофт Стояк Ю.К. 01.10.2024 УА #74295	
	СтруктураДопПараметров = Новый Структура;
	СтруктураДопПараметров.Вставить("АльтернативныйСпособЗагрузки", АльтернативныйСпособЗагрузкиСбер);
	
	Отчет = ИС_Сбер_Сервер.СоздатьОтчетКомиссионера(Профиль, Период, СписокПродажОК, Комментарий, СтруктураДопПараметров); 
	//Отчет = ИС_Сбер_Сервер.СоздатьОтчетКомиссионера(Профиль, Период, СписокПродажОК, Комментарий);
	//- ИнфоСофт Стояк Ю.К. 01.10.2024 УА #74295
	
	Если ЗначениеЗаполнено(Отчет) Тогда
		
		ДобавитьНовыйДокумент(Отчет);
		
		ОбъектОтчета = ОтчетСбера.ПолучитьОбъект();
		
		НСтр = ОбъектОтчета.Документы.Добавить();
		НСтр.Документ = Отчет;
		
		ОбъектОтчета.Записать();
		
	КонецЕсли;
	
	//+ ИнфоСофт Стояк Ю.К. 01.10.2024 УА #74295	
	Если Не АльтернативныйСпособЗагрузкиСбер Тогда  
	//- ИнфоСофт Стояк Ю.К. 01.10.2024 УА #74295
		
		СуммаКомпенсации = ОтчетСбера.Компенсации.Итог("Компенсация");
		
		Если СуммаКомпенсации <> 0 Тогда
			Взаимозачет = ИС_Сбер_Сервер.ПолучитьДокументКорректировкиЗадолженности(Отчет, СуммаКомпенсации);	
		КонецЕсли;
		
		Если ЗначениеЗаполнено(Взаимозачет) Тогда
			
			ДобавитьНовыйДокумент(Взаимозачет);
			
			ОбъектОтчета = ОтчетСбера.ПолучитьОбъект();
			
			НСтр = ОбъектОтчета.Документы.Добавить();
			НСтр.Документ = Взаимозачет;
			
			ОбъектОтчета.Записать();
			
		КонецЕсли;   
		
	//+ ИнфоСофт Стояк Ю.К. 01.10.2024 УА #74295
	КонецЕсли;
	//- ИнфоСофт Стояк Ю.К. 01.10.2024 УА #74295
	
КонецПроцедуры //- ИнфоСофт Стояк Ю.К. 01.04.2024 УА #62567    

//+ ИнфоСофт Мурсалимов Д.Р. 05.09.24 УА #82005
&НаСервере   
Функция ДобавитьСопоставление(ТаблицаТранзакций, Профиль)
		
	ТекстЗапроса =
	"ВЫБРАТЬ
	|	втТаблицаТранзакций.СтрокаНомер КАК СтрокаНомер,
	|	втТаблицаТранзакций.Артикул КАК Артикул,
	|	втТаблицаТранзакций.СтоимостьТовара КАК СтоимостьТовара,
	|	втТаблицаТранзакций.Количество КАК Количество,
	|	втТаблицаТранзакций.Бонусы КАК Бонусы,
	|	втТаблицаТранзакций.СберСпасибо КАК СберСпасибо,
	|	втТаблицаТранзакций.ЦенаПродажи КАК ЦенаПродажи,
	|	втТаблицаТранзакций.СуммаТоварныхУслуг КАК СуммаТоварныхУслуг,
	|	втТаблицаТранзакций.УслугиКРаспределению КАК УслугиКРаспределению,
	|	втТаблицаТранзакций.НомерОтправленияМП КАК НомерОтправленияМП,
	|	втТаблицаТранзакций.НомерОтправления КАК НомерОтправления,
	|	втТаблицаТранзакций.СтатусЗаказа КАК СтатусЗаказа,
	|	втТаблицаТранзакций.ДатаОтправления КАК ДатаОтправления
	|ПОМЕСТИТЬ втТаблицаТранзакций
	|ИЗ
	|	&ТаблицаТранзакций КАК втТаблицаТранзакций
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	МАКСИМУМ(ИС_Сбер_Товары.Номенклатура) КАК Номенклатура,
	|	МАКСИМУМ(ИС_Сбер_Товары.Характеристика) КАК Характеристика,
	|	втТаблицаТранзакций.Артикул КАК Артикул,
	|	МАКСИМУМ(ВЫБОР
	|			КОГДА ИС_Сбер_Товары.Номенклатура.ТипНоменклатуры = ЗНАЧЕНИЕ(Перечисление.ТипыНоменклатуры.Набор)
	|				ТОГДА ИСТИНА
	|			ИНАЧЕ ЛОЖЬ
	|		КОНЕЦ) КАК ЭтоНабор,
	|	МАКСИМУМ(ИС_Сбер_Товары.Упаковка) КАК Упаковка,
	|	МАКСИМУМ(ВЫБОР
	|		КОГДА ИС_Сбер_Товары.Упаковка ЕСТЬ NULL ИЛИ ИС_Сбер_Товары.Упаковка.Числитель = 0
	|			ТОГДА 1
	|		ИНАЧЕ ИС_Сбер_Товары.Упаковка.Числитель
	|	КОНЕЦ / ВЫБОР
	|		КОГДА ИС_Сбер_Товары.Упаковка ЕСТЬ NULL ИЛИ ИС_Сбер_Товары.Упаковка.Знаменатель = 0
	|			ТОГДА 1
	|		ИНАЧЕ ИС_Сбер_Товары.Упаковка.Знаменатель
	|	КОНЕЦ) КАК КоэффициентУпаковки
	|ПОМЕСТИТЬ ВТ_Номенклатура
	|ИЗ
	|	втТаблицаТранзакций КАК втТаблицаТранзакций
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ИС_Сбер_Товары КАК ИС_Сбер_Товары
	|		ПО (ИС_Сбер_Товары.offerID = втТаблицаТранзакций.Артикул)
	|
	|СГРУППИРОВАТЬ ПО
	|	втТаблицаТранзакций.Артикул
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	втТаблицаТранзакций.СтрокаНомер КАК СтрокаНомер,
	|	втТаблицаТранзакций.Артикул КАК Артикул,
	|	втТаблицаТранзакций.СтоимостьТовара КАК СтоимостьТовара,
	|	втТаблицаТранзакций.Количество КАК Количество,
	|	втТаблицаТранзакций.Бонусы КАК Бонусы,
	|	втТаблицаТранзакций.СберСпасибо КАК СберСпасибо,
	|	втТаблицаТранзакций.ЦенаПродажи КАК ЦенаПродажи,
	|	втТаблицаТранзакций.СуммаТоварныхУслуг КАК СуммаТоварныхУслуг,
	|	втТаблицаТранзакций.УслугиКРаспределению КАК УслугиКРаспределению,
	|	втТаблицаТранзакций.НомерОтправленияМП КАК НомерОтправленияМП,
	|	втТаблицаТранзакций.НомерОтправления КАК НомерОтправления,
	|	втТаблицаТранзакций.СтатусЗаказа КАК СтатусЗаказа,
	|	втТаблицаТранзакций.ДатаОтправления КАК ДатаОтправления,
	|	ВТ_Номенклатура.Номенклатура КАК Номенклатура,
	|	ВТ_Номенклатура.Характеристика КАК ХарактеристикаНоменклатуры,
	|	ВТ_Номенклатура.ЭтоНабор КАК ЭтоНабор,
	|	ВТ_Номенклатура.Упаковка КАК Упаковка,
	|	ВТ_Номенклатура.КоэффициентУпаковки КАК КоэффициентУпаковки
	|ИЗ
	|	втТаблицаТранзакций КАК втТаблицаТранзакций
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_Номенклатура КАК ВТ_Номенклатура
	|		ПО втТаблицаТранзакций.Артикул = ВТ_Номенклатура.Артикул"; 
	
	Запрос = Новый Запрос;
	
	Запрос.УстановитьПараметр("Профиль", 			Профиль);
	Запрос.УстановитьПараметр("ТаблицаТранзакций", 	ТаблицаТранзакций);	
	
	Запрос.Текст = ТекстЗапроса;
	
	РезультатЗапроса = Запрос.Выполнить().Выгрузить(); 
	
	Возврат РезультатЗапроса;
	
КонецФункции //- ИнфоСофт Мурсалимов Д.Р. 05.09.24 УА #82005

