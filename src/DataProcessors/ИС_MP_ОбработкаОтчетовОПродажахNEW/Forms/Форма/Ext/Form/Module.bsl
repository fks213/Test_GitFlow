&НаСервере
Функция ПолучитьНоменклатуруОзон(ТаблицаСопоставления)
	
	Запрос = Новый Запрос("ВЫБРАТЬ
	|	СопоставлениеOzon.НаименованиеТовара КАК НаименованиеТовара,
	|	СопоставлениеOzon.offer_id КАК offer_id,
	|	СопоставлениеOzon.SKU КАК SKU,
	|	СопоставлениеOzon.ШтрихКодТовара КАК ШтрихКодТовара
	|ПОМЕСТИТЬ ВТ_Данные
	|ИЗ
	|	&СопоставлениеOzon КАК СопоставлениеOzon
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_Данные.НаименованиеТовара КАК НаименованиеТовара,
	|	ВТ_Данные.offer_id КАК offer_id,
	|	ВТ_Данные.SKU КАК SKU,
	|	ВТ_Данные.ШтрихКодТовара КАК ШтрихКодТовара,
	|	ЕСТЬNULL(ИС_Ozon_Номенклатура.Ссылка, ЗНАЧЕНИЕ(Справочник.ИС_Ozon_Номенклатура.ПустаяСсылка)) КАК НоменклатураOzon
	|ИЗ
	|	ВТ_Данные КАК ВТ_Данные
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ИС_Ozon_Номенклатура КАК ИС_Ozon_Номенклатура
	|		ПО (ВТ_Данные.offer_id = ИС_Ozon_Номенклатура.offer_id
	|				И ИС_Ozon_Номенклатура.Профиль = &Профиль)");
	
	Запрос.УстановитьПараметр("СопоставлениеOzon", ТаблицаСопоставления);
	Запрос.УстановитьПараметр("Профиль", Профиль);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Выборка = РезультатЗапроса.Выбрать();
	
	СопоставлениеТЗ = Новый ТаблицаЗначений();
	
	СопоставлениеТЗ.Колонки.Добавить("НаименованиеТовара", Новый ОписаниеТипов("Строка")); 
	СопоставлениеТЗ.Колонки.Добавить("offer_id", Новый ОписаниеТипов("Строка"));
	СопоставлениеТЗ.Колонки.Добавить("SKU", Новый ОписаниеТипов("Строка"));
	СопоставлениеТЗ.Колонки.Добавить("ШтрихКодТовара", Новый ОписаниеТипов("Строка"));
	СопоставлениеТЗ.Колонки.Добавить("НоменклатураOzon", Новый ОписаниеТипов("СправочникСсылка.ИС_Ozon_Номенклатура"));
	
	КрточкиОзонЗагружены = Истина;
	
	Пока Выборка.Следующий() Цикл
		НоваяСтрока 							= СопоставлениеТЗ.Добавить();
		НоваяСтрока.НаименованиеТовара 			= Выборка.НаименованиеТовара;
		НоваяСтрока.offer_id 					= Выборка.offer_id;
		НоваяСтрока.SKU 						= Выборка.SKU;
		НоваяСтрока.ШтрихКодТовара 				= Выборка.ШтрихКодТовара;
		НоваяСтрока.НоменклатураOzon 			= Выборка.НоменклатураOzon; 
		
		Если Не ЗначениеЗаполнено(Выборка.НоменклатураOzon) Тогда
			КрточкиОзонЗагружены = Ложь;	
		КонецЕсли;	 
		
	КонецЦикла;
	
	Результат = Новый Структура;
	
	Результат.Вставить("КрточкиОзонЗагружены", КрточкиОзонЗагружены);
	Результат.Вставить("Сопоставление", СопоставлениеТЗ);
	
	Возврат Результат;
	
КонецФункции //- ИнфоСофт Сумин Д.В. 29.08.2023 УА #61252

//+ ИнфоСофт Сумин Д.В. 19.10.2023 УА #63924
&НаСервере
Функция ПолучитьВерсиюКомиссииОзон(Настройки = Неопределено) 
	
	Если Настройки = Неопределено Тогда
		МассивНаименованийПараметров = Новый Массив;	
		МассивНаименованийПараметров.Добавить("СоглашениеOzon");
		МассивНаименованийПараметров.Добавить("ДоговорOzon");
		Настройки = ИС_MP_Сервер.ПолучитьНастройки(Профиль, МассивНаименованийПараметров);	
	КонецЕсли;
	
	ИспользоватьСоглашенияСКлиентами = ПолучитьФункциональнуюОпцию("ИспользоватьСоглашенияСКлиентами"); 
	
	Если ИспользоватьСоглашенияСКлиентами И Настройки["СоглашениеOzon"] <> Неопределено И ЗначениеЗаполнено(Настройки["СоглашениеOzon"]) Тогда 
		КомиссионныеПродажи25 = Настройки["СоглашениеOzon"].КомиссионныеПродажи25		
	Иначе
		КомиссионныеПродажи25 = Настройки["ДоговорOzon"].КомиссионныеПродажи25;	
	КонецЕсли;
	
	Если КомиссионныеПродажи25 = Неопределено Тогда
		ВызватьИсключение("Проверьте настройки заполнения профиля по схеме комиссии.");	
	КонецЕсли;	
	
	Возврат КомиссионныеПродажи25;
	
КонецФункции //- ИнфоСофт Сумин Д.В. 19.10.2023 УА #63924

