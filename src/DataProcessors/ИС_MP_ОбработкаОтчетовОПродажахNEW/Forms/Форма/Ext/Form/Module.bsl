//+ ИнфоСофт Сумин Д.В. 16.08.2023 УА #61252
&НаКлиенте
Процедура ПутьКФайлуОтчетаНачалоВыбора(Элемент, ДанныеВыбора, ВыборДобавлением, СтандартнаяОбработка) 
	
	ОчиститьСообщения(); 
	
	ДиалогВыбораФайла = Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.Открытие);
	ДиалогВыбораФайла.Заголовок = "Выберите файл отчета комиссионера";
	ДиалогВыбораФайла.МножественныйВыбор =  Ложь;
	ДиалогВыбораФайла.ПроверятьСуществованиеФайла = Истина;
	//+ ИнфоСофт Стояк Ю.К. 31.03.2024 УА #62567                                           
	РасширениеФайлаZip = Ложь;
	Если Элементы.СтраницаОсновная.ТекущаяСтраница.Имя = Элементы.СтраницаСбер.Имя Тогда 
		ДиалогВыбораФайла.Фильтр = "Архив ZIP (*.zip)|*.zip|CSV файлы(*.csv)|*.csv";
	Иначе
		ДиалогВыбораФайла.Фильтр = "Excel файлы(*.xls;*.xlsx)|*.xls;*.xlsx";
	КонецЕсли;                                  
	//ДиалогВыбораФайла.Фильтр = "Excel файлы(*.xls;*.xlsx)|*.xls;*.xlsx";
	//- ИнфоСофт Стояк Ю.К. 31.03.2024 УА #62567	
	
	ДополнительныеПараметры = Новый Структура;
	ДополнительныеПараметры.Вставить("Реквизит", "ПутьКФайлуОтчета"); 
	//+ ИнфоСофт Стояк Ю.К. 31.03.2024 УА #62567
	ДополнительныеПараметры.Вставить("ЭтоZip", "РасширениеФайлаZip");
	//- ИнфоСофт Стояк Ю.К. 31.03.2024 УА #62567
	ДополнительныеПараметры.Вставить("Адрес", "АдресОтчетаВоВременномХранилище");  
	ДополнительныеПараметры.Вставить("ДиалогВыбораФайла", ДиалогВыбораФайла);
	
	ДиалогВыбораФайла.Показать(Новый ОписаниеОповещения("ПутьКФайлуНачалоВыбораЗавершение", ЭтотОбъект, ДополнительныеПараметры));
	
КонецПроцедуры //- ИнфоСофт Сумин Д.В. 16.08.2023 УА #61252

//+ ИнфоСофт Сумин Д.В. 16.08.2023 УА #61252
&НаКлиенте
Процедура ПрочитатьДанныеИзФайла(Команда)
	
	Если НЕ ЗначениеЗаполнено(Профиль) Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю("Не выбран профиль.", , , "Профиль");
		Возврат;
	КонецЕсли; 
	
	Если НЕ ЗначениеЗаполнено(ПутьКФайлуОтчета) Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю("Не выбран файл отчета.", , , "ПутьКФайлуОтчета");
		Возврат;
	КонецЕсли; 
	
	//+ ИнфоСофт Стояк Ю.К. 23.07.2024 УА #79419
	//Если НовыйФорматФайлаЯМ Тогда
	Если НовыйФорматФайлаЯМ Или ФорматФайлаДо31052024ЯМ Тогда
	//- ИнфоСофт Стояк Ю.К. 23.07.2024 УА #79419
	//+ ИнфоСофт Сумин Д.В. 13.05.2024 УА #74879	
		ПолучитьТаблицуЗначенийПродажИзФайлаЯндексПосле30032024();
	ИначеЕсли ФорматФайлаДо31032024ЯМ Тогда	
		ПолучитьТаблицуЗначенийПродажИзФайлаЯндекс(); 
	Иначе
		ОбщегоНазначенияКлиент.СообщитьПользователю(НСтр("ru = 'Необходимо выбрать формат файла.'"));
	КонецЕсли;
	//ПолучитьТаблицуЗначенийПродажИзФайлаЯндекс(); 
	//- ИнфоСофт Сумин Д.В. 13.05.2024 УА #74879 
	
	ЗаписатьДанныеПродаж(); 
		
КонецПроцедуры //- ИнфоСофт Сумин Д.В. 16.08.2023 УА #61252

//+ ИнфоСофт Сумин Д.В. 16.08.2023 УА #61252
&НаКлиенте
Процедура ПутьКФайлуНачалоВыбораЗавершение(Результат, ДополнительныеПараметры) Экспорт
	
	ДиалогВыбораФайла = ДополнительныеПараметры.ДиалогВыбораФайла;
	Если Результат = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ВыбранныеФайлы = ДиалогВыбораФайла.ВыбранныеФайлы;
	
	Если ВыбранныеФайлы <> Неопределено Тогда
		
		ЭтотОбъект[ДополнительныеПараметры.Реквизит] = ВыбранныеФайлы[0];
		
		ВыбранныйФайл = Новый Файл(ВыбранныеФайлы[0]); 
		//+ ИнфоСофт Стояк Ю.К. 31.03.2024 УА #62567		
		Расширение = ВыбранныйФайл.Расширение; 				                                  	
		
		Если Расширение = ".zip" Тогда  						
			ЭтотОбъект[ДополнительныеПараметры.ЭтоZip] = Истина;
		ИначеЕсли Элементы.СтраницаОсновная.ТекущаяСтраница.Имя = Элементы.СтраницаСбер.Имя Тогда  
			//+ ИнфоСофт Стояк Ю.К. 10.06.2024 УА #77384
			//ДатаОтчета = Дата(Сред(ВыбранныйФайл.ИмяБезРасширения, СтрДлина(ВыбранныйФайл.ИмяБезРасширения) - 9, 10) + " 00:00:00");			
			Попытка
				ДатаОтчета = Дата(Сред(ВыбранныйФайл.ИмяБезРасширения, СтрДлина(ВыбранныйФайл.ИмяБезРасширения) - 9, 10) + " 00:00:00");			
				//+ ИнфоСофт Стояк Ю.К. 09.08.2024 УА #81299				
				ДатаДопФайла = ДатаОтчета;                  
				//- ИнфоСофт Стояк Ю.К. 09.08.2024 УА #81299
			Исключение
				ОбщегоНазначенияКлиент.СообщитьПользователю("Не удалось получить дату отчета из названия файла. Укажите дату на форме!");
				Элементы.ДатаОтчета.Видимость = Истина;
			КонецПопытки;
			//- ИнфоСофт Стояк Ю.К. 10.06.2024 УА #77384
		КонецЕсли;                                  
		//- ИнфоСофт Стояк Ю.К. 31.03.2024 УА #62567
		
		ПутьКФайлуВоВременномКаталоге = ВыбранныеФайлы[0];
		ПоместитьФайлНаСервер(ДополнительныеПараметры.Адрес);
		
	КонецЕсли;
	
КонецПроцедуры //- ИнфоСофт Сумин Д.В. 16.08.2023 УА #61252

//+ ИнфоСофт Сумин Д.В. 16.08.2023 УА #61252
&НаКлиенте
Процедура ПоместитьФайлНаСервер(Адрес)
	
	ОписаниеОповещения = Новый ОписаниеОповещения("ПоместитьФайлНаСерверЗавершение", ЭтотОбъект, Новый Структура("Адрес", Адрес));
	НачатьПомещениеФайлаНаСервер(ОписаниеОповещения, , , , ПутьКФайлуВоВременномКаталоге, УникальныйИдентификатор);
	
КонецПроцедуры //- ИнфоСофт Сумин Д.В. 16.08.2023 УА #61252

//+ ИнфоСофт Сумин Д.В. 16.08.2023 УА #61252
&НаКлиенте
Процедура ВыполнитьСозданиеДокументов(Команда)
	
	Если Не ЗначениеЗаполнено(Профиль) Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю("Необходимо заполнить профиль.",,,"Профиль");
	    Возврат;
	КонецЕсли;	
	
	ЗаполнитьДоговорыСоглашения();
	
	Если РеализацияЧерезКомиссионераЯМ Тогда
		//+ ИнфоСофт Власова И.С. 06.08.24 УА #67453
		//СформироватьРеализациюЧерезКомиссионераНаСервере();
		Если Не СформироватьРеализациюЧерезКомиссионераНаСервере() Тогда
			Возврат;
		КонецЕсли;	
		//- ИнфоСофт Власова И.С. 06.08.24 УА #67453	
	Иначе
		//+ ИнфоСофт Власова И.С. 06.08.24 УА #81190
		//СформироватьОтчетаКомиссионераНаСервере();
		СформироватьОтчетКомиссионераНаСервере();
		//- ИнфоСофт Власова И.С. 06.08.24 УА #81190	
	КонецЕсли;
	
	УстановитьНачальноеОформлениеЯМ();
	
КонецПроцедуры //- ИнфоСофт Сумин Д.В. 16.08.2023 УА #61252

//+ ИнфоСофт Сумин Д.В. 16.08.2023 УА #61252
&НаКлиенте
Процедура РеализацияЧерезКомиссионераПриИзменении(Элемент) 
	
	Если НЕ ЗначениеЗаполнено(Период) Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю("Не выбран период.", , , "Период");
		РеализацияЧерезКомиссионераЯМ = Ложь;
		Возврат;
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(Профиль) Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю("Не выбран период.", , , "Профиль");
		РеализацияЧерезКомиссионераЯМ = Ложь;
		Возврат;
	КонецЕсли; 
	
	Если РеализацияЧерезКомиссионераЯМ Тогда 
		
		Попытка
			ОтчетКомиссионераЯМ = Ложь; 
			
			ЯндексКонтрагенты.Очистить(); 
			
			Если СписокТранзакцийExcelЯМ.Количество() = 0 Тогда
				
				ПолучитьСписокТранзакцийПродаж();
				
				Если СписокТранзакцийExcelЯМ.Количество() = 0 Тогда
					
					ОбщегоНазначенияКлиент.СообщитьПользователю("В данном периоде не найдены продажи для выбранного профиля. Выполните загрузку файла о продажах.");
					РеализацияЧерезКомиссионераЯМ = Ложь;
					Возврат;
					
				КонецЕсли;
				
			КонецЕсли;
			
			ОшибкаСопоставления = ПолучитьРезультатПроверкиСопоставленияЯМ();
			
			Если ОшибкаСопоставления Тогда
				
				РеализацияЧерезКомиссионераЯМ = Ложь;
				
				//+ ИнфоСофт Заварин К.В. 28.03.25 УА #97359
				СписокТранзакцийExcelЯМ.Сортировать("Номенклатура", "");
				//- ИнфоСофт Заварин К.В. 28.03.25 УА #97359
				
				Возврат;
				
			Иначе
				Элементы.СписокТранзакцийExcelЯМ.Видимость = ложь;
			КонецЕсли;
			
			РезультатПроверки = ПолучитьРезультатПроверкиПродажЮрЛицам();  
			
			КонтрагентыСопоставлены = ПолучитьРезультатСопоставленияКонтрагентов();
			
			//+ ИнфоСофт Власова И.С. 05.08.24 УА #81190
			Если АвтоматическиСоздатьКонтрагентовЯМ И КонтрагентыСопоставлены = "НеЗаполненыДанныеКомиссии" Тогда
				РеализацияЧерезКомиссионераЯМ = Ложь;
				Возврат;
			КонецЕсли;	
			//- ИнфоСофт Власова И.С. 05.08.24 УА #81190
			
			Если РезультатПроверки.РеализацияЧерезКомиссионера Тогда
				ЗаполнитьКонтрагентыОтображениеНаСервере("Яндекс");	
				Элементы.ЯндексКонтрагентыОтображение.Видимость = Истина;
			Иначе 
				РеализацияЧерезКомиссионераЯМ = Ложь;
				ОтчетКомиссионера = Истина;
			КонецЕсли; 
			
			Если ЗначениеЗаполнено(РезультатПроверки.СообщениеПользователю) Тогда
				ОбщегоНазначенияКлиент.СообщитьПользователю(РезультатПроверки.СообщениеПользователю);
			КонецЕсли; 
			
			Если КонтрагентыСопоставлены Тогда
				Элементы.ГруппаСозданиеДокументов.Видимость = Истина;
			Иначе
				Элементы.СоздатьКонтрагентаЯМ.Видимость = Истина;
				Элементы.ГруппаСозданиеДокументов.Видимость = Ложь;
				РеализацияЧерезКомиссионераЯМ = Ложь;
			КонецЕсли;
			
		Исключение
			
		КонецПопытки;
		
	КонецЕсли;
	
КонецПроцедуры //- ИнфоСофт Сумин Д.В. 16.08.2023 УА #61252 

//+ ИнфоСофт Сумин Д.В. 16.08.2023 УА #61252
&НаКлиенте
Процедура ОтчетКомиссионераПриИзменении(Элемент)
	
	Если НЕ ЗначениеЗаполнено(Период) Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю("Не выбран период.", , , "Период");
		ОтчетКомиссионераЯМ = Ложь;
		Возврат;
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(Профиль) Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю("Не выбран профиль.", , , "Профиль");
		РеализацияЧерезКомиссионераЯМ = Ложь;
		Возврат;
	КонецЕсли;
	
	Если ОтчетКомиссионераЯМ Тогда
		
		Если СписокТранзакцийExcelЯМ.Количество() = 0 Тогда
			
			ПолучитьСписокТранзакцийПродаж();
			Если СписокТранзакцийExcelЯМ.Количество() = 0 Тогда
				
				ОбщегоНазначенияКлиент.СообщитьПользователю("В данном периоде не найдены продажи для выбранного профиля. Выполните загрузку файла о продажах.");
				ОтчетКомиссионера = Ложь;
				Возврат;
				
			КонецЕсли;
			
		КонецЕсли;  
		
		ОшибкаСопоставления = ПолучитьРезультатПроверкиСопоставленияЯМ();
		
		Если ОшибкаСопоставления Тогда
			ОтчетКомиссионераЯМ = Ложь;
			
			//+ ИнфоСофт Заварин К.В. 12.03.25 УА #95878
			СписокТранзакцийExcelЯМ.Сортировать("Номенклатура", "");
			//- ИнфоСофт Заварин К.В. 12.03.25 УА #95878
			
			Возврат;
		Иначе
			Элементы.СписокТранзакцийExcelЯМ.Видимость = ложь;
		КонецЕсли;
		
		
		//+ ИнфоСофт Заварин К.В. 12.03.25 УА #95878
		СписокТранзакцийExcelЯМ.Сортировать("Номенклатура", "");
		//- ИнфоСофт Заварин К.В. 12.03.25 УА #95878
		
		ЗаполнитьКонтрагентыОтображениеНаСервере("Яндекс");	
		РеализацияЧерезКомиссионераЯМ = Ложь;
		Элементы.СоздатьКонтрагентаЯМ.Видимость = Ложь;
		Элементы.ГруппаСозданиеДокументов.Видимость = Истина;
		Элементы.ЯндексКонтрагентыОтображение.Видимость = Ложь;
		
		//+ ИнфоСофт Заварин К.В. 18.09.24 УА #83149	
		Если АвтоматическиСоздатьКонтрагентовЯМ И ЗаполнитьКолонкуПокупательЯМ Тогда 
			
			ЯндексКонтрагенты.Очистить();
			
			РезультатПроверки = ПолучитьРезультатПроверкиПродажЮрЛицам();  
			
			КонтрагентыСопоставлены = ПолучитьРезультатСопоставленияКонтрагентов();
			
			Если КонтрагентыСопоставлены = "НеЗаполненыДанныеКомиссии" Тогда
				Возврат;
			КонецЕсли;	
			
			Если РезультатПроверки.РеализацияЧерезКомиссионера Тогда
				ЗаполнитьКонтрагентыОтображениеНаСервере("Яндекс");	
				Элементы.ЯндексКонтрагентыОтображение.Видимость = Истина;
			КонецЕсли; 
			
			Если ЗначениеЗаполнено(РезультатПроверки.СообщениеПользователю) Тогда
				ОбщегоНазначенияКлиент.СообщитьПользователю(РезультатПроверки.СообщениеПользователю);
			КонецЕсли;
			
			Если КонтрагентыСопоставлены Тогда
				Элементы.ГруппаСозданиеДокументов.Видимость = Истина;
			Иначе
				Элементы.СоздатьКонтрагентаЯМ.Видимость = Истина;
				Элементы.ГруппаСозданиеДокументов.Видимость = Ложь;
				РеализацияЧерезКомиссионераЯМ = Ложь;
			КонецЕсли; 
			
		КонецЕсли;
		//- ИнфоСофт Заварин К.В. 18.09.24 УА #83149
		
	КонецЕсли;
КонецПроцедуры //- ИнфоСофт Сумин Д.В. 16.08.2023 УА #61252

//+ ИнфоСофт Сумин Д.В. 16.08.2023 УА #61252
&НаКлиенте
Процедура ПоказатьПунктДва(Команда)
	Элементы.ГруппаНастройкиСозданиеДокументов.Видимость = Истина;
	Элементы.ПоказатьПунктДва.Видимость = Ложь;
КонецПроцедуры //- ИнфоСофт Сумин Д.В. 16.08.2023 УА #61252

//+ ИнфоСофт Сумин Д.В. 20.08.2023 УА #61252
&НаКлиенте
Процедура СоздатьКонтрагента(Команда) 
	
	Если ЗначениеЗаполнено(Элементы.ЯндексКонтрагентыОтображение.ТекущиеДанные.Партнер) Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю("Контрагент уже создан.");
		Возврат;
	КонецЕсли;
	
	ЭлементыЗаполнения = Новый Структура();
	ЭлементыЗаполнения.Вставить("Инн", Элементы.ЯндексКонтрагентыОтображение.ТекущиеДанные.Инн);
	
	ИНН = Элементы.ЯндексКонтрагентыОтображение.ТекущиеДанные.Инн;
	Отбор = Новый Структура("ИНН", ИНН);
	
	НаименованиеКлиента = ЯндексКонтрагенты.НайтиСтроки(Отбор)[0].НаименованиеКлиента;
	
	ЭлементыЗаполнения.Вставить("Наименование", НаименованиеКлиента);
	ЭлементыЗаполнения.Вставить("СокращенноеНаименование", НаименованиеКлиента);
