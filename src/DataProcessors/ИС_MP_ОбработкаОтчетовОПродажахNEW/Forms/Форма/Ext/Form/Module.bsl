//+ ИнфоСофт Власова И.С. 06.08.24 УА #67453
&НаСервере
Функция СформироватьРеализациюЧерезКомиссионераНаСервере() 

	МассивНаименованийПараметров = Новый Массив;
	
	МассивНаименованийПараметров.Добавить("СоглашениеЯМ");
	МассивНаименованийПараметров.Добавить("ДоговорЯМ");
	//+ ИнфоСофт Власова И.С. 06.08.24 УА #67453
	МассивНаименованийПараметров.Добавить("КонтрагентЯМ");
	//- ИнфоСофт Власова И.С. 06.08.24 УА #67453
	
	Настройки = ИС_MP_Сервер.ПолучитьНастройки(Профиль, МассивНаименованийПараметров);

	//+ ИнфоСофт Власова И.С. 06.08.24 УА #67453
	//КомиссионныеПродажи25 = ПолучитьВерсиюКомиссии(Настройки);
	
	Маркетплейс = Перечисления.ИС_МП_Маркетплейсы.ЯМ;
	
	КомиссионныеПродажи25 = ИС_MP_Сервер.ПолучитьВерсиюКомиссионныхПродаж(Профиль, Маркетплейс);
	
	ПараметрыОтбора = Новый Структура("ПродажаЮрЛицу", Ложь);
		
	ЕстьРозничныеПродажи = ?(СписокТранзакцийExcelЯМ.Выгрузить(ПараметрыОтбора).Количество() > 0, Истина, Ложь);
	
	Если ((КомиссионныеПродажи25 Или ЕстьРозничныеПродажи) И Не ВыполнитьПроверкуЗаполненияНастроекПрофиля(Профиль, Маркетплейс, Настройки)) 
		Или (ЯндексКонтрагенты.Количество() > 0 И Не ВыполнитьПроверкуЗаполненияДанныхПоКлиентам("Яндекс", КомиссионныеПродажи25)) Тогда
		
		Возврат Ложь;
		
	КонецЕсли;
	//- ИнфоСофт Власова И.С. 06.08.24 УА #67453	
	
	СформироватьРеализацииЧерезКомиссионера(КомиссионныеПродажи25, Настройки);
	Элементы.СозданныеДокументы.Видимость = Истина;
	
	//+ ИнфоСофт Власова И.С. 06.08.24 УА #67453
	Возврат Истина;
	//- ИнфоСофт Власова И.С. 06.08.24 УА #67453

КонецФункции // ИнфоСофт Власова И.С. 06.08.24 УА #67453

