//+ ИнфоСофт Власова И.С. 06.08.24 УА #67453
&НаСервере
Функция СформироватьРеализациюЧерезКомиссионераНаСервереОзон()
	
	МассивНаименованийПараметров = Новый Массив;
	
	МассивНаименованийПараметров.Добавить("СоглашениеOzon");
	МассивНаименованийПараметров.Добавить("ДоговорOzon");
	//+ ИнфоСофт Власова И.С. 06.08.24 УА #67453
	МассивНаименованийПараметров.Добавить("КонтрагентOzon");
	//- ИнфоСофт Власова И.С. 06.08.24 УА #67453
	
	Настройки = ИС_MP_Сервер.ПолучитьНастройки(Профиль, МассивНаименованийПараметров);
	
	//+ ИнфоСофт Власова И.С. 06.08.24 УА #67453
	//КомиссионныеПродажи25 = ПолучитьВерсиюКомиссииОзон(Настройки);
	
	Маркетплейс = Перечисления.ИС_МП_Маркетплейсы.Озон;
	
	КомиссионныеПродажи25 = ИС_MP_Сервер.ПолучитьВерсиюКомиссионныхПродаж(Профиль, Маркетплейс);
	
	ПараметрыОтбора = Новый Структура("ПродажаЮрЛицу", Ложь);
		
	ЕстьРозничныеПродажи = ?(СписокТранзакцийExcelOzon.Выгрузить(ПараметрыОтбора).Количество() > 0, Истина, Ложь);
	
	Если ((КомиссионныеПродажи25 Или ЕстьРозничныеПродажи) И Не ВыполнитьПроверкуЗаполненияНастроекПрофиля(Профиль, Маркетплейс, Настройки)) 
		Или (OzonКонтрагенты.Количество() > 0 И Не ВыполнитьПроверкуЗаполненияДанныхПоКлиентам("Ozon", КомиссионныеПродажи25)) Тогда
		
		Возврат Ложь;
		
	КонецЕсли;
	//- ИнфоСофт Власова И.С. 06.08.24 УА #67453	
	
	СформироватьРеализацииЧерезКомиссионераОзон(КомиссионныеПродажи25, Настройки);
	Элементы.СозданныеДокументыОзон.Видимость = Истина;
	
	//+ ИнфоСофт Власова И.С. 06.08.24 УА #67453
	Возврат Истина;
	//- ИнфоСофт Власова И.С. 06.08.24 УА #67453

КонецФункции //- ИнфоСофт Власова И.С. 06.08.24 УА #67453

//+ ИнфоСофт Мурсалимов Д.Р. 21.10.24 УА #85566
&НаСервере
Процедура СформироватьРеализацииЧерезКомиссионераОзон(КомиссионныеПродажи25, Настройки) 

	Запрос = Новый Запрос;
	
	Запрос.Текст =
	"ВЫБРАТЬ
	|	СписокТранзакций.Номенклатура КАК Номенклатура,
	|	СписокТранзакций.ХарактеристикаНоменклатуры КАК ХарактеристикаНоменклатуры,
	|	СписокТранзакций.ЦенаРеализация КАК ЦенаРеализация,
	|	СписокТранзакций.Количество КАК Количество,
	|	СписокТранзакций.РеализованоНаСумму КАК РеализованоНаСумму,
	|	СписокТранзакций.СуммаЛояльностиРеализации КАК СуммаЛояльностиРеализации,
	|	СписокТранзакций.ЭтоНабор КАК ЭтоНабор,
	|	СписокТранзакций.НомерОтправления КАК НомерОтправления,
	|	СписокТранзакций.НомерСчетФактуры КАК НомерСчетФактуры,
	|	СписокТранзакций.ДатаСчетФактуры КАК ДатаСчетФактуры,
	|	СписокТранзакций.ПродажаЮрЛицу КАК ПродажаЮрЛицу
	|ПОМЕСТИТЬ ВТ_СписокТранзакций
	|ИЗ
	|	&СписокТранзакций КАК СписокТранзакций
	|ГДЕ
	|	СписокТранзакций.ПродажаЮрЛицу
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Контрагенты.Контрагент КАК Контрагент,
	|	Контрагенты.Договор КАК Договор,
	|	Контрагенты.Соглашение КАК Соглашение,
	|	ЕСТЬNULL(ВЫРАЗИТЬ(Контрагенты.Партнер КАК Справочник.Партнеры), ЗНАЧЕНИЕ(Справочник.Партнеры.ПустаяСсылка)) КАК Партнер,
	|	Контрагенты.НомерЗаказа КАК НомерОтправления
	|ПОМЕСТИТЬ ВТ_Контрагенты
	|ИЗ
	|	&Контрагенты КАК Контрагенты
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ИС_Ozon_Продажи.НомерОтправления КАК НомерОтправления,
	|	МАКСИМУМ(ИС_Ozon_Продажи.НомерСчетФактуры) КАК НомерСчетФактуры,
	|	МАКСИМУМ(ИС_Ozon_Продажи.ДатаСчетФактуры) КАК ДатаСчетФактуры
	|ПОМЕСТИТЬ ВТ_НомераСчетФактур
	|ИЗ
	|	ВТ_СписокТранзакций КАК ВТ_СписокТранзакций
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ИС_Ozon_Продажи КАК ИС_Ozon_Продажи
	|		ПО ВТ_СписокТранзакций.НомерОтправления = ИС_Ozon_Продажи.НомерОтправления
	|ГДЕ
	|	ИС_Ozon_Продажи.Профиль = &Профиль
	|	И ИС_Ozon_Продажи.ДатаНачала МЕЖДУ &ДатаНачала И &ДатаОкончания
	|	И ИС_Ozon_Продажи.ДатаОкончания МЕЖДУ &ДатаНачала И &ДатаОкончания
	|
	|СГРУППИРОВАТЬ ПО
	|	ИС_Ozon_Продажи.НомерОтправления
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_СписокТранзакций.Количество КАК Количество,
	|	ВТ_СписокТранзакций.Номенклатура КАК Номенклатура,
	|	ВТ_СписокТранзакций.РеализованоНаСумму КАК РеализованоНаСумму,
	|	ВТ_СписокТранзакций.СуммаЛояльностиРеализации КАК СуммаЛояльностиРеализации,
	|	ВТ_СписокТранзакций.ХарактеристикаНоменклатуры КАК ХарактеристикаНоменклатуры,
	|	ВТ_СписокТранзакций.ЦенаРеализация КАК ЦенаРеализация,
	|	ВТ_СписокТранзакций.ЭтоНабор КАК ЭтоНабор,
	|	ВТ_НомераСчетФактур.НомерСчетФактуры КАК НомерСчетФактуры,
	|	ВТ_НомераСчетФактур.ДатаСчетФактуры КАК ДатаСчетФактуры,
	|	ВТ_Контрагенты.Договор КАК Договор,
	|	ВТ_Контрагенты.Контрагент КАК Контрагент,
	|	ВТ_Контрагенты.Партнер КАК Партнер,
	|	ВТ_Контрагенты.Соглашение КАК Соглашение
	|ИЗ
	|	ВТ_СписокТранзакций КАК ВТ_СписокТранзакций
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_НомераСчетФактур КАК ВТ_НомераСчетФактур
	|		ПО ВТ_СписокТранзакций.НомерОтправления = ВТ_НомераСчетФактур.НомерОтправления
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_Контрагенты КАК ВТ_Контрагенты
	|		ПО ВТ_СписокТранзакций.НомерОтправления = ВТ_Контрагенты.НомерОтправления
	|
	|УПОРЯДОЧИТЬ ПО
	|	Партнер
	|ИТОГИ ПО
	|	НомерСчетФактуры";
 	
	Запрос.УстановитьПараметр("СписокТранзакций", 	СписокТранзакцийExcelOzon.Выгрузить());
	Запрос.УстановитьПараметр("Контрагенты", 		OzonКонтрагенты.Выгрузить());
	Запрос.УстановитьПараметр("Профиль", 			Профиль);
	Запрос.УстановитьПараметр("ДатаНачала", 		ПериодOzon.ДатаНачала);
	Запрос.УстановитьПараметр("ДатаОкончания", 		ПериодOzon.ДатаОкончания);
	
	КвалификаторЧисла = Новый КвалификаторыЧисла(10,2);
	
	ТаблицаПродажРеализацииЧерезКомиссионера = Новый ТаблицаЗначений;
		
	ТаблицаПродажРеализацииЧерезКомиссионера.Колонки.Добавить("Партнер", 					Новый ОписаниеТипов("СправочникСсылка.Партнеры"));
	ТаблицаПродажРеализацииЧерезКомиссионера.Колонки.Добавить("Контрагент", 				Новый ОписаниеТипов("СправочникСсылка.Контрагенты")); 
	ТаблицаПродажРеализацииЧерезКомиссионера.Колонки.Добавить("Договор", 					Новый ОписаниеТипов("СправочникСсылка.ДоговорыКонтрагентов"));
	ТаблицаПродажРеализацииЧерезКомиссионера.Колонки.Добавить("Соглашение", 				Новый ОписаниеТипов("СправочникСсылка.СоглашенияСКлиентами"));
	ТаблицаПродажРеализацииЧерезКомиссионера.Колонки.Добавить("Номенклатура", 				Новый ОписаниеТипов("СправочникСсылка.Номенклатура"));
	ТаблицаПродажРеализацииЧерезКомиссионера.Колонки.Добавить("ХарактеристикаНоменклатуры", Новый ОписаниеТипов("СправочникСсылка.ХарактеристикиНоменклатуры"));
	ТаблицаПродажРеализацииЧерезКомиссионера.Колонки.Добавить("Количество", 				Новый ОписаниеТипов("Число",,,КвалификаторЧисла));
	ТаблицаПродажРеализацииЧерезКомиссионера.Колонки.Добавить("РеализованоНаСумму", 		Новый ОписаниеТипов("Число",,,КвалификаторЧисла));
	ТаблицаПродажРеализацииЧерезКомиссионера.Колонки.Добавить("СуммаЛояльностиРеализации", 	Новый ОписаниеТипов("Число",,,КвалификаторЧисла));
	ТаблицаПродажРеализацииЧерезКомиссионера.Колонки.Добавить("ЦенаРеализация", 			Новый ОписаниеТипов("Число",,,КвалификаторЧисла));
	ТаблицаПродажРеализацииЧерезКомиссионера.Колонки.Добавить("ЭтоНабор", 					Новый ОписаниеТипов("Булево"));
	ТаблицаПродажРеализацииЧерезКомиссионера.Колонки.Добавить("НомерСчетФактуры",	 		Новый ОписаниеТипов("Строка"));
	ТаблицаПродажРеализацииЧерезКомиссионера.Колонки.Добавить("ДатаСчетФактуры", 			Новый ОписаниеТипов("Дата"));
	
	СтруктураДанных = Новый Структура;
	СтруктураДанных.Вставить("Профиль", Профиль);
	СтруктураДанных.Вставить("Период", 	ПериодOzon);	
	
	РезультатЗапроса = Запрос.Выполнить();
	Выборка = РезультатЗапроса.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);  
	
	МассивВзаимозачет = Новый Массив();
	
	Пока Выборка.Следующий() Цикл
		
		ВыборкаДетальныеЗаписи = Выборка.Выбрать();  
		
		ТаблицаПродажРеализацииЧерезКомиссионера.Очистить();
		
		Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
			
			НоваяСтрока = ТаблицаПродажРеализацииЧерезКомиссионера.Добавить(); 
			
			ЗаполнитьЗначенияСвойств(НоваяСтрока, ВыборкаДетальныеЗаписи);
			
		КонецЦикла;	
		
		СтруктураДанных.Вставить("ТаблицаПродаж", 				ТаблицаПродажРеализацииЧерезКомиссионера);
		СтруктураДанных.Вставить("РеализацияЧерезКомиссионера", КомиссионныеПродажи25);
		СтруктураДанных.Вставить("ЗаказКлиента", 				Неопределено);	
		
		Если Не КомиссионныеПродажи25 Тогда 
			
			ДокументВозврат = ИС_Ozon_Сервер.СоздатьДокументВозвратТоваров(СтруктураДанных);
			
			ДобавитьНовыйДокумент(ДокументВозврат);  		
			
			ПорядокРасчетов = ПолучитьПорядокРасчетов(СтруктураДанных.ТаблицаПродаж[0]); 
			
			СтруктураВзаимозачет = Новый Структура();		
			
			Если ПорядокРасчетов = Перечисления.ПорядокРасчетов.ПоЗаказам Тогда
				
				ДокументЗаказ = ИС_Ozon_Сервер.СоздатьЗаказКлиента(СтруктураДанных);
				
				ДобавитьНовыйДокумент(ДокументЗаказ);
				
				СтруктураДанных.Вставить("ЗаказКлиента", 		ДокументЗаказ.Ссылка);	
				СтруктураВзаимозачет.Вставить("ОбъектРасчетов", ДокументЗаказ.Ссылка);
				
			КонецЕсли;
			
		КонецЕсли;
		
		ДокументРеализация = ИС_Ozon_Сервер.СоздатьРеализациюТоваровЧерезКомиссионера(СтруктураДанных);
		
		Если ДокументРеализация <> Неопределено Тогда
			
			Если Не КомиссионныеПродажи25 Тогда
				
				Если ПорядокРасчетов = Перечисления.ПорядокРасчетов.ПоНакладным Тогда 
					СтруктураВзаимозачет.Вставить("ОбъектРасчетов", ДокументРеализация.Ссылка);
				КонецЕсли;
				
				Если ПорядокРасчетов = Перечисления.ПорядокРасчетов.ПоДоговорамКонтрагентов Тогда
					СтруктураВзаимозачет.Вставить("ОбъектРасчетов", ДокументВозврат.Договор)
				КонецЕсли;
				
				СтруктураВзаимозачет.Вставить("ДокументРеализация", ДокументРеализация.Ссылка);
				
				МассивВзаимозачет.Добавить(СтруктураВзаимозачет);
				
			КонецЕсли;
			
			ДобавитьНовыйДокумент(ДокументРеализация.Ссылка); 
			
			//+ ИнфоСофт Мурсалимов Д.Р. 25.03.25 УА #96800
			СуммаЛояльностиРеализации = ТаблицаПродажРеализацииЧерезКомиссионера[0].СуммаЛояльностиРеализации;
			
			Если СуммаЛояльностиРеализации = 0 Тогда
				Продолжить;
			КонецЕсли;
			
			СтруктураДанных.Вставить("Номенклатура", 	ОзонУслугаЮрЛиц);
			СтруктураДанных.Вставить("Соглашение", 		ОзонСоглашениеЮрЛиц);
			СтруктураДанных.Вставить("Договор", 		ОзонДоговорЮрЛиц);
			
			ДокументРеализацияУслуг = ИС_Ozon_Сервер.СоздатьРеализациюУслугПоЮрЛицам(СтруктураДанных);
			
			Если ДокументРеализацияУслуг = Неопределено Тогда
				Продолжить;
			КонецЕсли;
			
			ДобавитьНовыйДокумент(ДокументРеализацияУслуг.Ссылка);
			
			Если КомиссионныеПродажи25 Тогда
				Продолжить;
			КонецЕсли;
			
			СтруктураВзаимозачет = Новый Структура();
			
			СтруктураВзаимозачет.Вставить("ОбъектРасчетов", 	ДокументРеализацияУслуг.Ссылка);				
			СтруктураВзаимозачет.Вставить("ДокументРеализация", ДокументРеализацияУслуг.Ссылка);
			
			МассивВзаимозачет.Добавить(СтруктураВзаимозачет);
			//- ИнфоСофт Мурсалимов Д.Р. 25.03.25 УА #96800
			
		КонецЕсли;
		
	КонецЦикла;
	
	ПараметрыОтбора 			= Новый Структура("ПродажаЮрЛицу", Ложь);
		
	СписокПродажОК 				= СписокТранзакцийExcelOzon.Выгрузить(ПараметрыОтбора);

	ВсегоВыплатыОтПартнеров 	= СписокТранзакцийExcelOzon.Итог("ВыплатыОтПартнеров") 					- СписокТранзакцийExcelOzon.Итог("ВозвратВыплатыОтПартнеров");
	ВсегоКНачислению 			= СписокТранзакцийExcelOzon.Итог("ИтогиКНачислению")					- СписокТранзакцийExcelOzon.Итог("ИтогоВозвращено");
	ВсегоНачисленоБаллов 		= СписокТранзакцийExcelOzon.Итог("ДоплатаЗаСчетOzon") 					- СписокТранзакцийExcelOzon.Итог("ВозвратДоплатаЗаСчетOzon");
	ВсегоБазоваяКомиссия 		= СписокТранзакцийExcelOzon.Итог("ИтогиКомиссияСУчетомСкидокИНаценок") 	- СписокТранзакцийExcelOzon.Итог("ВозвратИтогиКомиссияСУчетомСкидокИНаценок");
	ВсегоКомиссияПослеСкидок 	= ВсегоБазоваяКомиссия - ВсегоНачисленоБаллов;
	
	Если ВсегоКомиссияПослеСкидок < ВсегоБазоваяКомиссия / 100 Тогда
		ВсегоКомиссияПослеСкидок = ВсегоБазоваяКомиссия / 100;
	КонецЕсли;
		
	Если СписокПродажОК.Количество() > 0 Тогда
		
		Комментарий = "Отчет комиссионера за период с " + ПериодOzon.ДатаНачала + " по " + ПериодOzon.ДатаОкончания;	
		
		//+ ИнфоСофт Заварин К.В. 19.09.24 УА #83149
		СтруктураПараметров = Новый Структура;
		СтруктураПараметров.Вставить("ЗаполнитьКолонкуПокупательОзон", ЗаполнитьКолонкуПокупательОзон);
		//+ ИнфоСофт Власова И.С. 10.12.24 УА #87450
		СтруктураПараметров.Вставить("РозничныйПокупательОзон",        РозничныйПокупательОзон);
		//- ИнфоСофт Власова И.С. 10.12.24 УА #87450
		//- ИнфоСофт Заварин К.В. 19.09.24 УА #83149
		//+ ИнфоСофт Стояк Ю.К. 18.02.2025 УА #92095		
		СтруктураПараметров.Вставить("Профиль", 					   Профиль);
		//- ИнфоСофт Стояк Ю.К. 18.02.2025 УА #92095
		
		Отчет = ИС_Ozon_Сервер.СоздатьДокументОтчетКомиссионера(Профиль, ПериодOzon, СписокПродажОК, Комментарий, ВсегоКомиссияПослеСкидок, СтруктураПараметров);	
		
		Если Отчет <> Неопределено Тогда
			ДобавитьНовыйДокумент(Отчет);
		КонецЕсли;
		
		Для Каждого Элемент Из МассивВзаимозачет Цикл
			
			Взаимозачет = ИС_МП_УправлениеЗаказами.СоздатьДокументВзаимозачетЗадолженности(Элемент.ОбъектРасчетов, Элемент.ДокументРеализация, Отчет);	
			ДобавитьНовыйДокумент(Взаимозачет);
			
		КонецЦикла;
		
	КонецЕсли;
		
КонецПроцедуры //- ИнфоСофт Мурсалимов Д.Р. 21.10.24 УА #85566

//+ ИнфоСофт Сумин Д.В. 19.10.2023 УА #63924
&НаСервере
Функция ПолучитьРезультатСопоставленияКонтрагентовОзон() 
	
	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	Контрагенты.ИНН КАК ИНН,
	|	Контрагенты.НомерЗаказа КАК НомерЗаказа,
	|	Контрагенты.НаименованиеКлиента КАК НаименованиеКлиента,
	|	Контрагенты.АдресКлиента КАК Адрес
	|ПОМЕСТИТЬ ВТ_Данные
	|ИЗ
	|	&Контрагенты КАК Контрагенты
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_Данные.ИНН КАК ИНН,
	|	ВТ_Данные.НомерЗаказа КАК НомерЗаказа,
	|	ВТ_Данные.Адрес КАК Адрес,
	|	ВТ_Данные.НаименованиеКлиента КАК НаименованиеКлиента,
	|	Партнеры.Ссылка КАК Партнер,
	|	Контрагенты.Ссылка КАК Контрагент
	|ПОМЕСТИТЬ ВТ_Контрагенты
	|ИЗ
	|	ВТ_Данные КАК ВТ_Данные
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Контрагенты КАК Контрагенты
	|			ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Партнеры КАК Партнеры
	|			ПО Контрагенты.Партнер = Партнеры.Ссылка
	|		ПО ВТ_Данные.ИНН = Контрагенты.ИНН
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
