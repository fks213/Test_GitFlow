	|	ИС_ЯМ_Продажи.ИннПокупателя КАК ИНН
	|ИЗ
	|	РегистрСведений.ИС_ЯМ_Продажи КАК ИС_ЯМ_Продажи
	|ГДЕ
	|	ИС_ЯМ_Продажи.Профиль = &Профиль
	|	И ИС_ЯМ_Продажи.ПродажаЮрЛицу
	//+ ИнфоСофт Заварин К.В. 12.11.24 УА #87034
	//|	И ИС_ЯМ_Продажи.ДатаОформленияЗаказа МЕЖДУ &ДатаНачала И &ДатаОкончания"); 
	|	И ИС_ЯМ_Продажи.ДатаДоставкиТовара МЕЖДУ &ДатаНачала И &ДатаОкончания");
	//- ИнфоСофт Заварин К.В. 12.11.24 УА #87034
	
	Запрос.УстановитьПараметр("Профиль", Профиль);
	Запрос.УстановитьПараметр("ДатаНачала", Период.ДатаНачала); 
	Запрос.УстановитьПараметр("ДатаОкончания", Период.ДатаОкончания);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Если РезультатЗапроса.Пустой() Тогда
		РезультатПроверки.Вставить("РеализацияЧерезКомиссионера", Ложь);
		РезультатПроверки.Вставить("СообщениеПользователю", "В данном периоде не найдены продажи юр. лицам. Реализация через комиссионера не требуется. Перейдите к пункту 3.");	
		Возврат РезультатПроверки;	
	КонецЕсли;	
	
	Выборка = РезультатЗапроса.Выбрать();
	
	Пока Выборка.Следующий() Цикл		
		
		НоваяСтрокаКонтрагент = ЯндексКонтрагенты.Добавить();
		
		ЗаполнитьЗначенияСвойств(НоваяСтрокаКонтрагент, Выборка);

	КонецЦикла; 
	
	Возврат РезультатПроверки; 
	
КонецФункции //- ИнфоСофт Сумин Д.В. 18.08.2023 УА #61252

//+ ИнфоСофт Сумин Д.В. 18.08.2023 УА #61252
&НаСервере
Функция ПолучитьРезультатСопоставленияКонтрагентов() 
	
	//+ ИнфоСофт Заварин К.В. 04.03.25 УА #95036
	МассивНаименованийПараметров = Новый Массив;	
	
	МассивНаименованийПараметров.Добавить("ДоговорЯМ");
	МассивНаименованийПараметров.Добавить("ПартнерЯМ");
	МассивНаименованийПараметров.Добавить("КонтрагентЯМ");

	Настройки = ИС_MP_Сервер.ПолучитьНастройки(Профиль, МассивНаименованийПараметров);
	//- ИнфоСофт Заварин К.В. 04.03.25 УА #95036
	
	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	Контрагенты.ИНН КАК ИНН,
	|	Контрагенты.НомерЗаказа КАК НомерЗаказа,
	|	Контрагенты.НаименованиеКлиента КАК НаименованиеКлиента,
	|	Контрагенты.АдресКлиента КАК Адрес
	|ПОМЕСТИТЬ ВТ_Данные
	|ИЗ
	|	&Контрагенты КАК Контрагенты
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_Данные.ИНН КАК ИНН,
	|	ВТ_Данные.НомерЗаказа КАК НомерЗаказа,
	|	ВТ_Данные.Адрес КАК Адрес,
	|	ВТ_Данные.НаименованиеКлиента КАК НаименованиеКлиента,
	|	Партнеры.Ссылка КАК Партнер,
	|	Контрагенты.Ссылка КАК Контрагент
	|ПОМЕСТИТЬ ВТ_Контрагенты
	|ИЗ
	|	ВТ_Данные КАК ВТ_Данные
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Контрагенты КАК Контрагенты
	|			ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Партнеры КАК Партнеры
	|			ПО Контрагенты.Партнер = Партнеры.Ссылка
	|		ПО ВТ_Данные.ИНН = Контрагенты.ИНН
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_Контрагенты.ИНН КАК ИНН,
	|	МАКСИМУМ(ДоговорыКонтрагентов.Ссылка) КАК Договор,
	|	МАКСИМУМ(ВТ_Контрагенты.НаименованиеКлиента) КАК НаименованиеКлиента,
	|	МАКСИМУМ(ВТ_Контрагенты.Адрес) КАК Адрес,
	|	МАКСИМУМ(СоглашенияСКлиентами.Ссылка) КАК Соглашение
	|ПОМЕСТИТЬ ВТ_Договоры
	|ИЗ
	|	ВТ_Контрагенты КАК ВТ_Контрагенты
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ДоговорыКонтрагентов КАК ДоговорыКонтрагентов
	|		ПО (ВТ_Контрагенты.Контрагент = ДоговорыКонтрагентов.Контрагент
	|				И ВТ_Контрагенты.Партнер = ДоговорыКонтрагентов.Партнер
	|				И ВЫБОР
	|					КОГДА &КомиссионныеПродажи25
	|						ТОГДА ДоговорыКонтрагентов.ТипДоговора = ЗНАЧЕНИЕ(Перечисление.ТипыДоговоров.РеализацияЧерезКомиссионера)
	|					ИНАЧЕ ДоговорыКонтрагентов.ТипДоговора = ЗНАЧЕНИЕ(Перечисление.ТипыДоговоров.СПокупателем)
	|				КОНЕЦ
	|				И ДоговорыКонтрагентов.Организация = &Организация)
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.СоглашенияСКлиентами КАК СоглашенияСКлиентами
	|		ПО (ВТ_Контрагенты.Контрагент = СоглашенияСКлиентами.Контрагент
	|				И ВЫБОР
	|					КОГДА &КомиссионныеПродажи25
	|						ТОГДА СоглашенияСКлиентами.ХозяйственнаяОперация = ЗНАЧЕНИЕ(Перечисление.ХозяйственныеОперации.ПередачаНаКОмиссию)
	|					ИНАЧЕ СоглашенияСКлиентами.ХозяйственнаяОперация = ЗНАЧЕНИЕ(Перечисление.ХозяйственныеОперации.РеализацияКлиенту)
	|				КОНЕЦ
	|				И СоглашенияСКлиентами.Организация = &Организация)
	//+ ИнфоСофт Заварин К.В. 04.03.25 УА #95036
	|
	|ГДЕ
	|	ДоговорыКонтрагентов.КомиссионерКонтрагент = &КомиссионерКонтрагент
	|
	//- ИнфоСофт Заварин К.В. 04.03.25 УА #95036
	|СГРУППИРОВАТЬ ПО
	|	ВТ_Контрагенты.ИНН
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_Контрагенты.ИНН КАК ИНН,
	|	ВТ_Контрагенты.НомерЗаказа КАК НомерЗаказа,
//+ ИнфоСофт Сумин Д.В. 03.05.2024 УА #67144
	|	ВТ_Контрагенты.Адрес КАК АдресКлиента,
	//|	ВТ_Контрагенты.Адрес КАК Адрес,
//- ИнфоСофт Сумин Д.В. 03.05.2024 УА #67144
	|	ВТ_Контрагенты.НаименованиеКлиента КАК НаименованиеКлиента,
	|	ВТ_Контрагенты.Партнер КАК Партнер,
	|	ВТ_Контрагенты.Контрагент КАК Контрагент,
	|	ВТ_Договоры.Договор КАК Договор,
	|	ВТ_Договоры.Соглашение КАК Соглашение
	|ИЗ
	|	ВТ_Контрагенты КАК ВТ_Контрагенты
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_Договоры КАК ВТ_Договоры
	|		ПО ВТ_Контрагенты.ИНН = ВТ_Договоры.ИНН");
	
	Запрос.УстановитьПараметр("Контрагенты", 			ЯндексКонтрагенты.Выгрузить()); 
	Запрос.УстановитьПараметр("Организация", 			Профиль.Организация);
	Запрос.УстановитьПараметр("КомиссионныеПродажи25", 	ПолучитьВерсиюКомиссии());
	//+ ИнфоСофт Заварин К.В. 04.03.25 УА #95036
	Запрос.УстановитьПараметр("КомиссионерКонтрагент", 	Настройки["КонтрагентЯМ"]);
	//- ИнфоСофт Заварин К.В. 04.03.25 УА #95036
	
	
	РезультатЗапроса = Запрос.Выполнить();	
	
	Выборка = РезультатЗапроса.Выбрать();
	
	ЯндексКонтрагенты.Очистить();
	
	//+ ИнфоСофт Заварин К.В. 04.03.25 УА #95036
	//+ ИнфоСофт Сумин Д.В. 02.05.2024 УА #67144
	//МассивНаименованийПараметров = Новый Массив;	
	//
	//МассивНаименованийПараметров.Добавить("ДоговорЯМ");
	//МассивНаименованийПараметров.Добавить("ПартнерЯМ");
	//МассивНаименованийПараметров.Добавить("КонтрагентЯМ");
		
	//Настройки = ИС_MP_Сервер.ПолучитьНастройки(Профиль, МассивНаименованийПараметров);
	//- ИнфоСофт Заварин К.В. 04.03.25 УА #95036
	
	//+ ИнфоСофт Власова И.С. 02.08.24 УА #80469
	СтруктураДанных = ИС_MP_Сервер.ПолучитьСтруктуруДляСозданияКонтрагента();
	СтруктураДанных.Маркетплейс           = Перечисления.ИС_МП_Маркетплейсы.ЯМ;
	//- ИнфоСофт Власова И.С. 02.08.24 УА #80469
	
	//+ ИнфоСофт Власова И.С. 05.08.24 УА #81190
	СтруктураДанных.КомиссионныеПродажи25 = ИС_MP_Сервер.ПолучитьВерсиюКомиссионныхПродаж(Профиль, СтруктураДанных.Маркетплейс);
	
	Если СтруктураДанных.КомиссионныеПродажи25 = Неопределено Тогда
		Возврат "НеЗаполненыДанныеКомиссии";
	КонецЕсли;
	//- ИнфоСофт Власова И.С. 05.08.24 УА #81190
	
	РезультатПроверки = Истина;
	
	Пока Выборка.Следующий() Цикл
		
		НоваяСтрока = ЯндексКонтрагенты.Добавить();
		
		ЗаполнитьЗначенияСвойств(НоваяСтрока, Выборка);
		
		Если Не ЗначениеЗаполнено(Выборка.Контрагент) Тогда
			
			Если АвтоматическиСоздатьКонтрагентовЯМ Тогда
				
				//+ ИнфоСофт Власова И.С. 01.04.25 УА #97214
				СтруктураОтбора = Новый Структура;
				СтруктураОтбора.Вставить("ИНН", Выборка.ИНН);
				
				СтрокиПоКонтрагенту = ЯндексКонтрагенты.НайтиСтроки(СтруктураОтбора);
				
				Для Каждого СтрокаКонтрагента Из СтрокиПоКонтрагенту Цикл
					
					Если ЗначениеЗаполнено(СтрокаКонтрагента.Контрагент) Тогда
						
						НоваяСтрока.Партнер    = СтрокаКонтрагента.Партнер;
						НоваяСтрока.Контрагент = СтрокаКонтрагента.Контрагент;
						НоваяСтрока.Договор    = СтрокаКонтрагента.Договор;
						НоваяСтрока.Соглашение = СтрокаКонтрагента.Соглашение;
						
						Прервать;
						
					КонецЕсли;	
					
				КонецЦикла;
				
				Если ЗначениеЗаполнено(НоваяСтрока.Контрагент) Тогда
					Продолжить;
				КонецЕсли;
				//- ИнфоСофт Власова И.С. 01.04.25 УА #97214
				
				//+ ИнфоСофт Власова И.С. 02.08.24 УА #80469
				//ДанныеКонтрагента = ИС_MP_Сервер.СоздатьКонтрагента(Профиль.Организация, Настройки, Выборка);
				
				ЗаполнитьЗначенияСвойств(СтруктураДанных, Выборка);
				ДанныеКонтрагента = ИС_MP_Сервер.СоздатьКонтрагента(Профиль.Организация, Настройки, СтруктураДанных);
				//- ИнфоСофт Власова И.С. 02.08.24 УА #80469
				
				НоваяСтрока.Партнер 			= ДанныеКонтрагента.Партнер;
				НоваяСтрока.Контрагент 			= ДанныеКонтрагента.Контрагент;
				НоваяСтрока.Договор 			= ДанныеКонтрагента.Договор;
				НоваяСтрока.Соглашение 			= ДанныеКонтрагента.Соглашение;
			Иначе	
				РезультатПроверки = Ложь;
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат РезультатПроверки;
	
КонецФункции //- ИнфоСофт Сумин Д.В. 18.08.2023 УА #61252

