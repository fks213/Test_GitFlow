&НаСервере
Функция ВыполнитьПроверкуЗаполненияДанныхПоКлиентам(Маркетплейс, КомиссионныеПродажи25)
	
	РезультатПроверки = Истина;
	
	ИспользоватьСоглашенияСКлиентами = ПолучитьФункциональнуюОпцию("ИспользоватьСоглашенияСКлиентами");
	ИспользоватьДоговорыСКлиентами   = ПолучитьФункциональнуюОпцию("ИспользоватьДоговорыСКлиентами");
	
	Если КомиссионныеПродажи25 Тогда
		ХозОперация = ПредопределенноеЗначение("Перечисление.ХозяйственныеОперации.РеализацияЧерезКомиссионера");
	Иначе
		ХозОперация = ПредопределенноеЗначение("Перечисление.ХозяйственныеОперации.РеализацияКлиенту");	
	КонецЕсли; 
	
	Контрагенты = ЭтотОбъект[Маркетплейс + "Контрагенты"];
	
	Для Каждого Контрагент Из Контрагенты Цикл
		
		Если ИспользоватьСоглашенияСКлиентами И Не КомиссионныеПродажи25 Тогда
			
			Если ЗначениеЗаполнено(Контрагент.Соглашение) Тогда	
				
				Если Не Общегоназначения.ЗначениеРеквизитаОбъекта(Контрагент.Соглашение, "ХозяйственнаяОперация") = ХозОперация Тогда
					
					ТекстСообщения = СтрШаблон(
						"соглашение с контрагентом: %1 имеет хозяйственную операцию, отличающуюся от ""%2"".",
						Контрагент.Контрагент, ХозОперация);
					ОбщегоНазначения.СообщитьПользователю(ТекстСообщения);
					
					РезультатПроверки = Ложь;
					
				КонецЕсли;
				
			Иначе	
				
				ТекстСообщения = СтрШаблон(
					"Не заполнено соглашение с контрагентом: %1.", Контрагент.Контрагент);
				ОбщегоНазначения.СообщитьПользователю(ТекстСообщения);
				
				РезультатПроверки = Ложь;
				
			КонецЕсли;
			
		КонецЕсли;
		
		Если КомиссионныеПродажи25
			Или (ИспользоватьДоговорыСКлиентами И Не ИспользоватьСоглашенияСКлиентами)
			Или (ИспользоватьСоглашенияСКлиентами И ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Контрагент.Соглашение, "ИспользуютсяДоговорыКонтрагентов")) Тогда
			
			Если ЗначениеЗаполнено(Контрагент.Договор) Тогда	
				
				Если Не Общегоназначения.ЗначениеРеквизитаОбъекта(Контрагент.Договор, "ХозяйственнаяОперация") = ХозОперация Тогда
					
					ТекстСообщения = СтрШаблон(
						"договор контрагента: %1 имеет хозяйственную операцию, отличающуюся от ""%2"".",
					Контрагент.Контрагент, ХозОперация);
					ОбщегоНазначения.СообщитьПользователю(ТекстСообщения);
					
					РезультатПроверки = Ложь;
					
				КонецЕсли;
				
			Иначе
				
				ТекстСообщения = СтрШаблон(
					"Не заполнен договор контрагента: %1.", Контрагент.Контрагент);
				ОбщегоНазначения.СообщитьПользователю(ТекстСообщения);
				
				РезультатПроверки = Ложь;
				
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат РезультатПроверки;
	
КонецФункции //- ИнфоСофт Власова И.С. 06.08.24 УА #67453

