&НаКлиенте
Процедура ОбработатьВыкупленныеТоварыПриИзменении(Элемент)
	
	Если НЕ ЗначениеЗаполнено(ПериодOzon) Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю("Не выбран период.", , , "Период");
		ОбработатьВыкупленныеТовары = Ложь;
		Возврат;
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(Профиль) Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю("Не выбран профиль.", , , "Профиль");
		ОбработатьВыкупленныеТовары = Ложь;
		Возврат;
	КонецЕсли;
	
	Если ОбработатьВыкупленныеТовары Тогда 
		
		Попытка
			
			РеализацияЧерезКомиссионераОзон = Ложь; 
			ОтчетКомиссионераОзон = Ложь;
			Элементы.СписокТранзакцийExcelOzon.Видимость = Ложь;
			
			Если OzonСписокТранзакцийВыкупленныхТоваров.Количество() = 0 Тогда
				
				ПолучитьСписокТранзакцийВыкупленныхТоваровОзон();
				
				Если OzonСписокТранзакцийВыкупленныхТоваров.Количество() = 0 Тогда
					
					ОбщегоНазначенияКлиент.СообщитьПользователю("В данном периоде не найдены выкупленные товары для выбранного профиля. Выполните загрузку файла о выкупленных товарах.");
					ОбработатьВыкупленныеТовары = Ложь;
					Возврат;
					
				КонецЕсли;
				
			КонецЕсли;
			
			ОшибкаСопоставления = ПолучитьРезультатПроверкиСопоставленияВыкупленныхТоваровОзон();
			
			Если ОшибкаСопоставления Тогда
				ОбработатьВыкупленныеТовары = Ложь;
				Элементы.OzonСписокТранзакцийВыкупленныхТоваров.Видимость = Истина;
				OzonСписокТранзакцийВыкупленныхТоваров.Сортировать("Номенклатура", "");
				Возврат;
			КонецЕсли;
			
			Элементы.OzonСписокТранзакцийВыкупленныхТоваров.Видимость = Истина;
			OzonСписокТранзакцийВыкупленныхТоваров.Сортировать("Номенклатура", "");
			Элементы.ГруппаЭтапТриОзон.Видимость = Истина;
			
		Исключение	
		КонецПопытки;
		
	КонецЕсли;

КонецПроцедуры //- ИнфоСофт Заварин К.В. 26.11.24 УА #74680

