&НаСервере
Процедура ЗаписатьДанныеПродажЮрЛиц(ПродажиЮрЛицамТЗ)
	
	НачатьТранзакцию();	
	
	Попытка
		
		БлокировкаДанных = Новый БлокировкаДанных;
		ЭлементБлокировкиДанных = БлокировкаДанных.Добавить("РегистрСведений.ИС_Ozon_Продажи");
		ЭлементБлокировкиДанных.УстановитьЗначение("Профиль", Профиль);
		ЭлементБлокировкиДанных.Режим = РежимБлокировкиДанных.Исключительный;
		БлокировкаДанных.Заблокировать();
		
		Для Каждого Элемент Из ПродажиЮрЛицамТЗ Цикл
			
			МенеджерЗаписи = РегистрыСведений.ИС_Ozon_Продажи.СоздатьМенеджерЗаписи(); 			
			
			//+ ИнфоСофт Заварин К.В. 28.01.25 УА #91934
			Элемент.ИНН = СокрЛП(Элемент.ИНН);
			//- ИнфоСофт Заварин К.В. 28.01.25 УА #91934
			
			ЗаполнитьЗначенияСвойств(МенеджерЗаписи, Элемент);
			
			МенеджерЗаписи.Профиль = Профиль;
			
			МенеджерЗаписи.Прочитать();  
			
			Если МенеджерЗаписи.Выбран() Тогда  
				
				ЗаполнитьЗначенияСвойств(МенеджерЗаписи, Элемент);
				
				МенеджерЗаписи.Записать(); 
				
			КонецЕсли;
			
		КонецЦикла;	
		
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		ЗаписьЖурналаРегистрации(НСтр("ru = 'Заметки'", ОбщегоНазначения.КодОсновногоЯзыка()), УровеньЖурналаРегистрации.Ошибка,,, ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		ВызватьИсключение;
	КонецПопытки;	
	
КонецПроцедуры //- ИнфоСофт Мурсалимов Д.Р. 25.10.24 УА #85566

//+ ИнфоСофт Сумин Д.В. 19.10.2023 УА #63924
&НаКлиенте
Процедура РеализацияЧерезКомиссионераОзонПриИзменении(Элемент)
	
	Если НЕ ЗначениеЗаполнено(ПериодOzon) Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю("Не выбран период.", , , "Период");
		РеализацияЧерезКомиссионераОзон = Ложь;
		Возврат;
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(Профиль) Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю("Не выбран профиль.", , , "Профиль");
		РеализацияЧерезКомиссионераОзон = Ложь;
		Возврат;
	КонецЕсли;
	
	Если РеализацияЧерезКомиссионераОзон Тогда 
		
		Попытка
			
			ОтчетКомиссионераОзон = Ложь; 
			
			OzonКонтрагенты.Очистить(); 
			
			Если СписокТранзакцийExcelOzon.Количество() = 0 Тогда
				
				ПолучитьСписокТранзакцийПродажОзон();
				
				Если СписокТранзакцийExcelOzon.Количество() = 0 Тогда
					ОбщегоНазначенияКлиент.СообщитьПользователю("В данном периоде не найдены продажи для выбранного профиля. Выполните загрузку файла о продажах.");
					РеализацияЧерезКомиссионераОзон = Ложь;
					Возврат;	
				КонецЕсли;
				
			КонецЕсли;
			
			ОшибкаСопоставления = ПолучитьРезультатПроверкиСопоставленияОзон();
			
			Если ОшибкаСопоставления Тогда	
				РеализацияЧерезКомиссионераОзон = Ложь;
				Элементы.СписокТранзакцийExcelOzon.Видимость = Истина;
				СписокТранзакцийExcelOzon.Сортировать("Номенклатура", "");
				Возврат;	
			КонецЕсли;
			
			РезультатПроверки = ПолучитьРезультатПроверкиПродажЮрЛицамОзон();
			
			//+ ИнфоСофт Сумин Д.В. 15.05.2024 УА #75889
			Если АвтоматическиСоздатьКонтрагентовОзон Тогда
				
				//+ ИнфоСофт Власова И.С. 05.08.24 УА #81190
				//ВыполнитьАлгоритмСозданияКонтрагентов();
				Если Не ВыполнитьАлгоритмСозданияКонтрагентов() Тогда
					РеализацияЧерезКомиссионераОзон = Ложь;
					Возврат;
				КонецЕсли;
				//- ИнфоСофт Власова И.С. 05.08.24 УА #81190
				
			КонецЕсли;	
			//- ИнфоСофт Сумин Д.В. 15.05.2024 УА #75889
			
			КонтрагентыСопоставлены = ПолучитьРезультатСопоставленияКонтрагентовОзон();
			
			Если РезультатПроверки.РеализацияЧерезКомиссионера Тогда  				
				ЗаполнитьКонтрагентыОтображениеНаСервере("Ozon");	
				Элементы.OzonКонтрагентыОтображение.Видимость = Истина;
			Иначе 
				РеализацияЧерезКомиссионераОзон = Ложь;
				ОтчетКомиссионераОзон = Истина;
			КонецЕсли; 
			
			Если ЗначениеЗаполнено(РезультатПроверки.СообщениеПользователю) Тогда
				ОбщегоНазначенияКлиент.СообщитьПользователю(РезультатПроверки.СообщениеПользователю);
			КонецЕсли; 
			
			Если КонтрагентыСопоставлены Тогда
				Элементы.ГруппаЭтапТриОзон.Видимость = Истина;
			Иначе
				Элементы.СоздатьКонтрагентаОзон.Видимость = Истина;
				//Элементы.ГруппаЭтапДваОзон.Видимость = Истина;
				Элементы.ГруппаЭтапТриОзон.Видимость = Ложь;
				РеализацияЧерезКомиссионераОзон = Ложь;
				ОбщегоНазначенияКлиент.СообщитьПользователю("По ИНН не найдены партнеры. Необходимо выполнить создание.");
			КонецЕсли;
			
		Исключение
			ТекстОшибки = ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
			ОбщегоНазначенияКлиент.СообщитьПользователю(ТекстОшибки);
		КонецПопытки;
		
	КонецЕсли;

КонецПроцедуры //+ ИнфоСофт Сумин Д.В. 19.10.2023 УА #63924

//+ ИнфоСофт Сумин Д.В. 19.10.2023 УА #63924
&НаСервере
Функция ПолучитьРезультатПроверкиПродажЮрЛицамОзон() 
	
	РезультатПроверки = Новый Структура;
	РезультатПроверки.Вставить("РеализацияЧерезКомиссионера", Истина);
	РезультатПроверки.Вставить("СообщениеПользователю", "");
	
	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	ИС_Ozon_Продажи.НомерОтправления КАК НомерЗаказа,
	|	ИС_Ozon_Продажи.НаименованиеЮрЛица КАК НаименованиеКлиента,
	|	ИС_Ozon_Продажи.ЮрАдресПокупателя КАК АдресКлиента,
	|	ИС_Ozon_Продажи.ИНН КАК ИНН
	|ИЗ
	|	РегистрСведений.ИС_Ozon_Продажи КАК ИС_Ozon_Продажи
	|ГДЕ
	|	ИС_Ozon_Продажи.Профиль = &Профиль
	|	И ИС_Ozon_Продажи.ИНН <> """"
	//+ ИнфоСофт Власова И.С. 02.08.24 УА #80469
	//|	И ИС_Ozon_Продажи.ДатаНачала МЕЖДУ &ДатаНачала И &ДатаОкончания");
	|	И ИС_Ozon_Продажи.ДатаНачала МЕЖДУ &ДатаНачала И &ДатаОкончания
	|
	|СГРУППИРОВАТЬ ПО
	|	ИС_Ozon_Продажи.НомерОтправления,
	|	ИС_Ozon_Продажи.НаименованиеЮрЛица,
	|	ИС_Ozon_Продажи.ИНН,
	|	ИС_Ozon_Продажи.ЮрАдресПокупателя");
	//- ИнфоСофт Власова И.С. 02.08.24 УА #80469
	
	Запрос.УстановитьПараметр("Профиль", 		Профиль);
	Запрос.УстановитьПараметр("ДатаНачала", 	НачалоДня(ПериодOzon.ДатаНачала)); 
	Запрос.УстановитьПараметр("ДатаОкончания", 	КонецДня(ПериодOzon.ДатаОкончания));
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Если РезультатЗапроса.Пустой() Тогда
		РезультатПроверки.Вставить("РеализацияЧерезКомиссионера", Ложь);
		РезультатПроверки.Вставить("СообщениеПользователю", "В данном периоде не найдены продажи юр. лицам. Реализация через комиссионера не требуется. Перейдите к пункту 3.");	
		Возврат РезультатПроверки;	
	КонецЕсли;	
	
	Выборка = РезультатЗапроса.Выбрать();
	
	Пока Выборка.Следующий() Цикл		
		НоваяСтрокаКонтрагент 						= OzonКонтрагенты.Добавить();
		НоваяСтрокаКонтрагент.ИНН 					= Выборка.ИНН; 
		НоваяСтрокаКонтрагент.НомерЗаказа 			= Выборка.НомерЗаказа;
		НоваяСтрокаКонтрагент.НаименованиеКлиента 	= Выборка.НаименованиеКлиента;
		НоваяСтрокаКонтрагент.АдресКлиента 			= Выборка.АдресКлиента;
	КонецЦикла; 
	
	Возврат РезультатПроверки; 
	
КонецФункции //- ИнфоСофт Сумин Д.В. 19.10.2023 УА #63924

