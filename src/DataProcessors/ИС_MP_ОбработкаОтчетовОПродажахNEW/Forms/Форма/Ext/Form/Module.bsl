	ПериодРеализации.Вставить("НомерРеализации", НомерВходящегоДокумента);
	//- ИнфоСофт Заварин К.В. 03.04.24 УА #66208
	
	Если ПериодРеализации = Неопределено Тогда
		ОбщегоНазначения.СообщитьПользователю("Выбран неверный файл. Необходим файл ""Позаказный отчет о реализации.""");	
		Возврат;
	КонецЕсли;  
	
	СписокТранзакцийExcelOzon.Очистить();
    
	КоличествоСтрок = ТабличныйДокумент.ВысотаТаблицы;
	
	Для сч = 16 По КоличествоСтрок Цикл
		
		Попытка
			
			ТабДок 													= ТабличныйДокумент;
			
			РассчитаннаяСтрока 										= "R" + Формат(сч, "ЧГ=0;") + "C";
			
