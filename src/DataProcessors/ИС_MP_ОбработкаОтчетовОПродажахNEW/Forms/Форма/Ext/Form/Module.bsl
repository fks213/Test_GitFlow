//Процедура ВыполнитьАлгоритмСозданияКонтрагентов()
&НаСервере
Функция ВыполнитьАлгоритмСозданияКонтрагентов()
//- ИнфоСофт Власова И.С. 05.08.24 УА #81190
	
	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	ИС_Ozon_Продажи.ИНН КАК ИНН,
	|	МАКСИМУМ(ИС_Ozon_Продажи.НаименованиеЮрЛица) КАК НаименованиеКлиента
	|ПОМЕСТИТЬ ВТ_ИНН
	|ИЗ
	|	РегистрСведений.ИС_Ozon_Продажи КАК ИС_Ozon_Продажи
	|ГДЕ
	|	ИС_Ozon_Продажи.Профиль = &Профиль
	|	И ИС_Ozon_Продажи.ИНН <> """"
	|	И ИС_Ozon_Продажи.ДатаНачала МЕЖДУ &ДатаНачала И &ДатаОкончания
	|
	|СГРУППИРОВАТЬ ПО
	|	ИС_Ozon_Продажи.ИНН
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Контрагенты.Ссылка КАК Контрагент,
	|	ВТ_ИНН.ИНН КАК ИНН,
	|	ВТ_ИНН.НаименованиеКлиента КАК НаименованиеКлиента
	|ИЗ
	|	ВТ_ИНН КАК ВТ_ИНН
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Контрагенты КАК Контрагенты
	|		ПО ВТ_ИНН.ИНН = Контрагенты.ИНН
	|ГДЕ
	|	Контрагенты.Ссылка ЕСТЬ NULL");
	
	Запрос.УстановитьПараметр("Профиль", 		Профиль);
	Запрос.УстановитьПараметр("ДатаНачала", 	НачалоДня(ПериодOzon.ДатаНачала)); 
	Запрос.УстановитьПараметр("ДатаОкончания", 	КонецДня(ПериодOzon.ДатаОкончания));
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Выборка = РезультатЗапроса.Выбрать();
	
	Если Не РезультатЗапроса.Пустой() Тогда
		
		МассивНаименованийПараметров = Новый Массив;	
		
		МассивНаименованийПараметров.Добавить("ДоговорOzon");
		МассивНаименованийПараметров.Добавить("ПартнерOzon");
		МассивНаименованийПараметров.Добавить("КонтрагентOzon");
		
		Настройки = ИС_MP_Сервер.ПолучитьНастройки(Профиль, МассивНаименованийПараметров);
		
		//+ ИнфоСофт Власова И.С. 02.08.24 УА #80469
		СтруктураДанных = ИС_MP_Сервер.ПолучитьСтруктуруДляСозданияКонтрагента();
		СтруктураДанных.Маркетплейс = Перечисления.ИС_МП_Маркетплейсы.Озон;
		//- ИнфоСофт Власова И.С. 02.08.24 УА #80469
		
		//+ ИнфоСофт Власова И.С. 05.08.24 УА #81190
		СтруктураДанных.КомиссионныеПродажи25 = ИС_MP_Сервер.ПолучитьВерсиюКомиссионныхПродаж(Профиль, СтруктураДанных.Маркетплейс);
		
		Если СтруктураДанных.КомиссионныеПродажи25 = Неопределено Тогда
			Возврат Ложь;
		КонецЕсли;	
		//- ИнфоСофт Власова И.С. 05.08.24 УА #81190
		
		Пока Выборка.Следующий() Цикл
			
			//+ ИнфоСофт Власова И.С. 02.08.24 УА #80469
			//СтруктураДанных = Новый Структура; 
			//
			//СтруктураДанных.Вставить("НаименованиеКлиента", Выборка.НаименованиеКлиента);
			//СтруктураДанных.Вставить("Инн", Выборка.Инн);
			
			ЗаполнитьЗначенияСвойств(СтруктураДанных, Выборка);	
			//- ИнфоСофт Власова И.С. 02.08.24 УА #80469
			
			ДанныеКонтрагента = ИС_MP_Сервер.СоздатьКонтрагента(Профиль.Организация, Настройки, СтруктураДанных);
			
		КонецЦикла;
	КонецЕсли;
	
	//+ ИнфоСофт Власова И.С. 05.08.24 УА #81190
	Возврат Истина;	
	//- ИнфоСофт Власова И.С. 05.08.24 УА #81190

//+ ИнфоСофт Власова И.С. 05.08.24 УА #81190	
//КонецПроцедуры //- ИнфоСофт Сумин Д.В. 15.05.2024 УА #75889
КонецФункции
//- ИнфоСофт Власова И.С. 05.08.24 УА #81190

