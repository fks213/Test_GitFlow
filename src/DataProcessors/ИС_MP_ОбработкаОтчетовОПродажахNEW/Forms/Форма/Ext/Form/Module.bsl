	КонецПопытки; 
	
	ТаблицаТранзакций = СписокТранзакцийExcelЯМ.Выгрузить(); 
	ТаблицаТранзакций = ИС_ЯМ_Сервер.ДобавитьСопоставлениеNew(ТаблицаТранзакций, Профиль);
	СписокТранзакцийExcelЯМ.Загрузить(ТаблицаТранзакций); 
	
	РезултьтатПроверки = ПолучитьРезультатПроверкиСопоставленияЯМ();
	
	//+ ИнфоСофт Заварин К.В. 24.09.24 УА #83149
	Элементы.ГруппаНастройкиСозданиеДокументов.Видимость = Истина; 
	Элементы.ПоказатьПунктДва.Видимость = Ложь;
	//- ИнфоСофт Заварин К.В. 24.09.24 УА #83149
	
КонецПроцедуры //- ИнфоСофт Сумин Д.В. 16.08.2023 УА #61252

