&НаСервере
Процедура ПрогрузитьТаблицуЗначенийПродажИзФайлаСбер()
	
	СписокТранзакцийСбер.Очистить();
	
	Если РасширениеФайлаZip Тогда  
		
		ФайлВременногоХранилища = ПолучитьИзВременногоХранилища(АдресОтчетаВоВременномХранилище); 
		Имя = ПолучитьИмяВременногоФайла("zip");
		ФайлВременногоХранилища.Записать(Имя);
		
		ВызватьОшибку = Истина;
		ТаблицаСтрок = ПрочитатьТабЗначИзZIP(Имя, ВызватьОшибку);
		
		Если ВызватьОшибку Тогда
			ОбщегоНазначения.СообщитьПользователю("Был выбран некорректный файл для загрузки отчета комиссионера СберМегаМаркет, проверьте выбранный файл",,, "ПутьКФайлу");
		КонецЕсли;
		
	Иначе
		
		ФайлВременногоХранилища = ПолучитьИзВременногоХранилища(АдресОтчетаВоВременномХранилище);
		Имя = ПолучитьИмяВременногоФайла("csv");
		ФайлВременногоХранилища.Записать(Имя);                                                         
		
		ТаблицаСтрок = ПрочитатьCSVвТЗ(Имя);		
		
	КонецЕсли; 
	
	Если ТаблицаСтрок.Количество() = 0 Тогда
		ОбщегоНазначения.СообщитьПользователю("Был выбран некорректный файл для загрузки отчета комиссионера СберМегаМаркет, проверьте выбранный файл",,, "ПутьКФайлу");	
	КонецЕсли;
	
	Отчет = Неопределено;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ИС_Сбер_ОтчетыОПродажах.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.ИС_Сбер_ОтчетыОПродажах КАК ИС_Сбер_ОтчетыОПродажах
		|ГДЕ
		|	ИС_Сбер_ОтчетыОПродажах.Профиль = &Профиль
		|	И ИС_Сбер_ОтчетыОПродажах.ДатаНачала = &ДатаНачала
		|	И ИС_Сбер_ОтчетыОПродажах.ДатаОкончания = &ДатаОкончания";
	
	Запрос.УстановитьПараметр("ДатаНачала", НачалоМесяца(ДатаОтчета));
	Запрос.УстановитьПараметр("ДатаОкончания", ДатаОтчета);
	Запрос.УстановитьПараметр("Профиль", Профиль);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		Отчет = ВыборкаДетальныеЗаписи.Ссылка;
	КонецЦикла;
	
	Если ЗначениеЗаполнено(Отчет) Тогда
		ОтчетСбера = Отчет;
	Иначе     
		Отчет = Справочники.ИС_Сбер_ОтчетыОПродажах.СоздатьЭлемент();
		Отчет.Наименование = "Отчет о продажах от " + Строка(ДатаОтчета) + " по профилю " + Профиль.Наименование;
		Отчет.ДатаНачала = НачалоМесяца(ДатаОтчета); 
		Отчет.ДатаОкончания = ДатаОтчета;
		Отчет.Профиль = Профиль;
		Отчет.Записать();
		
		ОтчетСбера = Отчет.Ссылка;
	КонецЕсли;
	
	//+ ИнфоСофт Стояк Ю.К. 05.12.2024 УА #88168	
	//УдаляемыхСтрок = 3;
	//Номер = 0;
	//Пока Номер < УдаляемыхСтрок Цикл 
	//	ТаблицаСтрок.Удалить(0); 
	//	Номер = Номер + 1;
	//КонецЦикла;
	//- ИнфоСофт Стояк Ю.К. 05.12.2024 УА #88168
	
	ОтборНулевыхСтрок = Новый Структура("Колонка4", "");
	
	НулевыеСтроки = ТаблицаСтрок.НайтиСтроки(ОтборНулевыхСтрок);
	
	Для Каждого НулеваяСтрока Из НулевыеСтроки Цикл
		ТаблицаСтрок.Удалить(НулеваяСтрока);	
	КонецЦикла;
	
	Для Каждого Строка Из ТаблицаСтрок Цикл
		
		НСтр = СписокТранзакцийСбер.Добавить();
		НСтр.Артикул = Строка.Колонка3;
		НСтр.СтрокаНомер = ?(Строка.Колонка0 = "", 0, Число(Строка.Колонка0));
		Если Строка.Колонка6 = "Возврат" Тогда
			НСтр.Количество = ?(Строка.Колонка4 = "", 0, -1 * Число(Строка.Колонка4));
		Иначе
			НСтр.Количество = ?(Строка.Колонка4 = "", 0, Число(Строка.Колонка4));	
		КонецЕсли;
		НСтр.СтоимостьТовара = ?(Строка.Колонка9 = "", 0, Число(Строка.Колонка9));
		НСтр.Бонусы = ?(Строка.Колонка10 = "", 0, Число(Строка.Колонка10));
		НСтр.СберСпасибо = ?(Строка.Колонка11 = "", 0, Число(Строка.Колонка11));
		НСтр.ЦенаПродажи = ?(Строка.Колонка12 = "", 0, Число(Строка.Колонка12));
		НСтр.СуммаТоварныхУслуг = ?(Строка.Колонка16 = "", 0, Число(Строка.Колонка16));		
		НСтр.НомерОтправленияМП = Строка.Колонка1;
		НСтр.НомерОтправления = Строка.Колонка2;
		НСтр.СтатусЗаказа = Строка.Колонка6;
		НСтр.ДатаОтправления = ?(Строка.Колонка7 = "", 0, Дата(Строка.Колонка7));		
		
	КонецЦикла; 
	
	СписокТранзакций = ДобавитьСопоставление(СписокТранзакцийСбер.Выгрузить(), Профиль);
	СписокТранзакцийСбер.Загрузить(СписокТранзакций);
		
КонецПроцедуры //- ИнфоСофт Стояк Ю.К. 31.03.2024 УА #62567

//+ ИнфоСофт Стояк Ю.К. 31.03.2024 УА #62567
&НаСервереБезКонтекста
Функция ПрочитатьCSVвТЗ(ИмяФайла, Разделитель=";", ЗаголовкиИзПервойСтроки = Ложь) Экспорт  
	
	Текст = Новый ЧтениеТекста(ИмяФайла);
	
	Результат = Новый ТаблицаЗначений;
	ТекСтрока = Текст.ПрочитатьСтроку();
	
	Если ТекСтрока <> Неопределено Тогда
		МассивЗначений = СтрРазделить(ТекСтрока, Разделитель);
		ИндексКолонки = 0;
		Для Каждого ИмяКолонки Из МассивЗначений Цикл
			ИмяКолонки = ?(ЗаголовкиИзПервойСтроки, "Кол"+ИндексКолонки, ИмяКолонки);
			Результат.Колонки.Добавить("Колонка" + ИндексКолонки, , ИмяКолонки);
			ИндексКолонки = ИндексКолонки + 1;
		КонецЦикла;
		Если ЗаголовкиИзПервойСтроки Тогда
			ТекСтрока = Текст.ПрочитатьСтроку();
		КонецЕсли;
	КонецЕсли;

	Пока ТекСтрока <> Неопределено Цикл 
		НоваяСтрока = Результат.Добавить();
		
		МассивЗначений = СтрРазделить(ТекСтрока, Разделитель);
		КоличествоКолонок = Мин(Результат.Колонки.Количество(), МассивЗначений.Количество());
		Для ИндексКолонки = 0 По КоличествоКолонок - 1 Цикл
			НоваяСтрока[ИндексКолонки] = МассивЗначений[ИндексКолонки];
		КонецЦикла;

		ТекСтрока = Текст.ПрочитатьСтроку();
	КонецЦикла; 
	
	//+ ИнфоСофт Стояк Ю.К. 05.12.2024 УА #88168	
	УдаляемыхСтрок = 3;
	Номер = 0;
	Пока Номер < УдаляемыхСтрок Цикл 
		Результат.Удалить(0); 
		Номер = Номер + 1;
	КонецЦикла;
	//- ИнфоСофт Стояк Ю.К. 05.12.2024 УА #88168	
	Возврат Результат;
КонецФункции //- ИнфоСофт Стояк Ю.К. 31.03.2024 УА #62657

