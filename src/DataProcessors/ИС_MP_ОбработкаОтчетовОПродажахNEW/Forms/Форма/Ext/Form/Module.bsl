&НаСервере
Процедура ПрочитатьДанныеПродажЮрЛицОзон()	 
	
	ФайлВременногоХранилища = ПолучитьИзВременногоХранилища(АдресПродажЮрЛицВоВременномХранилищеОзон);
	Имя = ПолучитьИмяВременногоФайла("xlsx");
	ФайлВременногоХранилища.Записать(Имя);
	
	ТабличныйДокумент = Новый ТабличныйДокумент;
	ТабличныйДокумент.Прочитать(Имя);
	
	Если СокрЛП(ТабличныйДокумент.ПолучитьОбласть("R2C2").ТекущаяОбласть.Текст) <> "Реестр продаж юридическим лицам" Тогда
		ОбщегоНазначения.СообщитьПользователю("Выбран неверный файл. Необходимо выбрать файл: ""Реестр продаж юридическим лицам"".");
		Возврат;
	КонецЕсли;	
	
	ПродажиЮрЛицамТЗ = ПолучитьДанныеПродажЮрЛицОзон(ТабличныйДокумент); 
	
	ЗаписатьДанныеПродажЮрЛиц(ПродажиЮрЛицамТЗ);
	
	ОбщегоНазначения.СообщитьПользователю("Файл обработан.");
	
КонецПроцедуры //- ИнфоСофт Сумин Д.В. 13.10.2023 УА #63924

//+ ИнфоСофт Мурсалимов Д.Р. 26.06.24 УА #78167
&НаСервере
Функция ПолучитьДанныеПродажЮрЛицОзон(ТабличныйДокумент)  
	
	КвалификаторСтроки = Новый КвалификаторыСтроки(50);
	
	//+ ИнфоСофт Мурсалимов Д.Р. 08.07.24 УА #79202
	КвалификаторДаты = Новый КвалификаторыДаты(ЧастиДаты.Дата);
	//- ИнфоСофт Мурсалимов Д.Р. 08.07.24 УА #79202
	
	ПродажиЮрЛицамТЗ = Новый ТаблицаЗначений;
	ПродажиЮрЛицамТЗ.Колонки.Добавить("ИНН", 				Новый ОписаниеТипов("Строка",,,,КвалификаторСтроки));
	ПродажиЮрЛицамТЗ.Колонки.Добавить("КПП", 				Новый ОписаниеТипов("Строка",,,,КвалификаторСтроки));
	ПродажиЮрЛицамТЗ.Колонки.Добавить("НомерОтправления", 	Новый ОписаниеТипов("Строка",,,,КвалификаторСтроки));
	ПродажиЮрЛицамТЗ.Колонки.Добавить("ЮрАдрес", 			Новый ОписаниеТипов("Строка"));
	ПродажиЮрЛицамТЗ.Колонки.Добавить("НаименованиеЮрЛица", Новый ОписаниеТипов("Строка"));
	ПродажиЮрЛицамТЗ.Колонки.Добавить("НомерСчетФактуры", 	Новый ОписаниеТипов("Строка"));
	//+ ИнфоСофт Мурсалимов Д.Р. 08.07.24 УА #79202
	ПродажиЮрЛицамТЗ.Колонки.Добавить("ДатаСчетФактуры", 	Новый ОписаниеТипов("Дата",,,,КвалификаторДаты));
	//- ИнфоСофт Мурсалимов Д.Р. 08.07.24 УА #79202
	
	КоличествоСтрок = ТабличныйДокумент.ВысотаТаблицы;
	
	Для сч = 11 По КоличествоСтрок Цикл
		
		Попытка
			
			ЧислоСтроки = Формат(сч, "ЧГ=0;");
			ИНН  = Строка(ТабличныйДокумент.ПолучитьОбласть("R" + ЧислоСтроки + "C" + 8).ТекущаяОбласть.Текст);
			Если ИНН = "" Тогда Прервать; КонецЕсли;
			
			НоваяСтрока = ПродажиЮрЛицамТЗ.Добавить(); 
			
			НоваяСтрока.ИНН 				= ИНН;
			НоваяСтрока.КПП 				= Строка(ТабличныйДокумент.ПолучитьОбласть("R" + ЧислоСтроки + "C" + 9).ТекущаяОбласть.Текст); 
			НоваяСтрока.ЮрАдрес 			= Строка(ТабличныйДокумент.ПолучитьОбласть("R" + ЧислоСтроки + "C" + 10).ТекущаяОбласть.Текст);
			НоваяСтрока.НомерОтправления 	= Строка(ТабличныйДокумент.ПолучитьОбласть("R" + ЧислоСтроки + "C" + 12).ТекущаяОбласть.Текст);
			НоваяСтрока.НаименованиеЮрЛица 	= Строка(ТабличныйДокумент.ПолучитьОбласть("R" + ЧислоСтроки + "C" + 6).ТекущаяОбласть.Текст);
			//+ ИнфоСофт Мурсалимов Д.Р. 08.07.24 УА #79202
			НоваяСтрока.НомерСчетФактуры	= Строка(ТабличныйДокумент.ПолучитьОбласть("R" + ЧислоСтроки + "C" + 4).ТекущаяОбласть.Текст);
			ДатаСчетФактуры	                = Строка(ТабличныйДокумент.ПолучитьОбласть("R" + ЧислоСтроки + "C" + 5).ТекущаяОбласть.Текст);

			Если ЗначениеЗаполнено(ДатаСчетФактуры) Тогда
				НоваяСтрока.ДатаСчетФактуры = СтроковыеФункцииКлиентСервер.СтрокаВДату(ДатаСчетФактуры);
			КонецЕсли;
			//- ИнфоСофт Мурсалимов Д.Р. 08.07.24 УА #79202
			
		Исключение
			ОбщегоНазначения.СообщитьПользователю("не удалось загрузить строку " + сч + ".");	
		КонецПопытки; 
		
	КонецЦикла;
	
	//Найдем данные по продажам
	Запрос = Новый Запрос;
	
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ПродажиЮрЛиц.ИНН КАК ИНН,
	|	ПродажиЮрЛиц.КПП КАК КПП,
