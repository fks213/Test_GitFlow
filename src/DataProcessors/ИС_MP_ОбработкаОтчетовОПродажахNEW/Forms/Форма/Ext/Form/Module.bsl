	Выборка = РезультатЗапроса.Выбрать();
	
	OzonКонтрагенты.Очистить();
	
	РезультатПроверки = Истина;
	
	Пока Выборка.Следующий() Цикл 
		
		НоваяСтрока = OzonКонтрагенты.Добавить(); 
