&НаСервере
Процедура ЗаписатьДанныеПродажСбер()  
	
	НачатьТранзакцию();	
	
	Попытка
		БлокировкаДанных = Новый БлокировкаДанных;
		ЭлементБлокировкиДанных = БлокировкаДанных.Добавить("РегистрСведений.ИС_Сбер_Продажи");
		ЭлементБлокировкиДанных.УстановитьЗначение("Профиль", Профиль);
