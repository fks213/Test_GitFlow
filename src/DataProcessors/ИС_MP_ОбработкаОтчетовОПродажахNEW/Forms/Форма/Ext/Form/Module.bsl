	|	ВТ_Номенклатура.КоэффициентУпаковки КАК КоэффициентУпаковки
	|ИЗ
	|	ВТ_ВыкупленныеТовары КАК ВТ_ВыкупленныеТовары
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_Номенклатура КАК ВТ_Номенклатура
	|		ПО ВТ_ВыкупленныеТовары.offer_id = ВТ_Номенклатура.offer_id";
	
	Запрос.УстановитьПараметр("Профиль", 		Профиль);
	Запрос.УстановитьПараметр("ДатаНачала", 	НачалоДня(ПериодOzon.ДатаНачала));
	Запрос.УстановитьПараметр("ДатаОкончания", 	КонецДня(ПериодOzon.ДатаОкончания)); 
	
