&НаСервере
Функция ПолучитьРезультатПроверкиСопоставленияЯМ() 
	
	ОшибкаСопоставления = Ложь;
	
	Для Каждого Строка Из СписокТранзакцийExcelЯМ Цикл
		Если Не ЗначениеЗаполнено(Строка.Номенклатура) Тогда
			ОшибкаСопоставления = Истина;			
		КонецЕсли;
	КонецЦикла;

	Если ОшибкаСопоставления Тогда
		Сообщение = "Есть позиции, по которым не удалось найти сопоставление. Заполните пустые строки."; 
		Элементы.СписокТранзакцийExcelЯМ.Видимость = Истина; 
		ОбщегоНазначения.СообщитьПользователю(Сообщение);

	КонецЕсли; 
	
	Элементы.ПоказатьПунктДва.Видимость = Ложь;
	Элементы.ГруппаНастройкиСозданиеДокументов.Видимость = Истина;
	
	Возврат ОшибкаСопоставления;
		
КонецФункции //- ИнфоСофт Сумин Д.В. 01.09.2023 УА #61252

