			МенеджерЗаписи = РегистрыСведений.ИС_Сбер_Продажи.СоздатьМенеджерЗаписи(); 
			
			МенеджерЗаписи.Профиль 						= Профиль;
			МенеджерЗаписи.НомерОтчета					= ОтчетСбера;
			МенеджерЗаписи.СтрокаНомер					= Элемент.СтрокаНомер;
			МенеджерЗаписи.Артикул						= Элемент.Артикул; 
			
			МенеджерЗаписи.Количество					= Элемент.Количество;
			МенеджерЗаписи.СтоимостьТовара				= Элемент.СтоимостьТовара;
			МенеджерЗаписи.Бонусы						= Элемент.Бонусы;
			МенеджерЗаписи.СберСпасибо					= Элемент.СберСпасибо;
			МенеджерЗаписи.ЦенаПродажи					= Элемент.ЦенаПродажи;
			МенеджерЗаписи.СуммаТоварныхУслуг			= Элемент.СуммаТоварныхУслуг;
			МенеджерЗаписи.УслугиКРаспределению			= Элемент.УслугиКРаспределению;
			
			МенеджерЗаписи.НомерОтправленияМП			= Элемент.НомерОтправленияМП;
			МенеджерЗаписи.НомерОтправления				= Элемент.НомерОтправления;
			МенеджерЗаписи.СтатусЗаказа					= Элемент.СтатусЗаказа;
			МенеджерЗаписи.ДатаОтправления				= Элемент.ДатаОтправления;
			
			МенеджерЗаписи.Записать();

		КонецЦикла;	
				
	ЗафиксироватьТранзакцию();
	
	Исключение
		ОтменитьТранзакцию();
		ЗаписьЖурналаРегистрации(НСтр("ru = 'Заметки'", ОбщегоНазначения.КодОсновногоЯзыка()), УровеньЖурналаРегистрации.Ошибка,,, ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		ВызватьИсключение;
	КонецПопытки;
	
КонецПроцедуры //- ИнфоСофт Стояк Ю.К. 31.03.2024 УА #62567

//+ ИнфоСофт Стояк Ю.К. 31.03.2024 УА #62567
&НаСервере
Процедура ПрогрузитьДопФайлСбер()

	ФайлВременногоХранилища = ПолучитьИзВременногоХранилища(АдресПродажЮрЛицВоВременномХранилищеОзон);
	Имя = ПолучитьИмяВременногоФайла("xlsx");
	ФайлВременногоХранилища.Записать(Имя);
	
	ТабличныйДокумент = Новый ТабличныйДокумент;
	ТабличныйДокумент.Прочитать(Имя);
	
	//+ ИнфоСофт Стояк Ю.К. 21.11.2024 УА #76394
	Если СтрНачинаетсяС(СокрЛП(ТабличныйДокумент.ПолучитьОбласть("R1C1").ТекущаяОбласть.Текст), "Отчет по легким возвратам") Тогда  
		
		КоличествоСтрок = ТабличныйДокумент.ВысотаТаблицы; 	
		НомерСтроки = СписокТранзакцийСбер.Количество();
			
		Для сч = 4 По КоличествоСтрок Цикл
			
			Попытка
				
				ТабДок 													= ТабличныйДокумент;				
				РассчитаннаяСтрока 										= "R" + Формат(сч, "ЧГ=0;") + "C";				
				СтатусСтроки  											= Строка(ПолучитьТекстОбласти(ТабДок, РассчитаннаяСтрока, 11));
				АртикулММ = Строка(ПолучитьТекстОбласти(ТабДок, РассчитаннаяСтрока, 9)); 
				
				Если СтатусСтроки = "Отказ" Тогда Продолжить; КонецЕсли;
				
				Если АртикулММ = "" Тогда Прервать; КонецЕсли;
												
				НСтр = СписокТранзакцийСбер.Добавить();
				НСтр.Артикул = Строка(ПолучитьТекстОбласти(ТабДок, РассчитаннаяСтрока, 10));
				НСтр.СтрокаНомер = НомерСтроки;
				НомерСтроки = НомерСтроки + 1;  
				НСтр.Количество = -1;				
				НСтр.Бонусы = ?(Строка(ПолучитьТекстОбласти(ТабДок, РассчитаннаяСтрока, 14)) = "", 0, Число(СтрЗаменить(ПолучитьТекстОбласти(ТабДок, РассчитаннаяСтрока, 14), Символы.НПП, "")));
				НСтр.СберСпасибо = 0;
				НСтр.ЦенаПродажи = ?(Строка(ПолучитьТекстОбласти(ТабДок, РассчитаннаяСтрока, 13)) = "", 0, Число(СтрЗаменить(ПолучитьТекстОбласти(ТабДок, РассчитаннаяСтрока, 13), Символы.НПП, "")));
				НСтр.СтоимостьТовара = НСтр.ЦенаПродажи + НСтр.Бонусы;
				НСтр.СуммаТоварныхУслуг = 0;		
				НСтр.НомерОтправленияМП = Строка(ПолучитьТекстОбласти(ТабДок, РассчитаннаяСтрока, 4));
				НСтр.НомерОтправления = Строка(ПолучитьТекстОбласти(ТабДок, РассчитаннаяСтрока, 6));
				НСтр.СтатусЗаказа = Строка(ПолучитьТекстОбласти(ТабДок, РассчитаннаяСтрока, 11));
				
				ДатаОтправления = Дата(СтрЗаменить(Строка(ПолучитьТекстОбласти(ТабДок, РассчитаннаяСтрока, 1)), "-", ".") + " 00:00:00");
				НСтр.ДатаОтправления = ДатаОтправления;
				
			Исключение
				Сообщение		= Новый СообщениеПользователю;
				Сообщение.Текст	= "Не удалось загрузить строку " + Строка(сч);
				Сообщение.Сообщить();
			КонецПопытки; 
			
		КонецЦикла;
		
		ОбщегоНазначения.СообщитьПользователю("Файл обработан.");	
		
		Попытка
