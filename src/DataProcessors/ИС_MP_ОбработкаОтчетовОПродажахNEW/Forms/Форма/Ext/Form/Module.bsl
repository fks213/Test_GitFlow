&НаСервере
Функция ПрочитатьТабЗначИзZIP(ИмяФайла, Отказ)
		
	ТаблицаСтрок = Новый ТаблицаЗначений;
	
	ЧтениеZip = Новый ЧтениеZipФайла(ИмяФайла, "");
	
	Отказ = Истина;
	
	Для Каждого Элемент Из ЧтениеZip.Элементы Цикл
		
		Если НРег(Элемент.Расширение) = "csv" И СтрНайти(Элемент.ИмяБезРасширения, "Приложение1") <> 0 Тогда
			Отказ = Ложь; 
			//+ ИнфоСофт Стояк Ю.К. 10.06.2024 УА #77384			
			Попытка
				ДатаОтчета = Дата(Сред(Элемент.ИмяБезРасширения, СтрДлина(Элемент.ИмяБезРасширения) - 9, 10) + " 00:00:00");
			Исключение
				ОбщегоНазначения.СообщитьПользователю("Не удалось получить дату отчета из названия файла. Укажите дату на форме!");
				Элементы.ДатаОтчета.Видимость = Истина;
			КонецПопытки;
			//ДатаОтчета = Дата(Сред(Элемент.ИмяБезРасширения, СтрДлина(Элемент.ИмяБезРасширения) - 9, 10) + " 00:00:00");
			//- ИнфоСофт Стояк Ю.К. 10.06.2024 УА #77384
			ПутьКФайлуВоВременномХранилище = КаталогВременныхФайлов();
			ЧтениеZip.Извлечь(Элемент, ПутьКФайлуВоВременномХранилище, , "");					
			ПутьКФайлуВоВременномХранилище = ПутьКФайлуВоВременномХранилище + Элемент.Имя;
			//+ ИнфоСофт Стояк Ю.К. 05.12.2024 УА #88168			
			Если ТаблицаСтрок.Количество() = 0 Тогда
				ТаблицаСтрок = ПрочитатьCSVвТЗ(ПутьКФайлуВоВременномХранилище);
			Иначе
				ТаблицаБуфер = ПрочитатьCSVвТЗ(ПутьКФайлуВоВременномХранилище);
				
				Для Каждого Строка Из ТаблицаБуфер Цикл			                               
					НСтр = ТаблицаСтрок.Добавить();
					ЗаполнитьЗначенияСвойств(НСтр, Строка);
				КонецЦикла;
				
			КонецЕсли;
			//- ИнфоСофт Стояк Ю.К. 05.12.2024 УА #88168
			//+ ИнфоСофт Стояк Ю.К. 18.11.2024 УА #76802
			//+ ИнфоСофт Стояк Ю.К. 05.12.2024 УА #88168			
			//Прервать;
		//ИначеЕсли НРег(Элемент.Расширение) = "csv" И СтрНайти(Элемент.ИмяБезРасширения, "Приложение5") <> 0 Тогда
		ИначеЕсли НРег(Элемент.Расширение) = "csv" И СтрНайти(Элемент.ИмяБезРасширения, "Приложение5") <> 0  И ТаблицаСтрок.Количество() = 0 Тогда
			//- ИнфоСофт Стояк Ю.К. 05.12.2024 УА #88168
			Отказ = Ложь; 			
			Попытка
				ДатаОтчета = Дата(Сред(Элемент.ИмяБезРасширения, СтрДлина(Элемент.ИмяБезРасширения) - 9, 10) + " 00:00:00");
			Исключение
				ОбщегоНазначения.СообщитьПользователю("Не удалось получить дату отчета из названия файла. Укажите дату на форме!");
				Элементы.ДатаОтчета.Видимость = Истина;
			КонецПопытки;
			ПутьКФайлуВоВременномХранилище = КаталогВременныхФайлов();
			ЧтениеZip.Извлечь(Элемент, ПутьКФайлуВоВременномХранилище, , "");					
			ПутьКФайлуВоВременномХранилище = ПутьКФайлуВоВременномХранилище + Элемент.Имя; 
			ТаблицаСтрок = ПрочитатьCSVвТЗ(ПутьКФайлуВоВременномХранилище);
		//- ИнфоСофт Стояк Ю.К. 18.11.2024 УА #76802
		КонецЕсли;
		
	КонецЦикла; 
	
	ЧтениеZip.Закрыть();
	
	Возврат ТаблицаСтрок;
	
КонецФункции //- ИнфоСофт Стояк Ю.К. 31.03.2024 УА #62657

