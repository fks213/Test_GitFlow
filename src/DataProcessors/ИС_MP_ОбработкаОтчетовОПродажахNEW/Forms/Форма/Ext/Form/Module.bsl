&НаСервере
Процедура ВыполнитьГруппировкуТаблицыЗаписей()   
	
	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	ВТ_Продажи.Профиль КАК Профиль,
	|	ВТ_Продажи.Sku КАК Sku,
	|	ВТ_Продажи.НомерЗаказа КАК НомерЗаказа,
	|	ВТ_Продажи.ПродажаЮрЛицу КАК ПродажаЮрЛицу,
	|	ВТ_Продажи.ИннПокупателя КАК ИннПокупателя,
	|	ВТ_Продажи.ДатаОформленияЗаказа КАК ДатаОформленияЗаказа,
	|	ВТ_Продажи.ДатаПередачиТовараВДоставку КАК ДатаПередачиТовараВДоставку,
	|	ВТ_Продажи.ДатаДоставкиТовара КАК ДатаДоставкиТовара,
	|	ВТ_Продажи.СпособОплаты КАК СпособОплаты,
	|	ВТ_Продажи.НаименованиеКлиента КАК НаименованиеКлиента,
	|	ВТ_Продажи.АдресКлиента КАК АдресКлиента,
	|	ВТ_Продажи.ЦенаПродавца КАК ЦенаПродавца,
	|	ВТ_Продажи.ЦенаРеализация КАК ЦенаРеализация,
	|	ВТ_Продажи.Количество КАК Количество,
	|	ВТ_Продажи.ВозвратКоличество КАК ВозвратКоличество,
	|	ВТ_Продажи.ВозвратЦенаРеализации КАК ВозвратЦенаРеализации,
	|	ВТ_Продажи.ВозвращеноНаСумму КАК ВозвращеноНаСумму,
	|	ВТ_Продажи.РеализованоНаСумму КАК РеализованоНаСумму
	|ПОМЕСТИТЬ ВТ_ДанныеПродаж
	|ИЗ
	|	&ВТ_Продажи КАК ВТ_Продажи
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_ДанныеПродаж.Профиль КАК Профиль,
	|	ВТ_ДанныеПродаж.Sku КАК Sku,
	|	ВТ_ДанныеПродаж.НомерЗаказа КАК НомерЗаказа,
	|	МАКСИМУМ(ВТ_ДанныеПродаж.ПродажаЮрЛицу) КАК ПродажаЮрЛицу,
	|	МАКСИМУМ(ВТ_ДанныеПродаж.ИннПокупателя) КАК ИннПокупателя,
	|	МАКСИМУМ(ВТ_ДанныеПродаж.ДатаОформленияЗаказа) КАК ДатаОформленияЗаказа,
	|	МАКСИМУМ(ВТ_ДанныеПродаж.ДатаПередачиТовараВДоставку) КАК ДатаПередачиТовараВДоставку,
	|	МАКСИМУМ(ВТ_ДанныеПродаж.ДатаДоставкиТовара) КАК ДатаДоставкиТовара,
	|	МАКСИМУМ(ВТ_ДанныеПродаж.НаименованиеКлиента) КАК НаименованиеКлиента,
	|	МАКСИМУМ(ВТ_ДанныеПродаж.АдресКлиента) КАК АдресКлиента,
	|	МАКСИМУМ(ВТ_ДанныеПродаж.СпособОплаты) КАК СпособОплаты,
	|	МАКСИМУМ(ВТ_ДанныеПродаж.ЦенаПродавца) КАК ЦенаПродавца,
	|	МАКСИМУМ(ВТ_ДанныеПродаж.ЦенаРеализация) КАК ЦенаРеализация,
	|	МАКСИМУМ(ВТ_ДанныеПродаж.Количество) КАК Количество,
	|	МАКСИМУМ(ВТ_ДанныеПродаж.ВозвратКоличество) КАК ВозвратКоличество,
	|	МАКСИМУМ(ВТ_ДанныеПродаж.ВозвратЦенаРеализации) КАК ВозвратЦенаРеализации,
	|	МАКСИМУМ(ВТ_ДанныеПродаж.ВозвращеноНаСумму) КАК ВозвращеноНаСумму,
	|	МАКСИМУМ(ВТ_ДанныеПродаж.РеализованоНаСумму) КАК РеализованоНаСумму
	|ИЗ
	|	ВТ_ДанныеПродаж КАК ВТ_ДанныеПродаж
	|
	|СГРУППИРОВАТЬ ПО
	|	ВТ_ДанныеПродаж.Профиль,
	|	ВТ_ДанныеПродаж.НомерЗаказа,
	|	ВТ_ДанныеПродаж.Sku");
	
	Запрос.УстановитьПараметр("ВТ_Продажи", СписокТранзакцийExcelЯМ.Выгрузить());
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Выборка = РезультатЗапроса.Выбрать();
	
	СписокТранзакцийExcelЯМ.Очистить();
	
	Пока Выборка.Следующий() Цикл
		СтрокаТЗ 								= СписокТранзакцийExcelЯМ.Добавить();
		СтрокаТЗ.Профиль 						= Выборка.Профиль;
		СтрокаТЗ.Sku 							= Выборка.Sku;
		СтрокаТЗ.НомерЗаказа 					= Выборка.НомерЗаказа;
		СтрокаТЗ.ПродажаЮрЛицу 					= Выборка.ПродажаЮрЛицу;
		СтрокаТЗ.ИннПокупателя 				 	= Выборка.ИннПокупателя;
		СтрокаТЗ.НаименованиеКлиента 				 	= Выборка.НаименованиеКлиента;
		СтрокаТЗ.АдресКлиента 				 	= Выборка.АдресКлиента;
		СтрокаТЗ.ДатаОформленияЗаказа 		 	= Выборка.ДатаОформленияЗаказа;
		СтрокаТЗ.ДатаПередачиТовараВДоставку 	= Выборка.ДатаПередачиТовараВДоставку;
		СтрокаТЗ.ДатаДоставкиТовара 			= Выборка.ДатаДоставкиТовара;
		СтрокаТЗ.СпособОплаты 					= Выборка.СпособОплаты;
		СтрокаТЗ.ЦенаПродавца 					= Выборка.ЦенаПродавца;
		СтрокаТЗ.ЦенаРеализация 				= Выборка.ЦенаРеализация;
		СтрокаТЗ.Количество 					= Выборка.Количество; 	
		СтрокаТЗ.ВозвратКоличество	 			= Выборка.ВозвратКоличество;
		СтрокаТЗ.ВозвратЦенаРеализации 			= Выборка.ВозвратЦенаРеализации;
		СтрокаТЗ.ВозвращеноНаСумму 				= Выборка.ВозвращеноНаСумму;		
		СтрокаТЗ.РеализованоНаСумму 			= Выборка.РеализованоНаСумму;
	КонецЦикла;	
		
КонецПроцедуры //- ИнфоСофт Сумин Д.В. 16.08.2023 УА #61252	

//+ ИнфоСофт Сумин Д.В. 16.08.2023 УА #61252
&НаСервере
Процедура СохранитьСопоставлениеНаСервере() 
	Попытка
		Сообщение = "Данные сохранены, перейдите к пункту ""2"".";
		НачатьТранзакцию();		
			
		НоменклатураЯмТЗ = ПолучитьНоменклатуруЯМ();
		
		БлокировкаДанных = Новый БлокировкаДанных;
		ЭлементБлокировкиДанных = БлокировкаДанных.Добавить("РегистрСведений.ИС_ЯМ_СоответствиеХарактеристик");
		ЭлементБлокировкиДанных.Режим = РежимБлокировкиДанных.Исключительный;
		БлокировкаДанных.Заблокировать();
		
		Для Каждого Строка Из СписокТранзакцийExcelЯМ Цикл 
			
			Если Не ЗначениеЗаполнено(Строка.Номенклатура) Тогда
				Сообщение = "Необходимо выполнить сопоставление.";
				ВызватьИсключение(Сообщение);
			КонецЕсли;
			
			СтрокаТЗ = НоменклатураЯмТЗ.Найти(Строка.SKU); 
			
			Если СтрокаТЗ = Неопределено Тогда
				Сообщение = "Не по всем SKU найдены данные. Необходимо выполнить загрузку товаров Яндекс Маркета.";
				ВызватьИсключение(Сообщение);	
			КонецЕсли;
			
			МенеджерЗаписи = РегистрыСведений.ИС_ЯМ_СоответствиеХарактеристик.СоздатьМенеджерЗаписи(); 
			
			МенеджерЗаписи.НоменклатураЯМ 	= СтрокаТЗ.Номенклатура;
			МенеджерЗаписи.Номенклатура		= Строка.Номенклатура;
			МенеджерЗаписи.Характеристика 	= Строка.ХарактеристикаНоменклатуры;
			
			МенеджерЗаписи.Записать();
			
		КонецЦикла;	

		ЗафиксироватьТранзакцию();
		ОбщегоНазначения.СообщитьПользователю(Сообщение);
	Исключение
		ОтменитьТранзакцию();  
		Сообщение = "Не по всем SKU найдены данные. Необходимо выполнить загрузку товаров Яндекс Маркета.";
		ОбщегоНазначения.СообщитьПользователю(Сообщение);
		ВызватьИсключение;
	КонецПопытки;
		
КонецПроцедуры //- ИнфоСофт Сумин Д.В. 16.08.2023 УА #61252

//+ ИнфоСофт Сумин Д.В. 16.08.2023 УА #61252
&Насервере
Функция ПолучитьНоменклатуруЯМ()
	
	НоменклатураЯмТЗ = Новый ТаблицаЗначений;
	НоменклатураЯмТЗ.Колонки.Добавить("Номенклатура", Новый ОписаниеТипов("СправочникСсылка.ИС_ЯМ_Номенклатура"));
	НоменклатураЯмТЗ.Колонки.Добавить("Sku", Новый ОписаниеТипов("Строка"));
	
	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	ИС_ЯМ_Номенклатура.Ссылка КАК НоменклатураЯМ,
	|	ИС_ЯМ_Номенклатура.shopSku КАК Sku
	|ИЗ
	|	Справочник.ИС_ЯМ_Номенклатура КАК ИС_ЯМ_Номенклатура
	|ГДЕ
	|	ИС_ЯМ_Номенклатура.Профиль = &Профиль
	|	И ИС_ЯМ_Номенклатура.shopSku В(&МассивSku)");
	
	SkuТЗ = СписокТранзакцийExcelЯМ.Выгрузить(,"SKU");
	SkuТЗ.Свернуть("SKU");
	
	Запрос.УстановитьПараметр("Профиль", Профиль); 
	Запрос.УстановитьПараметр("МассивSku", SkuТЗ.ВыгрузитьКолонку("SKU")); 
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Если РезультатЗапроса.Пустой() Тогда
		ВызватьИсключение("Не по всем SKU найдены данные. Необходимо выполнить загрузку товаров Яндекс Маркета.");	
	КонецЕсли;	
	
	Выборка = РезультатЗапроса.Выбрать();
	
	Пока Выборка.Следующий() Цикл
		СтрокаТЗ = НоменклатураЯмТЗ.Добавить();
		СтрокаТЗ.Номенклатура = Выборка.НоменклатураЯМ;
		СтрокаТЗ.SKU = Выборка.Sku;
	КонецЦикла;
	
	Возврат НоменклатураЯмТЗ;
	
КонецФункции //- ИнфоСофт Сумин Д.В. 16.08.2023 УА #61252

//+ ИнфоСофт Сумин Д.В. 21.08.2023 УА #61252
&НаСервере
Процедура СформироватьРеализацииЧерезКомиссионера(КомиссионныеПродажи25, Настройки) 
	
	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	СписокТранзакцийЯМ.Номенклатура КАК Номенклатура,
	|	СписокТранзакцийЯМ.ХарактеристикаНоменклатуры КАК ХарактеристикаНоменклатуры,
	|	СписокТранзакцийЯМ.ЦенаРеализация КАК ЦенаРеализация,
	|	СписокТранзакцийЯМ.Количество КАК Количество,
	|	СписокТранзакцийЯМ.РеализованоНаСумму КАК РеализованоНаСумму,
	|	СписокТранзакцийЯМ.ЭтоНабор КАК ЭтоНабор,
	|	СписокТранзакцийЯМ.НомерЗаказа КАК НомерЗаказа,
	|	СписокТранзакцийЯМ.ПродажаЮрЛицу КАК ПродажаЮрЛицу,
	|	СписокТранзакцийЯМ.ДатаОформленияЗаказа КАК ДатаОформленияЗаказа
	//+ ИнфоСофт Власова И.С. 01.04.25 УА #97214
	|,
	|	СписокТранзакцийЯМ.НомерУПД КАК НомерУПД
	//- ИнфоСофт Власова И.С. 01.04.25 УА #97214
	|ПОМЕСТИТЬ ВТ_СписокТранзакций
	|ИЗ
	|	&СписокТранзакцийЯМ КАК СписокТранзакцийЯМ
	|ГДЕ
	|	СписокТранзакцийЯМ.ПродажаЮрЛицу
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Контрагенты.Контрагент КАК Контрагент,
	|	Контрагенты.Договор КАК Договор,
	|	Контрагенты.Соглашение КАК Соглашение,
	|	Контрагенты.Партнер КАК Партнер,
	|	Контрагенты.НомерЗаказа КАК НомерЗаказа
	|ПОМЕСТИТЬ ВТ_Контрагенты
	|ИЗ
	|	&Контрагенты КАК Контрагенты
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_СписокТранзакций.Количество КАК Количество,
	|	ВТ_СписокТранзакций.Номенклатура КАК Номенклатура,
	|	ВТ_СписокТранзакций.РеализованоНаСумму КАК РеализованоНаСумму,
	|	ВТ_СписокТранзакций.ХарактеристикаНоменклатуры КАК ХарактеристикаНоменклатуры,
	|	ВТ_СписокТранзакций.ЦенаРеализация КАК ЦенаРеализация,
	|	ВТ_СписокТранзакций.ЭтоНабор КАК ЭтоНабор,
	|	ВТ_Контрагенты.Договор КАК Договор,
	|	ВТ_Контрагенты.Контрагент КАК Контрагент,
	|	ВТ_Контрагенты.Партнер КАК Партнер,
	|	ВТ_Контрагенты.Соглашение КАК Соглашение
	//+ ИнфоСофт Власова И.С. 01.04.25 УА #97214
	|,
	|	ВЫРАЗИТЬ(ВТ_СписокТранзакций.НомерУПД КАК СТРОКА(100)) КАК НомерУПД
	//- ИнфоСофт Власова И.С. 01.04.25 УА #97214
	|ИЗ
	|	ВТ_СписокТранзакций КАК ВТ_СписокТранзакций
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_Контрагенты КАК ВТ_Контрагенты
	|		ПО ВТ_СписокТранзакций.НомерЗаказа = ВТ_Контрагенты.НомерЗаказа
	|
	|УПОРЯДОЧИТЬ ПО
	|	Партнер
	|ИТОГИ ПО
	//+ ИнфоСофт Власова И.С. 01.04.25 УА #97214
	//|	Партнер");
	|	Партнер,
	|	НомерУПД");
	//- ИнфоСофт Власова И.С. 01.04.25 УА #97214
	
	Запрос.УстановитьПараметр("СписокТранзакцийЯМ", СписокТранзакцийExcelЯМ.Выгрузить());
	Запрос.УстановитьПараметр("Контрагенты", 		ЯндексКонтрагенты.Выгрузить());
	
	КвалификаторЧисла = Новый КвалификаторыЧисла(10,2);
	
	ТаблицаПродажРеализацииЧерезКомиссионера = Новый ТаблицаЗначений;
		
	ТаблицаПродажРеализацииЧерезКомиссионера.Колонки.Добавить("Партнер", 					Новый ОписаниеТипов("СправочникСсылка.Партнеры"));
	ТаблицаПродажРеализацииЧерезКомиссионера.Колонки.Добавить("Контрагент", 				Новый ОписаниеТипов("СправочникСсылка.Контрагенты")); 
	ТаблицаПродажРеализацииЧерезКомиссионера.Колонки.Добавить("Договор", 					Новый ОписаниеТипов("СправочникСсылка.ДоговорыКонтрагентов"));
	ТаблицаПродажРеализацииЧерезКомиссионера.Колонки.Добавить("Соглашение", 				Новый ОписаниеТипов("СправочникСсылка.СоглашенияСКлиентами"));
	ТаблицаПродажРеализацииЧерезКомиссионера.Колонки.Добавить("Номенклатура", 				Новый ОписаниеТипов("СправочникСсылка.Номенклатура"));
	ТаблицаПродажРеализацииЧерезКомиссионера.Колонки.Добавить("ХарактеристикаНоменклатуры", Новый ОписаниеТипов("СправочникСсылка.ХарактеристикиНоменклатуры"));
	ТаблицаПродажРеализацииЧерезКомиссионера.Колонки.Добавить("Количество", 				Новый ОписаниеТипов("Число",,,КвалификаторЧисла));
	ТаблицаПродажРеализацииЧерезКомиссионера.Колонки.Добавить("РеализованоНаСумму", 		Новый ОписаниеТипов("Число",,,КвалификаторЧисла));
	ТаблицаПродажРеализацииЧерезКомиссионера.Колонки.Добавить("ЦенаРеализация", 			Новый ОписаниеТипов("Число",,,КвалификаторЧисла));
	ТаблицаПродажРеализацииЧерезКомиссионера.Колонки.Добавить("ЭтоНабор", 					Новый ОписаниеТипов("Булево"));
	
	СтруктураДанных = Новый Структура;
	СтруктураДанных.Вставить("Период", Период);
	СтруктураДанных.Вставить("Профиль", Профиль);
	
	РезультатЗапроса = Запрос.Выполнить();
	Выборка = РезультатЗапроса.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	МассивВзаимозачет = Новый Массив();
	
	Пока Выборка.Следующий() Цикл
		
		//+ ИнфоСофт Власова И.С. 01.04.25 УА #97214
		//ВыборкаДетальныеЗаписи = Выборка.Выбрать();
		
		ВыборкаУПД = Выборка.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
		
		Пока ВыборкаУПД.Следующий() Цикл
		
		ВыборкаДетальныеЗаписи = ВыборкаУПД.Выбрать(); 
		//- ИнфоСофт Власова И.С. 01.04.25 УА #97214
		
		ТаблицаПродажРеализацииЧерезКомиссионера.Очистить();
		
		Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
			
			НоваяСтрока = ТаблицаПродажРеализацииЧерезКомиссионера.Добавить(); 
			
			ЗаполнитьЗначенияСвойств(НоваяСтрока, ВыборкаДетальныеЗаписи);
			
		КонецЦикла;	
		
		СтруктураДанных.Вставить("ТаблицаПродаж", ТаблицаПродажРеализацииЧерезКомиссионера);
		СтруктураДанных.Вставить("РеализацияЧерезКомиссионера", КомиссионныеПродажи25);
		СтруктураДанных.Вставить("ЗаказКлиента", Неопределено);	
		
		//+ ИнфоСофт Власова И.С. 01.04.25 УА #97214
		СтруктураДанных.Вставить("НомерУПД", ВыборкаУПД.НомерУПД);
		//- ИнфоСофт Власова И.С. 01.04.25 УА #97214
		
		Если Не КомиссионныеПродажи25 Тогда 
			
			ДокументВозврат = ИС_ЯМ_Сервер.СоздатьДокументВозвратТоваров(СтруктураДанных);
			ДобавитьНовыйДокумент(ДокументВозврат);  		
			ПорядокРасчетов = ПолучитьПорядокРасчетов(СтруктураДанных.ТаблицаПродаж[0]); 
			
			СтруктураВзаимозачет = Новый Структура();
			
			Если ПорядокРасчетов <> Перечисления.ПорядокРасчетов.ПоДоговорамКонтрагентов Тогда
				ДокументЗаказ = ИС_ЯМ_Сервер.СоздатьЗаказКлиента(СтруктураДанных);
				ДобавитьНовыйДокумент(ДокументЗаказ);
				СтруктураДанных.Вставить("ЗаказКлиента", ДокументЗаказ.Ссылка);	
				СтруктураВзаимозачет.Вставить("ОбъектРасчетов", ДокументЗаказ.Ссылка);
			Иначе
				СтруктураВзаимозачет.Вставить("ОбъектРасчетов", ДокументВозврат.Договор);	
			КонецЕсли;
			
		КонецЕсли;
		
		ДокументРеализация = ИС_ЯМ_Сервер.СоздатьРеализациюТоваровЧерезКомиссионера(СтруктураДанных);
		
		//+ ИнфоСофт Власова И.С. 05.08.24 УА #81190
		Если ДокументРеализация <> Неопределено Тогда
		//- ИнфоСофт Власова И.С. 05.08.24 УА #81190
			
		Если Не КомиссионныеПродажи25 Тогда
			СтруктураВзаимозачет.Вставить("ДокументРеализация", ДокументРеализация.Ссылка);
			МассивВзаимозачет.Добавить(СтруктураВзаимозачет);
		КонецЕсли;
		
		ДобавитьНовыйДокумент(ДокументРеализация.Ссылка);
		
		//+ ИнфоСофт Власова И.С. 05.08.24 УА #81190
		КонецЕсли;	
		//- ИнфоСофт Власова И.С. 05.08.24 УА #81190
		
		//+ ИнфоСофт Власова И.С. 01.04.25 УА #97214
		КонецЦикла;
		//- ИнфоСофт Власова И.С. 01.04.25 УА #97214
		
	КонецЦикла;
	
	ПараметрыОтбора = Новый Структура("ПродажаЮрЛицу", Ложь);
	
	СписокПродажОК = СписокТранзакцийExcelЯМ.Выгрузить(ПараметрыОтбора);
	
	//+ ИнфоСофт Власова И.С. 05.08.24 УА #81190
	//Комментарий = "Отчет комисисонера за период с " + Период.ДатаНачала + " по " + Период.ДатаОкончания;
	//
	//Отчет = ИС_ЯМ_Сервер.СоздатьДокументОтчетКомиссионера(Профиль, Период, СписокПродажОК, Комментарий); 
	//
	//ДобавитьНовыйДокумент(Отчет); 
	//
	//Для Каждого Элемент Из МассивВзаимозачет Цикл
	//	Взаимозачет = ИС_ЯМ_Сервер.СоздатьДокументВзаимозачетЗадолженности(Элемент.ОбъектРасчетов, Элемент.ДокументРеализация, Отчет);	
	//	ДобавитьНовыйДокумент(Взаимозачет); 
	//КонецЦикла;
	
	Если СписокПродажОК.Количество() > 0 Тогда
		
		Комментарий = "Отчет комиссионера за период с " + Период.ДатаНачала + " по " + Период.ДатаОкончания;
	
		//+ ИнфоСофт Заварин К.В. 19.09.24 УА #83149
		СтруктураПараметров = Новый Структура;
		СтруктураПараметров.Вставить("ЗаполнитьКолонкуПокупательЯМ", ЗаполнитьКолонкуПокупательЯМ); 
		//+ ИнфоСофт Власова И.С. 10.12.24 УА #87450
		СтруктураПараметров.Вставить("РозничныйПокупательЯМ",        РозничныйПокупательЯМ);
		//- ИнфоСофт Власова И.С. 10.12.24 УА #87450
		
		//+ ИнфоСофт Заварин К.В. 10.03.25 УА #95036
		СтруктураПараметров.Вставить("Профиль",        			 	 Профиль);
		//- ИнфоСофт Заварин К.В. 10.03.25 УА #95036
		
		//Отчет = ИС_ЯМ_Сервер.СоздатьДокументОтчетКомиссионера(Профиль, Период, СписокПродажОК, Комментарий); 
		Отчет = ИС_ЯМ_Сервер.СоздатьДокументОтчетКомиссионера(Профиль, Период, СписокПродажОК, Комментарий, СтруктураПараметров);
		//- ИнфоСофт Заварин К.В. 19.09.24 УА #83149
		
		Если Отчет <> Неопределено Тогда
			ДобавитьНовыйДокумент(Отчет);
		КонецЕсли;
		
		Для Каждого Элемент Из МассивВзаимозачет Цикл
			
			//+ ИнфоСофт Мурсалимов Д.Р. 25.10.24 УА #85566
			Взаимозачет = ИС_МП_УправлениеЗаказами.СоздатьДокументВзаимозачетЗадолженности(Элемент.ОбъектРасчетов, Элемент.ДокументРеализация, Отчет);
			//- ИнфоСофт Мурсалимов Д.Р. 25.10.24 УА #85566
			
			ДобавитьНовыйДокумент(Взаимозачет);
			
		КонецЦикла;
		
	КонецЕсли;
	//- ИнфоСофт Власова И.С. 05.08.24 УА #81190
		
КонецПроцедуры //- ИнфоСофт Сумин Д.В. 21.08.2023 УА #61252	

//+ ИнфоСофт Сумин Д.В. 21.08.2023 УА #61252
&НаСервере
Процедура ЗаполнитьКонтрагентыОтображениеНаСервере(Маркетплейс)
	
	Контрагенты 			= ЭтотОбъект[Маркетплейс + "Контрагенты"];
	КонтрагентыОтображение 	= ЭтотОбъект[Маркетплейс + "КонтрагентыОтображение"];
	
	КонтрагентыОтображение.Очистить();
	ТаблицаКонтрагенты = Контрагенты.Выгрузить(,"ИНН,Партнер,Контрагент,Договор,Соглашение");
	ТаблицаКонтрагенты.Свернуть("ИНН,Партнер,Контрагент,Договор,Соглашение");
	КонтрагентыОтображение.Загрузить(ТаблицаКонтрагенты);
	
КонецПроцедуры //- ИнфоСофт Сумин Д.В. 21.08.2023 УА #61252

//+ ИнфоСофт Сумин Д.В. 22.08.2023 УА #61252
&НаСервере
Процедура ДобавитьНовыйДокумент(НовыйДокумент)
	СозданныеДокументы.Добавить().Документ = НовыйДокумент.Ссылка; 	
КонецПроцедуры //- ИнфоСофт Сумин Д.В. 22.08.2023 УА #61252

//+ ИнфоСофт Сумин Д.В. 22.08.2023 УА #61252
&НаСервере
Функция ПолучитьПорядокРасчетов(СтрокаТЗ)
	Если Не ЗначениеЗаполнено(СтрокаТЗ.Соглашение) Или Не ЗначениеЗаполнено(СтрокаТЗ.Соглашение.ПорядокРасчетов) Тогда
		Возврат СтрокаТЗ.Договор.ПорядокРасчетов;
	Иначе
		Возврат СтрокаТЗ.Соглашение.ПорядокРасчетов;	
	КонецЕсли;	
КонецФункции //- ИнфоСофт Сумин Д.В. 22.08.2023 УА #61252

