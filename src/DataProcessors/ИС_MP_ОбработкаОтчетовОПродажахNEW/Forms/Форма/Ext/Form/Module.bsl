//Процедура СформироватьОтчетаКомиссионераНаСервере()
Процедура СформироватьОтчетКомиссионераНаСервере()
//- ИнфоСофт Власова И.С. 06.08.24 УА #81190  
	
	Комментарий = "Отчет комисисонера за период с " + Период.ДатаНачала + " по " + Период.ДатаОкончания;
	
	//+ ИнфоСофт Стояк Ю.К. 30.05.2024 УА #74897	
	Если ВариантФормированияЦеныВозврата = 1 И Не ЗначениеЗаполнено(ВидЦеныВозврата) Тогда
		
		ОбщегоНазначения.СообщитьПользователю("Не выбран вид цены");
		Возврат;
		
	КонецЕсли;
	
	СтруктураПараметров = Новый Структура;
	СтруктураПараметров.Вставить("СпособРасчетаЦеныВозврата", Новый Структура("СпособРасчета, ВидЦены", ВариантФормированияЦеныВозврата, ВидЦеныВозврата));       
	
	//+ ИнфоСофт Заварин К.В. 19.09.24 УА #83149
	СтруктураПараметров.Вставить("ЗаполнитьКолонкуПокупательЯМ", ЗаполнитьКолонкуПокупательЯМ);	 
	//- ИнфоСофт Заварин К.В. 19.09.24 УА #83149
	//+ ИнфоСофт Власова И.С. 10.12.24 УА #87450
	СтруктураПараметров.Вставить("РозничныйПокупательЯМ",        РозничныйПокупательЯМ);
	//- ИнфоСофт Власова И.С. 10.12.24 УА #87450
	//+ ИнфоСофт Стояк Ю.К. 27.02.2025 УА #94609
	СтруктураПараметров.Вставить("Профиль", 					   Профиль);
	//- ИнфоСофт Стояк Ю.К. 27.02.2025 УА #94609
	
	//Отчет = ИС_ЯМ_Сервер.СоздатьДокументОтчетКомиссионера(Профиль, Период, СписокТранзакцийExcelЯМ, Комментарий); 
	Отчет = ИС_ЯМ_Сервер.СоздатьДокументОтчетКомиссионера(Профиль, Период, СписокТранзакцийExcelЯМ, Комментарий, СтруктураПараметров); 
	//- ИнфоСофт Стояк Ю.К. 30.05.2024 УА #74897
	
	Элементы.СозданныеДокументы.Видимость = Истина;
	
	ДобавитьНовыйДокумент(Отчет);
	
КонецПроцедуры //- ИнфоСофт Сумин Д.В. 16.08.2023 УА #61252

