&НаСервере   
Функция ПолучитьРезультатПроверкиСопоставленияСбер() 
			
	ОшибкаСопоставления = Ложь;
	
	Для Каждого Строка Из СписокТранзакцийСбер Цикл
		Если Не ЗначениеЗаполнено(Строка.Номенклатура) Тогда
			ОшибкаСопоставления = Истина;			
		КонецЕсли;
	КонецЦикла;

	Если ОшибкаСопоставления Тогда
		СписокТранзакцийСбер.Сортировать("Номенклатура Возр");
		Сообщение = "Есть позиции, по которым не удалось найти сопоставление. Заполните пустые строки."; 
		Элементы.СписокТранзакцийСбер.Видимость = Истина; 
		ОбщегоНазначения.СообщитьПользователю(Сообщение);

	КонецЕсли; 
	
	Возврат ОшибкаСопоставления;
		
КонецФункции //- ИнфоСофт Стояк Ю.К. 01.04.2024 УА #62567

