	СписокТранзакцийExcelЯМ.Очистить(); 
	
	ФайлВременногоХранилища = ПолучитьИзВременногоХранилища(АдресОтчетаВоВременномХранилище);
	Имя = ПолучитьИмяВременногоФайла("xlsx");
	ФайлВременногоХранилища.Записать(Имя);
	ТабличныйДокумент = Новый ТабличныйДокумент; 
	ТабличныйДокумент.Прочитать(Имя);
	
	МассивСтруктур = Новый Массив;
	МассивСтруктур.Добавить(Новый Структура("Таблица,Тип", "Доставленные_товары", Истина));
	МассивСтруктур.Добавить(Новый Структура("Таблица,Тип", "Невыкупленные_товары", Ложь));
