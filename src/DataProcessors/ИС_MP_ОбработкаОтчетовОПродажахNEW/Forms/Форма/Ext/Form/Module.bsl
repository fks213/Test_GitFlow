&НаСервере
Процедура ОтчетСбераПриИзмененииНаСервере() 
	
	Для Каждого Документ Из ОтчетСбера.Документы Цикл
		ДобавитьНовыйДокумент(Документ.Документ);
	КонецЦикла;
	
	СписокТранзакцийСбер.Очистить();
	
	НаборЗаписей = РегистрыСведений.ИС_Сбер_Продажи.СоздатьНаборЗаписей();
	
	НаборЗаписей.Отбор.Профиль.Установить(Профиль); 
	НаборЗаписей.Отбор.НомерОтчета.Установить(ОтчетСбера);
	
	НаборЗаписей.Прочитать();
	
	Для Каждого Элемент Из НаборЗаписей Цикл
		
		НСтр = СписокТранзакцийСбер.Добавить();
				
		НСтр.СтрокаНомер					= Элемент.СтрокаНомер;
		НСтр.Артикул						= Элемент.Артикул; 
		
		НСтр.Количество						= Элемент.Количество;
		НСтр.СтоимостьТовара				= Элемент.СтоимостьТовара;
		НСтр.Бонусы							= Элемент.Бонусы;
		НСтр.СберСпасибо					= Элемент.СберСпасибо;
		НСтр.ЦенаПродажи					= Элемент.ЦенаПродажи;
		НСтр.СуммаТоварныхУслуг				= Элемент.СуммаТоварныхУслуг;
		НСтр.УслугиКРаспределению			= Элемент.УслугиКРаспределению;
		
		НСтр.НомерОтправленияМП				= Элемент.НомерОтправленияМП;
		НСтр.НомерОтправления				= Элемент.НомерОтправления;
		НСтр.СтатусЗаказа					= Элемент.СтатусЗаказа;
		НСтр.ДатаОтправления				= Элемент.ДатаОтправления;
				
	КонецЦикла;
		
	СписокТранзакций = ДобавитьСопоставление(СписокТранзакцийСбер.Выгрузить(), Профиль);
	СписокТранзакцийСбер.Загрузить(СписокТранзакций);

КонецПроцедуры //- ИнфоСофт Стояк Ю.К. 01.04.2024 УА #62567

