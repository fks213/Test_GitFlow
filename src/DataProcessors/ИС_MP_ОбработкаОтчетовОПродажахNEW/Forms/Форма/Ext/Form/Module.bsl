&НаСервере
Процедура ПолучитьТаблицуЗначенийПродажИзФайлаOzon()
			
	ФайлВременногоХранилища = ПолучитьИзВременногоХранилища(АдресОтчетаВоВременномХранилище);
	Имя = ПолучитьИмяВременногоФайла("xlsx");
	ФайлВременногоХранилища.Записать(Имя);
	
	ТабличныйДокумент = Новый ТабличныйДокумент; 
	ТабличныйДокумент.Прочитать(Имя, СпособЧтенияЗначенийТабличногоДокумента.Значение);
	
	//+ ИнфоСофт Сумин Д.В. 13.10.2023 УА #63924	
	ПериодРеализации = ПолучитьПериодРеализации(ТабличныйДокумент.ПолучитьОбласть("R4"  + "C5").ТекущаяОбласть.Текст);
	
	//+ ИнфоСофт Заварин К.В. 03.04.24 УА #66208
