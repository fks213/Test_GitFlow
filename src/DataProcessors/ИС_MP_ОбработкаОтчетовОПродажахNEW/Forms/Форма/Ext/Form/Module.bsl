//+ ИнфоСофт Сумин Д.В. 28.08.2023 УА #61252
&НаСервереБезКонтекста
Функция ПолучитьПериодРеализации(Строка)
	
	Если СтрНайти(Строка, "Реализация товаров за период с") < 1 Тогда
		Возврат Неопределено;
	КонецЕсли;
	//+ ИнфоСофт Сумин Д.В. 30.01.2024 УА #69135
	ДатаНачала = СтроковыеФункцииКлиентСервер.СтрокаВДату(Сред(Строка, 32, 11));
	ДатаОкончания = СтроковыеФункцииКлиентСервер.СтрокаВДату(Прав(Строка,11));
	//ДатаНачала = ОбщегоНазначенияКлиентСервер.СтрокаВДату(Сред(Строка, 32, 11));
	//ДатаОкончания = ОбщегоНазначенияКлиентСервер.СтрокаВДату(Прав(Строка,11));
	//- ИнфоСофт Сумин Д.В. 30.01.2024 УА #69135

	Если Не ЗначениеЗаполнено(ДатаНачала) Или Не ЗначениеЗаполнено(ДатаОкончания) Тогда
		Возврат Неопределено;	
	КонецЕсли;	
	
	ПериодРеализации = Новый Структура;
	ПериодРеализации.Вставить("ДатаНачала", ДатаНачала);
	ПериодРеализации.Вставить("ДатаОкончания", ДатаОкончания);
	
	Возврат ПериодРеализации;
	
КонецФункции //- ИнфоСофт Сумин Д.В. 28.08.2023 УА #61252

//+ ИнфоСофт Заварин К.В. 03.04.24 УА #66208
&НаСервере
Функция ПолучитьНомерВходящегоДокумента(Строка)
	
	//+ ИнфоСофт Сумин Д.В. 07.05.2024 УА #74879
	Если НовыйФорматФайла Тогда
		НомерДокумента = СтроковыеФункцииКлиентСервер.СтрокаВЧисло(Сред(Строка, 21, 9));	
		
	//+ ИнфоСофт Заварин К.В. 10.01.25 УА #90580	
	//+ ИнфоСофт Заварин К.В. 26.11.24 УА #74680
	//ИначеЕсли ФорматФайлаВыкупленныеТовары Тогда
	//	НомерДокумента = СтроковыеФункцииКлиентСервер.СтрокаВЧисло(Сред(Строка, 31, 15));
	//- ИнфоСофт Заварин К.В. 26.11.24 УА #74680                                         
	
	ИначеЕсли НовыйФорматФайлаВыкупленныеТовары Тогда
		НомерДокумента = СтроковыеФункцииКлиентСервер.СтрокаВЧисло(Сред(Строка, 31, 15)); 
		
	ИначеЕсли ФорматФайлаВыкупленныеТоварыДо30112014 Тогда
		НомерДокумента = СтроковыеФункцииКлиентСервер.СтрокаВЧисло(Сред(Строка, 31, 15));
	//- ИнфоСофт Заварин К.В. 10.01.25 УА #90580
	
	Иначе
		НомерДокумента = СтроковыеФункцииКлиентСервер.СтрокаВЧисло(Сред(Строка, 21, 10));
	КонецЕсли;
	//НомерДокумента = Число(Сред(Строка, 21, 10));
	//- ИнфоСофт Сумин Д.В. 07.05.2024 УА #74879

	Если Не ЗначениеЗаполнено(НомерДокумента) Тогда
		Возврат Неопределено;	
	КонецЕсли;	
	
	НомерРеализации = Новый Структура;
	НомерРеализации.Вставить("НомерРеализации", НомерДокумента);
	
	Возврат НомерДокумента;
	
КонецФункции //- ИнфоСофт Заварин К.В. 03.04.24 УА #66208

