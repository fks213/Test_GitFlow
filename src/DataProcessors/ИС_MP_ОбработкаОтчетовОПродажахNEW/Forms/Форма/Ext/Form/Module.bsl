//+ ИнфоСофт Заварин К.В. 11.11.24 УА #87034
&НаСервере
Функция ПолучитьСписокПродаж(Период)
	
	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	ИС_ЯМ_Продажи.Sku КАК Sku,
	|	ИС_ЯМ_Продажи.НомерЗаказа КАК НомерЗаказа,
	//+ ИнфоСофт Власова И.С. 22.04.25 УА #99750
	|	ИС_ЯМ_Продажи.НаименованиеТовара КАК НаименованиеТовара,
	//- ИнфоСофт Власова И.С. 22.04.25 УА #99750
	|	ИС_ЯМ_Продажи.ПродажаЮрЛицу КАК ПродажаЮрЛицу,
	|	ИС_ЯМ_Продажи.ИннПокупателя КАК ИннПокупателя,
	|	ИС_ЯМ_Продажи.ДатаОформленияЗаказа КАК ДатаОформленияЗаказа,
	|	ИС_ЯМ_Продажи.ДатаПередачиТовараВДоставку КАК ДатаПередачиТовараВДоставку,
	|	ИС_ЯМ_Продажи.ДатаДоставкиТовара КАК ДатаДоставкиТовара,
	|	ИС_ЯМ_Продажи.ДатаПриёмаВозврата КАК ДатаПриёмаВозврата,
	|	ИС_ЯМ_Продажи.СпособОплаты КАК СпособОплаты,
	|	ИС_ЯМ_Продажи.ВозвратКоличество КАК ВозвратКоличество,
	|	ИС_ЯМ_Продажи.ВозвратЦенаРеализации КАК ВозвратЦенаРеализации,
	|	ИС_ЯМ_Продажи.ВозвращеноНаСумму КАК ВозвращеноНаСумму,
	|	ИС_ЯМ_Продажи.Количество КАК Количество,
	|	ИС_ЯМ_Продажи.РеализованоНаСумму КАК РеализованоНаСумму,
	|	ИС_ЯМ_Продажи.ЦенаПродавца КАК ЦенаПродавца,
	|	ИС_ЯМ_Продажи.ЦенаРеализация КАК ЦенаРеализация
	|ПОМЕСТИТЬ ВТ_Продажи
	|ИЗ
	|	РегистрСведений.ИС_ЯМ_Продажи КАК ИС_ЯМ_Продажи
	|ГДЕ
	|	ИС_ЯМ_Продажи.Профиль = &Профиль
	|	И ИС_ЯМ_Продажи.ДатаДоставкиТовара МЕЖДУ &ДатаНачала И &ДатаОкончания
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ИС_ЯМ_Продажи.Sku,
	|	ИС_ЯМ_Продажи.НомерЗаказа,
	//+ ИнфоСофт Власова И.С. 22.04.25 УА #99750
	|	ИС_ЯМ_Продажи.НаименованиеТовара,
	//- ИнфоСофт Власова И.С. 22.04.25 УА #99750
	|	ИС_ЯМ_Продажи.ПродажаЮрЛицу,
	|	ИС_ЯМ_Продажи.ИннПокупателя,
	|	ИС_ЯМ_Продажи.ДатаОформленияЗаказа,
	|	ИС_ЯМ_Продажи.ДатаПередачиТовараВДоставку,
	|	ИС_ЯМ_Продажи.ДатаДоставкиТовара,
	|	ИС_ЯМ_Продажи.ДатаПриёмаВозврата,
	|	ИС_ЯМ_Продажи.СпособОплаты,
	|	ИС_ЯМ_Продажи.ВозвратКоличество,
	|	ИС_ЯМ_Продажи.ВозвратЦенаРеализации,
	|	ИС_ЯМ_Продажи.ВозвращеноНаСумму,
	|	ИС_ЯМ_Продажи.Количество,
	|	ИС_ЯМ_Продажи.РеализованоНаСумму,
	|	ИС_ЯМ_Продажи.ЦенаПродавца,
	|	ИС_ЯМ_Продажи.ЦенаРеализация
	|ИЗ
	|	РегистрСведений.ИС_ЯМ_Продажи КАК ИС_ЯМ_Продажи
	|ГДЕ
	|	ИС_ЯМ_Продажи.Профиль = &Профиль
	|	И ИС_ЯМ_Продажи.ДатаПриёмаВозврата МЕЖДУ &ДатаНачала И &ДатаОкончания
	|	И ИС_ЯМ_Продажи.ДатаДоставкиТовара НЕ МЕЖДУ &ДатаНачала И &ДатаОкончания
	|
	|;
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_Продажи.Sku КАК Sku,
	|	МАКСИМУМ(ИС_ЯМ_СоответствиеХарактеристик.Номенклатура) КАК Номенклатура,
	|	МАКСИМУМ(ИС_ЯМ_СоответствиеХарактеристик.Характеристика) КАК Характеристика,
	|	МАКСИМУМ(ВЫБОР
	|			КОГДА ИС_ЯМ_СоответствиеХарактеристик.Номенклатура.ТипНоменклатуры = ЗНАЧЕНИЕ(Перечисление.ТипыНоменклатуры.Набор)
	|				ТОГДА ИСТИНА
	|			ИНАЧЕ ЛОЖЬ
	|		КОНЕЦ) КАК ЭтоНабор,
	|	МАКСИМУМ(ИС_ЯМ_СоответствиеХарактеристик.Упаковка) КАК Упаковка,
	|	МАКСИМУМ(ВЫБОР
	|		КОГДА ИС_ЯМ_СоответствиеХарактеристик.Упаковка ЕСТЬ NULL ИЛИ ИС_ЯМ_СоответствиеХарактеристик.Упаковка.Числитель = 0
	|			ТОГДА 1
	|		ИНАЧЕ ИС_ЯМ_СоответствиеХарактеристик.Упаковка.Числитель
	|	КОНЕЦ / ВЫБОР
	|		КОГДА ИС_ЯМ_СоответствиеХарактеристик.Упаковка ЕСТЬ NULL ИЛИ ИС_ЯМ_СоответствиеХарактеристик.Упаковка.Знаменатель = 0
	|			ТОГДА 1
	|		ИНАЧЕ ИС_ЯМ_СоответствиеХарактеристик.Упаковка.Знаменатель
	|	КОНЕЦ) КАК КоэффициентУпаковки
	|ПОМЕСТИТЬ ВТ_Номенклатура
	|ИЗ
	|	ВТ_Продажи КАК ВТ_Продажи
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ИС_ЯМ_СоответствиеХарактеристик КАК ИС_ЯМ_СоответствиеХарактеристик
	|		ПО (ВТ_Продажи.Sku = ИС_ЯМ_СоответствиеХарактеристик.НоменклатураЯМ.shopSku
	|				И ИС_ЯМ_СоответствиеХарактеристик.НоменклатураЯМ.Профиль = &Профиль)
	|
	|СГРУППИРОВАТЬ ПО
	|	ВТ_Продажи.Sku 
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_Продажи.Sku КАК Sku,
	|	ВТ_Продажи.НомерЗаказа КАК НомерЗаказа,
	//+ ИнфоСофт Власова И.С. 22.04.25 УА #99750
	|	ВТ_Продажи.НаименованиеТовара КАК НаименованиеТовара,
	//- ИнфоСофт Власова И.С. 22.04.25 УА #99750
	|	ВТ_Продажи.ПродажаЮрЛицу КАК ПродажаЮрЛицу,
	|	ВТ_Продажи.ИннПокупателя КАК ИннПокупателя,
	|	ВТ_Продажи.ДатаОформленияЗаказа КАК ДатаОформленияЗаказа,
	|	ВТ_Продажи.ДатаПередачиТовараВДоставку КАК ДатаПередачиТовараВДоставку,
	|	ВТ_Продажи.ДатаДоставкиТовара КАК ДатаДоставкиТовара,
	|	ВТ_Продажи.ДатаПриёмаВозврата КАК ДатаПриёмаВозврата,
	|	ВТ_Продажи.СпособОплаты КАК СпособОплаты,
	|	ВТ_Продажи.ВозвратКоличество КАК ВозвратКоличество,
	|	ВТ_Продажи.ВозвратЦенаРеализации КАК ВозвратЦенаРеализации,
	|	ВТ_Продажи.ВозвращеноНаСумму КАК ВозвращеноНаСумму,
	|	ВТ_Продажи.Количество КАК Количество,
	|	ВТ_Продажи.РеализованоНаСумму КАК РеализованоНаСумму,
	|	ВТ_Продажи.ЦенаПродавца КАК ЦенаПродавца,
	|	ВТ_Продажи.ЦенаРеализация КАК ЦенаРеализация,
	|	ВТ_Номенклатура.Номенклатура КАК Номенклатура,
	|	ВТ_Номенклатура.Характеристика КАК ХарактеристикаНоменклатуры,
	|	ВТ_Номенклатура.ЭтоНабор КАК ЭтоНабор,
	|	ВТ_Номенклатура.Упаковка КАК Упаковка,
	|	ВТ_Номенклатура.КоэффициентУпаковки КАК КоэффициентУпаковки
	|ИЗ
	|	ВТ_Продажи КАК ВТ_Продажи
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_Номенклатура КАК ВТ_Номенклатура
	|		ПО ВТ_Продажи.Sku = ВТ_Номенклатура.Sku");
	
	Запрос.УстановитьПараметр("Профиль", 		Профиль);
	Запрос.УстановитьПараметр("ДатаНачала", 	Период.ДатаНачала);
	Запрос.УстановитьПараметр("ДатаОкончания", 	Период.ДатаОкончания);	
	
	РезультатЗапроса = Запрос.Выполнить().Выгрузить();
	
	Возврат РезультатЗапроса;
	
КонецФункции //- ИнфоСофт Заварин К.В. 11.11.24 УА #87034

//+ ИнфоСофт Мурсалимов Д.Р. 26.09.24 УА #65981 
&НаСервере
Процедура ЗаполнитьТаблицуЗаписи(Таблица, Продажа = Истина)
	
	КоличествоСтрок = Таблица.ВысотаТаблицы - 1;
	
	Для сч = 15 По КоличествоСтрок Цикл 
		
		Попытка
			
			ТабДок 									= Таблица;
			
			РассчитаннаяСтрока 						= "R" + Формат(сч, "ЧГ=0;") + "C";
			
			НоваяСтрока								= СписокТранзакцийExcelЯМ.Добавить();
			
			НоваяСтрока.НаименованиеТовара			= Строка(ПолучитьТекстОбласти(ТабДок, РассчитаннаяСтрока, 3));			
			НоваяСтрока.SKU							= Строка(ПолучитьТекстОбласти(ТабДок, РассчитаннаяСтрока, 4));			
			НоваяСтрока.Профиль 					= Профиль;
			НоваяСтрока.НомерЗаказа					= Строка(ПолучитьТекстОбласти(ТабДок, РассчитаннаяСтрока, 1));
			НоваяСтрока.ИННПокупателя		    	= Строка(ПолучитьТекстОбласти(ТабДок, РассчитаннаяСтрока, 22));
			НоваяСтрока.ПродажаЮрЛицу		    	= ?(ЗначениеЗаполнено(НоваяСтрока.ИННПокупателя), Истина, Ложь);
			НоваяСтрока.ДатаОформленияЗаказа		= ?(Строка(ПолучитьТекстОбласти(ТабДок, РассчитаннаяСтрока, 8)) = "", '00010101', СтроковыеФункцииКлиентСервер.СтрокаВДату(ПолучитьТекстОбласти(ТабДок, РассчитаннаяСтрока, 8)));
			НоваяСтрока.ДатаПередачиТовараВДоставку	= ?(Строка(ПолучитьТекстОбласти(ТабДок, РассчитаннаяСтрока, 9)) = "", '00010101', СтроковыеФункцииКлиентСервер.СтрокаВДату(ПолучитьТекстОбласти(ТабДок, РассчитаннаяСтрока, 9)));
			НоваяСтрока.ДатаДоставкиТовара			= ?(Строка(ПолучитьТекстОбласти(ТабДок, РассчитаннаяСтрока, 10)) = "", '00010101', СтроковыеФункцииКлиентСервер.СтрокаВДату(ПолучитьТекстОбласти(ТабДок, РассчитаннаяСтрока, 10)));
			
			Если Продажа Тогда			                                                                                                   
				
				НоваяСтрока.ЦенаПродавца			= ?(Строка(ПолучитьТекстОбласти(ТабДок, РассчитаннаяСтрока, 13)) = "", 0, Число(СтрЗаменить(ПолучитьТекстОбласти(ТабДок, РассчитаннаяСтрока, 13), Символы.НПП, "")));
				НоваяСтрока.ЦенаРеализация			= ?(Строка(ПолучитьТекстОбласти(ТабДок, РассчитаннаяСтрока, 17)) = "", 0, Число(СтрЗаменить(ПолучитьТекстОбласти(ТабДок, РассчитаннаяСтрока, 17), Символы.НПП, "")));
				НоваяСтрока.Количество				= ?(Строка(ПолучитьТекстОбласти(ТабДок, РассчитаннаяСтрока, 6)) = "", 0, Число(СтрЗаменить(ПолучитьТекстОбласти(ТабДок, РассчитаннаяСтрока, 6), Символы.НПП, "")));
				НоваяСтрока.РеализованоНаСумму		= ?(Строка(ПолучитьТекстОбласти(ТабДок, РассчитаннаяСтрока, 20)) = "", 0, Число(СтрЗаменить(ПолучитьТекстОбласти(ТабДок, РассчитаннаяСтрока, 20), Символы.НПП, "")));			
				НоваяСтрока.СпособОплаты			= ПолучитьТекстОбласти(ТабДок, РассчитаннаяСтрока, 11);
				НоваяСтрока.НаименованиеКлиента		= ПолучитьТекстОбласти(ТабДок, РассчитаннаяСтрока, 21);
				НоваяСтрока.АдресКлиента			= ПолучитьТекстОбласти(ТабДок, РассчитаннаяСтрока, 24);
				
			Иначе
				
				НоваяСтрока.ЦенаПродавца			= ?(Строка(ПолучитьТекстОбласти(ТабДок, РассчитаннаяСтрока, 14)) = "", 0, Число(СтрЗаменить(ПолучитьТекстОбласти(ТабДок, РассчитаннаяСтрока, 14), Символы.НПП, "")));
				НоваяСтрока.ВозвратЦенаРеализации	= ?(Строка(ПолучитьТекстОбласти(ТабДок, РассчитаннаяСтрока, 18)) = "", 0, Число(СтрЗаменить(ПолучитьТекстОбласти(ТабДок, РассчитаннаяСтрока, 18), Символы.НПП, "")));
				НоваяСтрока.ВозвратКоличество		= ?(Строка(ПолучитьТекстОбласти(ТабДок, РассчитаннаяСтрока, 6)) = "", 0, Число(СтрЗаменить(ПолучитьТекстОбласти(ТабДок, РассчитаннаяСтрока, 6), Символы.НПП, "")));
				НоваяСтрока.ВозвращеноНаСумму		= ?(Строка(ПолучитьТекстОбласти(ТабДок, РассчитаннаяСтрока, 21)) = "", 0, Число(СтрЗаменить(ПолучитьТекстОбласти(ТабДок, РассчитаннаяСтрока, 21), Символы.НПП, "")));
				
			КонецЕсли;
					
		Исключение
			Сообщение		= Новый СообщениеПользователю;
			Сообщение.Текст	= "Не удалось загрузить строку " + Строка(сч);
			Сообщение.Сообщить();
		КонецПопытки;
		
	КонецЦикла;
	
КонецПроцедуры //- ИнфоСофт Мурсалимов Д.Р. 26.09.24 УА #65981 

//+ ИнфоСофт Сумин Д.В. 16.08.2023 УА #61252
&НаКлиенте
Процедура ПоместитьФайлНаСерверЗавершение(Результат, Параметры) Экспорт
	
	Если Результат.ПомещениеФайлаОтменено Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю("Не удалось поместить файл на сервер, попробуйте ещё раз...", , , "ПутьКФайлу");
		Возврат;
	КонецЕсли;
	
	ЭтотОбъект[Параметры.Адрес] = Результат.Адрес;          
	
КонецПроцедуры //- ИнфоСофт Сумин Д.В. 16.08.2023 УА #61252 

