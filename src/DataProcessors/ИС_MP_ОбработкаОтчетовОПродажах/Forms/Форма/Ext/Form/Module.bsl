Функция ПолучитьДанныеЗаголовка() 
	
	Настройки = ИС_Ozon_Сервер.ПолучитьНастройкиФункциональностиСборочныхЗвданий(Профиль);
	
	ЗаголовокСтруктура = Новый Структура; 
	
