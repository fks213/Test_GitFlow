&НаСервере
Процедура ЗагрузитьОтчетКомисисонераПоИзФайлаНаСервере() 
	
	Если Элементы.Маркетплейсы.ТекущаяСтраница.Имя = "Ozon" Тогда
		//+ ИнфоСофт Сумин Д.В. 07.05.2024 УА #74879
		Если ФорматФайлаДо31032024 Тогда
			ПолучитьТаблицуЗначенийПродажИзФайлаOzon();
		ИначеЕсли НовыйФорматФайла Тогда
			ПолучитьТаблицуЗначенийПродажИзФайлаOzonПосле30032024();
		Иначе
			ОбщегоНазначения.СообщитьПользователю(НСтр("ru = 'Необходимо выбрать формат файла.'"));
		КонецЕсли;	
		//ПолучитьТаблицуЗначенийПродажИзФайлаOzon();
		//- ИнфоСофт Сумин Д.В. 07.05.2024 УА #74879 
	ИначеЕсли Элементы.Маркетплейсы.ТекущаяСтраница.Имя = "Яндекс" Тогда
		//+ ИнфоСофт Сумин Д.В. 13.05.2024 УА #74879
		Если НовыйФорматФайлаЯМ Тогда
			ПолучитьТаблицуЗначенийПродажИзФайлаЯндексПосле30032024();
		ИначеЕсли ФорматФайлаДо31032024ЯМ Тогда	
			ПолучитьТаблицуЗначенийПродажИзФайлаЯндекс(); 
		Иначе
			ОбщегоНазначения.СообщитьПользователю(НСтр("ru = 'Необходимо выбрать формат файла.'"));
		КонецЕсли;
		//- ИнфоСофт Сумин Д.В. 13.05.2024 УА #74879			
	КонецЕсли;
	
КонецПроцедуры //- ИнфоСофт Стояк Ю.К. 04.05.2023 УА #58008	      	

