//+ ИнфоСофт Сумин Д.В. 12.02.2024 УА #70399
&НаСервере
Процедура РассчитатьИтоги()
	
	ВсегоКНачислению = СписокТранзакцийExcel.Итог("ИтогиКНачислению") - СписокТранзакцийExcel.Итог("ИтогоВозвращено");
	ВсегоНачисленоБаллов = СписокТранзакцийExcel.Итог("ДоплатаЗаСчетOzon") - СписокТранзакцийExcel.Итог("ВозвратДоплатаЗаСчетOzon");
	ВсегоБазоваяКомиссия = СписокТранзакцийExcel.Итог("ИтогиКомиссияСУчетомСкидокИНаценок") - СписокТранзакцийExcel.Итог("ВозвратИтогиКомиссияСУчетомСкидокИНаценок");
	ВсегоКомиссияПослеСкидок = ВсегоБазоваяКомиссия - ВсегоНачисленоБаллов;
	
	Если ВсегоКомиссияПослеСкидок < ВсегоБазоваяКомиссия / 100 Тогда
		ВсегоКомиссияПослеСкидок = ВсегоБазоваяКомиссия / 100;
	КонецЕсли;
	
КонецПроцедуры //- ИнфоСофт Сумин Д.В. 12.02.2024 УА #70399
