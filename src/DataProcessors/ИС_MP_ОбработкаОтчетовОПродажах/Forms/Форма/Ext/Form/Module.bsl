	ЗаголовокСтруктура.Вставить("Организация", Профиль.Организация);
	ЗаголовокСтруктура.Вставить("ДоговорЗакупки", ДоговорЗакупкиОзон);
	ЗаголовокСтруктура.Вставить("СоглашениеЗакупки", СоглашениеЗакупкиОзон);
	ЗаголовокСтруктура.Вставить("Подразделение", Настройки.ПодразделениеOzon);
	ЗаголовокСтруктура.Вставить("Партнер", Настройки.ПартнерOzon);
	ЗаголовокСтруктура.Вставить("Контрагент", Настройки.КонтрагентOzon);
	
