//+ ИнфоСофт Стояк Ю.К. 19.05.2023 УА #58008
&НаСервере
Процедура ЗагрузитьПродолжитьНаСервере()
	
	Если Элементы.Маркетплейсы.ТекущаяСтраница.Имя = "Ozon" Тогда  
		
		ОшибкаСопоставления = Ложь;
		
		Для Каждого Строка Из СписокТранзакцийExcel Цикл
			Если Не ЗначениеЗаполнено(Строка.Номенклатура) Тогда
				ОшибкаСопоставления = Истина;			
			КонецЕсли;
		КонецЦикла;
		
		Если Не ОшибкаСопоставления Тогда    
			
			//+ ИнфоСофт Сумин Д.В. 12.02.2024 УА #70399
			РассчитатьИтоги();
			
			Отчет = ИС_Ozon_Сервер.СоздатьДокументОтчетКомиссионера(Профиль, Период, СписокТранзакцийExcel, Комментарий, ВсегоКомиссияПослеСкидок);
			//Отчет = ИС_Ozon_Сервер.СоздатьДокументОтчетКомиссионера(Профиль, Период, СписокТранзакцийExcel, Комментарий);
			//- ИнфоСофт Сумин Д.В. 12.02.2024 УА #70399
				
			Если ЗначениеЗаполнено(Отчет) Тогда
				СформированныеДокументы.Добавить().Документ = Отчет;
			КонецЕсли; 
		Иначе
			ОбщегоНазначения.СообщитьПользователю("Есть позиции, по которым не удалось найти сопоставление. Заполните пустые строки и нажмите ""Загрузить"", либо исправьте сопоставление и повторите загрузку");
		КонецЕсли;
		
	ИначеЕсли Элементы.Маркетплейсы.ТекущаяСтраница.Имя = "Яндекс" Тогда 
		
		ОшибкаСопоставления = Ложь;
		
		Для Каждого Строка Из СписокТранзакцийExcelЯМ Цикл
			Если Не ЗначениеЗаполнено(Строка.Номенклатура) Тогда
				ОшибкаСопоставления = Истина;			
			КонецЕсли;
		КонецЦикла;
		
		Если Не ОшибкаСопоставления Тогда    
			
			Отчет = ИС_ЯМ_Сервер.СоздатьДокументОтчетКомиссионера(Профиль, Период, СписокТранзакцийExcelЯМ, Комментарий);
			
			Если ЗначениеЗаполнено(Отчет) Тогда
				СформированныеДокументыЯндекс.Добавить().Документ = Отчет;
			КонецЕсли; 
		Иначе
			ОбщегоНазначения.СообщитьПользователю("Есть позиции, по которым не удалось найти сопоставление. Заполните пустые строки и нажмите ""Загрузить"", либо исправьте сопоставление и повторите загрузку");
		КонецЕсли;
				
	КонецЕсли;
	
	
	
КонецПроцедуры //- ИнфоСофт Стояк Ю.К. 19.05.2023 УА #58008

//+ ИнфоСофт Стояк Ю.К. 19.05.2023 УА #58008
&НаКлиенте
Процедура ЗагрузитьПродолжить(Команда)
