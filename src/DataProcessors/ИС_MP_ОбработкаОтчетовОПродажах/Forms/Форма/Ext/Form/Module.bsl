Процедура СоздатьДокументОприходованияЯМНаСервере() 
	
	ЗаголовокСтруктура = ПолучитьДанныеЗаголовкаЯМ();
	
	ДанныеДокумента = СписокУслугЯМ.Выгрузить();
	
	ДокументПриобретения = ИС_Ozon_Сервер.СоздатьДокументПриобретения(ЗаголовокСтруктура, ДанныеДокумента);
		
	СформированныеДокументыЯндекс.Добавить().Документ = ДокументПриобретения.Ссылка;

КонецПроцедуры //- ИнфоСофт Сумин Д.В. 19.12.2023 УА #65730

//+ ИнфоСофт Сумин Д.В. 18.12.2023 УА #65730
&НаСервере
Функция ПолучитьДанныеЗаголовкаЯМ() 
	
	Настройки = ИС_ЯМ_Сервер.ПолучитьНастройкиФункциональностиСборочныхЗвданий(Профиль);
	
	ЗаголовокСтруктура = Новый Структура; 
	
	ЗаголовокСтруктура.Вставить("ДатаДокумента", ТекущаяДатаСеанса());
	ЗаголовокСтруктура.Вставить("Организация", Профиль.Организация);
	ЗаголовокСтруктура.Вставить("ДоговорЗакупки", ДоговорЗакупкиЯМ);
	ЗаголовокСтруктура.Вставить("СоглашениеЗакупки", СоглашениеЗакупкиЯМ);
	ЗаголовокСтруктура.Вставить("Подразделение", Настройки.ПодразделениеЯМ);
	ЗаголовокСтруктура.Вставить("Партнер", Настройки.ПартнерЯМ);
	ЗаголовокСтруктура.Вставить("Контрагент", Настройки.КонтрагентЯМ);
	
	Возврат ЗаголовокСтруктура;
	
КонецФункции //- ИнфоСофт Сумин Д.В. 18.12.2023 УА #65730

