//+ ИнфоСофт Ивонин К.А. 15.03.24 УА #71892
&НаКлиенте
Процедура ТаблицаВыгрузкиРучнойОстатокПриИзменении(Элемент)
	
	ТекДанные = Элементы[Маркетплейс + "ТаблицаВыгрузки"].ТекущиеДанные;
	
	Если ТекДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ТекДанные.РучнойОстатокИзменен = Истина;
	Модифицированность = Истина;
	Элементы.СохранитьИзменения.Видимость = Истина;
	
	ЗаголовокСтраницы = ИС_МП_Клиент.ПредставлениеМаркетплейса(Маркетплейс);
	Элементы["Страница" + Маркетплейс].Заголовок = ЗаголовокСтраницы + " *";
	
	ПересчитатьБудетВыгружено(ТекДанные);
	
КонецПроцедуры //- ИнфоСофт Ивонин К.А. 15.03.24 УА #71892

