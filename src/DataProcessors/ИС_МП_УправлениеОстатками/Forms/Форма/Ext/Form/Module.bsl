// 
// Возвращаемое значение:
//  Структура - Возвращает структуру сформированную в результате запуска фонового задания
//
&НаСервере  
Функция НачатьВыгрузкуОстатковНаСервере()
    
	ПеречислениеМП = Перечисления.ИС_МП_Маркетплейсы[Маркетплейс];

	ПараметрыВыполнения = ДлительныеОперации.ПараметрыВыполненияВФоне(УникальныйИдентификатор);
	ПараметрыВыполнения.ЗапуститьВФоне = Истина;
	ПараметрыВыполнения.ОжидатьЗавершение = 0;
	
	ТаблицаВыгрузки = СформироватьТаблицуВыгрузки(ПеречислениеМП);
	
	Если ТаблицаВыгрузки.Количество() = 0 Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Возврат ДлительныеОперации.ВыполнитьПроцедуру(ПараметрыВыполнения, "ИС_МП_УправлениеОстатками.ВыгрузитьОстатки", 
		ПеречислениеМП, Профиль, ЭтотОбъект[Маркетплейс + "Склад"], ТаблицаВыгрузки);

КонецФункции //- ИнфоСофт Ивонин К.А. 15.03.24 УА #71892

// + ИнфоСофт Ивонин К.А. 01.04.24 УА #71892
//
// Параметры:
//  ПеречислениеМП	 - ПеречислниеСсылка.ИС_МП_Маркетплейсы	 - Маркетплейс по которому необходимо сформировать таблицу
// 
// Возвращаемое значение:
//  ТаблицаЗначений - Сформированная таблица для выгрузки остатков на Маркетплейс
//
&НаСервере   
Функция СформироватьТаблицуВыгрузки(ПеречислениеМП)

	ТаблицаВыгрузки = Новый ТаблицаЗначений;
	
	ИС_МП_УправлениеОстатками.ЗаполнитьКолонкиТаблицыВыгрузкиОстатков(ПеречислениеМП, ТаблицаВыгрузки);
	
	МассивПараметров = ИС_МП_УправлениеОстатками.ПолучитьПоляДляВыгрузки(ПеречислениеМП);
	
	Для Каждого Строка Из ЭтотОбъект[Маркетплейс + "ТаблицаВыгрузки"] Цикл
	
		Если Не Строка.Выгружать Тогда
			Продолжить;
		КонецЕсли;
	              
		НоваяСтрока = ТаблицаВыгрузки.Добавить();
		
		Для Каждого Элемент Из МассивПараметров Цикл
			НоваяСтрока[Элемент] = Строка[Элемент];
		КонецЦикла;
		
		НоваяСтрока.Остаток = Строка.БудетВыгружено;

	КонецЦикла;
	
	Возврат ТаблицаВыгрузки;
	 
КонецФункции //- ИнфоСофт Ивонин К.А. 01.04.24 УА #71892

