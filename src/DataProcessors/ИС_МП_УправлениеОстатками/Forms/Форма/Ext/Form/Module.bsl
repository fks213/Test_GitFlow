//+ ИнфоСофт Ивонин К.А. 15.03.24 УА #71892
&НаКлиенте
Процедура НачатьПолучениеТекущихОстатков()
    
    НайденныеСтроки = ТаблицаФоновыхЗаданий.НайтиСтроки(Новый Структура("Маркетплейс", Маркетплейс));
	
	Если НайденныеСтроки.Количество() > 0 Тогда
		Возврат;
	КонецЕсли;
    
	ДлительнаяОперация = НачатьПолучениеОстатковНаСервере();
	
	Если ДлительнаяОперация.Свойство("ИдентификаторЗадания") 
			И ЗначениеЗаполнено(ДлительнаяОперация.ИдентификаторЗадания) Тогда
		
		НоваяСтрока = ТаблицаФоновыхЗаданий.Добавить();
		НоваяСтрока.ИдентификаторЗадания = ДлительнаяОперация.ИдентификаторЗадания;
		НоваяСтрока.Маркетплейс = Маркетплейс;
			
		ДопПараметры = ДлительнаяОперация.ИдентификаторЗадания;
	
	КонецЕсли;
	
	ОповещениеОЗавершении = Новый ОписаниеОповещения("ПолучениеОстатковЗавершение", ЭтотОбъект, ДопПараметры);
	ДлительныеОперацииКлиент.ОжидатьЗавершение(ДлительнаяОперация, ОповещениеОЗавершении, ПараметрыОжидания());
	
	Элементы[Маркетплейс + "КартинкаОжидание"].Видимость = Истина;
	
КонецПроцедуры //- ИнфоСофт Ивонин К.А. 15.03.24 УА #71892

