//+ ИнфоСофт Ивонин К.А. 31.03.24 УА #71892
&НаСервере
Функция ЗагрузитьРучныеОстаткиНаСервере()
	
	Если Не ЗначениеЗаполнено(АдресРучныхОстатковВоВременномХранилище) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	РучныеОстаткиТЗ = ИС_MP_Сервер.ПолучитьТаблицуЗначенийИзExcel(АдресРучныхОстатковВоВременномХранилище);
	
	Если РучныеОстаткиТЗ = Неопределено Или РучныеОстаткиТЗ.Количество() = 0 Тогда
		Возврат Неопределено;
	КонецЕсли;
    
	Если РучныеОстаткиТЗ.Колонки.Найти("Остаток") = Неопределено Тогда
		ОбщегоНазначения.СообщитьПользователю("В файле не найдена колонка ""Остаток"", проверьте корректность файла");
		Возврат Неопределено;
	КонецЕсли;
	                                 
	ПолеПоиска = Неопределено;
	ПолеСопоставления = Неопределено;
	
	Таблица = ЭтотОбъект[Маркетплейс + "ТаблицаВыгрузки"];
	МассивСтрокВыгрузки = Новый Массив;
	МассивСтрокВыгрузки.Добавить(Таблица[0]);
	
	РеквизитыТаблицы = ПолучитьРеквизиты(Маркетплейс + "ТаблицаВыгрузки");
	
	ОпределитьПолеПоиска(РеквизитыТаблицы, РучныеОстаткиТЗ.Колонки, ПолеСопоставления, ПолеПоиска);
	
	Если ПолеПоиска = Неопределено Тогда
		ОбщегоНазначения.СообщитьПользователю("В файле не найдена колонка для сопоставлентя остатка по данному маркетплейсу");
		Возврат Неопределено;
	КонецЕсли;
	
	Счетчик = 0;
		
	Для Каждого Строка Из РучныеОстаткиТЗ Цикл
	
		НайденныеСтроки = Таблица.НайтиСтроки(Новый Структура(ПолеПоиска, Строка[ПолеСопоставления]));
		    
		Если Строка.Остаток = "" Тогда
			Продолжить;
		КонецЕсли;
		    
		Если НайденныеСтроки.Количество() > 0 Тогда

			НайденныеСтроки[0].РучнойОстаток = Строка.Остаток;
			НайденныеСтроки[0].РучнойОстатокИзменен = Истина;
			НайденныеСтроки[0].БудетВыгружено = Строка.Остаток;
			Счетчик = Счетчик + 1;	
	
		КонецЕсли;	
	
	КонецЦикла;
	
	Возврат Счетчик;

КонецФункции //- ИнфоСофт Ивонин К.А. 31.03.24 УА #71892

//+ ИнфоСофт Ивонин К.А. 08.04.24 УА #71892
&НаСервереБезКонтекста   
Процедура ОпределитьПолеПоиска(Знач РеквизитыТаблицы, Знач Колонки, ПолеСопоставления, ПолеПоиска)

	Для Каждого Колонка Из Колонки Цикл
		
		Если Колонка.Имя = "Остаток" Тогда
			Продолжить;
		КонецЕсли;
		
		Для Каждого Реквизит Из РеквизитыТаблицы Цикл
			
			Если Не Реквизит.ТипЗначения.СодержитТип(Тип("Строка")) Тогда
				Продолжить;
			КонецЕсли;
			
			ПредставлениеЗаголовка = СтрЗаменить(Реквизит.Заголовок, " ", "");
			ПредставлениеЗаголовка = СтрЗаменить(ПредставлениеЗаголовка, ".", "_");
			
			Если ПредставлениеЗаголовка = Колонка.Имя Тогда
				ПолеПоиска = Реквизит.Имя;
				ПолеСопоставления = Колонка.Имя;
				Прервать;
			КонецЕсли;
			
		КонецЦикла;		                                        
		
	КонецЦикла;

КонецПроцедуры //- ИнфоСофт Ивонин К.А. 08.04.24 УА #71892

