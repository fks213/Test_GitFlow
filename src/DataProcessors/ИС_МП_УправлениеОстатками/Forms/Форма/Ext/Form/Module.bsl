//+ ИнфоСофт Ивонин К.А. 14.03.24 УА #71892
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	УстановитьУсловноеОформление();
	ИС_МП_Сервер.ПриСозданииНаСервере(ЭтотОбъект);	
	Маркетплейс = "ВБ";	
КонецПроцедуры //- ИнфоСофт Ивонин К.А. 14.03.24 УА #71892

//+ ИнфоСофт Ивонин К.А. 21.03.24 УА #71892
&НаСервере
Процедура ПриЗагрузкеДанныхИзНастроекНаСервере(Настройки)
	
	ОпределитьИнтегрируемыеМаркетплейсы();
		
	Если ЗначениеЗаполнено(Профиль) И ЗначениеЗаполнено(ЭтотОбъект[Маркетплейс + "Склад"]) Тогда
		ОбновитьСписокНаСервере();
		Элементы["ДекорацияНадписьСклад" + Маркетплейс].Заголовок = 
			СформироватьИнформациюОСкладе(Маркетплейс, ЭтотОбъект[Маркетплейс + "Склад"]);	
	КонецЕсли;
	
КонецПроцедуры //- ИнфоСофт Ивонин К.А. 21.03.24 УА #71892

//+ ИнфоСофт Ивонин К.А. 14.03.24 УА #71892
&НаКлиенте
Процедура ПриОткрытии(Отказ)	
	
	ИС_МП_Клиент.ПриОткрытии(ЭтотОбъект, Отказ);
	
	Элементы.ГруппаСтраницы.ТекущаяСтраница = Элементы["Страница" + Маркетплейс];
	ПоследняяСтраница = Элементы["Страница" + Маркетплейс];		
	УправлениеФормой();
	ЗаполнитьШапку();
		
КонецПроцедуры //- ИнфоСофт Ивонин К.А. 14.03.24 УА #71892

//+ ИнфоСофт Ивонин К.А. 14.03.24 УА #71892
&НаКлиенте
Процедура ГруппаСтраницыПриСменеСтраницы(Элемент, ТекущаяСтраница)
	
	ОчиститьСообщения();
		
	Элементы.ВыгрузитьОстатки.Доступность = Ложь;
	
	Маркетплейс = СтрЗаменить(ТекущаяСтраница.Имя, "Страница", "");
	ПоследняяСтраница = Элементы["Страница" + Маркетплейс];

	УстановитьВидимостьПолученияОстатков();
	ЗаполнитьШапку();
	
	Если ЗначениеЗаполнено(Профиль) И ЗначениеЗаполнено(ЭтотОбъект[Маркетплейс + "Склад"]) Тогда
		
		Если ЭтотОбъект[Маркетплейс + "ТаблицаВыгрузки"].Количество() = 0 Тогда
			ОбновитьСписокНаСервере();
		КонецЕсли;
			
		ЗаполнитьИнформациюОСкладе();
			
		Если ЭтотОбъект[Маркетплейс + "ОтображатьТекущиеОстатки"] 
				И ЭтотОбъект[Маркетплейс + "ПолучатьТекущиеОстаткиАвтоматически"] Тогда
    	
    		НачатьПолучениеТекущихОстатков();
		
		КонецЕсли;
		
	КонецЕсли;
	
	Если ЭтотОбъект[Маркетплейс + "ТаблицаВыгрузки"].Количество() > 0 Тогда
		Элементы.ВыгрузитьОстатки.Доступность = Истина;
	КонецЕсли;
		
КонецПроцедуры //- ИнфоСофт Ивонин К.А. 14.03.24 УА #71892

//+ ИнфоСофт Ивонин К.А. 14.03.24 УА #71892
&НаКлиенте
Процедура ПрофильПриИзменении(Элемент)
	
	ОпределитьИнтегрируемыеМаркетплейсы();
	ГруппаСтраницыПриСменеСтраницы(Элементы.ГруппаСтраницы, Элементы.ГруппаСтраницы.ТекущаяСтраница);
	
	Если ЗначениеЗаполнено(Профиль) Тогда
	
		ЭтотОбъект[Маркетплейс + "Склад"] = ПолучитьСкладПоУмолчанию(Маркетплейс, Профиль);
		ЗаполнитьШапку();
	
		Если ЗначениеЗаполнено(ЭтотОбъект[Маркетплейс + "Склад"]) Тогда
			ОбновитьСписокНаСервере();
			ЗаполнитьИнформациюОСкладе();
			Возврат;	
		КонецЕсли;
					
	КонецЕсли;
	
	ЭтотОбъект[Маркетплейс + "ТаблицаВыгрузки"].Очистить();
	Элементы.ВыгрузитьОстатки.Доступность = Ложь;
	
КонецПроцедуры //- ИнфоСофт Ивонин К.А. 14.03.24 УА #71892

//+ ИнфоСофт Ивонин К.А. 14.03.24 УА #71892
&НаКлиенте
Процедура СкладПриИзменении(Элемент)
	
	ОчиститьСообщения();
	
	Если ЗначениеЗаполнено(ЭтотОбъект[Маркетплейс + "Склад"]) Тогда
		ОбновитьСписокНаСервере();
		ЗаполнитьИнформациюОСкладе();
	Иначе
		ЭтотОбъект[Маркетплейс + "ТаблицаВыгрузки"].Очистить();
		Элементы.ВыгрузитьОстатки.Доступность = Ложь;
		Элементы["ДекорацияНадписьСклад" + Маркетплейс].Заголовок = "";	
	КонецЕсли;	                                                
	
КонецПроцедуры //- ИнфоСофт Ивонин К.А. 14.03.24 УА #71892

//+ ИнфоСофт Ивонин К.А. 15.03.24 УА #71892
