//
// Параметры:
//  Маркетплейс	 - Строка - Строковое представление маркетплейса 
//  Склад		 - ЛюбаяСсылка - Склад по которому необходимо получить информацию
// 
// Возвращаемое значение:
//  Строка - содержит текстовое описание параметров склада исходя из настроек
//
&НаСервереБезКонтекста
Функция СформироватьИнформациюОСкладе(Знач Маркетплейс, Знач Склад)
	
	ПеречислениеМП = Перечисления.ИС_МП_Маркетплейсы[Маркетплейс];
	
	Возврат ИС_МП_УправлениеОстатками.ПолучитьИнформациюОСкладе(ПеречислениеМП, Склад);		

КонецФункции //- ИнфоСофт Ивонин К.А. 01.04.24 УА #71892

//+ ИнфоСофт Ивонин К.А. 28.03.24 УА #71892
&НаСервере
Процедура УстановитьУсловноеОформление()

	УсловноеОформление.Элементы.Очистить();
	
	ИнтегрируемыеМаркетплейсы = ИС_МП_Сервер.ИнтегрируемыеМаркетплейсы();
	
	// +#Удалить
	ИнтегрируемыеМаркетплейсы.Добавить("Ozon");
	ИнтегрируемыеМаркетплейсы.Добавить("Яндекс");
	ИнтегрируемыеМаркетплейсы.Добавить("Сбер");
	ИнтегрируемыеМаркетплейсы.Добавить("Aliexpress");
	// -#Удалить
	
	ТипЭлементОтбораКомпоновкиДанных = Тип("ЭлементОтбораКомпоновкиДанных");
	ОформлениеЦветТекста = "ЦветТекста";
	ОформлениеФормат = "Формат";
	ФорматНуля = "ЧН=0";
	
	Для Каждого Маркетплейс Из ИнтегрируемыеМаркетплейсы Цикл
	    
	    // Отсутствует сопоставление
	    
