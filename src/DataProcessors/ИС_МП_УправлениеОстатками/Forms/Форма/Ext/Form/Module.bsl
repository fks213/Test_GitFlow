//+ ИнфоСофт Ивонин К.А. 15.03.24 УА #71892
&НаКлиенте
Процедура ПолучениеОстатковЗавершение(Результат, ДополнительныеПараметры) Экспорт
       
    МП = Маркетплейс;
   
    Если ЗначениеЗаполнено(ДополнительныеПараметры) Тогда
    	
    	НайденныеСтроки = ТаблицаФоновыхЗаданий.НайтиСтроки(
    			Новый Структура("ИдентификаторЗадания", ДополнительныеПараметры));
    	
    	Если НайденныеСтроки.Количество() > 0 Тогда
    		МП = НайденныеСтроки[0].Маркетплейс;
    		ТаблицаФоновыхЗаданий.Удалить(НайденныеСтроки[0]);
    	КонецЕсли;	
    	
    КонецЕсли;
    
    Элементы[МП + "КартинкаОжидание"].Видимость = Ложь;
    
    Если Результат = Неопределено Тогда  // отменено пользователем
		Возврат;
	КонецЕсли;
    
	Если Результат.Статус = "Выполнено" Тогда
	    ОбработатьРезультатПолученияОстатковНаСервере(Результат.АдресРезультата, МП);
	КонецЕсли;
	
	Если Результат.Статус = "Ошибка" Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю(Результат.ПодробноеПредставлениеОшибки);	
	КонецЕсли;
	
	Если Результат.Сообщения.Количество() > 0 Тогда
		
		Для Каждого Элемент Из Результат.Сообщения Цикл
			ОбщегоНазначенияКлиент.СообщитьПользователю(Элемент.Текст);
		КонецЦикла;
		
	КонецЕсли;
	
	УдалитьИзВременногоХранилища(Результат.АдресРезультата);
	
КонецПроцедуры //- ИнфоСофт Ивонин К.А. 15.03.24 УА #71892

//+ ИнфоСофт Ивонин К.А. 01.04.24 УА #71892
&НаСервере   
Процедура ОбработатьРезультатПолученияОстатковНаСервере(Знач Адрес, Знач МП)

	Если МП = Неопределено Тогда
		МП = Маркетплейс;
	КонецЕсли;
	
	Остатки = ПолучитьИзВременногоХранилища(Адрес);
	
	ПеречислениеМП = Перечисления.ИС_МП_Маркетплейсы[МП];
	
    ПолеСопоставления = 
    	ИС_МП_УправлениеОстатками.ПолучитьПолеСопоставленияОстатков(ПеречислениеМП);
    
    Таблица = ЭтотОбъект[МП + "ТаблицаВыгрузки"];
    
	Для Каждого Строка Из Таблица Цикл
		Строка.ОстатокНаМаркетплейсе = 0;
		Строка.ЕстьОстатокНаМаркетплейсе = Ложь;
	КонецЦикла;
	                                                    
	Для Каждого Строка Из Остатки Цикл
	
		НайденныеСтроки = Таблица.НайтиСтроки(Новый Структура(ПолеСопоставления, Строка[ПолеСопоставления]));
		
		Если НайденныеСтроки.Количество() > 0 Тогда
			НайденныеСтроки[0].ОстатокНаМаркетплейсе = Строка.Остаток;
			НайденныеСтроки[0].ЕстьОстатокНаМаркетплейсе = Истина;
		КонецЕсли;
		
	КонецЦикла;

КонецПроцедуры //- ИнфоСофт Ивонин К.А. 01.04.24 УА #71892

//+ ИнфоСофт Ивонин К.А. 15.03.24 УА #71892
&НаКлиенте
Процедура УправлениеФормой()
    
    Элементы.СохранитьИзменения.Видимость = Ложь;
    
	УстановитьВидимостьПолученияОстатков();

	Если ЭтотОбъект[Маркетплейс + "ОтображатьТекущиеОстатки"] 
			И ЭтотОбъект[Маркетплейс + "ПолучатьТекущиеОстаткиАвтоматически"] Тогда
	    
	    Если ЗначениеЗаполнено(Профиль) И ЗначениеЗаполнено(ЭтотОбъект[Маркетплейс + "Склад"]) Тогда
			НачатьПолучениеТекущихОстатков();
		КонецЕсли;
	
	КонецЕсли;
		
КонецПроцедуры //- ИнфоСофт Ивонин К.А. 15.03.24 УА #71892

//+ ИнфоСофт Ивонин К.А. 15.03.24 УА #71892
&НаСервере   
Процедура СохранитьИзмененияНаСервере(МассивМаркетплейсов)
	
	Для Каждого МП Из МассивМаркетплейсов Цикл 
		
		ПеречислениеМП = Перечисления.ИС_МП_Маркетплейсы[МП];		
    
		ПолеСопоставление = ИС_МП_УправлениеОстатками.ПолучитьПолеСопоставленияОстатков(ПеречислениеМП);
	
		Для Каждого Строка Из ЭтотОбъект[МП + "ТаблицаВыгрузки"] Цикл
		    
			Если Строка.РучнойОстатокИзменен Тогда

				ИС_МП_УправлениеОстатками.ЗаписатьРучнойОстаток(
					Профиль, ПеречислениеМП, ЭтотОбъект[МП + "Склад"], Строка[ПолеСопоставление], Строка.РучнойОстаток);

				Строка.ЕстьРучнойОстаток = Истина;
				Строка.РучнойОстатокИзменен = Ложь;

			КонецЕсли;
			
			Если Строка.СкрываемыйОстатокИзменен Тогда
			
				ИС_МП_УправлениеОстатками.ЗаписатьСкрываемыйОстаток(
					Профиль, ПеречислениеМП, ЭтотОбъект[МП + "Склад"], Строка[ПолеСопоставление], Строка.СкрываемыйОстаток);
		
			    Строка.ЕстьСкрываемыйОстаток = Истина;
				Строка.СкрываемыйОстатокИзменен = Ложь;
			
			КонецЕсли;	
			
		КонецЦикла;
	
	КонецЦикла;
		
КонецПроцедуры //- ИнфоСофт Ивонин К.А. 15.03.24 УА #71892 

//+ ИнфоСофт Ивонин К.А. 20.03.24 УА #71892
&НаКлиенте
Процедура ЗаполнитьПоВыделеннымЗавершение(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ВыделенныеСтроки = Элементы[Маркетплейс + "ТаблицаВыгрузки"].ВыделенныеСтроки;
		
	Для Каждого Строка Из ВыделенныеСтроки Цикл
		
		ТекСтрока = ЭтотОбъект[Маркетплейс + "ТаблицаВыгрузки"].НайтиПоИдентификатору(Строка);
		ТекСтрока[ДополнительныеПараметры] = Результат;
		ТекСтрока[ДополнительныеПараметры + "Изменен"] = Истина;
		
		ПересчитатьБудетВыгружено(ТекСтрока);

	КонецЦикла;
	
	Элементы.СохранитьИзменения.Видимость = Истина;
	ЗаголовокСтраницы = ИС_МП_Клиент.ПредставлениеМаркетплейса(Маркетплейс);
	Элементы["Страница" + Маркетплейс].Заголовок = ЗаголовокСтраницы + " *";

КонецПроцедуры //- ИнфоСофт Ивонин К.А. 20.03.24 УА #71892

//+ ИнфоСофт Ивонин К.А. 26.03.24 УА #71892
&НаКлиенте
Процедура НесохраненныеИзмененияЗавершение(Результат, ДополнительныеПараметры) Экспорт
    
    Если Результат = Неопределено Тогда
    	Возврат;
    КонецЕсли;
    
    Если Результат.Значение = КодВозвратаДиалога.Да Тогда
    	
    	Модифицированность = Ложь;
    	Элементы.СохранитьИзменения.Видимость = Ложь;
    	
    	Если ТипЗнч(ДополнительныеПараметры) = Тип("Структура") 
    			И ДополнительныеПараметры.Свойство("Закрытие") 
    			И ДополнительныеПараметры.Закрытие Тогда 
    	
    		Закрыть();
    	
    	КонецЕсли;
    	
    	ТекущаяСтраница = Элементы.ГруппаСтраницы.ТекущаяСтраница;
    	
    	Маркетплейс = СтрЗаменить(ТекущаяСтраница.Имя, "Страница", "");
		ПоследняяСтраница = Элементы["Страница" + Маркетплейс];

		УстановитьВидимостьПолученияОстатков();
		
		Если ЗначениеЗаполнено(Профиль) И ЗначениеЗаполнено(ЭтотОбъект[Маркетплейс + "Склад"]) Тогда
			ОбновитьСписокНаСервере();
			ЗаполнитьИнформациюОСкладе();
		КонецЕсли;
   
       	Возврат;
    			
    КонецЕсли;
    
    Элементы.ГруппаСтраницы.ТекущаяСтраница = ПоследняяСтраница;
    	
КонецПроцедуры //- ИнфоСофт Ивонин К.А. 26.03.24 УА #71892

