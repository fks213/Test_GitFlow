//+ ИнфоСофт Ивонин К.А. 28.03.24 УА #71892
&НаКлиенте
Процедура УдалитьРучнойОстаток(Команда)
	
	ВыделенныеСтроки = Элементы[Маркетплейс + "ТаблицаВыгрузки"].ВыделенныеСтроки;
	
	Если ВыделенныеСтроки.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	ПолеСопоставление = ИС_МП_Клиент.ПолеСопоставленияОстатков(Маркетплейс);
	
	Для Каждого Строка Из ВыделенныеСтроки Цикл

		ОбрабатываемаяСтрока = ЭтотОбъект[Маркетплейс + "ТаблицаВыгрузки"].НайтиПоИдентификатору(Строка);
		УдалитьРучнойОстатокНаСервере(Профиль, Маркетплейс, 
			ЭтотОбъект[Маркетплейс + "Склад"], ОбрабатываемаяСтрока[ПолеСопоставление]);
		ОбрабатываемаяСтрока.ЕстьРучнойОстаток = Ложь;
		ОбрабатываемаяСтрока.РучнойОстатокИзменен = Ложь;
		ОбрабатываемаяСтрока.РучнойОстаток = 0;
		ПересчитатьБудетВыгружено(ОбрабатываемаяСтрока);

	КонецЦикла;
		
КонецПроцедуры //- ИнфоСофт Ивонин К.А. 28.03.24 УА #71892

//+ ИнфоСофт Ивонин К.А. 28.03.24 УА #71892
&НаКлиенте
Процедура УдалитьСкрываемыйОстаток(Команда)
	
	ВыделенныеСтроки = Элементы[Маркетплейс + "ТаблицаВыгрузки"].ВыделенныеСтроки;
	
	Если ВыделенныеСтроки.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	ПолеСопоставление = ИС_МП_Клиент.ПолеСопоставленияОстатков(Маркетплейс);
	
	Для Каждого Строка Из ВыделенныеСтроки Цикл
	
		ОбрабатываемаяСтрока = ЭтотОбъект[Маркетплейс + "ТаблицаВыгрузки"].НайтиПоИдентификатору(Строка);
		УдалитьСкрываемыйОстатокНаСервере(Профиль, Маркетплейс, 
			ЭтотОбъект[Маркетплейс + "Склад"], ОбрабатываемаяСтрока[ПолеСопоставление]);
		ОбрабатываемаяСтрока.СкрываемыйОстатокИзменен = Ложь;
		ОбрабатываемаяСтрока.ЕстьСкрываемыйОстаток = Ложь;
		ОбрабатываемаяСтрока.СкрываемыйОстаток = ЭтотОбъект[Маркетплейс + "СкрываемыйОстаток"];
        ПересчитатьБудетВыгружено(ОбрабатываемаяСтрока);
        
	КонецЦикла;
	
