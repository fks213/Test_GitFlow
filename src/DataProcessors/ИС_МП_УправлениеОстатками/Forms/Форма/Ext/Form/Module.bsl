// Отказываемся от асинхронности т.к. это основной функционал формы
&НаСервере   
Процедура ОбновитьСписокНаСервере()
	
	ПеречислениеМП = Перечисления.ИС_МП_Маркетплейсы[Маркетплейс];
	
	ПолучитьИЗаполнитьФункциональныеОпцииОстатков(ПеречислениеМП);
	
	Таблица = ЭтотОбъект[Маркетплейс + "ТаблицаВыгрузки"];
	Таблица.Очистить();
	
	Запрос = Новый Запрос;
	Запрос.Текст = ИС_МП_УправлениеОстатками.ПолучитьТекстЗапросаОстатков(ПеречислениеМП);
	
	ИС_МП_УправлениеОстатками.УстановитьПараметрыЗапросаОстатков(
		ПеречислениеМП, Запрос, Профиль, ЭтотОбъект[Маркетплейс + "Склад"]);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаОстатков = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаОстатков.Следующий() Цикл
		
		НоваяСтрока = Таблица.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, ВыборкаОстатков);
		
		НоваяСтрока.КэшРучнойОстаток = НоваяСтрока.РучнойОстаток;
		НоваяСтрока.КэшСкрываемыйОстаток = НоваяСтрока.СкрываемыйОстаток;
		
		Если ВыборкаОстатков.ЕстьСопоставление Или ВыборкаОстатков.ЕстьРучнойОстаток Тогда
			НоваяСтрока.Выгружать = Истина;
		КонецЕсли;
		
		Если ВыборкаОстатков.ЕстьРучнойОстаток Тогда
			НоваяСтрока.БудетВыгружено = НоваяСтрока.РучнойОстаток;
			ПроверитьПоследнийВыгруженныйОстаток(НоваяСтрока);
			Продолжить;
		КонецЕсли;
		
		СкрываемыйОстаток = НоваяСтрока.СкрываемыйОстаток;
			
		Если ЭтотОбъект[Маркетплейс + "РежимСокрытияОстатков"] Тогда
			СкрываемыйОстаток = НоваяСтрока.Свободно * НоваяСтрока.СкрываемыйОстаток / 100;	
		КонецЕсли;
		
		НоваяСтрока.БудетВыгружено = 0;
					
		Если НоваяСтрока.Свободно > СкрываемыйОстаток Тогда
			НоваяСтрока.БудетВыгружено = НоваяСтрока.Свободно - СкрываемыйОстаток;				
		КонецЕсли;
		 										
		Если ЭтотОбъект[Маркетплейс + "ИспользоватьФиксированныйОстаток"] 
				И НоваяСтрока.БудетВыгружено > ЭтотОбъект[Маркетплейс + "ФиксированныйОстаток"] Тогда

			НоваяСтрока.БудетВыгружено = ЭтотОбъект[Маркетплейс + "ФиксированныйОстаток"];	 

		КонецЕсли;
		
        ПроверитьПоследнийВыгруженныйОстаток(НоваяСтрока);
	
	КонецЦикла;
	
	Если ЭтотОбъект[Маркетплейс + "ТаблицаВыгрузки"].Количество() > 0 Тогда
		Элементы.ВыгрузитьОстатки.Доступность = Истина;
	КонецЕсли;	
	
КонецПроцедуры //- ИнфоСофт Ивонин К.А. 14.03.24 УА #71892

