//+ ИнфоСофт Ивонин К.А. 28.03.24 УА #71892
&НаСервере   
Процедура ЗаполнитьТехническуюИнформацию()
	
	ТехИнфо = ИС_МП_ОбновлениеМодуля.ТехническаяИнформация();
	ЗаполнитьЗначенияСвойств(ЭтотОбъект, ТехИнфо);
	Элементы.ВерсияМодуля.Подсказка = ТехИнфо.Хеш;
	
КонецПроцедуры //- ИнфоСофт Ивонин К.А. 28.03.24 УА #71892

//+ ИнфоСофт Ивонин К.А. 31.01.23 УА #54554
&НаСервере
Процедура ПроверитьНаличиеОбновленийНаСервере()
    
    Элементы.СообщениеОбОшибке.Видимость = Ложь; 
    Элементы.АктуальнаяВерсия.Видимость = Ложь;
	Элементы.НоваяВерсия.Видимость = Ложь;
    
	ИнформацияОВерсиях = ИС_МП_ОбновлениеМодуля.ИнформацияОбОбновлении();
		
	Если ИнформацияОВерсиях.ЕстьОшибки Тогда
		Элементы.СообщениеОбОшибке.Заголовок = ИнформацияОВерсиях.СообщениеОбОшибке;
		Элементы.СообщениеОбОшибке.Видимость = Истина;		
	Иначе
		
		Если ИнформацияОВерсиях.ЕстьНоваяВерсия Тогда
			НоваяВерсия = ИнформацияОВерсиях.НоваяВерсия;
			Элементы.НоваяВерсия.Видимость = Истина;
		Иначе
			Элементы.АктуальнаяВерсия.Видимость = Истина;
		КонецЕсли;
		
	КонецЕсли;
	
	ВремяПоследнейПроверки = ТекущаяДатаСеанса();
	
КонецПроцедуры //- ИнфоСофт Ивонин К.А. 31.01.23 УА #54554

//+ ИнфоСофт Ивонин К.А. 06.03.24 УА #65940
&НаСервере   
Функция ПолучитьФайлИнструкцииНаСервере()

	ПараметрыЗапроса = ИС_МП_РаботаСHTTPЗапросами.СтруктураHTTPЗапроса();
    
	РезультатРазбора = ИС_МП_РаботаСHTTPЗапросами.РазобратьURLНаПараметрыЗапроса(
		"https://drive.google.com/uc?export=download&id=11anaRyEBq1x_Q3e3W04CKyGhtZZDfacE");	

	ЗаполнитьЗначенияСвойств(ПараметрыЗапроса, РезультатРазбора);
	
	ПараметрыЗапроса.ФорматОтвета = "ДвоичныеДанные";
	ПараметрыЗапроса.ОбрабатыватьКоды3XX = Истина;
	
	РезультатЗапроса = ИС_МП_РаботаСHTTPЗапросами.ОтправитьGETЗапрос(ПараметрыЗапроса);
	
	Если РезультатЗапроса.КодОтвета = 200 Тогда
		Возврат ПоместитьВоВременноеХранилище(РезультатЗапроса.Ответ);
	КонецЕсли;
	
	Возврат Неопределено; 

КонецФункции //- ИнфоСофт Ивонин К.А. 06.03.24 УА #65940

//+ ИнфоСофт Ивонин К.А. 06.03.24 УА #65940
&НаКлиенте
Процедура СкачатьИнструкциюЗавершение(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат <> Неопределено Тогда
		ДвоичныеДанные = ПолучитьИзВременногоХранилища(ДополнительныеПараметры);
		ДвоичныеДанные.НачатьЗапись(Новый ОписаниеОповещения("СохранениеИнструкцииЗавершение", ЭтотОбъект), Результат[0]); 		
	КонецЕсли;
	
	УдалитьИзВременногоХранилища(ДополнительныеПараметры);	
	
КонецПроцедуры //- ИнфоСофт Ивонин К.А. 06.03.24 УА #65940

//+ ИнфоСофт Ивонин К.А. 06.03.24 УА #65940
&НаКлиенте
