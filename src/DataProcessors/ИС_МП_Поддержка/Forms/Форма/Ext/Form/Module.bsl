//+ ИнфоСофт Ивонин К.А. 01.08.24 УА #79145
&НаКлиенте
Процедура СкачатьИнструкциюПоРаботеСМодулемНажатие(Элемент)
    
    ОчиститьСообщения();
    
	Результат = ПолучитьФайлИнструкцииНаСервере();
	
	Если Результат = Неопределено Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю("Не удалось скачать файл инструкции...");
		Возврат;
	КонецЕсли;
			
	Режим = РежимДиалогаВыбораФайла.Сохранение;
	ДиалогОткрытияФайла = Новый ДиалогВыбораФайла(Режим);
	
	ДиалогОткрытияФайла.ПолноеИмяФайла = "Руководство по работе с модулем «Управление Маркетплейсами на 1С».docx";
	Фильтр = "Документы Word (*.docx)|*.xlsx";
	ДиалогОткрытияФайла.Фильтр = Фильтр;
	ДиалогОткрытияФайла.Заголовок = "Сохранить как";
	
	ДиалогОткрытияФайла.Показать(Новый ОписаниеОповещения("СкачатьИнструкциюЗавершение", ЭтаФорма, Результат));

КонецПроцедуры //- ИнфоСофт Ивонин К.А. 01.08.24 УА #79145

