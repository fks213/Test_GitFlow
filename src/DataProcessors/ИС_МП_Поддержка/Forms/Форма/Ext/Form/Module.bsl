	ОбщегоНазначенияКлиент.СообщитьПользователю("Файл успешно сохранен");
КонецПроцедуры //- ИнфоСофт Ивонин К.А. 06.03.24 УА #65940

//+ ИнфоСофт Ивонин К.А. 29.08.24 УА #81109
&НаКлиенте
Процедура ПриОткрытииЗавершение(Результат, ДопПараметры) Экспорт
	
	Элементы.СкачатьИнструкциюПоРаботеСМодулем.Доступность = Ложь;
	
	Если Результат = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если Результат = Истина Тогда
		Элементы.СкачатьИнструкциюПоРаботеСМодулем.Доступность = Истина;	
	КонецЕсли;
			
КонецПроцедуры //- ИнфоСофт Ивонин К.А. 29.08.24 УА #81109

