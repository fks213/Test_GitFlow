Функция ТестПодключенияНаСервере()
	Возврат ИС_МП_ОбновлениеМодуля.ТестПодключения();	
КонецФункции //- ИнфоСофт Ивонин К.А. 09.08.24 УА #79145

//+ ИнфоСофт Ивонин К.А. 02.06.23 УА #58360
&НаСервере   
Функция СохранитьНаСервере() 
	
	СтруктураНастроек = ИС_МП_ОбновлениеМодуля.СтруктураНастроек();
	ЗаполнитьЗначенияСвойств(СтруктураНастроек, ЭтотОбъект);
	
	Возврат ИС_МП_ОбновлениеМодуля.ЗаписатьНастройкиАвтообновления(СтруктураНастроек);
	
КонецФункции //- ИнфоСофт Ивонин К.А. 02.06.23 УА #58360

//+ ИнфоСофт Ивонин К.А. 08.08.24 УА #79145
&НаКлиенте
Процедура НесохраненныеИзмененияЗавершение(Результат, ДополнительныеПараметры) Экспорт
    
    Если Результат = Неопределено Тогда
    	Возврат;
    КонецЕсли;
    
    Если Результат.Значение = КодВозвратаДиалога.Да Тогда
    	Модифицированность = Ложь;
    	Закрыть();
    КонецЕсли;
    
КонецПроцедуры //- ИнфоСофт Ивонин К.А. 08.08.24 УА #79145

