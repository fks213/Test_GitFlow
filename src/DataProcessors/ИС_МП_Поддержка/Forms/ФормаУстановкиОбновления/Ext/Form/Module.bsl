КонецПроцедуры //- ИнфоСофт Ивонин К.А. 05.06.23 УА #59411

//+ ИнфоСофт Ивонин К.А. 06.03.23 УА #53535
&НаКлиенте
Процедура ПриЗакрытии(ЗавершениеРаботы)
	
	Если НеПрерываниеОбновления Тогда
		Возврат;	
	КонецЕсли;
	
	ПрерватьОбновлениеНаСервере();	
	
КонецПроцедуры //- ИнфоСофт Ивонин К.А. 06.03.23 УА #53535

//+ ИнфоСофт Ивонин К.А. 06.03.23 УА #53535
&НаКлиенте
Процедура НаличиеРезервнойКопииПриИзменении(Элемент)
    
    Если Не НаличиеРезервнойКопии Тогда
    	Возврат;
    КонецЕсли;
    
	Режим = РежимДиалогаВопрос.ДаНет;
	Оповещение = Новый ОписаниеОповещения("ПослеЗакрытияВопроса", ЭтотОбъект, Параметры);
	ПоказатьВопрос(Оповещение, НСтр("ru = 'Данным действие вы подтверждаете наличие резервной копии данной информационной базы 1С.
	|При возникновения нештатной ситуации ваша база данных 1С может быть повреждена и восстановление в случае отсутствия копии может быть НЕВОЗМОЖНЫМ!
	|Уверены что хотите продолжить?'"), Режим);
    
КонецПроцедуры //- ИнфоСофт Ивонин К.А. 06.03.23 УА #53535

#КонецОбласти

