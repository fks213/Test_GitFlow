#Область СлужебныеПроцедурыИФункции

//+ ИнфоСофт Ивонин К.А. 01.02.23 УА #54554
&НаКлиенте
Процедура УправлениеПросмотром()
	
	Элементы.Установить.Видимость = Ложь;
	Элементы.Далее.Видимость = Ложь;
	
	Если МожноОбновляться Тогда
		Элементы.Далее.Видимость = Истина;
	КонецЕсли;
	
	Если Элементы.ГруппаСтраницы.ТекущаяСтраница = Элементы.ГруппаСтраницаНачало Тогда
		Элементы.ГруппаСтраницы.ТекущаяСтраница = Элементы.ГруппаСтраницаИнформацияОбОбновлении;
	ИначеЕсли Элементы.ГруппаСтраницы.ТекущаяСтраница = Элементы.ГруппаСтраницаИнформацияОбОбновлении Тогда
		Элементы.ГруппаСтраницы.ТекущаяСтраница = Элементы.ГруппаСтраницаРезервнаяКопия;
		Элементы.Установить.Видимость = Истина;
		Элементы.Далее.Видимость = Ложь;
	ИначеЕсли Элементы.ГруппаСтраницы.ТекущаяСтраница = Элементы.ГруппаСтраницаРезервнаяКопия Тогда
		Элементы.ГруппаСтраницы.ТекущаяСтраница = Элементы.ГруппаСтраницаЗавершение;
		Элементы.Установить.Видимость = Ложь;
		Элементы.Далее.Видимость = Ложь;
		Элементы.Перезапустить.Видимость = Истина;	
	КонецЕсли;

КонецПроцедуры //- ИнфоСофт Ивонин К.А. 01.02.23 УА #54554

//+ ИнфоСофт Ивонин К.А. 01.02.23 УА #54554
&НаСервере
Функция ПолучитьИнформациюОбОбновлении()
    
    Элементы.ДекорацияИнформацияОбОбновленииДа.Видимость = Ложь;
	Элементы.ДекорацияИнформацияОбОбновленииНет.Видимость = Ложь;
	
	ТехИнфо = ИС_МП_ОбновлениеМодуля.ТехническаяИнформация();
	ИнформацияОбОбновлении = ИС_МП_ОбновлениеМодуля.ПроверитьНаличиеОбновлений(ТехИнфо);
	
	Если ИнформацияОбОбновлении.ЕстьОшибки Тогда
		Элементы.ДекорацияИнформацияОбОбновленииНет.Видимость = Истина;
		МожноОбновляться = Ложь;
		Возврат Ложь;
	КонецЕсли;
	
	ДатаВыхода = ИнформацияОбОбновлении.Дата;
	Версия = ИнформацияОбОбновлении.Версия;
	Описание = ИнформацияОбОбновлении.Описание;
	Хеш = ИнформацияОбОбновлении.Хеш;
	Guid = ИнформацияОбОбновлении.Guid;
	ИзменяетСтруктуру = Истина;
		
	Элементы.ДекорацияИнформацияОбОбновленииДа.Видимость = Истина;	
	
	Возврат Истина;

КонецФункции //- ИнфоСофт Ивонин К.А. 01.02.23 УА #54554

//+ ИнфоСофт Ивонин К.А. 01.02.23 УА #54554
&НаСервере
Процедура ПроверитьВозможностьОбновления()

	Элементы.ДекорацияДостаточноПравДа.Видимость = Ложь;
	Элементы.ДекорацияДостаточноПравНет.Видимость = Ложь;
	Элементы.ДекорацияОтсутствуютАктивныеСеансыДа.Видимость = Ложь;
	Элементы.ДекорацияОтсутствуютАктивныеСеансыНет.Видимость = Ложь; 
	Элементы.Далее.Видимость = Истина;
	
	Если ПроверитьПраваНаОбновление() Тогда
		Элементы.ДекорацияДостаточноПравДа.Видимость = Истина;
	Иначе
		Элементы.ДекорацияДостаточноПравНет.Видимость = Истина;
		Элементы.Далее.Видимость = Ложь;
		МожноОбновляться = Ложь;		
	КонецЕсли;        
	
	Если ПроверитьМонопольныйДоступ(ИзменяетСтруктуру) Тогда
		Элементы.ДекорацияОтсутствуютАктивныеСеансыДа.Видимость = Истина;
	Иначе
		Элементы.ДекорацияОтсутствуютАктивныеСеансыНет.Видимость = Истина;
		МожноОбновляться = Ложь;
	КонецЕсли;	

КонецПроцедуры //- ИнфоСофт Ивонин К.А. 01.02.23 УА #54554

