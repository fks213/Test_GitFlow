//+ ИнфоСофт Ивонин К.А. 06.03.23 УА #53535
&НаКлиенте
Процедура Проверить(Команда)
	
	МожноОбновляться = Истина;
	ПроверитьВозможностьОбновления();
	
	Элементы.Далее.Видимость = Ложь;
	
	Если МожноОбновляться Тогда
