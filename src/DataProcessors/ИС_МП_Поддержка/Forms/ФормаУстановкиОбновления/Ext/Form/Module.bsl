
#Область ОбработчикиСобытийФормы

//+ ИнфоСофт Ивонин К.А. 31.01.23 УА #54554
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
		
	Результат = ИС_МП_ОбновлениеМодуля.ТестПодключения();
			
	Если Результат = Неопределено Тогда
		Отказ = Истина;	
		Возврат;
	КонецЕсли;
	
	Если Результат.ТокенКорректный Тогда
		
		Если Не Результат.ПроверкаПройдена Тогда
			Отказ = Истина;
			ОбщегоНазначения.СообщитьПользователю("Данный токен, не зарегистрирован за данной базой"); 
			Возврат;
		КонецЕсли;
	
	Иначе
		Отказ = Истина;
		ОбщегоНазначения.СообщитьПользователю("Неверный токен");
		Возврат;
	КонецЕсли;
			
	МожноОбновляться = Истина;
	Если Не ПолучитьИнформациюОбОбновлении() Тогда
		Элементы.ДекорацияНачалоКомментарий.Заголовок = "Не удалось получить информацию об обновлении. 
														|Продолжение невозможно";
	КонецЕсли;	
	
	ПроверитьВозможностьОбновления();	

КонецПроцедуры //- ИнфоСофт Ивонин К.А. 31.01.23 УА #54554

