//+ ИнфоСофт Ивонин К.А. 06.03.23 УА #53535
&НаКлиенте
Процедура Установить(Команда)
	
	Если Не НаличиеРезервнойКопии Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю("Перед установкой необходимо наличие резервной копии данной базы 1С!"
			, , , "НаличиеРезервнойКопии");
		Возврат;
	КонецЕсли;
	
	Результат = УстановитьНаСервере();
	
	Если Результат = Истина Тогда
		УправлениеПросмотром();
	КонецЕсли;
	
КонецПроцедуры //- ИнфоСофт Ивонин К.А. 06.03.23 УА #53535

