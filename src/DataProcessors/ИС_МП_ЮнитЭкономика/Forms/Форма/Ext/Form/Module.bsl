	ТаблицаДанныеРасчета.Колонки.Добавить("Характеристика", 		Новый ОписаниеТипов("СправочникСсылка.ХарактеристикиНоменклатурыДляЦенообразования, СправочникСсылка.ХарактеристикиНоменклатуры"));
	ТаблицаДанныеРасчета.Колонки.Добавить("Количество", 			Новый ОписаниеТипов("Число"));
	ТаблицаДанныеРасчета.Колонки.Добавить("Комиссия", 				Новый ОписаниеТипов("Число"));
	ТаблицаДанныеРасчета.Колонки.Добавить("Хранение", 				Новый ОписаниеТипов("Число"));
	ТаблицаДанныеРасчета.Колонки.Добавить("Логистика", 				Новый ОписаниеТипов("Число"));
	ТаблицаДанныеРасчета.Колонки.Добавить("Штрафы", 				Новый ОписаниеТипов("Число")); 
	ТаблицаДанныеРасчета.Колонки.Добавить("ПрочиеРасходы", 			Новый ОписаниеТипов("Число"));
	ТаблицаДанныеРасчета.Колонки.Добавить("ЦенаПередачи", 			Новый ОписаниеТипов("Число"));
	ТаблицаДанныеРасчета.Колонки.Добавить("ЗакупочнаяЦена",			Новый ОписаниеТипов("Число"));
	ТаблицаДанныеРасчета.Колонки.Добавить("Себестоимость", 			Новый ОписаниеТипов("Число"));
	ТаблицаДанныеРасчета.Колонки.Добавить("МаржинальнаяПрибыль", 	Новый ОписаниеТипов("Число"));
	ТаблицаДанныеРасчета.Колонки.Добавить("МаржинальностьПроцент", 	Новый ОписаниеТипов("Число"));
	ТаблицаДанныеРасчета.Колонки.Добавить("Выручка", 				Новый ОписаниеТипов("Число"));

	Для Каждого Элемент Из WildBerriesТаблицаДанных Цикл
		
		НоваяСтрока = ТаблицаДанныеРасчета.Добавить();
		
		ЗаполнитьЗначенияСвойств(НоваяСтрока, Элемент);
		
	КонецЦикла;	
	
	МассивПараметров 				= ИС_WB_Сервер.ПолучитьСписокПараметровЦен();
	
	Результат 						= ИС_MP_Сервер.ПолучитьЗначениеНастроек(Профиль, Перечисления.ИС_МП_Маркетплейсы.ВБ, МассивПараметров);
	
	СтруктураЦен 					= ИС_WB_Сервер.ПолучитьСтруктуруПараметровЦен();
	
	ЗаполнитьЗначенияСвойств(СтруктураЦен, Результат);
	
	ВидЦеныЗакупочная 				= СтруктураЦен.ВидЦеныЗакупочная;
	
	ИспользуетсяЦенообразование25 	= Константы.ИспользуетсяЦенообразование25.Получить();
	
	РазделительЗапрос 				= ОбщегоНазначения.РазделительПакетаЗапросов();
	
	Запрос = Новый Запрос;
	
	Текст =
	"ВЫБРАТЬ
	|	ВТ_Данные.ЗаказМП КАК ЗаказМП,
	|	ВТ_Данные.РазмерWB КАК РазмерWB,
	|	ВТ_Данные.НоменклатураWB КАК НоменклатураWB,
	|	ВТ_Данные.Номенклатура КАК Номенклатура,
	|	ВТ_Данные.Характеристика КАК Характеристика,
	|	ВТ_Данные.Количество КАК Количество,
	|	ВТ_Данные.ЦенаПередачи КАК ЦенаПередачи,
	|	ВТ_Данные.Комиссия КАК Комиссия,
	|	ВТ_Данные.Логистика КАК Логистика,
	|	ВТ_Данные.Штрафы КАК Штрафы,
	|	ВТ_Данные.Хранение КАК Хранение,
	|	ВТ_Данные.ПрочиеРасходы КАК ПрочиеРасходы
	|ПОМЕСТИТЬ ВТ_ДанныеИтог
	|ИЗ
	|	&ТаблицаДанныеРасчета КАК ВТ_Данные
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_ДанныеИтог.ЗаказМП КАК ЗаказМП,
	|	ВТ_ДанныеИтог.РазмерWB КАК РазмерWB,
	|	ВТ_ДанныеИтог.НоменклатураWB КАК НоменклатураWB,
	|	ВТ_ДанныеИтог.Номенклатура КАК Номенклатура,
	|	ВТ_ДанныеИтог.Характеристика КАК Характеристика,
	|	ВТ_ДанныеИтог.Количество КАК Количество,
	|	ВТ_ДанныеИтог.ЦенаПередачи КАК ЦенаПередачи,
	|	ВТ_ДанныеИтог.Комиссия КАК Комиссия,
	|	ВТ_ДанныеИтог.Логистика КАК Логистика,
	|	ВТ_ДанныеИтог.Штрафы КАК Штрафы,
	|	ВТ_ДанныеИтог.Хранение КАК Хранение,
	|	ВТ_ДанныеИтог.ПрочиеРасходы КАК ПрочиеРасходы
	|ПОМЕСТИТЬ ВТ_ПоказателиОбъединение
	|ИЗ
	|	ВТ_ДанныеИтог КАК ВТ_ДанныеИтог";
	
	Если ИспользуетсяЦенообразование25 Тогда
		
		Текст = Текст + РазделительЗапрос +
		
		"ВЫБРАТЬ
		|	ЦеныНоменклатуры25.Номенклатура КАК Номенклатура,
		|	ЦеныНоменклатуры25.ХарактеристикаЦО КАК Характеристика,
		|	ЕСТЬNULL(ЦеныНоменклатуры25.Цена, 0) КАК Себестоимость
		|ПОМЕСТИТЬ ВТ_Себестоимость
		|ИЗ
		|	РегистрСведений.ЦеныНоменклатуры25.СрезПоследних(
		|			,
		|			ВидЦены = &ВидЦены
		|				И (Номенклатура, ХарактеристикаЦО) В
		|					(ВЫБРАТЬ
		|						ВТ.Номенклатура КАК Номенклатура,
		|						ВТ.Характеристика КАК ХарактеристикаЦО	
		|					ИЗ
		|						ВТ_ПоказателиОбъединение КАК ВТ)) КАК ЦеныНоменклатуры25";
		
		
	Иначе 
		
		Текст = Текст + РазделительЗапрос +
		
		"ВЫБРАТЬ
		|	ЦеныНоменклатуры.Номенклатура КАК Номенклатура,
		|	ЦеныНоменклатуры.Характеристика КАК Характеристика,
		|	ЕСТЬNULL(ЦеныНоменклатуры.Цена, 0) КАК Себестоимость
		|ПОМЕСТИТЬ ВТ_Себестоимость
		|ИЗ
		|	РегистрСведений.ЦеныНоменклатуры.СрезПоследних(
		|			,
		|			ВидЦены = &ВидЦены
		|				И (Номенклатура, Характеристика) В
		|					(ВЫБРАТЬ
		|						ВТ.Номенклатура КАК Номенклатура,
		|						ВТ.Характеристика КАК Характеристика
		|					ИЗ
		|						ВТ_ПоказателиОбъединение КАК ВТ)) КАК ЦеныНоменклатуры";
		
	КонецЕсли;

	Текст = Текст + РазделительЗапрос +
	
