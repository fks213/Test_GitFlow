&НаКлиенте
Процедура РасчетПоказетелейСтрокиНаКлиенте(Строка)

	Расходы = Строка.Комиссия + Строка.Логистика + Строка.Хранение + Строка.Штрафы + Строка.ПрочиеРасходы;
	Выручка = Строка.ЦенаПередачи * Строка.Количество;
	
	Строка.Себестоимость 		= Строка.ЗакупочнаяЦена + Расходы;
	Строка.Выручка 				= Выручка;
	Строка.МаржинальнаяПрибыль 	= Выручка - Строка.Себестоимость;
	
	Если Строка.ЦенаПередачи = 0 Тогда
		Строка.МаржинальностьПроцент = (Выручка - Расходы) / 100;
	ИначеЕсли Строка.Количество = 0 Тогда 
		Строка.МаржинальностьПроцент = (Выручка - Расходы) / 100;	
	Иначе
		Строка.МаржинальностьПроцент = (Выручка - Расходы) / Выручка * 100;
	КонецЕсли;

КонецПроцедуры //- ИнфоСофт Мурсалимов Д.Р. 17.03.25 УА #96130

