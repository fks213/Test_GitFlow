	ТаблицаДанныеЦенРасчета.Колонки.Добавить("РазмерWB", 			Новый ОписаниеТипов("СправочникСсылка.ИС_WB_РазмерыНоменклатур"));
	ТаблицаДанныеЦенРасчета.Колонки.Добавить("Номенклатура", 		Новый ОписаниеТипов("СправочникСсылка.Номенклатура"));			
	ТаблицаДанныеЦенРасчета.Колонки.Добавить("Характеристика", 		Новый ОписаниеТипов("СправочникСсылка.ХарактеристикиНоменклатурыДляЦенообразования, СправочникСсылка.ХарактеристикиНоменклатуры"));
	ТаблицаДанныеЦенРасчета.Колонки.Добавить("Количество", 			Новый ОписаниеТипов("Число"));
	ТаблицаДанныеЦенРасчета.Колонки.Добавить("ЦенаПередачи", 		Новый ОписаниеТипов("Число"));

	Для Каждого Элемент Из WildBerriesТаблицаДанных Цикл
		
		Если Элемент.Количество = 0 Тогда
			Продолжить;
		КонецЕсли;
		
		НоваяСтрока = ТаблицаДанныеЦенРасчета.Добавить();
		
		ЗаполнитьЗначенияСвойств(НоваяСтрока, Элемент);
		
	КонецЦикла;	

	Запрос = Новый Запрос;
	
	Запрос.Текст =
	
	"ВЫБРАТЬ
	|	ВТ_Данные.РазмерWB КАК РазмерWB,
	|	ВТ_Данные.НоменклатураWB КАК НоменклатураWB,
	|	ВТ_Данные.Номенклатура КАК Номенклатура,
	|	ВТ_Данные.Характеристика КАК Характеристика,
	|	ВТ_Данные.Количество КАК Количество,
	|	ВТ_Данные.ЦенаПередачи КАК ЦенаПередачи
	|ПОМЕСТИТЬ ВТ_ДанныеИтог
	|ИЗ
	|	&ТаблицаДанныеРасчета КАК ВТ_Данные
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_ДанныеИтог.РазмерWB КАК РазмерWB,
	|	ВТ_ДанныеИтог.НоменклатураWB КАК НоменклатураWB,
	|	ВТ_ДанныеИтог.Номенклатура КАК Номенклатура,
	|	ВТ_ДанныеИтог.Характеристика КАК Характеристика,
	|	ВТ_ДанныеИтог.Количество КАК Количество,
	|	ВТ_ДанныеИтог.ЦенаПередачи КАК ЦенаПередачи
	|ПОМЕСТИТЬ ВТ_Итог
	|ИЗ
	|	ВТ_ДанныеИтог КАК ВТ_ДанныеИтог
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_Итог.РазмерWB КАК РазмерWB,
	|	ВТ_Итог.НоменклатураWB КАК НоменклатураWB,
	|	ВТ_Итог.Номенклатура КАК Номенклатура,
	|	ВТ_Итог.Характеристика КАК Характеристика,
	|	ВТ_Итог.Количество КАК Количество,
	|	ВТ_Итог.ЦенаПередачи КАК ЦенаПередачи,
	|	NULL КАК ОбщееКоличество
	|ИЗ
	|	ВТ_Итог КАК ВТ_Итог
	|ИТОГИ
	|	КОЛИЧЕСТВО(ВТ_Итог.РазмерWB) КАК ОбщееКоличество 
	|ПО
	|	РазмерWB";
		
	Запрос.УстановитьПараметр("ТаблицаДанныеРасчета", ТаблицаДанныеЦенРасчета);
	
	Результат = Запрос.Выполнить();
	
	ВыборкаЦен = Результат.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);	
	
	Пока ВыборкаЦен.Следующий() Цикл
		
		ЦенаПередачи 	= 0;
		ОбщееКоличество = ВыборкаЦен.ОбщееКоличество;
		
		Выборка = ВыборкаЦен.Выбрать();
		
		Пока Выборка.Следующий() Цикл
			ЦенаПередачи = ЦенаПередачи + Выборка.ЦенаПередачи * Выборка.Количество;	
		КонецЦикла;
		
		ЦенаПередачи = ЦенаПередачи / ОбщееКоличество;
		
		Если ЦенаПередачи = 0 Тогда
			Продолжить;
		КонецЕсли;
		
		НайденныеСтроки = WildBerriesТаблицаДанных.НайтиСтроки(Новый Структура("РазмерWB", ВыборкаЦен.РазмерWB));
		
		Для Каждого Элемент Из НайденныеСтроки Цикл
			Элемент.ЦенаПередачи = ЦенаПередачи;	
		КонецЦикла;
		
	КонецЦикла;
	
КонецПроцедуры //- ИнфоСофт Мурсалимов Д.Р. 17.03.25 УА #96130

