//+ ИнфоСофт Мурсалимов Д.Р. 22.01.25 УА #67818
&НаСервереБезКонтекста
Функция ЗагрузитьДанныеХраненияНаСервере(Профиль, Период, УникальныйИдентификатор)
	
	ПараметрыВыполнения = ДлительныеОперации.ПараметрыВыполненияВФоне(УникальныйИдентификатор);
	
	ПараметрыВыполнения.ЗапуститьВФоне 		= Истина;
	ПараметрыВыполнения.ОжидатьЗавершение 	= 0;
	
	Возврат ДлительныеОперации.ВыполнитьФункцию(ПараметрыВыполнения, "ИС_WB_Сервер.СоздатьОтчетПлатногоХранения", Профиль, Период);
	
КонецФункции //- ИнфоСофт Мурсалимов Д.Р. 22.01.25 УА #67818

//+ ИнфоСофт Мурсалимов Д.Р. 22.01.25 УА #67818
&НаКлиенте
Процедура ЗагрузитьДанныеХраненияЗавершение(Результат, ДополнительныеПараметры) Экспорт
    
    Элементы[Маркетплейс + "КартинкаОжидание"].Видимость = Ложь;
	Элементы[Маркетплейс + "ЗагрузитьДанныеХранения"].Доступность = Истина;
    
    Если Результат = Неопределено Тогда  // отменено пользователем
		Возврат;
	КонецЕсли;
	
	Если Результат.Статус = "Ошибка" Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю(Результат.ПодробноеПредставлениеОшибки);	
	КонецЕсли;
	
	Если Результат.Сообщения.Количество() > 0 Тогда
		
		Для Каждого Элемент Из Результат.Сообщения Цикл
			ОбщегоНазначенияКлиент.СообщитьПользователю(Элемент.Текст);
		КонецЦикла;
		
	КонецЕсли; 
	
	ЗагрузитьДанныеПлатногоХранения(Результат.АдресРезультата); 
	
	УдалитьИзВременногоХранилища(Результат.АдресРезультата);
	
КонецПроцедуры //- ИнфоСофт Мурсалимов Д.Р. 22.01.25 УА #67818

//+ ИнфоСофт Мурсалимов Д.Р. 22.01.25 УА #67818
&НаСервере
Процедура ЗагрузитьДанныеПлатногоХранения(Знач Адрес)
	
	taskId = ПолучитьИзВременногоХранилища(Адрес);
	
	Результат = ИС_WB_Сервер.ЗагрузитьОтчетПлатногоХранения(Профиль, taskId);	
	
	Если Результат = Неопределено Тогда
		ОбщегоНазначения.СообщитьПользователю("Произошла ошибка при получении данных хранения. Повторите попытку.");
		Возврат;
	КонецЕсли;  
	
	ТаблицаДанныхХранения = Новый ТаблицаЗначений;
	
	ТаблицаДанныхХранения.Колонки.Добавить("РазмерWB", 			Новый ОписаниеТипов("СправочникСсылка.ИС_WB_РазмерыНоменклатур"));
	ТаблицаДанныхХранения.Колонки.Добавить("АртикулWB", 		Новый ОписаниеТипов("Число",,, Новый КвалификаторыЧисла(15,0)));
	ТаблицаДанныхХранения.Колонки.Добавить("Хранение", 			Новый ОписаниеТипов("Число",,, Новый КвалификаторыЧисла(15,2)));
	ТаблицаДанныхХранения.Колонки.Добавить("ДатаРасчета", 		Новый ОписаниеТипов("Дата",,));
	ТаблицаДанныхХранения.Колонки.Добавить("ДатаПерерасчета", 	Новый ОписаниеТипов("Дата",,));
	
	Для Каждого ЭлементРезультат Из Результат Цикл
		
		НоваяСтрока = ТаблицаДанныхХранения.Добавить();
		
		Если ЭлементРезультат.warehousePrice = 0 Тогда
			Продолжить;
		КонецЕсли;
		
		НоваяСтрока.РазмерWB 		= Справочники.ИС_WB_РазмерыНоменклатур.НайтиПоКоду(ЭлементРезультат.chrtId);
		НоваяСтрока.АртикулWB 		= ЭлементРезультат.nmId;
		НоваяСтрока.Хранение		= Окр(ЭлементРезультат.warehousePrice, 3, 0);
		НоваяСтрока.ДатаРасчета 	= ИС_MP_РаботаСHTTPЗапросамиСервер.ПрочитатьДатуИзJSON(ЭлементРезультат.date, ФорматДатыJSON.ISO);
		НоваяСтрока.ДатаПерерасчета = ИС_MP_РаботаСHTTPЗапросамиСервер.ПрочитатьДатуИзJSON(ЭлементРезультат.originalDate, ФорматДатыJSON.ISO);
		
	КонецЦикла; 
	
	День 			= 60 * 60 * 24;
	ДатаНачала 		= Период.ДатаНачала - День;
	ДатаОкончания 	= Период.ДатаОкончания - День;
	
	Запрос = Новый Запрос;
	
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ДанныеТЗ.РазмерWB КАК РазмерWB,
	|	ДанныеТЗ.АртикулWB КАК АртикулWB,
	|	ДанныеТЗ.Хранение КАК Хранение,
	|	ДанныеТЗ.ДатаРасчета КАК ДатаРасчета,
	|	ДанныеТЗ.ДатаПерерасчета КАК ДатаПерерасчета
	|ПОМЕСТИТЬ ВТ_Данные
	|ИЗ
	|	&ТаблицаДанных КАК ДанныеТЗ
	|ГДЕ
	|	ДанныеТЗ.ДатаПерерасчета МЕЖДУ &ДатаНачала И &ДатаОкончания
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_Данные.РазмерWB КАК РазмерWB,
	|	ВТ_Данные.АртикулWB КАК АртикулWB,
	|	ВТ_Данные.Хранение КАК Хранение
	|ПОМЕСТИТЬ ВТ_РасчетСумм
	|ИЗ
	|	ВТ_Данные КАК ВТ_Данные
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_СгруппированныеДанные.РазмерWB КАК РазмерWB,
	|	ВТ_СгруппированныеДанные.АртикулWB КАК АртикулWB,
	|	СУММА(ВТ_СгруппированныеДанные.Хранение) КАК Хранение
	|ПОМЕСТИТЬ ВТ_Итог
	|ИЗ
	|	ВТ_РасчетСумм КАК ВТ_СгруппированныеДанные
	|
	|СГРУППИРОВАТЬ ПО
	|	ВТ_СгруппированныеДанные.РазмерWB,
	|	ВТ_СгруппированныеДанные.АртикулWB
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_Итог.РазмерWB КАК РазмерWB,
	|	ВТ_Итог.АртикулWB КАК АртикулWB,
	|	ВТ_Итог.Хранение КАК Хранение
	|ИЗ
	|	ВТ_Итог КАК ВТ_Итог";
	
	Запрос.УстановитьПараметр("ТаблицаДанных", 	ТаблицаДанныхХранения);
	Запрос.УстановитьПараметр("ДатаНачала", 	ДатаНачала);
	Запрос.УстановитьПараметр("ДатаОкончания", 	ДатаОкончания);
	
	Хранение = Запрос.Выполнить().Выгрузить();
	
	ТаблицаДанныхХранения.Очистить();
	
	Для Каждого ЭлементХранения Из Хранение Цикл
		
		НоваяСтрока = ТаблицаДанныхХранения.Добавить();
		
		ЗаполнитьЗначенияСвойств(НоваяСтрока, ЭлементХранения);
		
	КонецЦикла;
	
	ТаблицаЗначенийРезультирующая = Новый ТаблицаЗначений; 
	
	ТаблицаЗначенийРезультирующая.Колонки.Добавить("НоменклатураWB", 	Новый ОписаниеТипов("СправочникСсылка.ИС_WB_Номенклатура"));			
	ТаблицаЗначенийРезультирующая.Колонки.Добавить("РазмерWB", 			Новый ОписаниеТипов("СправочникСсылка.ИС_WB_РазмерыНоменклатур"));
	ТаблицаЗначенийРезультирующая.Колонки.Добавить("Хранение", 			Новый ОписаниеТипов("Число",,, Новый КвалификаторыЧисла(15,2)));
	
	Для Каждого Элемент Из ТаблицаДанныхХранения Цикл
		
		НайденныеСтроки = WildBerriesТаблицаДанных.НайтиСтроки(Новый Структура("РазмерWB", Элемент.РазмерWB));
		
		Если НайденныеСтроки.Количество() = 0 Тогда
			
			НоваяСтрока = ТаблицаЗначенийРезультирующая.Добавить();
			
			НоваяСтрока.НоменклатураWB 	= Справочники.ИС_WB_Номенклатура.НайтиПоКоду(Элемент.АртикулWB);
			НоваяСтрока.РазмерWB 		= Элемент.РазмерWB;
			НоваяСтрока.Хранение 		= Элемент.Хранение;
			
			Продолжить;
			
		КонецЕсли;
		
		Для Каждого ЭлементДанных Из НайденныеСтроки Цикл
			
			ЭлементДанных.Хранение = Элемент.Хранение;
			
			Прервать;
			
		КонецЦикла;
		
	КонецЦикла;	 
	
	Для Каждого ЭлементРезультирующая Из ТаблицаЗначенийРезультирующая Цикл
		
		НоваяСтрока = WildBerriesТаблицаДанных.Добавить();
			
		ЗаполнитьЗначенияСвойств(НоваяСтрока, ЭлементРезультирующая);
		
	КонецЦикла;
	
	ПодобратьПоРазмеруНаСервере(WildBerriesТаблицаДанных);
	
	РасчетПоказателей();
	
КонецПроцедуры //- ИнфоСофт Мурсалимов Д.Р. 22.01.25 УА #67818

//+ ИнфоСофт Мурсалимов Д.Р. 22.01.25 УА #67818
&НаСервере
Процедура ЗагрузитьОтчетКомисисонераПоApiНаСервере()
	
	Попытка
	
		ДатаНачала 		= НачалоДня(Период.ДатаНачала);
		ДатаОкончания 	= КонецДня(Период.ДатаОкончания);
		
		ДанныеОК		= ИС_WB_Сервер.ПолучитьДанныеОтчетаКомиссионераApi(Профиль, ДатаНачала, ДатаОкончания); 
		
		Если ДанныеОК.Таблица.Количество() = 0 Тогда
			ОбщегоНазначения.СообщитьПользователю("Нет данных для обработки.");
			Возврат;
		КонецЕсли;
		
		НомерРФ = 0;
		
		Если ДанныеОК.Свойство("НомерРФ") Тогда
			НомерРФ = ДанныеОК.НомерРФ;
		КонецЕсли;
		
		Запрос = Новый Запрос;
		
		Запрос.Текст = ИС_WB_Сервер.ПолучитьТекстЗапросаОтчетаКомиссионера();
		
		Запрос.УстановитьПараметр("ДанныеТЗ", 	ДанныеОК.Таблица);
		Запрос.УстановитьПараметр("Профиль", 	Профиль);
		
		РезультатЗапроса = Запрос.Выполнить();
		
		ДанныеДляДокумента = РезультатЗапроса.Выгрузить(); 
		
		ДанныеДляДокумента = ПодобратьПоАртикулуНаСервере(ДанныеДляДокумента);
		
		WildBerriesТаблицаДанных.Очистить();
		
		Для Каждого Элемент Из ДанныеДляДокумента Цикл
			
			НоваяСтрока = WildBerriesТаблицаДанных.Добавить();
			
			ЗаполнитьЗначенияСвойств(НоваяСтрока, Элемент);
			
			НоваяСтрока.НоменклатураWB 	= Справочники.ИС_WB_Номенклатура.НайтиПоКоду(Элемент.АртикулWB);
				
		КонецЦикла;
	
	Исключение
	 	ОбщегоНазначения.СообщитьПользователю(ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;	
	
КонецПроцедуры //- ИнфоСофт Мурсалимов Д.Р. 22.01.25 УА #67818

