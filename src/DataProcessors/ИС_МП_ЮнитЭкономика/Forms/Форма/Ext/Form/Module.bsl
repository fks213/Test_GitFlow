&НаКлиенте
Процедура ЗагрузитьДанныеОК(Команда)
	
	Если Не ЗначениеЗаполнено(Профиль) Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю("Не выбран профиль.", , , "Профиль");
		Возврат;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(Период) Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю("Не выбран период загрузки.", , , "ПериодДляЗагрузки");
		Возврат;
	КонецЕсли;
	
	ЗагрузитьОтчетКомисисонераПоApiНаСервере();
	
	РасчетСреднейВзвешеннойЦеныНаСервере();
	
	СгруппироватьДанныеНаСервере();
	
КонецПроцедуры //- ИнфоСофт Мурсалимов Д.Р. 22.01.25 УА #67818

//+ ИнфоСофт Мурсалимов Д.Р. 22.01.25 УА #67818
&НаКлиенте
Процедура ЗагрузитьДанныеХранения(Команда)
	
	Если Не ЗначениеЗаполнено(Профиль) Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю("Не выбран профиль.", , , "Профиль");
		Возврат;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(Период) Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю("Не выбран период загрузки.", , , "ПериодДляЗагрузки");
		Возврат;
	КонецЕсли;
	
	ДлительнаяОперация = ЗагрузитьДанныеХраненияНаСервере(Профиль, Период, УникальныйИдентификатор);
	
	ОповещениеОЗавершении = Новый ОписаниеОповещения("ЗагрузитьДанныеХраненияЗавершение", ЭтотОбъект);
	ДлительныеОперацииКлиент.ОжидатьЗавершение(ДлительнаяОперация, ОповещениеОЗавершении, ПараметрыОжидания());
	
	Элементы[Маркетплейс + "КартинкаОжидание"].Видимость 			= Истина;
	
	Элементы[Маркетплейс + "ЗагрузитьДанныеХранения"].Доступность 	= Ложь;
	
КонецПроцедуры //- ИнфоСофт Мурсалимов Д.Р. 22.01.25 УА #67818

