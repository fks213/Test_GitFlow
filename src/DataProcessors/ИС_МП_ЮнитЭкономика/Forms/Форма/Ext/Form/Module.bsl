		Выручка = НоваяСтрока.ЦенаПередачи * НоваяСтрока.Количество;
		
		НоваяСтрока.Себестоимость 			= НоваяСтрока.ЗакупочнаяЦена + Расходы;
		НоваяСтрока.Выручка 				= Выручка;
		НоваяСтрока.МаржинальнаяПрибыль 	= Выручка - НоваяСтрока.Себестоимость;
		
		Если НоваяСтрока.ЦенаПередачи = 0 Тогда
			НоваяСтрока.МаржинальностьПроцент = (Выручка - Расходы) / 100;
		ИначеЕсли НоваяСтрока.Количество = 0 Тогда 
			НоваяСтрока.МаржинальностьПроцент = (Выручка - Расходы) / 100;	
		Иначе
			НоваяСтрока.МаржинальностьПроцент = (Выручка - Расходы) / Выручка * 100;
		КонецЕсли;
		
	КонецЦикла;
	
