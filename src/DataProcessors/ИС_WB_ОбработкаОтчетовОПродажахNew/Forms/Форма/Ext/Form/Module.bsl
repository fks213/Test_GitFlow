//+ ИнфоСофт Власова И.С. 08.04.25 УА #78061
&НаСервере
Процедура СоздатьВзаимозачетНаСервере()
	
	ДанныеОтчета = ПолучитьДанныеОтчетаКомиссионера(НомерОтчета);
	
	Если ДанныеОтчета = Неопределено Тогда
		ОбщегоНазначения.СообщитьПользователю(НСтр("ru = 'Ошибка получения данных по отчету'"));
		Возврат;
	КонецЕсли;
	
	Если Не ДанныеОтчета.ВидОтчета = Перечисления.ИС_WB_ВидыОтчетов.Российский Тогда
		ОбщегоНазначения.СообщитьПользователю(НСтр("ru = 'Функциональность создания взаимозачета доступна для отчетов по продажам в РФ'"),,,"НомерОтчета");
		Возврат;
	КонецЕсли;
	
	ДокументыДебитор  = Новый Массив;
	ДокументыДебитор.Добавить(ОтчетКомиссионера);
	
	ДокументыКредитор = Новый Массив;
	ДокументыКредитор.Добавить(ДокументПриобретения);
	
	Для Каждого Элемент Из ДанныеОтчета.Документы Цикл
		
		Если ТипЗнч(Элемент.Документ) = Тип(ИС_МП_СерверЛокализация.СтрокаТипСписаниеЗадолженности()) Тогда
			
			ХозяйственнаяОперация = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Элемент.Документ, "ХозяйственнаяОперация");
			
			Если ХозяйственнаяОперация = ИС_МП_СерверЛокализация.ХозяйственнаяОперацияСписаниеДебиторскойЗадолженности() Тогда
				ДокументыКредитор.Добавить(Элемент.Документ);
			ИначеЕсли ХозяйственнаяОперация = ИС_МП_СерверЛокализация.ХозяйственнаяОперацияСписаниеКредиторскойЗадолженности() Тогда	
				ДокументыКредитор.Добавить(Элемент.Документ);
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЦикла;
	
	ДанныеДокумента = ИС_WB_Сервер.ЗаполнитьДанныеВзаимозачетЗадолженности(Профиль, ДокументыДебитор, ДокументыКредитор);
	
	ДанныеДокумента.Дата        = КонецДня(ДанныеОтчета.ДатаОкончания);
	ДанныеДокумента.Комментарий = ДанныеОтчета.Наименование;
	
	ДокументВзаимозачет = ИС_WB_Сервер.СоздатьИзменитьВзаимозачетЗадолженности(Профиль, ДанныеДокумента);
	
	Если ДокументВзаимозачет <> Неопределено Тогда
		
		СформированныеДокументы.Добавить().Документ = ДокументВзаимозачет;
		
		ДобавитьДокументКОтчетуОПродажах(НомерОтчета, ДокументВзаимозачет);
		
	КонецЕсли;
	
КонецПроцедуры //- ИнфоСофт Власова И.С. 08.04.25 УА #78061

//+ ИнфоСофт Власова И.С. 08.04.25 УА #78061
&НаСервереБезКонтекста
Функция ПолучитьДанныеОтчетаКомиссионера(НомерОтчетаСсылка)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ИС_WB_НомерацияОтчетовОПродажах.ВидОтчета КАК ВидОтчета,
		|	ИС_WB_НомерацияОтчетовОПродажах.ДатаНачала КАК ДатаНачала,
		|	ИС_WB_НомерацияОтчетовОПродажах.ДатаОкончания КАК ДатаОкончания,
		|	ИС_WB_НомерацияОтчетовОПродажах.Наименование КАК Наименование,
		|	ИС_WB_НомерацияОтчетовОПродажах.Документы.(
		|		Ссылка КАК Ссылка,
		|		НомерСтроки КАК НомерСтроки,
		|		Документ КАК Документ
		|	) КАК Документы
		|ИЗ
		|	Справочник.ИС_WB_НомерацияОтчетовОПродажах КАК ИС_WB_НомерацияОтчетовОПродажах
		|ГДЕ
		|	ИС_WB_НомерацияОтчетовОПродажах.Ссылка = &НомерОтчета";
	
	Запрос.УстановитьПараметр("НомерОтчета", НомерОтчетаСсылка);
	
	ДанныеОтчета = Запрос.Выполнить().Выгрузить();
	
	Если ДанныеОтчета.Количество() > 0 Тогда
		Возврат ДанныеОтчета[0];
	Иначе	
		Возврат Неопределено;
	КонецЕсли;
	
КонецФункции //- ИнфоСофт Власова И.С. 08.04.25 УА #78061

