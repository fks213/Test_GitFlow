&НаСерверебезКонтекста
Функция ПолучитьТаблицуЗначенийДанныхПродаж(Номер, Таблица)
	
	Отбор = Новый Структура();
	Отбор.Вставить("Номер", Номер);
	
	ДанныеТЗ = Таблица.Скопировать(Отбор);
	
	Возврат ДанныеТЗ;
	
