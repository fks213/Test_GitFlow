	|		ПО ИС_WB_НомерацияОтчетовОПродажахДополнительнаяИнформация.Услуга.Наименование = ИС_WB_НаименованиеУслугИзОтчетаWildberries.НаименованиеУслугиИзОтчета
	//- ИнфоСофт Мурсалимов Д.Р. 27.05.24 УА #76549
	|ГДЕ
	|	ИС_WB_НомерацияОтчетовОПродажахДополнительнаяИнформация.Ссылка = &Ссылка
	|	И НЕ ИС_WB_НаименованиеУслугИзОтчетаWildberries.ПометкаУдаления
	//+ ИнфоСофт Мурсалимов Д.Р. 27.05.24 УА #76549
	//|	И (ИС_WB_НомерацияОтчетовОПродажахДополнительнаяИнформация.Наименование = ""Сумма вознаграждения Вайлдберриз за текущий период (ВВ), без НДС""
	//|			ИЛИ ИС_WB_НомерацияОтчетовОПродажахДополнительнаяИнформация.Наименование = ""Стоимость услуг Вайлдберриз по организации международной перевозки""
	//|			ИЛИ ИС_WB_НомерацияОтчетовОПродажахДополнительнаяИнформация.Наименование = ""Возмещение расходов поверенного""
	//|			ИЛИ ИС_WB_НомерацияОтчетовОПродажахДополнительнаяИнформация.Наименование = ""Штрафы согласно договору"")";
	|	И (ИС_WB_НомерацияОтчетовОПродажахДополнительнаяИнформация.Услуга.Наименование = ""Сумма вознаграждения Вайлдберриз за текущий период (ВВ), без НДС""
	|			ИЛИ ИС_WB_НомерацияОтчетовОПродажахДополнительнаяИнформация.Услуга.Наименование = ""Стоимость услуг Вайлдберриз по организации международной перевозки""
	|			ИЛИ ИС_WB_НомерацияОтчетовОПродажахДополнительнаяИнформация.Услуга.Наименование = ""Возмещение расходов поверенного""
	|			ИЛИ ИС_WB_НомерацияОтчетовОПродажахДополнительнаяИнформация.Услуга.Наименование = ""Возмещение издержек по эквайрингу""
	|			ИЛИ ИС_WB_НомерацияОтчетовОПродажахДополнительнаяИнформация.Услуга.Наименование = ""Штрафы""
	//+ ИнфоСофт Стояк Ю.К. 24.06.2024 УА #78086	
	|			ИЛИ ИС_WB_НомерацияОтчетовОПродажахДополнительнаяИнформация.Услуга.Наименование = ""НДС с вознаграждения Вайлдберриз"" 
	//- ИнфоСофт Стояк Ю.К. 24.06.2024 УА #78086
	|			ИЛИ ИС_WB_НомерацияОтчетовОПродажахДополнительнаяИнформация.Услуга.Наименование = ""Прочие удержания""
	|			ИЛИ ИС_WB_НомерацияОтчетовОПродажахДополнительнаяИнформация.Услуга.Наименование = ""Штрафы согласно договору"")";
	//- ИнфоСофт Мурсалимов Д.Р. 27.05.24 УА #76549
	
	Запрос.УстановитьПараметр("Ссылка", НомерОтчета);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Выборка = РезультатЗапроса.Выбрать();
	
	СуммаУслуг = 0;
	
	Выборка.Следующий();
	
	Если ЗначениеЗаполнено(Выборка.Сумма) И Выборка.Сумма > 0 Тогда
		СуммаУслуг = Выборка.Сумма;	
