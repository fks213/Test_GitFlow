//+ ИнфоСофт Власова И.С. 14.03.25 УА #68471
&НаСервере
Процедура СоздатьДокументПриобретенияНаСервере() 
	
	ДопПараметры = Новый Структура;
	
	СуммаОтрицательныхУслуг = 0;
	
	МассивСтрокПоложительныхУслуг = Новый Массив;
	
	Для Каждого Строка Из ОтражениеУслугWildberries Цикл	
		
		Если Строка.Сумма < 0 Тогда	
			СуммаОтрицательныхУслуг = СуммаОтрицательныхУслуг + Строка.Сумма;
		ИначеЕсли Строка.Сумма > 0 Тогда	
			МассивСтрокПоложительныхУслуг.Добавить(Строка);
		КонецЕсли;	
		
	КонецЦикла;
	
	Если СуммаОтрицательныхУслуг < 0 Тогда
		
		Маркетплейс = Перечисления.ИС_МП_Маркетплейсы.ВБ;
		
		МассивПараметров = Новый Массив;
		МассивПараметров.Добавить("СтатьяДоходовОтрицательноеВознаграждение");
		
		Настройки = ИС_МП_Сервер.ПолучитьЗначениеНастроек(Профиль, Маркетплейс, МассивПараметров);
		
		СтатьяДоходовОтрицательноеВознаграждение = ПланыВидовХарактеристик.СтатьиДоходов.ПустаяСсылка();
		
		Если Не Настройки = Неопределено Тогда
			
			Если Не Настройки["СтатьяДоходовОтрицательноеВознаграждение"] = Неопределено Тогда
				СтатьяДоходовОтрицательноеВознаграждение = Настройки["СтатьяДоходовОтрицательноеВознаграждение"];
			КонецЕсли;
			
		КонецЕсли;
		
		ДанныеДокумента = ИС_WB_Сервер.ПолучитьСтруктуруКорректировкиЗадолженности(); 
		
		РеквизитыПрофиля = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Профиль,
			"Организация, Контрагент, Партнер, Договор, Соглашение");
		
		ДанныеДокумента.Дата                  = КонецДня(НомерОтчета.ДатаОкончания);
		ДанныеДокумента.Комментарий           = НомерОтчета.Наименование;	
		ДанныеДокумента.Организация           = РеквизитыПрофиля.Организация;
	    ДанныеДокумента.Контрагент            = РеквизитыПрофиля.Контрагент;
	    ДанныеДокумента.Договор               = РеквизитыПрофиля.Договор;
		ДанныеДокумента.Соглашение            = РеквизитыПрофиля.Соглашение;
		ДанныеДокумента.ХозяйственнаяОперация = ИС_WB_СерверУТ11_5.ПолучитьХозОперациюСписаниеКредиторскойЗадолженности(); 
		
		ДанныеДокумента.КорреспонденцияСДоходами = Истина;
		
		СтрокаЗадолженность = ДанныеДокумента.Задолженность.Добавить();
		СтрокаЗадолженность.ТипРасчетов = ИС_WB_СерверУТ11_5.ПолучитьТипРасчетовСПартнерамиРасчетыСКлиентом();
		СтрокаЗадолженность.Партнер     = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Профиль, "Партнер");
		СтрокаЗадолженность.Сумма       = -СуммаОтрицательныхУслуг;
		
		СтрокаДоходыРасходыАктивыПассивы = ДанныеДокумента.ДоходыРасходыАктивыПассивы.Добавить();
		СтрокаДоходыРасходыАктивыПассивы.Статья        = СтатьяДоходовОтрицательноеВознаграждение;
		СтрокаДоходыРасходыАктивыПассивы.Подразделение = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Профиль, "Подразделение");
		СтрокаДоходыРасходыАктивыПассивы.Сумма         = -СуммаОтрицательныхУслуг;
		
		ДокументМинусовыхУслуг = ИС_WB_Сервер.СоздатьИзменитьКорректировкуЗадолженности(Профиль, ДанныеДокумента, ДопПараметры);
		
		Если Не ДокументМинусовыхУслуг = Неопределено Тогда
			
			СформированныеДокументы.Добавить().Документ = ДокументМинусовыхУслуг;
			
			ДобавитьДокументКОтчетуОПродажах(НомерОтчета, ДокументМинусовыхУслуг);
			
		КонецЕсли;
		
	КонецЕсли;	
	
	Если Не МассивСтрокПоложительныхУслуг.Количество() = 0 Тогда
		
		ДанныеДокумента = Новый Структура;
		
		ДанныеДокумента.Вставить("ДатаДокумента", КонецДня(НомерОтчета.ДатаОкончания));
		ДанныеДокумента.Вставить("Комментарий",   НомерОтчета.Наименование);
		
		ДокументПриобретения = ИС_WB_Сервер.СоздатьДокументПриобретения(Профиль, МассивСтрокПоложительныхУслуг, ДанныеДокумента);
		
		Если Не ДокументПриобретения = Неопределено Тогда
			
			СформированныеДокументы.Добавить().Документ = ДокументПриобретения;
			
			ДобавитьДокументКОтчетуОПродажах(НомерОтчета, ДокументПриобретения);
				
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры //- ИнфоСофт Власова И.С. 14.03.25 УА #68471

//+ ИнфоСофт Макарова Н.Е. 10.04.2025 УА #76491
&НаСервере
Функция ПолучитьДанныеНомераОтчета(НомерОтчета)
	
	ОтветСтруктура = Новый Структура;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	ИС_WB_НомерацияОтчетовОПродажахДокументы.Документ КАК Документ
	|ИЗ
	|	Справочник.ИС_WB_НомерацияОтчетовОПродажах.Документы КАК ИС_WB_НомерацияОтчетовОПродажахДокументы
	|ГДЕ
	|	ИС_WB_НомерацияОтчетовОПродажахДокументы.Ссылка = &Ссылка
	|	И НЕ ВЫРАЗИТЬ(ИС_WB_НомерацияОтчетовОПродажахДокументы.Документ КАК Документ.ОтчетКомиссионера).ПометкаУдаления
	|	И ИС_WB_НомерацияОтчетовОПродажахДокументы.Документ ССЫЛКА Документ.ОтчетКомиссионера";
	
	Запрос.УстановитьПараметр("Ссылка", НомерОтчета);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Если Не РезультатЗапроса.Пустой() Тогда
		
		ОтветСтруктура.Вставить("ЕстьОтчетКомиссионера", Истина);
		
	Иначе
		
		ОтветСтруктура.Вставить("ЕстьОтчетКомиссионера", Ложь);
		
	КонецЕсли;
	
	ОтветСтруктура.Вставить("ПометкаУдаления", НомерОтчета.ПометкаУдаления);
	
	Возврат ОтветСтруктура;
	
КонецФункции //- ИнфоСофт Макарова Н.Е. 10.04.2025 УА #76491

