	Если НомерОтчета.ВидОтчета <> Перечисления.ИС_WB_ВидыОтчетов.Российский Тогда
		ОбщегоНазначения.СообщитьПользователю(НСтр("ru = 'Обработка услуг доступна для отчетов по подажам в РФ'"),,,"НомерОтчета");
		Возврат;
	КонецЕсли;

	//+ ИнфоСофт Власова И.С. 21.08.24 УА #61503
