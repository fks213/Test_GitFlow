&НаСервере
Функция ПолучитьТабДок(ТипФайла, АдресВоВременномХранилище)
	
	Если ТипФайла = "Отчет" Тогда
		
		Если РасширениеИтоговогоФайлаZip Тогда  
			
			ФайлВременногоХранилища = ПолучитьИзВременногоХранилища(АдресВоВременномХранилище);
			Имя = ПолучитьИмяВременногоФайла("zip");
			ФайлВременногоХранилища.Записать(Имя);
			
			ВызватьОшибку = Истина;
			ТабличныйДокумент = ПрочитатьТабДокИзZIP(Имя, ВызватьОшибку);
			
			Если ВызватьОшибку Тогда
				ОбщегоНазначения.СообщитьПользователю(ПодробноеПредставлениеОшибки(ИнформацияОбОшибке())); 
				Возврат Неопределено;
			КонецЕсли;
			
		Иначе     
			
			ФайлВременногоХранилища = ПолучитьИзВременногоХранилища(АдресВоВременномХранилище);
			Имя = ПолучитьИмяВременногоФайла("xlsx");
			ФайлВременногоХранилища.Записать(Имя);
			ТабличныйДокумент = Новый ТабличныйДокумент;
			ТабличныйДокумент.Прочитать(Имя);
			
		КонецЕсли;
		
		ТабличныйДокумент.Область().Разъединить();
		
		Попытка
			УдалитьФайлы(Имя);
		Исключение
			ОбщегоНазначения.СообщитьПользователю(ПодробноеПредставлениеОшибки(ИнформацияОбОшибке())); 
			ОтменитьТранзакцию();
		КонецПопытки;  
		
	КонецЕсли;
	
	Если ТипФайла = "Детализация" Тогда
		
		Если РасширениеДетализацииФайлаZip Тогда  
			
			ФайлВременногоХранилища = ПолучитьИзВременногоХранилища(АдресВоВременномХранилище);
			Имя = ПолучитьИмяВременногоФайла("zip");
			ФайлВременногоХранилища.Записать(Имя);
			
			ВызватьОшибку = Истина;
			ТабличныйДокумент = ПрочитатьТабДокИзZIP(Имя, ВызватьОшибку);
			
			Если ВызватьОшибку Тогда
				ОбщегоНазначения.СообщитьПользователю(ПодробноеПредставлениеОшибки(ИнформацияОбОшибке())); 
				Возврат Неопределено;
			КонецЕсли;
			
		Иначе     
			
			ФайлВременногоХранилища = ПолучитьИзВременногоХранилища(АдресВоВременномХранилище);
			Имя = ПолучитьИмяВременногоФайла("xlsx");
			ФайлВременногоХранилища.Записать(Имя);
			ТабличныйДокумент = Новый ТабличныйДокумент;
			ТабличныйДокумент.Прочитать(Имя);
			
		КонецЕсли;
		
		ТабличныйДокумент.Область().Разъединить();
		
		Попытка
			УдалитьФайлы(Имя);
		Исключение
			ОбщегоНазначения.СообщитьПользователю(ПодробноеПредставлениеОшибки(ИнформацияОбОшибке())); 
			ОтменитьТранзакцию();
		КонецПопытки;  
			
	КонецЕсли; 
	
	Возврат ТабличныйДокумент;
	
КонецФункции //- ИнфоСофт Мурсалимов Д.Р. 30.05.24 УА #76699

//+ ИнфоСофт Сумин Д.В. 27.02.2024 УА #71107
&НаСервере
Функция ПрочитатьТабДокИзZIP(ИмяФайла, Отказ)
		
	ТабличныйДокумент = Новый ТабличныйДокумент;
	
	ЧтениеZip = Новый ЧтениеZipФайла(ИмяФайла, "");
	
	Отказ = Истина;
	
	Для Каждого Элемент Из ЧтениеZip.Элементы Цикл
		
		Если Элемент.Расширение = "xlsx" Тогда
			Отказ = Ложь;
			ПутьКФайлуВоВременномКаталоге = КаталогВременныхФайлов();
			ЧтениеZip.Извлечь(Элемент, ПутьКФайлуВоВременномКаталоге, , "");					
			ПутьКФайлуВоВременномКаталоге = ПутьКФайлуВоВременномКаталоге + Элемент.Имя; 
			ТабличныйДокумент.Прочитать(ПутьКФайлуВоВременномКаталоге);
		КонецЕсли;
		
	КонецЦикла; 
	
	ЧтениеZip.Закрыть();
	
	Возврат ТабличныйДокумент;
	
КонецФункции //- ИнфоСофт Сумин Д.В. 27.02.2024 УА #71107 

//+ ИнфоСофт Сумин Д.В. 27.02.2024 УА #71107
&НаСервере
Функция ОбработатьДанныеНаСервере()
	
	//+ ИнфоСофт Сумин Д.В. 14.03.2024 УА #71773
	Если НастройкаОтчета = 0 Тогда
		
		//Обработка итогового файла
		ИтоговыйФайлТабдок = ПолучитьТабДок("Отчет", АдресИтоговогоФайлаВоВременномХранилище);
		
		Если ИтоговыйФайлТабдок.НайтиТекст("Уведомление") <> Неопределено Тогда
			РоссийскиеПродажи = Ложь;
		ИначеЕсли ИтоговыйФайлТабдок.НайтиТекст("Отчет") <> Неопределено Тогда
			РоссийскиеПродажи = Истина;
		Иначе
			РоссийскиеПродажи = Неопределено;
		КонецЕсли;	
		
		Если РоссийскиеПродажи = Неопределено Тогда
			ОбщегоНазначения.СообщитьПользователю("Выбран некорректный формат файла",,,"ПутьИтоговыйФайл");
			Возврат Неопределено;
		КонецЕсли;
		Если РоссийскиеПродажи Тогда		
			Комментарий = ИтоговыйФайлТабдок.Область("R5C6").Текст;
			НомерДата = ИтоговыйФайлТабдок.Область("R5C7").Текст;
			НачалоПериода = ИтоговыйФайлТабдок.Область("R7C12").Текст;
			КонецПериода = ИтоговыйФайлТабдок.Область("R7C14").Текст;  
			ИскомыйНомер = СтрНайти(НомерДата, "от");
			
			НомерОтчетаСтрока = СтроковыеФункцииКлиентСервер.СтрокаВЧисло(Лев(НомерДата, ИскомыйНомер - 1));
			Комментарий = Комментарий + НомерДата;      
			НачалоПериода = СтроковыеФункцииКлиентСервер.СтрокаВДату(СтрЗаменить(НачалоПериода, "-", ""));
			КонецПериода = КонецДня(СтроковыеФункцииКлиентСервер.СтрокаВДату(СтрЗаменить(КонецПериода, "-", "")));
			ДанныеУслуг = ПолучитьДанныеПоУслугам(ИтоговыйФайлТабдок);
			
			Если ДанныеУслуг = Неопределено Тогда
				Возврат Неопределено;
			КонецЕсли;	
		Иначе
			Комментарий = ИтоговыйФайлТабдок.Область("R3C1").Текст;
			
			ИскомыйНомерНачало = СтрНайти(Комментарий, "№");
			ИскомыйНомерКонец = СтрНайти(Комментарий, "от");
			
			НомерОтчетаСтрока = СтроковыеФункцииКлиентСервер.СтрокаВЧисло(Сред(Комментарий, ИскомыйНомерНачало + 1, СтрДлина(Комментарий) - ИскомыйНомерКонец - 3));
			НачалоПериода = СтроковыеФункцииКлиентСервер.СтрокаВДату(СтрЗаменить(СтрРазделить(Комментарий, " ")[5], ".", ""));
			КонецПериода = КонецДня(СтроковыеФункцииКлиентСервер.СтрокаВДату(СтрЗаменить(СтрРазделить(Комментарий, " ")[5], ".", "")) + 3600 *24 * 7);
		КонецЕсли;
	Иначе
		НомерОтчетаСтрока = НомерОтчета.НомерОтчета;
		Комментарий = НомерОтчета.Наименование;
		НачалоПериода = НомерОтчета.ДатаНачала;
		КонецПериода = НомерОтчета.ДатаОкончания; 
		Если НомерОтчета.ВидОтчета = Перечисления.ИС_WB_ВидыОтчетов.Российский Тогда
			РоссийскиеПродажи = Истина;
		Иначе
			РоссийскиеПродажи = Ложь;
		КонецЕсли;
	КонецЕсли;
	//- ИнфоСофт Сумин Д.В. 14.03.2024 УА #71773
	ДанныеОтчета = Новый Структура;
	ДанныеОтчета.Вставить("НомерОтчета",        НомерОтчетаСтрока);
	ДанныеОтчета.Вставить("Комментарий",        Комментарий);
	ДанныеОтчета.Вставить("НачалоПериода",      НачалоПериода);
	ДанныеОтчета.Вставить("КонецПериода",       КонецПериода);
	ДанныеОтчета.Вставить("РоссийскиеПродажи",  РоссийскиеПродажи);
	
	СтруктураДанных = Новый Структура;
	СтруктураДанных.Вставить("ДанныеОтчета", ДанныеОтчета);
	
	//Обработка файла детализации
	ДетализацияТабдок = ПолучитьТабДок("Детализация", АдресДетализацииФайлаВоВременномХранилище);
	
	Если ДетализацияТабдок.Области.Количество() > 1 Тогда
		Если Не РоссийскиеПродажи Тогда
			ДанныеУслуг = ПолучитьДанныеПоУслугамИнПродаж(ДетализацияТабдок.ПолучитьОбласть("Сводный"));
			Если ДанныеУслуг = Неопределено Тогда
				Возврат Неопределено;
			КонецЕсли;	
		КонецЕсли;
		
