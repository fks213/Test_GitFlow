	////|	ИС_WB_НомерацияОтчетовОПродажахДополнительнаяИнформация.Наименование = ""НДС с вознаграждения Вайлдберриз""
	//|	ИС_WB_НомерацияОтчетовОПродажахДополнительнаяИнформация.Услуга.Наименование = ""НДС с вознаграждения Вайлдберриз""
	////- ИнфоСофт Мурсалимов Д.Р. 27.05.24 УА #76549
	//|	И ИС_WB_НомерацияОтчетовОПродажахДополнительнаяИнформация.Ссылка = &Ссылка";
	//- ИнфоСофт Власова И.С. 26.08.24 УА #82315
	
	Запрос.УстановитьПараметр("Ссылка", НомерОтчета);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Выборка = РезультатЗапроса.Выбрать();
	
	Пока Выборка.Следующий() Цикл
		НоваяСтрока = ОтражениеУслугWildberries.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, Выборка);
	КонецЦикла;
	
КонецПроцедуры //- ИнфоСофт Сумин Д.В. 04.03.2024 УА #71107

