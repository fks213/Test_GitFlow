		СтруктураДанных.Вставить("Соглашение", 							Профиль.Соглашение);
		СтруктураДанных.Вставить("Договор", 							Профиль.Договор);
		//+ ИнфоСофт Стояк Ю.К. 01.07.2024 УА #78655
		СтруктураДанных.Вставить("Подразделение", 						Профиль.Подразделение);
		//- ИнфоСофт Стояк Ю.К. 01.07.2024 УА #78655
		//+ ИнфоСофт Тимофеева А.А. 07.04.2025 УА #85500
		СтруктураДанных.Вставить("ОснованиеДляПФ", 						Строка(НомерОтчета.Наименование));
		//- ИнфоСофт Тимофеева А.А. 07.04.2025 УА #85500		
		
		//Обработать полученные данные в фоновом режиме
		ВыполняемыйМетод = "ИС_WB_СерверУТ11_5.ОбработатьИностранныеПродажи";
		ПараметрыПроцедуры = Новый Структура;
		ПараметрыПроцедуры.Вставить("СтруктураДанных", СтруктураДанных);
		ПараметрыВыполнения = ДлительныеОперации.ПараметрыВыполненияВФоне(УникальныйИдентификатор);
		ПараметрыВыполнения.НаименованиеФоновогоЗадания = НСтр("ru = 'Создание документа'");
		ПараметрыВыполнения.ЗапуститьВФоне = Истина;
		ПараметрыВыполнения.Вставить("ИдентификаторФормы", УникальныйИдентификатор); 	
	КонецЕсли;
	
	Возврат ДлительныеОперации.ВыполнитьФункцию(УникальныйИдентификатор, ВыполняемыйМетод, ПараметрыПроцедуры);
	
КонецФункции //- ИнфоСофт Сумин Д.В. 27.02.2024 УА #71107

//+ ИнфоСофт Мурсалимов Д.Р. 05.09.24 УА #82005
&НаСервере
Процедура ПодобратьПоАртикулуНаСервере()
	
	ТЗРезультирующая = Новый ТаблицаЗначений;
	
	ТЗРезультирующая.Колонки.Добавить("Артикул", Новый ОписаниеТипов("Строка", , Новый КвалификаторыСтроки(50)));
	ТЗРезультирующая.Колонки.Добавить("Размер", Новый ОписаниеТипов("Строка", , Новый КвалификаторыСтроки(50)));
		
	ТаблицаСопоставления = СписокТранзакций;  
		
	Для Каждого Строка Из ТаблицаСопоставления Цикл
		
		Если Не ЗначениеЗаполнено(Строка.Номенклатура) Тогда
			
			НоваяСтрока = ТЗРезультирующая.Добавить();
			
			//+ ИнфоСофт Конышев А.Е. 21.11.24 УА #87938
			НоваяСтрока.Артикул = Строка.АртикулПоставщика;
			НоваяСтрока.Размер = Строка.Размер; 
			//- ИнфоСофт Конышев А.Е. 21.11.24 УА #87938
			
		КонецЕсли;	
		
	КонецЦикла;
	
	ТЗРезультирующая.Свернуть("Артикул, Размер");
	
	Если ТЗРезультирующая.Количество() = 0 Тогда		
		ОбщегоНазначения.СообщитьПользователю("Нет данных для обработки!"); 
		Возврат;		
	КонецЕсли;
		
	Запрос = Новый Запрос;
	
	Запрос.Текст = 	
	"ВЫБРАТЬ
	|	ДанныеТЗ.Артикул КАК Артикул,
	|	ДанныеТЗ.Размер КАК Размер
	|ПОМЕСТИТЬ ВТ_ДанныеТЗ
	|ИЗ
	|	&ТЗРезультирующая КАК ДанныеТЗ
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ИС_WB_Номенклатура.Ссылка КАК Ссылка,
	|	ВТ_ДанныеТЗ.Артикул КАК Артикул,
	|	ВТ_ДанныеТЗ.Размер КАК Размер
	|ПОМЕСТИТЬ ВТ_Номенклатура
	|ИЗ
	|	Справочник.ИС_WB_Номенклатура КАК ИС_WB_Номенклатура
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_ДанныеТЗ КАК ВТ_ДанныеТЗ
	|		ПО ИС_WB_Номенклатура.vendorCode = ВТ_ДанныеТЗ.Артикул
	|ГДЕ
	|	ИС_WB_Номенклатура.Профиль = &Профиль
	|	И НЕ ВТ_ДанныеТЗ.Размер ЕСТЬ NULL
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_Номенклатура.Ссылка КАК НоменклатураWB,
	|	ВТ_Номенклатура.Артикул КАК Артикул,
	|	ВЫБОР
	|		КОГДА КОЛИЧЕСТВО(ИС_WB_РазмерыНоменклатур.techSize) > 1
	|			ТОГДА ВТ_Номенклатура.Размер
	|		ИНАЧЕ ИС_WB_РазмерыНоменклатур.techSize
	|	КОНЕЦ КАК Размер
	|ПОМЕСТИТЬ ВТ_РазмерНоменклатуры
	|ИЗ
	|	ВТ_Номенклатура КАК ВТ_Номенклатура
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ИС_WB_РазмерыНоменклатур КАК ИС_WB_РазмерыНоменклатур
	|		ПО (ИС_WB_РазмерыНоменклатур.Владелец = ВТ_Номенклатура.Ссылка)
	|			И (ИС_WB_РазмерыНоменклатур.Профиль = &Профиль)
	|
	|СГРУППИРОВАТЬ ПО
	|	ВТ_Номенклатура.Ссылка,
	|	ИС_WB_РазмерыНоменклатур.techSize,
	|	ВТ_Номенклатура.Размер,
	|	ВТ_Номенклатура.Артикул
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ 
	|	ВТ_РазмерНоменклатуры.Артикул КАК Артикул, 
	|	ВТ_РазмерНоменклатуры.Размер КАК Размер,
	|	ИС_WB_СоответствиеРазмеров.Номенклатура КАК Номенклатура,
	|	ЕСТЬNULL(ИС_WB_СоответствиеРазмеров.Характеристика, ЗНАЧЕНИЕ(Справочник.ХарактеристикиНоменклатуры.ПустаяСсылка)) КАК Характеристика,
	|	ВЫБОР
	|		КОГДА ИС_WB_СоответствиеРазмеров.Номенклатура.ТипНоменклатуры = ЗНАЧЕНИЕ(Перечисление.ТипыНоменклатуры.Набор)
	|			ТОГДА ИСТИНА
	|		ИНАЧЕ ЛОЖЬ
	|	КОНЕЦ КАК ЭтоНабор,
	|	ИС_WB_СоответствиеРазмеров.Упаковка КАК Упаковка,
	|	ВЫБОР
	|		КОГДА ИС_WB_СоответствиеРазмеров.Упаковка ЕСТЬ NULL ИЛИ ИС_WB_СоответствиеРазмеров.Упаковка.Числитель = 0
	|			ТОГДА 1
	|		ИНАЧЕ ИС_WB_СоответствиеРазмеров.Упаковка.Числитель
	|	КОНЕЦ / ВЫБОР
	|		КОГДА ИС_WB_СоответствиеРазмеров.Упаковка ЕСТЬ NULL ИЛИ ИС_WB_СоответствиеРазмеров.Упаковка.Знаменатель = 0
	|			ТОГДА 1
	|		ИНАЧЕ ИС_WB_СоответствиеРазмеров.Упаковка.Знаменатель
	|	КОНЕЦ КАК КоэффициентУпаковки
	|ПОМЕСТИТЬ ВТ_Результирующая
	|ИЗ
	|	ВТ_РазмерНоменклатуры КАК ВТ_РазмерНоменклатуры
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ИС_WB_РазмерыНоменклатур КАК ИС_WB_РазмерыНоменклатур
	|		ПО ВТ_РазмерНоменклатуры.НоменклатураWB = ИС_WB_РазмерыНоменклатур.Владелец
	|			И ВТ_РазмерНоменклатуры.Размер = ИС_WB_РазмерыНоменклатур.techSize
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ИС_WB_СоответствиеРазмеров КАК ИС_WB_СоответствиеРазмеров
	|		ПО (ИС_WB_РазмерыНоменклатур.Ссылка = ИС_WB_СоответствиеРазмеров.РазмерWB)
	|			И (ИС_WB_СоответствиеРазмеров.Профиль = &Профиль)
	|ГДЕ
	|	ИС_WB_РазмерыНоменклатур.Профиль = &Профиль
	|	И НЕ ИС_WB_РазмерыНоменклатур.ПометкаУдаления
	|	И НЕ ИС_WB_СоответствиеРазмеров.Номенклатура ЕСТЬ NULL
	|;
	|
	|//////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_Результирующая.Номенклатура КАК Номенклатура,
	|	ВТ_Результирующая.Характеристика КАК Характеристика, 
	|	ВТ_Результирующая.Артикул КАК АртикулПоставщика,   
	|	ВТ_Результирующая.Размер КАК Размер,
	|	ВТ_Результирующая.ЭтоНабор КАК ЭтоНабор,
	|	ВТ_Результирующая.Упаковка КАК Упаковка,
	|	ВТ_Результирующая.КоэффициентУпаковки КАК КоэффициентУпаковки
	|ИЗ
	|	ВТ_Результирующая КАК ВТ_Результирующая";
	
	Запрос.УстановитьПараметр("Профиль", 			Профиль);
	Запрос.УстановитьПараметр("ТЗРезультирующая", 	ТЗРезультирующая);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Выборка = РезультатЗапроса.Выбрать();
	
	Пока Выборка.Следующий() Цикл
		
		НайденныеСтроки = ТаблицаСопоставления.НайтиСтроки(Новый Структура("АртикулПоставщика", Выборка.АртикулПоставщика));
		
		Для Каждого Элемент Из НайденныеСтроки Цикл
			
			Если Не ЗначениеЗаполнено(Элемент.Номенклатура) Тогда
				
				ЗаполнитьЗначенияСвойств(Элемент, Выборка, "Номенклатура,Характеристика,Упаковка,КоэффициентУпаковки,ЭтоНабор,Размер");   
					
				Элемент.КоэффициентУпаковки = Выборка.КоэффициентУпаковки; 
					
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЦикла;
	
	СписокТранзакций.Сортировать("Номенклатура");
		
КонецПроцедуры //- ИнфоСофт Мурсалимов Д.Р. 05.09.24 УА #82005

