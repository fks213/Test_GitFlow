&НаКлиенте
Процедура ПутьДетализацияНачалоВыбора(Элемент, ДанныеВыбора, ВыборДобавлением, СтандартнаяОбработка)
	
	РасширениеДетализацииФайлаZip = Ложь;
	
	ПоказатьДиалогВыбораФайла("РасширениеДетализацииФайлаZip", "АдресДетализацииФайлаВоВременномХранилище", "ПутьДетализация");
	
КонецПроцедуры //- ИнфоСофт Сумин Д.В. 26.02.2024 УА #71107 

//+ ИнфоСофт Сумин Д.В. 26.02.2024 УА #71107
&НаКлиенте
Процедура ПоказатьДиалогВыбораФайла(РасширениеФайла, АдресВоВременномХранилище, ИмяРеквизита) 
	
	ОчиститьСообщения(); 
	  	
	ДиалогВыбораФайла = Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.Открытие);
	ДиалогВыбораФайла.Заголовок = "Выберите файл отчета/уведомления о выкупе";
	ДиалогВыбораФайла.МножественныйВыбор =  Ложь;
	ДиалогВыбораФайла.ПроверятьСуществованиеФайла = Истина;
	ДиалогВыбораФайла.Фильтр = "Архив ZIP (*.zip)|*.zip|Excel файлы(*.xls;*.xlsx)|*.xls;*.xlsx";
	
	ДополнительныеПараметры = Новый Структура;
	ДополнительныеПараметры.Вставить("Реквизит", ИмяРеквизита);
	ДополнительныеПараметры.Вставить("Адрес", АдресВоВременномХранилище);  
	ДополнительныеПараметры.Вставить("ЭтоZip", РасширениеФайла);
	ДополнительныеПараметры.Вставить("ДиалогВыбораФайла", ДиалогВыбораФайла);
	
	ДиалогВыбораФайла.Показать(Новый ОписаниеОповещения("ПутьИтоговыйФайлНачалоВыбораЗавершение", ЭтотОбъект, ДополнительныеПараметры));
	
КонецПроцедуры //- ИнфоСофт Сумин Д.В. 26.02.2024 УА #71107	

