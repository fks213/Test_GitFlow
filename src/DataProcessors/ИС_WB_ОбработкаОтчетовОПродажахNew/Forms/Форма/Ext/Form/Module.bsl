&НаСервере
Функция ПолучитьДанныеПоУслугамИнПродаж(ТабличныйДокумент) 
	
	МассивУслуг = Новый Массив;
	
	Для НомерСтроки = 2 По ТабличныйДокумент.ВысотаТаблицы Цикл	
		
		Если ТабличныйДокумент.Область("R" + НомерСтроки + "C3").Текст = "К клиенту при продаже" Тогда
			СтруктураУслуг = Новый Структура;
			Попытка
				СтруктураУслуг.Вставить("Наименование", "Услуги по доставке товара покупателю (Сумма)");
				СтруктураУслуг.Вставить("ОбоснованиеДляОплаты", "К клиенту при продаже");
				СуммаПродажи = СтроковыеФункцииКлиентСервер.СтрокаВЧисло(ТабличныйДокумент.Область("R" + НомерСтроки + "C5").Текст);
				Если СуммаПродажи = Неопределено Тогда
					СуммаПродажи = 0;	
				КонецЕсли;	
				СтруктураУслуг.Вставить("Сумма", СуммаПродажи);
			Исключение
				Возврат Неопределено;	
			КонецПопытки;
			
			МассивУслуг.Добавить(СтруктураУслуг);
		КонецЕсли;		
	КонецЦикла;
	
	Возврат МассивУслуг;
	
