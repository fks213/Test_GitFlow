&НаСервере
Функция ПолучитьДанныеПоУслугам(ТабличныйДокумент)
	
	МассивУслуг = Новый Массив;
	
	Для НомерСтроки = 21 По ТабличныйДокумент.ВысотаТаблицы Цикл
		
		Если ТабличныйДокумент.Область("R" + НомерСтроки + "C3").Текст = "" Тогда
			Прервать;	
		КонецЕсли;	
		
		СтруктураУслуг = Новый Структура;
		Попытка
			СтруктураУслуг.Вставить("Наименование", ТабличныйДокумент.Область("R" + НомерСтроки + "C3").Текст);
			СтруктураУслуг.Вставить("Сумма", Число(ТабличныйДокумент.Область("R" + НомерСтроки + "C13").Текст));
		Исключение
			Возврат Неопределено;	
		КонецПопытки;
		
		МассивУслуг.Добавить(СтруктураУслуг);
				
	КонецЦикла;
	
	Возврат МассивУслуг;

