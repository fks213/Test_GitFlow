//+ ИнфоСофт Сумин Д.В. 04.03.2024 УА #71107
&НаКлиенте
Процедура СоздатьДокументПриобретения(Команда)   
	
	ОчиститьСообщения(); 
	
	Если ОтражениеУслугWildberries.Количество() < 1 Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю(НСтр("ru = 'Необходимо заполнить услуги по отчету'"));
		Возврат;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(НомерОтчета) Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю(НСтр("ru = 'Необходимо выбрать обрабатываемый отчет'"),,,"НомерОтчета");
	    Возврат;
	КонецЕсли; 
	
	Если Не ЗначениеЗаполнено(Профиль) Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю(НСтр("ru = 'Необходимо выбрать профиль'"),,,"Профиль");
		Возврат;	
	КонецЕсли;
	
	СоздатьДокументПриобретенияНаСервере();
	
	ОбщегоНазначенияКлиент.СообщитьПользователю(НСтр("ru = 'Операция завершена'"));
	
КонецПроцедуры //- ИнфоСофт Сумин Д.В. 04.03.2024 УА #71107

//+ ИнфоСофт Сумин Д.В. 06.03.2024 УА #71107
&НаКлиенте
Процедура СоздатьВзаимозачет(Команда)
	
