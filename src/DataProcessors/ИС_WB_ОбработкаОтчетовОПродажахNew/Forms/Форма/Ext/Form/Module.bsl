//+ ИнфоСофт Сумин Д.В. 26.02.2024 УА #71107
&НаКлиенте
Процедура ОбработатьДанные(Команда)
	
	ОчиститьСообщения();
	
	Если Не ЗначениеЗаполнено(Профиль) Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю(НСтр("ru = 'Необходимо выбрать профиль'"),,,"Профиль");
		Возврат;
	КонецЕсли;
	
	//+ ИнфоСофт Сумин Д.В. 14.03.2024 УА #71773
	Если НастройкаОтчета = 0 Тогда
		Если Не ЗначениеЗаполнено(ПутьИтоговыйФайл) Тогда
			ОбщегоНазначенияКлиент.СообщитьПользователю(НСтр("ru = 'Необходимо выбрать файл excel'"),,,"ПутьИтоговыйФайл");
			Возврат;
		КонецЕсли;
	Иначе
		Если Не ЗначениеЗаполнено(НомерОтчета) Тогда
			ОбщегоНазначенияКлиент.СообщитьПользователю(НСтр("ru = 'Необходимо выбрать обрабатываемый отчет'"),,,"НомерОтчета");
			Возврат;
		КонецЕсли;	
	КонецЕсли;    
	//- ИнфоСофт Сумин Д.В. 14.03.2024 УА #71773
	
	Если Не ЗначениеЗаполнено(ПутьДетализация) Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю(НСтр("ru = 'Необходимо выбрать файл excel'"),,,"ПутьДетализация");
		Возврат;
	КонецЕсли;
	
	ДлительнаяОперация = ОбработатьДанныеНаСервере();
	
	Если ДлительнаяОперация <> Неопределено Тогда	 
		ПараметрыОжидания = ДлительныеОперацииКлиент.ПараметрыОжидания(ЭтотОбъект);
		ПараметрыОжидания.ВыводитьОкноОжидания = Истина;
		ПараметрыОжидания.ВыводитьПрогрессВыполнения = Ложь;
		ПараметрыОжидания.ТекстСообщения = "Чтение и обработка данных...";
		ОповещениеОЗавершении = Новый ОписаниеОповещения("ОбработатьДанныеЗавершение", ЭтотОбъект);
		ДлительныеОперацииКлиент.ОжидатьЗавершение(ДлительнаяОперация, ОповещениеОЗавершении, ПараметрыОжидания);
	Иначе
		ОбщегоНазначенияКлиент.СообщитьПользователю(НСтр("ru = 'Проверьте корректность выбранных excel файлов'"));
	КонецЕсли;
КонецПроцедуры //- ИнфоСофт Сумин Д.В. 26.02.2024 УА #71107

//+ ИнфоСофт Сумин Д.В. 26.02.2024 УА #71107
&НаКлиенте
