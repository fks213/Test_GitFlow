//+ ИнфоСофт Сумин Д.В. 29.02.2024 УА #71107
&НаКлиенте
Процедура СоздатьОтчетКомиссионера(Команда)
	
	ОчиститьСообщения();
	
	Если Не ЗначениеЗаполнено(Профиль) Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю(НСтр("ru = 'Необходимо выбрать профиль'"),,,"Профиль");
		Возврат;	
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(НомерОтчета) Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю(НСтр("ru = 'Необходимо выбрать обрабатываемый отчет. Вернитесь на страницу ""Данные продаж""'"));
		Возврат;	
	КонецЕсли;

	
	Если СписокТранзакций.Количество() = 0 Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю(НСтр("ru = 'Необходимо выбрать обрабатываемый отчет и заполнить таблицу продаж. Вернитесь на пункт ""Данные продаж""'"));
		Возврат;	
	КонецЕсли;
	
	Если ВариантФормированияЦеныВозврата = 1 И Не ЗначениеЗаполнено(ВидЦеныВозврата) Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю(НСтр("ru = 'Необходимо выбрать вид цены или выбрать другой вариант формирования стоимости передачи товара на комиссию'")
																	,,,"ВариантФормированияЦеныВозврата");
		Возврат;	
	КонецЕсли;	
	
	//+ ИнфоСофт Макарова Н.Е. 10.04.2025 УА #76491
	ДанныеНомераОтчета = ПолучитьДанныеНомераОтчета(НомерОтчета);
	
	Если ДанныеНомераОтчета.ПометкаУдаления Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю(НСтр("ru = 'Необходимо выбрать обрабатываемый отчет, который не помечен на удаление. Вернитесь на страницу ""Данные продаж""'"));
		Возврат;	
	КонецЕсли;
	
	Если ДанныеНомераОтчета.ЕстьОтчетКомиссионера И НЕ ПерезаписатьИмеющийсяОК Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю(НСтр("ru = 'Отчет комиссионера по данному номеру отчета уже создан. Чтобы перезаписать существующий документ, в настройках укажите ""Перезаписать имеющийся отчет комиссионера""'"));
		Возврат;	
	КонецЕсли;
	//- ИнфоСофт Макарова Н.Е. 10.04.2025 УА #76491
	
	ДлительнаяОперация = ПолучитьОтчетКомиссионераНаСервере(); 
	
	Если ДлительнаяОперация <> Неопределено Тогда	 
		ПараметрыОжидания = ДлительныеОперацииКлиент.ПараметрыОжидания(ЭтотОбъект);
		ПараметрыОжидания.ВыводитьОкноОжидания = Истина;
		ПараметрыОжидания.ВыводитьПрогрессВыполнения = Ложь;
		ПараметрыОжидания.ТекстСообщения = "Чтение и обработка данных...";
		ОповещениеОЗавершении = Новый ОписаниеОповещения("ОбработатьДанныеЗавершение", ЭтотОбъект);
		ДлительныеОперацииКлиент.ОжидатьЗавершение(ДлительнаяОперация, ОповещениеОЗавершении, ПараметрыОжидания);
	Иначе
		//+ ИнфоСофт Власова И.С. 26.08.24 УА #81190
		//ОбщегоНазначенияКлиент.СообщитьПользователю(НСтр("ru = 'Произошла непредвиденная ошибка'"));
		ОбщегоНазначенияКлиент.СообщитьПользователю(НСтр("ru = 'Произошла непредвиденная ошибка. Проверьте настройки профиля'"));
		//- ИнфоСофт Власова И.С. 26.08.24 УА #81190
	КонецЕсли;
	
КонецПроцедуры //- ИнфоСофт Сумин Д.В. 29.02.2024 УА #71107

//+ ИнфоСофт Сумин Д.В. 04.03.2024 УА #71107
&НаКлиенте
Процедура ЗаполнитьУслугиПоОтчету(Команда)
	
	ОчиститьСообщения();
	
	//+ ИнфоСофт Власова И.С. 26.08.24 УА #81190
	ОтражениеУслугWildberries.Очистить();
	//- ИнфоСофт Власова И.С. 26.08.24 УА #81190
	
	Если Не ЗначениеЗаполнено(НомерОтчета) Тогда
