 	КонецЕсли;
КонецПроцедуры //- ИнфоСофт Сумин Д.В. 27.02.2024 УА #71107

//+ ИнфоСофт Сумин Д.В. 27.02.2024 УА #71107
&НаСервере
Процедура ДлительныеОперацииЗавершениеНаСервере(АдресХранилища)
	
	Результат = ПолучитьИзВременногоХранилища(АдресХранилища);  
	
	Если Результат = Неопределено Тогда
		
		//+ ИнфоСофт Заварин К.В. 27.09.24 УА #73673
		//ОбщегоНазначения.СообщитьПользователю(ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		ОбщегоНазначения.СообщитьПользователю(ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()) + ". Попробуйте использовать изначальный обработанный отчет."); 
		//- ИнфоСофт Заварин К.В. 27.09.24 УА #73673
		
		//+ ИнфоСофт Сумин Д.В. 14.05.2024 УА #75591
		Возврат;
        //- ИнфоСофт Сумин Д.В. 14.05.2024 УА #75591
	КонецЕсли;
	
	//+ ИнфоСофт Сумин Д.В. 15.03.2024 УА #71773
	Если Результат.НомерСТраницы = 1 Тогда
		
		НомерОтчета = Справочники.ИС_WB_НомерацияОтчетовОПродажах.ПустаяСсылка();
		
	ИначеЕсли Результат.НомерСтраницы = 2 Тогда
		
		СписокТранзакций.Загрузить(Результат.СписокТранзакций);
		
	ИначеЕсли Результат.НомерСтраницы = 3 Тогда
		
		Для Каждого Документ Из Результат.МассивДокументов Цикл
			
			НоваяСтрока = СформированныеДокументы.Добавить();
			НоваяСтрока.Документ = Документ;
			
			Если ТипЗнч(Документ) = Тип("ДокументСсылка.ОтчетКомиссионера") Тогда
				ОтчетКомиссионера = Документ.Ссылка;
				
				//+ ИнфоСофт Макарова Н.Е. 10.04.2025 УА #76491
				СтрОК = НомерОтчета.Документы.Найти(ОтчетКомиссионера, "Документ");
				
				Если СтрОК <> Неопределено Тогда
					
					Продолжить;
					
				КонецЕсли;
				//- ИнфоСофт Макарова Н.Е. 10.04.2025 УА #76491
				
			КонецЕсли;
			
			//+ ИнфоСофт Власова И.С. 26.08.24 УА #81190
			//ДобавитьДокументКОтчетуОПроджах(НомерОтчета, Документ);
			ДобавитьДокументКОтчетуОПродажах(НомерОтчета, Документ);
			//- ИнфоСофт Власова И.С. 26.08.24 УА #81190
			
		КонецЦикла;
		
	КонецЕсли;	
	//- ИнфоСофт Сумин Д.В. 15.03.2024 УА #71773
	
КонецПроцедуры //- ИнфоСофт Сумин Д.В. 27.02.2024 УА #71107	

//+ ИнфоСофт Власова И.С. 26.08.24 УА #81190
&НаСервере
Процедура ДобавитьДокументКОтчетуОПродажах(НомерОтчетаВБ, Документ)
	
	НомерОтчетаОбъект = НомерОтчетаВБ.ПолучитьОбъект();
	НомерОтчетаОбъект.Документы.Добавить().Документ = Документ;
	НомерОтчетаОбъект.Записать();
	
КонецПроцедуры //- ИнфоСофт Власова И.С. 26.08.24 УА #81190	

&НаКлиенте
Процедура ДобавитьНоменклатуру(Команда)
	Для Каждого Элемент Из СписокТранзакций Цикл
		Если Не ЗначениеЗаполнено(Элемент.Номенклатура) Тогда
			Элемент.Номенклатура = Номенклатура;	
		КонецЕсли;	
	КонецЦикла;	
КонецПроцедуры

//+ ИнфоСофт Мурсалимов Д.Р. 28.02.25 УА #74987
&НаСервере
Процедура ЗагрузитьОтчетКомисисонераПоApiНаСервере()
	
	Попытка
	
		ДатаНачала 		= НачалоДня(Период.ДатаНачала);
		ДатаОкончания 	= КонецДня(Период.ДатаОкончания);
		
		ДанныеОК		= ИС_WB_Сервер.ПолучитьДанныеОК(Профиль, ДатаНачала, ДатаОкончания); 
		
		Если ДанныеОК.Таблица.Количество() = 0 Тогда
			ОбщегоНазначения.СообщитьПользователю("Нет данных для обработки.");
			Возврат;
		КонецЕсли;
		
		НомерРФ = 0;
		
		Если ДанныеОК.Свойство("НомерРФ") Тогда
			НомерРФ = ДанныеОК.НомерРФ;
		КонецЕсли;
		
		ДанныеОтчетаКомиссионера = ПолучитьТаблицуЗначенийДанныхПродаж(НомерРФ, ДанныеОК.Таблица); 
		
		Запрос = Новый Запрос;
		
		Запрос.Текст = ИС_WB_Сервер.ПолучитьТекстЗапросаОК();
		
		Запрос.УстановитьПараметр("Профиль", 	Профиль);
		Запрос.УстановитьПараметр("ДанныеТЗ", 	ДанныеОтчетаКомиссионера);	
		
		РезультатЗапроса = Запрос.Выполнить();
		
		ДанныеДляДокумента = РезультатЗапроса.Выгрузить(); 
		
		ДанныеДляДокумента = ПодобратьПоАртикулуApiНаСервере(ДанныеДляДокумента);
		
		Если ДанныеДляДокумента = Неопределено Тогда
			Возврат;
		КонецЕсли;
		
		Комментарий = "Отчет Вайлдберриз №" + Строка(НомерРФ) + " от " + Формат(ДатаОкончания, "ДФ=dd.MM.yyyy");
		
		МассивПараметров = Новый Массив;
		
		МассивПараметров.Добавить("WildBerriesСтатьяЗадолженности");
		
		Настройки = ИС_MP_Сервер.ПолучитьНастройки(Профиль, МассивПараметров);
		
		СтатьяЗадолженности = ПланыВидовХарактеристик.СтатьиРасходов.ПустаяСсылка();
		
		Если Настройки <> Неопределено Тогда
			
			Если Настройки["WildBerriesСтатьяЗадолженности"] <> Неопределено Тогда
				СтатьяЗадолженности = Настройки["WildBerriesСтатьяЗадолженности"];       
			КонецЕсли;
			
		КонецЕсли;
		
		ЗаголовокСтруктура = Новый Структура;
		
		ЗаголовокСтруктура.Вставить("ДатаДокумента", 		Период.ДатаНачала);
		ЗаголовокСтруктура.Вставить("Комментарий", 			Комментарий);
		ЗаголовокСтруктура.Вставить("НачалоПериода", 		Период.ДатаНачала);
		ЗаголовокСтруктура.Вставить("КонецПериода", 		Период.ДатаОкончания);  
		
		ДанныеВВ = Новый Структура;  
		ДанныеВВ.Вставить("РассчитыватьВВ", Ложь);
		
		ЗаголовокСтруктура.Вставить("ДанныеВВ", 			ДанныеВВ);
		
		МассивПараметров = Новый Массив;
		
		МассивПараметров.Добавить("WildBerriesСтатьяЗадолженности");
		
		Настройки = ИС_MP_Сервер.ПолучитьНастройки(Профиль, МассивПараметров);
		
		СтатьяЗадолженности = ПланыВидовХарактеристик.СтатьиРасходов.ПустаяСсылка();
		
		Если Настройки <> Неопределено Тогда
			
			Если Настройки["WildBerriesСтатьяЗадолженности"] <> Неопределено Тогда
				СтатьяЗадолженности = Настройки["WildBerriesСтатьяЗадолженности"];       
			КонецЕсли;
			
		КонецЕсли;
		
		ЗаголовокСтруктура.Вставить("СтатьяЗадолженности",	СтатьяЗадолженности);
		
		СтруктураДанных = Новый Структура;
	
		СтруктураДанных.Вставить("СтатьяЗадолженности",						СтатьяЗадолженности);
		СтруктураДанных.Вставить("ТаблицаПродаж",							ДанныеДляДокумента);
		СтруктураДанных.Вставить("РассчитатьКомиссионноеВознаграждение",	Ложь);
		СтруктураДанных.Вставить("ВариантСозданияОтчета", 					Ложь);
		СтруктураДанных.Вставить("ВариантФормированияЦеныВозврата", 		ВариантФормированияЦеныВозврата); 	
		СтруктураДанных.Вставить("ВидЦеныВозврата", 						Справочники.ВидыЦен.ПустаяСсылка());
		СтруктураДанных.Вставить("НомерОтчета", 							НомерРФ);
		СтруктураДанных.Вставить("Профиль", 								Профиль);
		СтруктураДанных.Вставить("Партнер", 								Профиль.Партнер);
		СтруктураДанных.Вставить("Контрагент", 								Профиль.Контрагент);
		СтруктураДанных.Вставить("Организация", 							Профиль.Организация); 
		СтруктураДанных.Вставить("Соглашение", 								Профиль.Соглашение);
		СтруктураДанных.Вставить("Договор", 								Профиль.Договор);
		СтруктураДанных.Вставить("Подразделение", 							Профиль.Подразделение);
		СтруктураДанных.Вставить("ДатаНачала", 								Период.ДатаНачала);
		СтруктураДанных.Вставить("ДатаОкончания", 							Период.ДатаОкончания);
		СтруктураДанных.Вставить("ДатаВходящегоДокумента", 					Период.ДатаНачала);
		СтруктураДанных.Вставить("НомерВходящегоДокумента", 				НомерРФ);
		СтруктураДанных.Вставить("Комментарий", 							Комментарий);
		
		//Создание документа отчет комиссионера о продажах		
		ОтчетКомиссионера = ИС_WB_СерверУТ11_5.СоздатьДокументОтчетКомиссионераNew(СтруктураДанных);
		ДобавитьДокументВРезультирующуюТЧ(ОтчетКомиссионера.Ссылка);
			
		//Создание документа корректировки задолженности по браку
		Взаимозачет = Неопределено;
		
		Если ДанныеОК.Брак > 0 Тогда
			Взаимозачет = ИС_WB_СерверУТ11_5.ПолучитьДокументКорректировкиЗадолженности(ЗаголовокСтруктура, ОтчетКомиссионера.Ссылка, ДанныеОК.Брак);
			ДобавитьДокументВРезультирующуюТЧ(Взаимозачет.Ссылка);
		КонецЕсли;      
		
		ОбщегоНазначения.СообщитьПользователю("Документы созданы. Перейдите, пожалуйста, на вкладку Созданные документы.");
	
	Исключение
	 	ОбщегоНазначения.СообщитьПользователю(ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;	
	
КонецПроцедуры //- ИнфоСофт Мурсалимов Д.Р. 28.02.25 УА #74987

//+ ИнфоСофт Мурсалимов Д.Р. 28.02.25 УА #74987
&НаСервере
Функция ПодобратьПоАртикулуApiНаСервере(СписокТранзакций)
	
	ТЗРезультирующая = Новый ТаблицаЗначений;
	
	ТЗРезультирующая.Колонки.Добавить("Артикул", 			Новый ОписаниеТипов("Строка", , Новый КвалификаторыСтроки(50)));
	ТЗРезультирующая.Колонки.Добавить("РазмерПоставщика", 	Новый ОписаниеТипов("Строка", , Новый КвалификаторыСтроки(50)));
		
	ТаблицаСопоставления = СписокТранзакций;  
		
	Для Каждого Строка Из ТаблицаСопоставления Цикл
		
		Если Не ЗначениеЗаполнено(Строка.Номенклатура) Тогда
			
			НоваяСтрока = ТЗРезультирующая.Добавить();
			
			ЗаполнитьЗначенияСвойств(НоваяСтрока, Строка);
			
		КонецЕсли;	
		
	КонецЦикла;
	
	ТЗРезультирующая.Свернуть("Артикул, РазмерПоставщика");
	
	Если ТЗРезультирующая.Количество() = 0 Тогда		
		Возврат ТаблицаСопоставления;		
	КонецЕсли;
		
	Запрос = Новый Запрос;
	
	Запрос.Текст = 	
	"ВЫБРАТЬ
	|	ДанныеТЗ.Артикул КАК Артикул,
	|	ДанныеТЗ.РазмерПоставщика КАК Размер
	|ПОМЕСТИТЬ ВТ_ДанныеТЗ
	|ИЗ
	|	&ТЗРезультирующая КАК ДанныеТЗ
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ИС_WB_Номенклатура.Ссылка КАК Ссылка,
	|	ВТ_ДанныеТЗ.Артикул КАК Артикул,
	|	ВТ_ДанныеТЗ.Размер КАК Размер
	|ПОМЕСТИТЬ ВТ_Номенклатура
	|ИЗ
	|	Справочник.ИС_WB_Номенклатура КАК ИС_WB_Номенклатура
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_ДанныеТЗ КАК ВТ_ДанныеТЗ
	|		ПО ИС_WB_Номенклатура.vendorCode = ВТ_ДанныеТЗ.Артикул
	|ГДЕ
	|	ИС_WB_Номенклатура.Профиль = &Профиль
	|	И НЕ ВТ_ДанныеТЗ.Размер ЕСТЬ NULL
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_Номенклатура.Ссылка КАК НоменклатураWB,
	|	ВТ_Номенклатура.Артикул КАК Артикул,
	|	ВЫБОР
	|		КОГДА КОЛИЧЕСТВО(ИС_WB_РазмерыНоменклатур.techSize) > 1
	|			ТОГДА ВТ_Номенклатура.Размер
	|		ИНАЧЕ ИС_WB_РазмерыНоменклатур.techSize
	|	КОНЕЦ КАК Размер
	|ПОМЕСТИТЬ ВТ_РазмерНоменклатуры
	|ИЗ
	|	ВТ_Номенклатура КАК ВТ_Номенклатура
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ИС_WB_РазмерыНоменклатур КАК ИС_WB_РазмерыНоменклатур
	|		ПО (ИС_WB_РазмерыНоменклатур.Владелец = ВТ_Номенклатура.Ссылка)
	|			И (ИС_WB_РазмерыНоменклатур.Профиль = &Профиль)
	|
	|СГРУППИРОВАТЬ ПО
	|	ВТ_Номенклатура.Ссылка,
	|	ИС_WB_РазмерыНоменклатур.techSize,
	|	ВТ_Номенклатура.Размер,
	|	ВТ_Номенклатура.Артикул
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ 
	|	ВТ_РазмерНоменклатуры.Артикул КАК Артикул, 
	|	ВТ_РазмерНоменклатуры.Размер КАК Размер,
	|	ИС_WB_СоответствиеРазмеров.Номенклатура КАК Номенклатура,
	|	ЕСТЬNULL(ИС_WB_СоответствиеРазмеров.Характеристика, ЗНАЧЕНИЕ(Справочник.ХарактеристикиНоменклатуры.ПустаяСсылка)) КАК Характеристика,
	|	ВЫБОР
	|		КОГДА ИС_WB_СоответствиеРазмеров.Номенклатура.ТипНоменклатуры = ЗНАЧЕНИЕ(Перечисление.ТипыНоменклатуры.Набор)
	|			ТОГДА ИСТИНА
	|		ИНАЧЕ ЛОЖЬ
	|	КОНЕЦ КАК ЭтоНабор,
	|	ИС_WB_СоответствиеРазмеров.Упаковка КАК Упаковка,
	|	ВЫБОР
	|		КОГДА ИС_WB_СоответствиеРазмеров.Упаковка ЕСТЬ NULL ИЛИ ИС_WB_СоответствиеРазмеров.Упаковка.Числитель = 0
	|			ТОГДА 1
	|		ИНАЧЕ ИС_WB_СоответствиеРазмеров.Упаковка.Числитель
	|	КОНЕЦ / ВЫБОР
	|		КОГДА ИС_WB_СоответствиеРазмеров.Упаковка ЕСТЬ NULL ИЛИ ИС_WB_СоответствиеРазмеров.Упаковка.Знаменатель = 0
	|			ТОГДА 1
	|		ИНАЧЕ ИС_WB_СоответствиеРазмеров.Упаковка.Знаменатель
	|	КОНЕЦ КАК КоэффициентУпаковки
	|ПОМЕСТИТЬ ВТ_Результирующая
	|ИЗ
	|	ВТ_РазмерНоменклатуры КАК ВТ_РазмерНоменклатуры
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ИС_WB_РазмерыНоменклатур КАК ИС_WB_РазмерыНоменклатур
	|		ПО ВТ_РазмерНоменклатуры.НоменклатураWB = ИС_WB_РазмерыНоменклатур.Владелец
	|			И ВТ_РазмерНоменклатуры.Размер = ИС_WB_РазмерыНоменклатур.techSize
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ИС_WB_СоответствиеРазмеров КАК ИС_WB_СоответствиеРазмеров
	|		ПО (ИС_WB_РазмерыНоменклатур.Ссылка = ИС_WB_СоответствиеРазмеров.РазмерWB)
	|			И (ИС_WB_СоответствиеРазмеров.Профиль = &Профиль)
	|ГДЕ
	|	ИС_WB_РазмерыНоменклатур.Профиль = &Профиль
	|	И НЕ ИС_WB_РазмерыНоменклатур.ПометкаУдаления
	|	И НЕ ИС_WB_СоответствиеРазмеров.Номенклатура ЕСТЬ NULL
	|;
	|
	|//////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_Результирующая.Номенклатура КАК Номенклатура,
	|	ВТ_Результирующая.Характеристика КАК Характеристика, 
	|	ВТ_Результирующая.Артикул КАК АртикулПоставщика,   
	|	ВТ_Результирующая.Размер КАК Размер,
	|	ВТ_Результирующая.ЭтоНабор КАК ЭтоНабор,
	|	ВТ_Результирующая.Упаковка КАК Упаковка,
	|	ВТ_Результирующая.КоэффициентУпаковки КАК КоэффициентУпаковки
	|ИЗ
	|	ВТ_Результирующая КАК ВТ_Результирующая";
	
	Запрос.УстановитьПараметр("Профиль", 			Профиль);
	Запрос.УстановитьПараметр("ТЗРезультирующая", 	ТЗРезультирующая);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Выборка = РезультатЗапроса.Выбрать();
	
	Пока Выборка.Следующий() Цикл
		
		НайденныеСтроки = ТаблицаСопоставления.НайтиСтроки(Новый Структура("Артикул", Выборка.АртикулПоставщика));
		
		Для Каждого Элемент Из НайденныеСтроки Цикл
			
			Если Не ЗначениеЗаполнено(Элемент.Номенклатура) Тогда
				
				ЗаполнитьЗначенияСвойств(Элемент, Выборка, "Номенклатура,Характеристика,Упаковка,КоэффициентУпаковки,ЭтоНабор,Размер");   
					
				Элемент.КоэффициентУпаковки = Выборка.КоэффициентУпаковки; 
					
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЦикла;
	
	СписокТранзакций.Сортировать("Номенклатура");
	
	Возврат СписокТранзакций;
		
КонецФункции //- ИнфоСофт Мурсалимов Д.Р. 28.02.25 УА #74987

