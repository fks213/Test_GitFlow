//+ ИнфоСофт Сумин Д.В. 04.03.2024 УА #71107
&НаСервере
Функция ПолучитьНастройкиУслугиВБ()
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ИС_WB_НаименованиеУслугИзОтчетаWildberries.Номенклатура.СтавкаНДС КАК СтавкаНДС,
	|	ИС_WB_НаименованиеУслугИзОтчетаWildberries.Номенклатура КАК Номенклатура
	|ИЗ
	|	Справочник.ИС_WB_НаименованиеУслугИзОтчетаWildberries КАК ИС_WB_НаименованиеУслугИзОтчетаWildberries
	|ГДЕ
	|	ИС_WB_НаименованиеУслугИзОтчетаWildberries.НаименованиеУслугиИзОтчета = ""Сумма вознаграждения Вайлдберриз за текущий период (ВВ), без НДС""";
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Результат = Новый Структура;
	
	Если РезультатЗапроса.Пустой() Тогда
		Результат.Вставить("СтавкаНДС", Справочники.СтавкиНДС.НайтиПоНаименованию("Без НДС"));
		Результат.Вставить("Номенклатура", Справочники.Номенклатура.ПустаяСсылка());
		Возврат Результат;	
	КонецЕсли;	
	
	Выборка = РезультатЗапроса.Выбрать();
	
	Выборка.Следующий();
	
	Результат.Вставить("СтавкаНДС", Выборка.СтавкаНДС);
	Результат.Вставить("Номенклатура", Выборка.Номенклатура);
	
	Возврат Результат;
		
КонецФункции //- ИнфоСофт Сумин Д.В. 04.03.2024 УА #71107 

//+ ИнфоСофт Заварин К.В. 01.11.24 УА #86746
&НаСервере
Процедура ЗаполнениеРегистраЗаказовНаСервере()
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|  ИС_WB_СборочноеЗадание.Ссылка КАК ЗаказМП,
	|  ИС_WB_СборочноеЗадание.rid КАК ИдентификаторМП,
	|  ИС_WB_СборочноеЗадание.Заказ КАК Заказ1С
	|ИЗ
	|  Документ.ИС_WB_СборочноеЗадание КАК ИС_WB_СборочноеЗадание
	|ГДЕ
	|  ИС_WB_СборочноеЗадание.Дата МЕЖДУ &НачалоПериода И &КонецПериода";
	
	Запрос.УстановитьПараметр("НачалоПериода",   '20240101000000');
	Запрос.УстановитьПараметр("КонецПериода",  '20241231000000');
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Выборка = РезультатЗапроса.Выбрать();
	
	Пока Выборка.Следующий() Цикл
		
		МенеджерЗаписи = РегистрыСведений.ИС_MP_ЗаказыОтчетаКомиссионера.СоздатьМенеджерЗаписи();
		
		МенеджерЗаписи.Профиль         			= Профиль;
		МенеджерЗаписи.Маркетплейс     			= Перечисления.ИС_МП_Маркетплейсы.ВБ;
		МенеджерЗаписи.ИдентификаторМП 		 	= Выборка.ИдентификаторМП;
