Процедура ОтменитьСопоставление(Команда)

	УдалитьСопоставлениеОсновногоРеквизита();

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

#Область ПроцедурыОповещения

&НаКлиенте
Процедура ВыборРеквизитаДляЗаполнения(Результат, СтруктураПараметров) Экспорт

	Если Не ЗначениеЗаполнено(Результат) Тогда
		Возврат;
	КонецЕсли;

	ТекущаяСтрока = Элементы.ОсновныеРеквизитыТовара.ТекущиеДанные;

	Если ТипЗнч(Результат) = Тип("СправочникСсылка.НаборыДополнительныхРеквизитовИСведений") Тогда

		ДополнительныеПараметры = Новый Структура;
		ДополнительныеПараметры.Вставить("ВидРеквизита1С", СтруктураПараметров.ВидРеквизита1С);

		Оповещение = Новый ОписаниеОповещения("ВыборРеквизитаДляЗаполнения", ЭтотОбъект, ДополнительныеПараметры);

		МассивЗначений = ДопРеквизитыНабора(Результат);
		СтруктураПараметров = Новый Структура;
		СтруктураПараметров.Вставить("МассивЗначений", МассивЗначений);

		ОткрытьФорму("Обработка.ИС_ЯМ_ВыгрузкаКарточекТоваров.Форма.ФормаВыбора", СтруктураПараметров, , , , , Оповещение,
			РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);

	Иначе

		ТекущаяСтрока.ВидРеквизита1С = СтруктураПараметров.ВидРеквизита1С;
		ТекущаяСтрока.Реквизит1С 	 = Результат;

	КонецЕсли;

	Если ЗначениеЗаполнено(ТекущаяСтрока.Реквизит1С) Тогда
		ЗаписатьСопоставлениеОсновногоРеквизита();
	КонецЕсли;

КонецПроцедуры 

#КонецОбласти

&НаСервере
Процедура ЗаполнитьСопоставление()

	ОсновныеРеквизитыТовара.Очистить();
	ТЗ = ОсновныеРеквизитыТовара.Выгрузить();
	ТаблицаРеквизитов = ИС_ЯМ_Сервер.ЗаполнитьТаблицуОсновныхРеквизитов(ТЗ, Категория);

	ОсновныеРеквизитыТовара.Загрузить(ТаблицаРеквизитов);

КонецПроцедуры

&НаСервереБезКонтекста
Функция ЕстьВидНоменклатурыУХарактеристики()

	Возврат ИС_MP_ВыгрузкаКарточек.ЕстьВидНоменклатурыУХарактеристики();

КонецФункции

&НаКлиенте
Процедура УдалитьСопоставлениеОсновногоРеквизита()

	ТекущаяСтрока = Элементы.ОсновныеРеквизитыТовара.ТекущиеДанные;
	Если ТекущаяСтрока = Неопределено Тогда
		Возврат;
	КонецЕсли;

	УдалитьСопоставлениеОсновногоРеквизитаНаСервере(Категория, ТекущаяСтрока.РеквизитТовара, "ИС_ЯМ_СоответствиеОсновныхРеквизитовТовара");

	ТекущаяСтрока.Реквизит1С 	 = Неопределено;
	ТекущаяСтрока.ВидРеквизита1С = ПредопределенноеЗначение("Перечисление.ИС_Ozon_ВидРеквизитаСопоставления.ПустаяСсылка");
	ТекущаяСтрока.ФиксированноеЗначение = 0;
	
	//+ ИнфоСофт Заварин К.В. 20.05.24 УА #71157
	ТекущаяСтрока.Множитель = 0;
	//- ИнфоСофт Заварин К.В. 20.05.24 УА #71157
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаписатьСопоставлениеОсновногоРеквизита()
	
	ТекущаяСтрока = Элементы.ОсновныеРеквизитыТовара.ТекущиеДанные;
	
	//+ ИнфоСофт Заварин К.В. 20.05.24 УА #71157
	//Добавлен множитель
	ДобавитьСопоставлениеОсновногоРеквизита(Категория, ТекущаяСтрока.РеквизитТовара,
	ТекущаяСтрока.ВидРеквизита1С, ТекущаяСтрока.Реквизит1С, ТекущаяСтрока.ФиксированноеЗначение, "ИС_ЯМ_СоответствиеОсновныхРеквизитовТовара", ТекущаяСтрока.Множитель);
	//- ИнфоСофт Заварин К.В. 20.05.24 УА #71157
	
КонецПроцедуры 

//+ ИнфоСофт Заварин К.В. 20.05.24 УА #71157
//Добавлен множитель  
&НаСервере
Процедура ДобавитьСопоставлениеОсновногоРеквизита(Категория, РеквизитТовара, ВидРеквизита1С, Реквизит1С, ФиксированноеЗначение, ИмяРегистра, Множитель)	
	ИС_MP_ВыгрузкаКарточек.ДобавитьСопоставлениеОсновногоРеквизита(Категория, РеквизитТовара, ВидРеквизита1С, Реквизит1С,
	ФиксированноеЗначение, ИмяРегистра, Множитель); 
КонецПроцедуры  //- ИнфоСофт Заварин К.В. 20.05.24 УА #71157  

&НаСервере
Процедура УдалитьСопоставлениеОсновногоРеквизитаНаСервере(Категория, РеквизитТовара, ИмяРегистра)	
	ИС_MP_ВыгрузкаКарточек.УдалитьСопоставлениеОсновногоРеквизита(Категория, РеквизитТовара, ИмяРегистра);
