#Область СлужебныеПроцедурыИФункции

//+ ИнфоСофт Стояк Ю.К. 12.05.2024 УА #62574
&НаКлиенте
Процедура ЗагрузитьСЯМ(ИмяКоманды)	

	ДопПараметры = Новый Структура;
	ДопПараметры.Вставить("ИмяКоманды", ИмяКоманды);  
	
	ДлительнаяОперация = ЗагрузитьСЯМНаСервере(ИмяКоманды); 
		
	ОповещениеОЗавершении = Новый ОписаниеОповещения("ПослеЗавершенияЗагрузкиСЯМ", ЭтотОбъект, ДопПараметры);
	ДлительныеОперацииКлиент.ОжидатьЗавершение(ДлительнаяОперация, ОповещениеОЗавершении, ПараметрыОжидания());

КонецПроцедуры //- ИнфоСофт Стояк Ю.К. 12.05.2024 УА #62574

//+ ИнфоСофт Стояк Ю.К. 12.05.2024 УА #62574
&НаСервере
Функция ЗагрузитьСЯМНаСервере(ИмяКоманды) 
	
	ПараметрыВыполнения = ДлительныеОперации.ПараметрыВыполненияВФоне(УникальныйИдентификатор);

	Если ИмяКоманды = "ЗагрузитьКатегориТоваровСЯМ" Тогда		
		Возврат ДлительныеОперации.ВыполнитьПроцедуру(ПараметрыВыполнения,
		"ИС_ЯМ_Сервер.ЗагрузитьКатегорииТоваров",
		Профиль);
		
	ИначеЕсли ИмяКоманды = "ЗагрузитьХарактеристикСЯМ" Тогда		
		Возврат ДлительныеОперации.ВыполнитьПроцедуру(ПараметрыВыполнения,
		"ИС_ЯМ_Сервер.ЗагрузитьХарактеристики",
		Профиль);
		
	КонецЕсли;
	
	Возврат Неопределено;
	
КонецФункции //- ИнфоСофт Стояк Ю.К. 12.05.2024 УА #62574

//+ ИнфоСофт Стояк Ю.К. 12.05.2024 УА #62574
&НаКлиенте
Процедура УстановитьУсловноеОформление(ИзменилисьИспользуемыеКатегории = Ложь)

	ЕстьИспользуемыеКатегории = ЕстьИспользуемыеКатегории();
	Если ЕстьИспользуемыеКатегории() Тогда
		РезультатВыбораИспользуемыхКатегорий = 2;
		ВыбранныеКатегорииТоваров = "";
	Иначе
		РезультатВыбораИспользуемыхКатегорий = 1;
		ВыбранныеКатегорииТоваров = "Не выбраны категории!";
	КонецЕсли;
	
КонецПроцедуры //- ИнфоСофт Стояк Ю.К. 12.05.2024 УА #62574

//+ ИнфоСофт Стояк Ю.К. 12.05.2024 УА #62574
&НаКлиенте
Процедура ПослеЗавершенияЗагрузкиСЯМ(Результат, СтруктураПараметров) Экспорт

	Если Результат = Неопределено Тогда
		Возврат;
	КонецЕсли;

	УстановитьУсловноеОформление();

КонецПроцедуры //- ИнфоСофт Стояк Ю.К. 12.05.2024 УА #62574

//+ ИнфоСофт Стояк Ю.К. 12.05.2024 УА #62574
&НаКлиенте
Процедура ПослеВыбораИспользуемыхКатегорий(Результат, СтруктураПараметров) Экспорт

	Если Результат = Истина Тогда
		ПоказатьПредупреждение( , "После изменения используемых категорий товаров необходимо загрузить значения характеристик для новых категорий!",
			, "Предупреждение.");
		УстановитьУсловноеОформление(Результат);
	КонецЕсли;

КонецПроцедуры //- ИнфоСофт Стояк Ю.К. 12.05.2024 УА #62574

//+ ИнфоСофт Стояк Ю.К. 12.05.2024 УА #62574
&НаСервереБезКонтекста
Функция ЕстьИспользуемыеКатегории()

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
	|	ИС_ЯМ_КатегорииТоваров.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.ИС_ЯМ_КатегорииТоваров КАК ИС_ЯМ_КатегорииТоваров
	|ГДЕ
	|	ИС_ЯМ_КатегорииТоваров.Используется = ИСТИНА
	|	И НЕ ИС_ЯМ_КатегорииТоваров.ПометкаУдаления
	|	И НЕ ИС_ЯМ_КатегорииТоваров.ЭтоГруппа";

	РезультатЗапроса = Запрос.Выполнить();

	Возврат Не РезультатЗапроса.Пустой();

КонецФункции //- ИнфоСофт Стояк Ю.К. 12.05.2024 УА #62574

&НаКлиенте
Процедура ВыгрузитьТовары(Команда) 
	
	Если Не ЗначениеЗаполнено(Профиль) Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю("Не выбран профиль!");
		Возврат;
	КонецЕсли; 

	СтруктураПараметров = Новый Структура;	
	СтруктураПараметров.Вставить("Профиль", Профиль);

	ОткрытьФорму("Обработка.ИС_ЯМ_ВыгрузкаКарточекТоваров.Форма.ФормаДобавленияТоваров", СтруктураПараметров, ЭтотОбъект);

КонецПроцедуры

