//+ ИнфоСофт Стояк Ю.К. 13.05.2024 УА #65724
&НаСервере
Процедура ЗаполнитьСтрокуТовара(СтрокаТаблицы, ДанныеЗаполнения, ТаблицаСоответствийЗначений,
	
	СтруктураПараметровЗначенийРеквизитовНоменклатуры, СтруктураПараметровЗначенийРеквизитовХарактеристикиНоменклатуры)
	
	СтрокаТаблицы.Номенклатура 					= ДанныеЗаполнения.Номенклатура;
	СтрокаТаблицы.Упаковка 						= ДанныеЗаполнения.Упаковка;
	СтрокаТаблицы.ХарактеристикаНоменклатуры 	= ДанныеЗаполнения.Характеристика;
	СтрокаТаблицы.offerId						= "";
	СтрокаТаблицы.Штрихкод 						= ДанныеЗаполнения.Штрихкод;

	СтрокаТаблицы.Цена							= ДанныеЗаполнения.Цена;
	СтрокаТаблицы.ЦенаСоСкидкой					= ДанныеЗаполнения.ЦенаСоСкидкой;	
	СтрокаТаблицы.ДлинаУпаковки 				= Макс(ДанныеЗаполнения.Высота, ДанныеЗаполнения.Глубина,
		ДанныеЗаполнения.Ширина);
	СтрокаТаблицы.ВысотаУпаковки 				= Мин(ДанныеЗаполнения.Высота, ДанныеЗаполнения.Глубина,
		ДанныеЗаполнения.Ширина);
	СтрокаТаблицы.ШиринаУпаковки 				= (ДанныеЗаполнения.Высота + ДанныеЗаполнения.Глубина
		+ ДанныеЗаполнения.Ширина) - (СтрокаТаблицы.ДлинаУпаковки + СтрокаТаблицы.ВысотаУпаковки);
	СтрокаТаблицы.ВесУпаковки 					= ДанныеЗаполнения.ВесУпаковки;
	СтрокаТаблицы.ИспользоватьХарактеристики 	= ДанныеЗаполнения.ИспользоватьХарактеристики;
	СтрокаТаблицы.ИспользоватьУпаковки 			= ДанныеЗаполнения.ИспользоватьУпаковки;
	
	РазделительФотографий = "";
	ИС_ЯМ_Сервер.ЗаполнитьЗначенияПоДопРеквизитам(СтрокаТаблицы, ТаблицаСоответствийЗначений,
	РазделительФотографий);
	ИС_ЯМ_Сервер.ЗаполнитьЗначенияПоРеквизитамНоменклатуры(СтрокаТаблицы,
	СтруктураПараметровЗначенийРеквизитовНоменклатуры, РазделительФотографий);
	ИС_ЯМ_Сервер.ЗаполнитьЗначенияПоРеквизитамХарактеристикиНоменклатуры(СтрокаТаблицы,
	СтруктураПараметровЗначенийРеквизитовХарактеристикиНоменклатуры, РазделительФотографий);

КонецПроцедуры

//+ ИнфоСофт Стояк Ю.К. 13.05.2024 УА #65724
&НаСервере
Процедура ИнициализироватьХарактеристики()
	
	УдалитьХарактеристики();
	
	Элементы.ГруппаШапкаПредупреждение.Видимость = Ложь;
	
	Если ЗначениеЗаполнено(Категория) Тогда
		
		Элементы.ГруппаТаблица.Доступность 		= Истина;
		Элементы.СохранитьТовары.Доступность 	= Истина;
		ИмяТабличнойЧасти = "Товары";
		
		ОбязательныеХарактеристики 	= Новый Массив;
		АспектныеХарактеристики 	= Новый Массив;
		
		Запрос = Новый Запрос;
		Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ИС_ЯМ_Характеристика.Наименование КАК Наименование,
		|	ИС_ЯМ_Характеристика.multivalue КАК НаборЗначений,		
		|	ИС_ЯМ_Характеристика.type КАК type,
		|	ИС_ЯМ_КатегорииТоваровproperties.required КАК Обязательная,
		|	ИС_ЯМ_Характеристика.Код КАК Код
		|ИЗ
		|	Справочник.ИС_ЯМ_КатегорииТоваров.properties КАК ИС_ЯМ_КатегорииТоваровproperties
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ИС_ЯМ_Характеристика КАК ИС_ЯМ_Характеристика
		|		ПО ИС_ЯМ_КатегорииТоваровproperties.Характеристика = ИС_ЯМ_Характеристика.Ссылка
		|ГДЕ
		|	ИС_ЯМ_КатегорииТоваровproperties.Ссылка = &Категория
		|
		|УПОРЯДОЧИТЬ ПО
		|	Обязательная УБЫВ";
		
		Запрос.УстановитьПараметр("Категория", Категория);
		
		РезультатЗапроса = Запрос.Выполнить();
		
		Выборка = РезультатЗапроса.Выбрать();		
			
		Пока Выборка.Следующий() Цикл
			
			ЦветФона = Новый Цвет(255, 255, 255);
			ИмяРеквизита 		= "Атрибут_" + Формат(Выборка.Код, "ЧГ=0");
			МножественныйВыбор  = Выборка.НаборЗначений;    
			
			Тип = Новый ОписаниеТипов("Строка", , Новый КвалификаторыСтроки(0, ДопустимаяДлина.Переменная));
			typeНР = НРег(Выборка.type);
			Если typeНР = "enum" И Не МножественныйВыбор Тогда
				Тип = Новый ОписаниеТипов("СправочникСсылка.ИС_ЯМ_ЗначенияХарактеристик");
			ИначеЕсли Выборка.НаборЗначений Тогда
				Тип = Новый ОписаниеТипов("СписокЗначений");			
			ИначеЕсли typeНР = "numeric" Тогда
				Тип = Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(10, 2, ДопустимыйЗнак.Любой));
			ИначеЕсли typeНР = "boolean" Тогда
				Тип = Новый ОписаниеТипов("Булево");			
			КонецЕсли;
			
			ПутьКДанным  		= ?(ИмяТабличнойЧасти = "", ИмяРеквизита, ИмяТабличнойЧасти + "." + ИмяРеквизита);
			СоздатьРеквизитФормы(ИмяРеквизита, Тип, Выборка.Наименование, ИмяТабличнойЧасти);
			
			Если Выборка.Обязательная Тогда
				ОбязательныеХарактеристики.Добавить(ИмяРеквизита);
				ЦветФона = Новый Цвет(0, 160, 70);
			КонецЕсли;
			
			СоздатьПолеФормы(Выборка, ИмяРеквизита, ПутьКДанным, МножественныйВыбор, ЦветФона);
						
		КонецЦикла;
		
		СписокОбязательныхХарактеристик = Новый ФиксированныйМассив(ОбязательныеХарактеристики);
		
	КонецЕсли;
	
КонецПроцедуры //- ИнфоСофт Стояк Ю.К. 13.05.2024 УА #65724

//+ ИнфоСофт Стояк Ю.К. 13.05.2024 УА #65724
&НаСервере
Процедура УдалитьХарактеристики()

	ЭлементыХарактеристик = Элементы.ГруппаХарактеристики.ПодчиненныеЭлементы;

	УдаляемыеПоля = Новый Массив;
	УдаляемыеРеквизиты = Новый Массив;

	Для Каждого Элемент Из ЭлементыХарактеристик Цикл
		УдаляемыеПоля.Добавить(Элемент);
		УдаляемыеРеквизиты.Добавить(Элемент.ПутьКДанным);
	КонецЦикла;

	Для Каждого Элемент Из УдаляемыеПоля Цикл
		Элементы.Удалить(Элемент);
	КонецЦикла;

	ИзменитьРеквизиты( , УдаляемыеРеквизиты);

КонецПроцедуры

//+ ИнфоСофт Стояк Ю.К. 13.05.2024 УА #65724
&НаСервере
Процедура СоздатьРеквизитФормы(ИмяРеквизита, Тип, ЗаголовокПоля = "", ИмяТабличнойЧасти = "")

	ДобавляемыеРеквизиты = Новый Массив;

	ИмяРеквизита = ИмяРеквизита;
	НовыйРеквизит = Новый РеквизитФормы(ИмяРеквизита, Тип, ИмяТабличнойЧасти, ЗаголовокПоля);
	ДобавляемыеРеквизиты.Добавить(НовыйРеквизит);

	ИзменитьРеквизиты(ДобавляемыеРеквизиты);

КонецПроцедуры

//+ ИнфоСофт Стояк Ю.К. 13.05.2024 УА #65724
&НаСервере
Процедура СоздатьПолеФормы(Выборка, ИмяРеквизита, ПутьКДанным, МножественныйВыбор, ЦветФона)

	ГруппаФормы = Элементы.ГруппаХарактеристики;
	type 		= НРег(Выборка.type);
	ВидПоля		= ВидПоля(type);
	НовыйЭлемент = Элементы.Добавить(ИмяРеквизита, Тип("ПолеФормы"), ГруппаФормы);
	НовыйЭлемент.ПутьКДанным 	= ПутьКДанным;
	НовыйЭлемент.Вид 			= ВидПоля;
	НовыйЭлемент.Заголовок		= Выборка.Наименование + ?(Выборка.Обязательная, "*", "");
	
	НовыйЭлемент.ПоложениеЗаголовка = ПоложениеЗаголовкаЭлементаФормы.Верх;
	НовыйЭлемент.ЦветФонаЗаголовка 				= ЦветФона;  
	
	Если Не НовыйЭлемент.Вид = ВидПоляФормы.ПолеФлажка Тогда
		НовыйЭлемент.РастягиватьПоГоризонтали 	= Истина;
		НовыйЭлемент.АвтоМаксимальнаяШирина 	= Ложь;
		НовыйЭлемент.АвтоОтметкаНезаполненного 	= Выборка.Обязательная;
		НовыйЭлемент.КнопкаОчистки 	= Истина;
	КонецЕсли;
	
	// Выбор из списка
	Если Не МножественныйВыбор И type = "enum" Тогда
		НовыйЭлемент.КнопкаВыбора 				= Истина;
		НовыйЭлемент.ОтображениеКнопкиВыбора 	= ОтображениеКнопкиВыбора.ОтображатьВПолеВвода;
		НовыйЭлемент.ИсторияВыбораПриВводе  	= ИсторияВыбораПриВводе.НеИспользовать;
		НовыйЭлемент.КнопкаВыпадающегоСписка 	= Ложь;
		НовыйЭлемент.КнопкаСоздания 			= Ложь;
		НовыйЭлемент.КнопкаОткрытия 			= Ложь;
		НовыйЭлемент.РедактированиеТекста 		= Ложь;
		НовыйЭлемент.УстановитьДействие("НачалоВыбора", "ХарактеристикаНачалоВыбора");
	КонецЕсли;

	НовыйЭлемент.УстановитьДействие("ПриИзменении", "ХарактеристикаПриИзменении");

	Если МножественныйВыбор Тогда
		НовыйЭлемент.УстановитьДействие("НачалоВыбора", "ХарактеристикаНачалоМножественногоВыбора");
		НовыйЭлемент.УстановитьДействие("ОбработкаВыбора", "ХарактеристикаОбработкаМножественногоВыбора");
		НовыйЭлемент.КнопкаВыбора 	= Истина;
	КонецЕсли;

КонецПроцедуры

//+ ИнфоСофт Стояк Ю.К. 13.05.2024 УА #65724
&НаСервере
Процедура ЗаполнитьКолонкуСопоставленнымиЗначениямиНаСервере(ИмяКолонки)

	ЕстьНастройкиОсновныхРеквизитовДляКатегории = ИС_АЛИ_Сервер.ЕстьНастройкиОсновныхРеквизитовДляКатегории(
		Категория);
	ТаблицаСоответствийЗначений = ИС_АЛИ_Сервер.ТаблицаСоответствийДопРеквизитов(Категория,
		ЕстьНастройкиОсновныхРеквизитовДляКатегории);
	СтруктураПараметровЗначенийРеквизитовНоменклатуры = ИС_АЛИ_Сервер.СтруктураПараметровЗначенийРеквизитовНоменклатуры(
		Категория, ЕстьНастройкиОсновныхРеквизитовДляКатегории);
	СтруктураПараметровЗначенийРеквизитовХарактеристикиНоменклатуры = ИС_АЛИ_Сервер.СтруктураПараметровЗначенийРеквизитовХарактеристикиНоменклатуры(
		Категория, ЕстьНастройкиОсновныхРеквизитовДляКатегории);
			
	РазделительФотографий = "";

	Для Каждого СтрокаТаблицы Из Товары Цикл

		ИС_ЯМ_Сервер.ЗаполнитьЗначенияПоДопРеквизитам(СтрокаТаблицы, ТаблицаСоответствийЗначений,
			РазделительФотографий, ИмяКолонки);
		ИС_ЯМ_Сервер.ЗаполнитьЗначенияПоРеквизитамНоменклатуры(СтрокаТаблицы,
			СтруктураПараметровЗначенийРеквизитовНоменклатуры, РазделительФотографий, ИмяКолонки);
		ИС_ЯМ_Сервер.ЗаполнитьЗначенияПоРеквизитамХарактеристикиНоменклатуры(СтрокаТаблицы,
			СтруктураПараметровЗначенийРеквизитовХарактеристикиНоменклатуры, РазделительФотографий, ИмяКолонки);

	КонецЦикла;

КонецПроцедуры

//+ ИнфоСофт Стояк Ю.К. 13.05.2024 УА #65724
&НаСервере
Процедура СохранитьТоварыНаСервере()

	МассивТоваров = Новый Массив;
	ПоляАтрибутов = Элементы.ГруппаХарактеристики.ПодчиненныеЭлементы; 	
			
	Для Каждого стр Из Товары Цикл
						
        	СтруктураТовара = СтруктураДобавленияТовара();
			СтруктураТовара = ЗаполнитьСтруктуруДобавленияТовара(стр, Категория, СтруктураТовара);
			СтруктураТовара.parameterValues = ЗаполнениеХарактеристик(стр, ПоляАтрибутов);			
			
			Товар = Новый Структура;
			
			Товар.Вставить("offer", СтруктураТовара);
			
			Если стр.marketSku <> 0 Тогда
				МаркетСКУ = Новый Структура("marketSku", стр.marketSku);
				Товар.Вставить("mapping", МаркетСКУ);
			КонецЕсли;
			
			//+ ИнфоСофт Власова И.С. 02.12.24 УА #62619
			Если СопоставитьНоменклатуруАвтоматически Тогда	
				
				ДанныеСопоставления = СтруктураСопоставленияТовара();
				ЗаполнитьЗначенияСвойств(ДанныеСопоставления, стр);
				
				Если Не ЗначениеЗаполнено(ДанныеСопоставления.Упаковка) Тогда			
					ДанныеСопоставления.Упаковка = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(стр.Номенклатура, "ЕдиницаИзмерения");		
				КонецЕсли;
				
				Товар.Вставить("ДанныеСопоставления", ДанныеСопоставления);
				
			КонецЕсли;
			//- ИнфоСофт Власова И.С. 02.12.24 УА #62619
			
			МассивТоваров.Добавить(Товар);
			
	КонецЦикла;
	
	ИС_ЯМ_Сервер.ВыгрузитьКарточкиТовара(Профиль, МассивТоваров);
	
	//+ ИнфоСофт Власова И.С. 02.12.24 УА #62619
	Если СоздатьКарточкиПослеВыгрузки Тогда
		СоздатьСопоставитьНоменклатуру(МассивТоваров);
	КонецЕсли;
	//- ИнфоСофт Власова И.С. 02.12.24 УА #62619
	
КонецПроцедуры

//+ ИнфоСофт Стояк Ю.К. 13.05.2024 УА #65724
&НаСервере
Функция ЗначенияРавны(Знач1, Знач2) 
		
	Если ТипЗнч(Знач1) = Тип("СписокЗначений") Тогда
	
		Если Знач1.Количество() = Знач2.Количество() Тогда
			Результат = Истина;
			Для Каждого элем Из Знач1 Цикл
				Если знач2.НайтиПоЗначению(элем.Значение) = Неопределено Тогда
					Результат = Ложь;
					Прервать;
				КонецЕсли;		
			КонецЦикла;	
		Иначе
			Результат = Ложь;	
		КонецЕсли;
		
	Иначе	
		Результат = Знач1 = Знач2;	
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

