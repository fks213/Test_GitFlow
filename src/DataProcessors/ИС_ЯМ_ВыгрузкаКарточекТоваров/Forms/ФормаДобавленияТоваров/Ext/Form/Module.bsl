&НаКлиенте
Процедура ХарактеристикаНачалоМножественногоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)

	СтандартнаяОбработка = Ложь;
	ТекущаяСтрока = Элементы.Товары.ТекущиеДанные;
	ИДстрокой = СтрРазделить(Элемент.Имя, "_")[1];
	ХарактеристикаЯМ = ХарактеристикаПоКоду(ИДстрокой);
	ВыбранныеЗначения = ТекущаяСтрока[Элемент.Имя].ВыгрузитьЗначения();	

	СтруктураПараметров = Новый Структура;
	СтруктураПараметров.Вставить("ВыбранныеЗначения", ВыбранныеЗначения);
	СтруктураПараметров.Вставить("Категория", Категория);
	СтруктураПараметров.Вставить("ХарактеристикаЯМ", ХарактеристикаЯМ); 
	
	Ограничение = ПолучитьРеквизит(ХарактеристикаЯМ, "limitingParameterId");
		
	Если Ограничение <> 0 Тогда		
		ЗначениеРеквизита = ТекущаяСтрока["Атрибут_" + Формат(Ограничение, "ЧГ=0")];
		
		КодЗначения = ПолучитьРеквизит(ЗначениеРеквизита, "Код");
		МассивЗначений = ПолучитьКоды(КодЗначения);
		
		СтруктураПараметров.Вставить("Значения", МассивЗначений); 
		
	КонецЕсли;
	
	ОткрытьФорму("Обработка.ИС_ЯМ_ВыгрузкаКарточекТоваров.Форма.ФормаМножественногоВыбораАтрибута", СтруктураПараметров, Элемент, , , , ,
		РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);

КонецПроцедуры

