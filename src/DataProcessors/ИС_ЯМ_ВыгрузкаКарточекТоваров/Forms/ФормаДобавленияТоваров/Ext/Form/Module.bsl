//+ ИнфоСофт Стояк Ю.К. 13.05.2024 УА #65724
&НаСервере
Функция ЗаполнитьСтруктуруДобавленияТовара(Источник, Категория, СтруктураТовара)
	

	СтруктураТовара.marketCategoryId	= Категория.Код;
	СтруктураТовара.offerId		= Источник.offerId;
	СтруктураТовара.name		= Источник.name;
	СтруктураТовара.description	= Источник.description;
	СтруктураТовара.vendorCode	= Источник.vendorCode;	
				
	СтруктураТовара.pictures.Добавить(Источник.pictures);
	
	Габариты = Новый Структура("length, width, height, weight", 0, 0, 0, 0);
	Габариты.weight = Источник.ВесУпаковки;
	Габариты.width = Источник.ШиринаУпаковки;
	Габариты.height = Источник.ВысотаУпаковки;
	Габариты.length = Источник.ДлинаУпаковки; 
	
	СтруктураТовара.Вставить("weightDimensions", Габариты);		
		
	Если ЗначениеЗаполнено(Источник.Штрихкод) Тогда 
		БуферныйМассив = Новый Массив;
		БуферныйМассив.Добавить(Строка(Источник.Штрихкод));
		СтруктураТовара.Вставить("barcodes", БуферныйМассив);		
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Источник.vendor) Тогда
		СтруктураТовара.Вставить("vendor", Источник.vendor);		
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Источник.certificates) Тогда
		
		БуферныйМассив = Новый Массив;
		
		МассивВыбранныхЗначений = Источник.certificates.ВыгрузитьЗначения(); 
				
		Для Каждого Значение Из МассивВыбранныхЗначений Цикл
			БуферныйМассив.Добавить(Строка(Значение));
		КонецЦикла;
		
		СтруктураТовара.Вставить("certificates", БуферныйМассив);		
		
	КонецЕсли; 
	
	Если Источник.boxCount > 1 Тогда
		СтруктураТовара.Вставить("boxCount", Источник.boxCount);		
	КонецЕсли; 
	
	Если Источник.downloadable Тогда
		СтруктураТовара.Вставить("downloadable", Источник.downloadable);		
	КонецЕсли; 
	
	Если Источник.adult Тогда
		СтруктураТовара.Вставить("adult", Источник.adult);		
	КонецЕсли;   
	
	Если ЗначениеЗаполнено(Источник.customsCommodityCode) Тогда
		СтруктураТовара.Вставить("customsCommodityCode", Источник.customsCommodityCode);		
	КонецЕсли; 
	
	//+ ИнфоСофт Стояк Ю.К. 25.07.2024 УА #79507	
	Если ЗначениеЗаполнено(Источник.type) И Источник.type <> "DEFAULT" Тогда       
	//Если Источник.type <> "DEFAULT" Тогда       
	//- ИнфоСофт Стояк Ю.К. 25.07.2024 УА #79507
		СтруктураТовара.Вставить("type", Источник.type);		
	КонецЕсли;	
	
	Возврат СтруктураТовара;

КонецФункции //- ИнфоСофт Стояк Ю.К. 13.05.2024 УА #65724

//+ ИнфоСофт Стояк Ю.К. 13.05.2024 УА #65724
&НаСервере
Функция ЗаполнениеХарактеристик(Источник, ПоляАтрибутов)

	Результат = Новый Массив;

	Для Каждого Поле Из ПоляАтрибутов Цикл

		ЗначениеАтрибута = Источник[Поле.Имя];
		Если Не ЗначениеЗаполнено(ЗначениеАтрибута) Тогда
			Продолжить;	
		КонецЕсли;
		
		ИдАтрибута = Число(СтрРазделить(Поле.Имя, "_")[1]);
		//+ ИнфоСофт Стояк Ю.К. 03.12.2024 УА #88925
		Если ТипЗнч(ЗначениеАтрибута) = Тип("СписокЗначений") Тогда
			СтруктураАтрибута = СтруктураОсновногоАтрибутаДобавлениеТовара(ИдАтрибута, ЗначениеАтрибута[0].Значение);
		Иначе
			СтруктураАтрибута = СтруктураОсновногоАтрибутаДобавлениеТовара(ИдАтрибута, ЗначениеАтрибута);
		КонецЕсли;
		//СтруктураАтрибута = СтруктураОсновногоАтрибутаДобавлениеТовара(ИдАтрибута, ЗначениеАтрибута);
		//- ИнфоСофт Стояк Ю.К. 03.12.2024 УА #88925
		Если СтруктураАтрибута.parameterId = 0 Тогда
			Продолжить;
		КонецЕсли;	
			
		Если ТипЗнч(ЗначениеАтрибута) = Тип("СписокЗначений") Тогда 
			
			МассивВыбранныхЗначений = ЗначениеАтрибута.ВыгрузитьЗначения();
			
			Для Каждого Значение Из МассивВыбранныхЗначений Цикл 
				
				БуферСтруктуры = СтруктураАтрибута; 
				
				Если ЗначениеЗаполнено(Значение) Тогда					
					
					Если БуферСтруктуры.Свойство("valueId") Тогда
						БуферСтруктуры.valueId = Значение.Код;
						БуферСтруктуры.value = Значение.Наименование;
					ИначеЕсли ТипЗнч(Значение) = Тип("Булево") Тогда
						БуферСтруктуры.value = ?(Значение = Ложь, "false", "true");		
					Иначе
						БуферСтруктуры.value = Строка(Значение.Наименование);
					КонецЕсли;
					
					Результат.Добавить(БуферСтруктуры);          
					
				КонецЕсли; 
				
			КонецЦикла; 
			
		Иначе  
			
			Если СтруктураАтрибута.Свойство("valueId") Тогда
					СтруктураАтрибута.valueId = ЗначениеАтрибута.Код;
					СтруктураАтрибута.value = ЗначениеАтрибута.Наименование;
			ИначеЕсли ТипЗнч(ЗначениеАтрибута) = Тип("Булево") Тогда
				СтруктураАтрибута.value = ?(ЗначениеАтрибута = Ложь, "false", "true");		
			Иначе
				//+ ИнфоСофт Стояк Ю.К. 26.11.2024 УА #88295				
				//СтруктураАтрибута.value = Строка(Значение.Наименование);
				СтруктураАтрибута.value = Строка(ЗначениеАтрибута);
				//- ИнфоСофт Стояк Ю.К. 26.11.2024 УА #88295
			КонецЕсли;		
			Результат.Добавить(СтруктураАтрибута);  
			
		КонецЕсли;
		

	КонецЦикла;

	Возврат Результат;

КонецФункции //- ИнфоСофт Стояк Ю.К. 13.05.2024 УА #65724

//+ ИнфоСофт Стояк Ю.К. 13.05.2024 УА #65724
&НаСервере
Функция СтруктураОсновногоАтрибутаДобавлениеТовара(ИДАтрибута, ЗначениеАтрибута)

	Результат = Новый Структура;
	Результат.Вставить("parameterId", 0);
	Результат.Вставить("value", ""); 

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ИС_ЯМ_Характеристика.Код КАК Код,
	|	ИС_ЯМ_Характеристика.Наименование КАК Наименование,
	|	ВЫБОР
	|		КОГДА ИС_ЯМ_Характеристика.type = ""ENUM""
	|			ТОГДА ИСТИНА
	|		ИНАЧЕ ЛОЖЬ
	|	КОНЕЦ КАК enum
	|ИЗ
	|	Справочник.ИС_ЯМ_Характеристика КАК ИС_ЯМ_Характеристика
	|ГДЕ
	|	ИС_ЯМ_Характеристика.Код = &Код";

	Запрос.УстановитьПараметр("Код", ИДАтрибута);	

	РезультатЗапроса = Запрос.Выполнить();

	Выборка = РезультатЗапроса.Выбрать();

	Если Выборка.Следующий() Тогда		
		Результат.parameterId = Выборка.Код; 
		
		Если Выборка.enum Тогда
			Результат.Вставить("valueId", ЗначениеАтрибута.Код);		
		КонецЕсли; 
		
	КонецЕсли; 
		
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	ИС_ЯМ_СоответствиеЗначенийХарактеристик.ЕдиницаИзмерения.Код КАК ЕдиницаИзмеренияКод
		|ИЗ
		|	РегистрСведений.ИС_ЯМ_СоответствиеЗначенийХарактеристик КАК ИС_ЯМ_СоответствиеЗначенийХарактеристик
		|ГДЕ
		|	ИС_ЯМ_СоответствиеЗначенийХарактеристик.Категория = &Категория
		|	И ИС_ЯМ_СоответствиеЗначенийХарактеристик.ЗначениеХарактеристикиЯМ = &ЗначениеХарактеристикиЯМ
		|	И ИС_ЯМ_СоответствиеЗначенийХарактеристик.ХарактеристикаЯМ.Код = &Код
		|	И НЕ ИС_ЯМ_СоответствиеЗначенийХарактеристик.ЕдиницаИзмерения ЕСТЬ NULL";
		//- ИнфоСофт Стояк Ю.К. 03.12.2024 УА #88925
	
	Запрос.УстановитьПараметр("ЗначениеХарактеристикиЯМ", ЗначениеАтрибута);
	Запрос.УстановитьПараметр("Категория", Категория);
	Запрос.УстановитьПараметр("Код", ИДАтрибута);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		Результат.Вставить("unitId", ВыборкаДетальныеЗаписи.ЕдиницаИзмеренияКод);	
	КонецЦикла;		

	Возврат Результат;

КонецФункции //- ИнфоСофт Стояк Ю.К. 13.05.2024 УА #65724

