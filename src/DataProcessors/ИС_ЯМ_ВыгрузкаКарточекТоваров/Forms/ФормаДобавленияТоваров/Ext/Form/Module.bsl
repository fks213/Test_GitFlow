//+ ИнфоСофт Стояк Ю.К. 13.05.2024 УА #65724
&НаКлиенте
Функция КатегорияЗаполнена()

	Результат = Истина;

	Если Не ЗначениеЗаполнено(Категория) Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю("Не заполнена Категория товаров", , "Категория");
		Результат = Ложь;
	КонецЕсли;

	Возврат Результат;

