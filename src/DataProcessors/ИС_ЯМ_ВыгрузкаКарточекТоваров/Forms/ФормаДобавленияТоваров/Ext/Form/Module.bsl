	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ИС_ЯМ_ХарактеристикаvalueRestrictions.id КАК id
		|ИЗ
		|	Справочник.ИС_ЯМ_Характеристика.valueRestrictions КАК ИС_ЯМ_ХарактеристикаvalueRestrictions
