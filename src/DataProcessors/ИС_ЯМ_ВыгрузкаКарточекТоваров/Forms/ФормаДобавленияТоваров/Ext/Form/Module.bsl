&НаСервере
Функция ЗависимыеРеквизитыНоменклатуры(СтруктураПараметров)

	ИспользуетсяЦенообразование25 = Не Метаданные.ФункциональныеОпции.Найти("ИспользуетсяЦенообразование25")
		= Неопределено И ПолучитьФункциональнуюОпцию("ИспользуетсяЦенообразование25");

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	ТаблицаНоменклатуры.Номенклатура КАК Номенклатура,
		|	ТаблицаНоменклатуры.Упаковка КАК Упаковка,
		|	ТаблицаНоменклатуры.Характеристика КАК Характеристика
		|ПОМЕСТИТЬ вт_ТаблицаНоменклатуры
		|ИЗ
		|	&ТаблицаНоменклатуры КАК ТаблицаНоменклатуры
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	Номенклатура.Ссылка КАК Номенклатура,
		|	НаборыУпаковок.Ссылка КАК НаборУпаковок,
		|	УпаковкиЕдиницыИзмерения.Ссылка КАК Упаковка
		|ПОМЕСТИТЬ вт_Упаковки
		|ИЗ
		|	Справочник.Номенклатура КАК Номенклатура
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.НаборыУпаковок КАК НаборыУпаковок
		|		ПО Номенклатура.НаборУпаковок = НаборыУпаковок.Ссылка
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.УпаковкиЕдиницыИзмерения КАК УпаковкиЕдиницыИзмерения
		|		ПО (НаборыУпаковок.Ссылка = УпаковкиЕдиницыИзмерения.Владелец)
		|ГДЕ
		|	НЕ Номенклатура.ЭтоГруппа
		|	И НЕ Номенклатура.ПометкаУдаления
		|	И Номенклатура.ТипНоменклатуры = ЗНАЧЕНИЕ(Перечисление.ТипыНоменклатуры.Товар)
		|	И Номенклатура.ИспользоватьУпаковки
		|	И НЕ Номенклатура.НаборУпаковок = ЗНАЧЕНИЕ(Справочник.НаборыУпаковок.ИндивидуальныйДляНоменклатуры)
		|	И Номенклатура.Ссылка В
		|			(ВЫБРАТЬ
		|				вт_ТаблицаНоменклатуры.Номенклатура
		|			ИЗ
		|				вт_ТаблицаНоменклатуры КАК вт_ТаблицаНоменклатуры)
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	Номенклатура.Ссылка,
		|	НаборыУпаковок.Ссылка,
		|	УпаковкиЕдиницыИзмерения.Ссылка
		|ИЗ
		|	Справочник.Номенклатура КАК Номенклатура
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.НаборыУпаковок КАК НаборыУпаковок
		|		ПО Номенклатура.НаборУпаковок = НаборыУпаковок.Ссылка
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.УпаковкиЕдиницыИзмерения КАК УпаковкиЕдиницыИзмерения
		|		ПО Номенклатура.Ссылка = УпаковкиЕдиницыИзмерения.Владелец
		|ГДЕ
		|	НЕ Номенклатура.ЭтоГруппа
		|	И НЕ Номенклатура.ПометкаУдаления
		|	И Номенклатура.ТипНоменклатуры = ЗНАЧЕНИЕ(Перечисление.ТипыНоменклатуры.Товар)
		|	И Номенклатура.ИспользоватьУпаковки
		|	И Номенклатура.НаборУпаковок = ЗНАЧЕНИЕ(Справочник.НаборыУпаковок.ИндивидуальныйДляНоменклатуры)
		|	И Номенклатура.Ссылка В
		|			(ВЫБРАТЬ
		|				вт_ТаблицаНоменклатуры.Номенклатура
		|			ИЗ
		|				вт_ТаблицаНоменклатуры КАК вт_ТаблицаНоменклатуры)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	вт_Упаковки.Номенклатура КАК Номенклатура,
		|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ вт_Упаковки.Упаковка) КАК Упаковка
		|ПОМЕСТИТЬ вт_КоличествоУпаковок
		|ИЗ
		|	вт_Упаковки КАК вт_Упаковки
		|
		|СГРУППИРОВАТЬ ПО
		|	вт_Упаковки.Номенклатура
		|
		|ИМЕЮЩИЕ
		|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ вт_Упаковки.Упаковка) = 1
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	вт_КоличествоУпаковок.Номенклатура КАК Номенклатура,
		|	вт_Упаковки.Упаковка КАК Упаковка
		|ПОМЕСТИТЬ вт_УпаковкаПоУмолчанию
		|ИЗ
		|	вт_КоличествоУпаковок КАК вт_КоличествоУпаковок
		|		ЛЕВОЕ СОЕДИНЕНИЕ вт_Упаковки КАК вт_Упаковки
		|		ПО вт_КоличествоУпаковок.Номенклатура = вт_Упаковки.Номенклатура
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	вт_ТаблицаНоменклатуры.Номенклатура КАК Номенклатура,
		|	ВЫБОР
		|		КОГДА вт_ТаблицаНоменклатуры.Упаковка = ЗНАЧЕНИЕ(Справочник.УпаковкиЕдиницыИзмерения.ПустаяСсылка)
		|				И НЕ вт_УпаковкаПоУмолчанию.Упаковка ЕСТЬ NULL
		|			ТОГДА вт_УпаковкаПоУмолчанию.Упаковка
		|		ИНАЧЕ вт_ТаблицаНоменклатуры.Упаковка
		|	КОНЕЦ КАК Упаковка,
		|	вт_ТаблицаНоменклатуры.Характеристика КАК Характеристика
		|ПОМЕСТИТЬ вт_ТаблицаНоменклатурыДополненная
		|ИЗ
		|	вт_ТаблицаНоменклатуры КАК вт_ТаблицаНоменклатуры
		|		ЛЕВОЕ СОЕДИНЕНИЕ вт_УпаковкаПоУмолчанию КАК вт_УпаковкаПоУмолчанию
		|		ПО вт_ТаблицаНоменклатуры.Номенклатура = вт_УпаковкаПоУмолчанию.Номенклатура
		|;" 
		
		+ ?(ИспользуетсяЦенообразование25,
		
		"
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ЦеныНоменклатурыСрезПоследних.Номенклатура КАК Номенклатура,
		|	ЦеныНоменклатурыСрезПоследних.ХарактеристикаЦО КАК Характеристика,
