//+ ИнфоСофт Стояк Ю.К. 29.05.2024 УА #65724
&НаСервере
Функция ПроверитьХарактеристики()
	
	ПоляАтрибутов = Элементы.ГруппаХарактеристики.ПодчиненныеЭлементы; 
	
	Для Каждого Стр Из Товары Цикл 
		
		Для Каждого Поле Из ПоляАтрибутов Цикл
						
			ЗначениеАтрибута = Стр[Поле.Имя]; 
			
			Если Не ЗначениеЗаполнено(ЗначениеАтрибута) Тогда
				Продолжить;	
			КонецЕсли;
			
			ИдАтрибута = Число(СтрРазделить(Поле.Имя, "_")[1]);
			ХарактеристикаЯМ = ХарактеристикаПоКоду(ИдАтрибута);
			
			Если ТипЗнч(ЗначениеАтрибута) = Тип("СписокЗначений") Тогда  
				
				МассивВыбранныхЗначений = ЗначениеАтрибута.ВыгрузитьЗначения(); 
				
				Для Каждого Значение Из МассивВыбранныхЗначений Цикл  
					
					Если ЗначениеЗаполнено(Значение) Тогда 
						
						Ограничение = ХарактеристикаЯМ.limitingParameterId;
						
						Если Ограничение <> 0 Тогда	
							
							ЗначениеРеквизитаОграничения = Стр["Атрибут_" + Формат(Ограничение, "ЧГ=0")];														
						
							КодЗначенияОграничения = ЗначениеРеквизитаОграничения.Код;
							МассивЗначений = ПолучитьКоды(КодЗначенияОграничения);
							
							КодЗначения = Значение.Код;
							
							ЭлементМассива = МассивЗначений.Найти(КодЗначения);
							
							Если Не ЗначениеЗаполнено(ЭлементМассива) Тогда
								ОбщегоНазначения.СообщитьПользователю("Значение " + Значение + " характеристики " +
								ХарактеристикаЯМ.Наименование + " не входит в список допустимых к выгрузке " +
								"из-за ограничения по текущему значению характеристики " + ЗначениеРеквизитаОграничения.Владелец);								
								Возврат Ложь;
							КонецЕсли;
							
						КонецЕсли;
						
					КонецЕсли;
					
				КонецЦикла; 
				
			Иначе 
				
				Если ЗначениеЗаполнено(ЗначениеАтрибута) Тогда 
					
					Ограничение = ХарактеристикаЯМ.limitingParameterId;
					
					Если Ограничение <> 0 Тогда	
						
						ЗначениеРеквизитаОграничения = Стр["Атрибут_" + Формат(Ограничение, "ЧГ=0")];
						
						КодЗначенияОграничения = ЗначениеРеквизитаОграничения.Код; 												
						МассивЗначений = ПолучитьКоды(КодЗначенияОграничения);
						
						КодЗначения = ЗначениеАтрибута.Код;
						
						ЭлементМассива = МассивЗначений.Найти(КодЗначения);
						
						Если Не ЗначениеЗаполнено(ЭлементМассива) Тогда
							ОбщегоНазначения.СообщитьПользователю("Значение " + Значение + " характеристики " +
							ХарактеристикаЯМ.Наименование + " не входит в список допустимых к выгрузке " +
							"из-за ограничения по текущему значению характеристики " + ЗначениеРеквизитаОграничения.Владелец);								
							Возврат Ложь;
						КонецЕсли;
						
					КонецЕсли;
					
				КонецЕсли;				
				
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЦикла;
	
	Возврат Истина;
	
КонецФункции //- ИнфоСофт Стояк Ю.К. 29.05.2024 УА #65724

