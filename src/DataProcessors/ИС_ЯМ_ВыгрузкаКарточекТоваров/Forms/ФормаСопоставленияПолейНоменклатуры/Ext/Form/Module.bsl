&НаСервере
Функция СоответствиеЗначенийЕдиницаИзмеренияНачалоВыбораНаСервере(ХарактеристикаЯМ)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ИС_ЯМ_Характеристикаunit.ЕдИзм КАК ЕдИзм
		|ИЗ
		|	Справочник.ИС_ЯМ_Характеристика.unit КАК ИС_ЯМ_Характеристикаunit
		|ГДЕ
		|	ИС_ЯМ_Характеристикаunit.Ссылка = &Ссылка";
	
	Запрос.УстановитьПараметр("Ссылка", ХарактеристикаЯМ);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Возврат РезультатЗапроса.Выгрузить().ВыгрузитьКолонку("ЕдИзм");

КонецФункции //- ИнфоСофт Стояк Ю.К. 28.05.2024 УА #65724 

//+ ИнфоСофт Стояк Ю.К. 28.05.2024 УА #65724
&НаКлиенте
Процедура ВыборЕдИзм(Результат, СтруктураПараметров) Экспорт

	Если Не ЗначениеЗаполнено(Результат) Тогда
		Возврат;
	КонецЕсли;

	ТекущаяСтрока = Элементы.СоответствиеЗначений.ТекущиеДанные;
	ТекущаяСтрока.ЕдиницаИзмерения 	 = Результат; 
	
	Если ЗначениеЗаполнено(ТекущаяСтрока.Реквизит1С) Тогда
		ДобавитьСопоставлениеХарактеристики(
			Категория, ТекущаяСтрока.ХарактеристикаЯМ, ТекущаяСтрока.ВидРеквизита1С, ТекущаяСтрока.Реквизит1С,
			ТекущаяСтрока.ФиксированноеЗначение, ТекущаяСтрока.ЕдиницаИзмерения);

		ТекущаяСтрока.СопоставленоЗначений = ТекстКоличествоСопоставленныхЗначений(
			Категория, ТекущаяСтрока.ХарактеристикаЯМ, ТекущаяСтрока.ВидРеквизита1С, ТекущаяСтрока.Реквизит1С,
			ТекущаяСтрока.ТребуетсяСопоставление);
	КонецЕсли;
	
	
КонецПроцедуры //- ИнфоСофт Стояк Ю.К. 28.05.2024 УА #65724

