&НаКлиенте
Процедура СоответствиеХарактеристикРеквизит1СОчистка(Элемент, СтандартнаяОбработка)

	//+ ИнфоСофт Стояк Ю.К. 02.04.2025 УА #97736	
	//ТекущаяСтрока = Элементы.СоответствиеХарактеристик.ТекущиеДанные;
	ТекущаяСтрока = Элементы.СоответствиеЗначений.ТекущиеДанные;
	//- ИнфоСофт Стояк Ю.К. 02.04.2025 УА #97736

	УдалитьСопоставлениеХарактеристики(Категория, ТекущаяСтрока.ХарактеристикаЯМ);

	ТекущаяСтрока.Реквизит1С 	 		= Неопределено;
	ТекущаяСтрока.ВидРеквизита1С 		= ПредопределенноеЗначение(
		"Перечисление.ИС_Ozon_ВидРеквизитаСопоставления.ПустаяСсылка");
	ТекущаяСтрока.ФиксированноеЗначение = Неопределено;

	ТекущаяСтрока.СопоставленоЗначений = ТекстКоличествоСопоставленныхЗначений(
		Категория, ТекущаяСтрока.ХарактеристикаЯМ, ТекущаяСтрока.ВидРеквизита1С, ТекущаяСтрока.Реквизит1С,
		ТекущаяСтрока.ТребуетсяСопоставление);

КонецПроцедуры //- ИнфоСофт Стояк Ю.К. 12.05.2024 УА #62574

