&НаКлиенте
Процедура ВыгрузитьТовары(Команда) 
	
	Если Не ЗначениеЗаполнено(Аккаунт) Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю("Не выбран профиль!");
		Возврат;
	КонецЕсли; 

	СтруктураПараметров = Новый Структура;
	СтруктураПараметров.Вставить("ЭтоДобавлениеТоваров", Истина);
	СтруктураПараметров.Вставить("Аккаунт", Аккаунт);

	ОткрытьФорму("Обработка.ИС_Ozon_ВыгрузкаКарточек.Форма.ФормаДобавленияТоваров", СтруктураПараметров, ЭтотОбъект);

