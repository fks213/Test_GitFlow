&НаСервереБезКонтекста
Функция ЕстьИспользуемыеКатегории()

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
	|	ИС_Ozon_КатегорииТоваров.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.ИС_Ozon_КатегорииТоваров КАК ИС_Ozon_КатегорииТоваров
	|ГДЕ
	|	ИС_Ozon_КатегорииТоваров.Используется = ИСТИНА
	|	И НЕ ИС_Ozon_КатегорииТоваров.ПометкаУдаления
	|	И НЕ ИС_Ozon_КатегорииТоваров.ЭтоГруппа";

	РезультатЗапроса = Запрос.Выполнить();

	Возврат Не РезультатЗапроса.Пустой();

КонецФункции

