&НаКлиенте
Процедура ЗагрузитьСOzon(ИмяКоманды)

	//ДлительнаяОперация = ЗагрузитьСOzonНаСервере(ИмяКоманды); 

	ДопПараметры = Новый Структура;
	ДопПараметры.Вставить("ИмяКоманды", ИмяКоманды);
	//Оповещение = Новый ОписаниеОповещения("ПослеЗавершенияЗагрузкиСOzon", ЭтотОбъект, ДопПараметры);

	//ПараметрыОжидания = БСП_ДлительныеОперацииКлиент.ПараметрыОжидания(ЭтотОбъект);
	//ПараметрыОжидания.ВыводитьСообщения = Истина;

	//БСП_ДлительныеОперацииКлиент.ОжидатьЗавершение(ДлительнаяОперация, Оповещение, ПараметрыОжидания);   
	
	ДлительнаяОперация = ЗагрузитьСOzonНаСервере(ИмяКоманды); 
		
	ОповещениеОЗавершении = Новый ОписаниеОповещения("ПослеЗавершенияЗагрузкиСOzon", ЭтотОбъект, ДопПараметры);
	ДлительныеОперацииКлиент.ОжидатьЗавершение(ДлительнаяОперация, ОповещениеОЗавершении, ПараметрыОжидания());

КонецПроцедуры

&НаСервере
Функция ЗагрузитьСOzonНаСервере(ИмяКоманды) 
	
	ПараметрыВыполнения = ДлительныеОперации.ПараметрыВыполненияВФоне(УникальныйИдентификатор);

	Если ИмяКоманды = "ЗагрузитьКатегориТоваровСOzon" Тогда		
		Возврат ДлительныеОперации.ВыполнитьПроцедуру(ПараметрыВыполнения,
		"ИС_Ozon_Сервер.ЗагрузитьКатегорииТоваров",
		Аккаунт);
		
	ИначеЕсли ИмяКоманды = "ЗагрузитьХарактеристикиКатегорийСOzon" Тогда
		Возврат ДлительныеОперации.ВыполнитьПроцедуру(ПараметрыВыполнения,
		"ИС_Ozon_Сервер.ЗагрузитьХарактеристикиКатегорий",
		Аккаунт);
		
	ИначеЕсли ИмяКоманды = "ЗагрузитьЗначенияХарактеристикСOzon" Тогда		
		Возврат ДлительныеОперации.ВыполнитьПроцедуру(ПараметрыВыполнения,
		"ИС_Ozon_Сервер.ЗагрузитьЗначенияХарактеристик",
		Аккаунт, Неопределено, Неопределено, ЗагружатьЗначенияНеобязательныхХарактеристик);
		
	КонецЕсли;
	
	Возврат Неопределено;
	
КонецФункции

