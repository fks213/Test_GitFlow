&НаКлиенте
Процедура ОткрытьПодбор(Команда)

	Если Не ЗначениеЗаполнено(Категория) Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю("Не заполнена Категория товаров", , "Категория");
		Возврат;
	КонецЕсли;

	ПараметрыФормыПодбораТоваров = ПараметрыФормыПодбораТоваров(Аккаунт, Валюта,
		УникальныйИдентификатор, Price);

	Оповещение = Новый ОписаниеОповещения("ПослеЗакрытияПодбора", ЭтотОбъект);
	ОткрытьФорму(ПараметрыФормыПодбораТоваров.ИмяФормы, ПараметрыФормыПодбораТоваров.ПараметрыФормы, ЭтотОбъект, , , ,
		Оповещение);

КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьКолонкуТекущимЗначением(Команда)

	ТекущиеДанные 	= Элементы.Товары.ТекущиеДанные;
	ИмяКолонки 		= Элементы.Товары.ТекущийЭлемент.Имя;

	ЭтоСписок = ТипЗнч(ТекущиеДанные[ИмяКолонки]) = Тип("СписокЗначений");
	Если ЭтоСписок Тогда
		Значение = ТекущиеДанные[ИмяКолонки].ВыгрузитьЗначения();
	Иначе
		Значение = ТекущиеДанные[ИмяКолонки];
	КонецЕсли;

	Для Каждого стр Из Товары Цикл

		Если ЭтоСписок Тогда
			стр[ИмяКолонки].ЗагрузитьЗначения(Значение);
		Иначе
			стр[ИмяКолонки] = Значение;
		КонецЕсли;

		Если Не (ИмяКолонки = "FBO" Или ИмяКолонки = "FBS" Или ИмяКолонки = "RFBS" Или ИмяКолонки = "ОУД") Тогда
			стр.ИзменилсяТовар 	= Истина;
		КонецЕсли;

	КонецЦикла;

	//Если (ИмяКолонки = "FBS" Или ИмяКолонки = "RFBS") И Значение = Ложь Тогда
	//	ВопросОбнулитьОстаткиНаOzon( , ИмяКолонки = "RFBS");
	//КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьКолонкуСопоставленнымиЗначениями(Команда)

	ИмяКолонки = Элементы.Товары.ТекущийЭлемент.Имя;
	Если Не ЭтоДобавлениеТоваров И ИмяКолонки = "Артикул" Тогда
		Возврат;
	КонецЕсли;

	ЗаполнитьКолонкуСопоставленнымиЗначениямиНаСервере(ИмяКолонки);

КонецПроцедуры

