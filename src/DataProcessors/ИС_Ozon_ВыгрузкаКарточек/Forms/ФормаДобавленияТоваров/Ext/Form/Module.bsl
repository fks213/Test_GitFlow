&НаСервере
Процедура ИнициализироватьХарактеристики()

	УдалитьХарактеристики();

	Элементы.ГруппаШапкаПредупреждение.Видимость = Ложь;

	Если ЗначениеЗаполнено(Категория) Тогда

		Если ИС_Ozon_Сервер.ХарактеристикиКатегорииНеЗагружены(Категория) Тогда

			Элементы.ГруппаШапкаПредупреждение.Видимость 	= Истина;
			Элементы.ГруппаТаблица.Доступность 				= Ложь;
			Элементы.СохранитьТовары.Доступность 			= Ложь;

		Иначе

			Элементы.ГруппаТаблица.Доступность 		= Истина;
			Элементы.СохранитьТовары.Доступность 	= Истина;
			ИмяТабличнойЧасти = "Товары";

			ОбязательныеХарактеристики 	= Новый Массив;
			АспектныеХарактеристики 	= Новый Массив;

			Запрос = Новый Запрос;
			Запрос.Текст =
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	Ozon_Характеристики.Наименование КАК Наименование,
			|	Ozon_Характеристики.Описание КАК Описание,
			|	Ozon_Характеристики.ИДСправочникаЗначенийХарактеристики КАК ИДСправочникаЗначенийХарактеристики,
			|	Ozon_Характеристики.НаборЗначений КАК НаборЗначений,
			|	Ozon_Характеристики.ТипХарактеристики КАК ТипХарактеристики,
			|	Ozon_КатегорииТоваровХарактеристики.Обязательная КАК Обязательная,
			|	Ozon_Характеристики.Код КАК Код,
			|	Ozon_КатегорииТоваровХарактеристики.Аспектная
			|ИЗ
			|	Справочник.ИС_Ozon_КатегорииТоваров.Характеристики КАК Ozon_КатегорииТоваровХарактеристики
			|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ИС_Ozon_Характеристики КАК Ozon_Характеристики
			|		ПО Ozon_КатегорииТоваровХарактеристики.Характеристика = Ozon_Характеристики.Ссылка
			|ГДЕ
			|	Ozon_КатегорииТоваровХарактеристики.Ссылка = &Категория
			|	И НЕ Ozon_КатегорииТоваровХарактеристики.НеИспользовать
			|
			|УПОРЯДОЧИТЬ ПО
			|	Обязательная УБЫВ";

			Запрос.УстановитьПараметр("Категория", Категория);

			РезультатЗапроса = Запрос.Выполнить();

			Выборка = РезультатЗапроса.Выбрать();
			//@skip-check new-color
			ЦветФона = Новый Цвет(255, 255, 255);
			//@skip-check new-color
			ЦветФонаАспектный = Новый Цвет(0, 150, 70);
			
			Пока Выборка.Следующий() Цикл

				ИмяРеквизита 		= "Атрибут_" + Формат(Выборка.Код, "ЧГ=0");
				МножественныйВыбор  = Выборка.НаборЗначений;
				ТипРеквизита 		= ИС_Ozon_Сервер.ТипРеквизита(Выборка.ТипХарактеристики,
					МножественныйВыбор, Выборка.ИДСправочникаЗначенийХарактеристики > 0);
				ПутьКДанным  		= ?(ИмяТабличнойЧасти = "", ИмяРеквизита, ИмяТабличнойЧасти + "." + ИмяРеквизита);
				СоздатьРеквизитФормы(ИмяРеквизита, ТипРеквизита, Выборка.Наименование, ИмяТабличнойЧасти);

				Если Выборка.Обязательная Тогда
					ОбязательныеХарактеристики.Добавить(ИмяРеквизита);
				КонецЕсли;
				
				Если Выборка.Аспектная Тогда
					АспектныеХарактеристики.Добавить(ИмяРеквизита);
					СоздатьПолеФормы(Выборка, ИмяРеквизита, ПутьКДанным, МножественныйВыбор, ЦветФонаАспектный);
				Иначе
					СоздатьПолеФормы(Выборка, ИмяРеквизита, ПутьКДанным, МножественныйВыбор, ЦветФона);
				КонецЕсли;
				
				Если Выборка.Наименование = "Объединить на одной карточке" Тогда
					КолонкаОбъединитьНаОднойКарточке = ИмяРеквизита;	
				КонецЕсли;
				
			КонецЦикла;

			СписокОбязательныхХарактеристик = Новый ФиксированныйМассив(ОбязательныеХарактеристики);
			СписокАспектныхХарактеристик 	= Новый ФиксированныйМассив(АспектныеХарактеристики);
		КонецЕсли;

	КонецЕсли;

КонецПроцедуры

&НаСервере
Процедура УдалитьХарактеристики()

	ЭлементыХарактеристик = Элементы.ГруппаХарактеристики.ПодчиненныеЭлементы;

	УдаляемыеПоля = Новый Массив;
	УдаляемыеРеквизиты = Новый Массив;

	Для Каждого Элемент Из ЭлементыХарактеристик Цикл
		УдаляемыеПоля.Добавить(Элемент);
		УдаляемыеРеквизиты.Добавить(Элемент.ПутьКДанным);
	КонецЦикла;

	Для Каждого Элемент Из УдаляемыеПоля Цикл
		Элементы.Удалить(Элемент);
	КонецЦикла;

	ИзменитьРеквизиты( , УдаляемыеРеквизиты);

КонецПроцедуры

&НаСервере
Процедура СоздатьРеквизитФормы(ИмяРеквизита, Тип, ЗаголовокПоля = "", ИмяТабличнойЧасти = "")

	ДобавляемыеРеквизиты = Новый Массив;

	ИмяРеквизита = ИмяРеквизита;
	НовыйРеквизит = Новый РеквизитФормы(ИмяРеквизита, Тип, ИмяТабличнойЧасти, ЗаголовокПоля);
	ДобавляемыеРеквизиты.Добавить(НовыйРеквизит);

	ИзменитьРеквизиты(ДобавляемыеРеквизиты);

КонецПроцедуры


&НаСервере
Процедура СоздатьПолеФормы(Выборка, ИмяРеквизита, ПутьКДанным, МножественныйВыбор, ЦветФона)

	ГруппаФормы = Элементы.ГруппаХарактеристики;
	type 		= НРег(Выборка.ТипХарактеристики);
	ВидПоля		= ВидПоля(type);
	НовыйЭлемент = Элементы.Добавить(ИмяРеквизита, Тип("ПолеФормы"), ГруппаФормы);
	НовыйЭлемент.ПутьКДанным 	= ПутьКДанным;
	НовыйЭлемент.Вид 			= ВидПоля;
	НовыйЭлемент.Заголовок		= Выборка.Наименование + ?(Выборка.Обязательная, "*", "");
	
	// Оформление
	НовыйЭлемент.ПоложениеЗаголовка = ПоложениеЗаголовкаЭлементаФормы.Верх;
	Подсказка = Новый ФорматированнаяСтрока(Выборка.Описание, Новый Шрифт(, 10, Истина));
	НовыйЭлемент.РасширеннаяПодсказка.Заголовок = Подсказка;
	НовыйЭлемент.ОтображениеПодсказки 			= ОтображениеПодсказки.Кнопка;
	НовыйЭлемент.ЦветФонаЗаголовка 				= ЦветФона;
	Если type = "multiline" Тогда
		НовыйЭлемент.МногострочныйРежим 	= Истина;
		НовыйЭлемент.Высота 				= 1;
		НовыйЭлемент.РастягиватьПоВертикали = Ложь;
	КонецЕсли;

	Если Не НовыйЭлемент.Вид = ВидПоляФормы.ПолеФлажка Тогда
		НовыйЭлемент.РастягиватьПоГоризонтали 	= Истина;
		НовыйЭлемент.АвтоМаксимальнаяШирина 	= Ложь;
		НовыйЭлемент.АвтоОтметкаНезаполненного 	= Выборка.Обязательная;
		НовыйЭлемент.КнопкаОчистки 	= Истина;
	КонецЕсли;
	
	// Выбор из списка
	Если Выборка.ИДСправочникаЗначенийХарактеристики > 0 И Не МножественныйВыбор И Не type = "boolean" Тогда
		НовыйЭлемент.КнопкаВыбора 				= Истина;
		НовыйЭлемент.ОтображениеКнопкиВыбора 	= ОтображениеКнопкиВыбора.ОтображатьВПолеВвода;
		НовыйЭлемент.ИсторияВыбораПриВводе  	= ИсторияВыбораПриВводе.НеИспользовать;
		НовыйЭлемент.КнопкаВыпадающегоСписка 	= Ложь;
		НовыйЭлемент.КнопкаСоздания 			= Ложь;
		НовыйЭлемент.КнопкаОткрытия 			= Ложь;
		НовыйЭлемент.РедактированиеТекста 		= Ложь;
		НовыйЭлемент.УстановитьДействие("НачалоВыбора", "ХарактеристикаНачалоВыбора");
	КонецЕсли;

	НовыйЭлемент.УстановитьДействие("ПриИзменении", "ХарактеристикаПриИзменении");

	Если МножественныйВыбор Тогда
		НовыйЭлемент.УстановитьДействие("НачалоВыбора", "ХарактеристикаНачалоМножественногоВыбора");
		НовыйЭлемент.УстановитьДействие("ОбработкаВыбора", "ХарактеристикаОбработкаМножественногоВыбора");
		НовыйЭлемент.КнопкаВыбора 	= Истина;
	КонецЕсли;

КонецПроцедуры

&НаСервере
Процедура ЗаполнитьЗначенияАтрибутов(ОбъектЗаполнения, Атрибуты, КомплексныеАтрибуты, СоответствиеАтрибутов, СоответствиеЗначенийАтрибутов)

	Если ЗначениеЗаполнено(Атрибуты) Тогда
//		ЗначенияАтрибутов = Ozon_ИнтернетЗапросыВызовСервера.ПреобразоватьJSONВСоответствие(Атрибуты);
		ЗаполнитьАтрибуты(ОбъектЗаполнения, Атрибуты, СоответствиеАтрибутов, СоответствиеЗначенийАтрибутов);
	КонецЕсли;

	Если ЗначениеЗаполнено(КомплексныеАтрибуты) Тогда
//		ЗначенияКомплексныхАтрибутов = Ozon_ИнтернетЗапросыВызовСервера.ПреобразоватьJSONВСоответствие(КомплексныеАтрибуты);
		ЗаполнитьКомплексныеАтрибуты(ОбъектЗаполнения, КомплексныеАтрибуты, СоответствиеАтрибутов, СоответствиеЗначенийАтрибутов);
	КонецЕсли;

КонецПроцедуры

&НаСервере
Процедура ЗаполнитьАтрибуты(ОбъектЗаполнения, ЗначенияАтрибутов, СоответствиеАтрибутов, СоответствиеЗначенийАтрибутов)

	Для Каждого Атрибут Из ЗначенияАтрибутов Цикл

		Значения = Атрибут.Получить("values");
		Если Значения.Количество() Тогда

			ИмяРеквизита = "Атрибут_" + Формат(Атрибут.Получить("attribute_id"), "ЧГ=0");
			Попытка

				Если ТипЗнч(ОбъектЗаполнения[ИмяРеквизита]) = Тип("СписокЗначений") Тогда
					ОбъектЗаполнения[ИмяРеквизита].ЗагрузитьЗначения(ЗначениеАтрибута(Атрибут, СоответствиеАтрибутов, СоответствиеЗначенийАтрибутов));
				Иначе
					Значение = ЗначениеАтрибута(Атрибут, СоответствиеАтрибутов, СоответствиеЗначенийАтрибутов);
					УстанавливаемоеЗначение = Значение[0];
					Если ТипЗнч(УстанавливаемоеЗначение) = Тип("Строка") И (СтрНайти(НРег(УстанавливаемоеЗначение),
						"<br>") > 0 Или СтрНайти(НРег(УстанавливаемоеЗначение), "<br/>") > 0 Или СтрНайти(НРег(
						УстанавливаемоеЗначение), "</br>") > 0) Тогда
						УстанавливаемоеЗначение = ИС_Ozon_Сервер.ПреобразоватьHTMLВМногострочныйТекст(
							УстанавливаемоеЗначение);
					КонецЕсли;
					ОбъектЗаполнения[ИмяРеквизита] = УстанавливаемоеЗначение;
				КонецЕсли;

			Исключение

				Продолжить;

			КонецПопытки;

		КонецЕсли;

	КонецЦикла;

КонецПроцедуры

&НаСервере
Процедура ЗаполнитьКомплексныеАтрибуты(ОбъектЗаполнения, ЗначенияКомплексныхАтрибутов, СоответствиеАтрибутов, СоответствиеЗначенийАтрибутов)

	Для Каждого МассивАтрибутов Из ЗначенияКомплексныхАтрибутов Цикл
