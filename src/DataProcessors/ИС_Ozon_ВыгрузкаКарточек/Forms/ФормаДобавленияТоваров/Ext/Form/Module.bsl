&НаСервере
Процедура ЗаполнитьТовары(МассивРедактируемыхТоваров)

	Для Каждого СтруктураТовара Из МассивРедактируемыхТоваров Цикл
		стрТовары = Товары.Добавить();
		ЗаполнитьЗначенияСвойств(стрТовары, СтруктураТовара);
		Если ЗначениеЗаполнено(стрТовары.images) Тогда
			стрТовары.Изображения.ЗагрузитьЗначения(ПреобразоватьJSONВСоответствие(
				стрТовары.images));
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

&НаСервере
Процедура ЗаполнитьЗависимыРеквизиты(ИДСтроки)

	ТаблицаНоменклатуры = ТаблицаЗначенийНоменклатуры();

	ТекущаяСтрока = Товары.НайтиПоИдентификатору(ИДСтроки);

	СтрНоменклатуры = ТаблицаНоменклатуры.Добавить();
	СтрНоменклатуры.Номенклатура 	= ТекущаяСтрока.Номенклатура;
	СтрНоменклатуры.Характеристика 	= ТекущаяСтрока.ХарактеристикаНоменклатуры;
	СтрНоменклатуры.Упаковка 		= ТекущаяСтрока.Упаковка;

	ТаблицаТоваров = ПолучитьДанныеПоНоменклатуре(ТаблицаНоменклатуры);
	ЕстьНастройкиОсновныхРеквизитовДляКатегории = ИС_Ozon_Сервер.ЕстьНастройкиОсновныхРеквизитовДляКатегории(
		Категория);

	Если ТаблицаТоваров.Количество() Тогда
		ЗаполнитьСтрокуТовара(ТекущаяСтрока, ТаблицаТоваров[0],
			ИС_Ozon_Сервер.ТаблицаСоответствийДопРеквизитов(Категория,
			ЕстьНастройкиОсновныхРеквизитовДляКатегории),
			ИС_Ozon_Сервер.СтруктураПараметровЗначенийРеквизитовНоменклатуры(Категория,
			ЕстьНастройкиОсновныхРеквизитовДляКатегории),
			ИС_Ozon_Сервер.СтруктураПараметровЗначенийРеквизитовХарактеристикиНоменклатуры(Категория,
			ЕстьНастройкиОсновныхРеквизитовДляКатегории));
	КонецЕсли;

КонецПроцедуры

&НаСервере
Функция ПолучитьДанныеПоНоменклатуре(ТаблицаНоменклатуры)

	СтруктураПараметров = Новый Структура;
	СтруктураПараметров.Вставить("ТаблицаНоменклатуры", ТаблицаНоменклатуры);
	СтруктураПараметров.Вставить("Price", Price);
	СтруктураПараметров.Вставить("Old_price", Old_price);
	СтруктураПараметров.Вставить("Min_price", Min_price);
	СтруктураПараметров.Вставить("Аккаунт", Аккаунт);
	СтруктураПараметров.Вставить("Категория", Категория);
	СтруктураПараметров.Вставить("ВалютаПродажиНаOzon", ВалютаПродажиНаOzon);

	ТаблицаТоваров = ЗависимыеРеквизитыНоменклатуры(СтруктураПараметров);

	Возврат ТаблицаТоваров;

КонецФункции

&НаСервере
Процедура ЗаполнитьСтрокуТовара(СтрокаТаблицы, ДанныеЗаполнения, ТаблицаСоответствийЗначений,
	
	СтруктураПараметровЗначенийРеквизитовНоменклатуры, СтруктураПараметровЗначенийРеквизитовХарактеристикиНоменклатуры)
	
	Ozon_Константы = ИС_Ozon_Сервер.ПолучитьНастройкиСопоставления();
	РазделительФотографий = Ozon_Константы.РазделительФотографий;
	
	//Ozon_Константы = Ozon_КонстантыВызовСервера.ПрочитатьКонстанты();
	//РазделительФотографий = Ozon_Константы.ЗначенияПоИменам.РазделительФотографий;

	СоответствиеСтавокНДС = ИС_Ozon_Сервер.СоответствиеСтавокНДС();

	СтрокаТаблицы.Номенклатура 					= ДанныеЗаполнения.Номенклатура;
	СтрокаТаблицы.Упаковка 						= ДанныеЗаполнения.Упаковка;
	СтрокаТаблицы.ХарактеристикаНоменклатуры 	= ДанныеЗаполнения.Характеристика;
	СтрокаТаблицы.Артикул						= "";
	СтрокаТаблицы.Штрихкод 						= ДанныеЗаполнения.Штрихкод;
	СтрокаТаблицы.СтавкаНДС 					= СоответствиеСтавокНДС.Получить(ДанныеЗаполнения.СтавкаНДС);
	СтрокаТаблицы.product_id 					= ДанныеЗаполнения.product_id;
	СтрокаТаблицы.Цена							= ДанныеЗаполнения.Цена;
	СтрокаТаблицы.ЦенаДоСкидки					= ДанныеЗаполнения.ЦенаДоСкидки;
	СтрокаТаблицы.ЦенаМинимальная 				= ДанныеЗаполнения.ЦенаМинимальная;
	СтрокаТаблицы.ДлинаУпаковки 				= Макс(ДанныеЗаполнения.Высота, ДанныеЗаполнения.Глубина,
		ДанныеЗаполнения.Ширина);
	СтрокаТаблицы.ВысотаУпаковки 				= Мин(ДанныеЗаполнения.Высота, ДанныеЗаполнения.Глубина,
		ДанныеЗаполнения.Ширина);
	СтрокаТаблицы.ШиринаУпаковки 				= (ДанныеЗаполнения.Высота + ДанныеЗаполнения.Глубина
		+ ДанныеЗаполнения.Ширина) - (СтрокаТаблицы.ДлинаУпаковки + СтрокаТаблицы.ВысотаУпаковки);
	СтрокаТаблицы.ВесУпаковки 					= ДанныеЗаполнения.ВесУпаковки;
	СтрокаТаблицы.ИспользоватьХарактеристики 	= ДанныеЗаполнения.ИспользоватьХарактеристики;
	СтрокаТаблицы.ИспользоватьУпаковки 			= ДанныеЗаполнения.ИспользоватьУпаковки;
	СтрокаТаблицы.FBO 							= СхемаПродажFBO;
	СтрокаТаблицы.FBS 							= СхемаПродажFBS;
	СтрокаТаблицы.RFBS 							= СхемаПродажRFBS;

	Если ДанныеЗаполнения.product_id = 0 Тогда
		ИС_Ozon_Сервер.ЗаполнитьЗначенияПоДопРеквизитам(СтрокаТаблицы, ТаблицаСоответствийЗначений,
			РазделительФотографий);
		ИС_Ozon_Сервер.ЗаполнитьЗначенияПоРеквизитамНоменклатуры(СтрокаТаблицы,
			СтруктураПараметровЗначенийРеквизитовНоменклатуры, РазделительФотографий);
		ИС_Ozon_Сервер.ЗаполнитьЗначенияПоРеквизитамХарактеристикиНоменклатуры(СтрокаТаблицы,
			СтруктураПараметровЗначенийРеквизитовХарактеристикиНоменклатуры, РазделительФотографий);
	Иначе
		СтрокаТаблицы.Артикул = ДанныеЗаполнения.offer_id;
		ЗаполнитьАтрибутыСтрокиПоДаннымOzon(ДанныеЗаполнения.product_id);
	КонецЕсли;

	Если СтрокаТаблицы.Артикул = "" Тогда
		СтрокаТаблицы.Артикул = ИС_Ozon_Сервер.Артикул(ДанныеЗаполнения.Номенклатура,
			ДанныеЗаполнения.Характеристика, ДанныеЗаполнения.Упаковка);
	КонецЕсли;

КонецПроцедуры

&НаСервере
Процедура ЗаполнитьАтрибутыТоваров()

	МассивProduct_id = Товары.Выгрузить().ВыгрузитьКолонку("product_id");
	//НастройкиАккаунта = Ozon_ОбщегоНазначенияВызовСервера.НастройкиАккаунта(Аккаунт);
	НастройкиСоединения = ИС_Ozon_СерверПовтИсп.ПолучитьНастройкиСоединения(Аккаунт);
		
	Если НастройкиСоединения = Неопределено Тогда
		ВызватьИсключение("Не удалось получить настройки подключения, проверьте настройки авторизации");
	КонецЕсли;  
		
	ПараметрыЗапроса = ИС_MP_РаботаСHTTPЗапросамиСервер.ПолучитьСтруктуруHTTPЗапроса();
	РезультатПроверки = ПроверитьИЗаполнитьПараметрыЗапроса(ПараметрыЗапроса, НастройкиСоединения);
	
	СоответствиеАтрибутов = Новый Соответствие();
	СоответствиеЗначенийАтрибутов = Новый Соответствие();	
	
	// Заполняем за раз по 50 товаров, при разовом заполнении 100 товаров переполняется стек от объема информации
	// из-за ошибки в методе API не возвращается last_id и не работает limit.
	НомерЗапроса = 1;
	Пока Истина Цикл
		
		СрезПоТоварам = ИС_Ozon_Сервер.СрезМассива(МассивProduct_id, НомерЗапроса);
		Если Не ЗначениеЗаполнено(СрезПоТоварам) Тогда
			Прервать;
		КонецЕсли;
		
		Атрибуты = ИС_Ozon_API.ПолучитьАтрибутыТоваров(ПараметрыЗапроса, , СрезПоТоварам);
		Для Каждого Атрибут Из Атрибуты Цикл
	
			стрТовары = Товары.НайтиСтроки(Новый Структура("product_id", Атрибут.id))[0];
	
			стрТовары.ВесУпаковки			= Атрибут.weight;
			стрТовары.ДлинаУпаковки			= Атрибут.depth;
			стрТовары.ШиринаУпаковки		= Атрибут.width;
			стрТовары.ВысотаУпаковки		= Атрибут.height;
			стрТовары.МаркетинговыйЦвет		= Атрибут.color_image;
	
			ЗаполнитьЗначенияАтрибутов(стрТовары, Атрибут.attributes, Атрибут.complex_attributes,
				СоответствиеАтрибутов, СоответствиеЗначенийАтрибутов);
	
		КонецЦикла;
		
		НомерЗапроса = НомерЗапроса + 1;
		
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьАтрибутыСтрокиПоДаннымOzon(product_id)

	МассивProduct_id = Новый Массив;
	МассивProduct_id.Добавить(product_id);

	//НастройкиАккаунта = Ozon_ОбщегоНазначенияВызовСервера.НастройкиАккаунта(Аккаунт);
	НастройкиСоединения = ИС_Ozon_СерверПовтИсп.ПолучитьНастройкиСоединения(Аккаунт);
		
	Если НастройкиСоединения = Неопределено Тогда
		ВызватьИсключение("Не удалось получить настройки подключения, проверьте настройки авторизации");
	КонецЕсли;  
		
	ПараметрыЗапроса = ИС_MP_РаботаСHTTPЗапросамиСервер.ПолучитьСтруктуруHTTPЗапроса();
	РезультатПроверки = ПроверитьИЗаполнитьПараметрыЗапроса(ПараметрыЗапроса, НастройкиСоединения);

	СоответствиеСтавокНДС 	= ИС_Ozon_Сервер.СоответствиеСтавокНДС();

	стрТовары = Товары.НайтиСтроки(Новый Структура("product_id", product_id))[0]; 

	ДанныеПоТовару = ИС_Ozon_API.ПолучитьСписокТоваров(Аккаунт, ПараметрыЗапроса, Новый Структура("product_id", МассивProduct_id));
	Для Каждого Товар Из ДанныеПоТовару.Получить("items") Цикл

		стрТовары.Название 			= Товар.Получить("name");
		стрТовары.Штрихкод 			= Товар.Получить("barcode");
		стрТовары.Цена 				= Товар.Получить("price");
		стрТовары.ЦенаДоСкидки 		= Товар.Получить("old_price");
		стрТовары.СтавкаНДС 		= СоответствиеСтавокНДС.Получить(Товар.Получить("vat"));
		стрТовары.СсылкаНаГлавноеФото	= Товар.Получить("primary_image");
		стрТовары.МаркетинговыйЦвет		= Товар.Получить("color_image");
		стрТовары.images 				= ПреобразоватьДанныеВJSON(Товар.Получить(
			"images"));
		стрТовары.Изображения.ЗагрузитьЗначения(ПреобразоватьJSONВСоответствие(
			стрТовары.images));

	КонецЦикла;

	СоответствиеАтрибутов = Новый Соответствие();
	СоответствиеЗначенийАтрибутов = Новый Соответствие();
		
	Атрибуты = ИС_Ozon_API.ПолучитьАтрибутыТоваров(ПараметрыЗапроса, , МассивProduct_id);
	Для Каждого Атрибут Из Атрибуты Цикл

		стрТовары.ВесУпаковки			= Атрибут.Получить("weight");
		стрТовары.ДлинаУпаковки			= Атрибут.Получить("depth");
		стрТовары.ШиринаУпаковки		= Атрибут.Получить("width");
		стрТовары.ВысотаУпаковки		= Атрибут.Получить("height");

		ЗаполнитьЗначенияАтрибутов(стрТовары, Атрибут.Получить("attributes"), Атрибут.Получить("complex_attributes"),
			СоответствиеАтрибутов, СоответствиеЗначенийАтрибутов);

	КонецЦикла;

КонецПроцедуры

