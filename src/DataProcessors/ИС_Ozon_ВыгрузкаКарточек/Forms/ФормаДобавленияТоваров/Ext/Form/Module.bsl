&НаКлиенте
Процедура ТоварыПередНачаломДобавления(Элемент, Отказ, Копирование, Родитель, Группа, Параметр)

	Если Не КатегорияЗаполнена() Тогда
		Отказ = Истина;
		Возврат;
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ТоварыПриНачалеРедактирования(Элемент, НоваяСтрока, Копирование)

	Если Копирование = Истина Тогда
		ИДСтроки = Элементы.Товары.ТекущаяСтрока;
		ТекущаяСтрока = Товары.НайтиПоИдентификатору(ИДСтроки);
		ТекущаяСтрока.Артикул = "";
		ЗаполнитьЗависимыРеквизиты(ИДСтроки);
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ИзображенияНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)

	СтандартнаяОбработка = Ложь;
	ТекущаяСтрока = Элементы.Товары.ТекущиеДанные;
	ВыбранныеЗначения = ТекущаяСтрока[Элемент.Имя].ВыгрузитьЗначения();

	СтруктураПараметров = Новый Структура;
	СтруктураПараметров.Вставить("ВыбранныеЗначения", ВыбранныеЗначения);

	ОткрытьФорму("Обработка.ИС_Ozon_ВыгрузкаКарточек.Форма.ФормаМножественногоВыбораАтрибута", СтруктураПараметров, Элемент, , , , ,
		РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);

КонецПроцедуры

