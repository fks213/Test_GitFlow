&НаСервере
Функция ЗначениеАтрибута(Атрибут, СоответствиеАтрибутов, СоответствиеЗначенийАтрибутов)

	Характеристика = СоответствиеАтрибутов.Получить(Атрибут.Получить("attribute_id"));
	Если Характеристика = Неопределено Тогда
		Характеристика = Справочники.ИС_Ozon_Характеристики.НайтиПоКоду(Атрибут.Получить("attribute_id"));
		СоответствиеАтрибутов.Вставить(Атрибут.Получить("attribute_id"), Характеристика);
	КонецЕсли;
	
	Результат = Новый Массив;

	Значения = Атрибут.Получить("values");
	Для Каждого Значение Из Значения Цикл
		ЗначениеСправочника = Неопределено;
		
		Если Значение.Получить("dictionary_value_id") > 0 Тогда
			
			ЗначенияАтрибутовХарактеристики = СоответствиеЗначенийАтрибутов.Получить(Характеристика);
			Если ЗначенияАтрибутовХарактеристики <> Неопределено Тогда
				ЗначениеСправочника = ЗначенияАтрибутовХарактеристики.Получить(Значение.Получить("dictionary_value_id"));	
			Иначе
				СоответствиеЗначенийАтрибутов.Вставить(Характеристика, Новый Соответствие);
			КонецЕсли;
			
			Если ЗначениеСправочника = Неопределено Тогда	
				
				ЗначениеСправочника = Справочники.ИС_Ozon_ЗначенияХарактеристик.НайтиПоКоду(Значение.Получить(
					"dictionary_value_id"), , , Характеристика);
				
				СоответствиеЗначенийАтрибутов.Получить(Характеристика)
					.Вставить(Значение.Получить("dictionary_value_id"), ЗначениеСправочника);
				
			КонецЕсли;
		КонецЕсли;

		Если ЗначениеЗаполнено(ЗначениеСправочника) Тогда
			Результат.Добавить(ЗначениеСправочника);
		Иначе
			Результат.Добавить(Значение.Получить("value"));
		КонецЕсли;

	КонецЦикла;

	Возврат Результат;

КонецФункции

&НаСервере
Процедура ЗаполнитьКолонкуСопоставленнымиЗначениямиНаСервере(ИмяКолонки)

	ЕстьНастройкиОсновныхРеквизитовДляКатегории = ИС_Ozon_Сервер.ЕстьНастройкиОсновныхРеквизитовДляКатегории(
		Категория);
	ТаблицаСоответствийЗначений = ИС_Ozon_Сервер.ТаблицаСоответствийДопРеквизитов(Категория,
		ЕстьНастройкиОсновныхРеквизитовДляКатегории);
	СтруктураПараметровЗначенийРеквизитовНоменклатуры = ИС_Ozon_Сервер.СтруктураПараметровЗначенийРеквизитовНоменклатуры(
		Категория, ЕстьНастройкиОсновныхРеквизитовДляКатегории);
	СтруктураПараметровЗначенийРеквизитовХарактеристикиНоменклатуры = ИС_Ozon_Сервер.СтруктураПараметровЗначенийРеквизитовХарактеристикиНоменклатуры(
		Категория, ЕстьНастройкиОсновныхРеквизитовДляКатегории);
		
	Ozon_Константы = ИС_Ozon_Сервер.ПолучитьНастройкиСопоставления();
	РазделительФотографий = Ozon_Константы.РазделительФотографий;
	//Ozon_Константы = Ozon_КонстантыВызовСервера.ПрочитатьКонстанты();
	//РазделительФотографий = Ozon_Константы.ЗначенияПоИменам.РазделительФотографий;

	Для Каждого СтрокаТаблицы Из Товары Цикл

		ИС_Ozon_Сервер.ЗаполнитьЗначенияПоДопРеквизитам(СтрокаТаблицы, ТаблицаСоответствийЗначений,
			РазделительФотографий, ИмяКолонки);
		ИС_Ozon_Сервер.ЗаполнитьЗначенияПоРеквизитамНоменклатуры(СтрокаТаблицы,
			СтруктураПараметровЗначенийРеквизитовНоменклатуры, РазделительФотографий, ИмяКолонки);
		ИС_Ozon_Сервер.ЗаполнитьЗначенияПоРеквизитамХарактеристикиНоменклатуры(СтрокаТаблицы,
			СтруктураПараметровЗначенийРеквизитовХарактеристикиНоменклатуры, РазделительФотографий, ИмяКолонки);

	КонецЦикла;

КонецПроцедуры

&НаСервере
Процедура СохранитьТоварыНаСервере()

	МассивТоваров = Новый Массив;
	ПоляАтрибутов = Элементы.ГруппаХарактеристики.ПодчиненныеЭлементы;
	Для Каждого стр Из Товары Цикл

		Если (Не ЭтоДобавлениеТоваров И Не стр.ИзменилсяТовар) Или (ЭтоДобавлениеТоваров И стр.product_id > 0
			И Не ОбновлятьСопоставленныеТовары) Тогда
			Продолжить;
		КонецЕсли;

		Если стр.Артикул = "" Тогда
			стр.Артикул = ИС_Ozon_Сервер.Артикул(стр.Номенклатура, стр.ХарактеристикаНоменклатуры,
				стр.Упаковка);
		КонецЕсли;

		СтруктураТовара = ИС_Ozon_Сервер.ЗаполнитьСтруктуруДобавленияТовара(стр, ПоляАтрибутов,
			Категория.Родитель);
			
		//+ ИнфоСофт Власова И.С. 02.12.24 УА #62619
		Если СопоставитьНоменклатуруАвтоматически Тогда
				
			ДанныеСопоставления = СтруктураСопоставленияТовара();
			ЗаполнитьЗначенияСвойств(ДанныеСопоставления, стр);
				
			СтруктураТовара.Вставить("ДанныеСопоставления", ДанныеСопоставления);
				
		КонецЕсли;
		//- ИнфоСофт Власова И.С. 02.12.24 УА #62619	
			
		МассивТоваров.Добавить(СтруктураТовара);

	КонецЦикла;

	ТЧТовары = Товары.Выгрузить( ,
		"Номенклатура, ХарактеристикаНоменклатуры, Упаковка, Артикул, product_id, FBO, FBS, RFBS, ОУД");

	НомерЗапроса = 1;	
	НастройкиСоединения = ИС_Ozon_СерверПовтИсп.ПолучитьНастройкиСоединения(Аккаунт);
		
	Если НастройкиСоединения = Неопределено Тогда
		ВызватьИсключение("Не удалось получить настройки подключения, проверьте настройки авторизации");
	КонецЕсли;  
		
	ПараметрыЗапроса = ИС_MP_РаботаСHTTPЗапросамиСервер.ПолучитьСтруктуруHTTPЗапроса();
	РезультатПроверки = ПроверитьИЗаполнитьПараметрыЗапроса(ПараметрыЗапроса, НастройкиСоединения);
	Пока Истина Цикл

		СрезТовары = ИС_Ozon_Сервер.СрезМассива(МассивТоваров, НомерЗапроса, 100);
		Если Не ЗначениеЗаполнено(СрезТовары) Тогда
			Прервать;
		КонецЕсли;

		task_id = ИС_Ozon_API.ЗагрузитьТоварыНаOzon(ПараметрыЗапроса, СрезТовары);
		Если ЗначениеЗаполнено(task_id) Тогда
			ОбщегоНазначения.СообщитьПользователю("Создана задача по выгрузке товаров с id " + Строка(task_id));
			
			//+ ИнфоСофт Власова И.С. 02.12.24 УА #62619
			Если СоздатьКарточкиПослеВыгрузки Тогда
				СоздатьСопоставитьНоменклатуру(task_id, СрезТовары);
			КонецЕсли;
			//- ИнфоСофт Власова И.С. 02.12.24 УА #62619
		КонецЕсли;

		НомерЗапроса = НомерЗапроса + 1;

	КонецЦикла;

КонецПроцедуры

&НаСервере
Функция ЗначенияРавны(Знач1, Знач2) 
		
	Если ТипЗнч(Знач1) = Тип("СписокЗначений") Тогда
	
		Если Знач1.Количество() = Знач2.Количество() Тогда
			Результат = Истина;
			Для Каждого элем Из Знач1 Цикл
				Если знач2.НайтиПоЗначению(элем.Значение) = Неопределено Тогда
					Результат = Ложь;
					Прервать;
				КонецЕсли;		
			КонецЦикла;	
		Иначе
			Результат = Ложь;	
		КонецЕсли;
		
	Иначе	
		Результат = Знач1 = Знач2;	
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

&НаСервере
Процедура ЗагрузитьЛимитыСозданияИОбновленияТоваров()
	
	Лимиты = ИС_Ozon_Сервер.ЗагрузитьЛимитыСозданияИОбновленияТоваров(Аккаунт);
	
	Если Лимиты.Количество() Тогда
		Если ЭтоДобавлениеТоваров Тогда
			ЛимитОстаток = Лимиты.Получить("daily_create").Получить("limit") - Лимиты.Получить("daily_create").Получить("usage");
			Текст = "Лимит на создание товаров";		
		Иначе
			ЛимитОстаток = Лимиты.Получить("daily_update").Получить("limit") - Лимиты.Получить("daily_update").Получить("usage");
			Текст = "Лимит на обновление товаров";
		КонецЕсли;
		Элементы.ДекорацияЛимит.Заголовок = СтрШаблон("%1 - %2;", Текст, ЛимитОстаток);
	КонецЕсли;
	
