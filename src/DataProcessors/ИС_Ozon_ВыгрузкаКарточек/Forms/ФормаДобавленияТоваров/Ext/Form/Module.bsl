#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	Параметры.Свойство("ЭтоДобавлениеТоваров", ЭтоДобавлениеТоваров);
	Параметры.Свойство("Категория", Категория);
	//ЗаполнитьЗначенияСвойств(ЭтотОбъект, Параметры.НастройкиАккаунта)
	Аккаунт = Параметры.Аккаунт;  
	
	ИС_Ozon_Сервер.ПолучитьНастройкиФункциональностиСборочныхЗвданий(Аккаунт);
	
	МассивПараметров = Новый Массив;
	
	МассивПараметров.Добавить("OzonВидЦеныСоСкидкой");
	МассивПараметров.Добавить("OzonВидЦены");
	МассивПараметров.Добавить("OzonВидЦеныМинимальный"); 
	
	Настройки = ИС_MP_Сервер.ПолучитьНастройки(Аккаунт, МассивПараметров);
	
	Если Настройки <> Неопределено Тогда	
		Price = Настройки["OzonВидЦеныСоСкидкой"];
		Min_price = Настройки["OzonВидЦеныМинимальный"];	
		Old_price = Настройки["OzonВидЦены"];
	Иначе
		Price = Справочники.ВидыЦен.ПустаяСсылка();			
		Min_price = Справочники.ВидыЦен.ПустаяСсылка();
		Old_price = Справочники.ВидыЦен.ПустаяСсылка();
	КонецЕсли;
	
	Валюта = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Price, "ВалютаЦены");
	ЗагрузитьЛимитыСозданияИОбновленияТоваров();
	
	ИС_Ozon_Сервер.УстановитьСвязиПараметровВыбораХарактеристикиИУпаковки(ЭтотОбъект);

	СписокОбязательныхХарактеристик = Новый ФиксированныйМассив(Новый Массив);

	ИнициализироватьХарактеристики();

	Если Не ЭтоДобавлениеТоваров Тогда
		Заголовок = "Редактирование товаров";
		Элементы.Категория.Доступность 						= Ложь;
		Элементы.Товары.КоманднаяПанель.Видимость 			= Ложь;
		Элементы.ДекорацияПодвал.Видимость					= Ложь;
		Элементы.ОбновлятьСопоставленныеТовары.Видимость 	= Ложь;
		Элементы.Номенклатура.Доступность 					= Ложь;
		Элементы.ХарактеристикаНоменклатуры.Доступность 	= Ложь;
		Элементы.Упаковка.Доступность 						= Ложь;
		Элементы.Артикул.ТолькоПросмотр						= Истина;
		ЗаполнитьТовары(Параметры.МассивРедактируемыхТоваров);
		ЗаполнитьАтрибутыТоваров();
	КонецЕсли;

	НеЗагруженыХарактеристики = Новый ФорматированнаяСтрока("Для данной категории товара отсутствуют характеристики.");
	
	//+ ИнфоСофт Власова И.С. 02.12.24 УА #62619
	Элементы.СопоставитьНоменклатуруАвтоматически.Видимость = СоздатьКарточкиПослеВыгрузки;
	//- ИнфоСофт Власова И.С. 02.12.24 УА #62619
	
КонецПроцедуры

&НаСервере
Процедура ОбработкаПроверкиЗаполненияНаСервере(Отказ, ПроверяемыеРеквизиты)

	ПроверяемыеРеквизиты.Очистить();
	ПроверяемыеРеквизиты.Добавить("Номенклатура");
	ПроверяемыеРеквизиты.Добавить("Цена");
	ПроверяемыеРеквизиты.Добавить("СтавкаНДС");
	ПроверяемыеРеквизиты.Добавить("ВесУпаковки");
	ПроверяемыеРеквизиты.Добавить("ДлинаУпаковки");
	ПроверяемыеРеквизиты.Добавить("ШиринаУпаковки");
	ПроверяемыеРеквизиты.Добавить("ВысотаУпаковки");
	ПроверяемыеРеквизиты.Добавить("СсылкаНаГлавноеФото");
	ПроверяемыеРеквизиты.Добавить("Категория");
	ПроверяемыеРеквизиты.Добавить("Название");
	ОбщегоНазначенияКлиентСервер.ДополнитьМассив(ПроверяемыеРеквизиты, СписокОбязательныхХарактеристик);

	РеквизитыТаблицы = ПолучитьРеквизиты("Товары");

	НомерСтроки = 1;
	Для Каждого стр Из Товары Цикл

		Если ЭтоДобавлениеТоваров И стр.product_id > 0 И Не ОбновлятьСопоставленныеТовары Тогда
			Продолжить;
		КонецЕсли;

		ИндексСтрокой = Формат(Товары.Индекс(стр), "ЧН=0; ЧГ=");
		Для Каждого реквизит Из РеквизитыТаблицы Цикл
			Если Не ПроверяемыеРеквизиты.Найти(реквизит.Имя) = Неопределено И Не ЗначениеЗаполнено(стр[реквизит.Имя])
				И Не (ТипЗнч(стр[реквизит.Имя]) = Тип("Число") И СтрНайти(Реквизит.Имя, "Атрибут_") > 1) Тогда

				ОбщегоНазначения.СообщитьПользователю(
					СтрШаблон("В строке: %1  не заполнена колонка: %2", НомерСтроки, реквизит.Заголовок), , СтрШаблон(
					"Товары[%1].%2", ИндексСтрокой, реквизит.Имя));

				Отказ = Истина;
			КонецЕсли;
		КонецЦикла;
		
		//Проверим Поле "Название" на наличие недопустимых символов
		Если ЗначениеЗаполнено(Стр.Название) И ИС_Ozon_Сервер.ЕстьНедопустимыеСимволыВСтроке(
			Стр.Название) Тогда

			ДопустимыеСимволы = "a-z A-Z а-я А-Я ёЁ 0-9 () "" ' & ; , : . / ? ! % * # № @ < > _ + -"
				+ " и символ ПРОБЕЛА";
			ОбщегоНазначения.СообщитьПользователю(
				СтрШаблон("В строке: %1 колонка 'Название' содержит недопустимые символы!
						  |	Разрешены к использованию только: %2", НомерСтроки, ДопустимыеСимволы), , СтрШаблон(
				"Товары[%1].%2", ИндексСтрокой, "Название"));

			Отказ = Истина;

		КонецЕсли;

		МассивОшибок = Новый Массив;
		Если Не ПроверитьЦеныПередОбновлением(стр.Цена, стр.ЦенаДоСкидки, стр.ЦенаМинимальная,
			МассивОшибок) Тогда

			Если ЗначениеЗаполнено(МассивОшибок) Тогда

				Отказ = Истина;

				Для Каждого СтрокаОшибки Из МассивОшибок Цикл
					Если СтрокаОшибки.Свойство("ЦенаСтарая") Тогда
						ИмяКолонки = "ЦенаДоСкидки";
						Сообщение = СтрокаОшибки.ЦенаСтарая;
					ИначеЕсли СтрокаОшибки.Свойство("ЦенаМинимальная") Тогда
						ИмяКолонки = "ЦенаМинимальная";
						Сообщение = СтрокаОшибки.ЦенаМинимальная;
					Иначе
						Продолжить;
					КонецЕсли;

					ОбщегоНазначения.СообщитьПользователю(
						СтрШаблон("В строке: %1 %2", НомерСтроки, Сообщение), , СтрШаблон("Товары[%1].%2",
						ИндексСтрокой, ИмяКолонки));

				КонецЦикла;

			КонецЕсли;

		КонецЕсли;

		НомерСтроки = НомерСтроки + 1;

	КонецЦикла;
	
	Если Не КолонкаОбъединитьНаОднойКарточке = "" Тогда
		Для счПроверяемаяСтрока = 0 По Товары.Количество() - 1 Цикл 
			Если ЗначениеЗаполнено(Товары[счПроверяемаяСтрока][КолонкаОбъединитьНаОднойКарточке]) Тогда
						
				Для счСравниваемаяСтрока = счПроверяемаяСтрока + 1 По Товары.Количество() - 1 Цикл
					
					Если Не Товары[счПроверяемаяСтрока][КолонкаОбъединитьНаОднойКарточке] = Товары[счСравниваемаяСтрока][КолонкаОбъединитьНаОднойКарточке] Тогда
						Продолжить;
					КонецЕсли;
						
					КоличествоСовпадающихАспектныхХарактеристик = 0;
						
					Для Каждого колонка Из СписокАспектныхХарактеристик Цикл
						
						Если ЗначенияРавны(Товары[счПроверяемаяСтрока][колонка], Товары[счСравниваемаяСтрока][колонка]) Тогда
							
							КоличествоСовпадающихАспектныхХарактеристик = КоличествоСовпадающихАспектныхХарактеристик + 1;
						
						КонецЕсли;
					
					КонецЦикла;
						
					Если СписокАспектныхХарактеристик.Количество() = КоличествоСовпадающихАспектныхХарактеристик Тогда
						
						Отказ = Истина;
						ОбщегоНазначения.СообщитьПользователю(
							СтрШаблон("В строках: %1 и %2 значения всех аспектных атрибутов совпадают при объединении на одной карточке", счПроверяемаяСтрока + 1, счСравниваемаяСтрока + 1), , СтрШаблон("Товары[%1][%2]",
							счПроверяемаяСтрока, КолонкаОбъединитьНаОднойКарточке));
								
					КонецЕсли;
						
				КонецЦикла;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

