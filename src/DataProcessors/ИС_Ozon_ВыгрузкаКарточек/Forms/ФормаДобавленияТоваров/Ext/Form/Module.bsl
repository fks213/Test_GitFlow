&НаСервере
Процедура СоздатьСопоставитьНоменклатуру(НомерЗадания, МассивТоваров)
	
	Перезаполнять = Истина;
	
	МассивИдентификаторов = Новый Массив;
	
	Для Каждого Товар Из МассивТоваров Цикл
		МассивИдентификаторов.Добавить(Товар.Артикул);
	КонецЦикла;	
	
	МассивНоменклатуры = ИС_Ozon_Сервер.СоздатьИзменитьНоменклатуруПоИдентификаторам(Аккаунт, МассивИдентификаторов, Перезаполнять);
	
	Если МассивНоменклатуры.Количество() > 0 Тогда
		
		Если СопоставитьНоменклатуруАвтоматически Тогда
			
			Для Каждого Элемент Из МассивНоменклатуры Цикл
				
				НайденныеСтроки = МассивТоваров.НайтиСтроки(Новый Структура("Артикул", Элемент.offer_id));
				
				Если НайденныеСтроки.Количество() > 0 Тогда
					
					ДанныеСопоставления = НайденныеСтроки[0].ДанныеСопоставления;
					
					Если Не ЗначениеЗаполнено(ДанныеСопоставления.Упаковка) Тогда			
						ДанныеСопоставления.Упаковка = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ДанныеСопоставления.Номенклатура, "ЕдиницаИзмерения");		
					КонецЕсли;
					
					ИС_Ozon_Сервер.ДобавитьСоответствиеНоменклатуры(Аккаунт, Элемент.НоменклатураОзон, 
						ДанныеСопоставления.Номенклатура, ДанныеСопоставления.ХарактеристикаНоменклатуры, ДанныеСопоставления.Упаковка);
					
				КонецЕсли;	
				
			КонецЦикла;
			
		КонецЕсли;
		
	Иначе	
		ОбщегоНазначения.СообщитьПользователю(СтрШаблон(НСтр("ru = 'По задаче №%1 не удалось создать номенклатуру Ozon, сопоставление не будет выполнено'"), НомерЗадания));
	КонецЕсли;
	
КонецПроцедуры //- ИнфоСофт Власова И.С. 02.12.24 УА #62619

