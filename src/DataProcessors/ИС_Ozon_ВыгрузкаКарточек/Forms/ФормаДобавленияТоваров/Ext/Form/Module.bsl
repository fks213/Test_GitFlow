&НаСервереБезКонтекста
Функция ПроверитьЦеныПередОбновлением(ЦенаТекущая, ЦенаСтарая, ЦенаМинимальная, МассивОшибок = Неопределено) Экспорт

	Результат = Истина;

	ВыводитьОшибкиСразу = Ложь;
	Если МассивОшибок = Неопределено Тогда
		ВыводитьОшибкиСразу = Истина;
		МассивОшибок = Новый Массив;
	КонецЕсли;

	Если Не ЗначениеЗаполнено(ЦенаТекущая) Тогда
		МассивОшибок.Добавить(Новый Структура("ЦенаТекущая",
			"Основная цена не может быть равна нулю! Цены по товару не установлены!"));
		Результат = Ложь;
	КонецЕсли;

	Если ЗначениеЗаполнено(ЦенаМинимальная) Тогда 
		// Цена до скидки должна быть выше текущей цены.
		Если ЦенаМинимальная > ЦенаТекущая Тогда
			МассивОшибок.Добавить(Новый Структура("ЦенаМинимальная",
				"Минимальная цена должна быть меньше или равна текущей цене! Цены по товару не установлены!"));
			Результат = Ложь;
		КонецЕсли;
	КонецЕсли;

	Если ЗначениеЗаполнено(ЦенаСтарая) Тогда 
		// Цена до скидки должна быть выше текущей цены.
		Если Не (ЦенаСтарая > ЦенаТекущая) Тогда
			МассивОшибок.Добавить(Новый Структура("ЦенаСтарая",
				"Цена до скидки должна быть выше текущей цены! Цены по товару не установлены!"));
			Результат = Ложь;
		КонецЕсли;
	КонецЕсли;

	Если ВыводитьОшибкиСразу Тогда
		Для Каждого СтрокаОшибки Из МассивОшибок Цикл
			Если СтрокаОшибки.Свойство("ЦенаСтарая") Тогда
				Сообщение = СтрокаОшибки.ЦенаСтарая;
			ИначеЕсли СтрокаОшибки.Свойство("ЦенаМинимальная") Тогда
				Сообщение = СтрокаОшибки.ЦенаМинимальная;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;

	Возврат Результат;

КонецФункции 

