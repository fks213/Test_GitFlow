&НаКлиенте
Процедура СкопироватьИзКатегории(Команда)

	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("Категория", Категория);
	ПараметрыФормы.Вставить("СопоставлениеОсновныхРеквизитов", Истина);

	Оповещение = Новый ОписаниеОповещения("ПриЗакрытииФормыКопированияСопоставленияХарактеристик", ЭтотОбъект);

	ОткрытьФорму("Обработка.ИС_Ozon_ВыгрузкаКарточек.Форма.ФормаКопированияСопоставленияХарактеристик", ПараметрыФормы, ЭтотОбъект, , , , Оповещение,
		РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

#Область ПроцедурыОповещения

&НаКлиенте
Процедура ВыборРеквизитаДляЗаполнения(Результат, СтруктураПараметров) Экспорт

	Если Не ЗначениеЗаполнено(Результат) Тогда
		Возврат;
	КонецЕсли;

	ТекущаяСтрока = Элементы.ОсновныеРеквизитыТовара.ТекущиеДанные;

	Если ТипЗнч(Результат) = Тип("СправочникСсылка.НаборыДополнительныхРеквизитовИСведений") Тогда

		ДополнительныеПараметры = Новый Структура;
		ДополнительныеПараметры.Вставить("ВидРеквизита1С", СтруктураПараметров.ВидРеквизита1С);

		Оповещение = Новый ОписаниеОповещения("ВыборРеквизитаДляЗаполнения", ЭтотОбъект, ДополнительныеПараметры);

		МассивЗначений = ДопРеквизитыНабора(Результат);
		СтруктураПараметров = Новый Структура;
		СтруктураПараметров.Вставить("МассивЗначений", МассивЗначений);

		ОткрытьФорму("Обработка.ИС_Ozon_ВыгрузкаКарточек.Форма.ФормаВыбора", СтруктураПараметров, , , , , Оповещение,
			РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);

	Иначе

		ТекущаяСтрока.ВидРеквизита1С = СтруктураПараметров.ВидРеквизита1С;
		ТекущаяСтрока.Реквизит1С 	 = Результат;

	КонецЕсли;

	Если ЗначениеЗаполнено(ТекущаяСтрока.Реквизит1С) Тогда
		ЗаписатьСопоставлениеОсновногоРеквизита();
	КонецЕсли
	;

КонецПроцедуры

&НаКлиенте
Процедура ПриЗакрытииФормыКопированияСопоставленияХарактеристик(Результат, ДополнительныеПараметры) Экспорт

	ЗаполнитьСопоставление();
	ЗаполнитьКонстанты();

КонецПроцедуры

#КонецОбласти

&НаСервере
Процедура ЗаполнитьСопоставление()

	ОсновныеРеквизитыТовара.Очистить();
	ТЗ = ОсновныеРеквизитыТовара.Выгрузить();
	ТаблицаРеквизитов = ИС_Ozon_Сервер.ЗаполнитьТаблицуОсновныхРеквизитов(ТЗ, Категория);

	ОсновныеРеквизитыТовара.Загрузить(ТаблицаРеквизитов);

КонецПроцедуры

&НаСервере
Процедура ЗаполнитьКонстанты()

	Ozon_Константы = ИС_Ozon_Сервер.ПолучитьНастройкиСопоставления();
	РазделительФотографий = Ozon_Константы.РазделительФотографий;
	ЗначениеАртикулаПоУмолчанию = Ozon_Константы.ЗначениеАртикулаПоУмолчанию;

	РасширенияДляВыгрузкиКартинок.ЗагрузитьЗначения(
				ИС_Ozon_Сервер.СсылкиНаПеречислениеИзСтроки(
		Ozon_Константы.РасширенияДляВыгрузкиКартинок, "ИС_Ozon_РасширенияФайловКартинок"));

КонецПроцедуры

&НаСервереБезКонтекста
Функция ЕстьВидНоменклатурыУХарактеристики()

	Возврат ИС_Ozon_Сервер.ЕстьВидНоменклатурыУХарактеристики();

КонецФункции

&НаКлиенте
Процедура УдалитьСопоставлениеОсновногоРеквизита()

	ТекущаяСтрока = Элементы.ОсновныеРеквизитыТовара.ТекущиеДанные;
	Если ТекущаяСтрока = Неопределено Тогда
		Возврат;
	КонецЕсли;

	УдалитьСопоставлениеОсновногоРеквизитаНаСервере(Категория, ТекущаяСтрока.РеквизитТовара);

	ТекущаяСтрока.Реквизит1С 	 = Неопределено;
	ТекущаяСтрока.ВидРеквизита1С = ПредопределенноеЗначение("Перечисление.ИС_Ozon_ВидРеквизитаСопоставления.ПустаяСсылка");
	ТекущаяСтрока.ФиксированноеЗначение = 0;
	//+ ИнфоСофт Заварин К.В. 20.05.24 УА #71523
	ТекущаяСтрока.Множитель = 0;
	//- ИнфоСофт Заварин К.В. 20.05.24 УА #71523
	
КонецПроцедуры

