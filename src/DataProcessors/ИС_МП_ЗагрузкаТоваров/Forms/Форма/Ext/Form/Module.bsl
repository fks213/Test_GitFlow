//+ ИнфоСофт Ивонин К.А. 14.09.22 УА #49591
&НаКлиенте
Процедура ЗагрузитьТовары(Команда)
	
	ОчиститьСообщения();
	
	Если Не ЗначениеЗаполнено(Профиль) Тогда 
		ОбщегоНазначенияКлиент.СообщитьПользователю("Необходимо выбрать ""Профиль""", , , "Профиль");
		Возврат;
	КонецЕсли;
	
	ИмяФункции = ИС_МП_Клиент.ИмяФункцииЗагрузкиТоваров(Маркетплейс);
	ДопПараметры = ИС_МП_Клиент.ДопПараметрыЗагрузкиТоваров(Маркетплейс, ЭтотОбъект);
	
	Если ДопПараметры = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ДлительнаяОперация = НачатьЗагрузкуТоваров(Профиль, Маркетплейс, ИмяФункции, 
		ДопПараметры, Перезаполнять, УникальныйИдентификатор);
	
	Если ДлительнаяОперация = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Элементы.ЗагрузитьТовары.Доступность = Ложь;
	Элементы.ДекорацияОжидание.Заголовок = "Пожалуйста, подождите. Идет загрузка товаров...";
	Элементы.ГруппаСтраницы.ТекущаяСтраница = Элементы.СтраницаОжидание; 
	ИдентификаторЗадания = ДлительнаяОперация.ИдентификаторЗадания;
	
	ОповещениеОЗавершении = Новый ОписаниеОповещения("ЗагрузитьТоварыЗавершение", ЭтотОбъект);
	ДлительныеОперацииКлиент.ОжидатьЗавершение(ДлительнаяОперация, ОповещениеОЗавершении, ПараметрыОжидания());

КонецПроцедуры //- ИнфоСофт Ивонин К.А. 14.09.22 УА #49591

