//+ ИнфоСофт Ивонин К.А. 01.10.23 УА #64020
&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	ДопПараметры = Новый Структура;
	ДопПараметры.Вставить("Оповещение", Новый ОписаниеОповещения("ПриОткрытииЗавершение", ЭтотОбъект));
	
	ИС_МП_Клиент.ПриОткрытии(ЭтотОбъект, Отказ, ДопПараметры);
	
	// +#Удалить
	Если Маркетплейс = "WildBerries" Тогда
		Маркетплейс = "ВБ";	
	КонецЕсли;
	// -#Удалить
	
	Элементы.ГруппаСтраницыМаркетплейсов.ТекущаяСтраница = Элементы["Страница" + Маркетплейс];
	ГруппаСтраницыМаркетплейсовПриСменеСтраницы(Элементы.ГруппаСтраницыМаркетплейсов, Элементы["Страница" + Маркетплейс]);	
	
КонецПроцедуры //- ИнфоСофт Ивонин К.А. 01.10.23 УА #64020

//+ ИнфоСофт Ивонин К.А. 22.10.24 УА #68001
&НаКлиенте
Процедура ПрофильПриИзменении(Элемент)
	ОпределитьИнтегрируемыеМаркетплейсы();
	ГруппаСтраницыМаркетплейсовПриСменеСтраницы(Элементы.ГруппаСтраницыМаркетплейсов, 
		Элементы.ГруппаСтраницыМаркетплейсов.ТекущаяСтраница);
КонецПроцедуры //- ИнфоСофт Ивонин К.А. 22.10.24 УА #68001

//+ ИнфоСофт Ивонин К.А. 01.10.23 УА #64020
&НаКлиенте
Процедура ГруппаСтраницыМаркетплейсовПриСменеСтраницы(Элемент, ТекущаяСтраница)
	
	Маркетплейс = СтрЗаменить(ТекущаяСтраница.Имя, "Страница", "");
	
	Если Маркетплейс = "Сбер" И Не ЗначениеЗаполнено(АдресВременногоХранилищаСбер) Тогда
		Элементы.ЗагрузитьТовары.Доступность = Ложь;
		Возврат;
	КонецЕсли;
	
	Если Маркетплейс = "МВМ" И Не ЗначениеЗаполнено(АдресВременногоХранилищаМВМ) Тогда
		Элементы.ЗагрузитьТовары.Доступность = Ложь;
		Возврат;
	КонецЕсли;
	
	Элементы.ЗагрузитьТовары.Доступность = Истина;
	
КонецПроцедуры //- ИнфоСофт Ивонин К.А. 01.10.23 УА #64020

//+ ИнфоСофт Ивонин К.А. 24.10.24 УА #68001
&НаКлиенте
Процедура ФайлНачалоВыбора(Элемент, ДанныеВыбора, ВыборДобавлением, СтандартнаяОбработка)
	
	ОчиститьСообщения();
	
	Маркетплейс = СтрЗаменить(Элемент.Имя, "ПутьФайла", "");
	
	ДополнительныеПараметры = Новый Структура;
	ДополнительныеПараметры.Вставить("Реквизит", Элемент.Имя);
	ДополнительныеПараметры.Вставить("Адрес", "АдресВременногоХранилища" + Маркетплейс);  	
	
	Оповещение = Новый ОписаниеОповещения("ЗагрузитьФайлЗавершение", ЭтотОбъект, ДополнительныеПараметры);
	
	ПараметрыЗагрузки = ФайловаяСистемаКлиент.ПараметрыЗагрузкиФайла();
	ПараметрыЗагрузки.Диалог.Заголовок = "Выберите файл товаров " + ИС_МП_Клиент.ПредставлениеМаркетплейса(Маркетплейс);
	ПараметрыЗагрузки.Диалог.ПроверятьСуществованиеФайла = Истина;
	ПараметрыЗагрузки.Диалог.Фильтр = "Excel файлы(*.xlsx)|*.xlsx";
	ПараметрыЗагрузки.ИдентификаторФормы = УникальныйИдентификатор;

	ФайловаяСистемаКлиент.ЗагрузитьФайл(Оповещение, ПараметрыЗагрузки);
		
КонецПроцедуры //- ИнфоСофт Ивонин К.А. 24.10.24 УА #68001

//+ ИнфоСофт Ивонин К.А. 07.02.25 УА #92406
&НаКлиенте
Процедура ПутьФайлаПриИзменении(Элемент)
	
	Если Не ЗначениеЗаполнено(ЭтотОбъект[Элемент.Имя]) Тогда
		Постфикс = СтрЗаменить(Элемент.Имя, "ПутьФайла", "");
		УдалитьИзВременногоХранилища(ЭтотОбъект["АдресВременногоХранилища" + Постфикс]);
		ЭтотОбъект["АдресВременногоХранилища" + Постфикс] = "";
		Элементы.ЗагрузитьТовары.Доступность = Ложь;	
	КонецЕсли; 
	
КонецПроцедуры //- ИнфоСофт Ивонин К.А. 07.02.25 УА #92406

//+ ИнфоСофт Ивонин К.А. 01.10.23 УА #64020
&НаКлиенте
Процедура ПриЗакрытии(ЗавершениеРаботы)
	
	Если ЗначениеЗаполнено(АдресВременногоХранилищаСбер) Тогда
		УдалитьИзВременногоХранилища(АдресВременногоХранилищаСбер);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(АдресВременногоХранилищаМВМ) Тогда
		УдалитьИзВременногоХранилища(АдресВременногоХранилищаМВМ);
	КонецЕсли;
	
КонецПроцедуры //- ИнфоСофт Ивонин К.А. 01.10.23 УА #64020

#КонецОбласти

