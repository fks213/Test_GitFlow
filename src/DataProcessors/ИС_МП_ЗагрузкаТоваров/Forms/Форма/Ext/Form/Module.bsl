//+ ИнфоСофт Ивонин К.А. 28.10.22 УА #49591
&НаСервереБезКонтекста
Функция НачатьЗагрузкуТоваров(Профиль, Маркетплейс, ИмяФункции, Знач ДопПараметры, Перезаполнять, УникальныйИдентификатор)
	
	ДопПараметры = ИС_МП_Сервер.ОбработатьДопПараметрыЗагрузкиТоваров(Маркетплейс, ДопПараметры);
	
	Если ДопПараметры = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	ПараметрыВыполнения = ДлительныеОперации.ПараметрыВыполненияВФоне(УникальныйИдентификатор);
	Возврат ДлительныеОперации.ВыполнитьФункцию(ПараметрыВыполнения, ИмяФункции, Профиль, Перезаполнять, ДопПараметры);	

КонецФункции //- ИнфоСофт Ивонин К.А. 28.10.22 УА #49591

//+ ИнфоСофт Ивонин К.А. 28.10.22 УА #49591
&НаКлиенте
Функция ПараметрыОжидания()
	
	ОповещениеОПрогрессеВыполнения = Новый ОписаниеОповещения("ОбновитьПрогрессВыполнения", ЭтотОбъект);
	
	ПараметрыОжидания = ДлительныеОперацииКлиент.ПараметрыОжидания(ЭтотОбъект);
	ПараметрыОжидания.ТекстСообщения = "Идет процесс загрузки товаров...";
	ПараметрыОжидания.ВыводитьПрогрессВыполнения = Истина;
	ПараметрыОжидания.ОповещениеОПрогрессеВыполнения = ОповещениеОПрогрессеВыполнения;
	ПараметрыОжидания.ВыводитьСообщения = Истина;
	ПараметрыОжидания.ПолучатьРезультат = Истина;
	ПараметрыОжидания.ВыводитьОкноОжидания = Ложь;
	
	ПараметрыОжидания.ОповещениеПользователя.Показать = Истина;
	ПараметрыОжидания.ОповещениеПользователя.НавигационнаяСсылка = "e1cib/app/Обработка.ИС_МП_ЗагрузкаТоваров";
		
	Возврат ПараметрыОжидания;
	
КонецФункции //- ИнфоСофт Ивонин К.А. 28.10.22 УА #49591

//+ ИнфоСофт Ивонин К.А. 28.10.22 УА #49591
&НаКлиенте
Процедура ЗагрузитьТоварыЗавершение(Результат, Параметры) Экспорт
	
	Элементы.ЗагрузитьТовары.Доступность = Истина;
	
	Если Результат = Неопределено Тогда  // отменено пользователем
		Возврат;
	КонецЕсли;
				
	Если Результат.Статус = "Ошибка" Тогда
		
		ПоказатьПредупреждение( , Результат.ПодробноеПредставлениеОшибки, , 
			"Произошла ошибка во время загрузки товаров");
		
		Для Каждого Элемент Из Результат.Сообщения Цикл 
			ОбщегоНазначенияКлиент.СообщитьПользователю(Элемент.Текст);	
		КонецЦикла;
		
		Элементы.ГруппаСтраницы.ТекущаяСтраница = Элементы.ГруппаСтраницаНачало;
		
		Возврат;
		
	КонецЕсли;
	
	Элементы.ГруппаСтраницы.ТекущаяСтраница = Элементы.ГруппаСтраницаЗавершение;
	
	Если Результат.Свойство("АдресРезультата") И ЗначениеЗаполнено(Результат.АдресРезультата) Тогда	
		
		РезультатФункции = ПолучитьИзВременногоХранилища(Результат.АдресРезультата);
		
		Если РезультатФункции <> Неопределено Тогда
			ОбщегоНазначенияКлиент.СообщитьПользователю(РезультатФункции);
		КонецЕсли;
		
	Иначе
		ОбщегоНазначенияКлиент.СообщитьПользователю("Загрузка завершена");
	КонецЕсли;
	
КонецПроцедуры //- ИнфоСофт Ивонин К.А. 28.10.22 УА #49591

//+ ИнфоСофт Ивонин К.А. 06.11.24 УА #86001
&НаКлиенте
Процедура ОбновитьПрогрессВыполнения(Результат, Параметры) Экспорт
	
	Если Результат = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если Результат.Прогресс <> Неопределено Тогда
		Элементы.ДекорацияОжидание.Заголовок = "Пожалуйста, подождите. Идет загрузка товаров..." 
			+ Символы.ПС + Результат.Прогресс.Текст;
	КонецЕсли;
	
	Если Результат.Свойство("Сообщения") И Результат.Сообщения <> Неопределено Тогда
	
		Для Каждого Сообщение Из Результат.Сообщения Цикл
			ОбщегоНазначенияКлиент.СообщитьПользователю(Сообщение.Текст);	
		КонецЦикла;
		
	КонецЕсли;
	
КонецПроцедуры //- ИнфоСофт Ивонин К.А. 06.11.24 УА #86001

//+ ИнфоСофт Ивонин К.А. 06.11.24 УА #68001
