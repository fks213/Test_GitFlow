
&НаСервере
Процедура СформироватьДанныеЭкспортаНаСервере()
	Инструкция.Очистить();
	СписокТоваров.Очистить();
	
	СтруктураОтветаФормирования = СформироватьДанныеXLSXФида(ЛичныйКабинет);
	СуществуютОшибкиЗаполнения = СтруктураОтветаФормирования.СуществуютОшибкиЗаполнения;
	Инструкция.Вывести(СтруктураОтветаФормирования.Инструкция);
	//СписокТоваров.Вывести(СтруктураОтветаФормирования.СписокТоваров);
	
	Элементы.ГруппаПодсказкаОбОшибках.Видимость = СуществуютОшибкиЗаполнения;
	Элементы.ГруппаПодсказкаОПроверке.Видимость = НЕ СуществуютОшибкиЗаполнения;
КонецПроцедуры

&НаКлиенте
Процедура СформироватьДанныеЭкспорта(Команда)
	СформироватьДанныеЭкспортаНаСервере();
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	Элементы.ГруппаСтраницыЛистов.ТекущаяСтраница = Элементы.СтраницаСписокТоваров;
КонецПроцедуры

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	Если Параметры.Свойство("ЛичныйКабинет") Тогда
		ЛичныйКабинет = Параметры.ЛичныйКабинет;
		СформироватьДанныеЭкспортаНаСервере();
	КонецЕсли;
КонецПроцедуры

#Область СохранениеВEXCEL

&НаКлиенте
Процедура ДалогСохраненияФайлаЗавершение(Результат, ДополнительныеПараметры) Экспорт
	Если Результат = Неопределено Тогда
        Возврат;
    КонецЕсли;
	
	Если ТипЗнч(Результат) = Тип("Массив") Тогда
		ИмяВыбранногоФайла = Результат[0];
		
		ПакетДанных = Новый ПакетОтображаемыхДокументов;
		
		ЭлементПакета = ПакетДанных.Состав.Добавить();
		ЭлементПакета.Наименование = "Инструкция";
		ЭлементПакета.Данные = ПоместитьВоВременноеХранилище(Инструкция);
		
		ЭлементПакета = ПакетДанных.Состав.Добавить();
		ЭлементПакета.Наименование = "Список товаров";
		ЭлементПакета.Данные = ПоместитьВоВременноеХранилище(СписокТоваров);
			    
	    ПакетДанных.НачатьЗапись(,ИмяВыбранногоФайла,ТипФайлаПакетаОтображаемыхДокументов.XLSX);
		
		ПоказатьОповещениеПользователя("Сформирован файл:"+Символы.ПС+ИмяВыбранногоФайла);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаДействияПользователяВВопросеСохранения(ОтветПользователя,ДопПараметр) Экспорт
	Если ОтветПользователя = КодВозвратаДиалога.Да Тогда
		УказаниеПутиСохраненияФайла();
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура УказаниеПутиСохраненияФайла()
	ДВФ = Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.Сохранение);
	ДВФ.Фильтр = "'Файл Excel'(*.xlsx)|*.xlsx";
	ДВФ.МножественныйВыбор = Ложь;
	ДВФ.Заголовок = "Сохранение сформированного фида Excel";
	
	ДВФ.Показать(Новый ОписаниеОповещения("ДалогСохраненияФайлаЗавершение", ЭтаФорма));
КонецПроцедуры

&НаКлиенте
Процедура СохранитьВEXCEL(Команда)
	Если СуществуютОшибкиЗаполнения Тогда
		ОбработкаОповещенияОтветаНаВопрос = Новый ОписаниеОповещения("ОбработкаДействияПользователяВВопросеСохранения",ЭтаФорма);
		ПоказатьВопрос(ОбработкаОповещенияОтветаНаВопрос,"Сформированный документ содержит ошибки, продолжить сохранение?",РежимДиалогаВопрос.ДаНет);
	Иначе
		УказаниеПутиСохраненияФайла();
	КонецЕсли;
КонецПроцедуры  

Функция СформироватьДанныеXLSXФида(ЛичныйКабинет) Экспорт
	СуществуютОшибкиЗаполнения = Ложь;
	
	МакетИнструкции = Обработки.ИС_Сбер_ВыгрузкаКарточек.ПолучитьМакет("МакетИнструкция");
	МакетДанных = Обработки.ИС_Сбер_ВыгрузкаКарточек.ПолучитьМакет("МакетСписокТоваров");
	
	Инструкция = Новый ТабличныйДокумент;
	СписокТоваров = Новый ТабличныйДокумент;
	
	Инструкция.Вывести(МакетИнструкции);
	СписокТоваров.Вывести(МакетДанных.ПолучитьОбласть("Заголовок"));
	
	ОбластьСтрока = МакетДанных.ПолучитьОбласть("Строка");
	
	ВыборкаЗапроса = ПолучитьВыборкуДанныхФида(ЛичныйКабинет);
	СтруктураВалидации = Новый Структура;
	Пока ВыборкаЗапроса.Следующий() Цикл									
		
		instock = Макс(ВыборкаЗапроса.instock,0);
		
		СтруктураВалидации.Вставить("offer_id",		ВыборкаЗапроса.offer_id);
		СтруктураВалидации.Вставить("available",	?(ВыборкаЗапроса.available,"Доступен","Не доступен"));
		СтруктураВалидации.Вставить("category",		ВыборкаЗапроса.category);
		СтруктураВалидации.Вставить("vendor",		ВыборкаЗапроса.vendor);
		СтруктураВалидации.Вставить("vendor_code",	ВыборкаЗапроса.vendor_code);
		СтруктураВалидации.Вставить("model",		ВыборкаЗапроса.model);
		СтруктураВалидации.Вставить("name",			ВыборкаЗапроса.name);
		СтруктураВалидации.Вставить("price",		Формат(Окр(ВыборкаЗапроса.price,0,РежимОкругления.Окр15как20),"ЧГ=0"));
		СтруктураВалидации.Вставить("old_price",	Формат(Окр(ВыборкаЗапроса.old_price,0,РежимОкругления.Окр15как20),"ЧГ=0"));
		СтруктураВалидации.Вставить("instock",		?(instock=0,"0",Формат(instock,"ЧГ=0")));
		СтруктураВалидации.Вставить("vat",			ПолучитьПредставлениеСтавкиНДС(ВыборкаЗапроса.vat));
		СтруктураВалидации.Вставить("barcode",		ВыборкаЗапроса.barcode);
		СтруктураВалидации.Вставить("picture",		ВыборкаЗапроса.picture);
		СтруктураВалидации.Вставить("description",	ВыборкаЗапроса.description);
		СтруктураВалидации.Вставить("url",			ВыборкаЗапроса.url);
		СтруктураВалидации.Вставить("order_before",	ВыборкаЗапроса.order_before);
		СтруктураВалидации.Вставить("days",			ВыборкаЗапроса.days);
		
		Если НЕ СуществуютОшибкиЗаполнения Тогда
			СуществуютОшибкиЗаполнения = ПроверитьСтруктуруЭлементаНаНаличиеОшибок(СтруктураВалидации,СуществуютОшибкиЗаполнения);
		КонецЕсли;
		
		ЗаполнитьЗначенияСвойств(ОбластьСтрока.Параметры,СтруктураВалидации);
		СписокТоваров.Вывести(ОбластьСтрока);
	КонецЦикла;                               
	
	
	СтруктураВозврата = Новый Структура;
	СтруктураВозврата.Вставить("СуществуютОшибкиЗаполнения",СуществуютОшибкиЗаполнения);
	СтруктураВозврата.Вставить("СписокТоваров",СписокТоваров);
	СтруктураВозврата.Вставить("Инструкция",Инструкция);
	
	Возврат СтруктураВозврата;
КонецФункции

Функция ПроверитьСтруктуруЭлементаНаНаличиеОшибок(СтруктураВалидации,СуществуютОшибкиЗаполнения)
	Попытка
		СуществуютОшибкиЗаполнения = Макс(СуществуютОшибкиЗаполнения,ПустаяСтрока(СтруктураВалидации.offer_id));
		СуществуютОшибкиЗаполнения = Макс(СуществуютОшибкиЗаполнения,ПустаяСтрока(СтруктураВалидации.category));
		СуществуютОшибкиЗаполнения = Макс(СуществуютОшибкиЗаполнения,ПустаяСтрока(СтруктураВалидации.vendor));
		СуществуютОшибкиЗаполнения = Макс(СуществуютОшибкиЗаполнения,ПустаяСтрока(СтруктураВалидации.vendor_code));
		СуществуютОшибкиЗаполнения = Макс(СуществуютОшибкиЗаполнения,ПустаяСтрока(СтруктураВалидации.name));
		СуществуютОшибкиЗаполнения = Макс(СуществуютОшибкиЗаполнения,?(ПустаяСтрока(СтруктураВалидации.price),0,Число(СтруктураВалидации.price))<0);
		СуществуютОшибкиЗаполнения = Макс(СуществуютОшибкиЗаполнения,Число(СтруктураВалидации.instock)<0);
		//СуществуютОшибкиЗаполнения = Макс(СуществуютОшибкиЗаполнения,ПустаяСтрока(СтруктураВалидации.barcode));
		СуществуютОшибкиЗаполнения = Макс(СуществуютОшибкиЗаполнения,ПустаяСтрока(СтруктураВалидации.vat));
		СуществуютОшибкиЗаполнения = Макс(СуществуютОшибкиЗаполнения,ПустаяСтрока(СтруктураВалидации.model));
	Исключение
		СуществуютОшибкиЗаполнения = Истина;
		Сообщить("Ошибка валидации обязательных полей");
	КонецПопытки;
	
	Возврат СуществуютОшибкиЗаполнения;
КонецФункции

