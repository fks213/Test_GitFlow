&НаСервере
Функция ЗаполнитьНастройкиФидаПоТекущемуМагазину() 
	
	//НастройкаВыгрузки = Справочники.ИС_Сбер_НастройкиВыгрузки.НайтиПоРеквизиту("Профиль", ЛичныйКабинет); 
	НастройкаВыгрузки = Справочники.ИС_Сбер_НастройкиВыгрузки.ПустаяСсылка();
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	ИС_Сбер_НастройкиВыгрузки.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.ИС_Сбер_НастройкиВыгрузки КАК ИС_Сбер_НастройкиВыгрузки
		|ГДЕ
		|	ИС_Сбер_НастройкиВыгрузки.Профиль = &Профиль
		|
		|УПОРЯДОЧИТЬ ПО
		|	Ссылка УБЫВ";
	
	Запрос.УстановитьПараметр("Профиль", ЛичныйКабинет);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		НастройкаВыгрузки = ВыборкаДетальныеЗаписи.Ссылка;	
	КонецЦикла;
	
	Если ЛичныйКабинет.Пустая() Или НастройкаВыгрузки.Пустая() Тогда
		Для Каждого СтрокаТНП Из ТаблицаНастроекПолей Цикл
			СтруктураПозиционирования = Новый Структура("ПолеНастройки",СтрокаТНП.ПолеНастройки);
			СтрокиТСН = ТаблицаСоответствияНастроек.НайтиСтроки(СтруктураПозиционирования);
			Если СтрокиТСН.Количество() = 0 Тогда
				Продолжить;
			КонецЕсли;
			
			СтрокаЗаполнения = СтрокиТСН[0];
			
			Если СтрокаЗаполнения.ПустоеПоле Тогда
				СтрокаТНП.ПредставлениеПустогоЗначения = СтрокаЗаполнения.Вариант;
				СтрокаТНП.ЗначениеПоля = "";
			Иначе
				СтрокаТНП.ЗначениеПоля = СтрокаЗаполнения.Вариант;
			КонецЕсли;
			
			СтрокаТНП.Настройка = СтрокаЗаполнения.Настройка;
			СтрокаТНП.СодержитЗначениеПоУмолчанию = СтрокаЗаполнения.СодержитЗначениеПоУмолчанию;
		КонецЦикла;
		СуществуютСохраненныеНастройки = Ложь;
	Иначе
		Для Каждого СтрокаСохраненныхНастроек Из НастройкаВыгрузки.НастройкиПолей Цикл
			СтруктураПозиционирования = Новый Структура("ПолеНастройки",СтрокаСохраненныхНастроек.Поле);
			
			СтрокиТСН = ТаблицаСоответствияНастроек.НайтиСтроки(СтруктураПозиционирования);
			СтрокиТНП = ТаблицаНастроекПолей.НайтиСтроки(СтруктураПозиционирования);
			
			Если СтрокиТСН.Количество() = 0 Тогда
				Продолжить;
			ИначеЕсли СтрокиТНП.Количество() = 0 Тогда
				Продолжить;
			КонецЕсли;
			
			СтрокаТСН = СтрокиТСН[0];
			СтрокаТНП = СтрокиТНП[0];
			
			Если СтрокаТСН.ПустоеПоле Тогда
				СтрокаТНП.ПредставлениеПустогоЗначения = СтрокаТСН.Вариант;
			КонецЕсли;
			
			СтрокаТНП.ЗначениеПоля	= СтрокаСохраненныхНастроек.ЗначениеПоля;
			СтрокаТНП.Настройка		= СтрокаСохраненныхНастроек.Настройка;
			СтрокаТНП.СодержитЗначениеПоУмолчанию = СтрокаТСН.СодержитЗначениеПоУмолчанию;
			
		КонецЦикла;
		СуществуютСохраненныеНастройки = Истина;
	КонецЕсли;
	
	Возврат СуществуютСохраненныеНастройки;
КонецФункции

