&НаСервере
Функция ЕстьЭлементКоллекции(ПарамКоллекция, ПарамЭлемент)
	ТипЗначенияКоллекции = ТипЗнч(ПарамКоллекция);
	Если ТипЗначенияКоллекции = Тип("Массив") Тогда
		ВозвращаемоеЗначение = ПарамКоллекция.Найти(ПарамЭлемент) <> Неопределено;
	ИначеЕсли ТипЗначенияКоллекции = Тип("СписокЗначений") Тогда
		ВозвращаемоеЗначение = ПарамКоллекция.НайтиПоЗначению(ПарамЭлемент) <> Неопределено;
	ИначеЕсли ТипЗначенияКоллекции = Тип("Структура") Тогда
		ВозвращаемоеЗначение = ПарамКоллекция.Свойство(ПарамЭлемент);
	ИначеЕсли ТипЗначенияКоллекции = Тип("Соответствие") Тогда
		ВозвращаемоеЗначение = ПарамКоллекция.Получить(ПарамЭлемент) <> Неопределено;
	Иначе
		ВозвращаемоеЗначение = Ложь;
	КонецЕсли;
	
	Возврат ВозвращаемоеЗначение;
КонецФункции

&НаСервере
Функция СформироватьМассивПараметраДопСведенийИРеквизитов()
	МассивИмен = Новый Массив;
	МассивИмен.Добавить("Номенклатура");
	МассивИмен.Добавить("Виды номенклатуры");
	МассивИмен.Добавить("Характеристики номенклатуры");
	МассивИмен.Добавить("Справочник ""Номенклатура"" (Общие)");
	МассивИмен.Добавить("Справочник ""Номенклатура""");
	МассивИмен.Добавить("Справочник ""Виды номенклатуры""");
	МассивИмен.Добавить("Справочник ""Характеристики номенклатуры""");
	МассивИмен.Добавить("Справочник ""Характеристики номенклатуры"" (Общие)");
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("МассивИмен",МассивИмен);
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	Ссылка
		|ИЗ
		|	Справочник.НаборыДополнительныхРеквизитовИСведений
		|ГДЕ
		|	Наименование В(&МассивИмен)";
	ВыборкаЗапроса = Запрос.Выполнить().Выбрать();
	
	ВозвращаемыйМассив = Новый Массив;
	Пока ВыборкаЗапроса.Следующий() Цикл
		ВозвращаемыйМассив.Добавить(ВыборкаЗапроса.Ссылка);
	КонецЦикла;
	
	Возврат ВозвращаемыйМассив;
КонецФункции

&НаСервере
Функция СформироватьСписокДополнительныхСвойствИАтрибутовНоменклатуры(парКонтекст = Неопределено)
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ДополнительныеРеквизиты.Ссылка				КАК Набор,
		|	ДополнительныеРеквизиты.Ссылка.Наименование	КАК Наименование,
		|	ДополнительныеРеквизиты.Ссылка.Родитель		КАК Родитель,
		|	ДополнительныеРеквизиты.Свойство			КАК Свойство,
		|	ДополнительныеРеквизиты.Свойство.Наименование КАК ИмяСвойства,
		|	ДополнительныеРеквизиты.ИмяПредопределенногоНабора КАК ИмяПредопределенногоНабора,
		|	ДополнительныеРеквизиты.Свойство.ТипЗначения КАК СвойствоТипЗначения
		|ИЗ
		|	Справочник.НаборыДополнительныхРеквизитовИСведений.ДополнительныеРеквизиты КАК ДополнительныеРеквизиты
		|ГДЕ
		|	ДополнительныеРеквизиты.Ссылка.Родитель В ИЕРАРХИИ(&ПараметрЗапроса)
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	ДополнительныеСведения.Ссылка,
		|	ДополнительныеСведения.Ссылка.Наименование,
		|	ДополнительныеСведения.Ссылка.Родитель,
		|	ДополнительныеСведения.Свойство,
		|	ДополнительныеСведения.Свойство.Наименование,
		|	ДополнительныеСведения.ИмяПредопределенногоНабора,
		|	ДополнительныеСведения.Свойство.ТипЗначения
		|ИЗ
		|	Справочник.НаборыДополнительныхРеквизитовИСведений.ДополнительныеСведения КАК ДополнительныеСведения
		|ГДЕ
		|	ДополнительныеСведения.Ссылка.Родитель В ИЕРАРХИИ(&ПараметрЗапроса)";
	
	Если ТипЗнч(парКонтекст) = Тип("Массив") Тогда
		ПараметрЗапроса = парКонтекст;
	Иначе
		Если парКонтекст = Неопределено Тогда
			ПараметрЗапроса = СформироватьМассивПараметраДопСведенийИРеквизитов();
		ИначеЕсли ТипЗнч(парКонтекст) = Тип("СправочникСсылка.НаборыДополнительныхРеквизитовИСведений") Тогда
			ПараметрЗапроса = Новый Массив;
			ПараметрЗапроса.Добавить(парКонтекст);
		КонецЕсли;
	КонецЕсли;
	Запрос.УстановитьПараметр("ПараметрЗапроса", ПараметрЗапроса);
	
	ВозвращаемыйСписок = Новый СписокЗначений;
	
	Результат = Запрос.Выполнить();
	Выборка = Результат.Выбрать();
	Пока Выборка.Следующий() Цикл
		РазмещениеСвойства = Новый Структура;
		РазмещениеСвойства.Вставить("Набор",	Строка(ЗначениеВСтрокуВнутр(Выборка.Набор)));
		РазмещениеСвойства.Вставить("Свойство",	Строка(ЗначениеВСтрокуВнутр(Выборка.Свойство)));
		ПредставлениеРазмещения = Записать(РазмещениеСвойства,ПереносСтрокJSON.Нет,ЭкранированиеСимволовJSON.СимволыВнеASCII);
		ВозвращаемыйСписок.Добавить(ПредставлениеРазмещения,Выборка.ИмяСвойства);
	КонецЦикла;
	
	Возврат ВозвращаемыйСписок;
КонецФункции

&НаСервере
Функция СформироватьСписокТекстовогоПредставленияВидовЦен()
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ВидыЦен.Ссылка			КАК Ссылка,
		|	ВидыЦен.Представление	КАК Представление
		|ИЗ
		|	Справочник.ВидыЦен КАК ВидыЦен
		|ГДЕ
		|	НЕ ВидыЦен.ПометкаУдаления
		|
		|УПОРЯДОЧИТЬ ПО
		|	Представление";
	Выборка = Запрос.Выполнить().Выбрать();
	
	ВозвращаемыйСписок = Новый СписокЗначений;
	Пока Выборка.Следующий() Цикл
		ЗначениеСписка = Строка(ЗначениеВСтрокуВнутр(Выборка.Ссылка));
		ВозвращаемыйСписок.Добавить(ЗначениеСписка,Выборка.Представление);
	КонецЦикла;
	
	Возврат ВозвращаемыйСписок;
КонецФункции   

&НаСервере
Функция Записать(Структура,
				ПереносСтрок = Неопределено, 
				Экранирование = Неопределено) 
	
	Если ПереносСтрок = Неопределено Тогда	
		ПереносСтрок = ПереносСтрокJSON.Авто;
	КонецЕсли;
	Если Экранирование = Неопределено Тогда
		Экранирование = ЭкранированиеСимволовJSON.СимволыВнеASCII;
	КонецЕсли;
	
	ЗаписьJSON = Новый ЗаписьJSON;
	ПараметрыЗаписи = Новый ПараметрыЗаписиJSON(ПереносСтрок , Символы.Таб,,Экранирование);
	ЗаписьJSON.УстановитьСтроку(ПараметрыЗаписи);
	ЗаписьJSON.ПроверятьСтруктуру = Ложь;
	ЗаписатьJSON(ЗаписьJSON, Структура);
	
	Попытка 
		ВозвращаемоеЗначение = ЗаписьJSON.Закрыть();
	Исключение
		ВозвращаемоеЗначение = Неопределено;
	КонецПопытки;
	
	Возврат ВозвращаемоеЗначение;
	
КонецФункции
