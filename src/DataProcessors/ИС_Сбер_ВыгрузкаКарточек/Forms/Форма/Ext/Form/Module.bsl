&НаСервере 
Функция ОбработкаПереданногоФайлаНаСервере(Знач АдресХранилища, Знач Ссылка)
	
	ВременныйТД = Новый ТабличныйДокумент;
	
	ДвоичныеДанные = ПолучитьИзВременногоХранилища(АдресХранилища);	
	ВременныйФайлТаблицы = ПолучитьИмяВременногоФайла(".xlsx");
	ДвоичныеДанные.Записать(ВременныйФайлТаблицы);
	
	ВременныйТД = Новый ТабличныйДокумент;
	ВременныйТД.Прочитать(ВременныйФайлТаблицы,СпособЧтенияЗначенийТабличногоДокумента.Значение);
	
	Для Каждого ОбластьТД ИЗ ВременныйТД.Области Цикл
		ИмяОбласти = ОбластьТД.Имя;
		Если ИмяОбласти = "Инструкция" Тогда
			Инструкция.Вывести(ВременныйТД.ПолучитьОбласть(ОбластьТД.Имя));
		ИначеЕсли ИмяОбласти = "Список_товаров" Тогда
			СписокТоваров.Вывести(ВременныйТД.ПолучитьОбласть(ОбластьТД.Имя));
		КонецЕсли;
	КонецЦикла;
	
	УдалитьИзВременногоХранилища(АдресХранилища);
	УдалитьФайлы(ВременныйФайлТаблицы);
	
	Элементы.ГруппаСтраницыExcel.ТекущаяСтраница = Элементы.СтраницаСписокТоваров;
КонецФункции

&НаКлиенте
Процедура ОповещениеПомещениеФайла(ПомещенныеФайлы, ДополнительныеПараметры)Экспорт
	Если ТипЗнч(ПомещенныеФайлы) = Тип("Массив") Тогда
		ОбработкаПереданногоФайлаНаСервере(ПомещенныеФайлы[0].Хранение, ДополнительныеПараметры);
	КонецЕсли; 	
КонецПроцедуры

&НаКлиенте
Процедура ОписаниеОповещенияВыбораФайла(ВыбранныеФайлы, ДополнительныеПараметры) Экспорт
	
	Если ВыбранныеФайлы.Количество() > 0 Тогда
		ИмяФайла = ВыбранныеФайлы[0];
		
		ОписаниеФайла = Новый ОписаниеПередаваемогоФайла();
		ОписаниеФайла.Имя = ИмяФайла;
		
		ПомещаемыеФайлы = Новый Массив;
		ПомещаемыеФайлы.Добавить(ОписаниеФайла);
		
		Оповещение = Новый ОписаниеОповещения("ОповещениеПомещениеФайла", ЭтаФорма, ДополнительныеПараметры);
		НачатьПомещениеФайлов(Оповещение, ПомещаемыеФайлы,, Ложь, ЭтаФорма.УникальныйИдентификатор);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьИзExcel()
	
	ДиалогВыбораФайла = Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.Открытие);	
	ДиалогВыбораФайла.МножественныйВыбор = Ложь;
	ДиалогВыбораФайла.Фильтр =  "Excel (*.xlsx)|*.xlsx|Excel 97-2010 (*.xls)|*.xls";
	ДиалогВыбораФайла.Показать(Новый ОписаниеОповещения("ОписаниеОповещенияВыбораФайла", ЭтаФорма, Новый Структура("Расширение", ДиалогВыбораФайла.Расширение)));
	
КонецПроцедуры

