&НаКлиенте
Процедура ТаблицаНастроекПолейПриАктивизацииСтроки()
	Если Элементы.ТаблицаНастроекПолей.ТекущаяСтрока = Неопределено Тогда
		ОбычныеНастройки = Истина;
	ИначеЕсли Элементы.ТаблицаНастроекПолей.ТекущиеДанные = Неопределено Тогда
		ОбычныеНастройки = Истина;
	Иначе
		ОбычныеНастройки = Ложь;
	КонецЕсли;
	
	ПолеНастройкиЗначения = Элементы.ТаблицаНастроекПолейЗначениеПоля;
	ПолеНастройкиЗначения.СписокВыбора.Очистить();
	
	Если ОбычныеНастройки Тогда
		ПолеНастройкиЗначения.РежимВыбораИзСписка = Ложь;	
	Иначе
		ТекущиеДанныеСтроки = Элементы.ТаблицаНастроекПолей.ТекущиеДанные;
		
		ПолеНастройкиЗначения.ТолькоПросмотр = ТекущиеДанныеСтроки.Фиксация;
		
		СтруктураПозиционирования = Новый Структура("ПолеНастройки",ТекущиеДанныеСтроки.ПолеНастройки);
		СтрокиТСН = ТаблицаСоответствияНастроек.НайтиСтроки(СтруктураПозиционирования);
		
		Если СтрокиТСН.Количество() > 1 Тогда
			ПолеНастройкиЗначения.РежимВыбораИзСписка = Истина;
			Для Каждого СтрокаТСН Из СтрокиТСН Цикл
				ПолеНастройкиЗначения.СписокВыбора.Добавить(СтрокаТСН.Вариант);
			КонецЦикла;
			Если ПолеНастройкиЗначения.СписокВыбора.НайтиПоЗначению(ТекущиеДанныеСтроки.ЗначениеПоля) = Неопределено Тогда
				ПолеНастройкиЗначения.СписокВыбора.Добавить(ТекущиеДанныеСтроки.ЗначениеПоля);
			КонецЕсли;
		Иначе
			ПолеНастройкиЗначения.РежимВыбораИзСписка = Ложь;
		КонецЕсли;
	КонецЕсли;

КонецПроцедуры

&НаСервереБезКонтекста
Функция СуществуютЗаписиПоЛичномуКабинету(парЛичныйКабинет)
	ЗапросОбновления = Новый Запрос;
	ЗапросОбновления.УстановитьПараметр("ЛичныйКабинет",парЛичныйКабинет);
	ЗапросОбновления.Текст = "ВЫБРАТЬ Количество(*) КАК Записей Из РегистрСведений.ИС_Сбер_Фид ГДЕ Профиль = &ЛичныйКабинет";
	Выборка = ЗапросОбновления.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		ПризнакОбновления = Выборка.Записей > 0;
	Иначе
		ПризнакОбновления = Ложь;
	КонецЕсли;
	
	Возврат ПризнакОбновления;
КонецФункции

&НаСервере
Функция СохранитьНастройкиПолейНаСервере()
	//+ ИнфоСофт Стояк Ю.К. 19.08.2024 УА #70735	
	Ссылка = Справочники.ИС_Сбер_НастройкиВыгрузки.НайтиПоРеквизиту("Профиль", ЛичныйКабинет);
	
	//+ ИнфоСофт Стояк Ю.К. 10.03.2025 УА #95753	
	//НовыеНастройки = Ссылка.ПолучитьОбъект();    
	//НовыеНастройки.НастройкиПолей.Очистить();
	Если ЗначениеЗаполнено(Ссылка) Тогда 
		НовыеНастройки = Ссылка.ПолучитьОбъект();    
		НовыеНастройки.НастройкиПолей.Очистить();
	Иначе
		НовыеНастройки = Справочники.ИС_Сбер_НастройкиВыгрузки.СоздатьЭлемент()
	КонецЕсли;                                  
	//- ИнфоСофт Стояк Ю.К. 10.03.2025 УА #95753
	//НовыеНастройки = Справочники.ИС_Сбер_НастройкиВыгрузки.СоздатьЭлемент();
	//- ИнфоСофт Стояк Ю.К. 19.08.2024 УА #70735
	Для Каждого СтрокаТНП Из ТаблицаНастроекПолей Цикл
		СтрокаНастройкиПолей = НовыеНастройки.НастройкиПолей.Добавить();
		СтрокаНастройкиПолей.Поле				 = СтрокаТНП.ПолеНастройки;
		СтрокаНастройкиПолей.ЗначениеПоля		 = СтрокаТНП.ЗначениеПоля;
		СтрокаНастройкиПолей.Настройка			 = СтрокаТНП.Настройка;
		СтрокаНастройкиПолей.ЗначениеПоУмолчанию = СтрокаТНП.СодержитЗначениеПоУмолчанию;
	КонецЦикла;
	НовыеНастройки.Профиль = ЛичныйКабинет;
	НовыеНастройки.Записать();
	
	Возврат СуществуютЗаписиПоЛичномуКабинету(ЛичныйКабинет);
КонецФункции

