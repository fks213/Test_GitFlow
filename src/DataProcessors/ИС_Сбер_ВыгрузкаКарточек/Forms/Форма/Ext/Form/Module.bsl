&НаСервере
Функция ПараметрыФормыПодбораТоваров() Экспорт    
	
	МассивПараметров = Новый Массив;		
	МассивПараметров.Добавить("ВидЦены");
	
	Результат = ИС_MP_Сервер.ПолучитьЗначениеНастроек(ЛичныйКабинет, Перечисления.ИС_МП_Маркетплейсы.Сбер, МассивПараметров);
	
	ВидЦены = Результат.ВидЦены;  
	
	Валюта = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ВидЦены, "ВалютаЦены");
	
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("Соглашение", Неопределено);
	ПараметрыФормы.Вставить("Организация", ЛичныйКабинет.Организация);
	ПараметрыФормы.Вставить("РежимПодбораИспользоватьСкладыВТабличнойЧасти", Ложь);
	ПараметрыФормы.Вставить("ИспользоватьДатыОтгрузки", Ложь);	
	ПараметрыФормы.Вставить("Заголовок", НСтр("ru = 'Подбор товаров';"));
	ПараметрыФормы.Вставить("Дата", ТекущаяДата());
	ПараметрыФормы.Вставить("Валюта", Валюта);
	ПараметрыФормы.Вставить("Документ", ПредопределенноеЗначение("Документ.ЗаказКлиента.ПустаяСсылка"));
	ПараметрыФормы.Вставить("ПодборВариантовОбеспечения", Ложь);
	ПараметрыФормы.Вставить("ОстаткиПоВсемСкладам", Истина);	
	ПараметрыФормы.Вставить("РежимПодбораБезСоглашенийСКлиентами", Истина);
	ПараметрыФормы.Вставить("ВидЦены", ВидЦены);

	Результат = Новый Структура;
	Результат.Вставить("ИмяФормы", "Обработка.ПодборТоваровВДокументПродажи.Форма");
	Результат.Вставить("ПараметрыФормы", ПараметрыФормы);

	Возврат Результат;

КонецФункции //- ИнфоСофт Стояк Ю.К. 19.08.2024 УА #70735

&НаСервереБезКонтекста
Функция ПриведенноеЗначениеВыбораНоменклатуры(парВыбранноеЗначение)
	//MVM-88828
	ВозвращаемыйМассив = Новый Массив;
	Если парВыбранноеЗначение.ЭтоГруппа Тогда
		Запрос = Новый Запрос("Выбрать ссылка Из справочник.Номенклатура где ссылка в Иерархии(&парВыбранноеЗначение) И НЕ ЭтоГруппа И НЕ ПометкаУдаления");
		Запрос.УстановитьПараметр("парВыбранноеЗначение",парВыбранноеЗначение);
		Выборка = Запрос.Выполнить().Выбрать();
		Пока Выборка.Следующий() Цикл
			ВозвращаемыйМассив.Добавить(Выборка.Ссылка);
		КонецЦикла;
	Иначе
		ВозвращаемыйМассив.Добавить(парВыбранноеЗначение);
	КонецЕсли;
	
	Возврат ВозвращаемыйМассив;
КонецФункции

