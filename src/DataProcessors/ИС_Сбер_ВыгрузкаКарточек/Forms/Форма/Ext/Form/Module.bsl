&НаСервереБезКонтекста
Функция СформироватьТекстОписанияПроблемы(ДанныеСтроки)
	ТекстОписания = Новый ТекстовыйДокумент;
	Если ПустаяСтрока(ДанныеСтроки.offer_id) Тогда
		ТекстОписания.ДобавитьСтроку("Поле 'Offer ID' обязательное. Значение не может быть пустым");
	КонецЕсли;
	Если ПустаяСтрока(ДанныеСтроки.category) Тогда
		ТекстОписания.ДобавитьСтроку("Поле 'Категория' обязательное. Значение не может быть пустым");
	КонецЕсли;
	Если ПустаяСтрока(ДанныеСтроки.vendor) Тогда
		ТекстОписания.ДобавитьСтроку("Поле 'Производитель (Бренд)' обязательное. Значение не может быть пустым");
	КонецЕсли;
	Если ПустаяСтрока(ДанныеСтроки.vendor_code) Тогда
		ТекстОписания.ДобавитьСтроку("Поле 'Артикул' обязательное. Значение не может быть пустым");
	КонецЕсли;
	Если ПустаяСтрока(ДанныеСтроки.name) Тогда
		ТекстОписания.ДобавитьСтроку("Поле 'Название' обязательное. Значение не может быть пустым");
	КонецЕсли;
	Если ПустаяСтрока(ДанныеСтроки.model) Тогда
		ТекстОписания.ДобавитьСтроку("Поле 'Модель' обязательное. Значение не может быть пустым");
	КонецЕсли;
	//Если ПустаяСтрока(ДанныеСтроки.barcode) Тогда
	//	ТекстОписания.ДобавитьСтроку("Поле 'Штрих-код' обязательное. Значение не может быть пустым");
	//КонецЕсли;
	Если ?(ПустаяСтрока(ДанныеСтроки.price),0,Число(ДанныеСтроки.price)) <= 0 Тогда
		ТекстОписания.ДобавитьСтроку("Цена не может быть 0, отрицательной, пустым значением или содержать буквы");
	КонецЕсли;
	Если Число(ДанныеСтроки.instock) < 0 Тогда
		ТекстОписания.ДобавитьСтроку("Остаток не может быть отрицательным, пустым значением или содержать буквы");
	КонецЕсли;
	Если ДанныеСтроки.vat.Пустая() Тогда
		ТекстОписания.ДобавитьСтроку("Допустимые значения НДС — 0%, Без НДС, 10%, 10/110, 20%, 20/120");
	КонецЕсли;
	
	Возврат ТекстОписания.ПолучитьТекст();
КонецФункции

&НаКлиенте
Процедура ОповеститьОПроблемахЗаполненияСтроки()
	Если Элементы.СписокТоваровФида.ТекущаяСтрока = Неопределено Тогда
		ВидимостьОписанияПроблемы = Ложь;
	ИначеЕсли Элементы.СписокТоваровФида.ТекущиеДанные = Неопределено Тогда
		ВидимостьОписанияПроблемы = Ложь;
	ИначеЕсли НЕ Элементы.СписокТоваровФида.ТекущиеДанные.Проблема Тогда
		ВидимостьОписанияПроблемы = Ложь;
	Иначе
		СтруктураПереопределенияТД = Новый Структура("offer_id,category,vendor,vendor_code,name,price,instock,vat,model,barcode");
		Для Каждого ЭлементТД Из СтруктураПереопределенияТД Цикл
			ЗначениеПереопределения = Неопределено;
			Элементы.СписокТоваровФида.ТекущиеДанные.Свойство(ЭлементТД.Ключ,ЗначениеПереопределения);
			СтруктураПереопределенияТД.Вставить(ЭлементТД.Ключ,ЗначениеПереопределения);
		КонецЦикла;
		ТекстОписанияПроблемы = СформироватьТекстОписанияПроблемы(СтруктураПереопределенияТД);
		ВидимостьОписанияПроблемы = Истина;
	КонецЕсли;
	Элементы.ГруппаОписаниеПроблемыЗаполнения.Видимость = ВидимостьОписанияПроблемы;
КонецПроцедуры

