&НаКлиенте
Процедура ОбработкаВыбораЭлементаИзСпискаДополнительныхРеквизитов(ЗначениеВыбора,парКонтекст) Экспорт
	Если ЗначениеВыбора = Неопределено Тогда
		СписокВыбора = Элементы.ТаблицаНастроекПолейЗначениеПоля.СписокВыбора;
		ИдЗн = СписокВыбора.Количество() - 1;
		Если СписокВыбора[ИдЗн].Значение = "Другое >>" ИЛИ СписокВыбора[ИдЗн].Значение = "Вид цен >>" Тогда
			РезультирующееЗначение = СписокВыбора[0].Значение;
		Иначе
			РезультирующееЗначение = СписокВыбора[ИдЗн].Значение;
		КонецЕсли;
	Иначе
		СтрокиКонтекста = ТаблицаНастроекПолей.НайтиСтроки(Новый Структура("ПолеНастройки",парКонтекст));
		Для Каждого СтрКонтекста Из СтрокиКонтекста Цикл
			СтрКонтекста.ЗначениеПоля = ЗначениеВыбора.Представление;
			СтрКонтекста.Настройка = ЗначениеВыбора.Значение;
		КонецЦикла;
		ТаблицаНастроекПолейПриАктивизацииСтроки();
		РезультирующееЗначение = ЗначениеВыбора.Представление;
	КонецЕсли;
	
	Элементы.ТаблицаНастроекПолей.ТекущиеДанные.ЗначениеПоля = РезультирующееЗначение;
КонецПроцедуры
	
