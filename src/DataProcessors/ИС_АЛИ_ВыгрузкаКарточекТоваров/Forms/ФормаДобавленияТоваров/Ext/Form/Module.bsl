&НаСервере
Функция ЗначенияРавны(Знач1, Знач2) 
		
	Если ТипЗнч(Знач1) = Тип("СписокЗначений") Тогда
	
		Если Знач1.Количество() = Знач2.Количество() Тогда
			Результат = Истина;
			Для Каждого элем Из Знач1 Цикл
				Если знач2.НайтиПоЗначению(элем.Значение) = Неопределено Тогда
					Результат = Ложь;
					Прервать;
				КонецЕсли;		
			КонецЦикла;	
		Иначе
			Результат = Ложь;	
		КонецЕсли;
		
	Иначе	
		Результат = Знач1 = Знач2;	
	КонецЕсли;
	
	Возврат Результат;
	
