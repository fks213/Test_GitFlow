Функция СтруктураОсновногоАтрибутаДобавлениеТовара(ИДАтрибута, АтрибутыРазмеров)

	Результат = Новый Структура;
	Результат.Вставить("attribute_name", "");
	Результат.Вставить("attribute_name_id", "");
	Результат.Вставить("attribute_value_id", ""); 
	Результат.Вставить("attribute_value", ""); 

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ИС_АЛИ_Атрибут.Код КАК Код,
	|	ИС_АЛИ_Атрибут.Наименование КАК Наименование
	|ИЗ
	|	Справочник.ИС_АЛИ_Атрибут КАК ИС_АЛИ_Атрибут
	|ГДЕ
	|	ИС_АЛИ_Атрибут.Код = &Код
	|	И НЕ ИС_АЛИ_Атрибут.Ссылка В (&Массив)";

	Запрос.УстановитьПараметр("Код", ИДАтрибута);
	Запрос.УстановитьПараметр("Массив", АтрибутыРазмеров);

	РезультатЗапроса = Запрос.Выполнить();

	Выборка = РезультатЗапроса.Выбрать();

	Если Выборка.Следующий() Тогда
		Результат.attribute_name 			= Выборка.Наименование;
		Результат.attribute_name_id		 	= СтрЗаменить(Строка(Выборка.Код), Символы.НПП, "");
	КонецЕсли;

	Возврат Результат;

