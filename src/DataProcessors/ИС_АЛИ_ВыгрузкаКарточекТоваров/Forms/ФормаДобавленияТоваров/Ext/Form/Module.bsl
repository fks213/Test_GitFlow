&НаСервере
Процедура ИнициализироватьХарактеристики()
	
	УдалитьХарактеристики();
	
	Элементы.ГруппаШапкаПредупреждение.Видимость = Ложь;
	
	Если ЗначениеЗаполнено(Категория) Тогда
		
		Элементы.ГруппаТаблица.Доступность 		= Истина;
		Элементы.СохранитьТовары.Доступность 	= Истина;
		ИмяТабличнойЧасти = "Товары";
		
		ОбязательныеХарактеристики 	= Новый Массив;
		АспектныеХарактеристики 	= Новый Массив;
		
		Запрос = Новый Запрос;
		Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ИС_АЛИ_Атрибут.Наименование КАК Наименование,
		|	ИС_АЛИ_Атрибут.is_multi_select КАК НаборЗначений,
		|	ИС_АЛИ_Атрибут.is_enum_prop КАК Справочный,
		|	ИС_АЛИ_КатегорииТоваровproperties.is_required КАК Обязательная,
		|	ИС_АЛИ_Атрибут.Код КАК Код
		|ИЗ
		|	Справочник.ИС_АЛИ_КатегорииТоваров.properties КАК ИС_АЛИ_КатегорииТоваровproperties
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ИС_АЛИ_Атрибут КАК ИС_АЛИ_Атрибут
		|		ПО ИС_АЛИ_КатегорииТоваровproperties.Атрибут = ИС_АЛИ_Атрибут.Ссылка
		|ГДЕ
		|	ИС_АЛИ_КатегорииТоваровproperties.Ссылка = &Категория
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	ИС_АЛИ_АтрибутРазмер.Наименование,
		|	ИС_АЛИ_АтрибутРазмер.is_multi_select,
		|	ИС_АЛИ_АтрибутРазмер.is_enum_prop,
		|	ИС_АЛИ_КатегорииТоваровsku_properties.is_required,
		|	ИС_АЛИ_АтрибутРазмер.Код
		|ИЗ
		|	Справочник.ИС_АЛИ_КатегорииТоваров.sku_properties КАК ИС_АЛИ_КатегорииТоваровsku_properties
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ИС_АЛИ_Атрибут КАК ИС_АЛИ_АтрибутРазмер
		|		ПО ИС_АЛИ_КатегорииТоваровsku_properties.Атрибут = ИС_АЛИ_АтрибутРазмер.Ссылка
		|ГДЕ
		|	ИС_АЛИ_КатегорииТоваровsku_properties.Ссылка = &Категория
		|
		|УПОРЯДОЧИТЬ ПО
		|	Обязательная УБЫВ";
		
		Запрос.УстановитьПараметр("Категория", Категория);
		
		РезультатЗапроса = Запрос.Выполнить();
		
		Выборка = РезультатЗапроса.Выбрать();
		ЦветФона = Новый Цвет(255, 255, 255);
			
		Пока Выборка.Следующий() Цикл
			
			ИмяРеквизита 		= "Атрибут_" + Формат(Выборка.Код, "ЧГ=0");
			МножественныйВыбор  = Выборка.НаборЗначений;
			
			Если Выборка.НаборЗначений Тогда
				ТипРеквизита 	= Новый ОписаниеТипов("СписокЗначений");
			ИначеЕсли Выборка.Справочный Тогда
				ТипРеквизита 	= Новый ОписаниеТипов("СправочникСсылка.ИС_АЛИ_ЗначенияАтрибутов");
			Иначе
				ТипРеквизита 	= Новый ОписаниеТипов("Строка", , Новый КвалификаторыСтроки(0, ДопустимаяДлина.Переменная));
			КонецЕсли; 
			
			ПутьКДанным  		= ?(ИмяТабличнойЧасти = "", ИмяРеквизита, ИмяТабличнойЧасти + "." + ИмяРеквизита);
			СоздатьРеквизитФормы(ИмяРеквизита, ТипРеквизита, Выборка.Наименование, ИмяТабличнойЧасти);
			
			Если Выборка.Обязательная Тогда
				ОбязательныеХарактеристики.Добавить(ИмяРеквизита);
			КонецЕсли;
			
			СоздатьПолеФормы(Выборка, ИмяРеквизита, ПутьКДанным, МножественныйВыбор, ЦветФона);
						
		КонецЦикла;
		
		СписокОбязательныхХарактеристик = Новый ФиксированныйМассив(ОбязательныеХарактеристики);
		
	КонецЕсли;
	
КонецПроцедуры //- ИнфоСофт Стояк Ю.К. 13.05.2024 УА #62574

//+ ИнфоСофт Стояк Ю.К. 13.05.2024 УА #62574
&НаСервере
Процедура УдалитьХарактеристики()

	ЭлементыХарактеристик = Элементы.ГруппаХарактеристики.ПодчиненныеЭлементы;

	УдаляемыеПоля = Новый Массив;
	УдаляемыеРеквизиты = Новый Массив;

	Для Каждого Элемент Из ЭлементыХарактеристик Цикл
		УдаляемыеПоля.Добавить(Элемент);
		УдаляемыеРеквизиты.Добавить(Элемент.ПутьКДанным);
	КонецЦикла;

	Для Каждого Элемент Из УдаляемыеПоля Цикл
		Элементы.Удалить(Элемент);
	КонецЦикла;

	ИзменитьРеквизиты( , УдаляемыеРеквизиты);

КонецПроцедуры

//+ ИнфоСофт Стояк Ю.К. 13.05.2024 УА #62574
&НаСервере
Процедура СоздатьРеквизитФормы(ИмяРеквизита, Тип, ЗаголовокПоля = "", ИмяТабличнойЧасти = "")

	ДобавляемыеРеквизиты = Новый Массив;

	ИмяРеквизита = ИмяРеквизита;
	НовыйРеквизит = Новый РеквизитФормы(ИмяРеквизита, Тип, ИмяТабличнойЧасти, ЗаголовокПоля);
	ДобавляемыеРеквизиты.Добавить(НовыйРеквизит);

	ИзменитьРеквизиты(ДобавляемыеРеквизиты);

КонецПроцедуры

//+ ИнфоСофт Стояк Ю.К. 13.05.2024 УА #62574
&НаСервере
Процедура СоздатьПолеФормы(Выборка, ИмяРеквизита, ПутьКДанным, МножественныйВыбор, ЦветФона)

	ГруппаФормы = Элементы.ГруппаХарактеристики;
	//type 		= НРег(Выборка.ТипХарактеристики);
	ВидПоля = ВидПоляФормы.ПолеВвода;
	НовыйЭлемент = Элементы.Добавить(ИмяРеквизита, Тип("ПолеФормы"), ГруппаФормы);
	НовыйЭлемент.ПутьКДанным 	= ПутьКДанным;
	НовыйЭлемент.Вид 			= ВидПоля;
	НовыйЭлемент.Заголовок		= Выборка.Наименование + ?(Выборка.Обязательная, "*", "");
	
	// Оформление
	НовыйЭлемент.ПоложениеЗаголовка = ПоложениеЗаголовкаЭлементаФормы.Верх;
	//Подсказка = Новый ФорматированнаяСтрока(Выборка.Описание, Новый Шрифт(, 10, Истина));
	//НовыйЭлемент.РасширеннаяПодсказка.Заголовок = Подсказка;
	//НовыйЭлемент.ОтображениеПодсказки 			= ОтображениеПодсказки.Кнопка;
	НовыйЭлемент.ЦветФонаЗаголовка 				= ЦветФона;
	//Если type = "multiline" Тогда
	//	НовыйЭлемент.МногострочныйРежим 	= Истина;
	//	НовыйЭлемент.Высота 				= 1;
	//	НовыйЭлемент.РастягиватьПоВертикали = Ложь;
	//КонецЕсли;

	Если Не НовыйЭлемент.Вид = ВидПоляФормы.ПолеФлажка Тогда
		НовыйЭлемент.РастягиватьПоГоризонтали 	= Истина;
		НовыйЭлемент.АвтоМаксимальнаяШирина 	= Ложь;
		НовыйЭлемент.АвтоОтметкаНезаполненного 	= Выборка.Обязательная;
		НовыйЭлемент.КнопкаОчистки 	= Истина;
	КонецЕсли;
	
	// Выбор из списка
	Если Не МножественныйВыбор Тогда
		НовыйЭлемент.КнопкаВыбора 				= Истина;
		НовыйЭлемент.ОтображениеКнопкиВыбора 	= ОтображениеКнопкиВыбора.ОтображатьВПолеВвода;
		НовыйЭлемент.ИсторияВыбораПриВводе  	= ИсторияВыбораПриВводе.НеИспользовать;
		НовыйЭлемент.КнопкаВыпадающегоСписка 	= Ложь;
		НовыйЭлемент.КнопкаСоздания 			= Ложь;
		НовыйЭлемент.КнопкаОткрытия 			= Ложь;
		НовыйЭлемент.РедактированиеТекста 		= Ложь;
		НовыйЭлемент.УстановитьДействие("НачалоВыбора", "ХарактеристикаНачалоВыбора");
	КонецЕсли;

	НовыйЭлемент.УстановитьДействие("ПриИзменении", "ХарактеристикаПриИзменении");

	Если МножественныйВыбор Тогда
		НовыйЭлемент.УстановитьДействие("НачалоВыбора", "ХарактеристикаНачалоМножественногоВыбора");
		НовыйЭлемент.УстановитьДействие("ОбработкаВыбора", "ХарактеристикаОбработкаМножественногоВыбора");
		НовыйЭлемент.КнопкаВыбора 	= Истина;
	КонецЕсли;

КонецПроцедуры

//+ ИнфоСофт Стояк Ю.К. 13.05.2024 УА #62574
&НаСервере
Процедура ЗаполнитьКолонкуСопоставленнымиЗначениямиНаСервере(ИмяКолонки)

	ЕстьНастройкиОсновныхРеквизитовДляКатегории = ИС_АЛИ_Сервер.ЕстьНастройкиОсновныхРеквизитовДляКатегории(
		Категория);
	ТаблицаСоответствийЗначений = ИС_АЛИ_Сервер.ТаблицаСоответствийДопРеквизитов(Категория,
		ЕстьНастройкиОсновныхРеквизитовДляКатегории);
	СтруктураПараметровЗначенийРеквизитовНоменклатуры = ИС_АЛИ_Сервер.СтруктураПараметровЗначенийРеквизитовНоменклатуры(
		Категория, ЕстьНастройкиОсновныхРеквизитовДляКатегории);
	СтруктураПараметровЗначенийРеквизитовХарактеристикиНоменклатуры = ИС_АЛИ_Сервер.СтруктураПараметровЗначенийРеквизитовХарактеристикиНоменклатуры(
		Категория, ЕстьНастройкиОсновныхРеквизитовДляКатегории);
			
	РазделительФотографий = "";

	Для Каждого СтрокаТаблицы Из Товары Цикл

		ИС_АЛИ_Сервер.ЗаполнитьЗначенияПоДопРеквизитам(СтрокаТаблицы, ТаблицаСоответствийЗначений,
			РазделительФотографий, ИмяКолонки);
		ИС_АЛИ_Сервер.ЗаполнитьЗначенияПоРеквизитамНоменклатуры(СтрокаТаблицы,
			СтруктураПараметровЗначенийРеквизитовНоменклатуры, РазделительФотографий, ИмяКолонки);
		ИС_АЛИ_Сервер.ЗаполнитьЗначенияПоРеквизитамХарактеристикиНоменклатуры(СтрокаТаблицы,
			СтруктураПараметровЗначенийРеквизитовХарактеристикиНоменклатуры, РазделительФотографий, ИмяКолонки);

	КонецЦикла;

КонецПроцедуры

//+ ИнфоСофт Стояк Ю.К. 13.05.2024 УА #62574
&НаСервере
Процедура СохранитьТоварыНаСервере()

	МассивТоваров = Новый Массив;
	ПоляАтрибутов = Элементы.ГруппаХарактеристики.ПодчиненныеЭлементы; 
		
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ИС_АЛИ_КатегорииТоваровsku_properties.Атрибут КАК Атрибут
		|ИЗ
		|	Справочник.ИС_АЛИ_КатегорииТоваров.sku_properties КАК ИС_АЛИ_КатегорииТоваровsku_properties
		|ГДЕ
		|	ИС_АЛИ_КатегорииТоваровsku_properties.Ссылка = &Ссылка";
	
	Запрос.УстановитьПараметр("Ссылка", Категория);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	АтрибутыРазмера = РезультатЗапроса.Выгрузить();
	
	МассивОбработаныхПризнаков = Новый Массив;
	
	Товары.Сортировать("КолонкаОбъединитьНаОднойКарточке Возр");
	
	СтруктураТовара = Неопределено;
	
	Для Каждого стр Из Товары Цикл
		
		Если стр.КолонкаОбъединитьНаОднойКарточке = "" Тогда
			
			Если ЗначениеЗаполнено(СтруктураТовара) Тогда
				МассивТоваров.Добавить(СтруктураТовара);
			КонецЕсли;
			
        	СтруктураТовара = СтруктураДобавленияТовара();
			СтруктураТовара = ЗаполнитьСтруктуруДобавленияТовара(стр, Категория, СтруктураТовара);
			СтруктураТовара.attribute_list = ЗаполнениеОсновныхАтрибутов(стр, ПоляАтрибутов, АтрибутыРазмера);
			СтруктураТовара.sku_info_list.Добавить(ЗаполнениеРазмерныхАтрибутов(стр, ПоляАтрибутов, АтрибутыРазмера));			

		ИначеЕсли МассивОбработаныхПризнаков.Найти(стр.КолонкаОбъединитьНаОднойКарточке) <> Неопределено Тогда
			СтруктураТовара.sku_info_list.Добавить(ЗаполнениеРазмерныхАтрибутов(стр, ПоляАтрибутов, АтрибутыРазмера));			
		Иначе 
			
			Если ЗначениеЗаполнено(СтруктураТовара) Тогда
				МассивТоваров.Добавить(СтруктураТовара);
			КонецЕсли;
			
			МассивОбработаныхПризнаков.Добавить(стр.КолонкаОбъединитьНаОднойКарточке);
			СтруктураТовара = СтруктураДобавленияТовара();
			СтруктураТовара = ЗаполнитьСтруктуруДобавленияТовара(стр, Категория, СтруктураТовара);
			СтруктураТовара.attribute_list = ЗаполнениеОсновныхАтрибутов(стр, ПоляАтрибутов, АтрибутыРазмера);			
			СтруктураТовара.sku_info_list.Добавить(ЗаполнениеРазмерныхАтрибутов(стр, ПоляАтрибутов, АтрибутыРазмера));			
			
		КонецЕсли;   
				
	КонецЦикла;
	
	Если ЗначениеЗаполнено(СтруктураТовара) Тогда
		МассивТоваров.Добавить(СтруктураТовара);
	КонецЕсли;
	
	ИС_АЛИ_Сервер.СозданиеКТ(Профиль, МассивТоваров);
	
	//+ ИнфоСофт Власова И.С. 02.12.24 УА #62619
	Если СоздатьКарточкиПослеВыгрузки Тогда
		СоздатьСопоставитьНоменклатуру(МассивТоваров);
	КонецЕсли;
	//- ИнфоСофт Власова И.С. 02.12.24 УА #62619
	
КонецПроцедуры

