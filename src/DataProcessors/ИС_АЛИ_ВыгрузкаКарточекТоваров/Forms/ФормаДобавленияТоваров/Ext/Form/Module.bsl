//+ ИнфоСофт Стояк Ю.К. 13.05.2024 УА #62574
&НаКлиенте
Функция КатегорияЗаполнена()

	Результат = Истина;

	Если Не ЗначениеЗаполнено(Категория) Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю("Не заполнена Категория товаров", , "Категория");
		Результат = Ложь;
	КонецЕсли;

	Возврат Результат;

КонецФункции

#Область ПроцедурыОповещения

//+ ИнфоСофт Стояк Ю.К. 13.05.2024 УА #62574
&НаКлиенте
Процедура ПослеЗакрытияПодбора(Результат, СтруктураПараметров) Экспорт

	Если ЗначениеЗаполнено(Результат) Тогда
		Если Результат.Свойство("АдресТоваровВХранилище") Тогда
			ПослеЗакрытияПодбораНаСервере(Результат.АдресТоваровВХранилище);
		Иначе
			ПослеЗакрытияПодбораНаСервере(Результат.АдресКорзиныВХранилище);
		КонецЕсли;
	КонецЕсли;

КонецПроцедуры

//+ ИнфоСофт Стояк Ю.К. 13.05.2024 УА #62574
&НаСервере
Процедура ПослеЗакрытияПодбораНаСервере(АдресТоваровВХранилище)

	ТаблицаПодбора = ПолучитьИзВременногоХранилища(АдресТоваровВХранилище);

	ТаблицаНоменклатуры = ТаблицаНоменклатурыПоТаблицеПодбора(ТаблицаПодбора);

	ТаблицаТоваров = ПолучитьДанныеПоНоменклатуре(ТаблицаНоменклатуры);
	ЕстьНастройкиОсновныхРеквизитовДляКатегории = ИС_АЛИ_Сервер.ЕстьНастройкиОсновныхРеквизитовДляКатегории(
		Категория);
	ТаблицаСоответствийЗначений = ИС_АЛИ_Сервер.ТаблицаСоответствийДопРеквизитов(Категория,
		ЕстьНастройкиОсновныхРеквизитовДляКатегории);
	СтруктураПараметровЗначенийРеквизитовНоменклатуры = ИС_АЛИ_Сервер.СтруктураПараметровЗначенийРеквизитовНоменклатуры(
		Категория, ЕстьНастройкиОсновныхРеквизитовДляКатегории);
	СтруктураПараметровЗначенийРеквизитовХарактеристикиНоменклатуры = ИС_АЛИ_Сервер.СтруктураПараметровЗначенийРеквизитовХарактеристикиНоменклатуры(
		Категория, ЕстьНастройкиОсновныхРеквизитовДляКатегории);

	Для Каждого ДанныеНоменклатуры Из ТаблицаТоваров Цикл
		НоваяСтрока = Товары.Добавить();
		ЗаполнитьСтрокуТовара(НоваяСтрока, ДанныеНоменклатуры, ТаблицаСоответствийЗначений,
			СтруктураПараметровЗначенийРеквизитовНоменклатуры,
			СтруктураПараметровЗначенийРеквизитовХарактеристикиНоменклатуры);
	КонецЦикла;

КонецПроцедуры

#КонецОбласти

