//+ ИнфоСофт Власова И.С. 02.12.24 УА #62619
&НаСервере
Процедура СоздатьСопоставитьНоменклатуру(МассивТоваров)
	
	Перезаполнять = Ложь;	
	
	ИС_АЛИ_Сервер.ПолучитьКарточкиТоваров(Профиль, Перезаполнять);
	
	Если СопоставитьНоменклатуруАвтоматически Тогда
		
		МассивКодов = Новый Массив;
		
		Для Каждого Товар Из МассивТоваров Цикл
			МассивКодов.Добавить(Товар.sku_code);
		КонецЦикла;
		
		Запрос = Новый Запрос;
		Запрос.Текст = 
			"ВЫБРАТЬ
			|	ИС_АЛИ_Вариации.Ссылка КАК ВариацияАЛИ,
			|	ИС_АЛИ_Вариации.КодВариации КАК sku_code
			|ПОМЕСТИТЬ ВТ_Вариации
			|ИЗ
			|	Справочник.ИС_АЛИ_Вариации КАК ИС_АЛИ_Вариации
			|ГДЕ
			|	ИС_АЛИ_Вариации.КодВариации В(&МассивКодов)
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ
			|	ВТ_Вариации.ВариацияАЛИ КАК ВариацияАЛИ,
			|	ВТ_Вариации.sku_code КАК sku_code,
			|	ВЫБОР
			|		КОГДА ИС_АЛИ_СоответствиеХарактеристик.ВариацияАЛИ = ЗНАЧЕНИЕ(Справочник.ИС_АЛИ_Вариации.ПустаяСсылка)
			|			ТОГДА ИСТИНА
			|		ИНАЧЕ ЛОЖЬ
			|	КОНЕЦ КАК ТребуетсяСопоставление
			|ПОМЕСТИТЬ ВТ_ОтборНесопоставленных
			|ИЗ
			|	ВТ_Вариации КАК ВТ_Вариации
			|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.ИС_АЛИ_СоответствиеХарактеристик КАК ИС_АЛИ_СоответствиеХарактеристик
			|		ПО ВТ_Вариации.ВариацияАЛИ = ИС_АЛИ_СоответствиеХарактеристик.ВариацияАЛИ
			|			И (ИС_АЛИ_СоответствиеХарактеристик.Профиль = &Профиль)
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ
			|	ВТ_ОтборНесопоставленных.ВариацияАЛИ КАК ВариацияАЛИ,
			|	ВТ_ОтборНесопоставленных.sku_code КАК sku_code,
			|	ВТ_ОтборНесопоставленных.ТребуетсяСопоставление КАК ТребуетсяСопоставление
			|ИЗ
			|	ВТ_ОтборНесопоставленных КАК ВТ_ОтборНесопоставленных
			|ГДЕ
			|	ВТ_ОтборНесопоставленных.ТребуетсяСопоставление";
		
		Запрос.УстановитьПараметр("МассивКодов", МассивКодов);
		Запрос.УстановитьПараметр("Профиль",     Профиль);
		
		РезультатЗапроса = Запрос.Выполнить();
		
		ВыборкаВариации = РезультатЗапроса.Выбрать();
		
		Пока ВыборкаВариации.Следующий() Цикл
			
			НайденныеСтроки = МассивТоваров.НайтиСтроки(Новый Структура("sku_code", ВыборкаВариации.sku_code));
			
			Если НайденныеСтроки.Количество() > 0 Тогда
				
				ДанныеСопоставления = НайденныеСтроки[0].ДанныеСопоставления;
				
				Если Не ЗначениеЗаполнено(ДанныеСопоставления.Упаковка) Тогда			
					ДанныеСопоставления.Упаковка = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ДанныеСопоставления.Номенклатура, "ЕдиницаИзмерения");		
				КонецЕсли;
				
				ИС_АЛИ_Сервер.ДобавитьСоответствиеНоменклатуры(Профиль, ВыборкаВариации.ВариацияАЛИ, 
					ДанныеСопоставления.Номенклатура, ДанныеСопоставления.ХарактеристикаНоменклатуры, ДанныеСопоставления.Упаковка);
				
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЕсли;
	
КонецПроцедуры //- ИнфоСофт Власова И.С. 02.12.24 УА #62619

