//+ ИнфоСофт Стояк Ю.К. 13.05.2024 УА #62574
Функция ЗаполнениеОсновныхАтрибутов(Источник, ПоляАтрибутов, АтрибутыРазмера)

	Результат = Новый Массив;

	Для Каждого Поле Из ПоляАтрибутов Цикл

		ЗначениеАтрибута = Источник[Поле.Имя];
		Если Не ЗначениеЗаполнено(ЗначениеАтрибута) Тогда
			Продолжить;	
		КонецЕсли;
		
		ИдАтрибута = Число(СтрРазделить(Поле.Имя, "_")[1]);
		СтруктураАтрибута = СтруктураОсновногоАтрибутаДобавлениеТовара(ИдАтрибута, АтрибутыРазмера);
		Если СтруктураАтрибута.attribute_name_id = "" Тогда
			Продолжить;
		КонецЕсли;	
			
		Если ТипЗнч(ЗначениеАтрибута) = Тип("СписокЗначений") Тогда
			МассивВыбранныхЗначений = ЗначениеАтрибута.ВыгрузитьЗначения();
			Для Каждого Значение Из МассивВыбранныхЗначений Цикл
				Если ЗначениеЗаполнено(Значение) Тогда					
					СтруктураАтрибута.attribute_value_id = СтрЗаменить(Строка(Значение.Код), Символы.НПП, "");
					СтруктураАтрибута.attribute_value = СтрЗаменить(Строка(Значение.Наименование), Символы.НПП, "");;
				КонецЕсли;
			КонецЦикла;
		Иначе
			СтруктураАтрибута.attribute_value_id = СтрЗаменить(Строка(ЗначениеАтрибута.Код), Символы.НПП, "");
			СтруктураАтрибута.attribute_value = СтрЗаменить(Строка(ЗначениеАтрибута.Наименование), Символы.НПП, "");;
		КонецЕсли;

		Результат.Добавить(СтруктураАтрибута);

	КонецЦикла;

	Возврат Результат;

КонецФункции //- ИнфоСофт Стояк Ю.К. 13.05.2024 УА #62574

