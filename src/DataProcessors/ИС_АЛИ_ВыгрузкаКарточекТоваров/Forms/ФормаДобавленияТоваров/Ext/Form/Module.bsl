	Результат.Вставить("inventory", 0);
	
	МассивАтрибутов = Новый Массив;

	Для Каждого Поле Из ПоляАтрибутов Цикл

		ЗначениеАтрибута = Источник[Поле.Имя];
		Если Не ЗначениеЗаполнено(ЗначениеАтрибута) Тогда
			Продолжить;	
		КонецЕсли;
		
		ИдАтрибута = Число(СтрРазделить(Поле.Имя, "_")[1]);
		СтруктураАтрибута = СтруктураРазмераАтрибутаДобавлениеТовара(ИдАтрибута, АтрибутыРазмера);
		Если СтруктураАтрибута.sku_attribute_name_id = "" Тогда
			Продолжить;
		КонецЕсли;	
			
		Если ТипЗнч(ЗначениеАтрибута) = Тип("СписокЗначений") Тогда
			МассивВыбранныхЗначений = ЗначениеАтрибута.ВыгрузитьЗначения();
			Для Каждого Значение Из МассивВыбранныхЗначений Цикл
				Если ЗначениеЗаполнено(Значение) Тогда					
					СтруктураАтрибута.sku_attribute_value_id = СтрЗаменить(Строка(Значение.Код), Символы.НПП, "");
					СтруктураАтрибута.sku_attribute_value_definition_name = Значение.Наименование;
				КонецЕсли;
			КонецЦикла;
		Иначе
			СтруктураАтрибута.sku_attribute_value_id = СтрЗаменить(Строка(ЗначениеАтрибута.Код), Символы.НПП, "");
			СтруктураАтрибута.sku_attribute_value_definition_name = ЗначениеАтрибута.Наименование;
		КонецЕсли;

		МассивАтрибутов.Добавить(СтруктураАтрибута);

	КонецЦикла; 
	
	Результат.Вставить("sku_attributes_list", МассивАтрибутов);

	Возврат Результат;

