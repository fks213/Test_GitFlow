Функция ПреобразоватьJSONВСоответствие(JSONСтрокой, ИменаСвойствСоЗначениямиДата = Неопределено,
	ОжидаемыйФорматДаты = Неопределено, ИмяФункцииВосстановления = Неопределено,
	МодульФункцииВосстановления = Неопределено, ИменаСвойствДляОбработкиВосстановления = Неопределено) Экспорт

	ИспользуемыйФорматДаты = ?(ОжидаемыйФорматДаты = Неопределено, ФорматДатыJSON.ISO, ОжидаемыйФорматДаты);

	Попытка
		ЧтениеJSON = Новый ЧтениеJSON;
		ЧтениеJSON.УстановитьСтроку(JSONСтрокой);
		ДанныеJSON = ПрочитатьJSON(ЧтениеJSON, Истина, ИменаСвойствСоЗначениямиДата, ИспользуемыйФорматДаты,
			ИмяФункцииВосстановления, МодульФункцииВосстановления, , ИменаСвойствДляОбработкиВосстановления);
		ЧтениеJSON.Закрыть();
	Исключение
		ИмяСобытия 	= "ПреобразоватьJSONВСоответствие";
		Комментарий = "Не удалось прочитать JSON: " + ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
		ДанныеJSON = Новый Соответствие;
	КонецПопытки;

	Возврат ДанныеJSON;

