
#Область ОбработчикиСобытийФормы

//+ ИнфоСофт Мурсалимов Д.Р. 15.01.24 УА #68819
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	Если Параметры.Свойство("Профиль") Тогда		
		Профиль = Параметры.Профиль;		
	КонецЕсли;
	
	Если Параметры.Свойство("Маркетплейс") Тогда 		
		Маркетплейс = Перечисления.ИС_МП_Маркетплейсы[Параметры.Маркетплейс];		
	Иначе		
		Маркетплейс = Перечисления.ИС_МП_Маркетплейсы.ВБ;	
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(Профиль) Тогда
		Возврат;
	КонецЕсли;
	
	ЗагрузитьЗапрос();
			
КонецПроцедуры //- ИнфоСофт Мурсалимов Д.Р. 15.01.24 УА #68819

&НаКлиенте
Процедура РеквизитПриИзменении(Элемент)

	Если ЗначениеЗаполнено(Профиль) И ЗначениеЗаполнено(Маркетплейс) Тогда
		ЗагрузитьЗапрос();	
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

//+ ИнфоСофт Мурсалимов Д.Р. 15.01.24 УА #68819
&НаКлиенте
Процедура Сохранить(Команда)
	
	ОчиститьСообщения();
	
	Если Не ЗначениеЗаполнено(Профиль) Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю("Не выбран Профиль", , , "Профиль");
		Возврат;
	КонецЕсли;

	СохранитьНаСервере();
	
КонецПроцедуры //- ИнфоСофт Мурсалимов Д.Р. 15.01.24 УА #68819

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

//+ ИнфоСофт Мурсалимов Д.Р. 15.01.24 УА #68819
&НаСервере
Процедура СохранитьНаСервере()   
	
	СтруктураПараметров = Новый Структура;
	СтруктураПараметров.Вставить("ТекстЗапросаСопоставления", ТекстЗапроса);
	
	ИС_МП_Сервер.ЗаписатьЗначениеНастроек(Профиль, Маркетплейс, СтруктураПараметров, "Строка");
		
КонецПроцедуры //- ИнфоСофт Мурсалимов Д.Р. 15.01.24 УА #68819   

//+ ИнфоСофт Ивонин К.А. 04.03.25 УА #92887
&НаСервере   
Процедура ЗагрузитьЗапрос()
	
	МассивПараметров = Новый Массив();
	МассивПараметров.Добавить("ТекстЗапросаСопоставления");
	
	Настройки = ИС_МП_Сервер.ПолучитьЗначениеНастроек(Профиль, Маркетплейс, МассивПараметров, "Строка");
		
	ТекстЗапроса = Настройки.ТекстЗапросаСопоставления; 
	
КонецПроцедуры //- ИнфоСофт Ивонин К.А. 04.03.25 УА #92887

#КонецОбласти
