					НайденныеСтроки[0].Штрихкод = Выборка.Штрихкод;
					//+ ИнфоСофт Конышев А.Е. 12.12.24 УА #84415
					НайденныеСтроки[0].Упаковка = Выборка.Упаковка; 		
					//- ИнфоСофт Конышев А.Е. 12.12.24 УА #84415
				КонецЕсли;                                  
				//- ИнфоСофт Стояк Ю.К. 20.06.2024 УА #78102
			
				НайденныеСтроки[0].Модифицированность = Истина;	
				
				//+ ИнфоСофт Мурсалимов Д.Р. 01.02.24 УА #69831
				Модифицированность = Истина;
				//- ИнфоСофт Мурсалимов Д.Р. 01.02.24 УА #69831
			
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры //- ИнфоСофт Мурсалимов Д.Р. 24.01.24 УА #68819

//+ ИнфоСофт Мурсалимов Д.Р. 24.01.24 УА #68819
&НаСервере
Процедура ПодборЯМ()
	
	МассивНоменклатур = Новый Массив;
	
	Для Каждого Строка Из ТоварыЯМ Цикл
		
		Если Не ЗначениеЗаполнено(Строка.Номенклатура) Тогда
			МассивНоменклатур.Добавить(Строка.НоменклатураЯМ);
		КонецЕсли;	
		
	КонецЦикла;
	
	Запрос = Новый Запрос;
	
	Если ПодбиратьПо = "Штрихкод" Тогда
		
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	ИС_ЯМ_Номенклатура.Ссылка КАК Ссылка,
		|	ИС_ЯМ_Штрихкоды.Штрихкод КАК Штрихкод
		|ПОМЕСТИТЬ ВТ_Номенклатура
		|ИЗ
		|	Справочник.ИС_ЯМ_Штрихкоды КАК ИС_ЯМ_Штрихкоды
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ИС_ЯМ_Номенклатура КАК ИС_ЯМ_Номенклатура
		|		ПО (ИС_ЯМ_Штрихкоды.Владелец = ИС_ЯМ_Номенклатура.Ссылка)
		|		И ИС_ЯМ_Номенклатура.Ссылка В(&НоменклатураЯМ) 
		|ГДЕ
		|	ИС_ЯМ_Номенклатура.Профиль = &ЛичныйКабинет
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ВТ_Номенклатура.Ссылка КАК Ссылка,
		|	ВТ_Номенклатура.Штрихкод КАК Штрихкод,
		|	ШтрихкодыНоменклатуры.Номенклатура КАК Номенклатура,
		|	ШтрихкодыНоменклатуры.Характеристика КАК Характеристика,
		//+ ИнфоСофт Конышев А.Е. 12.12.24 УА #84415
		|	ШтрихкодыНоменклатуры.Упаковка КАК Упаковка
		//- ИнфоСофт Конышев А.Е. 12.12.24 УА #84415
		|ИЗ
		|	ВТ_Номенклатура КАК ВТ_Номенклатура
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ШтрихкодыНоменклатуры КАК ШтрихкодыНоменклатуры
		|		ПО (ВТ_Номенклатура.Штрихкод = ШтрихкодыНоменклатуры.Штрихкод)
		|		И НЕ ШтрихкодыНоменклатуры.Номенклатура ЕСТЬ NULL";
		
	ИначеЕсли ПодбиратьПо = "Артикул" Тогда
		
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	ИС_ЯМ_Номенклатура.Ссылка КАК Ссылка,
		|	ИС_ЯМ_Номенклатура.shopSku КАК shopSku
		|ПОМЕСТИТЬ ВТ_Номенклатура
		|ИЗ
		|	Справочник.ИС_ЯМ_Номенклатура КАК ИС_ЯМ_Номенклатура
		|ГДЕ
		|	ИС_ЯМ_Номенклатура.Профиль = &ЛичныйКабинет
		|	И ИС_ЯМ_Номенклатура.Ссылка В(&НоменклатураЯМ)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ВТ_Номенклатура.Ссылка КАК Ссылка,
		|	Номенклатура.Ссылка КАК Номенклатура,
		//+ ИнфоСофт Стояк Ю.К. 20.06.2024 УА #78102		
		|	ЗНАЧЕНИЕ(Справочник.ХарактеристикиНоменклатуры.ПустаяСсылка) КАК Характеристика
		//- ИнфоСофт Стояк Ю.К. 20.06.2024 УА #78102
		|ИЗ
		|	ВТ_Номенклатура КАК ВТ_Номенклатура
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Номенклатура КАК Номенклатура
		|		ПО ВТ_Номенклатура.shopSku = Номенклатура.Артикул
		|		И НЕ Номенклатура.Ссылка ЕСТЬ NULL";
		
	Иначе
		
		МассивПараметров = Новый Массив();
		МассивПараметров.Добавить("ТекстЗапросаСопоставления");
	
		Настройки = ИС_МП_Сервер.ПолучитьЗначениеНастроек(Профиль, 
			Перечисления.ИС_МП_Маркетплейсы[Маркетплейс], МассивПараметров, "Строка");
				
		Если ЗначениеЗаполнено(Настройки.ТекстЗапросаСопоставления) Тогда
			Запрос.Текст = Настройки.ТекстЗапросаСопоставления;
		Иначе
			ОбщегоНазначения.СообщитьПользователю("Не заполнен текст запроса для сопоставления, продолжение невозможно...");
			Возврат;
		КонецЕсли;
		
	КонецЕсли;
	
	Запрос.УстановитьПараметр("НоменклатураЯМ", МассивНоменклатур);
	Запрос.УстановитьПараметр("ЛичныйКабинет", Профиль);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Выборка = РезультатЗапроса.Выбрать();
	
	СтруктураПоиска = Новый Структура;
	СтруктураПоиска.Вставить("НоменклатураЯМ");
	
	Пока Выборка.Следующий() Цикл
		
		Если ЗначениеЗаполнено(Выборка.Номенклатура) Тогда
			
			СтруктураПоиска.НоменклатураЯМ = Выборка.Ссылка;
			НайденныеСтроки = ТоварыЯМ.НайтиСтроки(СтруктураПоиска);
			
			Если НайденныеСтроки.Количество() > 0 Тогда
				
				Если ЗначениеЗаполнено(НайденныеСтроки[0].ТекущаяНоменклатура) Тогда
					Продолжить;
				КонецЕсли;
				
				НайденныеСтроки[0].Номенклатура = Выборка.Номенклатура;
				//+ ИнфоСофт Стояк Ю.К. 20.06.2024 УА #78102				
				НайденныеСтроки[0].Характеристика = Выборка.Характеристика;
				Если ПодбиратьПо = "Штрихкод" Тогда
					//НайденныеСтроки[0].Характеристика = Выборка.Характеристика;
					НайденныеСтроки[0].Штрихкод = Выборка.Штрихкод;
					//+ ИнфоСофт Конышев А.Е. 12.12.24 УА #84415
					НайденныеСтроки[0].Упаковка = Выборка.Упаковка;
					//- ИнфоСофт Конышев А.Е. 12.12.24 УА #84415
				КонецЕсли;                                  
				//- ИнфоСофт Стояк Ю.К. 20.06.2024 УА #78102
				
				НайденныеСтроки[0].Модифицированность = Истина;	
				
				//+ ИнфоСофт Мурсалимов Д.Р. 01.02.24 УА #69831
				Модифицированность = Истина;
				//- ИнфоСофт Мурсалимов Д.Р. 01.02.24 УА #69831
			
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры //- ИнфоСофт Мурсалимов Д.Р. 24.01.24 УА #68819

//+ ИнфоСофт Мурсалимов Д.Р. 24.01.24 УА #68819
&НаСервере
Процедура ПодборМегаМаркет()
	
	Запрос = Новый Запрос;
	
	Если ПодбиратьПо = "Штрихкод" Тогда
		
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	ШтрихкодыНоменклатуры.Номенклатура КАК Номенклатура,
		|	ШтрихкодыНоменклатуры.Характеристика КАК Характеристика,
		//+ ИнфоСофт Конышев А.Е. 12.12.24 УА #84415
		|	ШтрихкодыНоменклатуры.Упаковка КАК Упаковка,
		//- ИнфоСофт Конышев А.Е. 12.12.24 УА #84415
		|	ИС_Сбер_Номенклатура.offer_id КАК offerID,
		|	ИС_Сбер_Номенклатура.Ссылка КАК НоменклатураМегаМаркет
		|ИЗ
		|	Справочник.ИС_Сбер_Номенклатура КАК ИС_Сбер_Номенклатура
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ШтрихкодыНоменклатуры КАК ШтрихкодыНоменклатуры
		|		ПО (ИС_Сбер_Номенклатура.Штрихкод = ШтрихкодыНоменклатуры.Штрихкод)
		|ГДЕ
		|	ИС_Сбер_Номенклатура.Профиль = &Профиль     
		|	
		|";
		
	ИначеЕсли ПодбиратьПо = "Артикул" Тогда
		
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	Номенклатура.Ссылка КАК Номенклатура,
		|	ЗНАЧЕНИЕ(Справочник.ХарактеристикиНоменклатуры.ПустаяСсылка) КАК Характеристика,
		|	Номенклатура.Артикул КАК offerID,
		|	ИС_Сбер_Номенклатура.Ссылка КАК НоменклатураМегаМаркет
		|ИЗ
		|	Справочник.ИС_Сбер_Номенклатура КАК ИС_Сбер_Номенклатура
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Номенклатура КАК Номенклатура
		|		ПО ИС_Сбер_Номенклатура.offer_id = Номенклатура.Артикул
		|ГДЕ
		|	ИС_Сбер_Номенклатура.Профиль = &Профиль";
		
	ИначеЕсли ПодбиратьПо = "ПроизвольныйЗапрос" Тогда
		
		МассивПараметров = Новый Массив();
		МассивПараметров.Добавить("ТекстЗапросаСопоставления");
	
		Настройки = ИС_МП_Сервер.ПолучитьЗначениеНастроек(Профиль, 
			Перечисления.ИС_МП_Маркетплейсы[Маркетплейс], МассивПараметров, "Строка");
				
		Если ЗначениеЗаполнено(Настройки.ТекстЗапросаСопоставления) Тогда
			Запрос.Текст = Настройки.ТекстЗапросаСопоставления;
		Иначе
			ОбщегоНазначения.СообщитьПользователю("Не заполнен текст запроса для сопоставления, продолжение невозможно...");
			Возврат;
		КонецЕсли; 
		
	ИначеЕсли ПодбиратьПо = "Реквизит" Тогда   
		
		Если РеквизитПодбора = "" Тогда		
			ОбщегоНазначения.СообщитьПользователю("Не выбран реквизит подбора, продолжение невозможно...");
			Возврат;		
		КонецЕсли;
		
		Если РеквизитПодбора = "Код" Тогда
			
			Запрос.Текст = 
			"ВЫБРАТЬ
			|	Номенклатура.Ссылка КАК Номенклатура,
			|	ЗНАЧЕНИЕ(Справочник.ХарактеристикиНоменклатуры.ПустаяСсылка) КАК Характеристика,
			|	Номенклатура.Код КАК offerID,
			|	ИС_Сбер_Номенклатура.Ссылка КАК НоменклатураМегаМаркет
			|ИЗ
			|	Справочник.ИС_Сбер_Номенклатура КАК ИС_Сбер_Номенклатура
			|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Номенклатура КАК Номенклатура
			|		ПО (ИС_Сбер_Номенклатура.offer_id = Номенклатура.Код)
			|ГДЕ
			|	ИС_Сбер_Номенклатура.Профиль = &Профиль
			|";
			
		ИначеЕсли РеквизитПодбора = "АртикулПроизводителя" Тогда
			
			Запрос.Текст = 
			"ВЫБРАТЬ
			|	Номенклатура.Ссылка КАК Номенклатура,
			|	ЗНАЧЕНИЕ(Справочник.ХарактеристикиНоменклатуры.ПустаяСсылка) КАК Характеристика,
			|	ИС_Сбер_Номенклатура.offer_id КАК offerID,
			|	ИС_Сбер_Номенклатура.Ссылка КАК НоменклатураМегаМаркет
			|ИЗ
			|	Справочник.ИС_Сбер_Номенклатура КАК ИС_Сбер_Номенклатура
			|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Номенклатура КАК Номенклатура
			|		ПО (ИС_Сбер_Номенклатура.vendorCode = Номенклатура.Артикул)
			|			И (ИС_Сбер_Номенклатура.Профиль = &Профиль) 
			|			И НЕ Номенклатура.Артикул = """"
			|";
			
		ИначеЕсли РеквизитПодбора = "ДопРеквизит" Тогда
			
			Если ЗначениеЗаполнено(ДопРеквизит) Тогда
				Справочник = ДопРеквизит.НаборСвойств.Родитель.Наименование; 
			Иначе
				Справочник = "";
			КонецЕсли;
			
			Если Справочник = "Характеристики Номенклатуры" Тогда
				
				Запрос.Текст = 
				"ВЫБРАТЬ
				|	ХарактеристикиНоменклатурыДополнительныеРеквизиты.Ссылка.Владелец КАК Номенклатура,
				|	ХарактеристикиНоменклатурыДополнительныеРеквизиты.Ссылка КАК Характеристика,
				|	ХарактеристикиНоменклатурыДополнительныеРеквизиты.Значение КАК offerID,
				|	ИС_Сбер_Номенклатура.Ссылка КАК НоменклатураМегаМаркет
				|ИЗ
				|	Справочник.ИС_Сбер_Номенклатура КАК ИС_Сбер_Номенклатура
				|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ХарактеристикиНоменклатуры.ДополнительныеРеквизиты КАК ХарактеристикиНоменклатурыДополнительныеРеквизиты
				|		ПО (ИС_Сбер_Номенклатура.offer_id = ХарактеристикиНоменклатурыДополнительныеРеквизиты.Значение)
				|ГДЕ
				|	ХарактеристикиНоменклатурыДополнительныеРеквизиты.Свойство = &Свойство
				|	И НЕ ХарактеристикиНоменклатурыДополнительныеРеквизиты.Значение ЕСТЬ NULL
				|	И ИС_Сбер_Номенклатура.Профиль = &Профиль
				|"; 
				
				Запрос.УстановитьПараметр("Свойство", ДопРеквизит); 
				
			ИначеЕсли Справочник = "Номенклатура" Тогда
				
				Запрос.Текст = 
				"ВЫБРАТЬ
				|	НоменклатураДополнительныеРеквизиты.Ссылка КАК Номенклатура,
				|	ЗНАЧЕНИЕ(Справочник.ХарактеристикиНоменклатуры.ПустаяСсылка) КАК Характеристика,
				|	НоменклатураДополнительныеРеквизиты.Значение КАК offerID,
				|	ИС_Сбер_Номенклатура.Ссылка КАК НоменклатураМегаМаркет
				|ИЗ
				|	Справочник.ИС_Сбер_Номенклатура КАК ИС_Сбер_Номенклатура
				|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Номенклатура.ДополнительныеРеквизиты КАК НоменклатураДополнительныеРеквизиты
				|		ПО (ИС_Сбер_Номенклатура.offer_id = НоменклатураДополнительныеРеквизиты.Значение)
				|ГДЕ
				|	НоменклатураДополнительныеРеквизиты.Свойство = &Свойство
				|	И НЕ НоменклатураДополнительныеРеквизиты.Значение ЕСТЬ NULL
				|	И ИС_Сбер_Номенклатура.Профиль = &Профиль
				|";
				
				Запрос.УстановитьПараметр("Свойство", ДопРеквизит);
				
			КонецЕсли; 
			
		КонецЕсли;
		
	КонецЕсли;
	
	Запрос.УстановитьПараметр("Профиль", Профиль);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Если РезультатЗапроса.Пустой() Тогда
		ОбщегоНазначения.СообщитьПользователю("Не удалось найти сопоставление");
		Возврат;
	КонецЕсли;  
	
	Выборка = РезультатЗапроса.Выбрать(); 
	
	СтруктураПоиска = Новый Структура;
	СтруктураПоиска.Вставить("НоменклатураМегаМаркет");
	
	Пока Выборка.Следующий() Цикл 
		
		Если ЗначениеЗаполнено(Выборка.Номенклатура) Тогда
			
			СтруктураПоиска.НоменклатураМегаМаркет = Выборка.НоменклатураМегаМаркет;
			НайденныеСтроки = ТоварыСбер.НайтиСтроки(СтруктураПоиска);
			
			Если НайденныеСтроки.Количество() > 0 Тогда
				
				Если ЗначениеЗаполнено(НайденныеСтроки[0].ТекущаяНоменклатура) Тогда
					Продолжить;
				КонецЕсли;
				
				НайденныеСтроки[0].Номенклатура = Выборка.Номенклатура;
				НайденныеСтроки[0].Характеристика = Выборка.Характеристика;
				НайденныеСтроки[0].OfferID = Выборка.offerID;
				НайденныеСтроки[0].НоменклатураМегаМаркет = Выборка.НоменклатураМегаМаркет;
				//+ ИнфоСофт Конышев А.Е. 12.12.24 УА #84415
				Если ПодбиратьПо = "Штрихкод" Тогда
					НайденныеСтроки[0].Упаковка = Выборка.Упаковка; 		
				КонецЕсли;
				//- ИнфоСофт Конышев А.Е. 12.12.24 УА #84415
				НайденныеСтроки[0].Модифицированность = Истина;
				
				//+ ИнфоСофт Мурсалимов Д.Р. 01.02.24 УА #69831
				Модифицированность = Истина;
				//- ИнфоСофт Мурсалимов Д.Р. 01.02.24 УА #69831
		
			Иначе
		
				НоваяСтрока = ТоварыСбер.Добавить();
				НоваяСтрока.Номенклатура = Выборка.Номенклатура;
				НоваяСтрока.Характеристика = Выборка.Характеристика;
				НоваяСтрока.OfferID = Выборка.offerID; 
				НоваяСтрока.НоменклатураМегаМаркет = Выборка.НоменклатураМегаМаркет;
				//+ ИнфоСофт Конышев А.Е. 12.12.24 УА #84415
				Если ПодбиратьПо = "Штрихкод" Тогда
					НоваяСтрока.Упаковка = Выборка.Упаковка; 		
				КонецЕсли;
				//- ИнфоСофт Конышев А.Е. 12.12.24 УА #84415
			
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры //- ИнфоСофт Мурсалимов Д.Р. 24.01.24 УА #68819

//+ ИнфоСофт Мурсалимов Д.Р. 24.01.24 УА #68819
&НаСервере
Процедура ПодборAli()
	
	Запрос = Новый Запрос;
	
	Если ПодбиратьПо = "Штрихкод" Тогда
		
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	ИС_АЛИ_Вариации.Ссылка КАК ВариацияАли,
		|	ШтрихкодыНоменклатуры.Номенклатура КАК Номенклатура,
		|	ШтрихкодыНоменклатуры.Характеристика КАК Характеристика,
		//+ ИнфоСофт Конышев А.Е. 12.12.24 УА #84415
		|	ШтрихкодыНоменклатуры.Упаковка КАК Упаковка
		//- ИнфоСофт Конышев А.Е. 12.12.24 УА #84415
		|ИЗ
		|	Справочник.ИС_АЛИ_Вариации КАК ИС_АЛИ_Вариации
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ШтрихкодыНоменклатуры КАК ШтрихкодыНоменклатуры
		|		ПО ИС_АЛИ_Вариации.КодВариации = ШтрихкодыНоменклатуры.Штрихкод
		|ГДЕ
		|	ИС_АЛИ_Вариации.Профиль = &Профиль";
		
	ИначеЕсли ПодбиратьПо = "Артикул" Тогда
		
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	ИС_АЛИ_Вариации.Ссылка КАК ВариацияАли,
		|	Номенклатура.Ссылка КАК Номенклатура
		|ИЗ
		|	Справочник.ИС_АЛИ_Вариации КАК ИС_АЛИ_Вариации
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Номенклатура КАК Номенклатура
		|		ПО ИС_АЛИ_Вариации.КодВариации = Номенклатура.Артикул
		|ГДЕ
		|	ИС_АЛИ_Вариации.Профиль = &Профиль";
		
	ИначеЕсли ПодбиратьПо = "ПроизвольныйЗапрос" Тогда
		
		МассивПараметров = Новый Массив();
		МассивПараметров.Добавить("ТекстЗапросаСопоставления");
	
		Настройки = ИС_МП_Сервер.ПолучитьЗначениеНастроек(Профиль, 
			Перечисления.ИС_МП_Маркетплейсы[Маркетплейс], МассивПараметров, "Строка");
				
		Если ЗначениеЗаполнено(Настройки.ТекстЗапросаСопоставления) Тогда
			Запрос.Текст = Настройки.ТекстЗапросаСопоставления;
		Иначе
			ОбщегоНазначения.СообщитьПользователю("Не заполнен текст запроса для сопоставления, продолжение невозможно...");
			Возврат;
		КонецЕсли; 
		
	ИначеЕсли ПодбиратьПо = "Реквизит" Тогда
		
		Если РеквизитПодбора = "" Тогда		
			ОбщегоНазначения.СообщитьПользователю("Не выбран реквизит подбора, продолжение невозможно...");
			Возврат;		
		КонецЕсли;
		
		Если РеквизитПодбора = "ДопРеквизит" Тогда
			
			Если ЗначениеЗаполнено(ДопРеквизит) Тогда
				Справочник = ДопРеквизит.НаборСвойств.Родитель.Наименование; 
			Иначе
				Справочник = "";
			КонецЕсли;
			
			Если Справочник = "Характеристики Номенклатуры" Тогда
				
				Запрос.Текст = 
				"ВЫБРАТЬ
				|	ХарактеристикиНоменклатурыДополнительныеРеквизиты.Ссылка.Владелец КАК Номенклатура,
				|	ХарактеристикиНоменклатурыДополнительныеРеквизиты.Ссылка КАК Характеристика,
				|	ИС_АЛИ_Вариации.Ссылка КАК ВариацияАли
				|ИЗ
				|	Справочник.ИС_АЛИ_Вариации КАК ИС_АЛИ_Вариации
				|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ХарактеристикиНоменклатуры.ДополнительныеРеквизиты КАК ХарактеристикиНоменклатурыДополнительныеРеквизиты
				|		ПО (ИС_АЛИ_Вариации.КодВариации = ХарактеристикиНоменклатурыДополнительныеРеквизиты.Значение)
				|ГДЕ
				|	ХарактеристикиНоменклатурыДополнительныеРеквизиты.Свойство = &Свойство
				|	И НЕ ХарактеристикиНоменклатурыДополнительныеРеквизиты.Значение ЕСТЬ NULL
				|	И ИС_АЛИ_Вариации.Профиль = &Профиль
				|"; 
				
				Запрос.УстановитьПараметр("Свойство", ДопРеквизит); 
				
			ИначеЕсли Справочник = "Номенклатура" Тогда
				
				Запрос.Текст = 
				"ВЫБРАТЬ
				|	НоменклатураДополнительныеРеквизиты.Ссылка КАК Номенклатура,
				|	ЗНАЧЕНИЕ(Справочник.ХарактеристикиНоменклатуры.ПустаяСсылка) КАК Характеристика,
				|	ИС_АЛИ_Вариации.Ссылка КАК ВариацияАли
				|ИЗ
				|	Справочник.ИС_АЛИ_Вариации КАК ИС_АЛИ_Вариации
				|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Номенклатура.ДополнительныеРеквизиты КАК НоменклатураДополнительныеРеквизиты
				|		ПО (ИС_АЛИ_Вариации.КодВариации = НоменклатураДополнительныеРеквизиты.Значение)
				|ГДЕ
				|	НоменклатураДополнительныеРеквизиты.Свойство = &Свойство
				|	И НЕ НоменклатураДополнительныеРеквизиты.Значение ЕСТЬ NULL
				|	И ИС_АЛИ_Вариации.Профиль = &Профиль
				|";
				
				Запрос.УстановитьПараметр("Свойство", ДопРеквизит); 
				
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЕсли; 
	
	Запрос.УстановитьПараметр("Профиль", Профиль);

	РезультатЗапроса = Запрос.Выполнить();
	
	Выборка = РезультатЗапроса.Выбрать();
	
	СтруктураПоиска = Новый Структура;
	СтруктураПоиска.Вставить("ВариацияАли");
	
	Пока Выборка.Следующий() Цикл
		
		Если ЗначениеЗаполнено(Выборка.Номенклатура) Тогда
			
			СтруктураПоиска.ВариацияАли = Выборка.ВариацияАли;
			НайденныеСтроки = ТоварыАли.НайтиСтроки(СтруктураПоиска);
			
			Если НайденныеСтроки.Количество() > 0 Тогда
				
				Если ЗначениеЗаполнено(НайденныеСтроки[0].ТекущаяНоменклатура) Тогда
					Продолжить;
				КонецЕсли;
				
				НайденныеСтроки[0].Номенклатура = Выборка.Номенклатура;					
				
				Если ПодбиратьПо = "Штрихкод" Тогда
					НайденныеСтроки[0].Характеристика = Выборка.Характеристика;
					//+ ИнфоСофт Конышев А.Е. 12.12.24 УА #84415
					НайденныеСтроки[0].Упаковка = Выборка.Упаковка; 		
					//- ИнфоСофт Конышев А.Е. 12.12.24 УА #84415
				КонецЕсли;
			
				НайденныеСтроки[0].Модифицированность = Истина;
				
				//+ ИнфоСофт Мурсалимов Д.Р. 01.02.24 УА #69831
				Модифицированность = Истина;
				//- ИнфоСофт Мурсалимов Д.Р. 01.02.24 УА #69831
			
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры //- ИнфоСофт Мурсалимов Д.Р. 24.01.24 УА #68819

