//+ ИнфоСофт Ивонин К.А. 28.10.24 УА #68001
&НаСервере
Процедура УстановитьУсловноеОформление()

	УсловноеОформление.Элементы.Очистить();
	
	ТипЭлементОтбораКомпоновкиДанных = Тип("ЭлементОтбораКомпоновкиДанных");
	ОформлениеЦветТекста = "ЦветТекста";
	
	ИнтегрируемыеМаркетплейсы = ИС_МП_Сервер.ИнтегрируемыеМаркетплейсы();
		
	Для Каждого МП Из ИнтегрируемыеМаркетплейсы Цикл 
		
		ТоварыМП = "Товары" + МП; 
		
		// Номенклатура не заполнена
		
		Элемент = УсловноеОформление.Элементы.Добавить();
		ПолеЭлемента = Элемент.Поля.Элементы.Добавить();
		ПолеЭлемента.Поле = Новый ПолеКомпоновкиДанных(ТоварыМП);
		
		ОтборЭлемента = Элемент.Отбор.Элементы.Добавить(ТипЭлементОтбораКомпоновкиДанных);
		ОтборЭлемента.ЛевоеЗначение = Новый ПолеКомпоновкиДанных(ТоварыМП + ".Номенклатура");
		ОтборЭлемента.ВидСравнения = ВидСравненияКомпоновкиДанных.НеЗаполнено;
		
		Элемент.Оформление.УстановитьЗначениеПараметра(ОформлениеЦветТекста, ЦветаСтиля.ЦветОсобогоТекста);
		
		// Номенклатура заполнена
		
		Элемент = УсловноеОформление.Элементы.Добавить();
		ПолеЭлемента = Элемент.Поля.Элементы.Добавить();
		ПолеЭлемента.Поле = Новый ПолеКомпоновкиДанных(ТоварыМП);
		
		ОтборЭлемента = Элемент.Отбор.Элементы.Добавить(ТипЭлементОтбораКомпоновкиДанных);
		ОтборЭлемента.ЛевоеЗначение = Новый ПолеКомпоновкиДанных(ТоварыМП + ".Номенклатура");
		ОтборЭлемента.ВидСравнения = ВидСравненияКомпоновкиДанных.Заполнено;
		
		Элемент.Оформление.УстановитьЗначениеПараметра(ОформлениеЦветТекста, ЦветаСтиля.ЦветАкцента);
		
		// Модифицированность
		
		Элемент = УсловноеОформление.Элементы.Добавить();
		ПолеЭлемента = Элемент.Поля.Элементы.Добавить();
		ПолеЭлемента.Поле = Новый ПолеКомпоновкиДанных(ТоварыМП);
		
		ОтборЭлемента = Элемент.Отбор.Элементы.Добавить(ТипЭлементОтбораКомпоновкиДанных);
		ОтборЭлемента.ЛевоеЗначение = Новый ПолеКомпоновкиДанных(ТоварыМП + ".Модифицированность");
		ОтборЭлемента.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
		ОтборЭлемента.ПравоеЗначение = Истина;
		
		Элемент.Оформление.УстановитьЗначениеПараметра(ОформлениеЦветТекста, WebЦвета.ТемноОранжевый);
		
	КонецЦикла;
					
КонецПроцедуры //- ИнфоСофт Ивонин К.А. 28.10.24 УА #68001

//+ ИнфоСофт Ивонин К.А. 21.10.24 УА #86001
&НаСервере   
Процедура ОпределитьИнтегрируемыеМаркетплейсы()
	
	ИнтегрируемыеМаркетплейсы = ИС_МП_Сервер.ИнтегрируемыеМаркетплейсы();
		
	СтруктураНастроек = Новый Структура;
	
	Для Каждого Элемент Из ИнтегрируемыеМаркетплейсы Цикл
		СтруктураНастроек.Вставить(Элемент, ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Профиль, "Интеграция" + Элемент));	
	КонецЦикла;
	
	ТребуетсяСменаСтраницы = Ложь;
	ПерваяДоступнаяСтраница = Неопределено;
	ОТУпаковки = Новый ОписаниеТипов(ИС_МП_СерверЛокализация.СтрокаТипУпаковка());
	
	Для Каждого Элемент Из СтруктураНастроек Цикл 
		
		ИмяСтраницы = "Страница" + Элемент.Ключ;
		Видимость = ?(Элемент.Значение = Неопределено, Ложь, Элемент.Значение);
		Элементы[ИмяСтраницы].Видимость = Видимость;
		
		Если Видимость Тогда	
			Элементы["Товары" + Элемент.Ключ + "Упаковка"].ОграничениеТипа = ОТУпаковки;	
		КонецЕсли;
		
		Если Видимость И Не ЗначениеЗаполнено(ПерваяДоступнаяСтраница) Тогда
			ПерваяДоступнаяСтраница = ИмяСтраницы; 
		КонецЕсли;
		
		Если Не Видимость И Элементы.ГруппаСтраницы.ТекущаяСтраница = Элементы[ИмяСтраницы] Тогда
			ТребуетсяСменаСтраницы = Истина;	
		КонецЕсли;
		
	КонецЦикла;
	
	Если ТребуетсяСменаСтраницы Тогда 
		
		Если ЗначениеЗаполнено(ПерваяДоступнаяСтраница) Тогда
			Элементы.ГруппаСтраницы.ТекущаяСтраница = Элементы[ПерваяДоступнаяСтраница];		
		Иначе
			
			Для Каждого Страница Из Элементы.ГруппаСтраницы.ПодчиненныеЭлементы Цикл
				
				Если Страница.Видимость Тогда
					Элементы.ГруппаСтраницы.ТекущаяСтраница = Страница;
					Прервать;
				КонецЕсли;
				
			КонецЦикла;

		КонецЕсли;		
			
	КонецЕсли;
	
КонецПроцедуры //- ИнфоСофт Ивонин К.А. 21.10.24 УА #86001

//+ ИнфоСофт Мурсалимов Д.Р. 15.01.24 УА #68819
&НаКлиенте
Процедура УправлениеФормой()

	Элементы.ГруппаСтраницы.ТекущаяСтраница = Элементы["Страница" + Маркетплейс];
	ПоследнийМаркетплейс = Маркетплейс;
	
	Если ЗначениеЗаполнено(Профиль) Тогда
		ЗаполнитьТаблицуСопоставления();
	КонецЕсли;
	
	Если ПодбиратьПо = "Реквизит" Тогда
	
		Если Маркетплейс = "Сбер" Или Маркетплейс = "Али" Тогда
			Элементы.ГруппПодборРеквизит.Видимость = Истина;
		Иначе
			ПодбиратьПо = "ПроизвольныйЗапрос";
		    ОбщегоНазначенияКлиент.СообщитьПользователю("Подбор по ""Реквизиту"" доступен только для Маркетплейсов ""Мега Маркет"" и ""Aliexpress""");
		КонецЕсли;
			
	Иначе
		Элементы.ГруппПодборРеквизит.Видимость = Ложь;
	КонецЕсли;
	
	Если ПодбиратьПо = "ПроизвольныйЗапрос" Тогда
		Элементы.УстановитьТекстЗапроса.Видимость = Истина;
	Иначе
		Элементы.УстановитьТекстЗапроса.Видимость = Ложь;
	КонецЕсли;
	
КонецПроцедуры //- ИнфоСофт Мурсалимов Д.Р. 15.01.24 УА #68819

//+ ИнфоСофт Мурсалимов Д.Р. 15.01.24 УА #68819
&НаСервереБезКонтекста   
Функция ПолучитьТекстЗапроса(Маркетплейс)
    
	Текст = "";
	
	//+ ИнфоСофт Мурсалимов Д.Р. 17.01.24 УА #62628
	//Добавил упаковки
	//- ИнфоСофт Мурсалимов Д.Р. 17.01.24 УА #62628
		
	Если Маркетплейс = "Озон" Тогда
		
		Текст = 
		"ВЫБРАТЬ
		|	ЕСТЬNULL(ИС_Ozon_СоответствиеХарактеристик.Номенклатура, ЗНАЧЕНИЕ(Справочник.Номенклатура.ПустаяСсылка)) КАК Номенклатура,
		|	ЕСТЬNULL(ИС_Ozon_СоответствиеХарактеристик.Характеристика, ЗНАЧЕНИЕ(Справочник.ХарактеристикиНоменклатуры.ПустаяСсылка)) КАК Характеристика,
		|	ИС_Ozon_Номенклатура.Ссылка КАК НоменклатураOzon,
		|	ВЫБОР
		|		КОГДА ИС_Ozon_СоответствиеХарактеристик.Упаковка = &ПустаяУпаковка
		|				ИЛИ ИС_Ozon_СоответствиеХарактеристик.Упаковка ЕСТЬ NULL
		|			ТОГДА ИС_Ozon_СоответствиеХарактеристик.Номенклатура.ЕдиницаИзмерения
		|		ИНАЧЕ ИС_Ozon_СоответствиеХарактеристик.Упаковка
		|	КОНЕЦ КАК Упаковка
		|ИЗ
		|	Справочник.ИС_Ozon_Номенклатура КАК ИС_Ozon_Номенклатура
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ИС_Ozon_СоответствиеХарактеристик КАК ИС_Ozon_СоответствиеХарактеристик
