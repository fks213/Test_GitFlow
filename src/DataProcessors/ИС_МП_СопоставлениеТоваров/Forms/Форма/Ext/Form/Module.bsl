//+ ИнфоСофт Мурсалимов Д.Р. 08.12.23 УА #67006
&НаСервере
Процедура ЗаполнитьТаблицуСопоставления()
	
	МП = Перечисления.ИС_МП_Маркетплейсы[Маркетплейс];
	
	МассивПараметров = Новый Массив;
	МассивПараметров.Добавить("СопоставлятьПо");
	
	Настройки = ИС_МП_Сервер.ПолучитьЗначениеНастроек(Профиль, МП, МассивПараметров);
	
	Если ЗначениеЗаполнено(Настройки.СопоставлятьПо) Тогда
		ПодбиратьПо = Настройки.СопоставлятьПо;	
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = ПолучитьТекстЗапроса(Маркетплейс);
	
	Запрос.УстановитьПараметр("Профиль", Профиль);
	Запрос.УстановитьПараметр("ПустаяУпаковка", ИС_МП_СерверЛокализация.ПустаяСсылкаУпаковка());
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Выборка = РезультатЗапроса.Выбрать();
	
	Таблица = ЭтотОбъект["Товары" + Маркетплейс];
	
	Таблица.Очистить();
	
	КоличествоСопоставленных = 0;	
	
	Пока Выборка.Следующий() Цикл
		
		НоваяСтрока = Таблица.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, Выборка);	
		НоваяСтрока.ТекущаяНоменклатура = Выборка.Номенклатура;
		НоваяСтрока.ТекущаяХарактеристика = Выборка.Характеристика;
		НоваяСтрока.ТекущаяУпаковка = Выборка.Упаковка;
		
		Если ЗначениеЗаполнено(Выборка.Номенклатура) Тогда
			КоличествоСопоставленных = КоличествоСопоставленных + 1;
		КонецЕсли;
		
	КонецЦикла;
	
	Делитель = ?(Выборка.Количество() = 0, 1, Выборка.Количество()); 
	ПроцентСопоставленны = Окр(КоличествоСопоставленных / Делитель * 100, 2);	
	ПроцентСопоставления = СтрШаблон("%1 / %2 (%3%%)", 
		КоличествоСопоставленных, Выборка.Количество(), ПроцентСопоставленны);
	
КонецПроцедуры //- ИнфоСофт Мурсалимов Д.Р. 08.12.23 УА #67006

//+ ИнфоСофт Мурсалимов Д.Р. 08.12.23 УА #67006
&НаКлиенте
Процедура ПрофильПриИзмененииЗавершение(Результат, Параметры) Экспорт
	
	Если Результат.Значение = КодВозвратаДиалога.Да Тогда
		ЗаполнитьТаблицуСопоставления();
		Модифицированность = Ложь;
		ОпределитьИнтегрируемыеМаркетплейсы();
	КонецЕсли;   
	
КонецПроцедуры //- ИнфоСофт Мурсалимов Д.Р. 08.12.23 УА #67006

//+ ИнфоСофт Мурсалимов Д.Р. 16.01.24 УА #68819
&НаСервере
Процедура ПодборНаСервере(МассивСопоставления, ПолеСопоставления)
	
	Если Маркетплейс = "Озон" Тогда	
		ПодборOzon();
		Возврат;
	ИначеЕсли Маркетплейс = "ЯМ" Тогда	
		ПодборЯМ();
		Возврат;
	ИначеЕсли Маркетплейс = "Сбер" Тогда	
		ПодборМегаМаркет();
		Возврат;
	ИначеЕсли Маркетплейс = "Али" Тогда	
		ПодборAli();
		Возврат;
	ИначеЕсли Маркетплейс = "МВМ" Тогда	
		ПодборМВМ();
		Возврат;
	//+ ИнфоСофт Власова И.С. 23.12.24 УА #90120
	ИначеЕсли Маркетплейс = "Ламода" Тогда	
		ПодборЛамода();
		Возврат;
	//- ИнфоСофт Власова И.С. 23.12.24 УА #90120	
	КонецЕсли;

	ПараметрыПодбора = Новый Структура("СопоставлятьПо", ПодбиратьПо);
	
	РезультатПодбора = ИС_МП_Сервер.ПодобратьТовары(Маркетплейс, Профиль, МассивСопоставления, ПараметрыПодбора); 
	
	Если РезультатПодбора = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если РезультатПодбора.Количество() = 0 Тогда
		Возврат;	
	КонецЕсли;
	
	Для Каждого Строка Из РезультатПодбора Цикл
		
		Отбор = Новый Структура(ПолеСопоставления, Строка.ПолеСопоставления);
		
		НайденныеСтроки = ЭтотОбъект["Товары" + Маркетплейс].НайтиСтроки(Отбор);
		
		Если НайденныеСтроки.Количество() > 0 Тогда
			
			Если ЗначениеЗаполнено(НайденныеСтроки[0].ТекущаяНоменклатура) Тогда
				Продолжить;
			КонецЕсли;
			
			ЗаполнитьЗначенияСвойств(НайденныеСтроки[0], Строка);
			
			НайденныеСтроки[0].Модифицированность = Истина;
			Модифицированность = Истина;

		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры //- ИнфоСофт Мурсалимов Д.Р. 16.01.24 УА #68819

//+ ИнфоСофт Мурсалимов Д.Р. 24.01.24 УА #68819
&НаСервере
Процедура ПодборOzon()
	
	МассивНоменклатур = Новый Массив;
	
	Для Каждого Строка Из ТоварыОзон Цикл
		
		Если Не ЗначениеЗаполнено(Строка.Номенклатура) Тогда
			МассивНоменклатур.Добавить(Строка.НоменклатураOzon);
		КонецЕсли;	
		
	КонецЦикла;
	
	Запрос = Новый Запрос;
	
	Если ПодбиратьПо = "Штрихкод" Тогда
		
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	ИС_Ozon_Номенклатура.Ссылка КАК Ссылка,
		|	ИС_Ozon_Штрихкоды.Наименование КАК Штрихкод
		|ПОМЕСТИТЬ ВТ_Номенклатура
		|ИЗ
		|	Справочник.ИС_Ozon_Штрихкоды КАК ИС_Ozon_Штрихкоды
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ИС_Ozon_Номенклатура КАК ИС_Ozon_Номенклатура
		|		ПО (ИС_Ozon_Штрихкоды.Карточка = ИС_Ozon_Номенклатура.Ссылка)
		|		И ИС_Ozon_Номенклатура.Ссылка В(&НоменклатураOzon) 
		|ГДЕ
		|	ИС_Ozon_Номенклатура.Профиль = &ЛичныйКабинет
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ВТ_Номенклатура.Ссылка КАК Ссылка,
		|	ВТ_Номенклатура.Штрихкод КАК Штрихкод,
		|	ШтрихкодыНоменклатуры.Номенклатура КАК Номенклатура,
		|	ШтрихкодыНоменклатуры.Характеристика КАК Характеристика,
		//+ ИнфоСофт Конышев А.Е. 12.12.24 УА #84415
		|	ШтрихкодыНоменклатуры.Упаковка КАК Упаковка
		//- ИнфоСофт Конышев А.Е. 12.12.24 УА #84415
		|ИЗ
		|	ВТ_Номенклатура КАК ВТ_Номенклатура
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ШтрихкодыНоменклатуры КАК ШтрихкодыНоменклатуры
		|		ПО (ВТ_Номенклатура.Штрихкод = ШтрихкодыНоменклатуры.Штрихкод)   
		|		И НЕ ШтрихкодыНоменклатуры.Номенклатура ЕСТЬ NULL"
		
	ИначеЕсли ПодбиратьПо = "Артикул" Тогда
		
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	ИС_Ozon_Номенклатура.Ссылка КАК Ссылка,
		|	ИС_Ozon_Номенклатура.offer_id КАК offer_id
		|ПОМЕСТИТЬ ВТ_Номенклатура
		|ИЗ
		|	Справочник.ИС_Ozon_Номенклатура КАК ИС_Ozon_Номенклатура
		|ГДЕ
		|	ИС_Ozon_Номенклатура.Профиль = &ЛичныйКабинет
		|	И ИС_Ozon_Номенклатура.Ссылка В(&НоменклатураOzon) 
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ВТ_Номенклатура.Ссылка КАК Ссылка,
		|	Номенклатура.Ссылка КАК Номенклатура,
		//+ ИнфоСофт Стояк Ю.К. 20.06.2024 УА #78102		
		|	ЗНАЧЕНИЕ(Справочник.ХарактеристикиНоменклатуры.ПустаяСсылка) КАК Характеристика
		//- ИнфоСофт Стояк Ю.К. 20.06.2024 УА #78102
		|ИЗ
		|	ВТ_Номенклатура КАК ВТ_Номенклатура
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Номенклатура КАК Номенклатура
		|		ПО ВТ_Номенклатура.offer_id = Номенклатура.Артикул
		|		И НЕ Номенклатура.Ссылка ЕСТЬ NULL";    
		
	Иначе
		
		МассивПараметров = Новый Массив();
		МассивПараметров.Добавить("ТекстЗапросаСопоставления");
	
		Настройки = ИС_МП_Сервер.ПолучитьЗначениеНастроек(Профиль, 
			Перечисления.ИС_МП_Маркетплейсы[Маркетплейс], МассивПараметров, "Строка");
				
		Если ЗначениеЗаполнено(Настройки.ТекстЗапросаСопоставления) Тогда
			Запрос.Текст = Настройки.ТекстЗапросаСопоставления;
		Иначе
			ОбщегоНазначения.СообщитьПользователю("Не заполнен текст запроса для сопоставления, продолжение невозможно...");
			Возврат;
		КонецЕсли;
		
	КонецЕсли;
	
	Запрос.УстановитьПараметр("НоменклатураOzon", МассивНоменклатур);
	Запрос.УстановитьПараметр("ЛичныйКабинет", Профиль);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Выборка = РезультатЗапроса.Выбрать();
	
	СтруктураПоиска = Новый Структура;
	СтруктураПоиска.Вставить("НоменклатураOzon");
	
	Пока Выборка.Следующий() Цикл
		
		Если ЗначениеЗаполнено(Выборка.Номенклатура) Тогда
			
			СтруктураПоиска.НоменклатураOzon = Выборка.Ссылка;
			НайденныеСтроки = ТоварыОзон.НайтиСтроки(СтруктураПоиска);
			
			Если НайденныеСтроки.Количество() > 0 Тогда
				
				Если ЗначениеЗаполнено(НайденныеСтроки[0].ТекущаяНоменклатура) Тогда
					Продолжить;
				КонецЕсли;
				
				НайденныеСтроки[0].Номенклатура = Выборка.Номенклатура;
				
				//+ ИнфоСофт Стояк Ю.К. 20.06.2024 УА #78102				
				НайденныеСтроки[0].Характеристика = Выборка.Характеристика;
