//+ ИнфоСофт Мурсалимов Д.Р. 24.01.24 УА #68819
&НаКлиенте
Процедура ПриСменеСтраницыЗавершение(Результат, Параметры) Экспорт
	
	Если Результат = Неопределено Тогда
    	Элементы.ГруппаСтраницы.ТекущаяСтраница = Элементы["Страница" + ПоследнийМаркетплейс];
    	Возврат;
    КонецЕсли;
	
	Если Результат.Значение = КодВозвратаДиалога.Да Тогда 
	    	    
	    Для Каждого Строка Из ЭтотОбъект["Товары" + ПоследнийМаркетплейс] Цикл 
	    	Строка.Модифицированность = Ложь;
	    КонецЦикла;
	    
		Модифицированность = Ложь;
		ЗаполнитьТаблицуСопоставления();
		ПоследнийМаркетплейс = Маркетплейс;
	
	Иначе
		Элементы.ГруппаСтраницы.ТекущаяСтраница = Элементы["Страница" + ПоследнийМаркетплейс];
	КонецЕсли;   
	
КонецПроцедуры //- ИнфоСофт Мурсалимов Д.Р. 24.01.24 УА #68819

