		КонецЕсли;
			
	Иначе
		Элементы.ГруппПодборРеквизит.Видимость = Ложь;
	КонецЕсли;
	
	Если ПодбиратьПо = "ПроизвольныйЗапрос" Тогда
		Элементы.УстановитьТекстЗапроса.Видимость = Истина;
	Иначе
		Элементы.УстановитьТекстЗапроса.Видимость = Ложь;
	КонецЕсли;
	
КонецПроцедуры //- ИнфоСофт Мурсалимов Д.Р. 17.01.24 УА #68819

