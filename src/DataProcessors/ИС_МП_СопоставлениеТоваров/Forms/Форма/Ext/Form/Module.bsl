//+ ИнфоСофт Мурсалимов Д.Р. 08.12.23 УА #67006
&НаКлиенте
Процедура ГруппаТаблицаСопоставленияПриСменеСтраницы(Элемент, ТекущаяСтраница)	
		
	Маркетплейс = СтрЗаменить(ТекущаяСтраница.Имя, "Страница", "");
	
	Если Модифицированность Тогда
	
		Оповещение = Новый ОписаниеОповещения("ПриСменеСтраницыЗавершение", ЭтотОбъект, Параметры);
		СтандартныеПодсистемыКлиент.ПоказатьВопросПользователю(Оповещение, 
			НСтр("ru = 'Имеются несохраненные данные, все изменения будут утеряны. Хотите продолжить?'"), 
			РежимДиалогаВопрос.ДаНет);
	
	Иначе
		ЗаполнитьТаблицуСопоставления();
	КонецЕсли;
	
КонецПроцедуры //- ИнфоСофт Мурсалимов Д.Р. 08.12.23 УА #67006  

//+ ИнфоСофт Ивонин К.А. 28.10.24 УА #68001
&НаКлиенте
Процедура РеквизитСопоставленияПриИзменении(Элемент)
	
	ТекДанные = Элементы["Товары" + Маркетплейс].ТекущиеДанные;
    
    Если ТекДанные = Неопределено Тогда
    	Возврат;
    КонецЕсли;
	
	Если ТекДанные.Номенклатура <> ТекДанные.ТекущаяНоменклатура 
			Или ТекДанные.Характеристика <> ТекДанные.ТекущаяХарактеристика
			Или ТекДанные.Упаковка <> ТекДанные.ТекущаяУпаковка Тогда
	
	    ТекДанные.Модифицированность = Истина;
	    Модифицированность = Истина;
		
	КонецЕсли;
    
КонецПроцедуры //- ИнфоСофт Ивонин К.А. 28.10.24 УА #68001

