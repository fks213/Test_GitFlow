//+ ИнфоСофт Мурсалимов Д.Р. 08.12.23 УА #67006
&НаСервере   
Процедура ЗаписатьИзмененияНаСервере()
		
	Для Каждого Элемент Из ЭтотОбъект["Товары" + Маркетплейс] Цикл
		
		Если Элемент.Модифицированность И ЗначениеЗаполнено(Элемент.Номенклатура) Тогда 
			
			//+ ИнфоСофт Мурсалимов Д.Р. 17.01.24 УА #62628
			Если Не ЗначениеЗаполнено(Элемент.Упаковка) Тогда			
				Элемент.Упаковка = Элемент.Номенклатура.ЕдиницаИзмерения;		
			КонецЕсли;
			
			Если Маркетплейс = "ВБ" Тогда
			
				ИС_WB_Сервер.ДобавитьСоответствиеРазмеров(Профиль, Элемент.РазмерWB, Элемент.Номенклатура, 
					Элемент.Характеристика, Элемент.Упаковка, Элемент.ТекущаяНоменклатура, Элемент.ТекущаяХарактеристика); 
				
			ИначеЕсли Маркетплейс = "Озон" Тогда
				
				ИС_Ozon_Сервер.ДобавитьСоответствиеНоменклатуры(Профиль, Элемент.НоменклатураOzon, Элемент.Номенклатура, 
					Элемент.Характеристика, Элемент.Упаковка, Элемент.ТекущаяНоменклатура, Элемент.ТекущаяХарактеристика);  
				
			ИначеЕсли Маркетплейс = "ЯМ" Тогда	
				
				ИС_ЯМ_Сервер.ДобавитьСоответствиеНоменклатуры(Профиль, Элемент.НоменклатураЯМ, Элемент.Номенклатура, 
					Элемент.Характеристика, Элемент.Упаковка, Элемент.ТекущаяНоменклатура, Элемент.ТекущаяХарактеристика);	
				
			ИначеЕсли Маркетплейс = "Сбер" Тогда 
				
				ИС_Сбер_Сервер.ДобавитьСоответствиеНоменклатуры(Профиль, Элемент.OfferID, Элемент.Номенклатура, 
					Элемент.Характеристика, Элемент.Упаковка, Элемент.ТекущаяНоменклатура, Элемент.ТекущаяХарактеристика);
				
			ИначеЕсли Маркетплейс = "Али" Тогда	
				
				ИС_АЛИ_Сервер.ДобавитьСоответствиеНоменклатуры(Профиль, Элемент.ВариацияАЛИ, Элемент.Номенклатура, 
					Элемент.Характеристика, Элемент.Упаковка, Элемент.ТекущаяНоменклатура, Элемент.ТекущаяХарактеристика);
					
			ИначеЕсли Маркетплейс = "МВМ" Тогда	
				
				ИС_МВМ_Сервер.ДобавитьСоответствиеТовара(Профиль, Элемент.ТоварМВМ, Элемент.Номенклатура, 
					Элемент.Характеристика, Элемент.Упаковка, Элемент.ТекущаяНоменклатура, Элемент.ТекущаяХарактеристика);
					
			//+ ИнфоСофт Власова И.С. 23.12.24 УА #90120
			ИначеЕсли Маркетплейс = "Ламода" Тогда	
				
				ИС_Ламода_Сервер.ДобавитьСоответствиеТовара(Профиль, Элемент.РазмерЛамода, Элемент.Номенклатура, 
					Элемент.Характеристика, Элемент.Упаковка, Элемент.ТекущаяНоменклатура, Элемент.ТекущаяХарактеристика);
			//- ИнфоСофт Власова И.С. 23.12.24 УА #90120		
					
			КонецЕсли;
			//- ИнфоСофт Мурсалимов Д.Р. 17.01.24 УА #62628
			
		КонецЕсли; 
		
	КонецЦикла;		

	Модифицированность = Ложь;

	ЗаполнитьТаблицуСопоставления();

КонецПроцедуры //- ИнфоСофт Мурсалимов Д.Р. 08.12.23 УА #67006

//+ ИнфоСофт Мурсалимов Д.Р. 08.12.23 УА #67006
&НаСервере
Процедура УдалитьСопоставлениеНаСервере()
	
	ВыделенныеСтроки = Элементы["Товары" + Маркетплейс].ВыделенныеСтроки;
	
	Для Каждого Идентификатор Из ВыделенныеСтроки Цикл
		
		СтрокаТаблицы = ЭтотОбъект["Товары" + Маркетплейс].НайтиПоИдентификатору(Идентификатор);
		
		Если Не ЗначениеЗаполнено(СтрокаТаблицы.ТекущаяНоменклатура) Тогда
			Продолжить;                                                          
		КонецЕсли;
		
		Если Маркетплейс = "ВБ" Тогда
			
			НаборЗаписей = РегистрыСведений.ИС_WB_СоответствиеРазмеров.СоздатьНаборЗаписей();
			НаборЗаписей.Отбор.Профиль.Установить(Профиль);
			НаборЗаписей.Отбор.РазмерWB.Установить(СтрокаТаблицы.РазмерWB);
			НаборЗаписей.Отбор.Номенклатура.Установить(СтрокаТаблицы.ТекущаяНоменклатура);
			НаборЗаписей.Отбор.Характеристика.Установить(СтрокаТаблицы.ТекущаяХарактеристика);
			
		ИначеЕсли Маркетплейс = "Озон" Тогда 
			
			НаборЗаписей = РегистрыСведений.ИС_Ozon_СоответствиеХарактеристик.СоздатьНаборЗаписей();
			НаборЗаписей.Отбор.НоменклатураOzon.Установить(СтрокаТаблицы.НоменклатураOzon); 
			
		ИначеЕсли Маркетплейс = "ЯМ" Тогда   
			
			НаборЗаписей = РегистрыСведений.ИС_ЯМ_СоответствиеХарактеристик.СоздатьНаборЗаписей();
			НаборЗаписей.Отбор.НоменклатураЯМ.Установить(СтрокаТаблицы.НоменклатураЯМ);
			
		ИначеЕсли Маркетплейс = "Сбер" Тогда 
			
			НаборЗаписей = РегистрыСведений.ИС_Сбер_Товары.СоздатьНаборЗаписей();
			НаборЗаписей.Отбор.offerID.Установить(СтрокаТаблицы.offerID);
			
		ИначеЕсли Маркетплейс = "Али" Тогда  
			
			НаборЗаписей = РегистрыСведений.ИС_АЛИ_СоответствиеХарактеристик.СоздатьНаборЗаписей();
			НаборЗаписей.Отбор.ВариацияАли.Установить(СтрокаТаблицы.ВариацияАли);
			
		ИначеЕсли Маркетплейс = "МВМ" Тогда  
			
			НаборЗаписей = РегистрыСведений.ИС_МВМ_СоответствиеТоваров.СоздатьНаборЗаписей();
			НаборЗаписей.Отбор.ТоварМВМ.Установить(СтрокаТаблицы.ТоварМВМ);
			
		//+ ИнфоСофт Власова И.С. 23.12.24 УА #90120
		ИначеЕсли Маркетплейс = "Ламода" Тогда  
			
			НаборЗаписей = РегистрыСведений.ИС_Ламода_СоответствиеТоваров.СоздатьНаборЗаписей();
			НаборЗаписей.Отбор.РазмерЛамода.Установить(СтрокаТаблицы.РазмерЛамода);
		//- ИнфоСофт Власова И.С. 23.12.24 УА #90120	
			
		КонецЕсли;
		
		НаборЗаписей.Прочитать();
		
		Если НаборЗаписей.Количество() > 0 Тогда
			НаборЗаписей.Очистить();
		КонецЕсли;
		
		НаборЗаписей.Записывать = Истина;
		НаборЗаписей.Записать();
		
	КонецЦикла;
	
	ЗаполнитьТаблицуСопоставления();
	
КонецПроцедуры //- ИнфоСофт Мурсалимов Д.Р. 08.12.23 УА #67006

//+ ИнфоСофт Мурсалимов Д.Р. 08.12.23 УА #67006
&НаКлиенте
Процедура ПриЗакрытиииЗавершение(Результат, Параметры) Экспорт
	
	Если Результат.Значение = КодВозвратаДиалога.Да Тогда
