//+ ИнфоСофт Сумин Д.В. 22.02.23 УА #55507
&НаКлиенте
Процедура СоздатьНоменклатуру(Команда)  
	
	Структурапроверки = ПроверкаЗаполненияНаПустыеЗначения(); 
	
	Если Структурапроверки.ПустыеЗначения Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(Структурапроверки.Текст);
		Возврат;
	КонецЕсли;
	
	Если СоздаватьХарактеристики Тогда
		Счетчик = СоздатьНоменклатуруСХарактеристиками();	
	Иначе	
		Счетчик = СоздатьНоменклатуруБезХарактеристик();
	КонецЕсли; 
	
	ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Выполнение обработки завершено. Обработано " + Счетчик + " объектов");  
	
КонецПроцедуры //- ИнфоСофт Сумин Д.В. 22.02.23 УА #55507 

