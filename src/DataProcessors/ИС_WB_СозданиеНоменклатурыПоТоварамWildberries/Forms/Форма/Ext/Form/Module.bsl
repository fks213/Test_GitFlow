//+ ИнфоСофт Сумин Д.В. 22.02.23 УА #55507
&НаСервере
Процедура ЗаполнитьДанныеНаСервере()
	
	Объект.ДанныеДляСозданияНоменклатуры.Очистить();
	
	ДанныеДляСозданияТЗ = ПолучитьДанныеДляСозданияНаСервере(); 
	
	Если ДанныеДляСозданияТЗ.Количество() < 1 Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Данных для создания номенклатуры не найдено.");
		Возврат;
		
	КонецЕсли;
	
	Если СоздаватьХарактеристики Тогда
		ЗаполнитьТаблицуДанныхСХарактеристиками(ДанныеДляСозданияТЗ);	
	Иначе
		ЗаполнитьТаблицуДанныхБезХарактеристик(ДанныеДляСозданияТЗ);	
	КонецЕсли;	
	
КонецПроцедуры //- ИнфоСофт Сумин Д.В. 22.02.23 УА #55507 

//+ ИнфоСофт Сумин Д.В. 22.02.23 УА #55507
&НаСервере
Функция ПолучитьДанныеДляСозданияНаСервере()
	
	Запрос = Новый Запрос;
	
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ИС_WB_РазмерыНоменклатур.Владелец.Ссылка КАК НоменклатураВБ,
	|	ИС_WB_РазмерыНоменклатур.Ссылка КАК РазмерНоменклатуры
	|ПОМЕСТИТЬ ВТ_ОсновныеДанные
	|ИЗ
	|	Справочник.ИС_WB_РазмерыНоменклатур КАК ИС_WB_РазмерыНоменклатур
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ИС_WB_СоответствиеРазмеров КАК ИС_WB_СоответствиеРазмеров
	|		ПО (ИС_WB_РазмерыНоменклатур.Ссылка = ИС_WB_СоответствиеРазмеров.РазмерWB)
	|ГДЕ
	|	ИС_WB_СоответствиеРазмеров.РазмерWB ЕСТЬ NULL
	|	И ИС_WB_РазмерыНоменклатур.Профиль = &Профиль
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	МАКСИМУМ(ИС_WB_ШтрихкодыРазмеров.Штрихкод) КАК Штрихкод,
	|	ВТ_ОсновныеДанные.РазмерНоменклатуры КАК РазмерНоменклатуры
	|ПОМЕСТИТЬ ВТ_Штрихкод
	|ИЗ
	|	ВТ_ОсновныеДанные КАК ВТ_ОсновныеДанные
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ИС_WB_ШтрихкодыРазмеров КАК ИС_WB_ШтрихкодыРазмеров
	|		ПО ВТ_ОсновныеДанные.РазмерНоменклатуры = ИС_WB_ШтрихкодыРазмеров.Размер
	|
	|СГРУППИРОВАТЬ ПО
	|	ВТ_ОсновныеДанные.РазмерНоменклатуры
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_ОсновныеДанные.НоменклатураВБ КАК НоменклатураВБ,
	|	ВТ_ОсновныеДанные.РазмерНоменклатуры КАК РазмерНоменклатуры,
	|	ВТ_Штрихкод.Штрихкод КАК Штрихкод
	|ИЗ
	|	ВТ_ОсновныеДанные КАК ВТ_ОсновныеДанные
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_Штрихкод КАК ВТ_Штрихкод
	|		ПО ВТ_ОсновныеДанные.РазмерНоменклатуры = ВТ_Штрихкод.РазмерНоменклатуры";
	
	Запрос.УстановитьПараметр("Профиль", Профиль);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Возврат РезультатЗапроса.Выгрузить();
	
КонецФункции //- ИнфоСофт Сумин Д.В. 22.02.23 УА #55507

