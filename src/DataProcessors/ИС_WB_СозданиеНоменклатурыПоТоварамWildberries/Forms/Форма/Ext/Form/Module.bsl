&НаСервере
Функция СоздатьХарактеристикуУТНаСервере(Владелец, Наименование) 
	
	Характеристика = Справочники.ХарактеристикиНоменклатуры.СоздатьЭлемент(); 
	Характеристика.Владелец = Владелец.Ссылка;
	Характеристика.Наименование = Наименование;
	Характеристика.НаименованиеПолное = Наименование;
	Характеристика.ВидНоменклатуры = ВидНоменклатуры;
	Характеристика.Записать();
	
	Возврат Характеристика.Ссылка;
	
КонецФункции //- ИнфоСофт Сумин Д.В. 22.02.23 УА #55507 

