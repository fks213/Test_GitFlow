//+ ИнфоСофт Сумин Д.В. 22.02.23 УА #55507
&НаСервере
Процедура СоздатьЗаписьВРегистрШтрихкодов(Номенклатура, Элемент, Характеристика = Неопределено) 
	
	Попытка
		МенеджерЗаписи = РегистрыСведений.ШтрихкодыНоменклатуры.СоздатьМенеджерЗаписи();
		МенеджерЗаписи.Номенклатура = Номенклатура; 
		МенеджерЗаписи.Характеристика = Характеристика;
		МенеджерЗаписи.Упаковка = Номенклатура.ЕдиницаИзмерения;
		МенеджерЗаписи.Штрихкод = Элемент.Штрихкод;
			
		МенеджерЗаписи.Записать(); 
		
	Исключение 
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));	
	КонецПопытки;
	
КонецПроцедуры //- ИнфоСофт Сумин Д.В. 22.02.23 УА #55507

//+ ИнфоСофт Ивонин К.А. 02.08.24 УА #80685
&НаСервере   
Процедура ЗаполнитьСписокВыбораФормированияНаименования()
	
	Элементы.НоменклатураНаименованиеПоля.СписокВыбора.Добавить("Наименование");
	Элементы.НоменклатураНаименованиеПоля.СписокВыбора.Добавить("Бренд");
	Элементы.НоменклатураНаименованиеПоля.СписокВыбора.Добавить("Категория");
	Элементы.НоменклатураНаименованиеПоля.СписокВыбора.Добавить("Артикул поставщика");
	Элементы.НоменклатураНаименованиеПоля.СписокВыбора.Добавить("Код");
	Элементы.НоменклатураНаименованиеПоля.СписокВыбора.Добавить("Размер");
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ИС_WB_ХарактеристикиКатегорий.Наименование КАК Наименование
	|ИЗ
	|	Справочник.ИС_WB_ХарактеристикиКатегорий КАК ИС_WB_ХарактеристикиКатегорий";
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаХарактеристик = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаХарактеристик.Следующий() Цикл
		Элементы.НоменклатураНаименованиеПоля.СписокВыбора.Добавить(ВыборкаХарактеристик.Наименование);
	КонецЦикла;
	
	НоваяСтрока = Объект.Номенклатура.Добавить();
	НоваяСтрока.НаименованиеПоля = "Наименование";
	
КонецПроцедуры //- ИнфоСофт Ивонин К.А. 02.08.24 УА #80685

#КонецОбласти
