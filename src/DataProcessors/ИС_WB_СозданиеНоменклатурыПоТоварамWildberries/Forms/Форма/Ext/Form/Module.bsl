//+ ИнфоСофт Сумин Д.В. 22.02.23 УА #55507
&НаСервере
Функция ПроверкаЗаполненияНаПустыеЗначения()
	
	СтруктураПроверки = Новый Структура;
	СтруктураПроверки.Вставить("ПустыеЗначения", Ложь);
	
	Если Не ЗначениеЗаполнено(ЕдиницаИзмерения) Или Не ЗначениеЗаполнено(ВидНоменклатуры) Или Не ЗначениеЗаполнено(ОсобенностьУчета) Или Не ЗначениеЗаполнено(ТипНоменклатуры)
		Или Не ЗначениеЗаполнено(НоменклатурнаяГруппа) Тогда 
		Текст = "Необходимо заполнить настройки создания номенклатуры.";
		СтруктураПроверки.Вставить("Текст", Текст);
		СтруктураПроверки.Вставить("ПустыеЗначения", Истина);
		Возврат СтруктураПроверки;
	КонецЕсли;	
		
	
	Для Каждого Элемент Из Объект.ДанныеДляСозданияНоменклатуры Цикл
		
		Если Не ЗначениеЗаполнено(Элемент.НаименованиеНоменклатуры) Тогда
			Текст = "В строке номер: " + Элемент.НомерСтроки + " не заполнено ""Наименование номенклатуры"". Удалите строку или заполните данные.";
			СтруктураПроверки.Вставить("Текст", Текст);
			СтруктураПроверки.Вставить("ПустыеЗначения", Истина);
			Возврат СтруктураПроверки;	
		КонецЕсли; 
		
		Если СоздаватьХарактеристики Тогда 
			
			Если Не ЗначениеЗаполнено(Элемент.НаименованиеХарактеристики) Тогда
				Текст = "В строке номер: " + Элемент.НомерСтроки + " не заполнено ""Наименование характеристики"". Удалите строку или заполните данные.";
				СтруктураПроверки.Вставить("Текст", Текст);
				СтруктураПроверки.Вставить("ПустыеЗначения", Истина);
				Возврат СтруктураПроверки;	
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЦикла; 
	
	Возврат СтруктураПроверки; 
	
КонецФункции //- ИнфоСофт Сумин Д.В. 22.02.23 УА #55507 

