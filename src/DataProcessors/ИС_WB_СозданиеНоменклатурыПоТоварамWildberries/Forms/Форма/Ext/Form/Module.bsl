&НаСервере
Процедура ЗаполнитьТаблицуДанныхБезХарактеристик(ДанныеДляСозданияТЗ) 
	
	Для Каждого Элемент Из ДанныеДляСозданияТЗ Цикл	
		Наименование = ПолучитьНаименованиеИзНоменклатуры(Элемент.НоменклатураВБ, Элемент.РазмерНоменклатуры); 		
		ЗаполнитьТЧДанных(Элемент, Наименование);	
	КонецЦикла;	
	
КонецПроцедуры //- ИнфоСофт Ивонин К.А. 02.08.24 УА #80685 

//+ ИнфоСофт Сумин Д.В. 22.02.23 УА #55507
&НаСервере
Процедура ЗаполнитьТаблицуДанныхСХарактеристиками(ДанныеДляСозданияТЗ)
	
	Для Каждого Элемент Из ДанныеДляСозданияТЗ Цикл
		
		НаименованиеНоменклатуры = ПолучитьНаименованиеИзНоменклатуры(Элемент.НоменклатураВБ, Элемент.РазмерНоменклатуры);
		
		Если ИспользоватьВНаименованииРоссийскийРазмер Тогда
			НаименованиеХарактеристики = Элемент.РазмерНоменклатуры.wbSize;	
		Иначе
			НаименованиеХарактеристики = Элемент.РазмерНоменклатуры.techSize;	
		КонецЕсли;
		
		Если Не ЗначениеЗаполнено(НаименованиеХарактеристики) Или СокрЛП(НаименованиеХарактеристики) = "0" Тогда
			НаименованиеХарактеристики = Элемент.РазмерНоменклатуры.наименование;	
		КонецЕсли;	
		
		ЗаполнитьТЧДанных(Элемент, НаименованиеНоменклатуры, НаименованиеХарактеристики)
		
	КонецЦикла;
	
КонецПроцедуры //- ИнфоСофт Сумин Д.В. 22.02.23 УА #55507

//+ ИнфоСофт Ивонин К.А. 02.08.24 УА #80685
&НаСервере
Функция ПолучитьНаименованиеИзНоменклатуры(Номенклатура, Размер)
	
	Наименование = ""; 
	
	Характеристки = Номенклатура.Характеристики;
	
	Для Каждого Элемент Из Объект.Номенклатура Цикл
		
		Если Элемент.НаименованиеПоля = "Наименование" Тогда
			Наименование = Наименование + " " + Номенклатура.Наименование;	
		ИначеЕсли Элемент.НаименованиеПоля = "Бренд" Тогда
			Наименование = Наименование + " " + Номенклатура.Бренд;	
		ИначеЕсли Элемент.НаименованиеПоля = "Категория" Тогда
			Наименование = Наименование + " " + Номенклатура.object;	
		ИначеЕсли Элемент.НаименованиеПоля = "Артикул поставщика" Тогда
			Наименование = Наименование + " " + Номенклатура.vendorCode;	
		ИначеЕсли Элемент.НаименованиеПоля = "Код" Тогда	
			Наименование = Наименование + " " + СтрЗаменить(Номенклатура.Код, Символы.НПП, "");
		ИначеЕсли Элемент.НаименованиеПоля = "Размер" Тогда
			
			Если ИспользоватьВНаименованииРоссийскийРазмер Тогда
				НаименованиеРазмера = Размер.wbSize;	
			Иначе
				НаименованиеРазмера = Размер.techSize;	
			КонецЕсли;
			
			Если Не ЗначениеЗаполнено(НаименованиеРазмера) Или СокрЛП(НаименованиеРазмера) = "0" Тогда
				НаименованиеРазмера = Размер.Наименование;	
			КонецЕсли;
			
			Наименование = Наименование + " " + НаименованиеРазмера;
				
		Иначе
			
			Для Каждого Строка Из Характеристки Цикл
				
				Если Строка(Строка.Поле) = Элемент.НаименованиеПоля Тогда
					Наименование = Наименование + " " + Строка.Значение;		
				КонецЕсли;	
				
			КонецЦикла;	
			
		КонецЕсли;	
		
	КонецЦикла;	
	
	Возврат Наименование;
	
КонецФункции //- ИнфоСофт Ивонин К.А. 02.08.24 УА #80685

//+ ИнфоСофт Сумин Д.В. 22.02.23 УА #55507
&НаСервере
Процедура ЗаполнитьТЧДанных(Элемент, НаименованиеНоменклатуры, НаименованиеХарактеристики = Неопределено) 
	
	ЭлементТЧ = Объект.ДанныеДляСозданияНоменклатуры.Добавить();
	ЭлементТЧ.НоменклатураWB = Элемент.НоменклатураВБ;
	ЭлементТЧ.РазмерНоменклатуры = Элемент.РазмерНоменклатуры;
	ЭлементТЧ.НаименованиеНоменклатуры = НаименованиеНоменклатуры;
	ЭлементТЧ.НаименованиеХарактеристики = НаименованиеХарактеристики; 
	ЭлементТЧ.Категория = Элемент.НоменклатураВБ.object;
	ЭлементТЧ.Штрихкод = Элемент.Штрихкод;
	
КонецПроцедуры //- ИнфоСофт Сумин Д.В. 22.02.23 УА #55507

#КонецОбласти

#Область СозданияНоменклатуры  

//+ ИнфоСофт Сумин Д.В. 22.02.23 УА #55507
&НаСервере
Функция СоздатьНоменклатуруБезХарактеристик()   
		
	Счетчик = 0;
	
	Для Каждого Элемент Из Объект.ДанныеДляСозданияНоменклатуры Цикл 
		
		Попытка
			Номенклатура = СоздатьНоменклатуруНаСервере(Элемент);
		Исключение
			Текст = СтрШаблон("Номенклатура не создана %1 %2", Элемент.НаименованиеНоменклатуры, 
				ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(Текст);
			Продолжить;
		КонецПопытки;
		
		Если СоздаватьШтрихкодыНоменклатуры Тогда
			СоздатьЗаписьВРегистрШтрихкодов(Номенклатура, Элемент); 	
		КонецЕсли;
		
		СоздатьЗаписьВРегистрСоответсвийРазмеров(Номенклатура, Элемент.РазмерНоменклатуры);
			
		Счетчик = Счетчик + 1;
		
	КонецЦикла;	 
	
	Объект.ДанныеДляСозданияНоменклатуры.Очистить();
	
	Возврат Счетчик;
	
КонецФункции //- ИнфоСофт Сумин Д.В. 22.02.23 УА #55507

//+ ИнфоСофт Сумин Д.В. 22.02.23 УА #55507
&НаСервере
Функция СоздатьНоменклатуруСХарактеристиками()   
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Данные.НоменклатураWB КАК НоменклатураWB,
	|	Данные.РазмерНоменклатуры КАК РазмерНоменклатуры,
	|	Данные.НаименованиеНоменклатуры КАК НаименованиеНоменклатуры,
	|	Данные.НаименованиеХарактеристики КАК НаименованиеХарактеристики,
	|	Данные.Штрихкод КАК Штрихкод
	|ПОМЕСТИТЬ ВТ_Данные
	|ИЗ
	|	&Данные КАК Данные
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_Данные.НоменклатураWB КАК НоменклатураWB,
	|	ВТ_Данные.РазмерНоменклатуры КАК РазмерНоменклатуры,
	|	ВТ_Данные.НаименованиеНоменклатуры КАК НаименованиеНоменклатуры,
	|	ВТ_Данные.НаименованиеХарактеристики КАК НаименованиеХарактеристики,
	|	ВТ_Данные.Штрихкод КАК Штрихкод
	|ИЗ
	|	ВТ_Данные КАК ВТ_Данные
	|ИТОГИ ПО
	|	НоменклатураWB,
	|	НаименованиеНоменклатуры";
	
	Запрос.УстановитьПараметр("Данные", Объект.ДанныеДляСозданияНоменклатуры.Выгрузить());
	
	РезультатЗапроса = запрос.Выполнить();
	
	Выборка = РезультатЗапроса.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
		
	Счетчик = 0; 
		
	Пока Выборка.Следующий() Цикл
		
		ВыборкаНаименование = Выборка.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
		
		Пока ВыборкаНаименование.Следующий() Цикл
			
			Попытка
				Номенклатура = СоздатьНоменклатуруНаСервере(ВыборкаНаименование);
			Исключение
				Текст = СтрШаблон("Номенклатура не создана %1 %2", ВыборкаНаименование, 
					ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю(Текст);	
				Продолжить;	
			КонецПопытки;	
			
			ВыборкаХарактеристика = ВыборкаНаименование.Выбрать();
			
			Пока ВыборкаХарактеристика.Следующий() Цикл
				
				Характеристика = СоздатьХарактеристикуУТНаСервере(Номенклатура, ВыборкаХарактеристика.НаименованиеХарактеристики); 
				
				Если СоздаватьШтрихкодыНоменклатуры Тогда
					СоздатьЗаписьВРегистрШтрихкодов(Номенклатура, ВыборкаХарактеристика, Характеристика); 	
				КонецЕсли;
				
				СоздатьЗаписьВРегистрСоответсвийРазмеров(Номенклатура, ВыборкаХарактеристика.РазмерНоменклатуры, Характеристика);
							
				Счетчик = Счетчик + 1;
				
			КонецЦикла;	
			
		КонецЦикла;	
		
	КонецЦикла; 
	
	Объект.ДанныеДляСозданияНоменклатуры.Очистить();
	
	Возврат Счетчик;
	
КонецФункции //- ИнфоСофт Сумин Д.В. 22.02.23 УА #55507

//+ ИнфоСофт Сумин Д.В. 22.02.23 УА #55507
&НаСервере
Функция СоздатьНоменклатуруНаСервере(Элемент)
	
	НоменклатураСсылка = Справочники.Номенклатура.НайтиПоНаименованию(Элемент.НаименованиеНоменклатуры, Истина);
	
	Если ЗначениеЗаполнено(НоменклатураСсылка) Тогда 
		Номенклатура = НоменклатураСсылка.ПолучитьОбъект();		
	Иначе	
		Номенклатура = Справочники.Номенклатура.СоздатьЭлемент();
	КонецЕсли;
	
	Номенклатура.Родитель 						= НоменклатурнаяГруппа;
	Номенклатура.Артикул 						= Элемент.НоменклатураWB.VendorCode;
	Номенклатура.ВидНоменклатуры 				= ВидНоменклатуры;
	Номенклатура.Наименование 					= Элемент.НаименованиеНоменклатуры;
	Номенклатура.ЕдиницаИзмерения 				= ЕдиницаИзмерения;
	Номенклатура.НаименованиеПолное 			= Элемент.НаименованиеНоменклатуры; 
	
	Номенклатура.СтавкаНДС 						= СтавкаНДС_Справочник;
	Номенклатура.ТипНоменклатуры 				= ТипНоменклатуры;
	Номенклатура.ОсобенностьУчета 				= ОсобенностьУчета;
	Номенклатура.Качество 						= Перечисления.ГрадацииКачества.Новый;
	Номенклатура.ГруппаДоступа 					= Справочники.ГруппыДоступаНоменклатуры.НайтиПоНаименованию("Прочее"); 
	Номенклатура.ВариантОформленияПродажи 		= Перечисления.ВариантыОформленияПродажи.РеализацияТоваровУслуг;
	
	Если СоздаватьХарактеристики Тогда	
		Номенклатура.ИспользованиеХарактеристик = Перечисления.ВариантыИспользованияХарактеристикНоменклатуры.ИндивидуальныеДляНоменклатуры;   		
	Иначе
		Номенклатура.ИспользованиеХарактеристик = Перечисления.ВариантыИспользованияХарактеристикНоменклатуры.НеИспользовать;  		
	КонецЕсли;	
	
	Номенклатура.Записать();
	
	Возврат Номенклатура.Ссылка;
	
КонецФункции //- ИнфоСофт Сумин Д.В. 22.02.23 УА #55507

