//+ ИнфоСофт Ивонин К.А. 20.10.21 УА #38646
&НаСервере
Процедура ЗаполнитьДеревоМетаданных() 

	КоллекцииОбъектовМетаданных = Новый Массив;
	КоллекцииОбъектовМетаданных.Добавить(Метаданные.Справочники);
	КоллекцииОбъектовМетаданных.Добавить(Метаданные.ПланыВидовХарактеристик);
	КоллекцииОбъектовМетаданных.Добавить(Метаданные.РегистрыСведений);
	
	ДеревоМетаданныхЗначение = РеквизитФормыВЗначение("ДеревоМетаданных");
	
	ПрефиксУдаляемыхОбъектов = "удалить";
	УдаляемыеОбъекты = Новый СписокЗначений;
	
	Для Каждого КоллекцияОбъектовМетаданных Из КоллекцииОбъектовМетаданных Цикл
		
		Если КоллекцияОбъектовМетаданных.Количество() = 0 Тогда
			Продолжить;
		КонецЕсли;
	
		СтрокаМетаданные = ДеревоМетаданныхЗначение.Строки.Добавить();
		
		ИмяМетаданных = КоллекцияОбъектовМетаданных[0].ПолноеИмя();
		КолвоСимволов = СтрНайти(ИмяМетаданных, ".");
		НазваниеМетаданных = Лев(ИмяМетаданных, КолвоСимволов - 1);
		
		СоответствиеНаименованийМетаданных = ПолучитьСоответствиеИменМетаданных();
		СинонимМетаданных = СоответствиеНаименованийМетаданных.Получить(НазваниеМетаданных);
		
		СтрокаМетаданные.Метаданные = НазваниеМетаданных;
		СтрокаМетаданные.ПолноеИмя = СинонимМетаданных;
		СтрокаМетаданные.Синоним = СинонимМетаданных;
		
		Для Каждого ОбъектМетаданных Из КоллекцияОбъектовМетаданных Цикл
			
			Если НазваниеМетаданных = "Справочник" Или НазваниеМетаданных = "ПланВидовХарактеристик" Тогда
				
				Если ОбъектМетаданных.Имя = "Номенклатура" Или ОбъектМетаданных.Имя = "ДополнительныеРеквизитыИСведения" Или ОбъектМетаданных.Имя = "ХарактеристикиНоменклатуры" Тогда										
			
					СтрОбъектМетаданных = СтрокаМетаданные.Строки.Добавить();
					СтрОбъектМетаданных.Метаданные = ОбъектМетаданных.Имя;
					СтрОбъектМетаданных.ПолноеИмя = ОбъектМетаданных.ПолноеИмя();
					СтрОбъектМетаданных.Синоним = ОбъектМетаданных.Синоним;
			
				// не у всех метаданных есть владельцы
				//ИначеЕсли ОбъектМетаданных.Владельцы.Количество() > 0 Тогда
				//
				//	Для Каждого Владелец Из ОбъектМетаданных.Владельцы Цикл
				//		
				//		Если Владелец.Имя = "Номенклатура" Тогда
				//			
				//			СтрОбъектМетаданных = СтрокаМетаданные.Строки.Добавить();
				//			СтрОбъектМетаданных.Метаданные = ОбъектМетаданных.Имя;
				//			СтрОбъектМетаданных.ПолноеИмя = ОбъектМетаданных.ПолноеИмя();
				//			СтрОбъектМетаданных.Синоним = ОбъектМетаданных.Синоним;
				//			Прервать;
				//			
				//		КонецЕсли;
				//	
				//	КонецЦикла; 
								
				Иначе
					Продолжить;
				КонецЕсли;	
			//+ ИнфоСофт Стояк Ю.К. 13.03.2025 УА #95826			
			ИначеЕсли ОбъектМетаданных.Имя = "ДополнительныеСведения" Тогда
				
				СтрОбъектМетаданных = СтрокаМетаданные.Строки.Добавить();
				СтрОбъектМетаданных.Метаданные = ОбъектМетаданных.Имя;
				СтрОбъектМетаданных.ПолноеИмя = ОбъектМетаданных.ПолноеИмя();
				СтрОбъектМетаданных.Синоним = ОбъектМетаданных.Синоним;
				//- ИнфоСофт Стояк Ю.К. 13.03.2025 УА #95826
				
			Иначе				
			
				Если СтрНачинаетсяС(НРег(ОбъектМетаданных.Имя), ПрефиксУдаляемыхОбъектов) Тогда
					Продолжить;
				КонецЕсли;
				
				МассивТипов = Новый Массив;
				МассивТипов.Добавить(Тип("СправочникСсылка.Номенклатура"));
				
				Для Каждого Измерение Из ОбъектМетаданных.Измерения Цикл					
				
					Если Измерение.Тип = Новый ОписаниеТипов(МассивТипов) Тогда
				
						СтрОбъектМетаданных = СтрокаМетаданные.Строки.Добавить();
						СтрОбъектМетаданных.Метаданные = ОбъектМетаданных.Имя;
						СтрОбъектМетаданных.ПолноеИмя = ОбъектМетаданных.ПолноеИмя();
						СтрОбъектМетаданных.Синоним = ОбъектМетаданных.Синоним;
						Прервать;
				
					КонецЕсли;
				
				КонецЦикла;
				
				Для Каждого Ресурс Из ОбъектМетаданных.Ресурсы Цикл
					
					Если Ресурс.Тип = Новый ОписаниеТипов(МассивТипов) Тогда
						
						Если Не (СтрокаМетаданные.Строки.Найти(ОбъектМетаданных.Имя, "Метаданные") = Неопределено) Тогда
							Продолжить;
						КонецЕсли;
						
						СтрОбъектМетаданных = СтрокаМетаданные.Строки.Добавить();
						СтрОбъектМетаданных.Метаданные = ОбъектМетаданных.Имя;
						СтрОбъектМетаданных.ПолноеИмя = ОбъектМетаданных.ПолноеИмя();
						СтрОбъектМетаданных.Синоним = ОбъектМетаданных.Синоним;
						Прервать;
					
					КонецЕсли;
				
				КонецЦикла;
				
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЦикла;
	
	ЗначениеВРеквизитФормы(ДеревоМетаданныхЗначение, "ДеревоМетаданных");
	
КонецПроцедуры //- ИнфоСофт Ивонин К.А. 20.10.21 УА #38646

//+ ИнфоСофт Ивонин К.А. 20.10.21 УА #38646
&НаСервереБезКонтекста
Функция ПолучитьСоответствиеИменМетаданных()

	СоответствиеНаименованийМетаданных = Новый Соответствие;
	СоответствиеНаименованийМетаданных.Вставить("Справочник", "Справочник");
	СоответствиеНаименованийМетаданных.Вставить("ПланВидовХарактеристик", "План видов характеристик");
	СоответствиеНаименованийМетаданных.Вставить("РегистрСведений", "Регистр сведений");
	
	Возврат СоответствиеНаименованийМетаданных;
	
КонецФункции //- ИнфоСофт Ивонин К.А. 20.10.21 УА #38646

//+ ИнфоСофт Ивонин К.А. 20.10.21 УА #38646
&НаСервере
Процедура УстановитьПараметрыПоейКатегорийНаСервере()
	ПоляКатегорий.Параметры.УстановитьЗначениеПараметра("Ссылка", Категория);	
КонецПроцедуры //- ИнфоСофт Ивонин К.А. 20.10.21 УА #38646

//+ ИнфоСофт Ивонин К.А. 20.10.21 УА #38646
&НаСервере
Функция СформироватьДанныеВыбора()
	                
	ЗначенияВыбора = Новый СписокЗначений;
	ОбъектМетаданных = Метаданные.НайтиПоПолномуИмени(Раздел1С);
	
	//+ ИнфоСофт Стояк Ю.К. 13.03.2025 УА #95826	
	Если СтрНайти(Раздел1С, "ДополнительныеСведения") <> 0 Тогда
		ЗаполнитьДопСвойства(ЗначенияВыбора);
	//Если СтрНайти(Раздел1С, "Справочник") <> 0 Тогда
	ИначеЕсли СтрНайти(Раздел1С, "Справочник") <> 0 Тогда
	//- ИнфоСофт Стояк Ю.К. 13.03.2025 УА #95826
		          
		Для Каждого Реквизит Из ОбъектМетаданных.Реквизиты Цикл
			ЗначенияВыбора.Добавить(Реквизит.Имя, Реквизит.Синоним);	
		КонецЦикла;
		
		ЗначенияВыбора.Добавить("Наименование", "Наименование");
		ЗначенияВыбора.Добавить("Код", "Код");
	
	ИначеЕсли СтрНайти(Раздел1С, "ПланВидовХарактеристик") <> 0 Тогда
		ЗаполнитьСвойствамиНоменклатуры(ЗначенияВыбора);
		ЗаполнитьСвойствамиХарактеристики(ЗначенияВыбора);
	Иначе
		
		Для Каждого Измерение Из ОбъектМетаданных.Измерения Цикл
			ЗначенияВыбора.Добавить(Измерение.Имя, Измерение.Синоним);	
		КонецЦикла;	
		
		Для Каждого Ресурс Из ОбъектМетаданных.Ресурсы Цикл
			ЗначенияВыбора.Добавить(Ресурс.Имя, Ресурс.Синоним);	
		КонецЦикла;	

	КонецЕсли;
	
	ЗначенияВыбора.СортироватьПоПредставлению(НаправлениеСортировки.Возр);
	
	Возврат ЗначенияВыбора;
	
КонецФункции //- ИнфоСофт Ивонин К.А. 20.10.21 УА #38646

//+ ИнфоСофт Ивонин К.А. 20.10.21 УА #38646
&НаСервере
Процедура ЗаполнитьСвойствамиНоменклатуры(ЗначенияВыбора)
		
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	НоменклатураДополнительныеРеквизиты.Свойство.Имя КАК Свойство,
	|	НоменклатураДополнительныеРеквизиты.Свойство.Заголовок КАК Заголовок
	|ИЗ
	|	Справочник.Номенклатура.ДополнительныеРеквизиты КАК НоменклатураДополнительныеРеквизиты";
	
	РезультатЗапроса = Запрос.Выполнить();
	Выборка = РезультатЗапроса.Выбрать();
	
	Пока Выборка.Следующий() Цикл
		ЗначенияВыбора.Добавить(Выборка.Свойство, Выборка.Заголовок);
	КонецЦикла;
	
КонецПроцедуры

