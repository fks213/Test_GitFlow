//+ ИнфоСофт Ивонин К.А. 20.10.21 УА #38646
&НаСервере
Процедура ДобавитьНаСервере()
	
	МенеджерЗаписи = РегистрыСведений.ИС_WB_НастройкиСопоставленияХарактеристикТоваров.СоздатьМенеджерЗаписи(); 
	МенеджерЗаписи.Категория = Категория; 
	МенеджерЗаписи.Характеристика = Характеристика; 
	МенеджерЗаписи.Раздел1С = Раздел1С;
	МенеджерЗаписи.Поле1С = Поле1С; 
	МенеджерЗаписи.Записать(); 	

КонецПроцедуры //- ИнфоСофт Ивонин К.А. 20.10.21 УА #38646

//+ ИнфоСофт Стояк Ю.К. 13.03.2025 УА #95826
&НаСервере
Процедура ЗаполнитьДопСвойства(ЗначенияВыбора)
		
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
	|	ДополнительныеСведения.Свойство.Наименование КАК Заголовок,
	|	ДополнительныеСведения.Свойство.Имя КАК Свойство
	|ИЗ
	|	РегистрСведений.ДополнительныеСведения КАК ДополнительныеСведения
	|ГДЕ
	|	ТИПЗНАЧЕНИЯ(ДополнительныеСведения.Объект) = ТИП(Справочник.Номенклатура)";
	
	РезультатЗапроса = Запрос.Выполнить();
	Выборка = РезультатЗапроса.Выбрать();
	
	Пока Выборка.Следующий() Цикл
		ЗначенияВыбора.Добавить(Выборка.Свойство, Выборка.Заголовок);
	КонецЦикла;
	
КонецПроцедуры //- ИнфоСофт Стояк Ю.К. 13.03.2025 УА #95826

#КонецОбласти
