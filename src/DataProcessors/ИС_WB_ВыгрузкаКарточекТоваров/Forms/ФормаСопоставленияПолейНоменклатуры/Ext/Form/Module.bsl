//+ ИнфоСофт Ивонин К.А. 20.10.21 УА #38646
&НаКлиенте
Процедура ДеревоМетаданныхВыборЗначения(Элемент, Значение, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;

	Если СтрНайти(Элемент.ТекущиеДанные.ПолноеИмя, ".") = 0 Тогда
		Возврат;
	КонецЕсли;
	
	СтрДерева = ДеревоМетаданных.НайтиПоИдентификатору(Значение);
	
	Раздел1С = СтрДерева.ПолноеИмя;
		
	ДанныеВыбора = Новый СписокЗначений;
	ДанныеВыбора = СформироватьДанныеВыбора();
	                                                            
	Поля1С.Очистить();
	
	Для Каждого Элемент Из ДанныеВыбора Цикл
		НоваяСтрока = Поля1С.Добавить();
		НоваяСтрока.Значение = Элемент.Значение;
	КонецЦикла;
	
КонецПроцедуры //- ИнфоСофт Ивонин К.А. 20.10.21 УА #38646

//+ ИнфоСофт Ивонин К.А. 20.10.21 УА #38646
&НаКлиенте
Процедура ПоляКатегорийВыборЗначения(Элемент, Значение, СтандартнаяОбработка)
	
	ТекДанные = Элементы.ПоляКатегорий.ТекущиеДанные;
	
	Если ТекДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	СтандартнаяОбработка = Ложь;
	Характеристика = ТекДанные.Наименование;

КонецПроцедуры //- ИнфоСофт Ивонин К.А. 20.10.21 УА #38646

//+ ИнфоСофт Ивонин К.А. 20.10.21 УА #38646
