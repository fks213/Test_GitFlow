//+ ИнфоСофт Ивонин К.А. 20.10.21 УА #38646
&НаКлиенте
Процедура РежимОтладки(Команда)
	
	РежимОтладки = Не РежимОтладки;
	
	Если РежимОтладки Тогда
		Элементы.ГруппаСтраницы.ОтображениеСтраниц = ОтображениеСтраницФормы.ЗакладкиСверху;
	Иначе

		Элементы.ГруппаСтраницы.ОтображениеСтраниц = ОтображениеСтраницФормы.Нет;

		Если Элементы.ГруппаСтраницы.ТекущаяСтраница = Элементы.ГруппаТестирование Тогда
			Элементы.ГруппаСтраницы.ТекущаяСтраница = Элементы.ГруппаВыгрузка;	
		КонецЕсли;

	КонецЕсли;
	
КонецПроцедуры //- ИнфоСофт Ивонин К.А. 20.10.21 УА #38646

