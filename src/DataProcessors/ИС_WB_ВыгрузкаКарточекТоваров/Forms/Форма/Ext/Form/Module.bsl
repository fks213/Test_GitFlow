КонецПроцедуры //- ИнфоСофт Ивонин К.А. 06.10.21 УА #38646

//+ ИнфоСофт Ивонин К.А. 30.08.24 УА #74933
&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	Элементы.ГруппаПосикКартинок.Видимость = Ложь;
	Элементы.ТаблицаИзображенийГруппаФайл.Видимость = Ложь;
	Элементы.ТаблицаИзображенийФайлКартинки.Видимость = Истина;
	
	Если РежимВыгрузкиФото = "Файл" Тогда
		Элементы.ГруппаПосикКартинок.Видимость = Истина;
		Элементы.ТаблицаИзображенийГруппаФайл.Видимость = Истина;
		Элементы.ТаблицаИзображенийФайлКартинки.Видимость = Ложь;
	КонецЕсли;
	
	//+ ИнфоСофт Власова И.С. 02.12.24 УА #62619
	Элементы.СопоставитьНоменклатуруАвтоматически.Видимость = СоздатьКарточкиПослеВыгрузки;
	//- ИнфоСофт Власова И.С. 02.12.24 УА #62619

КонецПроцедуры //- ИнфоСофт Ивонин К.А. 30.08.24 УА #74933

//+ ИнфоСофт Ивонин К.А. 07.10.21 УА #38646
&НаКлиенте
Процедура СписокКатегорийВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	ОчиститьСообщения();
	
	Если Не ЗначениеЗаполнено(Профиль) Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю("Не выбран Профиль", , , "Профиль");
	    Возврат;
	КонецЕсли;

	ТекДанные = Элементы.СписокКатегорий.ТекущиеДанные;
	
	Если ТекДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;	

	ПерейтиКФормированиюВыгрузки(ТекДанные.Категория);
	
КонецПроцедуры //- ИнфоСофт Ивонин К.А. 07.10.21 УА #38646

//+ ИнфоСофт Ивонин К.А. 11.10.21 УА #38646
&НаКлиенте
Процедура ТаблицаВыгрузкиПриАктивизацииЯчейки(Элемент)

	Имя = Элемент.ТекущийЭлемент.Имя;

	Если Лев(Имя, 1) = "П" Тогда
		НастроитьПараметрыПоля(Имя);	
	КонецЕсли;
	
КонецПроцедуры //- ИнфоСофт Ивонин К.А. 11.10.21 УА #38646

//+ ИнфоСофт Ивонин К.А. 11.10.21 УА #38646
&НаКлиенте
Процедура ТаблицаВыгрузкиАвтоПодбор(Элемент, Текст, ДанныеВыбора, ПараметрыПолученияДанных, Ожидание, СтандартнаяОбработка)

	Если АвтоПодбор Тогда
		СтандартнаяОбработка = Ложь;
		ДанныеВыбора = ПолучитьСписокПодбора(Профиль, Категория, Элемент.Имя, Текст);
