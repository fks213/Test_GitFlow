//+ ИнфоСофт Ивонин К.А. 26.11.21 УА #40333
&НаКлиенте
Процедура ЗаполнитьПоНайденным(Команда)
	
	Для Каждого Строка Из ТаблицаИзображений Цикл
		
		Если ЗначениеЗаполнено(Строка.Номенклатура) Тогда
			
			НайденныеСтроки = ТаблицаВыгрузки.НайтиСтроки(Новый Структура("Номенклатура", Строка.Номенклатура));
			
			Попытка
				УИД = Новый УникальныйИдентификатор(Строка.Результат);
			Исключение
			   	Продолжить;
			КонецПопытки;
			
			Если НайденныеСтроки.Количество() > 0 Тогда
				НайденныеСтроки[0].Фото.Добавить(Строка.Результат);	
			КонецЕсли;
					
		КонецЕсли;
			
	КонецЦикла;
	
КонецПроцедуры //- ИнфоСофт Ивонин К.А. 26.11.21 УА #40333

