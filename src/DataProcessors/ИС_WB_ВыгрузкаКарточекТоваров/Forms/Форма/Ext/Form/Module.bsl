//+ ИнфоСофт Ивонин К.А. 13.10.21 УА #38646
&НаСервере
Функция СформироватьМассивCharacteristics(Строка, СоответствиеПолей)
		
	Результат = Новый Массив;
	
	Для Каждого Элемент Из СоответствиеПолей Цикл
		
		Если Элемент.Значение.Наименование = "Размер" Тогда
        	Продолжить;
        КонецЕсли;
        
        Если Элемент.Значение.Наименование = "Рос. размер" Тогда
        	Продолжить;
        КонецЕсли;
        
        Если Элемент.Значение.Наименование = "Наименование" Тогда
        	Продолжить;
        КонецЕсли;
        
		Если Элемент.Значение.Наименование = "Описание" Тогда
        	Продолжить;
        КонецЕсли;
        
		Если Элемент.Значение.Наименование = "Бренд" Тогда
        	Продолжить;
        КонецЕсли;
        
		Если Элемент.Значение.Наименование = "Длина упаковки" Тогда
        	Продолжить;
        КонецЕсли;
        
		Если Элемент.Значение.Наименование = "Ширина упаковки" Тогда
        	Продолжить;
        КонецЕсли;
        
		Если Элемент.Значение.Наименование = "Высота упаковки" Тогда
        	Продолжить;
        КонецЕсли;

		
		Если Элемент.Значение.МаксимальноеКоличество = 0 Тогда
			
			Если ЗначениеЗаполнено(Строка[Элемент.Ключ]) Тогда
				
				СтруктураПоля = Новый Структура;
				
				СтруктураПоля.Вставить("id", Элемент.Значение.charcID);
				СтруктураПоля.Вставить("name", Элемент.Значение.Наименование);
				СтруктураПоля.Вставить("value", Строка[Элемент.Ключ]);
				
				Результат.Добавить(СтруктураПоля);
				
			КонецЕсли;
			
		ИначеЕсли Элемент.Значение.МаксимальноеКоличество = 1 Тогда
			
			Если ЗначениеЗаполнено(Строка[Элемент.Ключ]) Тогда
				
				СтруктураПоля = Новый Структура;
				МассивЗначения = Новый Массив;
				МассивЗначения.Добавить(Строка[Элемент.Ключ]);
				
				СтруктураПоля.Вставить("id", Элемент.Значение.charcID);
				СтруктураПоля.Вставить("name", Элемент.Значение.Наименование);
				СтруктураПоля.Вставить("value", МассивЗначения);
				
				Результат.Добавить(СтруктураПоля);
				
			КонецЕсли;
			
		Иначе
			
			Если Строка[Элемент.Ключ].Количество() > 0 Тогда
			
				СтруктураПоля = Новый Структура;
				МассивЗначения = Новый Массив;                        
				
				Для Каждого ЭлементСписка Из Строка[Элемент.Ключ] Цикл
					МассивЗначения.Добавить(ЭлементСписка.Значение);        
				КонецЦикла;
				
				СтруктураПоля.Вставить("id", Элемент.Значение.charcID);
				СтруктураПоля.Вставить("name", Элемент.Значение.Наименование);
				СтруктураПоля.Вставить("value", МассивЗначения);
				
				Результат.Добавить(СтруктураПоля);
								
			КонецЕсли;
			
		КонецЕсли;			
		
	КонецЦикла;
	
	Возврат Результат;

КонецФункции //- ИнфоСофт Ивонин К.А. 13.10.21 УА #38646

//+ ИнфоСофт Ивонин К.А. 20.10.21 УА #38646
&НаСервере
Функция ПолучитьСтруктуруПараметровВыбор(Имя, Значение)
	
	СоответствиеПолей = ХранилищеОбщихНастроек.Загрузить("ИС_НастройкиПолей");
	
	Поле = СоответствиеПолей[Имя];
	Если Поле = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;

	Результат = Новый Структура;                 	
	Результат.Вставить("Имя", Поле.Наименование);	
	Результат.Вставить("Справочник", Поле.Справочник);	
	Результат.Вставить("МаксимальноеКоличество", Поле.МаксимальноеКоличество);
	Результат.Вставить("ЭтоЧисло", Поле.ЕдиницаИзмерения);
	Результат.Вставить("Профиль", Профиль);
	Результат.Вставить("Категория", Категория); 
	Результат.Вставить("АвтоПодбор", АвтоПодбор);
	Результат.Вставить("Значение", Значение);
	
	Возврат Результат;

КонецФункции //- ИнфоСофт Ивонин К.А. 20.10.21 УА #38646

//+ ИнфоСофт Ивонин К.А. 20.10.21 УА #38646
&НаСервере
Функция ЗапросНаСервере()
        
	КодОтвета = "";
	
	Результат = ИС_WB_Сервер.ВыгрузитьКарточкиТоваров(Профиль, РезультатФормирования);

	Если Не Результат = Неопределено Тогда 	
		
		КодОтвета = Результат.КодОтвета;  
		РезультатВыгрузки = Результат.Ответ;
		
		Если Результат.КодОтвета = 200 Тогда   
			
			//+ ИнфоСофт Мурсалимов Д.Р. 25.03.24 УА #71529
			Если ЗаписыватьСгенерированныйШтрихкод Тогда
				
				Для Каждого Строка Из ТаблицаВыгрузки Цикл
					
					Если Строка.ШтрихкодСгенерирован Тогда
						
						СохранитьШтрихкодНоменклатуры(Строка.Номенклатура, Строка.Характеристика, Строка.barcode);
						
					КонецЕсли; 
					
				КонецЦикла;
				
			КонецЕсли;
			//- ИнфоСофт Мурсалимов Д.Р. 25.03.24 УА #71529
			
			ОбщегоНазначения.СообщитьПользователю("Выгрузка успешно завершена"); 
			Возврат Истина; 
			
		КонецЕсли;
		
		Возврат Ложь;
		
	КонецЕсли;               
	
	Возврат Ложь;
		
КонецФункции //- ИнфоСофт Ивонин К.А. 20.10.21 УА #38646

//+ ИнфоСофт Ивонин К.А. 25.10.21 УА #38646
&НаСервереБезконтекста
Функция ПолучитьТаблицуСопоставления(Категория)

	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ИС_WB_НастройкиСопоставленияХарактеристикТоваров.Категория КАК Категория,
	|	ИС_WB_НастройкиСопоставленияХарактеристикТоваров.Характеристика КАК Характеристика,
	|	ИС_WB_НастройкиСопоставленияХарактеристикТоваров.Раздел1С КАК Раздел1С,
	|	ИС_WB_НастройкиСопоставленияХарактеристикТоваров.Поле1С КАК Поле1С
	|ИЗ
	|	РегистрСведений.ИС_WB_НастройкиСопоставленияХарактеристикТоваров КАК ИС_WB_НастройкиСопоставленияХарактеристикТоваров
	|ГДЕ
	|	ИС_WB_НастройкиСопоставленияХарактеристикТоваров.Категория = &Категория
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ИС_WB_НастройкиСопоставленияХарактеристикТоваров.Категория,
	|	ИС_WB_НастройкиСопоставленияХарактеристикТоваров.Характеристика,
	|	ИС_WB_НастройкиСопоставленияХарактеристикТоваров.Раздел1С,
	|	ИС_WB_НастройкиСопоставленияХарактеристикТоваров.Поле1С
	|ИЗ
	|	РегистрСведений.ИС_WB_НастройкиСопоставленияХарактеристикТоваров КАК ИС_WB_НастройкиСопоставленияХарактеристикТоваров
	|ГДЕ
	|	ИС_WB_НастройкиСопоставленияХарактеристикТоваров.Категория = ЗНАЧЕНИЕ(Справочник.ИС_WB_Категории.ПустаяСсылка)
	|
	|УПОРЯДОЧИТЬ ПО
	|	Категория";
	
	Запрос.УстановитьПараметр("Категория", Категория);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ТаблицаСопоставления = РезультатЗапроса.Выгрузить();
	
	Возврат ТаблицаСопоставления;

КонецФункции //- ИнфоСофт Ивонин К.А. 25.10.21 УА #38646

//+ ИнфоСофт Ивонин К.А. 27.10.21 УА #38646
&НаСервереБезконтекста
Функция ПолучитьЗначениеПараметра(Знач Номенклатура, Поле1С, Раздел1С, Знач Характеристика)
	
	Запрос = Новый Запрос;
	Условие = Истина;
	Запрос.УстановитьПараметр("Номенклатура", Номенклатура);
	ПолеКопия = Поле1С;
	
	Если Раздел1С = "Справочник.Номенклатура" Тогда
		Условие = "Источник.Ссылка = &Номенклатура";   
		
		Для Каждого Владелец Из Метаданные.НайтиПоПолномуИмени(Раздел1С).Владельцы Цикл
			
			Если Владелец.Имя = "Номенклатура" Тогда
