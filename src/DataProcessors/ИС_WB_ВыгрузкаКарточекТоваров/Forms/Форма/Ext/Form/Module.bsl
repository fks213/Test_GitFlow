//+ ИнфоСофт Ивонин К.А. 28.01.24 УА #62605
&НаСервереБезКонтекста
Функция ПолучитьЗначениеЦены(ВидЦены, Номенклатура, Характеристика)

	ИспользуетсяЦенообразование25 = Константы.ИспользуетсяЦенообразование25.Получить();
    
    Запрос = Новый Запрос;
    
    Если ИспользуетсяЦенообразование25 Тогда 
    
		Запрос.Текст =	
		"ВЫБРАТЬ
		|	ВЫРАЗИТЬ(&Номенклатура КАК Справочник.Номенклатура) КАК Номенклатура,
		|	ЕСТЬNULL(ВЫРАЗИТЬ(&Характеристика КАК Справочник.ХарактеристикиНоменклатуры).ХарактеристикаНоменклатурыДляЦенообразования, ЗНАЧЕНИЕ(Справочник.ХарактеристикиНоменклатурыДляЦенообразования.ПустаяСсылка)) КАК Характеристика
		|ПОМЕСТИТЬ ВТ_Номенклатура
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ЕСТЬNULL(ЦеныНоменклатуры25СрезПоследних.Цена, 0) КАК Цена
		|ПОМЕСТИТЬ ВТ_Наборы
		|ИЗ
		|	ВТ_Номенклатура КАК ВТ_Номенклатура
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЦеныНоменклатуры25.СрезПоследних(
		|				,
		|				Номенклатура В
		|						(ВЫБРАТЬ
		|							ВТ.Номенклатура КАК Номенклатура
		|						ИЗ
		|							ВТ_Номенклатура КАК ВТ)
		|					И ВидЦены = &ВидЦены) КАК ЦеныНоменклатуры25СрезПоследних
		|		ПО ВТ_Номенклатура.Номенклатура = ЦеныНоменклатуры25СрезПоследних.Номенклатура
		|			И ВТ_Номенклатура.Характеристика = ЦеныНоменклатуры25СрезПоследних.ХарактеристикаЦО
		|
		|ОБЪЕДИНИТЬ
		|
		|ВЫБРАТЬ
		|	СУММА(ЕСТЬNULL(ЦеныНоменклатуры25СрезПоследних.Цена, 0) * ЕСТЬNULL(ВариантыКомплектацииНоменклатурыТовары.Количество, 0))
		|ИЗ
		|	ВТ_Номенклатура КАК ВТ_Номенклатура
