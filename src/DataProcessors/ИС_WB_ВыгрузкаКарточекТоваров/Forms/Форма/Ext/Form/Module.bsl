&НаСервере 
Процедура ПриИзмененииНаСервере(Номенклатура, Строка)   
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ШтрихкодыНоменклатуры.Штрихкод КАК Штрихкод,
	|	ШтрихкодыНоменклатуры.Номенклатура КАК Номенклатура,
	|	ШтрихкодыНоменклатуры.Характеристика КАК Характеристика
	|ИЗ
	|	РегистрСведений.ШтрихкодыНоменклатуры КАК ШтрихкодыНоменклатуры
	|ГДЕ
	|	ШтрихкодыНоменклатуры.Номенклатура = &Номенклатура";
	
	Запрос.УстановитьПараметр("Номенклатура", Номенклатура);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Если РезультатЗапроса.Пустой() Тогда
		ПодобратьПоля(Номенклатура, Неопределено, Строка, Новый Структура);
		Возврат;	
	КонецЕсли;
		
	ВыборкаШтрихкодов = РезультатЗапроса.Выгрузить();	
	
	Для Каждого Запись Из ВыборкаШтрихкодов Цикл 
		
		ДопПараметры = Новый Структура;
		
		Если ЗначениеЗаполнено(Запись.Штрихкод) Тогда
			ДопПараметры.Вставить("Штрихкод", Запись.Штрихкод);
		КонецЕсли;                     
		
		Если ЗначениеЗаполнено(Запись.Характеристика) Тогда
			ДопПараметры.Вставить("Характеристика", Запись.Характеристика);
		КонецЕсли;                                             
		
		ПодобратьПоля(Номенклатура, Неопределено, Строка, ДопПараметры);
		
		Строка = Неопределено;
		
	КонецЦикла;			
	
КонецПроцедуры //- ИнфоСофт Стояк Ю.К. 25.05.2023 УА #58481

//+ ИнфоСофт Стояк Ю.К. 25.05.2023 УА #58481
