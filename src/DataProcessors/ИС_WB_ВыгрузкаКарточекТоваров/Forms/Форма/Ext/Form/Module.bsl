//+ ИнфоСофт Мурсалимов Д.Р. 25.03.24 УА #71529
&НаСервереБезКонтекста 
Процедура СохранитьШтрихкодНоменклатуры(Номенклатура, Характеристика, Штрихкод)   	
	
	НаборЗаписей = РегистрыСведений.ШтрихкодыНоменклатуры.СоздатьНаборЗаписей();
	
	НаборЗаписей.Отбор.Штрихкод.Установить(Штрихкод);
		
	НаборЗаписей.Прочитать(); 
	
	ТребуетсяНоваяЗапись = Истина;	
	Если НаборЗаписей.Количество() > 0 Тогда 
		
		Для Каждого Запись Из НаборЗаписей Цикл
			
			Запись.Номенклатура 	= Номенклатура;
			Запись.Характеристика 	= Характеристика;
			Запись.Штрихкод 		= Штрихкод;
			ТребуетсяНоваяЗапись 	= Ложь;
			Прервать;
			
		КонецЦикла; 	
	
	КонецЕсли;
   
    Если ТребуетсяНоваяЗапись Тогда
	
		НоваяЗапись = НаборЗаписей.Добавить();
		
		НоваяЗапись.Номенклатура 		= Номенклатура; 
		НоваяЗапись.Характеристика 		= Характеристика;
		НоваяЗапись.Штрихкод 			= Штрихкод;
		
	КонецЕсли;
				
	НаборЗаписей.Записывать = Истина; 
	
	НаборЗаписей.Записать(Истина);
		
КонецПроцедуры //- ИнфоСофт Мурсалимов Д.Р. 25.03.24 УА #71529

