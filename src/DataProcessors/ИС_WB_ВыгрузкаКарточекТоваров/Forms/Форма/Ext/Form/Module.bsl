&НаСервере
Процедура ПодборНоменклатурыWBНаСервере(МассивВыбора)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ИС_WB_РазмерыНоменклатур.Ссылка КАК Ссылка,
	|	ИС_WB_РазмерыНоменклатур.Владелец КАК Номенклатура,
	|	ИС_WB_РазмерыНоменклатур.Владелец.Код КАК NMid
	|ПОМЕСТИТЬ ВТ_Размеры
	|ИЗ
	|	Справочник.ИС_WB_РазмерыНоменклатур КАК ИС_WB_РазмерыНоменклатур
	|ГДЕ
	|	ИС_WB_РазмерыНоменклатур.Владелец В(&Владелец)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_Размеры.Номенклатура КАК НоменклатураWB,
	|	МАКСИМУМ(ИС_WB_СоответствиеРазмеров.Номенклатура) КАК Номенклатура,
	|	ИС_WB_СоответствиеРазмеров.Номенклатура.ФайлКартинки КАК ФайлКартинки,
	|	ВТ_Размеры.NMid КАК NMid
	|ИЗ
	|	ВТ_Размеры КАК ВТ_Размеры
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.ИС_WB_СоответствиеРазмеров КАК ИС_WB_СоответствиеРазмеров
	|		ПО ВТ_Размеры.Ссылка = ИС_WB_СоответствиеРазмеров.РазмерWB
	|
	|СГРУППИРОВАТЬ ПО
	|	ВТ_Размеры.Номенклатура,
	|	ИС_WB_СоответствиеРазмеров.Номенклатура.ФайлКартинки,
	|	ИС_WB_СоответствиеРазмеров.Номенклатура.Артикул,
	|	ВТ_Размеры.NMid";
	
	Запрос.УстановитьПараметр("Владелец", МассивВыбора);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаПодбора = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаПодбора.Следующий() Цикл	
		
		НоваяСтрока = ТаблицаИзображений.Добавить();  
		ЗаполнитьЗначенияСвойств(НоваяСтрока, ВыборкаПодбора);
		
		Если ЗначениеЗаполнено(НоваяСтрока.ФайлКартинки) Тогда
			НоваяСтрока.Выгружать = Истина;
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры //- ИнфоСофт Ивонин К.А. 30.08.24 УА #74933

