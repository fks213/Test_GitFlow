КонецПроцедуры //- ИнфоСофт Ивонин К.А. 11.10.21 УА #38646

//+ ИнфоСофт Ивонин К.А. 12.10.21 УА #38646
&НаКлиенте
Процедура ТаблицаВыгрузкиНоменклатураПриИзменении(Элемент)
	
	ТекДанные = Элементы.ТаблицаВыгрузки.ТекущиеДанные;
	
	Если ТекДанные = Неопределено Тогда 
		Возврат;
	КонецЕсли;
	
	Строка = Элементы.ТаблицаВыгрузки.ТекущаяСтрока;	
	Номенклатура = ТекДанные.Номенклатура; 	
	
	//+ ИнфоСофт Стояк Ю.К. 25.05.2023 УА #58481	
	ПриИзмененииНаСервере(Номенклатура, Строка);
	//- ИнфоСофт Стояк Ю.К. 25.05.2023 УА #58481

КонецПроцедуры //- ИнфоСофт Ивонин К.А. 12.10.21 УА #38464

//+ ИнфоСофт Ивонин К.А. 12.10.21 УА #38646
&НаКлиенте
Процедура ОбработкаВыбора(ВыбранноеЗначение, ИсточникВыбора)
	
	Если ИсточникВыбора.ИмяФормы = "Справочник.Номенклатура.Форма.ФормаВыбораГруппИЭлементов" Тогда
		ПодборНаСервере(ВыбранноеЗначение);
	ИначеЕсли ИсточникВыбора.ИмяФормы = "Справочник.ИС_WB_Номенклатура.ФормаВыбора" Тогда
		ПодборНоменклатурыWBНаСервере(ВыбранноеЗначение);
	КонецЕсли;                                  
	
КонецПроцедуры //- ИнфоСофт Ивонин К.А. 12.10.21 УА #38646

//+ ИнфоСофт Ивонин К.А. 20.10.21 УА #38646
&НаКлиенте
Процедура ТаблицаВыгрузкиНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
    
    ТекДанные = Элементы.ТаблицаВыгрузки.ТекущиеДанные;
	
	Если ТекДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
    
	СтандартнаяОбработка = Ложь;
	ПараметрыОткрытия = ПолучитьСтруктуруПараметровВыбор(Элемент.Имя, ТекДанные[Элемент.Имя]);
	ОткрытьФорму("Обработка.ИС_WB_ВыгрузкаКарточекТоваров.Форма.ФормаВыбораСпискаЗначений", ПараметрыОткрытия, Элемент);

КонецПроцедуры //- ИнфоСофт Ивонин К.А. 20.10.21 УА #38646

