//+ ИнфоСофт Ивонин К.А. 06.10.21 УА #38646
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ИС_WB_Сервер.ПриСозданииНаСервере(ЭтотОбъект);
	
	АвтоПодбор = Истина;	
	РежимОтладки = Ложь;
