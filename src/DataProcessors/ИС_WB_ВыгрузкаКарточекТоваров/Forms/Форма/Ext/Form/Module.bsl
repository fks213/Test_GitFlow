		//+ ИнфоСофт Власова И.С. 05.02.25 УА #92726
		|	ВТ_ОтборНесопоставленных.Упаковка КАК Упаковка,
		//- ИнфоСофт Власова И.С. 05.02.25 УА #92726
		|	ВТ_ОтборНесопоставленных.Размер КАК РазмерВБ,
		|	ВТ_ОтборНесопоставленных.ТребуетсяСопоставление КАК ТребуетсяСопоставление
		|ИЗ
		|	ВТ_ОтборНесопоставленных КАК ВТ_ОтборНесопоставленных
		|ГДЕ
		|	ВТ_ОтборНесопоставленных.ТребуетсяСопоставление";
	
	Запрос.УстановитьПараметр("ТаблицаВыгрузки", ТаблицаВыгрузки.Выгрузить());
	Запрос.УстановитьПараметр("Профиль",         Профиль);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаСопоставление = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаСопоставление.Следующий() Цикл
		
		ИС_WB_Сервер.ДобавитьСоответствиеРазмеров(Профиль, ВыборкаСопоставление.РазмерВБ, ВыборкаСопоставление.Номенклатура,
			ВыборкаСопоставление.Характеристика, ВыборкаСопоставление.Упаковка);
		
	КонецЦикла;
		
