//+ ИнфоСофт Ивонин К.А. 12.10.21 УА #38646
&НаСервере
Процедура ПодобратьПоля(Элемент, ТаблицаСопоставления, Знач Строка = Неопределено, ДопПараметры)
    
   	Если ТаблицаСопоставления = Неопределено Тогда
		ТаблицаСопоставления = ПолучитьТаблицуСопоставления(Категория);
	КонецЕсли;

	Если ТипЗнч(Строка) = Тип("Число") Тогда  	
		Строка = ТаблицаВыгрузки.НайтиПоИдентификатору(Строка);
	Иначе
		Строка = ТаблицаВыгрузки.Добавить();
	КонецЕсли;

	Строка.Номенклатура = Элемент; 
	
	//+ ИнфоСофт Ивонин К.А. 12.03.24 УА #72137
	////+ ИнфоСофт Стояк Ю.К. 27.06.2023 УА #59660
	//НайденныйСтроки = ТаблицаВыгрузки.НайтиСтроки(Новый Структура("Номенклатура", Строка.Номенклатура)); 
	//	
	//Если НайденныйСтроки.Количество() > 1 И ХарактеристикаКакРазмер Тогда
	//	Строка.ЭтоРазмер = Истина;	
	//КонецЕсли;                                  
	////- ИнфоСофт Стояк Ю.К. 27.06.2023 УА #59660
	//- ИнфоСофт Ивонин К.А. 12.03.24 УА #72137
	
	//+ ИнфоСофт Стояк Ю.К. 25.05.2023 УА #58481	
	Если ДопПараметры.Свойство("Штрихкод") Тогда
		Строка.barcode = ДопПараметры.Штрихкод;	
	КонецЕсли;
	
	Если ДопПараметры.Свойство("Характеристика") Тогда
		Строка.Характеристика = ДопПараметры.Характеристика;	
	КонецЕсли;
	//- ИнфоСофт Стояк Ю.К. 25.05.2023 УА #58481
	
	Если ЗначениеЗаполнено(ВидЦены) Тогда
		Строка.РозничнаяЦена = ПолучитьЗначениеЦены(ВидЦены, Строка.Номенклатура, Строка.Характеристика);
	КонецЕсли;
	
	Строка.object = Категория;
	
	СоответствиеПолей = ХранилищеОбщихНастроек.Загрузить("ИС_НастройкиПолей");
	
	Для Каждого СтрокаТаблицы Из ТаблицаСопоставления Цикл
	
		Если СтрокаТаблицы.Характеристика = "Артикул" Тогда
			Строка.vendorCode = ПолучитьЗначениеПараметра(Элемент, СтрокаТаблицы.Поле1С, СтрокаТаблицы.Раздел1С, Строка.Характеристика);
			Продолжить;
		КонецЕсли;
		
		Если СтрокаТаблицы.Характеристика = "Бренд" Тогда
			Строка.Бренд = ПолучитьЗначениеПараметра(Элемент, СтрокаТаблицы.Поле1С, СтрокаТаблицы.Раздел1С, Строка.Характеристика);
			Продолжить;
		КонецЕсли;
		
		Если СтрокаТаблицы.Характеристика = "Наименование" Тогда
			Строка.Наименование = ПолучитьЗначениеПараметра(Элемент, СтрокаТаблицы.Поле1С, СтрокаТаблицы.Раздел1С, Строка.Характеристика);
			Продолжить;
		КонецЕсли;
		
		Если СтрокаТаблицы.Характеристика = "Описание" Тогда
			Строка.Описание = ПолучитьЗначениеПараметра(Элемент, СтрокаТаблицы.Поле1С, СтрокаТаблицы.Раздел1С, Строка.Характеристика);
			Продолжить;
		КонецЕсли;
		
		Если СтрокаТаблицы.Характеристика = "Длина упаковки (см)" Тогда
			Строка.ДлинаУпаковки = ПолучитьЗначениеПараметра(Элемент, СтрокаТаблицы.Поле1С, СтрокаТаблицы.Раздел1С, Строка.Характеристика);
			Продолжить;
		КонецЕсли;
		
		Если СтрокаТаблицы.Характеристика = "Ширина упаковки (см)" Тогда
			Строка.ШиринаУпаковки = ПолучитьЗначениеПараметра(Элемент, СтрокаТаблицы.Поле1С, СтрокаТаблицы.Раздел1С, Строка.Характеристика);
			Продолжить;
		КонецЕсли;
		
		Если СтрокаТаблицы.Характеристика = "Высота упаковки (см)" Тогда
			Строка.ВысотаУпаковки = ПолучитьЗначениеПараметра(Элемент, СтрокаТаблицы.Поле1С, СтрокаТаблицы.Раздел1С, Строка.Характеристика);
			Продолжить;
		КонецЕсли;
		
		Если Не ЗначениеЗаполнено(Строка.barcode) Тогда
			Если СтрокаТаблицы.Характеристика = "Штрихкод" Тогда
				Строка.barcode = ПолучитьЗначениеПараметра(Элемент, СтрокаТаблицы.Поле1С, СтрокаТаблицы.Раздел1С, Строка.Характеристика);
				Продолжить;
			КонецЕсли;
		КонецЕсли;
			
		Для Каждого ЭлементСоответствия Из СоответствиеПолей Цикл
		
			Если ЭлементСоответствия.Значение.Поле.Наименование = СтрокаТаблицы.Характеристика Тогда
				
				//+ ИнфоСофт Стояк Ю.К. 26.05.2023 УА #58481				
				Если ЭлементСоответствия.Значение.МаксимальноеКоличество > 1 Тогда
					Строка[ЭлементСоответствия.Ключ].Добавить(ПолучитьЗначениеПараметра(Элемент, СтрокаТаблицы.Поле1С, СтрокаТаблицы.Раздел1С, Строка.Характеристика)) 
				Иначе
				//+ ИнфоСофт Ивонин К.А. 12.03.24 УА #72137
					
					ЗначениеПараметра = ПолучитьЗначениеПараметра(Элемент, СтрокаТаблицы.Поле1С, СтрокаТаблицы.Раздел1С, Строка.Характеристика);
					
					Если ЗначениеПараметра = Неопределено Тогда
						Продолжить;
					КонецЕсли;
					
					Если ЗначениеЗаполнено(ЭлементСоответствия.Значение.ЕдиницаИзмерения) Тогда
					
						Попытка
							Строка[ЭлементСоответствия.Ключ] = Число(ЗначениеПараметра);
						Исключение
							Строка[ЭлементСоответствия.Ключ] = 0;
						КонецПопытки;	
					
					Иначе
						Строка[ЭлементСоответствия.Ключ] = Строка(ЗначениеПараметра);
					КонецЕсли;
					//Если Не Строка[ЭлементСоответствия.Ключ] = ПолучитьЗначениеПараметра(Элемент, СтрокаТаблицы.Поле1С, СтрокаТаблицы.Раздел1С, Строка.Характеристика) Тогда
					//	Попытка
					//		Строка[ЭлементСоответствия.Ключ] = Число(ПолучитьЗначениеПараметра(Элемент, СтрокаТаблицы.Поле1С, СтрокаТаблицы.Раздел1С, Строка.Характеристика));
					//	Исключение                                                                                                                                            
					//		Строка[ЭлементСоответствия.Ключ] = Строка(ПолучитьЗначениеПараметра(Элемент, СтрокаТаблицы.Поле1С, СтрокаТаблицы.Раздел1С, Строка.Характеристика));
					//	КонецПопытки;
					//КонецЕсли;
				//- ИнфоСофт Ивонин К.А. 12.03.24 УА #72137	
				КонецЕсли;
				//- ИнфоСофт Стояк Ю.К. 26.05.2023 УА #58481
		    	Прервать;	
			
			КонецЕсли;
		
		КонецЦикла;	
	
	КонецЦикла;
	
	ТаблицаСопоставления = Неопределено;
			
КонецПроцедуры //- ИнфоСофт Ивонин К.А. 12.10.21 УА #38646

//+ ИнфоСофт Ивонин К.А. 12.10.21 УА #38646
&НаСервере
Процедура СформироватьТелоЗапросаВыгрузкиКарточек()

	Результат = Новый Массив; 
	                  
    ТаблицаФоримрованияЗапроса = ТаблицаВыгрузки.Выгрузить();
    
    СоответствиеПолей = ХранилищеОбщихНастроек.Загрузить("ИС_НастройкиПолей");
    
    Размер = Неопределено;
    РосРазмер = Неопределено;
    
    Для Каждого Элемент Из СоответствиеПолей Цикл
        
        Если Элемент.Значение.Наименование = "Размер" Тогда
        	Размер = Элемент.Ключ;
        	Продолжить;
        КонецЕсли;
        
        Если Элемент.Значение.Наименование = "Рос. размер" Тогда
        	РосРазмер = Элемент.Ключ;
        	Продолжить;
        КонецЕсли;
           
    КонецЦикла;
    
    Запрос = Новый Запрос;
	Запрос.Текст =	
	"ВЫБРАТЬ
	|	ТЧ.Номенклатура КАК Номенклатура,
	|	ТЧ.Характеристика КАК Характеристика
	|ПОМЕСТИТЬ ВТ_ТЧ
	|ИЗ
	|	&ТЧ КАК ТЧ
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_ТЧ.Номенклатура КАК Номенклатура,
	|	ВТ_ТЧ.Характеристика КАК Характеристика
	|ИЗ
	|	ВТ_ТЧ КАК ВТ_ТЧ
	|ИТОГИ ПО
	|	Номенклатура";

	Запрос.УстановитьПараметр("ТЧ", ТаблицаФоримрованияЗапроса);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаНоменклатуры = РезультатЗапроса.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	Пока ВыборкаНоменклатуры.Следующий() Цикл
    	
    	ВыборкаХакартеристики = ВыборкаНоменклатуры.Выбрать();
    	
    	СтруктураТовара = Новый Структура;
    	
    	МассивVariants = Новый Массив;
    	
    	ВыборкаХакартеристики.Следующий();
    	
		НайденныеСтроки = ТаблицаФоримрованияЗапроса.НайтиСтроки(
			Новый Структура("Номенклатура, Характеристика", ВыборкаХакартеристики.Номенклатура, ВыборкаХакартеристики.Характеристика));	
		
		Если НайденныеСтроки.Количество() = 0 Тогда
			Продолжить;
		КонецЕсли;
		
		СтруктураVariant = Новый Структура;
		МассивSizes = Новый Массив;
		
		Для Каждого Строка Из НайденныеСтроки Цикл
			
			СтруктураТовара.Вставить("subjectID", Строка.object.subjectID);	
		
			Если Не ЗначениеЗаполнено(Строка.vendorCode) Тогда
				Продолжить;
			КонецЕсли;
				
			СтруктураVariant.Вставить("vendorCode", Строка.vendorCode);
			СтруктураVariant.Вставить("title", Строка.Наименование);
			СтруктураVariant.Вставить("description", Строка.Описание);
			СтруктураVariant.Вставить("brand", Строка.Бренд);
			
			СтруктураDimensions = Новый Структура;
			
			СтруктураDimensions.Вставить("length", Строка.ДлинаУпаковки);
			СтруктураDimensions.Вставить("width", Строка.ШиринаУпаковки);
			СтруктураDimensions.Вставить("height", Строка.ВысотаУпаковки);
            
            СтруктураVariant.Вставить("dimensions", СтруктураDimensions);
            
            МассивCharacteristics = СформироватьМассивCharacteristics(Строка, СоответствиеПолей);
           	СтруктураVariant.Вставить("characteristics", МассивCharacteristics); 
			
			СтруктураSizes = Новый Структура;
			
			Если Размер <> Неопределено Тогда
				СтруктураSizes.Вставить("techSize", Строка[Размер]);
			КонецЕсли;
			
			Если РосРазмер <> Неопределено Тогда		
				СтруктураSizes.Вставить("wbSize", Строка[РосРазмер]);   
			КонецЕсли;
			
			Если ЗначениеЗаполнено(Строка.РозничнаяЦена) Тогда	
				СтруктураSizes.Вставить("price", Строка.РозничнаяЦена);    
			КонецЕсли;
			
			Если ЗначениеЗаполнено(Строка.barcode) Тогда
				
				МассивBarcodes = Новый Массив;
				МассивBarcodes.Добавить(Строка.barcode);
				
				СтруктураSizes.Вставить("skus", МассивBarcodes); 
			
			КонецЕсли;
			
			Если СтруктураSizes.Количество() > 0 Тогда
				МассивSizes.Добавить(СтруктураSizes);
			КонецЕсли;
				
			СтруктураVariant.Вставить("sizes", МассивSizes);
			
			МассивVariants.Добавить(СтруктураVariant);
			
			СтруктураТовара.Вставить("variants", МассивVariants);
		
		КонецЦикла;
		
		Пока ВыборкаХакартеристики.Следующий() Цикл
    	
			НайденныеСтроки = ТаблицаФоримрованияЗапроса.НайтиСтроки(
				Новый Структура("Номенклатура, Характеристика", ВыборкаХакартеристики.Номенклатура, ВыборкаХакартеристики.Характеристика));	
			
			Если НайденныеСтроки.Количество() = 0 Тогда
				Продолжить;
			КонецЕсли;
			
			Если ХарактеристикаКакРазмер Тогда	    
			    
			    Для Каждого Строка Из НайденныеСтроки Цикл
				
					СтруктураSizes = Новый Структура;
					
					Если Размер <> Неопределено Тогда
						СтруктураSizes.Вставить("techSize", Строка[Размер]);
					КонецЕсли;
					
					Если РосРазмер <> Неопределено Тогда		
						СтруктураSizes.Вставить("wbSize", Строка[РосРазмер]);   
					КонецЕсли;
					
					Если ЗначениеЗаполнено(Строка.РозничнаяЦена) Тогда	
						СтруктураSizes.Вставить("price", Строка.РозничнаяЦена);    
					КонецЕсли;
					
					Если ЗначениеЗаполнено(Строка.barcode) Тогда
						
						МассивBarcodes = Новый Массив;
						МассивBarcodes.Добавить(Строка.barcode);
						
						СтруктураSizes.Вставить("skus", МассивBarcodes); 
					
					КонецЕсли;
					
					Если СтруктураSizes.Количество() > 0 Тогда
						МассивSizes.Добавить(СтруктураSizes);
					КонецЕсли;
				
				КонецЦикла;
			
			Иначе // Цвет
			
				СтруктураVariant = Новый Структура;
				
				Для Каждого Строка Из НайденныеСтроки Цикл
					
					СтруктураТовара.Вставить("subjectID", Строка.object.subjectID);	
				
					Если Не ЗначениеЗаполнено(Строка.vendorCode) Тогда
						Продолжить;
					КонецЕсли;
						
					СтруктураVariant.Вставить("vendorCode", Строка.vendorCode);
					СтруктураVariant.Вставить("title", Строка.Наименование);
					СтруктураVariant.Вставить("description", Строка.Описание);
					СтруктураVariant.Вставить("brand", Строка.Бренд);
					
					СтруктураDimensions = Новый Структура;
					
					СтруктураDimensions.Вставить("length", Строка.ДлинаУпаковки);
					СтруктураDimensions.Вставить("width", Строка.ШиринаУпаковки);
					СтруктураDimensions.Вставить("height", Строка.ВысотаУпаковки);
					            
		            СтруктураVariant.Вставить("dimensions", СтруктураDimensions);
		            
		            МассивCharacteristics = СформироватьМассивCharacteristics(Строка, СоответствиеПолей);
		           	СтруктураVariant.Вставить("characteristics", МассивCharacteristics); 
					
					МассивSizes = Новый Массив;
					СтруктураSizes = Новый Структура;
					
					Если Размер <> Неопределено Тогда
						СтруктураSizes.Вставить("techSize", Строка[Размер]);
					КонецЕсли;
					
					Если РосРазмер <> Неопределено Тогда		
						СтруктураSizes.Вставить("wbSize", Строка[РосРазмер]);   
					КонецЕсли;
					
					Если ЗначениеЗаполнено(Строка.РозничнаяЦена) Тогда	
						СтруктураSizes.Вставить("price", Строка.РозничнаяЦена);    
					КонецЕсли;
					
					Если ЗначениеЗаполнено(Строка.barcode) Тогда
						
						МассивBarcodes = Новый Массив;
						МассивBarcodes.Добавить(Строка.barcode);
						
						СтруктураSizes.Вставить("skus", МассивBarcodes); 
					
					КонецЕсли;
					
					Если СтруктураSizes.Количество() > 0 Тогда
						МассивSizes.Добавить(СтруктураSizes);
					КонецЕсли;
						
					СтруктураVariant.Вставить("sizes", МассивSizes);
					
					МассивVariants.Добавить(СтруктураVariant);
				
				КонецЦикла;
			
			КонецЕсли; 
			
		КонецЦикла;
    	
    	Результат.Добавить(СтруктураТовара);
    	   
	КонецЦикла;
	
	РезультатФормирования = ИС_MP_РаботаСHTTPЗапросамиСервер.ПолучитьСтрокуJSON(Результат);
                                             
