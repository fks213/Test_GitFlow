&НаСервереБезКонтекста
Процедура ПерезагрузитьКатегориюНаСервере(Профиль, Категория)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ИС_WB_Категории.Наименование КАК Наименование
	|ИЗ
	|	Справочник.ИС_WB_Категории КАК ИС_WB_Категории
	|ГДЕ
	|	ИС_WB_Категории.Ссылка = &Ссылка";
	
	Запрос.УстановитьПараметр("Ссылка", Категория);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Если РезультатЗапроса.Пустой() Тогда
		ОбщегоНазначения.СообщитьПользователю("Выбраная категория не найдена, возможно она была удалена");
		Возврат;
	КонецЕсли;
	
	ВыборкаКатегорий = РезультатЗапроса.Выбрать();
	ВыборкаКатегорий.Следующий();	
    
	ЗагруженнаяКатегория = ИС_WB_Сервер.ЗагрузитьКатегорию(Профиль, ВыборкаКатегорий.Наименование, Истина);
	Если ЗагруженнаяКатегория <> Неопределено Тогда
		ОбщегоНазначения.СообщитьПользователю(СтрШаблон("Категория %1 успешно загружена", ЗагруженнаяКатегория));
	КонецЕсли;
	
КонецПроцедуры //- ИнфоСофт Ивонин К.А. 24.04.24 УА #73304

