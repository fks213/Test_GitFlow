//+ ИнфоСофт Ивонин К.А. 07.10.21 УА #38646
&НаСервере
Процедура СформироватьТаблицуДляВыгрузки(ВыбраннаяКатегория)

	МассивУдаления = Новый Массив;

	Для Каждого Элемент Из ПолучитьРеквизиты("ТаблицаВыгрузки") Цикл
			
		Если Лев(Элемент.Имя, 1) = "П" Тогда
			МассивУдаления.Добавить("ТаблицаВыгрузки." + Элемент.Имя);
			Элементы.Удалить(Элементы[Элемент.Имя]);
		КонецЕсли;
	
	КонецЦикла;
	
	ИзменитьРеквизиты(, МассивУдаления);

	СоответствиеПолей = Новый Соответствие;
		
	ОписаниеТиповЧислоВещественное = Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(10, 3, ДопустимыйЗнак.Любой));
	ОписаниеТиповСтрока     	   = Новый ОписаниеТипов("Строка", , Новый КвалификаторыСтроки(1024));
	ОписаниеТиповСписокЗначений	   = Новый ОписаниеТипов("СписокЗначений");
		    
	ТЗ = Новый ТаблицаЗначений;
		
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ИС_WB_КатегорииХарактеристики.Поле КАК Поле,
	|	ИС_WB_ХарактеристикиКатегорий.Наименование КАК Наименование,
	|	ИС_WB_ХарактеристикиКатегорий.charcID КАК charcID,
	|	ИС_WB_КатегорииХарактеристики.Обязательное КАК Обязательное,
	|	ИС_WB_ХарактеристикиКатегорий.dictionary КАК dictionary,
	|	ИС_WB_ХарактеристикиКатегорий.maxCount КАК maxCount,
	|	ИС_WB_ХарактеристикиКатегорий.unitName КАК unitName,
	|	ИС_WB_ХарактеристикиКатегорий.popular КАК popular
	|ИЗ
	|	Справочник.ИС_WB_Категории.Характеристики КАК ИС_WB_КатегорииХарактеристики
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ИС_WB_ХарактеристикиКатегорий КАК ИС_WB_ХарактеристикиКатегорий
	|		ПО ИС_WB_КатегорииХарактеристики.Поле = ИС_WB_ХарактеристикиКатегорий.Ссылка
	|ГДЕ
	|	ИС_WB_КатегорииХарактеристики.Ссылка = &Ссылка
	|
	|УПОРЯДОЧИТЬ ПО
	|	popular УБЫВ,
	|	Наименование";
		
	Запрос.УстановитьПараметр("Ссылка", ВыбраннаяКатегория);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Выборка = РезультатЗапроса.Выбрать();
	
	ТекущийИдЭлемента = 0;
	Пока Выборка.Следующий() Цикл
		
		СтруктураПоля = Новый Структура;
		СтруктураПоля.Вставить("Поле", Выборка.Поле);
		СтруктураПоля.Вставить("charcID", Выборка.charcID);
		СтруктураПоля.Вставить("Наименование", Выборка.Наименование);
		СтруктураПоля.Вставить("Обязательное", Выборка.Обязательное);
		СтруктураПоля.Вставить("Справочник", Выборка.dictionary);
		СтруктураПоля.Вставить("МаксимальноеКоличество", Выборка.maxCount);
		СтруктураПоля.Вставить("ЕдиницаИзмерения", Выборка.unitName);
		СтруктураПоля.Вставить("Популярная", Выборка.popular);
			
		СоответствиеПолей.Вставить("Поле" + ТекущийИдЭлемента, СтруктураПоля);
		
		Если Выборка.maxCount > 1 Тогда
			ТЗ.Колонки.Добавить("Поле" + ТекущийИдЭлемента, ОписаниеТиповСписокЗначений);		
		ИначеЕсли Выборка.unitName <> "" Тогда
			ТЗ.Колонки.Добавить("Поле" + ТекущийИдЭлемента, ОписаниеТиповЧислоВещественное);
		Иначе
		    ТЗ.Колонки.Добавить("Поле" + ТекущийИдЭлемента, ОписаниеТиповСтрока);
		КонецЕсли;
		
		ТекущийИдЭлемента = ТекущийИдЭлемента + 1;
	
	КонецЦикла;
	
	ХранилищеОбщихНастроек.Сохранить("ИС_НастройкиПолей", , СоответствиеПолей);
	
	НовыеРеквизиты = Новый Массив;
	
	Для Каждого Колонка Из ТЗ.Колонки Цикл
		Реквизит = Новый РеквизитФормы(Колонка.Имя, Колонка.ТипЗначения, 
			"ТаблицаВыгрузки", СоответствиеПолей[Колонка.Имя].Наименование);
		НовыеРеквизиты.Добавить(Реквизит);
	КонецЦикла;
	
	ИзменитьРеквизиты(НовыеРеквизиты);
		
	Для Каждого Колонка Из ТЗ.Колонки Цикл
		                                   
		НовыйЭлемент = Элементы.Добавить(Колонка.Имя, Тип("ПолеФормы"), Элементы["ТаблицаВыгрузки"]);
		НовыйЭлемент.Вид = ВидПоляФормы.ПолеВвода;
		НовыйЭлемент.ПутьКДанным = "ТаблицаВыгрузки." + Колонка.Имя;
		
		Характеристика = СоответствиеПолей[Колонка.Имя];
		
		Если Характеристика.Справочник <> "" И Характеристика.МаксимальноеКоличество < 2 Тогда
		
			Если Характеристика.Справочник <> "tnved" Тогда
			
				НовыйЭлемент.РежимВыбораИзСписка = Истина;
				СписокВыбора = ИС_WB_Сервер.ПолучитьЗначенияХарактеристики(Профиль, Характеристика.Справочник);
				Если СписокВыбора = Неопределено Тогда
					НовыйЭлемент.РежимВыбораИзСписка = Ложь;	
				Иначе
					НовыйЭлемент.СписокВыбора.ЗагрузитьЗначения(СписокВыбора.ВыгрузитьЗначения()); 
				КонецЕсли;			
				
			Иначе	
				НовыйЭлемент.УстановитьДействие("АвтоПодбор", "ТаблицаВыгрузкиАвтоПодбор"); 
		    КонецЕсли;
		
		КонецЕсли;
		
		Если Характеристика.МаксимальноеКоличество > 1 Тогда
			НовыйЭлемент.УстановитьДействие("НачалоВыбора", "ТаблицаВыгрузкиНачалоВыбора");
			НовыйЭлемент.УстановитьДействие("ОбработкаВыбора", "ОбработкаВыбораЭлемента");
		КонецЕсли;

		Если Характеристика.Обязательное Тогда
			НовыйЭлемент.ЦветФонаЗаголовка = ЦветаСтиля.ЦветАкцента;
			НовыйЭлемент.ЦветТекстаЗаголовка = ЦветаСтиля.ЦветТекстаВыделенияПоля;
		КонецЕсли;
					
	КонецЦикла;
		
КонецПроцедуры //- ИнфоСофт Ивонин К.А. 07.10.21 УА #38646

