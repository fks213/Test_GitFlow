
#Область ОбработчикиСобытийФормы

//+ ИнфоСофт Ивонин К.А. 06.10.21 УА #38646
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ИС_WB_Сервер.ПриСозданииНаСервере(ЭтотОбъект);
	
	Если Параметры.Свойство("Профиль") Тогда
		Профиль = Параметры.Профиль;
	КонецЕсли;

КонецПроцедуры //- ИнфоСофт Ивонин К.А. 06.10.21 УА #38646

//+ ИнфоСофт Ивонин К.А. 06.10.21 УА #38646
&НаКлиенте
Процедура ПриОткрытии(Отказ)

	Если Не ЗначениеЗаполнено(Профиль) Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю("Для загрузки категорий необходимо выбрать Профиль!", , , "Профиль");
		Возврат;
	КонецЕсли;
	
	ЗагрузитьСписокРодительскихКатегорий();

КонецПроцедуры //- ИнфоСофт Ивонин К.А. 06.10.21 УА #38646

//+ ИнфоСофт Ивонин К.А. 07.10.21 УА #38646
&НаКлиенте
Процедура РодительскаяКатегорияВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	ТекДанные = Элементы.РодительскаяКатегория.ТекущиеДанные;
	Если ТекДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ЗагрузитьСписокКатегорий(ТекДанные.id);

КонецПроцедуры //- ИнфоСофт Ивонин К.А. 07.10.21 УА #38646

//+ ИнфоСофт Ивонин К.А. 07.10.21 УА #38646
&НаКлиенте
Процедура КатегорияВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	ТекДанныеКатегория = Элементы.Категория.ТекущиеДанные;
	Если ТекДанныеКатегория = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ЗагрузитьКатегорию(ТекДанныеКатегория.Наименование);
	ОповеститьОбИзменении(Тип("СправочникСсылка.ИС_WB_Категории"));

КонецПроцедуры //- ИнфоСофт Ивонин К.А. 07.10.21 УА #38646

#КонецОбласти

