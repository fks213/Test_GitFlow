//+ ИнфоСофт Стояк Ю.К. 12.05.2023 УА #54628
&НаСервере
Процедура ПрофильПриИзмененииНаСервере()
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ИС_Ozon_Номенклатура.Ссылка КАК НоменклатураOzon,
		|	ИС_Ozon_Номенклатура.Наименование КАК Наименование,
		|	ИС_Ozon_Номенклатура.offer_id КАК Артикул,
		|	ИС_Ozon_Номенклатура.Код КАК product_id,
		|	ИС_Ozon_Штрихкоды.Наименование КАК Штрихкод
		|ИЗ
		|	Справочник.ИС_Ozon_Номенклатура КАК ИС_Ozon_Номенклатура
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ИС_Ozon_Штрихкоды КАК ИС_Ozon_Штрихкоды
		|		ПО ИС_Ozon_Номенклатура.Ссылка = ИС_Ozon_Штрихкоды.Владелец
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ИС_Ozon_СоответствиеХарактеристик КАК ИС_Ozon_СоответствиеХарактеристик
		|		ПО ИС_Ozon_СоответствиеХарактеристик.НоменклатураOzon = ИС_Ozon_Номенклатура.Ссылка
		|ГДЕ
		|	ИС_Ozon_Номенклатура.Профиль = &Профиль
		|	И ИС_Ozon_СоответствиеХарактеристик.НоменклатураOzon ЕСТЬ NULL";
	
	Запрос.УстановитьПараметр("Профиль", Профиль);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выгрузить();
	
	Объект.ДанныеДляСозданияНоменклатурыOzon.Загрузить(ВыборкаДетальныеЗаписи);
	
КонецПроцедуры //- ИнфоСофт Стояк Ю.К. 12.05.2023 УА #54628


