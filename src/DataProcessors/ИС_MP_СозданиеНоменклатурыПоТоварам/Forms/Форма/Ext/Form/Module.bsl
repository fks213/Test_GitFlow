//+ ИнфоСофт Стояк Ю.К. 12.05.2023 УА #54628
&НаКлиенте
Процедура СоздатьНоменклатуру(Команда)
	ВыбранныеТовары = Объект.ДанныеДляСозданияНоменклатурыOzon.НайтиСтроки(Новый Структура("Создавать", Истина));
	Если ВыбранныеТовары.Количество() = 0 Или Не ЗначениеЗаполнено(ВидНоменклатуры) Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю(
			"Для перехода к созданию номенклатуры, необходимо выбрать один или несколько товаров и выбрать вид номенклатуры");
		Возврат;
	КонецЕсли;
	СоздатьНоменклатуруНаСервере();
КонецПроцедуры //- ИнфоСофт Стояк Ю.К. 12.05.2023 УА #54628

#КонецОбласти

