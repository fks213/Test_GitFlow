//+ ИнфоСофт Стояк Ю.К. 12.05.2023 УА #54628
&НаСервере
Процедура СоздатьНоменклатуруНаСервере()
	ВыбранныеТовары = Объект.ДанныеДляСозданияНоменклатурыOzon.НайтиСтроки(Новый Структура("Создавать", Истина));
	ТаблицаТовары 	= Объект.ДанныеДляСозданияНоменклатурыOzon.Выгрузить(ВыбранныеТовары);
	СтруктураСвойств = Новый Структура;
	СтруктураСвойств.Вставить("ВидНоменклатуры", ВидНоменклатуры);
	СтруктураСвойств.Вставить("ГруппаНоменклатуры", ГруппаНоменклатуры);
	СтруктураСвойств.Вставить("СтавкаНДС", СтавкаНДС);
	
	Таблица = ИС_Ozon_Сервер.СоздатьНоменклатуру(ТаблицаТовары, СтруктураСвойств); 
	
	Для Каждого Строка Из Объект.ДанныеДляСозданияНоменклатурыOzon Цикл
		
		НайденныеСтроки = Таблица.НайтиСтроки(Новый Структура("НоменклатураOzon", Строка.НоменклатураOzon)); 
		
		Если НайденныеСтроки.Количество() > 0 Тогда
				Строка.Номенклатура = НайденныеСтроки[0].Номенклатура;
		КонецЕсли; 
			
	КонецЦикла;
	
КонецПроцедуры //- ИнфоСофт Стояк Ю.К. 12.05.2023 УА #54628

#КонецОбласти

