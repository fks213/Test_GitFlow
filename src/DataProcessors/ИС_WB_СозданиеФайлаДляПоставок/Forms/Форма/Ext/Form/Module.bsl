//+ ИнфоСофт Ивонин К.А. 10.04.23 УА #57127
&НаКлиенте
Процедура ПодключитьРасширениеДляРаботыСФайламиЗавершение(Подключено, УстановитьЕслиНеПодключено) Экспорт
	
	Если Подключено Тогда
		Возврат;
	ИначеЕсли УстановитьЕслиНеПодключено Тогда  	
		ОписаниеОповещения = Новый ОписаниеОповещения("ПодключитьРасширениеДляРаботыСФайлами", ЭтотОбъект, Ложь);     
		НачатьУстановкуРасширенияРаботыСФайлами(ОписаниеОповещения);
	Иначе
		ОбщегоНазначенияКлиент.СообщитьПользователю("Не удалось подключить расширение для работы с файлами!");
	КонецЕсли;
	
КонецПроцедуры //- ИнфоСофт Ивонин К.А. 10.04.23 УА #57127

//+ ИнфоСофт Ивонин К.А. 21.09.21 УА #38645
&НаСервере
Процедура СформироватьФайлНаСервере()
		
	МассивНоменклатур = ДокументОснование.Товары.Выгрузить(, 
		"Номенклатура,Характеристика,НоменклатураНабора,ХарактеристикаНабора,Количество");		
	МассивНоменклатур.Свернуть(
		"Номенклатура,Характеристика,НоменклатураНабора,ХарактеристикаНабора","Количество");	
	
	Запрос = Новый Запрос;
	Запрос.Текст =	
	"ВЫБРАТЬ
	|	ВариантыКомплектацииНоменклатурыТовары.Ссылка.Владелец КАК НоменклатураНабора,
	|	ВариантыКомплектацииНоменклатурыТовары.Ссылка.Характеристика КАК ХарактеристикаНабора,
	|	ВариантыКомплектацииНоменклатурыТовары.Номенклатура КАК Номенклатура,
	|	ВариантыКомплектацииНоменклатурыТовары.Характеристика КАК Характеристика,
	|	ВариантыКомплектацииНоменклатурыТовары.Количество КАК Количество
	|ИЗ
	|	Справочник.ВариантыКомплектацииНоменклатуры.Товары КАК ВариантыКомплектацииНоменклатурыТовары
	|ГДЕ
	|	ВариантыКомплектацииНоменклатурыТовары.Ссылка.Владелец В (&НоменклатураНабора)
	|	И ВариантыКомплектацииНоменклатурыТовары.Ссылка.Характеристика В (&ХарактеристикаНабора)";
				
				
	Запрос.УстановитьПараметр("НоменклатураНабора", МассивНоменклатур.ВыгрузитьКолонку("НоменклатураНабора"));                            
	Запрос.УстановитьПараметр("ХарактеристикаНабора", МассивНоменклатур.ВыгрузитьКолонку("ХарактеристикаНабора"));
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Выборка = РезультатЗапроса.Выгрузить(); 
	
	Количество = Неопределено;
	
	Пока Выборка.Количество() > 0 Цикл   
		
		НайденныеСтроки = МассивНоменклатур.НайтиСтроки(Новый Структура("НоменклатураНабора,ХарактеристикаНабора", Выборка[0].НоменклатураНабора, Выборка[0].ХарактеристикаНабора)); 
		
		Если НайденныеСтроки.Количество() > 0 Тогда
			
			Для Каждого Строка Из НайденныеСтроки Цикл 
				
				СтрокиВыборки = Выборка.НайтиСтроки(Новый Структура("НоменклатураНабора,ХарактеристикаНабора", Строка.НоменклатураНабора,  Строка.ХарактеристикаНабора)); 				
				
				Для Каждого СтрокаВыборки Из СтрокиВыборки Цикл
					
					Если Строка.Номенклатура = СтрокаВыборки.Номенклатура И СтрокаВыборки.Характеристика = Строка.Характеристика Тогда 
						
						Если Количество = Неопределено Тогда
							Количество = Цел(Строка.Количество / СтрокаВыборки.Количество);
						Иначе
							Количество = Мин(Количество, Цел(Строка.Количество / СтрокаВыборки.Количество));	
						КонецЕсли; 
						
					КонецЕсли; 
					
				КонецЦикла;	  																									
				
			КонецЦикла;
			
			Для Каждого Строка Из НайденныеСтроки Цикл 
				МассивНоменклатур.Удалить(Строка);	
			КонецЦикла;
			
			НоваяСтрока = МассивНоменклатур.Добавить();
			НоваяСтрока.Номенклатура = Выборка[0].НоменклатураНабора;
			НоваяСтрока.Характеристика = Выборка[0].ХарактеристикаНабора;
			НоваяСтрока.Количество = Количество;
			
			Для Каждого СтрокаВыборки Из СтрокиВыборки Цикл 
				Выборка.Удалить(СтрокаВыборки);	
			КонецЦикла; 
			
		Иначе
			Выборка.Удалить(0);			
		КонецЕсли;
		
	КонецЦикла;
	
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ИС_WB_СоответствиеРазмеров.Номенклатура КАК Номенклатура,
	|	МАКСИМУМ(ИС_WB_ШтрихкодыРазмеров.Штрихкод) КАК Штрихкод,
	|	ИС_WB_СоответствиеРазмеров.Характеристика КАК Характеристика
	|ИЗ
	|	РегистрСведений.ИС_WB_СоответствиеРазмеров КАК ИС_WB_СоответствиеРазмеров
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ИС_WB_ШтрихкодыРазмеров КАК ИС_WB_ШтрихкодыРазмеров
	|		ПО (ИС_WB_СоответствиеРазмеров.РазмерWB = ИС_WB_ШтрихкодыРазмеров.Размер)
	|ГДЕ
	|	ИС_WB_СоответствиеРазмеров.Номенклатура В(&Номенклатура)
	|	И ИС_WB_СоответствиеРазмеров.Характеристика В(&Характеристика)
	|	И ИС_WB_СоответствиеРазмеров.Профиль = &Профиль
	|
	|СГРУППИРОВАТЬ ПО
	|	ИС_WB_СоответствиеРазмеров.Номенклатура,
	|	ИС_WB_СоответствиеРазмеров.Характеристика";
	
	Запрос.УстановитьПараметр("Номенклатура", МассивНоменклатур.ВыгрузитьКолонку("Номенклатура"));
	Запрос.УстановитьПараметр("Характеристика", МассивНоменклатур.ВыгрузитьКолонку("Характеристика"));
	Запрос.УстановитьПараметр("Профиль", Профиль);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Выборка = РезультатЗапроса.Выбрать();
	
	ТаблицаВыгрузки = Новый ТаблицаЗначений;
	ТаблицаВыгрузки.Колонки.Добавить("Баркод");
	ТаблицаВыгрузки.Колонки.Добавить("Количество");
	
	Пока Выборка.Следующий() Цикл
		
		НайденныеСтроки = МассивНоменклатур.НайтиСтроки(Новый Структура("Номенклатура,Характеристика", Выборка.Номенклатура, Выборка.Характеристика));
		
		Если НайденныеСтроки.Количество() > 0 Тогда  
			НоваяСтрока = ТаблицаВыгрузки.Добавить();
			НоваяСтрока.Баркод = Выборка.Штрихкод;
			НоваяСтрока.Количество = Окр(НайденныеСтроки[0].Количество, 0, РежимОкругления.Окр15как10);  
			МассивНоменклатур.Удалить(НайденныеСтроки[0]);
		КонецЕсли;
		
	КонецЦикла;
	
	Для Каждого Элемент Из МассивНоменклатур Цикл
		ОбщегоНазначения.СообщитьПользователю("Для номенклатуры: " + Элемент.Номенклатура + " не найдено сопоставление номенклатуры WB, она не будет добавлена в файл!");
	КонецЦикла;
	
	ТабличныйДокумент = Новый ТабличныйДокумент;
	
	Построитель = Новый ПостроительОтчета;
	Построитель.ИсточникДанных = Новый ОписаниеИсточникаДанных(ТаблицаВыгрузки); 
	Построитель.ВыводитьЗаголовокОтчета = Ложь;
	Построитель.Вывести(ТабличныйДокумент);
	
	ТабличныйДокумент.АвтоМасштаб = Истина;
	ТабличныйДокумент.УдалитьОбласть(ТабличныйДокумент.Область("R1C1:R100C1"), ТипСмещенияТабличногоДокумента.ПоГоризонтали);
	ТабличныйДокумент.Область("R1C1:R100C1").ШиринаКолонки = 20;
	ТабличныйДокумент.Область("R1C2:R100C2").ШиринаКолонки = 20;
	
	ДокументВыгрузки = ТабличныйДокумент;
	
КонецПроцедуры //- ИнфоСофт Ивонин К.А. 21.09.21 УА #38645

//+ ИнфоСофт Ивонин К.А. 27.09.21 УА #38645
&НаКлиенте
Процедура СохранитьФайл(Команда)

	Если Не ЗначениеЗаполнено(ПутьСохранения) Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю("Поле ""Путь сохранения"" не заполнено", , , "ПутьСохранения");
		Возврат;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(ИмяФайла) Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю("Поле ""Имя файла"" не заполнено!", , , "ИмяФайла");
		Возврат;
	КонецЕсли;
	
	Попытка
		ПутьСохраненияФайла = СтрШаблон("%1/%2.xlsx", ПутьСохранения, ИмяФайла);
		ДокументВыгрузки.Записать(ПутьСохраненияФайла, ТипФайлаТабличногоДокумента.XLSX);
		ОбщегоНазначенияКлиент.СообщитьПользователю("Файл " + ПутьСохраненияФайла + " успешно сохранен");
	Исключение
		ОбщегоНазначенияКлиент.СообщитьПользователю(ОписаниеОшибки());
	КонецПопытки;
	
КонецПроцедуры //- ИнфоСофт Ивонин К.А. 27.09.21 УА #38645

//+ ИнфоСофт Ивонин К.А. 27.09.21 УА #38645
&НаКлиенте
Процедура ПутьСохраненияНачалоВыбораЗавершение(Результат, ДополнительныеПараметры) Экспорт

	ДиалогВыбораФайла = ДополнительныеПараметры.ДиалогВыбораФайла;
    Если Результат = Неопределено Тогда
    	Возврат;
    КонецЕсли;
    
    Если ДиалогВыбораФайла.Каталог <> Неопределено Тогда   	
    	ПутьСохранения = ДиалогВыбораФайла.Каталог;			
    КонецЕсли;
        
КонецПроцедуры //- ИнфоСофт Ивонин К.А. 27.09.21 УА #38645

#КонецОбласти
