&НаСервере
Функция ПолучитьДанныеЗаголовкаИзФайла() 
	
	Если ЗначениеЗаполнено(АдресОтчетаВоВременномХранилище) Тогда
		
		Если РасширениеФайлаОтчетаZip Тогда  
			
			ФайлВременногоХранилища = ПолучитьИзВременногоХранилища(АдресОтчетаВоВременномХранилище); 
			Имя = ПолучитьИмяВременногоФайла("zip");
			ФайлВременногоХранилища.Записать(Имя);
			
			ВызватьОшибку = Истина;
			ТабличныйДокумент = ПрочитатьТабДокИзZIP(Имя, ВызватьОшибку);
			
			Если ВызватьОшибку Тогда
				ОбщегоНазначения.СообщитьПользователю("Был выбран некорректный файл для загрузки отчета комиссионера WildBerries, проверьте выбранный файл",,, "ПутьКФайлу");
				ОтменитьТранзакцию();
			КонецЕсли;
			
		Иначе
			
			ФайлВременногоХранилища = ПолучитьИзВременногоХранилища(АдресОтчетаВоВременномХранилище);
			Имя = ПолучитьИмяВременногоФайла("xlsx");
			ФайлВременногоХранилища.Записать(Имя);
			ТабличныйДокумент = Новый ТабличныйДокумент;
			ТабличныйДокумент.Прочитать(Имя);		
			
		КонецЕсли;
		
		ТабличныйДокумент.Область().Разъединить();
		
		Если РоссийскиеПродажи Тогда		
			Комментарий = ТабличныйДокумент.Область("R5C6").Текст;
			НомерДата = ТабличныйДокумент.Область("R5C7").Текст;
			НачалоПериода = ТабличныйДокумент.Область("R7C12").Текст;
			КонецПериода = ТабличныйДокумент.Область("R7C14").Текст;  
			
			ДатаДокумента = Дата(СтрЗаменить(СтрРазделить(НомерДата, " ")[2], "-", "") + "000000");
			Комментарий = Комментарий + НомерДата;      
			НачалоПериода = Дата(СтрЗаменить(НачалоПериода, "-", "") + "000000");
			КонецПериода = Дата(СтрЗаменить(КонецПериода, "-", "") + "000000");			
		Иначе
			Комментарий = ТабличныйДокумент.Область("R3C1").Текст;
			ВремДата = СтрЗаменить(СтрРазделить(Комментарий, " ")[5], ".", "");
			КаноническаяФорма = Сред(ВремДата, 5, 4) + Сред(ВремДата, 3, 2) + Сред(ВремДата, 1, 2) + "000000" ;  
			ДатаДокумента = Дата(КаноническаяФорма);
		КонецЕсли;
		
		Попытка
			УдалитьФайлы(Имя);
		Исключение
			ЗаписьЖурналаРегистрации(НСтр("ru = 'ИС.WB.ЗагрузитьОтчетКомиссионераНаСервере'"), УровеньЖурналаРегистрации.Ошибка, , , ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
			ОтменитьТранзакцию();
		КонецПопытки;   
		
	Иначе
		ДатаДокумента = ТекущаяДатаСеанса(); 
		Комментарий = Неопределено;
		НачалоПериода = Неопределено;
		КонецПериода = ТекущаяДатаСеанса();
		
	КонецЕсли;
	
	Результат = Новый Структура;
	
	Результат.Вставить("ДатаДокумента", ДатаДокумента);
	Результат.Вставить("Комментарий", Комментарий);
	Результат.Вставить("НачалоПериода", НачалоПериода);
	Результат.Вставить("КонецПериода", КонецПериода);
	Результат.Вставить("ЗагрузитьКодыМаркировкиВДокументРеализации", Ложь); 
	
	Возврат Результат;
		
КонецФункции //- ИнфоСофт Сумин Д.В. 03.03.23 УА #55086	

//+ ИнфоСофт Сумин Д.В. 03.03.23 УА #55086
&НаСервере
Функция ПолучитьТаблицуЗначенийПродажИзФайла()
	Если РасширениеФайлаДетализацииZip Тогда  
			
			ФайлВременногоХранилища = ПолучитьИзВременногоХранилища(АдресДетализацииВоВременномХранилище);
			Имя = ПолучитьИмяВременногоФайла("zip");
			ФайлВременногоХранилища.Записать(Имя);
			
			ВызватьОшибку = Истина;
			ТабличныйДокумент = ПрочитатьТабДокИзZIP(Имя, ВызватьОшибку);
							
			Если ВызватьОшибку Тогда
				ОбщегоНазначения.СообщитьПользователю(ПодробноеПредставлениеОшибки(ИнформацияОбОшибке())); 
				ОтменитьТранзакцию();
			КонецЕсли;
			
		Иначе     
			
			ФайлВременногоХранилища = ПолучитьИзВременногоХранилища(АдресДетализацииВоВременномХранилище);
			Имя = ПолучитьИмяВременногоФайла("xlsx");
			ФайлВременногоХранилища.Записать(Имя);
			ТабличныйДокумент = Новый ТабличныйДокумент;
			ТабличныйДокумент.Прочитать(Имя);
			
		КонецЕсли;
		
		ТабличныйДокумент.Область().Разъединить();
			
		ПоследняяСтрока = ТабличныйДокумент.ВысотаТаблицы;
		ПоследняяКолонка = ТабличныйДокумент.ШиринаТаблицы;
		
		ОбластьЯчеек = ТабличныйДокумент.Область(1, 1, ПоследняяСтрока, ПоследняяКолонка);
		ИсточникДанных = Новый ОписаниеИсточникаДанных(ОбластьЯчеек);
		
		ПостроительОтчета = Новый ПостроительОтчета;
		ПостроительОтчета.ИсточникДанных = ИсточникДанных;
		ПостроительОтчета.Выполнить();
		
		ТаблицаЗначений = ПостроительОтчета.Результат.Выгрузить();
		
		//+ ИнфоСофт Сумин Д.В. 07.11.2023 УА #65868
		МассивУдаляемыхСтрок = Новый Массив;
		Для Каждого Строка Из ТаблицаЗначений Цикл
			Если Строка.Баркод = "" Тогда
				МассивУдаляемыхСтрок.Добавить(Строка);	
			КонецЕсли;	
		КонецЦикла;
		
		Для Каждого Элемент Из МассивУдаляемыхСтрок Цикл
			ТаблицаЗначений.Удалить(Элемент);		
		КонецЦикла;	
		//- ИнфоСофт Сумин Д.В. 07.11.2023 УА #65868 
		
		Попытка
			УдалитьФайлы(Имя);
		Исключение
			ОбщегоНазначения.СообщитьПользователю(ПодробноеПредставлениеОшибки(ИнформацияОбОшибке())); 
			ОтменитьТранзакцию();
		КонецПопытки;  
		
		Возврат ТаблицаЗначений;
		
КонецФункции //- ИнфоСофт Сумин Д.В. 03.03.23 УА #55086	
	
//+ ИнфоСофт Ивонин К.А. 15.12.22 УА #52439
&НаСервере
Функция ПрочитатьТабДокИзZIP(ИмяФайла, Отказ)
		
	ТабличныйДокумент = Новый ТабличныйДокумент;
	
	ЧтениеZip = Новый ЧтениеZipФайла(ИмяФайла, "");
	
	Отказ = Истина;
	
	Для Каждого Элемент Из ЧтениеZip.Элементы Цикл
		
		Если Элемент.Расширение = "xlsx" Тогда
			Отказ = Ложь;
			ПутьКФайлуВоВременномКаталоге = КаталогВременныхФайлов();
			ЧтениеZip.Извлечь(Элемент, ПутьКФайлуВоВременномКаталоге, , "");					
			ПутьКФайлуВоВременномКаталоге = ПутьКФайлуВоВременномКаталоге + Элемент.Имя; 
			ТабличныйДокумент.Прочитать(ПутьКФайлуВоВременномКаталоге);
		КонецЕсли;
		
	КонецЦикла; 
	
	ЧтениеZip.Закрыть();
	
	Возврат ТабличныйДокумент;
	
КонецФункции //- ИнфоСофт Ивонин К.А. 15.12.22 УА #52439

