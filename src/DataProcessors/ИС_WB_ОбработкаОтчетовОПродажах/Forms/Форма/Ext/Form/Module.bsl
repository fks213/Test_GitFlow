&НаСервере
Функция СоздатьДокументСписанияТоваровКомиссионера(ДокОтчет, ПотериТЗ)
	
	ДокументСписания = Документы.ОтчетКомиссионераОСписании.СоздатьДокумент();
	
	ДокументСписания.Дата = ТекущаяДатаСеанса();
	
	ДокументСписания.Организация = ДокОтчет.Организация;
	
	ДокументСписания.Партнер = ДокОтчет.Партнер;
	
	ДокументСписания.Контрагент = ДокОтчет.Контрагент; 
	
	ДокументСписания.Соглашение = ДокОтчет.Соглашение;
	
	ДокументСписания.Валюта = ДокОтчет.Валюта;
	
	ДокументСписания.НалогообложениеНДС = ДокОтчет.НалогообложениеНДС;
	
	ДокументСписания.ЦенаВключаетНДС = ДокОтчет.ЦенаВключаетНДС;
	
	ДокументСписания.ДатаПлатежа = ТекущаяДатаСеанса();
	
	ДокументСписания.Договор = ДокОтчет.Договор; 
	
	ДокументСписания.ПорядокРасчетов = ДокОтчет.ПорядокРасчетов;
	
	ДокументСписания.ПорядокРасчетов = ДокОтчет.ПорядокРасчетов;
	
	Если ДокументСписания.НалогообложениеНДС = Перечисления.ТипыНалогообложенияНДС.ПродажаОблагаетсяНДС Тогда
		ПродажаОблагаетсяНДС = Истина;
	Иначе
		ПродажаОблагаетсяНДС = Ложь;
	КонецЕсли;	
		
	Для Каждого Элемент Из ПотериТЗ Цикл
		
		Если Элемент.ЭтоНабор Тогда
			ТоварыНабора = ИС_WB_СерверУТ11_5.ПолучитьТаблицуТоваровНабораNew(Элемент.Номенклатура, Элемент.Характеристика, Профиль);  
			
			Если ТоварыНабора[0].ВариантРасчетаЦены = Перечисления.ВариантыРасчетаЦенНаборов.РассчитываетсяИзЦенКомплектующих Или
				ТоварыНабора[0].ВариантРасчетаЦены = Перечисления.ВариантыРасчетаЦенНаборов.ЦенаЗадаетсяЗаНаборРаспределяетсяПоЦенам Тогда
				
				МассивКоэффициентов = ИС_WB_СерверУТ11_5.РассчитатьКоэффициентыИзЦен(ТоварыНабора.ВыгрузитьКолонку("КомплектующиеЦена"), Элемент.Номенклатура);
			Иначе
				МассивКоэффициентов = ТоварыНабора.ВыгрузитьКолонку("ДоляСтоимости");
			КонецЕсли;
			
			СуммыПродажи = ОбщегоНазначения.РаспределитьСуммуПропорциональноКоэффициентам(Элемент.Сумма, МассивКоэффициентов);
				
	  		Для Каждого ЭлементНабора Из ТоварыНабора Цикл 
				
				НоваяСтрока = ДокументСписания.Товары.Добавить();
				
				НоваяСтрока.Номенклатура = ЭлементНабора.Номенклатура;
				НоваяСтрока.Характеристика = ЭлементНабора.Характеристика;
				НоваяСтрока.Количество = ЭлементНабора.КоличествоУпаковок;
				НоваяСтрока.КоличествоУпаковок = ЭлементНабора.КоличествоУпаковок;
								
				НоваяСтрока.Цена = СуммыПродажи[0] / ЭлементНабора.КоличествоУпаковок;
				НоваяСтрока.Сумма = СуммыПродажи[0];
				НоваяСтрока.СуммаСНДС = СуммыПродажи[0];			 
				НоваяСтрока.СтавкаНДС = ЭлементНабора.Номенклатура.СтавкаНДС;
				НоваяСтрока.Упаковка = ЭлементНабора.Упаковка;
				
				СуммыПродажи.Удалить(0);
	
			КонецЦикла;	
		Иначе	
			НоваяСтрока = ДокументСписания.Товары.Добавить();
			НоваяСтрока.Номенклатура = Элемент.Номенклатура;
			НоваяСтрока.Характеристика = Элемент.Характеристика;
			НоваяСтрока.Упаковка = Элемент.Упаковка;
			НоваяСтрока.КоличествоУпаковок = 1;
			Если Элемент.Упаковка.Числитель = 0 Тогда
				НоваяСтрока.Количество = 1;	
			Иначе	
				НоваяСтрока.Количество = Элемент.Упаковка.Числитель; 
			КонецЕсли;
			НоваяСтрока.Цена = Элемент.Сумма;
			НоваяСтрока.Сумма = Элемент.Сумма;
			НоваяСтрока.СуммаСНДС = Элемент.Сумма;
			НоваяСтрока.СтавкаНДС = Элемент.Номенклатура.СтавкаНДС;
		КонецЕсли;
	КонецЦикла;	
	
	Если ПродажаОблагаетсяНДС Тогда 
		СтруктураДействий = Новый Структура;
		СтруктураДействий.Вставить("ПересчитатьСуммуНДС", ОбработкаТабличнойЧастиКлиентСервер.ПараметрыПересчетаСуммыНДСВСтрокеТЧ(ДокументСписания));	
		ОбработкаТабличнойЧастиСервер.ОбработатьТЧ(ДокументСписания.Товары, СтруктураДействий, Неопределено);	
	КонецЕсли;	
	
	ДокументСписания.Записать(РежимЗаписиДокумента.Запись);
	
	ДобавитьДокументВРезультирующуюТЧ(ДокументСписания.Ссылка);
	
КонецФункции //- ИнфоСофт Сумин Д.В. 30.11.2023 УА #63730	

//+ ИнфоСофт Мурсалимов Д.Р. 14.12.23 УА #64799
&НаКлиенте
Процедура ПодобратьПоАртикулу(Команда)
	
	ПодобратьПоАртикулуНаСервере(Элементы.Отчеты.ТекущаяСтраница.Имя);	
	
КонецПроцедуры //- ИнфоСофт Мурсалимов Д.Р. 14.12.23 УА #64799  

//+ ИнфоСофт Мурсалимов Д.Р. 14.12.23 УА #64799
&НаСервере
Процедура ПодобратьПоАртикулуНаСервере(Отчеты)
	
	ТЗРезультирующая = Новый ТаблицаЗначений;
	
	//+ ИнфоСофт Мурсалимов Д.Р. 28.03.24 УА #72971
	ТЗРезультирующая.Колонки.Добавить("Артикул", Новый ОписаниеТипов("Строка", , Новый КвалификаторыСтроки(50)));
	ТЗРезультирующая.Колонки.Добавить("Размер", Новый ОписаниеТипов("Строка", , Новый КвалификаторыСтроки(50)));
	//- ИнфоСофт Мурсалимов Д.Р. 28.03.24 УА #72971
		
	Если Отчеты = "РоссийскиеПродажи" Тогда  
		
		ТаблицаСопоставления = СписокТранзакцийExcelWB;
		
	ИначеЕсли Отчеты = "ИностранныеПродажи" Тогда 
		
		ТаблицаСопоставления = СписокТранзакцийExcelWBИн;
		
	Иначе      
		
		ТаблицаСопоставления = СписокТранзакцийExcelWB; 
		
	КонецЕсли;
	
	Для Каждого Строка Из ТаблицаСопоставления Цикл
		
		Если Не ЗначениеЗаполнено(Строка.Номенклатура) Тогда
			
			НоваяСтрока = ТЗРезультирующая.Добавить();
			//+ ИнфоСофт Мурсалимов Д.Р. 27.03.24 УА #72971
			НоваяСтрока.Артикул = СокрЛП(Строка.Артикул);
			НоваяСтрока.Размер = СокрЛП(Строка.РазмерПоставщика);
			//- ИнфоСофт Мурсалимов Д.Р. 27.03.24 УА #72971
			
		КонецЕсли;	
		
	КонецЦикла;
	
	ТЗРезультирующая.Свернуть("Артикул, Размер");
	
	Если ТЗРезультирующая.Количество() = 0 Тогда
		
		ОбщегоНазначения.СообщитьПользователю("Нет данных для обработки!"); 
		Возврат;
		
	КонецЕсли;
		
	Запрос = Новый Запрос;
	
	Запрос.Текст = 	
	"ВЫБРАТЬ
	|	ДанныеТЗ.Артикул КАК Артикул,
	|	ДанныеТЗ.Размер КАК Размер
	|ПОМЕСТИТЬ ВТ_ДанныеТЗ
	|ИЗ
	|	&ТЗРезультирующая КАК ДанныеТЗ
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ИС_WB_Номенклатура.Ссылка КАК Ссылка,
	|	ВТ_ДанныеТЗ.Артикул КАК Артикул,
	|	ВТ_ДанныеТЗ.Размер КАК Размер
	|ПОМЕСТИТЬ ВТ_Номенклатура
	|ИЗ
	|	Справочник.ИС_WB_Номенклатура КАК ИС_WB_Номенклатура
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_ДанныеТЗ КАК ВТ_ДанныеТЗ
	|		ПО ИС_WB_Номенклатура.vendorCode = ВТ_ДанныеТЗ.Артикул
	|ГДЕ
	|	ИС_WB_Номенклатура.Профиль = &Профиль
	|	И НЕ ВТ_ДанныеТЗ.Размер ЕСТЬ NULL
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_Номенклатура.Ссылка КАК НоменклатураWB,
	|	ВТ_Номенклатура.Артикул КАК Артикул,
	|	ВЫБОР
	|		КОГДА КОЛИЧЕСТВО(ИС_WB_РазмерыНоменклатур.techSize) > 1
	|			ТОГДА ВТ_Номенклатура.Размер
	|		ИНАЧЕ ИС_WB_РазмерыНоменклатур.techSize
	|	КОНЕЦ КАК Размер
	|ПОМЕСТИТЬ ВТ_РазмерНоменклатуры
	|ИЗ
	|	ВТ_Номенклатура КАК ВТ_Номенклатура
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ИС_WB_РазмерыНоменклатур КАК ИС_WB_РазмерыНоменклатур
	|		ПО (ИС_WB_РазмерыНоменклатур.Владелец = ВТ_Номенклатура.Ссылка)
	|			И (ИС_WB_РазмерыНоменклатур.Профиль = &Профиль)
	|
	|СГРУППИРОВАТЬ ПО
	|	ВТ_Номенклатура.Ссылка,
	|	ИС_WB_РазмерыНоменклатур.techSize,
	|	ВТ_Номенклатура.Размер,
	|	ВТ_Номенклатура.Артикул
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ 
	|	ВТ_РазмерНоменклатуры.Артикул КАК Артикул, 
	|	ВТ_РазмерНоменклатуры.Размер КАК Размер,
	|	ИС_WB_СоответствиеРазмеров.Номенклатура КАК Номенклатура,
	|	ЕСТЬNULL(ИС_WB_СоответствиеРазмеров.Характеристика, ЗНАЧЕНИЕ(Справочник.ХарактеристикиНоменклатуры.ПустаяСсылка)) КАК Характеристика,
	|	ВЫБОР
	|		КОГДА ИС_WB_СоответствиеРазмеров.Номенклатура.ТипНоменклатуры = ЗНАЧЕНИЕ(Перечисление.ТипыНоменклатуры.Набор)
	|			ТОГДА ИСТИНА
	|		ИНАЧЕ ЛОЖЬ
	|	КОНЕЦ КАК ЭтоНабор
	|ПОМЕСТИТЬ ВТ_Результирующая
	|ИЗ
	|	ВТ_РазмерНоменклатуры КАК ВТ_РазмерНоменклатуры
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ИС_WB_РазмерыНоменклатур КАК ИС_WB_РазмерыНоменклатур
	|		ПО ВТ_РазмерНоменклатуры.НоменклатураWB = ИС_WB_РазмерыНоменклатур.Владелец
	|			И ВТ_РазмерНоменклатуры.Размер = ИС_WB_РазмерыНоменклатур.techSize
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ИС_WB_СоответствиеРазмеров КАК ИС_WB_СоответствиеРазмеров
	|		ПО (ИС_WB_РазмерыНоменклатур.Ссылка = ИС_WB_СоответствиеРазмеров.РазмерWB)
	|			И (ИС_WB_СоответствиеРазмеров.Профиль = &Профиль)
	|ГДЕ
	|	ИС_WB_РазмерыНоменклатур.Профиль = &Профиль
	|	И НЕ ИС_WB_РазмерыНоменклатур.ПометкаУдаления
	|	И НЕ ИС_WB_СоответствиеРазмеров.Номенклатура ЕСТЬ NULL
	|;
	|
	|//////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	МАКСИМУМ(ВЫБОР
	|			КОГДА ШтрихкодыНоменклатуры.Упаковка = ЗНАЧЕНИЕ(Справочник.УпаковкиЕдиницыИзмерения.ПустаяСсылка)
	|					ИЛИ ШтрихкодыНоменклатуры.Упаковка ЕСТЬ NULL
	|				ТОГДА ВТ_Результирующая.Номенклатура.ЕдиницаИзмерения
	|			ИНАЧЕ ШтрихкодыНоменклатуры.Упаковка
	|		КОНЕЦ) КАК Упаковка,
	|	ВЫБОР
	|		КОГДА МАКСИМУМ(ЕСТЬNULL(ШтрихкодыНоменклатуры.Упаковка.Числитель, 1)) = 0
	|			ТОГДА 1
	|		ИНАЧЕ МАКСИМУМ(ЕСТЬNULL(ШтрихкодыНоменклатуры.Упаковка.Числитель, 1))
	|	КОНЕЦ КАК КоличествоВУпаковке,
	|	ШтрихкодыНоменклатуры.Номенклатура КАК Номенклатура,
	|	ШтрихкодыНоменклатуры.Характеристика КАК Характеристика
	|ПОМЕСТИТЬ ВТ_Упаковка
	|ИЗ
	|	ВТ_Результирующая КАК ВТ_Результирующая
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ШтрихкодыНоменклатуры КАК ШтрихкодыНоменклатуры
	|		ПО (ШтрихкодыНоменклатуры.Номенклатура = ВТ_Результирующая.Номенклатура)
	|			И (ШтрихкодыНоменклатуры.Характеристика = ВТ_Результирующая.Характеристика)
	|
	|СГРУППИРОВАТЬ ПО
	|	ШтрихкодыНоменклатуры.Номенклатура,
	|	ШтрихкодыНоменклатуры.Характеристика
	|;
	|
	|//////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_Результирующая.Номенклатура КАК Номенклатура,
	|	ВТ_Результирующая.Характеристика КАК Характеристика, 
	|	ВТ_Результирующая.Артикул КАК Артикул,   
	|	ВТ_Результирующая.Размер КАК РазмерПоставщика,
	|	ВТ_Результирующая.ЭтоНабор КАК ЭтоНабор,
	|	ЕСТЬNULL(ВТ_Упаковка.Упаковка, ВТ_Результирующая.Номенклатура.ЕдиницаИзмерения) КАК Упаковка,
	|	ЕСТЬNULL(ВТ_Упаковка.КоличествоВУпаковке, 1) КАК КоличествоВУпаковке
	|ИЗ
	|	ВТ_Результирующая КАК ВТ_Результирующая
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_Упаковка КАК ВТ_Упаковка
	|		ПО ВТ_Результирующая.Номенклатура = ВТ_Упаковка.Номенклатура
	|			И ВТ_Результирующая.Характеристика = ВТ_Упаковка.Характеристика";

	Запрос.УстановитьПараметр("Профиль", Профиль);
	Запрос.УстановитьПараметр("ТЗРезультирующая", ТЗРезультирующая);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Выборка = РезультатЗапроса.Выбрать();
	
	Пока Выборка.Следующий() Цикл
		
		НайденныеСтроки = ТаблицаСопоставления.НайтиСтроки(Новый Структура("Артикул", Выборка.Артикул));
		
		Для Каждого Элемент Из НайденныеСтроки Цикл
			
			Если Не ЗначениеЗаполнено(Элемент.Номенклатура) Тогда
				
				ЗаполнитьЗначенияСвойств(Элемент, Выборка, "Номенклатура,Характеристика,Упаковка,ЭтоНабор,РазмерПоставщика");
	
				Если Отчеты = "РоссийскиеПродажи" Тогда  
					
					Элемент.КоличествоВУпаковке = Выборка.КоличествоВУпаковке;
	
				Иначе      
					
					Элемент.УпаковкаКоличество = Выборка.КоличествоВУпаковке; 
					
				КонецЕсли;	
								
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЦикла;
	
КонецПроцедуры //- ИнфоСофт Мурсалимов Д.Р. 14.12.23 УА #64799

//+ ИнфоСофт Сумин Д.В. 04.03.23 УА #55086
&Насервере
Функция ПолучитьДанныеПоЛогистике(Профиль, Логистика)
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	ИС_WB_НаименованиеУслугИзОтчетаWildberries.Номенклатура КАК Номенклатура,
	|	ИС_WB_НаименованиеУслугИзОтчетаWildberries.СтатьяРасходов КАК СтатьяРасходов,
	|	ИС_WB_НаименованиеУслугИзОтчетаWildberries.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.ИС_WB_НаименованиеУслугИзОтчетаWildberries КАК ИС_WB_НаименованиеУслугИзОтчетаWildberries
	|ГДЕ
	|	ИС_WB_НаименованиеУслугИзОтчетаWildberries.НаименованиеУслугиИзОтчета = ""Стоимость услуг Вайлдберриз по организации международной перевозки"""; 
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Если РезультатЗапроса.Пустой() Тогда
		ВызватьИсключение("Необходимо корректно заполнить справочник: ""Наименование услуг Wildberries"". Не найдена услуга по доставке.");	
	КонецЕсли;	
	
	Выборка = РезультатЗапроса.Выбрать();
	
	Выборка.Следующий();
	
	ДанныеЛогистики = Новый ТаблицаЗначений;
	
	ДанныеЛогистики.Колонки.Добавить("УслугаWildberries", Новый ОписаниеТипов("СправочникСсылка.ИС_WB_НаименованиеУслугИзОтчетаWildberries")); 
	ДанныеЛогистики.Колонки.Добавить("Сумма", Новый ОписаниеТипов("Число"));
	ДанныеЛогистики.Колонки.Добавить("НДС", Новый ОписаниеТипов("Число"));
	ДанныеЛогистики.Колонки.Добавить("Номенклатура", Новый ОписаниеТипов("СправочникСсылка.Номенклатура"));
	ДанныеЛогистики.Колонки.Добавить("СтатьяРасходов", Новый ОписаниеТипов("ПланВидовХарактеристикСсылка.СтатьиРасходов"));
	ДанныеЛогистики.Колонки.Добавить("СтавкаНДС", Новый ОписаниеТипов("СправочникСсылка.СтавкиНДС"));
	
	СтрокаТЗ = ДанныеЛогистики.Добавить();
	
	СтрокаТЗ.УслугаWildberries = Выборка.Ссылка;
	СтрокаТЗ.Сумма = Логистика;
	СтрокаТЗ.Номенклатура = Выборка.Номенклатура; 
	СтрокаТЗ.СтатьяРасходов = Выборка.СтатьяРасходов;
	
	ОблагаетсяНДС = ИС_WB_СерверУТ11_5.ПолучитьРезультатПроверкиУчетаНДС(Профиль.Организация); 
	
	Если ОблагаетсяНДС Тогда
		СтрокаТЗ.НДС = ИС_WB_СерверУТ11_5.РассчитатьСуммуНДС(Логистика, 20, Истина);
		СтрокаТЗ.СтавкаНДС = Справочники.СтавкиНДС.НайтиПоНаименованию("20%");
	Иначе
		СтрокаТЗ.НДС = 0;
		СтрокаТЗ.СтавкаНДС = Справочники.СтавкиНДС.НайтиПоНаименованию("Без НДС");	
	КонецЕсли;
	
	Возврат ДанныеЛогистики;
	
