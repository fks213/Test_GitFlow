&НаСервере
Функция ВыполнитьГруппировкуПоНоменклатуре(ДанныеДляДокумента)  
	
	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	Данные.Номенклатура КАК Номенклатура,
	|	Данные.Характеристика КАК Характеристика,
	|	Данные.Упаковка КАК Упаковка,
	|	Данные.Количество КАК Количество,
	|	Данные.ЦенаРозничная КАК ЦенаРозничная,
	|	Данные.СуммаПродажи КАК СуммаПродажи,
	|	Данные.ЦенаПродажи КАК ЦенаПродажи,
	|	Данные.Размер КАК Размер,
	|	Данные.ЭтоНабор КАК ЭтоНабор,
	|	Данные.Название КАК Название,
	|	Данные.Баркод КАК Баркод,
	|	Данные.Номер КАК Номер,
	|	Данные.Код КАК Код,
	|	Данные.КоличествоВУпаковке КАК КоличествоВУпаковке
	|ПОМЕСТИТЬ ВТ_Данные
	|ИЗ
	|	&Данные КАК Данные
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_Данные.Номенклатура КАК Номенклатура,
	|	ВТ_Данные.Характеристика КАК Характеристика,
	|	МАКСИМУМ(ВТ_Данные.Упаковка) КАК Упаковка,
	|	СУММА(ВТ_Данные.Количество) КАК Количество,
	|	МАКСИМУМ(ВТ_Данные.ЦенаРозничная) КАК ЦенаРозничная,
	|	СУММА(ВТ_Данные.СуммаПродажи) КАК СуммаПродажи,
	|	МАКСИМУМ(ВТ_Данные.ЦенаПродажи) КАК ЦенаПродажи,
	|	МАКСИМУМ(ВТ_Данные.ЭтоНабор) КАК ЭтоНабор,
	|	МАКСИМУМ(ВТ_Данные.КоличествоВУпаковке) КАК КоличествоВУпаковке
	|ИЗ
	|	ВТ_Данные КАК ВТ_Данные
	|
	|СГРУППИРОВАТЬ ПО
	|	ВТ_Данные.Номенклатура,
	|	ВТ_Данные.Характеристика");
	
	Запрос.УстановитьПараметр("Данные", ДанныеДляДокумента);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ДанныеДляДокумента = РезультатЗапроса.Выгрузить();
	
	МассивУдаляемыхСтрока = Новый Массив;
	
	Для Каждого Строка Из ДанныеДляДокумента Цикл
		Если Строка.Количество = 0 Тогда
			МассивУдаляемыхСтрока.Добавить(Строка);	
		КонецЕсли;	
	КонецЦикла;
	
	Для Каждого Элемент Из МассивУдаляемыхСтрока Цикл
		ДанныеДляДокумента.Удалить(Элемент);	
	КонецЦикла;
	
	Возврат ДанныеДляДокумента;
	
КонецФункции //- ИнфоСофт Сумин Д.В. 23.11.2023 УА #64595

