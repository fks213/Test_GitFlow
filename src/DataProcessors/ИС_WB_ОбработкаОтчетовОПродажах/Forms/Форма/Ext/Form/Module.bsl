//+ ИнфоСофт Мурсалимов Д.Р. 12.12.24 УА #67818
&НаСервере
Процедура ЗагрузитьОтчетКомисисонераПоApiНаСервере() 
	
	Попытка
		
		ДатаНачала 	= НачалоДня(ПериодДляЗагрузки.ДатаНачала);
		ДатаКонца 	= КонецДня(ПериодДляЗагрузки.ДатаОкончания);
		
		ДанныеОК 	= ИС_WB_Сервер.ПолучитьДанныеОК(Профиль, ДатаНачала, ДатаКонца);
		
		НомерДокументаРФ = 0;
		НомерДокументаИн = 0;
		
		Для Каждого Элемент Из ДанныеОК.Тип Цикл
			
			Если Элемент.Российский Тогда
				НомерДокументаРФ = Элемент.Номер;
			Иначе
				НомерДокументаИн = Элемент.номер;	
			КонецЕсли;
			
		КонецЦикла;
		
		ДанныеОкРФ = ПолучитьТаблицуЗначенийДанныхПродаж(НомерДокументаРФ, ДанныеОК.Таблица);
		
		ДанныеОкИн = ПолучитьТаблицуЗначенийДанныхПродаж(НомерДокументаИн, ДанныеОК.Таблица); 
		
		Запрос = Новый Запрос;
		
		Запрос.Текст = ИС_WB_Сервер.ПолучитьТекстЗапросаОК();
		
		Запрос.УстановитьПараметр("ДанныеТЗ", 	ДанныеОкРФ);
		Запрос.УстановитьПараметр("Профиль", 	Профиль);
		
		РезультатЗапроса = Запрос.Выполнить();
		
		ДанныеДляДокумента = РезультатЗапроса.Выгрузить(); 
		
		ДанныеДляДокумента = ПодобратьПоАртикулуApiНаСервере(ДанныеДляДокумента);
		
		ЗаголовокСтруктура = Новый Структура;
		
		Комментарий = "Отчет  Вайлдберриз №" + Строка(НомерДокументаРФ) + " от " + Формат(ДатаКонца, "ДФ=dd.MM.yyyy"); 
		
		ЗаголовокСтруктура.Вставить("ДатаДокумента", 		ПериодДляЗагрузки.ДатаНачала);
		ЗаголовокСтруктура.Вставить("Комментарий", 			Комментарий);
		ЗаголовокСтруктура.Вставить("НачалоПериода", 		ПериодДляЗагрузки.ДатаНачала);
		ЗаголовокСтруктура.Вставить("КонецПериода", 		ПериодДляЗагрузки.ДатаОкончания);  
		
		ДанныеВВ = Новый Структура;  
		ДанныеВВ.Вставить("РассчитыватьВВ", Ложь);
		
		ЗаголовокСтруктура.Вставить("ДанныеВВ", 			ДанныеВВ);
		
		МассивПараметров = Новый Массив;
		
		МассивПараметров.Добавить("WildBerriesСтатьяЗадолженности");
		
		Настройки = ИС_MP_Сервер.ПолучитьНастройки(Профиль, МассивПараметров);
		
		СтатьяЗадолженности = ПланыВидовХарактеристик.СтатьиРасходов.ПустаяСсылка();
		
		Если Настройки <> Неопределено Тогда
			
			Если Настройки["WildBerriesСтатьяЗадолженности"] <> Неопределено Тогда
				СтатьяЗадолженности = Настройки["WildBerriesСтатьяЗадолженности"];       
			КонецЕсли;
			
		КонецЕсли;
		
		ЗаголовокСтруктура.Вставить("СтатьяЗадолженности",	СтатьяЗадолженности);
		
		//+ ИнфоСофт Заварин К.В. 21.02.25 УА #94295
 		Если ДанныеДляДокумента = Неопределено Тогда
			Возврат;
		КонецЕсли;
		//- ИнфоСофт Заварин К.В. 21.02.25 УА #94295
		
		ДокОтчет = ИС_WB_Сервер.СоздатьОтчетКомиссионера(ДанныеДляДокумента, Профиль, ЗаголовокСтруктура);
		ДобавитьДокументВРезультирующуюТЧ(ДокОтчет.Ссылка);
		
		//Создание документа корреткировки задолженности по браку
		Взаимозачет = Неопределено;
		
		Если ДанныеОК.Брак > 0 Тогда
			Взаимозачет = ИС_WB_СерверУТ11_5.ПолучитьДокументКорректировкиЗадолженности(ЗаголовокСтруктура, ДокОтчет.Ссылка, ДанныеОК.Брак);
			ДобавитьДокументВРезультирующуюТЧ(Взаимозачет.Ссылка);
		КонецЕсли;
		
	Исключение 
		ОбщегоНазначения.СообщитьПользователю(ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));		
	КонецПопытки;
	
КонецПроцедуры //- ИнфоСофт Мурсалимов Д.Р. 12.12.24 УА #67818

//+ ИнфоСофт Мурсалимов Д.Р. 12.12.24 УА #67818
&НаСервере
Функция ПодобратьПоАртикулуApiНаСервере(СписокТранзакций)
	
	ТЗРезультирующая = Новый ТаблицаЗначений;
	
	ТЗРезультирующая.Колонки.Добавить("Артикул", 	Новый ОписаниеТипов("Строка", , Новый КвалификаторыСтроки(50)));
	ТЗРезультирующая.Колонки.Добавить("Размер", 	Новый ОписаниеТипов("Строка", , Новый КвалификаторыСтроки(50)));
		
	ТаблицаСопоставления = СписокТранзакций;  
		
	Для Каждого Строка Из ТаблицаСопоставления Цикл
		
		Если Не ЗначениеЗаполнено(Строка.Номенклатура) Тогда
			
			НоваяСтрока = ТЗРезультирующая.Добавить();
			
			ЗаполнитьЗначенияСвойств(НоваяСтрока, Строка);
			
		КонецЕсли;	
		
	КонецЦикла;
	
	ТЗРезультирующая.Свернуть("Артикул, Размер");
	
	Если ТЗРезультирующая.Количество() = 0 Тогда		
		ОбщегоНазначения.СообщитьПользователю("Нет данных для обработки!"); 
		Возврат Неопределено;		
	КонецЕсли;
		
	Запрос = Новый Запрос;
	
	Запрос.Текст = 	
	"ВЫБРАТЬ
	|	ДанныеТЗ.Артикул КАК Артикул,
	|	ДанныеТЗ.Размер КАК Размер
	|ПОМЕСТИТЬ ВТ_ДанныеТЗ
	|ИЗ
	|	&ТЗРезультирующая КАК ДанныеТЗ
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ИС_WB_Номенклатура.Ссылка КАК Ссылка,
	|	ВТ_ДанныеТЗ.Артикул КАК Артикул,
	|	ВТ_ДанныеТЗ.Размер КАК Размер
	|ПОМЕСТИТЬ ВТ_Номенклатура
	|ИЗ
	|	Справочник.ИС_WB_Номенклатура КАК ИС_WB_Номенклатура
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_ДанныеТЗ КАК ВТ_ДанныеТЗ
	|		ПО ИС_WB_Номенклатура.vendorCode = ВТ_ДанныеТЗ.Артикул
	|ГДЕ
	|	ИС_WB_Номенклатура.Профиль = &Профиль
	|	И НЕ ВТ_ДанныеТЗ.Размер ЕСТЬ NULL
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_Номенклатура.Ссылка КАК НоменклатураWB,
	|	ВТ_Номенклатура.Артикул КАК Артикул,
	|	ВЫБОР
	|		КОГДА КОЛИЧЕСТВО(ИС_WB_РазмерыНоменклатур.techSize) > 1
	|			ТОГДА ВТ_Номенклатура.Размер
	|		ИНАЧЕ ИС_WB_РазмерыНоменклатур.techSize
	|	КОНЕЦ КАК Размер
	|ПОМЕСТИТЬ ВТ_РазмерНоменклатуры
	|ИЗ
	|	ВТ_Номенклатура КАК ВТ_Номенклатура
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ИС_WB_РазмерыНоменклатур КАК ИС_WB_РазмерыНоменклатур
	|		ПО (ИС_WB_РазмерыНоменклатур.Владелец = ВТ_Номенклатура.Ссылка)
	|			И (ИС_WB_РазмерыНоменклатур.Профиль = &Профиль)
	|
	|СГРУППИРОВАТЬ ПО
	|	ВТ_Номенклатура.Ссылка,
	|	ИС_WB_РазмерыНоменклатур.techSize,
	|	ВТ_Номенклатура.Размер,
	|	ВТ_Номенклатура.Артикул
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ 
	|	ВТ_РазмерНоменклатуры.Артикул КАК Артикул, 
	|	ВТ_РазмерНоменклатуры.Размер КАК Размер,
	|	ИС_WB_СоответствиеРазмеров.Номенклатура КАК Номенклатура,
	|	ЕСТЬNULL(ИС_WB_СоответствиеРазмеров.Характеристика, ЗНАЧЕНИЕ(Справочник.ХарактеристикиНоменклатуры.ПустаяСсылка)) КАК Характеристика,
	|	ВЫБОР
	|		КОГДА ИС_WB_СоответствиеРазмеров.Номенклатура.ТипНоменклатуры = ЗНАЧЕНИЕ(Перечисление.ТипыНоменклатуры.Набор)
	|			ТОГДА ИСТИНА
	|		ИНАЧЕ ЛОЖЬ
	|	КОНЕЦ КАК ЭтоНабор,
	|	ИС_WB_СоответствиеРазмеров.Упаковка КАК Упаковка,
	|	ВЫБОР
	|		КОГДА ИС_WB_СоответствиеРазмеров.Упаковка ЕСТЬ NULL ИЛИ ИС_WB_СоответствиеРазмеров.Упаковка.Числитель = 0
	|			ТОГДА 1
	|		ИНАЧЕ ИС_WB_СоответствиеРазмеров.Упаковка.Числитель
	|	КОНЕЦ / ВЫБОР
	|		КОГДА ИС_WB_СоответствиеРазмеров.Упаковка ЕСТЬ NULL ИЛИ ИС_WB_СоответствиеРазмеров.Упаковка.Знаменатель = 0
	|			ТОГДА 1
	|		ИНАЧЕ ИС_WB_СоответствиеРазмеров.Упаковка.Знаменатель
	|	КОНЕЦ КАК КоэффициентУпаковки
	|ПОМЕСТИТЬ ВТ_Результирующая
	|ИЗ
	|	ВТ_РазмерНоменклатуры КАК ВТ_РазмерНоменклатуры
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ИС_WB_РазмерыНоменклатур КАК ИС_WB_РазмерыНоменклатур
	|		ПО ВТ_РазмерНоменклатуры.НоменклатураWB = ИС_WB_РазмерыНоменклатур.Владелец
	|			И ВТ_РазмерНоменклатуры.Размер = ИС_WB_РазмерыНоменклатур.techSize
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ИС_WB_СоответствиеРазмеров КАК ИС_WB_СоответствиеРазмеров
	|		ПО (ИС_WB_РазмерыНоменклатур.Ссылка = ИС_WB_СоответствиеРазмеров.РазмерWB)
	|			И (ИС_WB_СоответствиеРазмеров.Профиль = &Профиль)
	|ГДЕ
	|	ИС_WB_РазмерыНоменклатур.Профиль = &Профиль
	|	И НЕ ИС_WB_РазмерыНоменклатур.ПометкаУдаления
	|	И НЕ ИС_WB_СоответствиеРазмеров.Номенклатура ЕСТЬ NULL
	|;
	|
	|//////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_Результирующая.Номенклатура КАК Номенклатура,
	|	ВТ_Результирующая.Характеристика КАК Характеристика, 
	|	ВТ_Результирующая.Артикул КАК АртикулПоставщика,   
	|	ВТ_Результирующая.Размер КАК Размер,
	|	ВТ_Результирующая.ЭтоНабор КАК ЭтоНабор,
	|	ВТ_Результирующая.Упаковка КАК Упаковка,
	|	ВТ_Результирующая.КоэффициентУпаковки КАК КоэффициентУпаковки
	|ИЗ
	|	ВТ_Результирующая КАК ВТ_Результирующая";
	
	Запрос.УстановитьПараметр("Профиль", 			Профиль);
	Запрос.УстановитьПараметр("ТЗРезультирующая", 	ТЗРезультирующая);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Выборка = РезультатЗапроса.Выбрать();
	
	Пока Выборка.Следующий() Цикл
		
		НайденныеСтроки = ТаблицаСопоставления.НайтиСтроки(Новый Структура("Артикул", Выборка.АртикулПоставщика));
		
		Для Каждого Элемент Из НайденныеСтроки Цикл
			
			Если Не ЗначениеЗаполнено(Элемент.Номенклатура) Тогда
				
				ЗаполнитьЗначенияСвойств(Элемент, Выборка, "Номенклатура,Характеристика,Упаковка,КоэффициентУпаковки,ЭтоНабор,Размер");   
					
				Элемент.КоэффициентУпаковки = Выборка.КоэффициентУпаковки; 
					
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЦикла;
	
	СписокТранзакций.Сортировать("Номенклатура");
	
	Возврат СписокТранзакций;
		
КонецФункции //- ИнфоСофт Мурсалимов Д.Р. 12.12.24 УА #67818

//+ ИнфоСофт Мурсалимов Д.Р. 14.12.24 УА #67818
&НаСерверебезКонтекста
Функция ПолучитьТаблицуЗначенийДанныхПродаж(Номер, Таблица)
	
	Отбор = Новый Структура();
	Отбор.Вставить("Номер", Номер);
	
	ДанныеТЗ = Таблица.Скопировать(Отбор);
	
	Возврат ДанныеТЗ;
	
КонецФункции //- ИнфоСофт Мурсалимов Д.Р. 14.12.24 УА #67818 

//+ ИнфоСофт Сумин Д.В. 06.07.2023 УА #60267
&НаСервере
Процедура ЗагрузитьОтчетКомисисонераИзФайлаНаСервере()  
	
	//+ ИнфоСофт Сумин Д.В. 01.08.2023 УА #61489
	УстановитьПривилегированныйРежим(Истина);
	//- ИнфоСофт Сумин Д.В. 01.08.2023 УА #61489
	
	СтруктураНастроек = ПолучитьДанныеЗаголовкаИзФайла();
	//+ ИнфоСофт Стояк Ю.К. 06.09.2023 УА #62429
	Если Не Элементы.СписокТранзакцийExcelWB.Видимость Тогда
		
		ДанныеОк = ПолучитьТаблицуЗначенийПродажИзФайла(); 
		
		МассивУдаляемыхСтрок = Новый Массив;
		//+ ИнфоСофт Сумин Д.В. 29.11.2023 УА #63730 
		
		Брак.Очистить();
		Потери.Очистить();
		
		АвансоваяСумма = 0;
		Если УчитыватьБракСписаниеОтдельно Тогда
			БракМассив = Новый Массив;
			ПотериМассив = Новый Массив;
			Для Каждого Строка Из ДанныеОк Цикл
				Если Строка.Кол_во = "0" Тогда			
					МассивУдаляемыхСтрок.Добавить(Строка);
				ИначеЕсли Строка.ОбоснованиеДляОплаты = "Частичная компенсация брака" Или Строка.ОбоснованиеДляОплаты = "Оплата брака" Тогда
					БракМассив.Добавить(Строка);
					МассивУдаляемыхСтрок.Добавить(Строка);
				ИначеЕсли Строка.ОбоснованиеДляОплаты = "Авансовая оплата за товар без движения" Тогда
					ПотериМассив.Добавить(Строка);
					МассивУдаляемыхСтрок.Добавить(Строка);
				ИначеЕсли Строка.ОбоснованиеДляОплаты = "Возмещение издержек по перевозке" Тогда 
					МассивУдаляемыхСтрок.Добавить(Строка);
				Иначе
					Продолжить;
				КонецЕсли;
				
			КонецЦикла;
			
			Если БракМассив.Количество() > 0 Тогда	
				БракТЗ = ПолучитьТзИзМассива(БракМассив); 
			КонецЕсли;  
			
			Если ПотериМассив.Количество() > 0 Тогда	
				ПотериТЗ = ПолучитьТзИзМассива(ПотериМассив); 
			КонецЕсли;  
			
		Иначе	
			Для Каждого Строка Из ДанныеОк Цикл	
				Если Строка.Кол_во = "0" Тогда			
					МассивУдаляемыхСтрок.Добавить(Строка);
				ИначеЕсли Строка.ОбоснованиеДляОплаты = "Частичная компенсация брака" Или Строка.ОбоснованиеДляОплаты = "Авансовая оплата за товар без движения" Или Строка.ОбоснованиеДляОплаты = "Оплата брака" Тогда 	
					Коэффициент = -1;
					Если Строка.ТипДокумента = "Продажа" Тогда
						Коэффициент = 1;
					КонецЕсли;
					МассивУдаляемыхСтрок.Добавить(Строка);
					АвансоваяСумма = АвансоваяСумма + Число(Строка.ВайлдберризРеализовалТовар_Пр_) * Коэффициент;
				ИначеЕсли Строка.ОбоснованиеДляОплаты = "Возмещение издержек по перевозке" Тогда 
					МассивУдаляемыхСтрок.Добавить(Строка);
				Иначе
					Продолжить;
				КонецЕсли;		
			КонецЦикла;
		КонецЕсли;
		//АвансоваяСумма = 0;
		//
		//Для Каждого Строка Из ДанныеОк Цикл	
		//	Если Строка.Кол_во = "0" Тогда			
		//		МассивУдаляемыхСтрок.Добавить(Строка);
		//	ИначеЕсли Строка.ОбоснованиеДляОплаты = "Частичная компенсация брака" Или Строка.ОбоснованиеДляОплаты = "Авансовая оплата за товар без движения" Или Строка.ОбоснованиеДляОплаты = "Оплата брака" Тогда 	
		//		Коэффициент = -1;
		//		Если Строка.ТипДокумента = "Продажа" Тогда
		//			Коэффициент = 1;
		//		КонецЕсли;
		//		МассивУдаляемыхСтрок.Добавить(Строка);
		//		АвансоваяСумма = АвансоваяСумма + Число(Строка.ВайлдберризРеализовалТовар_Пр_) * Коэффициент;
		//	ИначеЕсли Строка.ОбоснованиеДляОплаты = "Возмещение издержек по перевозке" Тогда 
		//		МассивУдаляемыхСтрок.Добавить(Строка);
		//	Иначе
		//		Продолжить;
		//	КонецЕсли;	
		//	
		//КонецЦикла;
		//- ИнфоСофт Сумин Д.В. 29.11.2023 УА #63730
		
		Для Каждого Строка Из МассивУдаляемыхСтрок Цикл
			ДанныеОк.Удалить(Строка);
		КонецЦикла;
		
		ТаблицаЗначенийРезультирующая = Новый ТаблицаЗначений;
		
		ТаблицаЗначенийРезультирующая.Колонки.Добавить("НоменклатураWB", Новый ОписаниеТипов("СправочникСсылка.ИС_WB_Номенклатура"));			
		ТаблицаЗначенийРезультирующая.Колонки.Добавить("Баркод", Новый ОписаниеТипов("Строка"));
		//+ ИнфоСофт Стояк Ю.К. 06.09.2023 УА #62429		
		ТаблицаЗначенийРезультирующая.Колонки.Добавить("Название", Новый ОписаниеТипов("Строка")); 
		ТаблицаЗначенийРезультирующая.Колонки.Добавить("Номер", Новый ОписаниеТипов("Строка"));
		//- ИнфоСофт Стояк Ю.К. 06.09.2023 УА #62429
		ТаблицаЗначенийРезультирующая.Колонки.Добавить("Количество", Новый ОписаниеТипов("Число"));		
		ТаблицаЗначенийРезультирующая.Колонки.Добавить("ЦенаРозничная", Новый ОписаниеТипов("Число"));
		ТаблицаЗначенийРезультирующая.Колонки.Добавить("СуммаПродажи", Новый ОписаниеТипов("Число"));
		ТаблицаЗначенийРезультирующая.Колонки.Добавить("ЦенаПродажи", Новый ОписаниеТипов("Число"));
		ТаблицаЗначенийРезультирующая.Колонки.Добавить("Код", Новый ОписаниеТипов("Число"));
		ТаблицаЗначенийРезультирующая.Колонки.Добавить("РазмерыНоменклатурWB", Новый ОписаниеТипов("СправочникСсылка.ИС_WB_РазмерыНоменклатур"));
		//+ ИнфоСофт Мурсалимов Д.Р. 14.12.23 УА #64799
		ТаблицаЗначенийРезультирующая.Колонки.Добавить("Артикул", Новый ОписаниеТипов("Строка"));
		ТаблицаЗначенийРезультирующая.Колонки.Добавить("РазмерПоставщика", Новый ОписаниеТипов("Строка"));
		//- ИнфоСофт Мурсалимов Д.Р. 14.12.23 УА #64799
		
		МассивНастроек = Новый Массив;
		
		Для Каждого Строка Из ДанныеОк Цикл	
			Коэффициент = -1;
			Если Строка.ТипДокумента = "Продажа" Тогда
				Коэффициент = 1;
			КонецЕсли;	
			
			НоваяСтрока = ТаблицаЗначенийРезультирующая.Добавить();
			НоваяСтрока.Баркод = Строка.Баркод;
			НоваяСтрока.Количество = Коэффициент * Число(Строка.Кол_во);
			НоваяСтрока.ЦенаРозничная = Число(Строка.ЦенаРозничная); 
			НоваяСтрока.СуммаПродажи = Коэффициент * Число(Строка.ВайлдберризРеализовалТовар_Пр_);	   	
			НоваяСтрока.ЦенаПродажи = ?(НоваяСтрока.Количество = 0, 0, НоваяСтрока.СуммаПродажи / НоваяСтрока.Количество); 	
			НоваяСтрока.Код = Строка.КодНоменклатуры;
			//+ ИнфоСофт Стояк Ю.К. 06.09.2023 УА #62429
			НоваяСтрока.Название = Строка.Название; 
			НоваяСтрока.Номер = Строка._;
			//- ИнфоСофт Стояк Ю.К. 06.09.2023 УА #62429
			//+ ИнфоСофт Мурсалимов Д.Р. 14.12.23 УА #64799
			НоваяСтрока.Артикул = Строка.АртикулПоставщика;
			НоваяСтрока.РазмерПоставщика = Строка.Размер;
			//- ИнфоСофт Мурсалимов Д.Р. 14.12.23 УА #64799
			
			Если Коэффициент > 0 Тогда
				МассивНастроек.Добавить(НоваяСтрока.ЦенаПродажи);	
			КонецЕсли;
			
		КонецЦикла;
		
		Если АвансоваяСумма <> 0 Тогда
			Итератор = 0;
			МассивСуммАванс = ОбщегоНазначения.РаспределитьСуммуПропорциональноКоэффициентам(АвансоваяСумма, МассивНастроек);
			Для Каждого Строка Из ТаблицаЗначенийРезультирующая Цикл	
