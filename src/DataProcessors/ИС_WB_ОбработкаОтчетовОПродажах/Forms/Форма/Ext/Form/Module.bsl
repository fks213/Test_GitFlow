	Выборка = РезультатЗапроса.Выбрать();
	
	Выборка.Следующий();
	
	СтруктураНастроек.Вставить("СтавкаНДС", Выборка.СтавкаНДС);	
	СтруктураНастроек.Вставить("Номенклатура", Выборка.Номенклатура);
	
	Возврат СтруктураНастроек;     
	
