//+ ИнфоСофт Сумин Д.В. 02.11.2023 УА #64784
&НаСервере
Процедура ЗагрузитьИностранныеПродажиНаСервере() 
	
	УстановитьПривилегированныйРежим(Истина);

	Если Не Элементы.СписокТранзакцийExcelWBИн.Видимость Тогда 
		
		Если Не ЗначениеЗаполнено(ПутьКФайлуДетализации) Тогда
			ОбщегоНазначения.СообщитьПользователю("Не выбран файл",,, "ПутьКФайлуДетализации");
			Возврат;
		КонецЕсли;				
		
		ПродажиТЗ = ПолучитьТаблицуЗначенийПродажИзФайла();
		
		Отбор = Новый Структура("ТипДокумента", "Возврат");
		ВозвратыТЗ = ПродажиТЗ.Скопировать(Отбор);
		
		//+ ИнфоСофт Сумин Д.В. 10.11.2023 УА #66026
		МассивКУдалению = Новый Массив;
		Для Каждого Строка Из ПродажиТЗ Цикл
			Если Строка.ТипДокумента = "Возврат" Тогда
				МассивКУдалению.Добавить(Строка);
			КонецЕсли;
		КонецЦикла;
		
		Для Каждого Элемент Из МассивКУдалению Цикл
			ПродажиТЗ.Удалить(Элемент);	
		КонецЦикла;
		//- ИнфоСофт Сумин Д.В. 10.11.2023 УА #66026

		ТаблицаРезультирующаяПродажи = ИС_WB_Сервер.ПолучитьРезультирующиюТаблицуИнПродаж(ПродажиТЗ, Профиль);
			
		ДобавитьВТаблицу(ТаблицаРезультирующаяПродажи, Ложь);
		
		ТаблицаРезультирующаяВозвраты = ИС_WB_Сервер.ПолучитьРезультирующиюТаблицуИнПродаж(ВозвратыТЗ, Профиль);
		ДобавитьВТаблицу(ТаблицаРезультирующаяВозвраты, Истина); 
		
		СписокТранзакцийExcelWBИн.Сортировать("Номенклатура Возр");
		
		Для Каждого Строка Из СписокТранзакцийExcelWBИн Цикл
			Если Не ЗначениеЗаполнено(Строка.Номенклатура) Тогда
				ОбщегоНазначения.СообщитьПользователю("Проверьте сопоставление для создания документов!"); 
				Элементы.СписокТранзакцийExcelWBИн.Видимость = Истина; 
				//+ ИнфоСофт Мурсалимов Д.Р. 14.12.23 УА #64799
				Элементы.ПодобратьПоАртикулуИн.Видимость = Истина;
				//- ИнфоСофт Мурсалимов Д.Р. 14.12.23 УА #64799
				Возврат;
			КонецЕсли;
		КонецЦикла;
		
	Иначе 
		
		Для Каждого Строка Из СписокТранзакцийExcelWBИн Цикл
			Если Не ЗначениеЗаполнено(Строка.Номенклатура) Тогда
				ОбщегоНазначения.СообщитьПользователю("Проверьте сопоставление для создания документов!");
				Возврат;
			КонецЕсли;
		КонецЦикла;
		
		ТаблицаРезультирующаяПродажи = СписокТранзакцийExcelWBИн.Выгрузить(Новый Структура("Возврат", Ложь));	
		ТаблицаРезультирующаяВозвраты = СписокТранзакцийExcelWBИн.Выгрузить(Новый Структура("Возврат", Истина));
		
	КонецЕсли;

	ЗаголовокСтруктура = ПолучитьДанныеЗаголовкаИзФайла();
	
	Если Не СоздаватьПриОшибке Тогда
		НачатьТранзакцию(); 
	КонецЕсли;	
	
	ЕстьОшибка = Ложь;
		
	ПараметрыСебестоимости = Новый Структура("СпособРасчета, ВидЦены", ВариантФормированияСебестоимости, ВидЦеныСебестоимость);
	
	МассивДокументов = Новый Массив();
	
	//+ ИнфоСофт Сумин Д.В. 21.11.2023 УА #61641
	ИспользоватьСоглашенияСКлиентами = ПолучитьФункциональнуюОпцию("ИспользоватьСоглашенияСКлиентами"); 
	Если ИспользоватьСоглашенияСКлиентами Тогда
		КомиссионныеПродажи25 = Профиль.Соглашение.КомиссионныеПродажи25;
	Иначе
		КомиссионныеПродажи25 = Профиль.Договор.КомиссионныеПродажи25;
	КонецЕсли;	
    //- ИнфоСофт Сумин Д.В. 21.11.2023 УА #61641

	Попытка 
		//+ ИнфоСофт Сумин Д.В. 21.11.2023 УА #61641
        Если НЕ КомиссионныеПродажи25 Тогда
		//Если Не ЗначениеЗаполнено(Профиль.Соглашение) Или НЕ Профиль.Соглашение.КомиссионныеПродажи25 Тогда
		//- ИнфоСофт Сумин Д.В. 21.11.2023 УА #61641
			ДокументВозвратКомиссия = ИС_WB_Сервер.СоздатьДокументВозвратТоваров(Профиль, ТаблицаРезультирующаяПродажи, ЗаголовокСтруктура, Истина); 
			МассивДокументов.Добавить(ДокументВозвратКомиссия.Ссылка);
			
			ДокументРТУ = ИС_WB_Сервер.СоздатьДокументРТУ(Профиль, ТаблицаРезультирующаяПродажи, ЗаголовокСтруктура, Ложь); 
			МассивДокументов.Добавить(ДокументРТУ.Ссылка);
			
			Если ТаблицаРезультирующаяВозвраты.Количество() > 0 Тогда 
				ДокументВозвратТоваровОтКлиента = ИС_WB_Сервер.СоздатьДокументВозвратТоваров(Профиль, ТаблицаРезультирующаяВозвраты, ЗаголовокСтруктура, Ложь, ПараметрыСебестоимости);
				МассивДокументов.Добавить(ДокументВозвратТоваровОтКлиента.Ссылка);
				
				ДокументПередачаНаКомиссию = ИС_WB_Сервер.СоздатьДокументРТУ(Профиль, ТаблицаРезультирующаяВозвраты, ЗаголовокСтруктура, Истина);
				МассивДокументов.Добавить(ДокументПередачаНаКомиссию.Ссылка);	
			КонецЕсли;  
		Иначе 
			//+ ИнфоСофт Стояк Ю.К. 23.11.2023 УА #64836			
			ДокументЗаявкаНаВозвратКомиссия = Неопределено;
			
			Если Константы.ИспользоватьЗаявкиНаВозвратТоваровОтКлиентов.Получить() Тогда
				ДокументЗаявкаНаВозвратКомиссия = ИС_WB_Сервер.СоздатьДокументЗаявкаНаВозврат(Профиль, ТаблицаРезультирующаяПродажи, ЗаголовокСтруктура); 
				МассивДокументов.Добавить(ДокументЗаявкаНаВозвратКомиссия.Ссылка);
			КонецЕсли;
			//- ИнфоСофт Стояк Ю.К. 23.11.2023 УА #64836
			
			ДокументВозвратКомиссия = ИС_WB_Сервер.СоздатьДокументПоступлениеТоваровОтХранителя(Профиль, ТаблицаРезультирующаяПродажи, ЗаголовокСтруктура, ДокументЗаявкаНаВозвратКомиссия);
			МассивДокументов.Добавить(ДокументВозвратКомиссия.Ссылка);
			
			ДокументРТУ = ИС_WB_Сервер.СоздатьДокументРТУ(Профиль, ТаблицаРезультирующаяПродажи, ЗаголовокСтруктура, Ложь);
			МассивДокументов.Добавить(ДокументРТУ.Ссылка);
			
			ОблагаетсяНДС = ИС_WB_СерверУТ11_5.ПолучитьРезультатПроверкиУчетаНДС(Профиль.Организация);
			
			Если ОблагаетсяНДС И ДокументРТУ.Проведен Тогда 
				СчетФактура = ИС_WB_СерверУТ11_5.СоздатьСчетФактуру(ДокументРТУ.Ссылка);
				МассивДокументов.Добавить(СчетФактура.Ссылка);  
			КонецЕсли; 
			
			Если ТаблицаРезультирующаяВозвраты.Количество() > 0 Тогда 
				ДокументВозвратТоваровОтКлиента = ИС_WB_Сервер.СоздатьДокументВозвратТоваров(Профиль, ТаблицаРезультирующаяВозвраты, ЗаголовокСтруктура, Ложь, ПараметрыСебестоимости);
				МассивДокументов.Добавить(ДокументВозвратТоваровОтКлиента.Ссылка);
				
				ДокументПередачаТоваровНаХранение = ИС_WB_Сервер.СоздатьПередачуТоваровНаХранение(Профиль, ТаблицаРезультирующаяВозвраты, ЗаголовокСтруктура);
				МассивДокументов.Добавить(ДокументПередачаТоваровНаХранение.Ссылка);
			КонецЕсли;
		КонецЕсли; 
		
	Исключение
		ЕстьОшибка = Истина;
		ОбщегоНазначения.СообщитьПользователю(ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));	
	КонецПопытки;
	
	Если Не СоздаватьПриОшибке И ЕстьОшибка Тогда
		ОтменитьТранзакцию();
		Возврат;
	КонецЕсли;
	
	Если Не СоздаватьПриОшибке И Не ЕстьОшибка Тогда
		ЗафиксироватьТранзакцию();
	КонецЕсли;

	Для Каждого Элемент Из МассивДокументов Цикл
		ДобавитьДокументВРезультирующуюТЧ(Элемент);	
	КонецЦикла;		
	
    УстановитьПривилегированныйРежим(Ложь);
	
КонецПроцедуры //- ИнфоСофт Сумин Д.В. 02.11.2023 УА #64784

//+ ИнфоСофт Сумин Д.В. 30.06.2023 УА #60267
&НаСервере
Функция ПрочитатьExcelФайлВТабличныйДокумент()  
	
	Если РасширениеФайлаОтчетаZip Тогда  
		
		ФайлВременногоХранилища = ПолучитьИзВременногоХранилища(АдресОтчетаВоВременномХранилище); 
		Имя = ПолучитьИмяВременногоФайла("zip");
		ФайлВременногоХранилища.Записать(Имя);
		
		ВызватьОшибку = Истина;
		ТабличныйДокумент = ПрочитатьТабДокИзZIP(Имя, ВызватьОшибку);
		
		Если ВызватьОшибку Тогда
			ОбщегоНазначения.СообщитьПользователю("Был выбран некорректный файл для загрузки отчета комиссионера WildBerries
				|проверьте выбранный файл", , , "ПутьКФайлу");
			Возврат Неопределено;
		КонецЕсли;
		
	Иначе
		
		ФайлВременногоХранилища = ПолучитьИзВременногоХранилища(АдресОтчетаВоВременномХранилище);
		Имя = ПолучитьИмяВременногоФайла("xlsx");
		ФайлВременногоХранилища.Записать(Имя);
		ТабличныйДокумент = Новый ТабличныйДокумент;
		ТабличныйДокумент.Прочитать(Имя);	
		
	КонецЕсли;     
	
	ТабличныйДокумент.Область().Разъединить();
	
	Возврат ТабличныйДокумент;
	
КонецФункции  //- ИнфоСофт Сумин Д.В. 30.06.2023 УА #60267

