&НаКлиенте
Процедура Загрузить(Команда)
	
	Если НЕ ЗначениеЗаполнено(Профиль) Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю("Не выбран профиль.", , , "Профиль");
		Возврат;
	КонецЕсли;  
	
	Если РоссийскиеПродажи Тогда
		
		Если НЕ ЗначениеЗаполнено(ПутьКФайлуОтчета) Тогда
			ОбщегоНазначенияКлиент.СообщитьПользователю("Не выбран файл отчета.", , , "ПутьКФайлуОтчета");
			Возврат;
		КонецЕсли; 
		
		Если НЕ ЗначениеЗаполнено(ПутьКФайлуДетализации) Тогда
			ОбщегоНазначенияКлиент.СообщитьПользователю("Не выбран файл детализации.", , , "ПутьКФайлуДетализации");
			Возврат;
		КонецЕсли;
		
		ЗагрузитьОтчетКомисисонераИзФайлаНаСервере();	
		
	ИначеЕсли Api Тогда 
		Если НЕ ЗначениеЗаполнено(ПериодДляЗагрузки) Тогда
			ОбщегоНазначенияКлиент.СообщитьПользователю("Не выбран период загрузки.", , , "ПериодДляЗагрузки");
			Возврат;
		КонецЕсли; 
		ЗагрузитьОтчетКомисисонераПоApiНаСервере(); 
		
	ИначеЕсли ИностранныеПродажи Тогда 
		ЗагрузитьИностранныеПродажиНаСервере();	
	КонецЕсли;
	
КонецПроцедуры //- ИнфоСофт Сумин Д.В. 02.03.23 УА #55086  

