&НаСервере
Функция ПолучитьСоотвествиеНоменклаутры(ТЗ)
	
	Данные = Новый ТаблицаЗначений;
	//Данные.Колонки.Добавить("Баркод");
	Данные.Колонки.Добавить("Баркод", Новый ОписаниеТипов("Строка",,,,Новый КвалификаторыСтроки(50)));
	Данные.Колонки.Добавить("ВайлдберризРеализовалТовар_Пр_", Новый ОписаниеТипов("Число",,,Новый КвалификаторыЧисла(10,2)));
	
	Для Каждого Строка Из ТЗ Цикл 
		НоваяСтрока = Данные.Добавить();
		НоваяСтрока.Баркод 							= Строка.Баркод;
		НоваяСтрока.ВайлдберризРеализовалТовар_Пр_ 	= Число(Строка.ВайлдберризРеализовалТовар_Пр_);		
	КонецЦикла;
	
	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	Данные.Баркод КАК Баркод,
	|	Данные.ВайлдберризРеализовалТовар_Пр_ КАК Сумма
	|ПОМЕСТИТЬ ВТ_Данные
	|ИЗ
	|	&Данные КАК Данные
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	СУММА(ВТ_Данные.Сумма) КАК Сумма,
	|	ЕСТЬNULL(ИС_WB_СоответствиеРазмеров.Номенклатура, ЗНАЧЕНИЕ(Справочник.Номенклатура.ПустаяСсылка)) КАК Номенклатура,
	|	ЕСТЬNULL(ИС_WB_СоответствиеРазмеров.Характеристика, ЗНАЧЕНИЕ(Справочник.ХарактеристикиНоменклатуры.ПустаяСсылка)) КАК Характеристика,
	|	ИС_WB_ШтрихкодыРазмеров.Штрихкод КАК Штрихкод
	|ПОМЕСТИТЬ ВТ_ОсновныеДанные
	|ИЗ
	|	ВТ_Данные КАК ВТ_Данные
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ИС_WB_ШтрихкодыРазмеров КАК ИС_WB_ШтрихкодыРазмеров
	|			ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ИС_WB_СоответствиеРазмеров КАК ИС_WB_СоответствиеРазмеров
	|			ПО ИС_WB_ШтрихкодыРазмеров.Размер = ИС_WB_СоответствиеРазмеров.РазмерWB
	|		ПО ВТ_Данные.Баркод = ИС_WB_ШтрихкодыРазмеров.Штрихкод
	|			И (ИС_WB_ШтрихкодыРазмеров.Профиль = &Профиль)
	|
	|СГРУППИРОВАТЬ ПО
	|	ЕСТЬNULL(ИС_WB_СоответствиеРазмеров.Номенклатура, ЗНАЧЕНИЕ(Справочник.Номенклатура.ПустаяСсылка)),
	|	ЕСТЬNULL(ИС_WB_СоответствиеРазмеров.Характеристика, ЗНАЧЕНИЕ(Справочник.ХарактеристикиНоменклатуры.ПустаяСсылка)),
	|	ИС_WB_ШтрихкодыРазмеров.Штрихкод
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_ОсновныеДанные.Штрихкод КАК Штрихкод,
	|	МАКСИМУМ(ЕСТЬNULL(ШтрихкодыНоменклатуры.Упаковка, ВТ_ОсновныеДанные.Номенклатура.ЕдиницаИзмерения)) КАК Упаковка
	|ПОМЕСТИТЬ ВТ_Упаковка
	|ИЗ
	|	ВТ_ОсновныеДанные КАК ВТ_ОсновныеДанные
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ШтрихкодыНоменклатуры КАК ШтрихкодыНоменклатуры
	|		ПО (ВТ_ОсновныеДанные.Штрихкод = ШтрихкодыНоменклатуры.Штрихкод)
	|
	|СГРУППИРОВАТЬ ПО
	|	ВТ_ОсновныеДанные.Штрихкод
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_ОсновныеДанные.Сумма КАК Сумма,
	|	ВТ_ОсновныеДанные.Номенклатура КАК Номенклатура,
	|	ВТ_ОсновныеДанные.Характеристика КАК Характеристика,
	|	ВТ_ОсновныеДанные.Штрихкод КАК Штрихкод,
	|	ВТ_Упаковка.Упаковка КАК Упаковка,
	|	ВЫБОР
	|		КОГДА ВТ_ОсновныеДанные.Номенклатура.ТипНоменклатуры = ЗНАЧЕНИЕ(Перечисление.ТипыНоменклатуры.Набор)
	|			ТОГДА ИСТИНА
	|		ИНАЧЕ ЛОЖЬ
	|	КОНЕЦ КАК ЭтоНабор
	|ИЗ
	|	ВТ_ОсновныеДанные КАК ВТ_ОсновныеДанные
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_Упаковка КАК ВТ_Упаковка
	|		ПО ВТ_ОсновныеДанные.Штрихкод = ВТ_Упаковка.Штрихкод"); 
	
	Запрос.УстановитьПараметр("Профиль", Профиль);
	Запрос.УстановитьПараметр("Данные", Данные);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Возврат РезультатЗапроса.Выгрузить();
	
КонецФункции //- ИнфоСофт Сумин Д.В. 29.11.2023 УА #63730

