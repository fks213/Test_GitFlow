&НаСервере
Процедура ЗаполнитьДанныеПоУслугамОтчета(ТабличныйДокумент)  
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ИС_WB_НаименованиеУслугИзОтчетаWildberries.Ссылка КАК Ссылка,
	|	ИС_WB_НаименованиеУслугИзОтчетаWildberries.НаименованиеУслугиИзОтчета КАК НаименованиеУслугиИзОтчета,
	|	ИС_WB_НаименованиеУслугИзОтчетаWildberries.Номенклатура КАК Номенклатура,
	|	ИС_WB_НаименованиеУслугИзОтчетаWildberries.СтатьяРасходов КАК СтатьяРасходов
	|ИЗ
	|	Справочник.ИС_WB_НаименованиеУслугИзОтчетаWildberries КАК ИС_WB_НаименованиеУслугИзОтчетаWildberries";
	
	РезультатЗапроса = Запрос.Выполнить(); 
	
	Если РезультатЗапроса.Пустой() Тогда
		ВызватьИсключение("Необходимо заполнить справочник ""Наименование услуш Wildberries.""");	
	КонецЕсли;	
	
	Выборка = РезультатЗапроса.Выбрать();
	
	ОтражениеУслугWildberries.Очистить();
	
	Пока Выборка.Следующий() Цикл
		
		Если Не ЗначениеЗаполнено(Выборка.НаименованиеУслугиИзОтчета) Тогда
			ОбщегоНазначения.СообщитьПользователю(
			СтрШаблон("Не заполнено поле ""Наименование услуги из отчета"" услуги %1, услуга не будет добавлена.", 
			Выборка.Ссылка));
			Продолжить; 
		КонецЕсли;     
		
		Если Не ЗначениеЗаполнено(Выборка.Номенклатура) Тогда
			ОбщегоНазначения.СообщитьПользователю(
			СтрШаблон("Не заполнено поле ""Номенклатура"" услуги %1, услуга не будет добавлена.", Выборка.Ссылка));  
			Продолжить;
		КонецЕсли;
		
		Для НомерСтроки = 1 По ТабличныйДокумент.ВысотаТаблицы Цикл
			
			Если СокрЛП(ТабличныйДокумент.Область("R" + НомерСтроки + "C3").Текст) = СокрЛП(Строка(Выборка.НаименованиеУслугиИзОтчета)) Тогда				
				
				НоваяСтрока = ОтражениеУслугWildberries.Добавить();
				НоваяСтрока.УслугаWildberries = Выборка.Ссылка;    
				НоваяСтрока.Номенклатура = Выборка.Номенклатура;
				НоваяСтрока.СтатьяРасходов = Выборка.СтатьяРасходов;			    
				
				Попытка
					НоваяСтрока.Сумма = Число(ТабличныйДокумент.Область("R" + НомерСтроки + "C13").Текст);
				Исключение
				КонецПопытки;   
				
				Попытка
					
					Если СокрЛП(Строка(Выборка.НаименованиеУслугиИзОтчета)) = "Сумма вознаграждения Вайлдберриз за текущий период (ВВ), без НДС" Тогда
						НомерСтроки = НомерСтроки + 1;
						НоваяСтрока.НДС = Число(ТабличныйДокумент.Область("R" + НомерСтроки + "C13").Текст);
					Иначе
						НоваяСтрока.НДС = Число(ТабличныйДокумент.Область("R" + НомерСтроки + "C14").Текст);	
					КонецЕсли;
					
				Исключение
				КонецПопытки;    
				
				Если НоваяСтрока.НДС > 0 Тогда
					НоваяСтрока.СтавкаНДС = Справочники.СтавкиНДС.НайтиПоНаименованию("20%");
				Иначе				
					НоваяСтрока.СтавкаНДС = Справочники.СтавкиНДС.НайтиПоНаименованию("Без НДС");
				КонецЕсли;
				
				Прервать;   			
				
			КонецЕсли;
			
		КонецЦикла		
		
	КонецЦикла; 	
	
КонецПроцедуры //- ИнфоСофт Сумин Д.В. 19.08.22 УА #48780 

