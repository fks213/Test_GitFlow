	|";	
	
	РезультатЗапроса = Запрос.Выполнить();
	
	СтруктураНастроек = Новый Структура;
	
	Если РезультатЗапроса.Пустой() Тогда
		СтруктураНастроек.Вставить("СтавкаНДС", Справочники.СтавкиНДС.ПустаяСсылка());	
