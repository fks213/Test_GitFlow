&НаКлиенте
Процедура ЗаполнитьПоВыделенным(Команда)

	ВыделенныеСтроки = Элементы[Маркетплейс + "ТаблицаВыгрузки"].ВыделенныеСтроки;
	
	Если ВыделенныеСтроки.Количество() = 0 Тогда
		Возврат;
	КонецЕсли; 
	
	ТекПоле = Элементы[Маркетплейс + "ТаблицаВыгрузки"].ТекущийЭлемент;
	
	Если ТекПоле = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Если Маркетплейс = "Ozon" Тогда
		
		Если ТекПоле = Элементы[Маркетплейс + "ТаблицаВыгрузкиРучнаяЦена"] Тогда
			Параметр = "РучнаяЦена";
		ИначеЕсли ТекПоле = Элементы[Маркетплейс + "ТаблицаВыгрузкиРучнаяСкидка"]	Тогда
			Параметр = "РучнаяСкидка";
		ИначеЕсли ТекПоле = Элементы[Маркетплейс + "ТаблицаВыгрузкиРучнаяЦенаМинимальная"]	Тогда
			Параметр = "РучнаяЦенаМинимальная";
		Иначе
			Возврат;
		КонецЕсли;
		
	ИначеЕсли Маркетплейс = "Сбер" Тогда
		
		Если ТекПоле = Элементы[Маркетплейс + "ТаблицаВыгрузкиРучнаяЦена"] Тогда
			Параметр = "РучнаяЦена";
		Иначе
			Возврат;
		КонецЕсли;
		
	Иначе
		
		Если ТекПоле = Элементы[Маркетплейс + "ТаблицаВыгрузкиРучнаяЦена"] Тогда
			Параметр = "РучнаяЦена";
		ИначеЕсли ТекПоле = Элементы[Маркетплейс + "ТаблицаВыгрузкиРучнаяСкидка"]	Тогда
			Параметр = "РучнаяСкидка";
		Иначе
			Возврат;
		КонецЕсли;
		
	КонецЕсли;
	    
    ОписаниеОповещения = Новый ОписаниеОповещения("ЗаполнитьПоВыделеннымЗавершение", ЭтотОбъект, Параметр);
	ПоказатьВводЧисла(ОписаниеОповещения, 0, "Заполнение ручных цен", 10, 0);	

КонецПроцедуры //- ИнфоСофт Мурсалимов Д.Р. 07.05.24 УА #66901

