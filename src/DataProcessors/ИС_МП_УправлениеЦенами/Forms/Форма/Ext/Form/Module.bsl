//+ ИнфоСофт Мурсалимов Д.Р. 15.04.24 УА #66901
&НаКлиенте
Процедура УправлениеФормой()
    
    Элементы.СохранитьИзменения.Видимость = Ложь;
	
	УстановитьВидимостьПолученияЦен();
	
	Если ЭтотОбъект[Маркетплейс + "ОтображатьТекущиеЦены"] 
		И ЭтотОбъект[Маркетплейс + "ПолучатьТекущиеЦеныАвтоматически"] Тогда
	    
	    Если ЗначениеЗаполнено(Профиль) Тогда
			НачатьПолучениеТекущихЦен();
		КонецЕсли;
	
	КонецЕсли;
		
КонецПроцедуры //- ИнфоСофт Мурсалимов Д.Р. 15.04.24 УА #66901

//+ ИнфоСофт Мурсалимов Д.Р. 15.04.24 УА #66901
&НаКлиенте
Процедура ЗаполнитьШапку()
	
	РежимОкругленияЦен 				= ЭтотОбъект[Маркетплейс + "РежимОкругленияЦен"];
		
	ОтображениеРежимОкругленияЦен 	= ?(РежимОкругленияЦен = 0, "Округлять 1.5 как 1", "Округлять 1.5 как 2");
	
	Элементы.ОтображениеВидЦены.Видимость 						= Ложь;
	Элементы.ОтображениеВидЦены.ЦветТекста 						= WebЦвета.Зеленый;
	Элементы.ОтображениеВидЦеныСоСкидкой.Видимость 				= Ложь;
	Элементы.ОтображениеВидЦеныСоСкидкой.ЦветТекста 			= WebЦвета.Зеленый;
	Элементы.ОтображениеВидЦеныМинимальный.Видимость 			= Ложь;
	Элементы.ОтображениеВидЦеныМинимальный.ЦветТекста 			= WebЦвета.Зеленый;
	
	ВидыЦен = ПолучитьМассивВидовЦен(Маркетплейс);
		
	Если ВидыЦен.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	Для Каждого Элемент Из ВидыЦен Цикл
		
		ВидЦены 												= ЭтотОбъект[Маркетплейс + Элемент.Ключ];
		
		Если ЗначениеЗаполнено(ВидЦены) Тогда	
			ЭтотОбъект["Отображение" + Элемент.Ключ] 			= ВидЦены;	
		Иначе			
			ЭтотОбъект["Отображение" + Элемент.Ключ] 			= Элементы["Отображение" + Элемент.Ключ].Заголовок + " не заполнен";	
			Элементы["Отображение" + Элемент.Ключ].ЦветТекста 	= WebЦвета.Красный;	
		КонецЕсли;
		
		Элементы["Отображение" + Элемент.Ключ].Видимость 		= Истина;	
		
	КонецЦикла;

КонецПроцедуры //- ИнфоСофт Мурсалимов Д.Р. 15.04.24 УА #66901 

