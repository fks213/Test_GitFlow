// 
// Возвращаемое значение:
//  Структура - Возвращает структуру сформированную в результате запуска фонового задания
//
&НаСервере  
Функция НачатьВыгрузкуЦенНаСервере()
    
    ПеречислениеМП = Перечисления.ИС_МП_Маркетплейсы[КонвертироватьМаркетплейс(Маркетплейс)];
    
	ПараметрыВыполнения = ДлительныеОперации.ПараметрыВыполненияВФоне(УникальныйИдентификатор);
	ПараметрыВыполнения.ЗапуститьВФоне = Истина;
	ПараметрыВыполнения.ОжидатьЗавершение = 0;
	
	ТаблицаВыгрузки = СформироватьТаблицуВыгрузки(ПеречислениеМП);
	
	Если ТаблицаВыгрузки.Количество() = 0 Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Возврат ДлительныеОперации.ВыполнитьПроцедуру(ПараметрыВыполнения, "ИС_МП_УправлениеЦенами.ВыгрузитьЦены", 
		ПеречислениеМП, Профиль, ТаблицаВыгрузки);

