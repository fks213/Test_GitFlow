	ВидимостьПоследнихЦен = ЭтотОбъект[Маркетплейс + "ИспользоватьПоследниеЦены"];
	
	Элементы[Маркетплейс + "ТаблицаВыгрузкиПоследняяВыгруженнаяЦена"].Видимость 			= ВидимостьПоследнихЦен;
	Элементы[Маркетплейс + "ТаблицаВыгрузкиПоследняяВыгруженнаяЦенаСоСкидкой"].Видимость 	= ВидимостьПоследнихЦен;
	
	Видимость = ЭтотОбъект[Маркетплейс + "ОтображатьТекущиеЦены"];
	
	Если Маркетплейс = "WildBerries" Тогда
	
		Элементы[Маркетплейс + "ПолучатьТекущиеЦеныАвтоматически"].Видимость 				= Видимость;
		Элементы[Маркетплейс + "ПолучитьТекущиеЦены"].Видимость 							= Видимость;
		Элементы[Маркетплейс + "ТаблицаВыгрузкиЦенаНаМаркетплейсе"].Видимость 				= Видимость;
		Элементы[Маркетплейс + "ТаблицаВыгрузкиСкидкаНаМаркетплейсе"].Видимость 			= Видимость;
		Элементы[Маркетплейс + "ТаблицаВыгрузкиЦенаСоСкидкойНаМаркетплейсе"].Видимость 		= Видимость;
		
	ИначеЕсли Маркетплейс = "Ozon" Тогда
	
		Элементы[Маркетплейс + "ПолучатьТекущиеЦеныАвтоматически"].Видимость 				= Видимость;
		Элементы[Маркетплейс + "ПолучитьТекущиеЦены"].Видимость 							= Видимость;
		Элементы[Маркетплейс + "ТаблицаВыгрузкиЦенаНаМаркетплейсе"].Видимость 				= Видимость;
		Элементы[Маркетплейс + "ТаблицаВыгрузкиЦенаСоСкидкойНаМаркетплейсе"].Видимость 		= Видимость;
		Элементы[Маркетплейс + "ТаблицаВыгрузкиЦенаМинимальнаяНаМаркетплейсе"].Видимость 	= Видимость;
		//+ ИнфоСофт Заварин К.В. 07.04.25 УА #89329
		Элементы[Маркетплейс + "ТаблицаВыгрузкиТоварУчаствуетВАкции"].Видимость 			= Видимость;
		Элементы[Маркетплейс + "ТаблицаВыгрузкиЦенаДляПокупателя"].Видимость 				= Видимость;
		Элементы[Маркетплейс + "ТаблицаВыгрузкиЦенаВаша"].Видимость 						= Видимость;
		//- ИнфоСофт Заварин К.В. 07.04.25 УА #89329
				
	Иначе
	
		Элементы[Маркетплейс + "ПолучатьТекущиеЦеныАвтоматически"].Видимость 				= Видимость;
		Элементы[Маркетплейс + "ПолучитьТекущиеЦены"].Видимость 							= Видимость;
		Элементы[Маркетплейс + "ТаблицаВыгрузкиЦенаНаМаркетплейсе"].Видимость 				= Видимость;
		Элементы[Маркетплейс + "ТаблицаВыгрузкиЦенаСоСкидкойНаМаркетплейсе"].Видимость 		= Видимость;
		                                                                                
	КонецЕсли;
	
КонецПроцедуры //- ИнфоСофт Мурсалимов Д.Р. 15.04.24 УА #66901

