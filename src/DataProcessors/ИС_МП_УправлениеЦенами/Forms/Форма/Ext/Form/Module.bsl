//+ ИнфоСофт Мурсалимов Д.Р. 12.05.24 УА #66901
//
// Параметры:
//  ПеречислениеМП	 - ПеречислниеСсылка.ИС_МП_Маркетплейсы	 - Маркетплейс по которому необходимо сформировать таблицу
// 
// Возвращаемое значение:
//  ТаблицаЗначений - Сформированная таблица для выгрузки цен на Маркетплейс
//
&НаСервере   
Функция СформироватьТаблицуВыгрузки(ПеречислениеМП)

	ТаблицаВыгрузки = Новый ТаблицаЗначений;
	
	ИС_МП_УправлениеЦенами.ЗаполнитьКолонкиТаблицыВыгрузкиЦен(ПеречислениеМП, ТаблицаВыгрузки);
	
	МассивПараметров = ИС_МП_УправлениеЦенами.ПолучитьПоляДляВыгрузки(ПеречислениеМП);
	
	Если ПеречислениеМП = Перечисления.ИС_МП_Маркетплейсы.ВБ Тогда
		
		//+ ИнфоСофт Мурсалимов Д.Р. 04.02.25 УА #91535
		ВыгружатьНулевыеСкидки = ЭтотОбъект[Маркетплейс + "ВыгружатьНулевыеСкидки"];	
		
		Для Каждого Строка Из ЭтотОбъект[Маркетплейс + "ТаблицаВыгрузки"] Цикл
			
