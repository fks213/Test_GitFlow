	ПараметрыОжидания = ДлительныеОперацииКлиент.ПараметрыОжидания(ЭтотОбъект);
	ПараметрыОжидания.ОповещениеПользователя.Показать = Истина;
	ПараметрыОжидания.ОповещениеПользователя.НавигационнаяСсылка = 
		"e1cib/command/Обработка.ИС_МП_УправлениеЦенами.Команда.ОткрытьФормуПанельНавигации";
	ПараметрыОжидания.ВыводитьОкноОжидания = Ложь;
	ПараметрыОжидания.ВыводитьСообщения = Истина;
	Возврат ПараметрыОжидания;

КонецФункции //- ИнфоСофт Мурсалимов Д.Р. 15.04.24 УА #66901

//+ ИнфоСофт Мурсалимов Д.Р. 15.04.24 УА #66901
&НаКлиенте
Процедура НачатьПолучениеТекущихЦен()
	
	НайденныеСтроки = ТаблицаФоновыхЗаданий.НайтиСтроки(Новый Структура("Маркетплейс", Маркетплейс));
	
	Если НайденныеСтроки.Количество() > 0 Тогда
		Возврат;
	КонецЕсли;
	
	ДлительнаяОперация = НачатьПолучениеЦенНаСервере();
	
	Если ДлительнаяОперация.Свойство("ИдентификаторЗадания") 
		И ЗначениеЗаполнено(ДлительнаяОперация.ИдентификаторЗадания) Тогда
		
		НоваяСтрока = ТаблицаФоновыхЗаданий.Добавить();
		НоваяСтрока.ИдентификаторЗадания = ДлительнаяОперация.ИдентификаторЗадания;
		НоваяСтрока.Маркетплейс = Маркетплейс;
		
		ДопПараметры = ДлительнаяОперация.ИдентификаторЗадания;
		
	КонецЕсли;
	
	ОповещениеОЗавершении = Новый ОписаниеОповещения("ПолучениеЦенЗавершение", ЭтотОбъект, ДопПараметры);
	ДлительныеОперацииКлиент.ОжидатьЗавершение(ДлительнаяОперация, ОповещениеОЗавершении, ПараметрыОжидания());
	
	Элементы[Маркетплейс + "КартинкаОжидание"].Видимость = Истина;
	
КонецПроцедуры //- ИнфоСофт Мурсалимов Д.Р. 15.04.24 УА #66901

