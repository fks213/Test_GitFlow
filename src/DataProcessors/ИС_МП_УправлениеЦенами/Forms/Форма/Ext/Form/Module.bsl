//+ ИнфоСофт Мурсалимов Д.Р. 27.04.24 УА #66901
&НаКлиенте
Процедура ПередЗакрытием(Отказ, ЗавершениеРаботы, ТекстПредупреждения, СтандартнаяОбработка)
	
	Если Модифицированность Тогда

		Отказ = Истина;

		Если ЗавершениеРаботы Тогда
			ТекстПредупреждения = НСтр("ru = 'Имеются несохраненные данные, все изменения будут утеряны. Хотите продолжить?'");
			Возврат;
		КонецЕсли;		
		
		Оповещение = Новый ОписаниеОповещения("НесохраненныеИзмененияЗавершение", 
			ЭтотОбъект, Новый Структура("Закрытие", Истина));
		
		СтандартныеПодсистемыКлиент.ПоказатьВопросПользователю(Оповещение, 
			НСтр("ru = 'Имеются несохраненные данные, все изменения будут утеряны. Хотите продолжить?'"), 
			РежимДиалогаВопрос.ДаНет);
	
	КонецЕсли;
	
КонецПроцедуры //- ИнфоСофт Мурсалимов Д.Р. 27.04.24 УА #66901

//+ ИнфоСофт Мурсалимов Д.Р. 16.04.24 УА #66901
&НаКлиенте
Процедура ГруппаСтраницыПриСменеСтраницы(Элемент, ТекущаяСтраница)
	
	ОчиститьСообщения();
	
	Если Модифицированность Тогда
	
		Оповещение = Новый ОписаниеОповещения("НесохраненныеИзмененияЗавершение", ЭтотОбъект);
		СтандартныеПодсистемыКлиент.ПоказатьВопросПользователю(Оповещение, 
			НСтр("ru = 'Имеются несохраненные данные, все изменения будут утеряны. Хотите продолжить?'"), 
			РежимДиалогаВопрос.ДаНет);
		Возврат;
	
	КонецЕсли;
	
	Элементы.ВыгрузитьЦены.Доступность = Ложь;
	
	Маркетплейс = СтрЗаменить(ТекущаяСтраница.Имя, "Страница", "");
	ПоследняяСтраница = Элементы["Страница" + Маркетплейс];

	УстановитьВидимостьПолученияЦен();
	ЗаполнитьШапку();
	
	Если ЗначениеЗаполнено(Профиль) Тогда
		
		ОбновитьСписокНаСервере();
			
		Если ЭтотОбъект[Маркетплейс + "ОтображатьТекущиеЦены"] 
			И ЭтотОбъект[Маркетплейс + "ПолучатьТекущиеЦеныАвтоматически"] Тогда
			
			НачатьПолучениеТекущихЦен();
		
		КонецЕсли;
		
	КонецЕсли;
		
КонецПроцедуры //- ИнфоСофт Мурсалимов Д.Р. 16.04.24 УА #66901

//+ ИнфоСофт Мурсалимов Д.Р. 06.05.24 УА #66901
&НаКлиенте
Процедура ПрофильПриИзменении(Элемент)
	
	//+ ИнфоСофт Власова И.С. 23.12.24 УА #90120
	//ОпределитьИнтегрируемыеМаркетплейсы();
	//ГруппаСтраницыПриСменеСтраницы(Элементы.ГруппаСтраницы, Элементы.ГруппаСтраницы.ТекущаяСтраница);
	//- ИнфоСофт Власова И.С. 23.12.24 УА #90120
	
	Если ЗначениеЗаполнено(Профиль) Тогда
	
		ПолучитьИЗаполнитьФункциональныеОпцииЦен(Профиль);
		ЗаполнитьШапку();
		
		ВидыЦен = ПолучитьМассивВидовЦен(Маркетплейс);
		
		Если ВидыЦен.Количество() > 0 Тогда
			ОбновитьСписокНаСервере();
			УстановитьВидимостьПолученияЦен();
			Возврат;
		КонецЕсли;
				
	КонецЕсли;
	
	ЭтотОбъект[Маркетплейс + "ТаблицаВыгрузки"].Очистить();
	Элементы.ВыгрузитьЦены.Доступность = Ложь;
	
КонецПроцедуры //- ИнфоСофт Мурсалимов Д.Р. 06.05.24 УА #66901

