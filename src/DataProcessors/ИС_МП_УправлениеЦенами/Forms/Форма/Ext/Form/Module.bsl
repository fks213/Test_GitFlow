//+ ИнфоСофт Мурсалимов Д.Р. 12.05.24 УА #66901
&НаСервере
Процедура ЗагрузитьРучныеЦеныНаСервере()

	Если Не ЗначениеЗаполнено(АдресРучныхЦенВоВременномХранилище) Тогда
		Возврат;
	КонецЕсли;
	
	РучныеЦеныТЗ = ИС_MP_Сервер.ПолучитьТаблицуЗначенийИзExcel(АдресРучныхЦенВоВременномХранилище);
	
	Если РучныеЦеныТЗ = Неопределено Или РучныеЦеныТЗ.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
    
	Если РучныеЦеныТЗ.Колонки.Найти("Цена") = Неопределено Тогда
		ОбщегоНазначения.СообщитьПользователю("В файле не найдена колонка ""Цена"", проверьте корректность файла");
		Возврат;
	КонецЕсли;
	
	ПеречислениеМП = Перечисления.ИС_МП_Маркетплейсы[КонвертироватьМаркетплейс(Маркетплейс)];
	
	ИспользоватьПоследниеЦены = ЭтотОбъект[Маркетплейс + "ИспользоватьПоследниеЦены"];
	
	ПолеПоиска = Неопределено;
	ПолеСопоставления = Неопределено;
	
	Таблица = ЭтотОбъект[Маркетплейс + "ТаблицаВыгрузки"];
	МассивСтрокВыгрузки = Новый Массив;
	МассивСтрокВыгрузки.Добавить(Таблица[0]);
	
	РеквизитыТаблицы = ПолучитьРеквизиты(Маркетплейс + "ТаблицаВыгрузки");
	
	ОпределитьПолеПоиска(РеквизитыТаблицы, РучныеЦеныТЗ.Колонки, ПолеСопоставления, ПолеПоиска);
	
	Если ПолеПоиска = Неопределено Тогда
		ОбщегоНазначения.СообщитьПользователю("В файле не найдена колонка для сопоставления цен по данному маркетплейсу");
		Возврат;
	КонецЕсли;
	
	Счетчик = 0;
	
	Для Каждого Строка Из РучныеЦеныТЗ Цикл
		
		НайденныеСтроки = Таблица.НайтиСтроки(Новый Структура(ПолеПоиска, Строка[ПолеСопоставления]));
		
		Если Строка.Цена = "" И Строка.Скидка = "" Тогда
			Продолжить;
		КонецЕсли;
		
		Если НайденныеСтроки.Количество() > 0 Тогда
			
			НайденныеСтроки[0].РучнаяЦена = Строка.Цена;
			НайденныеСтроки[0].РучнаяЦенаИзменена = ЗначениеЗаполнено(Строка.Цена);
			
			НайденныеСтроки[0].РучнаяСкидка = Строка.Скидка;
			НайденныеСтроки[0].РучнаяСкидкаИзменена = ЗначениеЗаполнено(Строка.Скидка);
			
			РасчетЦенНаСервере(ПеречислениеМП, НайденныеСтроки[0], ИспользоватьПоследниеЦены);
			
			Модифицированность = Истина;
			Элементы.СохранитьИзменения.Видимость = Истина;
			Счетчик = Счетчик + 1;	
			
		КонецЕсли;	
		
	КонецЦикла;
	
	Если Счетчик > 0 Тогда
		ОбщегоНазначения.СообщитьПользователю("Загрузка выполнена успешно, заполнено строк: " + Счетчик);
	КонецЕсли;
	
КонецПроцедуры //- ИнфоСофт Мурсалимов Д.Р. 12.05.24 УА #66901

//+ ИнфоСофт Мурсалимов Д.Р. 12.05.24 УА #66901
&НаСервереБезКонтекста   
Процедура ОпределитьПолеПоиска(Знач РеквизитыТаблицы, Знач Колонки, ПолеСопоставления, ПолеПоиска)

	Для Каждого Колонка Из Колонки Цикл
		
		Если Колонка.Имя = "Цена" Тогда
			Продолжить;
		КонецЕсли;
		
		Если Колонка.Имя = "Скидка" Тогда
			Продолжить;
		КонецЕсли;
		
		Для Каждого Реквизит Из РеквизитыТаблицы Цикл
			
			Если Не Реквизит.ТипЗначения.СодержитТип(Тип("Строка")) Тогда
				Продолжить;
			КонецЕсли;
			
			Если СтрЗаменить(Реквизит.Заголовок, " ", "") = Колонка.Имя Тогда
				ПолеПоиска = Реквизит.Имя;
				ПолеСопоставления = Колонка.Имя;
				Прервать;
			КонецЕсли;
			
		КонецЦикла;		                                        
		
	КонецЦикла;

КонецПроцедуры //- ИнфоСофт Мурсалимов Д.Р. 12.05.24 УА #66901

