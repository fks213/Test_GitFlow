//
&НаСервере   
Функция НачатьПолучениеЦенНаСервере()
    
    ПеречислениеМП = Перечисления.ИС_МП_Маркетплейсы[КонвертироватьМаркетплейс(Маркетплейс)];
    
	ПараметрыВыполнения = ДлительныеОперации.ПараметрыВыполненияВФоне(УникальныйИдентификатор);
	ПараметрыВыполнения.ЗапуститьВФоне = Истина;
	ПараметрыВыполнения.ОжидатьЗавершение = 0;
	
	Возврат ДлительныеОперации.ВыполнитьФункцию(ПараметрыВыполнения, 
		"ИС_МП_УправлениеЦенами.ПолучитьЦеныFBS", ПеречислениеМП, Профиль);

КонецФункции //- ИнфоСофт Мурсалимов Д.Р. 15.04.24 УА #66901

//+ ИнфоСофт Мурсалимов Д.Р. 15.04.24 УА #66901
&НаКлиенте
Процедура ПолучениеЦенЗавершение(Результат, ДополнительныеПараметры) Экспорт
	
	МП = Маркетплейс;
   
    Если ЗначениеЗаполнено(ДополнительныеПараметры) Тогда
    	
    	НайденныеСтроки = ТаблицаФоновыхЗаданий.НайтиСтроки(
    			Новый Структура("ИдентификаторЗадания", ДополнительныеПараметры));
    	
    	Если НайденныеСтроки.Количество() > 0 Тогда
    		МП = НайденныеСтроки[0].Маркетплейс;
    		ТаблицаФоновыхЗаданий.Удалить(НайденныеСтроки[0]);
    	КонецЕсли;	
    	
    КонецЕсли;
	
    Элементы[МП + "КартинкаОжидание"].Видимость = Ложь;
    
    Если Результат = Неопределено Тогда  // отменено пользователем
		Возврат;
	КонецЕсли;
    
	Если Результат.Статус = "Выполнено" Тогда
	    ОбработатьРезультатПолученияЦенНаСервере(Результат.АдресРезультата, МП);
	КонецЕсли;
	
	Если Результат.Статус = "Ошибка" Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю(Результат.ПодробноеПредставлениеОшибки);	
	КонецЕсли;
	
	Если Результат.Сообщения.Количество() > 0 Тогда
		
		Для Каждого Элемент Из Результат.Сообщения Цикл
			ОбщегоНазначенияКлиент.СообщитьПользователю(Элемент.Текст);
		КонецЦикла;
		
	КонецЕсли;
	
	УдалитьИзВременногоХранилища(Результат.АдресРезультата);
	
КонецПроцедуры //- ИнфоСофт Мурсалимов Д.Р. 15.04.24 УА #66901

//+ ИнфоСофт Мурсалимов Д.Р. 15.04.24 УА #66901
&НаСервере   
Процедура ОбработатьРезультатПолученияЦенНаСервере(Знач Адрес, Знач МП)
	
	Если МП = Неопределено Тогда
		МП = Маркетплейс;
	КонецЕсли;
	
	Цены = ПолучитьИзВременногоХранилища(Адрес);
	
    ПолеСопоставления = 
    	ИС_МП_УправлениеЦенами.ПолучитьПолеСопоставленияЦен(Перечисления.ИС_МП_Маркетплейсы[КонвертироватьМаркетплейс(МП)]);
    
    Таблица = ЭтотОбъект[МП + "ТаблицаВыгрузки"];	
	
	Если Цены = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если МП = "WildBerries" Тогда
		
		Для Каждого Строка Из Таблица Цикл
			
			Строка.ЦенаНаМаркетплейсе = 0;
			Строка.ЕстьЦенаНаМаркетплейсе = Ложь;
			
			Строка.СкидкаНаМаркетплейсе = 0;
			Строка.ЕстьСкидкаНаМаркетплейсе = Ложь;
			
			Строка.ЦенаСоСкидкойНаМаркетплейсе = 0;
			Строка.ЕстьЦенаСоСкидкойНаМаркетплейсе = Ложь;
			
		КонецЦикла;
		
		Для Каждого Строка Из Цены Цикл
			
			НайденныеСтроки = Таблица.НайтиСтроки(Новый Структура(ПолеСопоставления, Строка[ПолеСопоставления]));
			
			Если НайденныеСтроки.Количество() > 0 Тогда
				
				НайденныеСтроки[0].ЦенаНаМаркетплейсе = Строка.Цена;
				НайденныеСтроки[0].ЕстьЦенаНаМаркетплейсе = ЗначениеЗаполнено(Строка.Цена);
				
				НайденныеСтроки[0].СкидкаНаМаркетплейсе = Строка.Скидка;
				НайденныеСтроки[0].ЕстьСкидкаНаМаркетплейсе = ЗначениеЗаполнено(Строка.Скидка);
				
				НайденныеСтроки[0].ЦенаСоСкидкойНаМаркетплейсе = Строка.ЦенаСоСкидкой;
				НайденныеСтроки[0].ЕстьЦенаСоСкидкойНаМаркетплейсе = ЗначениеЗаполнено(Строка.ЦенаСоСкидкой);
				
			КонецЕсли;
			
		КонецЦикла;
		
	ИначеЕсли МП = "Ozon" Тогда
		
		Для Каждого Строка Из Таблица Цикл
			
			Строка.ЦенаНаМаркетплейсе = 0;
			Строка.ЕстьЦенаНаМаркетплейсе = Ложь;
			
			Строка.ЦенаСоСкидкойНаМаркетплейсе = 0;
			Строка.ЕстьЦенаСоСкидкойНаМаркетплейсе = Ложь;
			
			Строка.ЦенаМинимальнаяНаМаркетплейсе = 0;
			Строка.ЕстьЦенаМинимальнаяНаМаркетплейсе = Ложь;
			
			//+ ИнфоСофт Заварин К.В. 07.04.25 УА #89329
			Строка.ЦенаДляПокупателя = 0;
			Строка.ЕстьЦенаДляПокупателя = Ложь; 
			
			Строка.ЦенаВаша = 0;
			Строка.ЕстьЦенаВаша = Ложь;
			//- ИнфоСофт Заварин К.В. 07.04.25 УА #89329
			
		КонецЦикла;
		
		Для Каждого Строка Из Цены Цикл
			
			НайденныеСтроки = Таблица.НайтиСтроки(Новый Структура(ПолеСопоставления, Строка[ПолеСопоставления]));
			
			Если НайденныеСтроки.Количество() > 0 Тогда
				
				НайденныеСтроки[0].ЦенаНаМаркетплейсе = Строка.Цена;
				НайденныеСтроки[0].ЕстьЦенаНаМаркетплейсе = ЗначениеЗаполнено(Строка.Цена);
				
				НайденныеСтроки[0].ЦенаСоСкидкойНаМаркетплейсе = Строка.ЦенаСоСкидкой;
				НайденныеСтроки[0].ЕстьЦенаСоСкидкойНаМаркетплейсе = ЗначениеЗаполнено(Строка.ЦенаСоСкидкой); 
				
				НайденныеСтроки[0].ЦенаМинимальнаяНаМаркетплейсе = Строка.ЦенаМинимальная;
				НайденныеСтроки[0].ЕстьЦенаМинимальнаяНаМаркетплейсе = ЗначениеЗаполнено(Строка.ЦенаМинимальная);
				
				//+ ИнфоСофт Заварин К.В. 07.04.25 УА #89329
				НайденныеСтроки[0].ЦенаДляПокупателя = Строка.ЦенаДляПокупателя;
				НайденныеСтроки[0].ЕстьЦенаДляПокупателя = ЗначениеЗаполнено(Строка.ЦенаДляПокупателя); 
				
				НайденныеСтроки[0].ЦенаВаша = Строка.ЦенаВаша;
				НайденныеСтроки[0].ЕстьЦенаВаша = ЗначениеЗаполнено(Строка.ЦенаВаша);
				
				НайденныеСтроки[0].ТоварУчаствуетВАкции = Строка.ТоварУчаствуетВАкции;
				//- ИнфоСофт Заварин К.В. 07.04.25 УА #89329
				
			КонецЕсли;
			
		КонецЦикла;
		
	Иначе
		
		Для Каждого Строка Из Таблица Цикл
			
			Строка.ЦенаНаМаркетплейсе = 0;
			Строка.ЕстьЦенаНаМаркетплейсе = Ложь;
			
			Строка.ЦенаСоСкидкойНаМаркетплейсе = 0;
			Строка.ЕстьЦенаСоСкидкойНаМаркетплейсе = Ложь;
			
		КонецЦикла;
		
		Для Каждого Строка Из Цены Цикл
			
			НайденныеСтроки = Таблица.НайтиСтроки(Новый Структура(ПолеСопоставления, Строка[ПолеСопоставления]));
			
			Если НайденныеСтроки.Количество() > 0 Тогда
				
				НайденныеСтроки[0].ЦенаНаМаркетплейсе = Строка.Цена;
				НайденныеСтроки[0].ЕстьЦенаНаМаркетплейсе = ЗначениеЗаполнено(Строка.Цена);
								
				НайденныеСтроки[0].ЦенаСоСкидкойНаМаркетплейсе = Строка.ЦенаСоСкидкой;
				НайденныеСтроки[0].ЕстьЦенаСоСкидкойНаМаркетплейсе = ЗначениеЗаполнено(Строка.ЦенаСоСкидкой);
				
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЕсли;

КонецПроцедуры //- ИнфоСофт Мурсалимов Д.Р. 15.04.24 УА #66901

//+ ИнфоСофт Мурсалимов Д.Р. 15.04.24 УА #66901
// Отказываемся от асинхронности т.к. это основной функционал формы
&НаСервере   
Процедура ОбновитьСписокНаСервере()
    
    ПеречислениеМП = Перечисления.ИС_МП_Маркетплейсы[КонвертироватьМаркетплейс(Маркетплейс)];

	РежимОкругленияЦен = ЭтотОбъект[Маркетплейс + "РежимОкругленияЦен"];
	ИспользоватьПоследниеЦены = ЭтотОбъект[Маркетплейс + "ИспользоватьПоследниеЦены"];
	
	Таблица = ЭтотОбъект[Маркетплейс + "ТаблицаВыгрузки"];
	Таблица.Очистить();
	
	Запрос = Новый Запрос;
	Запрос.Текст = ИС_МП_УправлениеЦенами.ПолучитьТекстЗапросаЦен(ПеречислениеМП);
	
	ИС_МП_УправлениеЦенами.УстановитьПараметрыЗапросаЦен(ПеречислениеМП, Запрос, Профиль);
		
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаЦен = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаЦен.Следующий() Цикл
		
		НоваяСтрока = Таблица.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, ВыборкаЦен);
		
		Если ВыборкаЦен.ЕстьСопоставление Или ВыборкаЦен.ЕстьРучнаяЦена Тогда
			НоваяСтрока.Выгружать = Истина;
		КонецЕсли;
		
		ПересчитатьБудетВыгруженоНаСервере(Профиль, ПеречислениеМП, НоваяСтрока, ВыборкаЦен, РежимОкругленияЦен);
		
		ЗаполнитьКэшЦен(ПеречислениеМП, НоваяСтрока);
		
		Если ИспользоватьПоследниеЦены Тогда
			ПроверитьПоследниеВыгруженныеЦены(ПеречислениеМП, НоваяСтрока);
		КонецЕсли;
		
	КонецЦикла;
	
	Если ЭтотОбъект[Маркетплейс + "ТаблицаВыгрузки"].Количество() > 0 Тогда
		Элементы.ВыгрузитьЦены.Доступность = Истина;
	КонецЕсли;	
	
КонецПроцедуры //- ИнфоСофт Мурсалимов Д.Р. 15.04.24 УА #66901

//+ ИнфоСофт Мурсалимов Д.Р. 14.10.24 УА #83503
&НаСервере
Процедура ПересчитатьБудетВыгруженоНаСервере(Профиль, ПеречислениеМП, Строка, ВыборкаЦен, РежимОкругленияЦен) Экспорт
	
	Если ВыборкаЦен.ЕстьРучнаяЦена Тогда
		Цена = ВыборкаЦен.РучнаяЦена;
	Иначе  
		Цена = ВыборкаЦен.Цена;	
	КонецЕсли;
	
	Цена = Окр(Цена, 0, РежимОкругленияЦен);
	
	Строка.БудетВыгруженаЦена = Цена;
	
	Если ПеречислениеМП = Перечисления.ИС_МП_Маркетплейсы.ВБ Тогда
		
		Если ВыборкаЦен.ЕстьРучнаяЦенаСоСкидкой Тогда
			ЦенаСоСкидкой = ВыборкаЦен.РучнаяЦенаСоСкидкой;
		Иначе
