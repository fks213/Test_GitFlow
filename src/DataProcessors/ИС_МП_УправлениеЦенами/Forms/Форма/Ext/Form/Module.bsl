//+ ИнфоСофт Мурсалимов Д.Р. 15.04.24 УА #66901
&НаСервере
Процедура УстановитьУсловноеОформление()

	УсловноеОформление.Элементы.Очистить();

	МассивМаркетплейсов = Новый Массив; 
	МассивМаркетплейсов.Добавить("WildBerries");
	МассивМаркетплейсов.Добавить("Ozon");
	МассивМаркетплейсов.Добавить("Яндекс");
	МассивМаркетплейсов.Добавить("Сбер");
	МассивМаркетплейсов.Добавить("Aliexpress");
	
	//+ ИнфоСофт Власова И.С. 23.12.24 УА #90120
	МассивМаркетплейсов.Добавить("Ламода");
	//- ИнфоСофт Власова И.С. 23.12.24 УА #90120
	
	ТипЭлементОтбораКомпоновкиДанных = Тип("ЭлементОтбораКомпоновкиДанных");
	ОформлениеЦветТекста = "ЦветТекста";
	ОформлениеФормат = "Формат";
	ФорматНуля = "ЧН=0";
	
	Для Каждого Маркетплейс Из МассивМаркетплейсов Цикл
	    
	    // Отсутствует сопоставление
	    
		Элемент = УсловноеОформление.Элементы.Добавить();
		ПолеЭлемента = Элемент.Поля.Элементы.Добавить();
		ПолеЭлемента.Поле = Новый ПолеКомпоновкиДанных(Маркетплейс + "ТаблицаВыгрузки");
		
		ОтборЭлемента = Элемент.Отбор.Элементы.Добавить(ТипЭлементОтбораКомпоновкиДанных);
		ОтборЭлемента.ЛевоеЗначение = Новый ПолеКомпоновкиДанных(Маркетплейс + "ТаблицаВыгрузки.ЕстьСопоставление");
		ОтборЭлемента.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
		ОтборЭлемента.ПравоеЗначение = Ложь;

		Элемент.Оформление.УстановитьЗначениеПараметра(ОформлениеЦветТекста, ЦветаСтиля.ЦветОсобогоТекста);

		// Есть ручная цена
	    
		Элемент = УсловноеОформление.Элементы.Добавить();
		ПолеЭлемента = Элемент.Поля.Элементы.Добавить();
		ПолеЭлемента.Поле = Новый ПолеКомпоновкиДанных(Маркетплейс + "ТаблицаВыгрузкиРучнаяЦена");
		
		ОтборЭлемента = Элемент.Отбор.Элементы.Добавить(ТипЭлементОтбораКомпоновкиДанных);
		ОтборЭлемента.ЛевоеЗначение = Новый ПолеКомпоновкиДанных(Маркетплейс + "ТаблицаВыгрузки.ЕстьРучнаяЦена");
		ОтборЭлемента.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
		ОтборЭлемента.ПравоеЗначение = Истина;

		Элемент.Оформление.УстановитьЗначениеПараметра(ОформлениеЦветТекста, ЦветаСтиля.ЦветАкцента);
		Элемент.Оформление.УстановитьЗначениеПараметра(ОформлениеФормат, ФорматНуля);
		
		// Есть ручная скидка
	    
		Элемент = УсловноеОформление.Элементы.Добавить();
		ПолеЭлемента = Элемент.Поля.Элементы.Добавить();
		ПолеЭлемента.Поле = Новый ПолеКомпоновкиДанных(Маркетплейс + "ТаблицаВыгрузкиРучнаяСкидка");
		
		ОтборЭлемента = Элемент.Отбор.Элементы.Добавить(ТипЭлементОтбораКомпоновкиДанных);
		ОтборЭлемента.ЛевоеЗначение = Новый ПолеКомпоновкиДанных(Маркетплейс + "ТаблицаВыгрузки.ЕстьРучнаяСкидка");
		ОтборЭлемента.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
		ОтборЭлемента.ПравоеЗначение = Истина;

		Элемент.Оформление.УстановитьЗначениеПараметра(ОформлениеЦветТекста, ЦветаСтиля.ЦветАкцента); 
		Элемент.Оформление.УстановитьЗначениеПараметра(ОформлениеФормат, ФорматНуля);
		
		// Есть ручная цена минимальная
	    
		Элемент = УсловноеОформление.Элементы.Добавить();
		ПолеЭлемента = Элемент.Поля.Элементы.Добавить();
		ПолеЭлемента.Поле = Новый ПолеКомпоновкиДанных(Маркетплейс + "ТаблицаВыгрузкиРучнаяЦенаМинимальная");
		
		ОтборЭлемента = Элемент.Отбор.Элементы.Добавить(ТипЭлементОтбораКомпоновкиДанных);
		ОтборЭлемента.ЛевоеЗначение = Новый ПолеКомпоновкиДанных(Маркетплейс + "ТаблицаВыгрузки.ЕстьРучнаяЦенаМинимальная");
		ОтборЭлемента.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
