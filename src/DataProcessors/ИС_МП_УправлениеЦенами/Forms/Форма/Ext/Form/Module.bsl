	Если ПеречислениеМП = Перечисления.ИС_МП_Маркетплейсы.ВБ Тогда 
		
		Если ТекДанные.ЕстьРучнаяСкидка Или ТекДанные.РучнаяСкидкаИзменена Тогда
			
			ТекДанные.БудетВыгруженаЦенаСоСкидкой = Окр(ТекДанные.БудетВыгруженаЦена * (100 - ТекДанные.РучнаяСкидка) / 100, 0, РежимОкругленияЦен);	
			ТекДанные.Выгружать = Истина;
			
		КонецЕсли;
		
		ТекДанные.БудетВыгруженаСкидка = ТекДанные.РучнаяСкидка;
		
		Если ТекДанные.ЕстьПоследняяВыгруженнаяЦена И ТекДанные.ЕстьПоследняяВыгруженнаяЦенаСоСкидкой 
			И ТекДанные.БудетВыгруженаЦена = ТекДанные.ПоследняяВыгруженнаяЦена 
			И ТекДанные.БудетВыгруженаЦенаСоСкидкой = ТекДанные.ПоследняяВыгруженнаяЦенаСоСкидкой Тогда
			
			ТекДанные.Выгружать = Ложь;
			
			ТекДанные.БудетВыгруженаЦена = 0;
			ТекДанные.БудетВыгруженаЦенаСоСкидкой = 0;
			ТекДанные.БудетВыгруженаСкидка = 0;
			
		КонецЕсли;
		
	ИначеЕсли ПеречислениеМП = Перечисления.ИС_МП_Маркетплейсы.Озон Тогда 
		
		Если ТекДанные.ЕстьРучнаяСкидка Или ТекДанные.РучнаяСкидкаИзменена Тогда
			
			ТекДанные.БудетВыгруженаЦенаСоСкидкой = Окр(ТекДанные.БудетВыгруженаЦена * (100 - ТекДанные.РучнаяСкидка) / 100, 0, РежимОкругленияЦен);	
			ТекДанные.Выгружать = Истина;
			
		КонецЕсли;
		
		Если ТекДанные.ЕстьРучнаяЦенаМинимальная Или ТекДанные.РучнаяЦенаМинимальнаяИзменена Тогда	
			ТекДанные.БудетВыгруженаЦенаМинимальная = ТекДанные.РучнаяЦенаМинимальная;	
			ТекДанные.Выгружать = Истина;	
		КонецЕсли;
		
		Если ТекДанные.ЕстьПоследняяВыгруженнаяЦена И ТекДанные.ЕстьПоследняяВыгруженнаяЦенаСоСкидкой 
			И ТекДанные.ЕстьПоследняяВыгруженнаяЦенаМинимальная
			И ТекДанные.БудетВыгруженаЦена = ТекДанные.ПоследняяВыгруженнаяЦена 
			И ТекДанные.БудетВыгруженаЦенаСоСкидкой = ТекДанные.ПоследняяВыгруженнаяЦенаСоСкидкой
			И ТекДанные.БудетВыгруженаЦенаМинимальная = ТекДанные.ПоследняяВыгруженнаяЦенаМинимальная Тогда
			
			ТекДанные.Выгружать = Ложь;
			ТекДанные.БудетВыгруженаЦена = 0;
			ТекДанные.БудетВыгруженаЦенаСоСкидкой = 0;
			ТекДанные.БудетВыгруженаЦенаМинимальная = 0;
			
		КонецЕсли;
		
	ИначеЕсли ПеречислениеМП = Перечисления.ИС_МП_Маркетплейсы.Сбер Тогда
		
		Если ТекДанные.ЕстьПоследняяВыгруженнаяЦена И ТекДанные.БудетВыгруженаЦена = ТекДанные.ПоследняяВыгруженнаяЦена Тогда
			
			ТекДанные.Выгружать = Ложь;
			ТекДанные.БудетВыгруженаЦена = 0;
			
		КонецЕсли;
		
	Иначе
		
		Если ТекДанные.ЕстьРучнаяСкидка Или ТекДанные.РучнаяСкидкаИзменена Тогда
			
			ТекДанные.БудетВыгруженаЦенаСоСкидкой = Окр(ТекДанные.БудетВыгруженаЦена * (100 - ТекДанные.РучнаяСкидка) / 100, 0, РежимОкругленияЦен);	
			ТекДанные.Выгружать = Истина;
			
		КонецЕсли;
		
		Если ТекДанные.ЕстьПоследняяВыгруженнаяЦена И ТекДанные.ЕстьПоследняяВыгруженнаяЦенаСоСкидкой 
			И ТекДанные.БудетВыгруженаЦена = ТекДанные.ПоследняяВыгруженнаяЦена 
			И ТекДанные.БудетВыгруженаЦенаСоСкидкой = ТекДанные.ПоследняяВыгруженнаяЦенаСоСкидкой Тогда
			
			ТекДанные.Выгружать = Ложь;
			ТекДанные.БудетВыгруженаЦена = 0;
			ТекДанные.БудетВыгруженаЦенаСоСкидкой = 0;
			
		КонецЕсли;
		
	КонецЕсли;
	
	Если ИспользоватьПоследниеЦены Тогда
		ПроверитьПоследниеВыгруженныеЦены(ПеречислениеМП, ТекДанные);
	КонецЕсли;
			
КонецПроцедуры //- ИнфоСофт Мурсалимов Д.Р. 06.05.24 УА #66901

//+ ИнфоСофт Мурсалимов Д.Р. 06.05.24 УА #66901
&НаСервере   
Процедура СохранитьИзмененияНаСервере()
		
	ПеречислениеМП = Перечисления.ИС_МП_Маркетплейсы[КонвертироватьМаркетплейс(Маркетплейс)];    
	ПолеСопоставление = ИС_МП_УправлениеЦенами.ПолучитьПолеСопоставленияЦен(ПеречислениеМП);
	
	Для Каждого Строка Из ЭтотОбъект[Маркетплейс + "ТаблицаВыгрузки"] Цикл
	    
		Если Строка.РучнаяЦенаИзменена Тогда

			ИС_МП_УправлениеЦенами.ЗаписатьРучнуюЦену(
				Профиль, ПеречислениеМП, Строка[ПолеСопоставление], Строка.РучнаяЦена, Перечисления.ИС_МП_ВидыЦенМаркетплейса.ВидЦены);

			Строка.ЕстьРучнаяЦена = Истина;
			Строка.РучнаяЦенаИзменена = Ложь;

		КонецЕсли;
		
		Если Строка.РучнаяСкидкаИзменена Тогда
			
			ЦенаСоСкидкой = Окр(Строка.БудетВыгруженаЦена * (100 - Строка.РучнаяСкидка) / 100, 0, РежимОкругленияЦен);
			
			ИС_МП_УправлениеЦенами.ЗаписатьРучнуюЦену(
				Профиль, ПеречислениеМП, Строка[ПолеСопоставление], ЦенаСоСкидкой, Перечисления.ИС_МП_ВидыЦенМаркетплейса.ВидЦеныСоСкидкой);
	
		    Строка.ЕстьРучнаяСкидка = Истина;
			Строка.РучнаяСкидкаИзменена = Ложь;
		
		КонецЕсли;
		
		Если Строка.Свойство("РучнаяЦенаМинимальнаяИзменена") И Строка.РучнаяЦенаМинимальнаяИзменена Тогда
		
			ИС_МП_УправлениеЦенами.ЗаписатьРучнуюЦену(
				Профиль, ПеречислениеМП, Строка[ПолеСопоставление], Строка.РучнаяЦенаМинимальная, Перечисления.ИС_МП_ВидыЦенМаркетплейса.ВидЦеныМинимальный);
	
		    Строка.ЕстьРучнаяЦенаМинимальная = Истина;
			Строка.РучнаяЦенаМинимальнаяИзменена = Ложь;
		
		КонецЕсли;
		
	КонецЦикла;
		
КонецПроцедуры //- ИнфоСофт Мурсалимов Д.Р. 06.05.24 УА #66901

