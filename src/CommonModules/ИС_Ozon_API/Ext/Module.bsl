//+ ИнфоСофт Стояк Ю.К. 22.01.2024 УА #61983
// Получить атрибуты товаров POST /v3/products/info/attributes
//
// Параметры:
//  ПараметрыПодключения - Структура.
//  offer_id	 - Массив из Строка	 - Идентификатор товара в системе продавца - артикул.
//  product_id	 - Массив из Число	 - Идентификатор товара.
//	visibility 	- Строка 			- Фильтр по видимости товара, возможные значения:
// 									ALL - все товары.
//									VISIBLE - товары, которые видны покупателям.
//									INVISIBLE - товары, которые по какой-то из причин не видны покупателям.
//									EMPTY_STOCK - товары, у которых не указано наличие.
//									NOT_MODERATED - товары, которые не прошли модерацию.
//									MODERATED - товары, которые прошли модерацию.
//									DISABLED - товары, которые видны покупателям, но недоступны к покупке.
//									STATE_FAILED - товары, создание которых завершилось ошибĸой.
//									READY_TO_SUPPLY - товары, готовые к поставке.
//									VALIDATION_STATE_PENDING - товары, которые проходят проверку на премодерации (валидатором).
//									VALIDATION_STATE_FAIL - товары, которые не прошли проверку на премодерации (валидатором).
//									VALIDATION_STATE_SUCCESS - товары, которые прошли проверку на премодерации (валидатором).
//									TO_SUPPLY - товары, готовые к продаже.
//									IN_SALE - товары в продаже.
//									REMOVED_FROM_SALE - товары, скрытые от покупателей.
//									BANNED - заблокированные товары.
//									OVERPRICED - товары с завышенной ценой.
//									CRITICALLY_OVERPRICED - товары со слишком завышенной ценой.
//									EMPTY_BARCODE - товары без штрихкода.
//									BARCODE_EXISTS - товары со штрихкодом.
//									QUARANTINE - товары на карантине после изменения цены более чем на 50%.
//									ARCHIVED - товары в архиве.
//									OVERPRICED_WITH_STOCK - товары в продаже со стоимостью выше, чем у конкурентов.
//									PARTIAL_APPROVED - товары в продаже с пустым или неполным описанием.
//									IMAGE_ABSENT - товары без изображений.
//									MODERATION_BLOCK - товары, для которых заблокирована модерация.
//  limit		- Число  - Количество значений на странице.
//  last_id	 	- Строка - Идентификатор последнего значения на странице. Оставьте это поле пустым при выполнении первого 
//  						запроса. Чтобы получить следующие значения, укажите last_id из ответа предыдущего запроса.
// 
// Возвращаемое значение:
//  Массив из Соответствие:
//		* attributes - Массив из Соответствие - Массив с характеристиками товара. Характеристики отличаются для разных категорий:
//			** attributeId  - Число - Идентификатор характеристики. 
//			** complex_id   - Число - Идентификатор характеристики, которая поддерживает вложенные свойства. Например, у характеристики Процессор есть вложенные характеристики Производитель, L2 Cache, и другие. У каждой из вложенных характеристик может быть несколько вариантов значений.
//			** value   		- Массив из Соответствие - Массив вложенных значений характеристики:
//				*** dictionaryValueId   - Число  - Идентификатор справочника.
//				*** value   			- Строка - Значение справочника.
//		* barcode 			- Строка - Штрихкод товара.
//		* category_id 		- Число  - Идентификатор категории.
//		* color_image		- Строка - Маркетинговый цвет.
//		* complex_attributes - Массив из Соответствие - Массив характеристик:
//			** attributes - Массив из Соответствие - Массив характеристик:
//				*** complex_id   - Число - Идентификатор характеристики, которая поддерживает вложенные свойства. Например, у характеристики Процессор есть вложенные характеристики Производитель, L2 Cache, и другие. У каждой из вложенных характеристик может быть несколько вариантов значений.
//				*** attributeId  - Число  - Идентификатор характеристики.
//				*** value - Массив из Соответствие - Массив вложенных значений характеристики:
//					**** dictionaryValueId   	- Число  - Идентификатор справочника.
//					**** value   				- Строка - Значение справочника.
//		* depth  			- Число  - Глубина упаковки.
//		* dimension_unit  	- Строка - Единица измерения габаритов. mm - миллиметры, cm - сантиметры, in - дюймы.
//		* height   			- Число  - Высота упаковки.
//		* id	   			- Число  - ?.
//		* image_group_id   	- Строка - Идентификатор для последующей пакетной загрузки изображений.
//		* images - Массив из Соответствие - Массив с изображениями:
//			** default  	- Булево - Изображение по умолчанию. 
//			** file_name   	- Строка - Наименование изображения.
//			** index   		- Число  - Идентификатор изображения.
//		* images360 - Массив из Соответствие - Массив с изображениями:
//			** file_name  	- Строка - Наименование изображения. 
//			** index   		- Число  - Идентификатор изображения.
//		* name   			- Строка - Название товара.
//		* offer_id   		- Строка - Идентификатор товара в системе продавца - артикул.
//		* pdf_list    		- Массив из Соответствие - Массив pdf-файлов:
//			** index   		- Число  - Индекс файла.
//			** file_name    - Строка - URL ссылка на файл.
//			** name  		- Строка - Наименование файла.
//		* weight     		- Число  - Вес товара в упаковке.
//		* weight_unit      	- Строка - Единицы измерения веса: g - граммы, kg - килограммы, lb - фунты.
//		* width       		- Число  - Ширина упаковки.
//
Функция ПолучитьАтрибутыТоваров(ПараметрыЗапроса, offer_id = Неопределено, product_id = Неопределено, visibility = "ALL") Экспорт

	limit = 1000; 
	last_id = "";
	
	//+ ИнфоСофт Стояк Ю.К. 26.01.2025 УА #91698	
	//ПараметрыЗапроса.АдресРесурса = "/v3/products/info/attributes";
	ПараметрыЗапроса.АдресРесурса = "/v4/products/info/attributes";
	//- ИнфоСофт Стояк Ю.К. 26.01.2025 УА #91698
	ПараметрыЗапроса.ФорматОтвета = "Строка";

	ИмяПроцедуры = "ПолучитьАтрибутыТоваров";	

	Результат = Новый Массив;

	filter = Новый Структура;
	filter.Вставить("visibility", visibility);

	Если ЗначениеЗаполнено(offer_id) Тогда
		filter.Вставить("offer_id", offer_id);
	КонецЕсли;
	Если ЗначениеЗаполнено(product_id) Тогда
		filter.Вставить("product_id", product_id);
	КонецЕсли;

	Тело = Новый Структура;
	Тело.Вставить("filter", filter);
	Тело.Вставить("limit", limit);

	ВыполнитьЗапрос = Истина;
	Пока ВыполнитьЗапрос Цикл

		Тело.Вставить("last_id", last_id);

		ПараметрыЗапроса.ТелоСтрока = ИС_MP_РаботаСHTTPЗапросамиСервер.ПолучитьСтрокуJSON(Тело);  
		
		РезультатЗапроса = ИС_MP_РаботаСHTTPЗапросамиСервер.ОтправитьPOSTЗапрос(ПараметрыЗапроса);
		
		Если РезультатЗапроса.ЕстьОшибки Тогда
			Текст = СтрШаблон("Произошла ошибка при отправке запроса: %1",	РезультатЗапроса.ИнформацияОбОшибке.Описание); 
			ОбщегоНазначения.СообщитьПользователю(Текст);  			
		Иначе
			
			Если РезультатЗапроса.КодОтвета = 200 Тогда
				
				JSON = ИС_MP_РаботаСHTTPЗапросамиСервер.ПолучитьОбъектJSON(РезультатЗапроса.Ответ);
				
				Если ТипЗнч(JSON) = Тип("Структура") Тогда				
					result = JSON.result;
					last_id = JSON.last_id;
				Иначе
					Текст = СтрШаблон("Получен нераспознанный ответ от сервера: %1", РезультатЗапроса.Ответ);
					ОбщегоНазначения.СообщитьПользователю(Текст);					
					result = Неопределено;
				КонецЕсли;
				
			Иначе
				
				РазобратьHTTPОтветПоКоду(РезультатЗапроса);				
				result = Неопределено;
			КонецЕсли;
			
		КонецЕсли;
		

		Если ЗначениеЗаполнено(result) Тогда
			ОбщегоНазначенияКлиентСервер.ДополнитьМассив(Результат, result);
			Если result.Количество() < limit Тогда
				Прервать;
			КонецЕсли;
		Иначе
			Прервать;
		КонецЕсли;

	КонецЦикла;

	Возврат Результат;

КонецФункции //- ИнфоСофт Стояк Ю.К. 22.01.2024 УА #61983

