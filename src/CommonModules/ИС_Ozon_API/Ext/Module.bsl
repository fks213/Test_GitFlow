Функция ЗагрузитьТоварыНаOzon(ПараметрыЗапроса, items) Экспорт
	
	//+ ИнфоСофт Стояк Ю.К. 05.03.2024 УА #71269	
	//ПараметрыЗапроса.АдресРесурса = "/v2/product/import";
	ПараметрыЗапроса.АдресРесурса = "/v3/product/import";
