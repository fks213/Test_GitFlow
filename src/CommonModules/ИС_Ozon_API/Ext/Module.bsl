//+ ИнфоСофт Ивонин К.А. 10.04.23 УА #57127
Функция ПолучитьСписокТоваров(Профиль, ПараметрыЗапроса, СтруктураЗапроса) Экспорт

	ПараметрыЗапроса.Заголовки.Вставить("Content-Type",   "application/json; charset=utf-8");
	ПараметрыЗапроса.Заголовки.Вставить("Accept-Charset", "utf-8");
	//+ ИнфоСофт Стояк Ю.К. 26.01.2025 УА #91698	
	//ПараметрыЗапроса.АдресРесурса = "/v2/product/list";
	ПараметрыЗапроса.АдресРесурса = "/v3/product/list";
	//- ИнфоСофт Стояк Ю.К. 26.01.2025 УА #91698
	ПараметрыЗапроса.ФорматОтвета = "Строка";
	
	ПараметрыЗапроса.ТелоСтрока = ИС_MP_РаботаСHTTPЗапросамиСервер.ПолучитьСтрокуJSON(СтруктураЗапроса); 
	
	РезультатЗапроса = ИС_MP_РаботаСHTTPЗапросамиСервер.ОтправитьPOSTЗапрос(ПараметрыЗапроса);
	
	//+ ИнфоСофт Заварин К.В. 24.05.24 УА #76506
	ЗаписатьДанныеОтладки(Профиль, Перечисления.ИС_МП_МетодыHTTP.POST, ПараметрыЗапроса, РезультатЗапроса);
    //- ИнфоСофт Заварин К.В. 24.05.24 УА #76506
	
	Если РезультатЗапроса.ЕстьОшибки Тогда
		Текст = СтрШаблон("Произошла ошибка при отправке запроса: %1",	РезультатЗапроса.ИнформацияОбОшибке.Описание); 
		ОбщегоНазначения.СообщитьПользователю(Текст);  
		Возврат Неопределено;	
	Иначе
	
		Если РезультатЗапроса.КодОтвета = 200 Тогда
		
			JSON = ИС_MP_РаботаСHTTPЗапросамиСервер.ПолучитьОбъектJSON(РезультатЗапроса.Ответ, Истина);
			
			Если ТипЗнч(JSON) = Тип("Соответствие") Тогда				
				Возврат JSON["result"];	
			Иначе
				Текст = СтрШаблон("Получен нераспознанный ответ от сервера: %1", РезультатЗапроса.Ответ);
			 	ОбщегоНазначения.СообщитьПользователю(Текст);
				Возврат Неопределено;
			КонецЕсли;
			
		Иначе
			
			РазобратьHTTPОтветПоКоду(РезультатЗапроса);
			Возврат Неопределено;
		
		КонецЕсли;
			
	КонецЕсли;
	
КонецФункции //- ИнфоСофт Ивонин К.А. 10.04.23 УА #57127

//+ ИнфоСофт Ивонин К.А. 10.04.23 УА #57127
Функция ПолучитьСписокТоваровПоИдентификаторам(Профиль, ПараметрыЗапроса, МассивИдентификаторов) Экспорт

	ПараметрыЗапроса.Заголовки.Вставить("Content-Type",   "application/json; charset=utf-8");
	ПараметрыЗапроса.Заголовки.Вставить("Accept-Charset", "utf-8");
	//+ ИнфоСофт Стояк Ю.К. 26.01.2025 УА #91698	
	//ПараметрыЗапроса.АдресРесурса = "/v2/product/info/list";
	ПараметрыЗапроса.АдресРесурса = "/v3/product/info/list";
	//- ИнфоСофт Стояк Ю.К. 26.01.2025 УА #91698
	ПараметрыЗапроса.ФорматОтвета = "Строка";
	
	СтруктураЗапроса = Новый Структура("offer_id", МассивИдентификаторов);
	
	ПараметрыЗапроса.ТелоСтрока = ИС_MP_РаботаСHTTPЗапросамиСервер.ПолучитьСтрокуJSON(СтруктураЗапроса); 
	
	РезультатЗапроса = ИС_MP_РаботаСHTTPЗапросамиСервер.ОтправитьPOSTЗапрос(ПараметрыЗапроса);
	
	//+ ИнфоСофт Заварин К.В. 24.05.24 УА #76506
	ЗаписатьДанныеОтладки(Профиль, Перечисления.ИС_МП_МетодыHTTP.POST, ПараметрыЗапроса, РезультатЗапроса);
    //- ИнфоСофт Заварин К.В. 24.05.24 УА #76506
	
	Если РезультатЗапроса.ЕстьОшибки Тогда
		Текст = СтрШаблон("Произошла ошибка при отправке запроса: %1",	РезультатЗапроса.ИнформацияОбОшибке.Описание); 
		ОбщегоНазначения.СообщитьПользователю(Текст);  
		Возврат Неопределено;	
	Иначе
	
		Если РезультатЗапроса.КодОтвета = 200 Тогда
		
			JSON = ИС_MP_РаботаСHTTPЗапросамиСервер.ПолучитьОбъектJSON(РезультатЗапроса.Ответ, Истина);
			
			Если ТипЗнч(JSON) = Тип("Соответствие") Тогда
				//+ ИнфоСофт Стояк Ю.К. 26.01.2025 УА #91698				
				//Возврат JSON["result"];	                    
				Возврат JSON;	                    
				//- ИнфоСофт Стояк Ю.К. 26.01.2025 УА #91698
			Иначе
				Текст = СтрШаблон("Получен нераспознанный ответ от сервера: %1", РезультатЗапроса.Ответ);
			 	ОбщегоНазначения.СообщитьПользователю(Текст);
				Возврат Неопределено;
			КонецЕсли;
			
		Иначе
			
			РазобратьHTTPОтветПоКоду(РезультатЗапроса);
			Возврат Неопределено;
		
		КонецЕсли;
			
	КонецЕсли;
	
КонецФункции //- ИнфоСофт Ивонин К.А. 10.04.23 УА #57127

