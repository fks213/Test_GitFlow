//+ ИнфоСофт Украинцева А.А. 16.11.2023 УА #61983 
// Лимиты на ассортимент, создание и обновление товаров. http метод POST /v4/product/info/limit
// Метод для получения информации о лимитах:
// На ассортимент - сколько всего товаров можно создать в вашем личном кабинете.
// На создание товаров - сколько товаров можно создать в сутки.
// На обновление товаров - сколько товаров можно отредактировать в сутки.
// Если у вас есть лимит на ассортимент и вы израсходуете его, вы не сможете создавать новые товары.
//
// Параметры:
// 	ПараметрыПодключения - Структура - Параметры подключения к API OzonSeller.
// 	
// Возвращаемое значение:
//  - Соответствие - Результат:
//		* daily_create - Соответствие - Суточный лимит на создание товаров:
//			** limit - Число - Сколько всего товаров можно создать в сутки.
//			** reset_at - Строка - Время в формате UTC, когда сбросится значение счётчика за текущие сутки.
//			** usage - Число - Сколько товаров создано за текущие сутки.
//		* daily_update - Соответствие - Суточный лимит на обновление товаров:
//			** limit - Число - Сколько всего товаров можно обновить в сутки.
//			** reset_at - Строка - Время в формате UTC, когда сбросится значение счётчика за текущие сутки.
//			** usage - Число - Сколько товаров обновлено за текущие сутки.
//		* total - Соответствие - Лимит на ассортимент:
//			** limit - Число - Сколько всего товаров можно создать в личном кабинете.
//			** usage - Число - Сколько товаров уже создано.
//
Функция ЛимитыНаАссортиментСозданиеИОбновлениеТоваров(ПараметрыЗапроса) Экспорт
	
	Результат = Новый Соответствие;     
	
		
	ПараметрыЗапроса.Заголовки.Вставить("Content-Type",   "application/json; charset=utf-8");
	ПараметрыЗапроса.Заголовки.Вставить("Accept-Charset", "utf-8");  
	
	ПараметрыЗапроса.АдресРесурса = "/v4/product/info/limit";
	ПараметрыЗапроса.ФорматОтвета = "Строка";
	
	РезультатЗапроса = ИС_MP_РаботаСHTTPЗапросамиСервер.ОтправитьPOSTЗапрос(ПараметрыЗапроса);
	
	Если РезультатЗапроса.ЕстьОшибки Тогда
		Текст = СтрШаблон("Произошла ошибка при отправке запроса: %1",	РезультатЗапроса.ИнформацияОбОшибке.Описание); 
		ОбщегоНазначения.СообщитьПользователю(Текст);  
		Возврат Неопределено;	
	Иначе
	
		Если РезультатЗапроса.КодОтвета = 200 Тогда
		
			JSON = ИС_MP_РаботаСHTTPЗапросамиСервер.ПолучитьОбъектJSON(РезультатЗапроса.Ответ, Истина);
			
			Если ТипЗнч(JSON) = Тип("Соответствие") Тогда				
				Возврат JSON;	
			Иначе
				Текст = СтрШаблон("Получен нераспознанный ответ от сервера: %1", РезультатЗапроса.Ответ);
			 	ОбщегоНазначения.СообщитьПользователю(Текст);
				Возврат Неопределено;
			КонецЕсли;
			
		Иначе
			
			РазобратьHTTPОтветПоКоду(РезультатЗапроса);
			Возврат Неопределено;
		
		КонецЕсли;			
	КонецЕсли;  	
КонецФункции //- ИнфоСофт Украинцева А.А. 16.11.2023 УА #61983

