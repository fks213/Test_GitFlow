Функция ПолучитьСтруктуруПараметровЗапросаСпискаТоваров(limit = 1, last_id = "") Экспорт
	
	Результат = Новый Структура;
	
	СтруктураFilter = Новый Структура("visibility", "ALL");
     
    Результат.Вставить("filter", СтруктураFilter);
	Результат.Вставить("limit", limit);
	Результат.Вставить("last_id", last_id);
	
	Возврат Результат;
	
