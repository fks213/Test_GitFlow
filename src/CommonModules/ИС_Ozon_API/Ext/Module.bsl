Функция ПолучитьЗначенияАтрибутаКатегории(ПараметрыЗапроса, type_id, attribute_id, description_category_id, last_value_id = 0,
	limit = 2500, language = "RU") Экспорт
	
	//+ ИнфоСофт Стояк Ю.К. 05.03.2024 УА #71269	
	//ПараметрыЗапроса.АдресРесурса = "/v2/category/attribute/values";
	ПараметрыЗапроса.АдресРесурса = "/v1/description-category/attribute/values";
	//- ИнфоСофт Стояк Ю.К. 05.03.2024 УА #71269
	ПараметрыЗапроса.ФорматОтвета = "Строка";

	ИмяПроцедуры = "ПолучитьЗначенияАтрибутаКатегории";	

	Результат = Новый Массив;

	Тело = Новый Структура;                                         
	//+ ИнфоСофт Стояк Ю.К. 05.03.2024 УА #71269	
	Тело.Вставить("type_id", type_id);
	Тело.Вставить("description_category_id", description_category_id);
	//- ИнфоСофт Стояк Ю.К. 05.03.2024 УА #71269
	Тело.Вставить("attribute_id", attribute_id);
	Тело.Вставить("language", language);
	Тело.Вставить("limit", limit);

	ВыполнитьЗапрос = Истина;
	Пока ВыполнитьЗапрос Цикл

		Тело.Вставить("last_value_id", last_value_id);		
		
		ПараметрыЗапроса.ТелоСтрока = ИС_MP_РаботаСHTTPЗапросамиСервер.ПолучитьСтрокуJSON(Тело);  
		
		РезультатЗапроса = ИС_MP_РаботаСHTTPЗапросамиСервер.ОтправитьPOSTЗапрос(ПараметрыЗапроса); 
				
		Если РезультатЗапроса.ЕстьОшибки Тогда
			Текст = СтрШаблон("Произошла ошибка при отправке запроса: %1",	РезультатЗапроса.ИнформацияОбОшибке.Описание); 
			ОбщегоНазначения.СообщитьПользователю(Текст);  			
		Иначе
			
			Если РезультатЗапроса.КодОтвета = 200 Тогда
				
				JSON = ИС_MP_РаботаСHTTPЗапросамиСервер.ПолучитьОбъектJSON(РезультатЗапроса.Ответ);
				
				Если ТипЗнч(JSON) = Тип("Структура") Тогда				
					result = JSON.result;
					Если ЗначениеЗаполнено(result) Тогда
						ОбщегоНазначенияКлиентСервер.ДополнитьМассив(Результат, result); 
						last_value_id = result[result.ВГраница()].id;
					КонецЕсли;
					ВыполнитьЗапрос = JSON.has_next;
				Иначе
					Текст = СтрШаблон("Получен нераспознанный ответ от сервера: %1", РезультатЗапроса.Ответ);
					ОбщегоНазначения.СообщитьПользователю(Текст);					
				КонецЕсли;
				
			Иначе
				
				РазобратьHTTPОтветПоКоду(РезультатЗапроса);				
				
			КонецЕсли;
			
		КонецЕсли;

		Если Не ЗначениеЗаполнено(ВыполнитьЗапрос) Тогда
			Прервать;
		КонецЕсли;

	КонецЦикла;

	Возврат Результат;

