//+ ИнфоСофт Стояк Ю.К. 20.01.2024 УА #61983
// Список сертификатов. http метод POST /v1/product/certification/list
//
// Параметры:
//  ПараметрыПодключения - Структура.
//  page		 - Число - Номер страницы, возвращаемой в запросе.
//  page_size	 - Число - Количество элементов на странице.
// 
// Возвращаемое значение:
//  Массив из Соответствие - Список сертификатов:
//		* category_name - Строка - Наименование категории товаров.
//		* is_required 	- Булево - Используется сертификат.
//        
Функция КатегорииСОбязатетльнымиСертификатами(ПараметрыЗапроса, page = 1, page_size = 250) Экспорт 
	
	ПараметрыЗапроса.АдресРесурса = "/v1/product/certification/list";
	ПараметрыЗапроса.ФорматОтвета = "Строка";	

	Результат = Новый Массив;

	Тело = Новый Структура;
	Тело.Вставить("page_size", page_size);

	НомерСтраницы = 1;
	ВыполнитьЗапрос = Истина;
	
	Пока ВыполнитьЗапрос Цикл

		Тело.Вставить("page", НомерСтраницы);
		
		ПараметрыЗапроса.ТелоСтрока = ИС_MP_РаботаСHTTPЗапросамиСервер.ПолучитьСтрокуJSON(Тело);  
		
		РезультатЗапроса = ИС_MP_РаботаСHTTPЗапросамиСервер.ОтправитьPOSTЗапрос(ПараметрыЗапроса);
		
		Если РезультатЗапроса.ЕстьОшибки Тогда
			Текст = СтрШаблон("Произошла ошибка при отправке запроса: %1",	РезультатЗапроса.ИнформацияОбОшибке.Описание); 
			ОбщегоНазначения.СообщитьПользователю(Текст);  
			result = Неопределено;	
		Иначе
			
			Если РезультатЗапроса.КодОтвета = 200 Тогда
				
				JSON = ИС_MP_РаботаСHTTPЗапросамиСервер.ПолучитьОбъектJSON(РезультатЗапроса.Ответ);
				
				Если ТипЗнч(JSON) = Тип("Структура") Тогда				
					result = JSON.result.certification;	
				Иначе
					Текст = СтрШаблон("Получен нераспознанный ответ от сервера: %1", РезультатЗапроса.Ответ);
					ОбщегоНазначения.СообщитьПользователю(Текст);
					result = Неопределено;
				КонецЕсли;
				
			Иначе
				
				РазобратьHTTPОтветПоКоду(РезультатЗапроса);
				result = Неопределено;
				
			КонецЕсли;
			
		КонецЕсли;

		Если ЗначениеЗаполнено(result) Тогда
			ОбщегоНазначенияКлиентСервер.ДополнитьМассив(Результат, result);
			Если result.Количество() < page_size Тогда
				Прервать;
			КонецЕсли;
		Иначе
			Прервать;
		КонецЕсли;

		НомерСтраницы = НомерСтраницы + 1;

	КонецЦикла;  
	
	Возврат Результат;

КонецФункции //- ИнфоСофт Стояк Ю.К. 20.01.2024 УА #61983

