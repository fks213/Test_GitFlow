//+ ИнфоСофт Мурсалимов Д.Р. 15.08.24 УА #81483
Функция РассчитатьЦеныНаборов(Профиль, ПеречислениеМП, ВыборкаЦен) Экспорт
		
	Результат = Новый Структура;
	
	МассивПараметров = ПолучитьСписокПараметровЦен(ПеречислениеМП);
	
	Результат = ИС_MP_Сервер.ПолучитьЗначениеНастроек(Профиль, ПеречислениеМП, МассивПараметров);
	
	СтруктураЦен = ПолучитьСтруктуруПараметровЦен(ПеречислениеМП);
	
	ЗаполнитьЗначенияСвойств(СтруктураЦен, Результат);
	
	Если ПеречислениеМП = Перечисления.ИС_МП_Маркетплейсы.ВБ Тогда
		
		ЦенаНабора 			= РассчитатьЦенуНабора(ВыборкаЦен, СтруктураЦен.ВидЦены, "Цена");
		ЦенаНабораСоСкидкой = РассчитатьЦенуНабора(ВыборкаЦен, СтруктураЦен.ВидЦеныСоСкидкой, "ЦенаСоСкидкой");
		
		//+ ИнфоСофт Заварин К.В. 03.09.24 УА #72696
		ЦенаНабораFBO 		= РассчитатьЦенуНабора(ВыборкаЦен, СтруктураЦен.ВидЦеныFBO, "ЦенаFBO");
		//- ИнфоСофт Заварин К.В. 03.09.24 УА #72696 
		
		Результат.Вставить("Цена", 				ЦенаНабора);
		Результат.Вставить("ЦенаСоСкидкой", 	ЦенаНабораСоСкидкой);
		
		//+ ИнфоСофт Заварин К.В. 03.09.24 УА #72696
		Результат.Вставить("ЦенаFBO", 			ЦенаНабораFBO);
		//- ИнфоСофт Заварин К.В. 03.09.24 УА #72696	
		
	ИначеЕсли ПеречислениеМП = Перечисления.ИС_МП_Маркетплейсы.Озон Тогда

		ЦенаНабора 				= РассчитатьЦенуНабора(ВыборкаЦен, СтруктураЦен.ВидЦены, "Цена");
		ЦенаНабораСоСкидкой 	= РассчитатьЦенуНабора(ВыборкаЦен, СтруктураЦен.ВидЦеныСоСкидкой, "ЦенаСоСкидкой");
		ЦенаНабораМинимальная 	= РассчитатьЦенуНабора(ВыборкаЦен, СтруктураЦен.ВидЦеныМинимальный, "ЦенаМинимальная");
		
		Результат.Вставить("Цена", 				ЦенаНабора);
		Результат.Вставить("ЦенаСоСкидкой", 	ЦенаНабораСоСкидкой);
		Результат.Вставить("ЦенаМинимальная", 	ЦенаНабораМинимальная);	
		
	ИначеЕсли ПеречислениеМП = Перечисления.ИС_МП_Маркетплейсы.ЯМ Тогда
		
		ЦенаНабора 				= РассчитатьЦенуНабора(ВыборкаЦен, СтруктураЦен.ВидЦены, "Цена");
		ЦенаНабораСоСкидкой 	= РассчитатьЦенуНабора(ВыборкаЦен, СтруктураЦен.ВидЦеныСоСкидкой, "ЦенаСоСкидкой");	
		
		Результат.Вставить("Цена", 				ЦенаНабора);
		Результат.Вставить("ЦенаСоСкидкой", 	ЦенаНабораСоСкидкой);
		
	ИначеЕсли ПеречислениеМП = Перечисления.ИС_МП_Маркетплейсы.Сбер Тогда
		
		ЦенаНабора 				= РассчитатьЦенуНабора(ВыборкаЦен, СтруктураЦен.ВидЦены, "Цена");
		
		Результат.Вставить("Цена", 				ЦенаНабора);
		
	ИначеЕсли ПеречислениеМП = Перечисления.ИС_МП_Маркетплейсы.Али Тогда
		
		ЦенаНабора 				= РассчитатьЦенуНабора(ВыборкаЦен, СтруктураЦен.ВидЦены, "Цена");
		ЦенаНабораСоСкидкой 	= РассчитатьЦенуНабора(ВыборкаЦен, СтруктураЦен.ВидЦеныСоСкидкой, "ЦенаСоСкидкой");
		
		Результат.Вставить("Цена", ЦенаНабора);
		Результат.Вставить("ЦенаСоСкидкой", ЦенаНабораСоСкидкой); 	
	
	//+ ИнфоСофт Власова И.С. 23.12.24 УА #90120
	ИначеЕсли ПеречислениеМП = Перечисления.ИС_МП_Маркетплейсы.Ламода Тогда
		
		ЦенаНабора 				= РассчитатьЦенуНабора(ВыборкаЦен, СтруктураЦен.ВидЦены,          "Цена");
		ЦенаНабораСоСкидкой 	= РассчитатьЦенуНабора(ВыборкаЦен, СтруктураЦен.ВидЦеныСоСкидкой, "ЦенаСоСкидкой");
		
		Результат.Вставить("Цена",          ЦенаНабора);
		Результат.Вставить("ЦенаСоСкидкой", ЦенаНабораСоСкидкой);
	//- ИнфоСофт Власова И.С. 23.12.24 УА #90120
	
	КонецЕсли;
	
	Возврат Результат;

КонецФункции //- ИнфоСофт Мурсалимов Д.Р. 15.08.24 УА #81483

//+ ИнфоСофт Мурсалимов Д.Р. 16.08.24 УА #81483
Функция РассчитатьЦенуНабора(ВыборкаЦен, ВидЦены, ЦенаПоВидуЦен)

	Валюта = Неопределено;
	ИС_МП_УправлениеЗаказами.ОбработатьВалютуXML(Валюта, "643");
	
	Результат = 0;
	
	Цена = ВыборкаЦен[ЦенаПоВидуЦен];
	
	ПараметрыКомплектующих = ПодборТоваровКлиентСервер.ПараметрыТовара();
	ПараметрыКомплектующих.Номенклатура   			= ВыборкаЦен.Номенклатура;
	ПараметрыКомплектующих.НоменклатураНабора   	= ВыборкаЦен.Номенклатура;
	ПараметрыКомплектующих.ХарактеристикаНабора 	= ВыборкаЦен.Характеристика;				
	ПараметрыКомплектующих.КоличествоУпаковок		= 1;
	
	ДополнительныеПараметры = Новый Структура;
	ДополнительныеПараметры.Вставить("Дата",  		ТекущаяДатаСеанса());
	ДополнительныеПараметры.Вставить("Валюта",		Валюта);
	ДополнительныеПараметры.Вставить("Цена",		Цена);
	ДополнительныеПараметры.Вставить("ВидЦены",		ВидЦены);
	
	//ПодобранныеТовары = ИС_МП_УправлениеЗаказами.Комплектующие(ПараметрыКомплектующих, ДополнительныеПараметры);
	ПодобранныеТовары = НаборыВызовСервера.Комплектующие(ПараметрыКомплектующих, ДополнительныеПараметры);
	
	ЦенаНабора = 0;
	
	Для Каждого Элемент Из ПодобранныеТовары Цикл		
		ЦенаНабора = Элемент.Цена * Элемент.КоличествоУпаковок + ЦенаНабора;		
	КонецЦикла; 
	
	Если ЦенаНабора > 0 Тогда
		Результат = ЦенаНабора;  
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции //- ИнфоСофт Мурсалимов Д.Р. 16.08.24 УА #81483

