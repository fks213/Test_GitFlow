	Если Маркетплейс = Перечисления.ИС_МП_Маркетплейсы.Сбер Тогда
		Возврат ИС_Сбер_Сервер.ПолучитьСтруктуруПараметровЦен();
	КонецЕсли;

	Если Маркетплейс = Перечисления.ИС_МП_Маркетплейсы.Али Тогда
		Возврат ИС_АЛИ_Сервер.ПолучитьСтруктуруПараметровЦен();
	КонецЕсли;
	
	//+ ИнфоСофт Власова И.С. 23.12.24 УА #90120
	ОбщийМодуль = ИС_МП_Сервер.ОбщийМодульМаркетплейса(Маркетплейс);
	Возврат ОбщийМодуль.ПолучитьСтруктуруПараметровЦен();
	//- ИнфоСофт Власова И.С. 23.12.24 УА #90120
	
КонецФункции //- ИнфоСофт Мурсалимов Д.Р. 04.07.24 УА #66901

//+ ИнфоСофт Мурсалимов Д.Р. 26.04.24 УА #66901   
Процедура ПолучитьРеквизитыЦен(Профиль, Объект) Экспорт
	
	МассивМаркетплейсов = ИС_MP_Сервер.ПолучитьМаркетплейсы();
	
	Для Каждого ТекМаркетплейс Из МассивМаркетплейсов Цикл 
		
		Маркетплейс = ИС_MP_Сервер.ПолучитьНаименованиеМаркетплейса(ТекМаркетплейс); 
		
		МассивНастроек = ИС_МП_УправлениеЦенами.ПолучитьСписокПараметровЦен(ТекМаркетплейс);
		
		СтруктураНастроекПрофиля = ИС_MP_Сервер.ПолучитьЗначениеНастроек(Профиль, ТекМаркетплейс, МассивНастроек);
		
		Для Каждого Элемент Из СтруктураНастроекПрофиля Цикл
			
			Если ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(Объект, Маркетплейс + Элемент.Ключ) Тогда 
				Объект[Маркетплейс + Элемент.Ключ] = СтруктураНастроекПрофиля[Элемент.Ключ];
			КонецЕсли;	
			
		КонецЦикла;
	
	КонецЦикла;
	
КонецПроцедуры //- ИнфоСофт Мурсалимов Д.Р. 26.04.24 УА #66901

//+ ИнфоСофт Мурсалимов Д.Р. 04.07.24 УА #66901
Функция ЗаписатьРеквизитыЦен(Профиль, Объект) Экспорт
	
	МассивМаркетплейсов = ИС_MP_Сервер.ПолучитьМаркетплейсы();
	
	Для Каждого ТекМаркетплейс Из МассивМаркетплейсов Цикл 
		
		Маркетплейс = ИС_MP_Сервер.ПолучитьНаименованиеМаркетплейса(ТекМаркетплейс);
		
		СтруктураНастроек = ИС_МП_УправлениеЦенами.ПолучитьСтруктуруПараметровЦен(ТекМаркетплейс);
		
		Для Каждого Элемент Из СтруктураНастроек Цикл
			
			Если ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(Объект, Маркетплейс + Элемент.Ключ) Тогда 
				СтруктураНастроек[Элемент.Ключ] = Объект[Маркетплейс + Элемент.Ключ];
			КонецЕсли;	
			
		КонецЦикла;

		ИС_MP_Сервер.ЗаписатьЗначениеНастроек(Профиль, ТекМаркетплейс, СтруктураНастроек);
	
