Процедура УстановитьПараметрыЗапросаЦен(Маркетплейс, Запрос, Профиль) Экспорт

	Если Маркетплейс = Перечисления.ИС_МП_Маркетплейсы.ВБ Тогда
		ИС_WB_Сервер.УстановитьПараметрыЗапросаЦен(Запрос, Профиль);
		Возврат;
	КонецЕсли;
	
	Если Маркетплейс = Перечисления.ИС_МП_Маркетплейсы.Озон Тогда
		ИС_Ozon_Сервер.УстановитьПараметрыЗапросаЦен(Запрос, Профиль);
		Возврат;
	КонецЕсли;

	Если Маркетплейс = Перечисления.ИС_МП_Маркетплейсы.ЯМ Тогда
		ИС_ЯМ_Сервер.УстановитьПараметрыЗапросаЦен(Запрос, Профиль);
		Возврат;
	КонецЕсли;

	Если Маркетплейс = Перечисления.ИС_МП_Маркетплейсы.Сбер Тогда
		ИС_Сбер_Сервер.УстановитьПараметрыЗапросаЦен(Запрос, Профиль);
		Возврат;
	КонецЕсли;

	Если Маркетплейс = Перечисления.ИС_МП_Маркетплейсы.Али Тогда
		ИС_АЛИ_Сервер.УстановитьПараметрыЗапросаЦен(Запрос, Профиль);
		Возврат;
	КонецЕсли;
	
	//+ ИнфоСофт Власова И.С. 23.12.24 УА #90120
	ОбщийМодуль = ИС_МП_Сервер.ОбщийМодульМаркетплейса(Маркетплейс);
	ОбщийМодуль.УстановитьПараметрыЗапросаЦен(Запрос, Профиль);
	//- ИнфоСофт Власова И.С. 23.12.24 УА #90120
	
