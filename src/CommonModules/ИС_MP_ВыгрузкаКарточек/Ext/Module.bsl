//+ ИнфоСофт Стояк Ю.К. 22.01.2024 УА #61983
Функция ЭтоПримитивныйТип(ТипРеквизита) Экспорт

	Результат = Ложь;

	Если ТипЗнч(ТипРеквизита) = Тип("ОписаниеТипов") Тогда

		Если ТипРеквизита.СодержитТип(Тип("Строка")) Или ТипРеквизита.СодержитТип(Тип("Число"))
			Или ТипРеквизита.СодержитТип(Тип("Булево")) Или ТипРеквизита.СодержитТип(Тип("Дата")) Тогда

			Результат = Истина;

		КонецЕсли;
	ИначеЕсли ТипЗнч(ТипРеквизита) = Тип("Тип") Тогда

		Если ТипРеквизита = Тип("Строка") Или ТипРеквизита = Тип("Число") Или ТипРеквизита = Тип("Булево")
			Или ТипРеквизита = Тип("Дата") Тогда

			Результат = Истина;

		КонецЕсли;

	КонецЕсли;

	Возврат Результат;

КонецФункции //- ИнфоСофт Стояк Ю.К. 22.01.2024 УА #61983

//+ ИнфоСофт Стояк Ю.К. 22.01.2024 УА #61983
Процедура УстановитьСвязиПараметровВыбораХарактеристикиИУпаковки(Форма, ИмяТЧ = "Товары") Экспорт

	ЭлементХарактеристика = Форма.Элементы.Найти("ХарактеристикаНоменклатуры");
	ЭлементУпаковка = Форма.Элементы.Найти("Упаковка");

	КраткоеНаименованиеОсновнойПодсистемы = КраткоеНаименованиеОсновнойПодсистемы();

	СвязиПараметровВыбора = Новый Массив;
	ПараметрыВыбораУпаковки = Новый Массив;

	Если КраткоеНаименованиеОсновнойПодсистемы = "УНФ" Тогда
		СвязиПараметровВыбора.Добавить(Новый СвязьПараметраВыбора("Отбор.Владелец", СтрШаблон(
			"Элементы.%1.ТекущиеДанные.Номенклатура", ИмяТЧ), РежимИзмененияСвязанногоЗначения.Очищать));
		ПараметрыВыбораУпаковки.Добавить(Новый ПараметрВыбора("НеИспользоватьКлассификатор", Истина));
	Иначе
		СвязиПараметровВыбора.Добавить(Новый СвязьПараметраВыбора("Номенклатура", СтрШаблон(
			"Элементы.%1.ТекущиеДанные.Номенклатура", ИмяТЧ), РежимИзмененияСвязанногоЗначения.Очищать));
	КонецЕсли;

	Если Не ЭлементХарактеристика = Неопределено Тогда
		ЭлементХарактеристика.СвязиПараметровВыбора = Новый ФиксированныйМассив(СвязиПараметровВыбора);
	КонецЕсли;

	Если Не ЭлементУпаковка = Неопределено Тогда
		ЭлементУпаковка.СвязиПараметровВыбора = Новый ФиксированныйМассив(СвязиПараметровВыбора);
		ЭлементУпаковка.ПараметрыВыбора = Новый ФиксированныйМассив(ПараметрыВыбораУпаковки);
	КонецЕсли;
КонецПроцедуры //- ИнфоСофт Стояк Ю.К. 22.01.2024 УА #61983

//+ ИнфоСофт Стояк Ю.К. 28.05.2024 УА #65724
Функция КраткоеНаименованиеОсновнойПодсистемы() Экспорт

	Результат = "";

	ПоддерживаемыеПодсистемы = Новый Соответствие;
	ПоддерживаемыеПодсистемы.Вставить("УправлениеТорговлей", "УТ");
	ПоддерживаемыеПодсистемы.Вставить("УправлениеНебольшойФирмой", "УНФ");	

	Модуль_СтандартныеПодсистемыСервер = ОбщегоНазначения.ОбщийМодуль("СтандартныеПодсистемыСервер");
	Модуль_СтандартныеПодсистемыПовтИсп = ОбщегоНазначения.ОбщийМодуль("СтандартныеПодсистемыПовтИсп");

	ОписаниеПодсистемКонфигурации = Модуль_СтандартныеПодсистемыПовтИсп.ОписанияПодсистем().ПоИменам;

	Для Каждого КлючИЗначение Из ПоддерживаемыеПодсистемы Цикл
		ОписаниеПодсистемы = ОписаниеПодсистемКонфигурации.Получить(КлючИЗначение.Ключ + ?(
			Модуль_СтандартныеПодсистемыСервер.ЭтоБазоваяВерсияКонфигурации(), "Базовая", ""));
		Если ОписаниеПодсистемы <> Неопределено Тогда
			Результат = КлючИЗначение.Значение;
			Прервать;
		КонецЕсли;
	КонецЦикла;

	Возврат Результат;

КонецФункции //- ИнфоСофт Стояк Ю.К. 28.05.2024 УА #65724

#КонецОбласти