//+ ИнфоСофт Заварин К.В. 20.05.24 УА #71157
//Добавлен множитель
Процедура ДобавитьСопоставлениеОсновногоРеквизита(Категория, РеквизитТовара, ВидРеквизита1С, Реквизит1С,
	ФиксированноеЗначение, ИмяРегистра, Множитель = 0) Экспорт
//- ИнфоСофт Заварин К.В. 20.05.24 УА #71157

	НаборЗаписей = РегистрыСведений[ИмяРегистра].СоздатьНаборЗаписей();
	НаборЗаписей.Отбор.Категория.Установить(Категория);
	НаборЗаписей.Отбор.РеквизитТовара.Установить(РеквизитТовара);
	НаборЗаписей.Прочитать();
	НаборЗаписей.Очистить();

	ЗаписьНабора = НаборЗаписей.Добавить();
	ЗаписьНабора.Категория 				= Категория;
	ЗаписьНабора.РеквизитТовара 		= РеквизитТовара;
	ЗаписьНабора.ВидРеквизита1С 		= ВидРеквизита1С;
	ЗаписьНабора.Реквизит1С 			= Реквизит1С;
	ЗаписьНабора.ФиксированноеЗначение 	= ФиксированноеЗначение;
	//+ ИнфоСофт Заварин К.В. 20.05.24 УА #71157
	ЗаписьНабора.Множитель 				= Множитель;      
	//- ИнфоСофт Заварин К.В. 20.05.24 УА #71157
	НаборЗаписей.Записать(Истина);

КонецПроцедуры //- ИнфоСофт Стояк Ю.К. 12.05.2024 УА #62574

