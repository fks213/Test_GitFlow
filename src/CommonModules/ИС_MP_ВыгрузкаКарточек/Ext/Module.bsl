//+ ИнфоСофт Стояк Ю.К. 22.01.2024 УА #61983
Функция ДопРеквизитыНабора(НаборДопРеквизитов = Неопределено) Экспорт

	Если НаборДопРеквизитов = Неопределено Тогда

		НаименованияЭлементовСправочника = Новый Массив;
		НаименованияЭлементовСправочника.Добавить("Номенклатура");
		НаименованияЭлементовСправочника.Добавить("Справочник ""Номенклатура""");
		//т.к. с версии 11.5 имеются предопределенные и непредопределенные элементы с одним наименованием
		Запрос = Новый Запрос;
		Запрос.Текст =
		"ВЫБРАТЬ
		|	НаборыДополнительныхРеквизитовИСведений.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.НаборыДополнительныхРеквизитовИСведений КАК НаборыДополнительныхРеквизитовИСведений
		|ГДЕ
		|	НаборыДополнительныхРеквизитовИСведений.Наименование В (&НаименованияЭлементовСправочника)";

		Запрос.УстановитьПараметр("НаименованияЭлементовСправочника", НаименованияЭлементовСправочника);

		РезультатЗапроса = Запрос.Выполнить().Выгрузить();

		НаборДопРеквизитов = РезультатЗапроса.ВыгрузитьКолонку("Ссылка");

	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	НаборыДопРеквизитов.Свойство КАК Свойство
	|ИЗ
	|	Справочник.НаборыДополнительныхРеквизитовИСведений.ДополнительныеРеквизиты КАК НаборыДопРеквизитов
	|ГДЕ
	|	НаборыДопРеквизитов.Ссылка В ИЕРАРХИИ(&НаборДопРеквизитов)
	|	И НЕ НаборыДопРеквизитов.Ссылка.ЭтоГруппа
	|	И НЕ НаборыДопРеквизитов.ПометкаУдаления";

	Запрос.УстановитьПараметр("НаборДопРеквизитов", НаборДопРеквизитов);

	РезультатЗапроса = Запрос.Выполнить().Выгрузить();

	Возврат РезультатЗапроса.ВыгрузитьКолонку("Свойство");

КонецФункции //- ИнфоСофт Стояк Ю.К. 22.01.2024 УА #61983

//+ ИнфоСофт Стояк Ю.К. 22.01.2024 УА #61983
Функция РеквизитыНоменклатуры() Экспорт

	Реквизиты = Метаданные.Справочники["Номенклатура"].Реквизиты;
	Результат = Новый Массив;
	Для Каждого Реквизит Из Реквизиты Цикл
		Результат.Добавить(СокрЛП(Реквизит.Синоним));
	КонецЦикла;

	СтандартныеРеквизиты = Метаданные.Справочники["Номенклатура"].СтандартныеРеквизиты;
	Для Каждого Реквизит Из СтандартныеРеквизиты Цикл
		Результат.Добавить(Реквизит.Имя);
	КонецЦикла;

	Возврат Результат;

КонецФункции //- ИнфоСофт Стояк Ю.К. 22.01.2024 УА #61983

//+ ИнфоСофт Стояк Ю.К. 22.01.2024 УА #61983
Функция ДопСвойстваНоменклатуры() Экспорт

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	НаборыДополнительныхСведений.Свойство КАК Свойство
	|ИЗ
	|	Справочник.НаборыДополнительныхРеквизитовИСведений.ДополнительныеСведения КАК НаборыДополнительныхСведений
	|ГДЕ
	|	НаборыДополнительныхСведений.Ссылка В ИЕРАРХИИ
	|			(ВЫБРАТЬ
	|				НаборыДополнительныхРеквизитовИСведений.Ссылка КАК Ссылка
	|			ИЗ
	|				Справочник.НаборыДополнительныхРеквизитовИСведений КАК НаборыДополнительныхРеквизитовИСведений
	|			ГДЕ
	|				НаборыДополнительныхРеквизитовИСведений.Наименование = &Наименование)
	|	И НЕ НаборыДополнительныхСведений.Ссылка.ЭтоГруппа
	|	И НЕ НаборыДополнительныхСведений.ПометкаУдаления";

	Запрос.УстановитьПараметр("Наименование", "Номенклатура");

	РезультатЗапроса = Запрос.Выполнить().Выгрузить();

	Возврат РезультатЗапроса.ВыгрузитьКолонку("Свойство");

КонецФункции //- ИнфоСофт Стояк Ю.К. 22.01.2024 УА #61983

//+ ИнфоСофт Стояк Ю.К. 22.01.2024 УА #61983
Функция НаборыДопРеквизитовХарактеристикиНоменклатуры() Экспорт

	НаименованияЭлементовСправочника = Новый Массив;
	НаименованияЭлементовСправочника.Добавить("Характеристики");
	НаименованияЭлементовСправочника.Добавить("Характеристики номенклатуры");
	НаименованияЭлементовСправочника.Добавить("Справочник ""Характеристики номенклатуры""");

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	НаборыДополнительныхРеквизитовИСведений.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.НаборыДополнительныхРеквизитовИСведений КАК НаборыДополнительныхРеквизитовИСведений
	|ГДЕ
	|	НЕ НаборыДополнительныхРеквизитовИСведений.ЭтоГруппа
	|	И НЕ НаборыДополнительныхРеквизитовИСведений.ПометкаУдаления
	|	И НаборыДополнительныхРеквизитовИСведений.Родитель В (ВЫБРАТЬ
	|			НаборыДополнительныхРеквизитовИСведений.Ссылка КАК Ссылка
	|		ИЗ
	|			Справочник.НаборыДополнительныхРеквизитовИСведений КАК НаборыДополнительныхРеквизитовИСведений
	|		ГДЕ
	|			НаборыДополнительныхРеквизитовИСведений.Наименование В (&НаименованияЭлементовСправочника))
	|	И НаборыДополнительныхРеквизитовИСведений.КоличествоРеквизитов > 0";

	Запрос.УстановитьПараметр("НаименованияЭлементовСправочника", НаименованияЭлементовСправочника);

	РезультатЗапроса = Запрос.Выполнить().Выгрузить();

	Возврат РезультатЗапроса.ВыгрузитьКолонку("Ссылка");

КонецФункции //- ИнфоСофт Стояк Ю.К. 22.01.2024 УА #61983

//+ ИнфоСофт Стояк Ю.К. 22.01.2024 УА #61983
Функция ВидыНоменклатурыХарактеристик() Экспорт

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ХарактеристикиНоменклатуры.ВидНоменклатуры КАК ВидНоменклатуры,
	|	КОЛИЧЕСТВО(ХарактеристикиНоменклатурыДополнительныеРеквизиты.Свойство) КАК Свойство
	|ИЗ
	|	Справочник.ХарактеристикиНоменклатуры КАК ХарактеристикиНоменклатуры
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ХарактеристикиНоменклатуры.ДополнительныеРеквизиты КАК ХарактеристикиНоменклатурыДополнительныеРеквизиты
	|		ПО (ХарактеристикиНоменклатурыДополнительныеРеквизиты.Ссылка = ХарактеристикиНоменклатуры.Ссылка)
	|
	|СГРУППИРОВАТЬ ПО
	|	ХарактеристикиНоменклатуры.ВидНоменклатуры
	|
	|ИМЕЮЩИЕ
	|	КОЛИЧЕСТВО(ХарактеристикиНоменклатурыДополнительныеРеквизиты.Свойство) = 0
	|";
	РезультатЗапроса = Запрос.Выполнить().Выгрузить();

	Возврат РезультатЗапроса.ВыгрузитьКолонку("ВидНоменклатуры");

КонецФункции //- ИнфоСофт Стояк Ю.К. 22.01.2024 УА #61983

