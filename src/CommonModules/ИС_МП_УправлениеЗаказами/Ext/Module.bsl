			//- ИнфоСофт Заварин К.В. 10.04.25 УА #98479
			
		КонецЕсли;
		
	Иначе
	//- ИнфоСофт Стояк Ю.К. 12.02.2025 УА #89133	
		Если ПолучитьФункциональнуюОпцию("ИспользоватьСоглашенияСКлиентами") И ДополнительныеПараметры.Свойство("Соглашение")
