			Если ПараметрыТовара.ТипНоменклатуры = ПредопределенноеЗначение("Перечисление.ТипыНоменклатуры.Услуга")
				Или ПараметрыТовара.ТипНоменклатуры = ПредопределенноеЗначение("Перечисление.ТипыНоменклатуры.Работа") Тогда
				ПараметрыТовара.Склад = Неопределено;
			КонецЕсли;
						
			ПараметрыТовара.ХарактеристикиИспользуются = ?(ЗначениеЗаполнено(ПараметрыТовара.Характеристика), Истина, Ложь);						
			
			//+ ИнфоСофт Власова И.С. 12.03.25 УА #95821
			Если ЗначениеЗаполнено(СтрокаТЧ.Упаковка) Тогда
				СтоимостьНоменклатуры = СтрокаТЧ.Цена * СтрокаТЧ.КоличествоУпаковок;
			Иначе	
				СтоимостьНоменклатуры = СтрокаТЧ.Цена * СтрокаТЧ.Количество;
			КонецЕсли;
			//- ИнфоСофт Власова И.С. 12.03.25 УА #95821
			
			Если ПараметрыТовара.КоличествоУпаковок <> 0 И ОбщаяСтоимость <> 0 Тогда
				
				//+ ИнфоСофт Власова И.С. 12.03.25 УА #95821
				//ПараметрыТовара.Цена = Окр(((СтрокаТЧ.Цена / ОбщаяСтоимость) * СуммаКРаспределению)
				/// ПараметрыТовара.КоличествоУпаковок, 2);
				//ПараметрыТовара.Вставить("ЦенаПродажи", Окр(((СтрокаТЧ.Цена / ОбщаяСтоимость) * СуммаПродажиКРаспределению)
				/// ПараметрыТовара.КоличествоУпаковок, 2));
				//ПараметрыТовара.Вставить("Комиссия", Окр(((СтрокаТЧ.Цена / ОбщаяСтоимость) * СуммаКомиссииКРаспределению)
				/// ПараметрыТовара.КоличествоУпаковок, 2));
				
				ПараметрыТовара.Цена = Окр(((СтоимостьНоменклатуры / ОбщаяСтоимость) * СуммаКРаспределению)
					/ ПараметрыТовара.КоличествоУпаковок, 2);
				ПараметрыТовара.Вставить("ЦенаПродажи", Окр(((СтоимостьНоменклатуры / ОбщаяСтоимость) * СуммаПродажиКРаспределению)
					/ ПараметрыТовара.КоличествоУпаковок, 2));
				ПараметрыТовара.Вставить("Комиссия", Окр(((СтоимостьНоменклатуры / ОбщаяСтоимость) * СуммаКомиссииКРаспределению)
