
#Область СлужебныйПрограммныйИнтерфейс

//+ ИнфоСофт Стояк Ю.К. 29.10.2024 УА #67816
Функция ТекстЗапросаПараметровПечатиШтрихкодов() Экспорт
	
	Текст = "
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ЗаказКлиента.Ссылка КАК Заказ1С,
	|	ЗаказКлиента.Дата КАК ДатаЗаказ1С,
	|	ЗаказКлиента.Автор КАК АвторЗаказ1С,
	|	ЗаказКлиента.Организация КАК ОрганизацияЗаказ1С,
	|	ЗаказКлиента.Менеджер КАК ОтветственныйЗаказ1С,
	|	ЗаказКлиента.ДатаОтгрузки КАК ДатаОтгрузкиЗаказ1С,
	|	ЗаказКлиента.Номер КАК НомерЗаказ1С,
	|	ЗаказКлиента.Комментарий КАК КомментарийЗаказ1С
	|ПОМЕСТИТЬ ВТ_ДанныеЗаказа
	|ИЗ
	|	ВТ_ДанныеМаркетплейса КАК ВТ_ДанныеМаркетплейса
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ЗаказКлиента КАК ЗаказКлиента
	|		ПО ВТ_ДанныеМаркетплейса.Заказ = ЗаказКлиента.Ссылка
	|ГДЕ
	|	НЕ ЗаказКлиента.ПометкаУдаления
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_ДанныеЗаказа.Заказ1С КАК Заказ1С,
	|	ПередачаТоваровХранителю.Ссылка КАК Реализация
	|ПОМЕСТИТЬ ВТ_РеализацииССылка
	|ИЗ
	|	ВТ_ДанныеЗаказа КАК ВТ_ДанныеЗаказа
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ПередачаТоваровХранителю КАК ПередачаТоваровХранителю
	|		ПО ВТ_ДанныеЗаказа.Заказ1С = ПередачаТоваровХранителю.ЗаказКлиента
	|			И (НЕ ВТ_ДанныеЗаказа.Заказ1С = ЗНАЧЕНИЕ(Документ.ЗаказКлиента.ПустаяСсылка))
	|ГДЕ
	|	НЕ ВТ_ДанныеЗаказа.Заказ1С = ЗНАЧЕНИЕ(Документ.ЗаказКлиента.ПустаяСсылка)
	|	И НЕ ПередачаТоваровХранителю.Ссылка ЕСТЬ NULL
	|
	|ОБЪЕДИНИТЬ
	|
	|ВЫБРАТЬ
	|	ВТ_ДанныеЗаказа.Заказ1С,
	|	ПередачаТоваровХранителюТовары.Ссылка
	|ИЗ
	|	ВТ_ДанныеЗаказа КАК ВТ_ДанныеЗаказа
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ПередачаТоваровХранителю.Товары КАК ПередачаТоваровХранителюТовары
	|		ПО ВТ_ДанныеЗаказа.Заказ1С = ПередачаТоваровХранителюТовары.ЗаказКлиента
	|			И (НЕ ВТ_ДанныеЗаказа.Заказ1С = ЗНАЧЕНИЕ(Документ.ЗаказКлиента.ПустаяСсылка))
	|ГДЕ
	|	НЕ ВТ_ДанныеЗаказа.Заказ1С = ЗНАЧЕНИЕ(Документ.ЗаказКлиента.ПустаяСсылка)
	|	И НЕ ПередачаТоваровХранителюТовары.Ссылка ЕСТЬ NULL
	|
	|ОБЪЕДИНИТЬ
	|
	|ВЫБРАТЬ
	|	ВТ_ДанныеЗаказа.Заказ1С,
	|	РеализацияТоваровУслуг.Ссылка 
	|ИЗ
	|	ВТ_ДанныеЗаказа КАК ВТ_ДанныеЗаказа
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.РеализацияТоваровУслуг КАК РеализацияТоваровУслуг
	|		ПО ВТ_ДанныеЗаказа.Заказ1С = РеализацияТоваровУслуг.ЗаказКлиента
	|			И (НЕ ВТ_ДанныеЗаказа.Заказ1С = ЗНАЧЕНИЕ(Документ.ЗаказКлиента.ПустаяСсылка))
	|ГДЕ
	|	НЕ ВТ_ДанныеЗаказа.Заказ1С = ЗНАЧЕНИЕ(Документ.ЗаказКлиента.ПустаяСсылка)
	|	И НЕ РеализацияТоваровУслуг.Ссылка ЕСТЬ NULL
	|
	|ОБЪЕДИНИТЬ
	|
	|ВЫБРАТЬ
	|	ВТ_ДанныеЗаказа.Заказ1С,
	|	РеализацияТоваровУслугТовары.Ссылка
	|ИЗ
	|	ВТ_ДанныеЗаказа КАК ВТ_ДанныеЗаказа
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.РеализацияТоваровУслуг.Товары КАК РеализацияТоваровУслугТовары
	|		ПО ВТ_ДанныеЗаказа.Заказ1С = РеализацияТоваровУслугТовары.ЗаказКлиента
	|			И (НЕ ВТ_ДанныеЗаказа.Заказ1С = ЗНАЧЕНИЕ(Документ.ЗаказКлиента.ПустаяСсылка))
	|ГДЕ
	|	НЕ ВТ_ДанныеЗаказа.Заказ1С = ЗНАЧЕНИЕ(Документ.ЗаказКлиента.ПустаяСсылка)
	|	И НЕ РеализацияТоваровУслугТовары.Ссылка ЕСТЬ NULL
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_РеализацииССылка.Реализация КАК Реализация1С,
	|	ВТ_РеализацииССылка.Реализация.Номер КАК НомерРеализация1С,
	|	ВТ_РеализацииССылка.Реализация.Дата КАК ДатаРеализация1С,
	|	ВТ_РеализацииССылка.Реализация.Комментарий КАК КомментарийРеализация1С,
	|	ВТ_РеализацииССылка.Реализация.Менеджер КАК ОтветственныйРеализация1С,
	|	ВТ_РеализацииССылка.Реализация.Автор КАК АвторРеализация1С,
	|	ВТ_ДанныеЗаказа.Заказ1С КАК Заказ1С,
	|	ВТ_ДанныеЗаказа.ДатаЗаказ1С КАК ДатаЗаказ1С,
	|	ВТ_ДанныеЗаказа.АвторЗаказ1С КАК АвторЗаказ1С,
	|	ВТ_ДанныеЗаказа.ОрганизацияЗаказ1С КАК ОрганизацияЗаказ1С,
	|	ВТ_ДанныеЗаказа.ОтветственныйЗаказ1С КАК ОтветственныйЗаказ1С,
	|	ВТ_ДанныеЗаказа.ДатаОтгрузкиЗаказ1С КАК ДатаОтгрузкиЗаказ1С,
	|	ВТ_ДанныеЗаказа.НомерЗаказ1С КАК НомерЗаказ1С,
	|	ВТ_ДанныеЗаказа.КомментарийЗаказ1С КАК КомментарийЗаказ1С
	|ПОМЕСТИТЬ ВТ_ДанныеЗаказаИРеализации
	|ИЗ
	|	ВТ_ДанныеЗаказа КАК ВТ_ДанныеЗаказа
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_РеализацииССылка КАК ВТ_РеализацииССылка
	|		ПО ВТ_ДанныеЗаказа.Заказ1С = ВТ_РеализацииССылка.Заказ1С
	|ГДЕ
	|	НЕ ВТ_РеализацииССылка.Реализация.ПометкаУдаления
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Номенклатура.Наименование КАК НаименованиеНоменклатуры1С,
	|	Номенклатура.Артикул КАК АртикулНоменклатуры1С,
	|	Номенклатура.Производитель КАК ПроизводительНоменклатуры1С,
	|	Номенклатура.СрокГодности КАК СрокГодностиНоменклатуры1С,	
	|	Номенклатура.Ссылка КАК Ссылка
	|ПОМЕСТИТЬ ВТ_ДанныеНоменклатуры
	|ИЗ
	|	ВТ_ДанныеМаркетплейса КАК ВТ_ДанныеМаркетплейса
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Номенклатура КАК Номенклатура
	|		ПО ВТ_ДанныеМаркетплейса.Номенклатура1С = Номенклатура.Ссылка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////  
	
	//+ ИнфоСофт Заварин К.В. 10.12.24 УА #89316
	//|ВЫБРАТЬ 
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	//- ИнфоСофт Заварин К.В. 10.12.24 УА #89316	
	|	ВТ_ДанныеМаркетплейса.НомерЗаказаСМаркетплейса КАК НомерЗаказаСМаркетплейса,
	|	ВТ_ДанныеМаркетплейса.КодНоменклатурыСМаркетплейса КАК КодНоменклатурыСМаркетплейса,
	|	ВТ_ДанныеМаркетплейса.Дата КАК Дата,
	|	ВТ_ДанныеМаркетплейса.АртикулПоставщикаНоменклатурыСМаркетплейса КАК АртикулПоставщикаНоменклатурыСМаркетплейса,
	|	ВТ_ДанныеМаркетплейса.РазмерСВБ КАК РазмерСВБ,
	|	ВТ_ДанныеМаркетплейса.ЦветСВБ КАК ЦветСВБ,
	|	ВТ_ДанныеМаркетплейса.ШтрихкодСМаркетплейса КАК ШтрихкодСМаркетплейса,
	|	ВТ_ДанныеМаркетплейса.НаименованиеНоменклатурыСМаркетплейса КАК НаименованиеНоменклатурыСМаркетплейса,
	|	ВТ_ДанныеМаркетплейса.Номенклатура1С КАК Номенклатура1С,
	|	ВТ_ДанныеМаркетплейса.Характеристика1С КАК Характеристика1С,
	//+ ИнфоСофт Заварин К.В. 27.12.24 УА #90269
	|	МАКСИМУМ(ВТ_ДанныеЗаказаИРеализации.Реализация1С) КАК Реализация1С,
	|	МАКСИМУМ(ВТ_ДанныеЗаказаИРеализации.НомерРеализация1С) КАК НомерРеализация1С,
	|	МАКСИМУМ(ВТ_ДанныеЗаказаИРеализации.ДатаРеализация1С) КАК ДатаРеализация1С,
	|	МАКСИМУМ(ВЫРАЗИТЬ(ВТ_ДанныеЗаказаИРеализации.КомментарийРеализация1С КАК СТРОКА(1000))) КАК КомментарийРеализация1С,
	|	МАКСИМУМ(ВТ_ДанныеЗаказаИРеализации.ОтветственныйРеализация1С) КАК ОтветственныйРеализация1С,
	|	МАКСИМУМ(ВТ_ДанныеЗаказаИРеализации.АвторРеализация1С) КАК АвторРеализация1С,
	//- ИнфоСофт Заварин К.В. 27.12.24 УА #90269
	|	ВТ_ДанныеЗаказаИРеализации.Заказ1С КАК Заказ1С,
	|	ВТ_ДанныеЗаказаИРеализации.ДатаЗаказ1С КАК ДатаЗаказ1С,
	|	ВТ_ДанныеЗаказаИРеализации.АвторЗаказ1С КАК АвторЗаказ1С,
	|	ВТ_ДанныеЗаказаИРеализации.ОрганизацияЗаказ1С КАК ОрганизацияЗаказ1С,
	|	ВТ_ДанныеЗаказаИРеализации.ОтветственныйЗаказ1С КАК ОтветственныйЗаказ1С,
	|	ВТ_ДанныеЗаказаИРеализации.ДатаОтгрузкиЗаказ1С КАК ДатаОтгрузкиЗаказ1С,
	|	ВТ_ДанныеЗаказаИРеализации.НомерЗаказ1С КАК НомерЗаказ1С,
	//+ ИнфоСофт Заварин К.В. 10.12.24 УА #89316
	//|	ВТ_ДанныеЗаказаИРеализации.КомментарийЗаказ1С КАК КомментарийЗаказ1С, 
	|	ВЫРАЗИТЬ(ВТ_ДанныеЗаказаИРеализации.КомментарийЗаказ1С КАК СТРОКА(1000)) КАК КомментарийЗаказ1С,
	//- ИнфоСофт Заварин К.В. 10.12.24 УА #89316
	|	ВТ_ДанныеНоменклатуры.НаименованиеНоменклатуры1С КАК НаименованиеНоменклатуры1С,
	|	ВТ_ДанныеНоменклатуры.АртикулНоменклатуры1С КАК АртикулНоменклатуры1С,
	|	ВТ_ДанныеНоменклатуры.ПроизводительНоменклатуры1С КАК ПроизводительНоменклатуры1С,
	|	ВТ_ДанныеНоменклатуры.СрокГодностиНоменклатуры1С КАК СрокГодностиНоменклатуры1С	
	|ИЗ
	|	ВТ_ДанныеМаркетплейса КАК ВТ_ДанныеМаркетплейса
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_ДанныеНоменклатуры КАК ВТ_ДанныеНоменклатуры
	|		ПО (ВТ_ДанныеМаркетплейса.Номенклатура1С = ВТ_ДанныеНоменклатуры.Ссылка)
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_ДанныеЗаказаИРеализации КАК ВТ_ДанныеЗаказаИРеализации
	|		ПО (ВТ_ДанныеМаркетплейса.Заказ = ВТ_ДанныеЗаказаИРеализации.Заказ1С)
	//+ ИнфоСофт Заварин К.В. 27.12.24 УА #90269
	|СГРУППИРОВАТЬ ПО
	|	ВТ_ДанныеМаркетплейса.НомерЗаказаСМаркетплейса,
	|	ВТ_ДанныеМаркетплейса.Дата,
	|	ВТ_ДанныеМаркетплейса.КодНоменклатурыСМаркетплейса,
	|	ВТ_ДанныеМаркетплейса.АртикулПоставщикаНоменклатурыСМаркетплейса,
	|	ВТ_ДанныеМаркетплейса.РазмерСВБ,
	|	ВТ_ДанныеМаркетплейса.ЦветСВБ,
	|	ВТ_ДанныеМаркетплейса.ШтрихкодСМаркетплейса,
	|	ВТ_ДанныеМаркетплейса.НаименованиеНоменклатурыСМаркетплейса,
	|	ВТ_ДанныеМаркетплейса.Номенклатура1С,
	|	ВТ_ДанныеМаркетплейса.Характеристика1С,
	|	ВТ_ДанныеЗаказаИРеализации.Заказ1С,
	|	ВТ_ДанныеЗаказаИРеализации.ДатаЗаказ1С,
	|	ВТ_ДанныеЗаказаИРеализации.АвторЗаказ1С,
	|	ВТ_ДанныеЗаказаИРеализации.ОрганизацияЗаказ1С,
	|	ВТ_ДанныеЗаказаИРеализации.ОтветственныйЗаказ1С,
	|	ВТ_ДанныеЗаказаИРеализации.ДатаОтгрузкиЗаказ1С,
	|	ВТ_ДанныеЗаказаИРеализации.НомерЗаказ1С,
	|	ВТ_ДанныеНоменклатуры.НаименованиеНоменклатуры1С,
	|	ВТ_ДанныеНоменклатуры.АртикулНоменклатуры1С,
	|	ВТ_ДанныеНоменклатуры.ПроизводительНоменклатуры1С,
	|	ВТ_ДанныеНоменклатуры.СрокГодностиНоменклатуры1С,
	|	ВЫРАЗИТЬ(ВТ_ДанныеЗаказаИРеализации.КомментарийЗаказ1С КАК СТРОКА(1000))";
