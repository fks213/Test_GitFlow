Функция ПолучитьНомерЭтикеткиДляСборочногоЗадания(СборочноеЗадание) Экспорт
	
	ВозвращаемыйНомер = " Номер этикетки: не найден";
	
	Запрос = Новый Запрос;
	Запрос.Текст =                             
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	ВЫРАЗИТЬ(ИС_WB_СтатусыИЭтикеткиСборочныхЗаданий.partA КАК СТРОКА) КАК partA,
	|	ВЫРАЗИТЬ(ИС_WB_СтатусыИЭтикеткиСборочныхЗаданий.partB КАК СТРОКА) КАК partB,
	|	"" Номер этикетки: "" + ИС_WB_СтатусыИЭтикеткиСборочныхЗаданий.partA + ИС_WB_СтатусыИЭтикеткиСборочныхЗаданий.partB КАК НомерЭтикетки
	|ИЗ
	|	РегистрСведений.ИС_WB_СтатусыИЭтикеткиСборочныхЗаданий КАК ИС_WB_СтатусыИЭтикеткиСборочныхЗаданий
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ИС_WB_СборочноеЗадание КАК ИС_WB_СборочноеЗадание
	|		ПО ИС_WB_СтатусыИЭтикеткиСборочныхЗаданий.СборочноеЗадание = ИС_WB_СборочноеЗадание.Ссылка
	|ГДЕ
	|	ИС_WB_СборочноеЗадание.Ссылка = &Ссылка";
	
	
	Запрос.УстановитьПараметр("Ссылка", СборочноеЗадание);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Выборка = РезультатЗапроса.Выбрать();	
	
	Пока Выборка.Следующий() Цикл			
		ВозвращаемыйНомер = Выборка.НомерЭтикетки;		
	КонецЦикла;
	
	Возврат ВозвращаемыйНомер;
	
КонецФункции //- ИнфоСофт Тюменцев А.А. 26.07.23 УА #60918

