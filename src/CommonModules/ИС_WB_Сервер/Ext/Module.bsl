		ИспользоватьПоследниеОстатки = Настройки.ИспользоватьПоследниеОстатки;
	КонецЕсли;
		
	Если ТаблицаВыгрузки = Неопределено Тогда		
		ТаблицаВыгрузки = ИС_МП_УправлениеОстатками.СформироватьТаблицуВыгрузки(Профиль, Склад, ПеречислениеМП, Настройки);		
	КонецЕсли;
	
	Если ТаблицаВыгрузки.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	data = Новый Массив;
		
	Для Каждого Строка Из ТаблицаВыгрузки Цикл
		
		dataStructure = Новый Структура;
		dataStructure.Вставить("sku", Строка.Штрихкод);
		dataStructure.Вставить("amount", Строка.Остаток); 
		
		data.Добавить(dataStructure);		
		
	КонецЦикла;
		
	РазбитыйМассив = ИС_МП_Сервер.РазбитьМассивПоNЭлементов(data, 1000);
	
	БылиОшибкиВыгрузки = Ложь;
	
	//+ ИнфоСофт Заварин К.В. 05.08.24 УА #80998
	СчетчикПаузы = 0;
	//- ИнфоСофт Заварин К.В. 05.08.24 УА #80998 
	
	Для Каждого Элемент Из РазбитыйМассив Цикл
		
	    //+ ИнфоСофт Заварин К.В. 03.08.24 УА #80998
		Если СчетчикПаузы = 298 Тогда
			ИС_МП_Сервер.Пауза(60);
			СчетчикПаузы = 0;
		КонецЕсли;
		СчетчикПаузы = СчетчикПаузы + 1;
		//- ИнфоСофт Заварин К.В. 03.08.24 УА #80998
		
		Результат = ИС_WB_API.ОбновитьОстатки(Профиль, ПараметрыЗапроса, Склад.Код, Элемент);	 
	
		Если Результат = Неопределено Тогда
			БылиОшибкиВыгрузки = Истина;
		КонецЕсли;

	КонецЦикла;
	
	Если Не ИспользоватьПоследниеОстатки Тогда
		Возврат;
	КонецЕсли;
	
	Если Не БылиОшибкиВыгрузки Тогда
		
		Для Каждого Строка Из ТаблицаВыгрузки Цикл
			ИС_МП_УправлениеОстатками.ЗаписатьПоследнийВыгруженныйОстаток(Профиль, 
				ПеречислениеМП, Склад, Строка.РазмерWB, Строка.Остаток);
		КонецЦикла;
	
	КонецЕсли;
						
КонецПроцедуры //- ИнфоСофт Сумин Д.В. 31.10.212 УА #51150    

//+ ИнфоСофт Ивонин К.А. 16.03.23 УА #55822
