//+ ИнфоСофт Ивонин К.А. 22.03.23 УА #55822
Функция ПолучитьТекстЗапросаСборочныхЗаданий() Экспорт
    
    ИмяМодуля = ИС_MP_Сервер.ПолучитьИмяМодуляКонфигурации();
    ОбщийМодуль = ОбщегоНазначения.ОбщийМодуль(ИмяМодуля);
    
    Если ОбщийМодуль = Неопределено Тогда
    	Возврат Неопределено;
    КонецЕсли;
    
    Возврат ОбщийМодуль.ПолучитьТекстЗапросаСборочныхЗаданий();

КонецФункции //- ИнфоСофт Ивонин К.А. 22.03.23 УА #55822

#КонецОбласти

#Область РегламентныеЗадания

//+ ИнфоСофт Ивонин К.А. 22.01.23 УА #53535
Процедура ВыполнитьКомандуРеглЗадания(Профиль, ИдентификаторКомандыОбработки) Экспорт
	
	Событие = ПолучитьИмяСобытия("ВыполнитьКомандуРеглЗадания");
	
	Если ИдентификаторКомандыОбработки = "ПолучениеКарточекТоваров" Тогда
		ИС_ВБ_Сервер.ЗагрузитьТовары(Профиль);
		Возврат;				
	КонецЕсли;
	
	Если ИдентификаторКомандыОбработки = "ПолучениеСборочныхЗаданий" Тогда
		
		ДатаНачала = ИС_ВБ_Сервер.ДатаПоследнегоЗаказа(Профиль);
		
		Если Не ЗначениеЗаполнено(ДатаНачала) Тогда
			ДатаНачала = НачалоДня(ТекущаяДатаСеанса());	
		КонецЕсли;
		
		//ПолучитьСписокСборочныхЗаданий(Профиль, ДатаНачала + 1);
		ИС_ВБ_Сервер.ВыполнитьЗагрузкуЗаказов(Профиль, ДатаНачала + 1);
		Возврат;				
	
	КонецЕсли;
	
	Если ИдентификаторКомандыОбработки = "ОбновлениеСтатусовСборочныхЗаданий" Тогда
		//+ ИнфоСофт Стояк Ю.К. 08.04.2024 УА #68800
		ФукнциональныеОпции = ИС_WB_СерверПовтИсп.ПолучитьНастройкиФункциональностиСборочныхЗвданий(Профиль);
		
		//+ ИнфоСофт Мурсалимов Д.Р. 23.04.25 УА #99629
		АктивныйЗаказКлиента = ПолучитьАктивныйЗаказКлиента(Профиль);
		
		Если АктивныйЗаказКлиента <> Неопределено Тогда	
			ФукнциональныеОпции.Вставить("АктивныйЗаказКлиента", АктивныйЗаказКлиента);	
		КонецЕсли;
		//- ИнфоСофт Мурсалимов Д.Р. 23.04.25 УА #99629
		
		Если ФукнциональныеОпции.КоличествоДнейОбновлениеСтатусов = 0 Тогда
			Период = 30 * 86400;
		Иначе
			Период = ФукнциональныеОпции.КоличествоДнейОбновлениеСтатусов * 86400;
		КонецЕсли;
		
		ИС_ВБ_Сервер.ОбновитьСтатусыЗаказов(Профиль, , Период);
		//ОбновитьСтатусыСборочныхЗаданий(Профиль);
		//- ИнфоСофт Стояк Ю.К. 08.04.2024 УА #68800
		Возврат;				                    
		
	КонецЕсли;
	
	Если ИдентификаторКомандыОбработки = "ОбновлениеПоставок" Тогда
		ИС_ВБ_Сервер.ОбновитьИнформациюОПоставках(Профиль);
		Возврат;				
	КонецЕсли;
	
	//+ ИнфоСофт Мурсалимов Д.Р. 02.04.24 УА #72003
	Если ИдентификаторКомандыОбработки = "ВыгрузкаЦенИСкидок" Тогда
		ВыгрузитьЦены(Профиль);
		Возврат;				
	КонецЕсли;
	
	////+ ИнфоСофт Стояк Ю.К. 27.10.2023 УА #62964	
	//Если ИдентификаторКомандыОбработки = "ВыгрузкаСкидок" Тогда
	//	ВыгрузитьСкидки(Профиль);
	//	Возврат;				
	//КонецЕсли;                                  
	////- ИнфоСофт Стояк Ю.К. 27.10.2023 УА #62964
	//- ИнфоСофт Мурсалимов Д.Р. 02.04.24 УА #72003
	
	Если ИдентификаторКомандыОбработки = "ВыгрузкаОстатков" Тогда
			
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	ИС_ВБ_Склады.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.ИС_ВБ_Склады КАК ИС_ВБ_Склады
		|ГДЕ
		|	НЕ ИС_ВБ_Склады.ПометкаУдаления
		|	И ИС_ВБ_Склады.Профиль = &Профиль
		|	И ИС_ВБ_Склады.ЗагруженИзЛК
		//+ ИнфоСофт Заварин К.В. 13.08.24 УА #81097
		|	И НЕ(ИС_ВБ_Склады.ОбщаяГруппаСкладов = ЗНАЧЕНИЕ(Справочник.Склады.ПустаяСсылка)
		|				И ИС_ВБ_Склады.Склад = ЗНАЧЕНИЕ(Справочник.Склады.ПустаяСсылка)
		|				И ИС_ВБ_Склады.ВыгружатьОстаткиИзГруппыСкладов = ЛОЖЬ)";
		//- ИнфоСофт Заварин К.В. 13.08.24 УА #81097
		
		Запрос.УстановитьПараметр("Профиль", Профиль);
		
		РезультатЗапроса = Запрос.Выполнить();
		
		Выборка = РезультатЗапроса.Выбрать();
		
		Пока Выборка.Следующий() Цикл
			ВыгрузитьОстатки(Профиль, Выборка.Ссылка);
		КонецЦикла;
	
		Возврат;				
	
	КонецЕсли;
	
	Если ИдентификаторКомандыОбработки = "ЗакрыватьЗаказВТечениеДня" Тогда
		
		//+ ИнфоСофт Стояк Ю.К. 18.04.2025 УА #98648
		ВыполнитьЗакрытиеЗаказов(Профиль);
		Возврат;
		//- ИнфоСофт Стояк Ю.К. 18.04.2025 УА #98648
		
	КонецЕсли;
	
	//+ ИнфоСофт Сумин Д.В. 23.05.2023 УА #58355 
	Если ИдентификаторКомандыОбработки = "ВыполнениеАлгоритмаПоОсновнойСхемеFbo" Тогда
		ВыполнитьАлгоритмПоОсновнойСхемеFbo(Профиль);	
		
		Возврат;
	КонецЕсли;	
	//- ИнфоСофт Сумин Д.В. 23.05.2023 УА #58355
		
	//+ ИнфоСофт Стояк Ю.К. 24.11.2023 УА #61986
	Если ИдентификаторКомандыОбработки = "ПолучитьОстаткиFBO" Тогда
		ИС_MP_Сервер.ПолучитьОстаткиFBO(Профиль);			
		Возврат;
	КонецЕсли;
	//- ИнфоСофт Стояк Ю.К. 24.11.2023 УА #61986
	
	Если ИдентификаторКомандыОбработки = "ЗагружатьДанныеОК" Тогда
			
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	ИС_WB_ДанныеОтчетовРеализацииСрезПоследних.date_to КАК date_to
		|ИЗ
		|	РегистрСведений.ИС_WB_ДанныеОтчетовРеализации.СрезПоследних(, Профиль = &Профиль) КАК ИС_WB_ДанныеОтчетовРеализацииСрезПоследних";
		
		Запрос.УстановитьПараметр("Профиль", Профиль);
		
		РезультатЗапроса = Запрос.Выполнить();
		
		Выборка = РезультатЗапроса.Выбрать();
		
		Если Выборка.Следующий() Тогда
			ДатаНачала = Выборка.date_to;
			НеделяБезСекунды = 604799; 
			ДатаОкончания = Выборка.date_to + НеделяБезСекунды;
		Иначе
			ДатаНачала = НачалоНедели(ТекущаяДатаСеанса());
			ДатаОкончания = КонецНедели(ТекущаяДатаСеанса());
		КонецЕсли;
		
		ЗагрузитьДанныеОК(Профиль, ДатаНачала, ДатаОкончания);			
		Возврат;
	
	КонецЕсли;
		
КонецПроцедуры //- ИнфоСофт Ивонин К.А. 22.01.23 УА #53535

#КонецОбласти

#Область Цены

//+ ИнфоСофт Мурсалимов Д.Р. 12.05.24 УА #66901
Процедура ВыгрузитьЦены(Профиль, ТаблицаВыгрузки = Неопределено) Экспорт
	
	Событие = ПолучитьИмяСобытия("ВыгрузитьЦены");
	
	//+ ИнфоСофт Ивонин К.А. 20.01.25 УА #89159
	//НастройкиСоединения = ПолучитьНастройкиСоединенияПрофиля(Профиль);
	//ПараметрыЗапроса = ПроверитьИЗаполнитьПараметрыЗапроса(НастройкиСоединения);
	//
	//ПараметрыЗапроса.Сервер = "discounts-prices-api.wb.ru";
	
	ПараметрыЗапроса = ИС_ВБ_Сервер.ПараметрыHTTPЗапроса(Профиль, "Цены");
	//- ИнфоСофт Ивонин К.А. 20.01.25 УА #89159
	
	ПеречислениеМП = Перечисления.ИС_МП_Маркетплейсы.ВБ;
	
	МассивПараметров = ПолучитьСписокПараметровЦен();
	
	Результат = ИС_MP_Сервер.ПолучитьЗначениеНастроек(Профиль, Перечисления.ИС_МП_Маркетплейсы.ВБ, МассивПараметров);
	
	СтруктураЦен = ПолучитьСтруктуруПараметровЦен();
	
	ЗаполнитьЗначенияСвойств(СтруктураЦен, Результат);
	
	РежимОкругленияЦен = СтруктураЦен.РежимОкругленияЦен;
	ИспользоватьПоследниеЦены = СтруктураЦен.ИспользоватьПоследниеЦены; 
	
	//+ ИнфоСофт Мурсалимов Д.Р. 04.02.25 УА #91535
	ВыгружатьНулевыеСкидки = СтруктураЦен.ВыгружатьНулевыеСкидки;
	//- ИнфоСофт Мурсалимов Д.Р. 04.02.25 УА #91535
	
	Если ТаблицаВыгрузки = Неопределено Тогда
				
		Запрос = Новый Запрос;
		Запрос.Текст = ПолучитьТекстЗапросаЦен(); 
		
		УстановитьПараметрыЗапросаЦен(Запрос, Профиль);                                                       
		
		РезультатЗапроса = Запрос.Выполнить();
		
		Если РезультатЗапроса.Пустой() Тогда
			Возврат;
		КонецЕсли;
		
		Выборка = РезультатЗапроса.Выбрать();
		
		ТаблицаВыгрузки = Новый ТаблицаЗначений;	
		
		ИС_МП_УправлениеЦенами.ЗаполнитьКолонкиТаблицыВыгрузкиЦен(ПеречислениеМП, ТаблицаВыгрузки);
		
		МассивПолей = ИС_МП_УправлениеЦенами.ПолучитьПоляДляВыгрузки(ПеречислениеМП);
		
		Пока Выборка.Следующий() Цикл
		
			Если Не Выборка.ЕстьСопоставление И Не Выборка.ЕстьРучнаяЦена И Не Выборка.ЕстьРучнаяЦенаСоСкидкой Тогда
				Продолжить;
			КонецЕсли;
			
			НоваяСтрока = ТаблицаВыгрузки.Добавить();
		
			Для Каждого Элемент Из МассивПолей Цикл
				НоваяСтрока[Элемент] = Выборка[Элемент];
			КонецЦикла;
			
			ЭтоНабор = Выборка.ЭтоНабор;
			
			Если Выборка.ЕстьРучнаяЦена Тогда
				Цена = Выборка.РучнаяЦена;
			Иначе  
				Цена = Выборка.Цена;	
			КонецЕсли;
			
			Цена = Окр(Цена, 0, РежимОкругленияЦен);
			
			НоваяСтрока.Цена = Цена;
			
			Если Выборка.ЕстьРучнаяЦенаСоСкидкой Тогда
				ЦенаСоСкидкой = Выборка.РучнаяЦенаСоСкидкой;
			Иначе
				ЦенаСоСкидкой = Выборка.ЦенаСоСкидкой;	
			КонецЕсли;
				
			ЦенаСоСкидкой = Окр(ЦенаСоСкидкой, 0, РежимОкругленияЦен);
				
			Если ЦенаСоСкидкой = 0 Тогда
				Скидка = 0;	
			Иначе
				Скидка = ?(Цена = 0, 0, 100 - Окр(ЦенаСоСкидкой / Цена * 100, 0, РежимОкругленияЦен));
			КонецЕсли;
			
			//+ ИнфоСофт Мурсалимов Д.Р. 04.02.25 УА #91535 
			НоваяСтрока.ВыгружатьСкидку = Ложь;
	
			Если ВыгружатьНулевыеСкидки Тогда
				
				НоваяСтрока.Скидка 			= Скидка;
				НоваяСтрока.ВыгружатьСкидку = Истина;
				
			Иначе	
				
				Если ЗначениеЗаполнено(Скидка) И Скидка > 0 Тогда 
					
					НоваяСтрока.Скидка 			= Скидка;         
					НоваяСтрока.ВыгружатьСкидку = Истина;       
					
				КонецЕсли;
				
			КонецЕсли;
			//- ИнфоСофт Мурсалимов Д.Р. 04.02.25 УА #91535
			
			Если НоваяСтрока.Цена = 0 И НоваяСтрока.Скидка = 0 Тогда 
				ТаблицаВыгрузки.Удалить(НоваяСтрока);
			КонецЕсли;
			
			Если Не ИспользоватьПоследниеЦены Тогда
				Продолжить;
			КонецЕсли;
			
			Если Не Выборка.ЕстьРучнаяЦена И Не Выборка.ЕстьРучнаяЦенаСоСкидкой Тогда
			
				Если Не ИС_МП_УправлениеЦенами.ПроверитьПоследниеЦены(ПеречислениеМП, Выборка, НоваяСтрока) Тогда				
					ТаблицаВыгрузки.Удалить(НоваяСтрока);
				КонецЕсли; 
				
			КонецЕсли;
			
		КонецЦикла;
				
	КонецЕсли;
	
	Если ТаблицаВыгрузки.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	data = Новый Массив;
		
	Для Каждого Строка Из ТаблицаВыгрузки Цикл
		
		dataStructure = Новый Структура;
		dataStructure.Вставить("nmID", 		Строка.nmId);
		dataStructure.Вставить("price", 	Строка.Цена);
		
		//+ ИнфоСофт Стояк Ю.К. 07.10.2024 УА #84967		
		//dataStructure.Вставить("discount", 	Строка.Скидка);
		Если Строка.ВыгружатьСкидку Тогда
			dataStructure.Вставить("discount", 	Строка.Скидка);	
		КонецЕсли;
		//- ИнфоСофт Стояк Ю.К. 07.10.2024 УА #84967
		
		data.Добавить(dataStructure);		
		
	КонецЦикла;
		
	РазбитыйМассив = ИС_MP_Сервер.РазбитьМассивПоNЭлементов(data, 1000);
	
	БылиОшибкиВыгрузки = Ложь;
	
	Для Каждого Элемент Из РазбитыйМассив Цикл
	
		Результат = ИС_WB_API.ВыгрузитьЦеныИСкидки(Профиль, ПараметрыЗапроса, Элемент);	 
	
		Если ЗначениеЗаполнено(Результат) Тогда
			
		Иначе
			БылиОшибкиВыгрузки = Истина;	
			Текст = "Не удалось обновить цены товаров";			
			ИС_MP_Сервер.ЗаписатьВЖРИСообщитьПользователю(Событие, Текст);
		КонецЕсли;

	КонецЦикла;
	
	Если Не БылиОшибкиВыгрузки И ИспользоватьПоследниеЦены Тогда
		
		Для Каждого Строка Из ТаблицаВыгрузки Цикл	
			
			ИС_МП_УправлениеЦенами.ЗаписатьПоследнююВыгруженнуюЦену(Профиль, 
			Перечисления.ИС_МП_Маркетплейсы.ВБ, Строка.РазмерWB, Строка.Цена, Перечисления.ИС_МП_ВидыЦенМаркетплейса.ВидЦены);
			
			ИС_МП_УправлениеЦенами.ЗаписатьПоследнююВыгруженнуюЦену(Профиль, 
			Перечисления.ИС_МП_Маркетплейсы.ВБ, Строка.РазмерWB, Строка.ЦенаСоСкидкой, Перечисления.ИС_МП_ВидыЦенМаркетплейса.ВидЦеныСоСкидкой);
			
		КонецЦикла;
		
	КонецЕсли;
						
КонецПроцедуры //- ИнфоСофт Мурсалимов Д.Р. 12.05.24 УА #66901

//+ ИнфоСофт Ивонин К.А. 18.12.22 УА #52439
Функция ПолучитьТекстЗапросаЦен() Экспорт
    
    ИмяМодуля = ИС_MP_Сервер.ПолучитьИмяМодуляКонфигурации();
    ОбщийМодуль = ОбщегоНазначения.ОбщийМодуль(ИмяМодуля);
    
    Если ОбщийМодуль = Неопределено Тогда
    	Возврат Неопределено;
    КонецЕсли;
    
    Возврат ОбщийМодуль.ПолучитьТекстЗапросаЦен();

КонецФункции //- ИнфоСофт Ивонин К.А. 18.12.22 УА #52439

//+ ИнфоСофт Мурсалимов Д.Р. 13.05.24 УА #66901
Процедура УстановитьПараметрыЗапросаЦен(Запрос, Профиль) Экспорт
    
    ИмяМодуля = ИС_MP_Сервер.ПолучитьИмяМодуляКонфигурации();
    ОбщийМодуль = ОбщегоНазначения.ОбщийМодуль(ИмяМодуля);
    
    Если ОбщийМодуль = Неопределено Тогда
    	Возврат;
    КонецЕсли;
    
    ОбщийМодуль.УстановитьПараметрыЗапросаЦен(Запрос, Профиль);
    		
КонецПроцедуры //- ИнфоСофт Мурсалимов Д.Р. 13.05.24 УА #66901

//+ ИнфоСофт Мурсалимов Д.Р. 04.07.24 УА #66901
Функция ПолучитьСписокПараметровЦен() Экспорт

	Результат = Новый Массив;
	
	Результат.Добавить("ВидЦены");
	Результат.Добавить("ВидЦеныСоСкидкой");
	Результат.Добавить("РежимОкругленияЦен");
	Результат.Добавить("ИспользоватьПоследниеЦены");
	
	//+ ИнфоСофт Заварин К.В. 15.08.24 УА #72696
	Результат.Добавить("КоличествоОстаткаДляПереходаНаFBS");
	Результат.Добавить("ИспользоватьИзменениеЦенFboFbs");
	Результат.Добавить("ВидЦеныFBO");
