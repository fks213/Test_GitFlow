//+ ИнфоСофт Ивонин К.А. 26.01.23 УА #53535
Функция ПолучитьИнфорамциюОбОстаткахFBS(Профиль) Экспорт
	
	//+ ИнфоСофт Ивонин К.А. 20.01.25 УА #89159
	//НастройкиСоединения = ПолучитьНастройкиСоединенияПрофиля(Профиль);
	//	
	//Если НастройкиСоединения.Количество() = 0 Тогда
	//	ВызватьИсключение("Не удалось получить настройки подключения, проверьте настройки авторизации");
	//КонецЕсли;  
	//	
	//ПараметрыЗапроса = ИС_MP_РаботаСHTTPЗапросамиСервер.ПолучитьСтруктуруHTTPЗапроса();
	//РезультатПроверки = ПроверитьИЗаполнитьПараметрыЗапросаДляСервисаAPI(ПараметрыЗапроса, НастройкиСоединения);
	//
	//Если Не РезультатПроверки Тогда
	//	Возврат Неопределено;
	//КонецЕсли;
	
	ПараметрыЗапроса = ИС_ВБ_Сервер.ПараметрыHTTPЗапроса(Профиль, "Маркетплейс");
	//- ИнфоСофт Ивонин К.А. 20.01.25 УА #89159
		
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ИС_ВБ_Склады.Наименование КАК Наименование,
	|	ИС_ВБ_Склады.Код КАК Код
	|ИЗ
	|	Справочник.ИС_ВБ_Склады КАК ИС_ВБ_Склады
	|ГДЕ
	|	НЕ ИС_ВБ_Склады.ПометкаУдаления
	|	И ИС_ВБ_Склады.ЗагруженИзЛК
	|	И ИС_ВБ_Склады.Профиль = &Профиль";
	
	Запрос.УстановитьПараметр("Профиль", Профиль);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаСклады = РезультатЗапроса.Выбрать();
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ИС_WB_РазмерыНоменклатур.Владелец.object КАК subject,
	|	ИС_WB_НоменклатураХарактеристики.Значение КАК brand,
	|	ИС_WB_РазмерыНоменклатур.Владелец.Код КАК nmId,
	|	МАКСИМУМ(ИС_WB_ШтрихкодыРазмеров.Штрихкод) КАК barcode,
	|	ИС_WB_РазмерыНоменклатур.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.ИС_WB_РазмерыНоменклатур КАК ИС_WB_РазмерыНоменклатур
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ИС_WB_Номенклатура.Характеристики КАК ИС_WB_НоменклатураХарактеристики
	|		ПО (ИС_WB_РазмерыНоменклатур.Владелец = ИС_WB_НоменклатураХарактеристики.Ссылка)
	|			И (ИС_WB_НоменклатураХарактеристики.Поле.Наименование = ""Бренд"")
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ИС_WB_ШтрихкодыРазмеров КАК ИС_WB_ШтрихкодыРазмеров
	|		ПО (ИС_WB_РазмерыНоменклатур.Ссылка = ИС_WB_ШтрихкодыРазмеров.Размер)
	|ГДЕ
	|	ИС_WB_РазмерыНоменклатур.Профиль = &Профиль
	|	И НЕ ИС_WB_ШтрихкодыРазмеров.Штрихкод = """"
	|
	|СГРУППИРОВАТЬ ПО
	|	ИС_WB_РазмерыНоменклатур.Владелец.object,
	|	ИС_WB_НоменклатураХарактеристики.Значение,
	|	ИС_WB_РазмерыНоменклатур.Владелец.Код,
	|	ИС_WB_РазмерыНоменклатур.Ссылка";
	
	Запрос.УстановитьПараметр("Профиль", Профиль);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаШтрихкоды = РезультатЗапроса.Выбрать();
	
	МассивSKU = Новый Массив;
	
	Пока ВыборкаШтрихкоды.Следующий() Цикл
		МассивSKU.Добавить(ВыборкаШтрихкоды.barcode);
	КонецЦикла;
	
	Результат = Новый ТаблицаЗначений; 
	КвалификаторыЧисла = Новый КвалификаторыЧисла(15, 0, ДопустимыйЗнак.Неотрицательный);
	//+ ИнфоСофт Стояк Ю.К. 15.03.2024 УА #72261	
	//КвалификаторыСтроки = Новый КвалификаторыСтроки(20);
	КвалификаторыСтроки = Новый КвалификаторыСтроки(80);
	//- ИнфоСофт Стояк Ю.К. 15.03.2024 УА #72261

	Результат.Колонки.Добавить("Предмет", Новый ОписаниеТипов("Строка", КвалификаторыСтроки));
	Результат.Колонки.Добавить("Бренд", Новый ОписаниеТипов("Строка", КвалификаторыСтроки));
	Результат.Колонки.Добавить("ИД", Новый ОписаниеТипов("Число", КвалификаторыЧисла));
	Результат.Колонки.Добавить("Штрихкод", Новый ОписаниеТипов("Строка", КвалификаторыСтроки));
	Результат.Колонки.Добавить("Склад", Новый ОписаниеТипов("Строка", КвалификаторыСтроки));
	Результат.Колонки.Добавить("НаСкладе", Новый ОписаниеТипов("Число", КвалификаторыЧисла));
	Результат.Колонки.Добавить("ТипСклада", Новый ОписаниеТипов("Число", КвалификаторыЧисла));	
	//+ ИнфоСофт Стояк Ю.К. 16.02.2024 УА #70683                                                
	Результат.Колонки.Добавить("ФБС", Новый ОписаниеТипов("Булево"));
	//Результат.Колонки.Добавить("КодСклада", Новый ОписаниеТипов("Число", КвалификаторыЧисла));
	//- ИнфоСофт Стояк Ю.К. 16.02.2024 УА #70683
		
	Пока ВыборкаСклады.Следующий() Цикл
		
		МассивДляВыгрузки = ИС_MP_Сервер.РазбитьМассивПоNЭлементов(МассивSKU, 1000);
		
		Для Каждого Массив Из МассивДляВыгрузки Цикл
			
			ОстаткиТоваров = ИС_WB_API.ПолучитьОстаткиТоваров(Профиль, ПараметрыЗапроса, ВыборкаСклады.Код, Массив);
				
			Если ОстаткиТоваров = Неопределено Тогда
				Продолжить;
			КонецЕсли;
	        
	        ВыборкаШтрихкоды.Сбросить();
	        
	        Пока ВыборкаШтрихкоды.Следующий() Цикл
			
				Для Каждого Элемент Из ОстаткиТоваров.stocks Цикл
			   
			    	Если Элемент.sku = ВыборкаШтрихкоды.barcode Тогда
			    	
			    		НоваяСтрока = Результат.Добавить();
						НоваяСтрока.Предмет = ВыборкаШтрихкоды.subject;
						НоваяСтрока.Бренд = ВыборкаШтрихкоды.brand;
						НоваяСтрока.ИД = ВыборкаШтрихкоды.nmId;
						НоваяСтрока.Штрихкод = ВыборкаШтрихкоды.barcode;
						НоваяСтрока.Склад = ВыборкаСклады.Наименование;
						НоваяСтрока.НаСкладе = Элемент.amount;
						НоваяСтрока.ТипСклада = 0;
						//+ ИнфоСофт Стояк Ю.К. 16.02.2024 УА #70683						
						НоваяСтрока.ФБС = Истина;
						//НоваяСтрока.КодСклада = ВыборкаСклады.Код;  
						//- ИнфоСофт Стояк Ю.К. 16.02.2024 УА #70683

			    	КонецЕсли;
				
				КонецЦикла;        
	        
	        КонецЦикла;
	        
		КонецЦикла; 
						
	КонецЦикла;
	
	Возврат Результат;			
	
КонецФункции //- ИнфоСофт Ивонин К.А. 26.01.23 УА #53535

//+ ИнфоСофт Ивонин К.А. 02.03.23 УА #53535
//+ ИнфоСофт Стояк Ю.К. 20.10.2023 УА #62749
