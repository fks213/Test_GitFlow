//+ ИнфоСофт Заварин К.В. 14.08.24 УА #72696
Процедура ПерезаписатьЦеныWBПоМассивуШтихкодов(Профиль, МассивДляУстановкиЦен, ВидЦеныFBO)
	
	Настройки = ИС_WB_СерверПовтИсп.ПолучитьПараметрыВыгрузкиЦен(Профиль);
	ПеречислениеМП = Перечисления.ИС_МП_Маркетплейсы.ВБ;

	Запрос = Новый Запрос;
	Запрос.Текст = ПолучитьТекстЗапросаЦен(); 
	
	УстановитьПараметрыЗапросаЦен(Запрос, Профиль);
		
	РезультатЗапроса = Запрос.Выполнить();
	
	Если РезультатЗапроса.Пустой() Тогда 
		
		Текст = "Ошибка получения цен.";
		ЗаписьЖурналаРегистрации("ИС.WB.ВыполнениеАлгоритмаПоОсновнойСхемеFbo", УровеньЖурналаРегистрации.Ошибка, , , Текст);
		Возврат; 
		
	КонецЕсли;
	
	Выборка = РезультатЗапроса.Выбрать();
	
	ТаблицаВыгрузкиЦен = Новый ТаблицаЗначений;
	ТаблицаВыгрузкиЦен.Колонки.Добавить("Штрихкод");
	ТаблицаВыгрузкиЦен.Колонки.Добавить("Размер");
	ТаблицаВыгрузкиЦен.Колонки.Добавить("Цена");
	ТаблицаВыгрузкиЦен.Колонки.Добавить("ЦенаFBO");
	
	Пока Выборка.Следующий() Цикл 
		
		ЭтоНабор = Выборка.ЭтоНабор;
		
		Если ЭтоНабор Тогда
			
			ЦеныНаборов = ИС_МП_УправлениеЦенами.РассчитатьЦеныНаборов(Профиль, ПеречислениеМП, Выборка);	
			ТекущаяЦенаFBO = Окр(ЦеныНаборов.ЦенаFBO, 0, Настройки.РежимОкругленияЦен);
			ТекущаяЦена    = Окр(ЦеныНаборов.Цена, 0, Настройки.РежимОкругленияЦен);
			
		Иначе
			
			ТекущаяЦенаFBO = Окр(Выборка.ЦенаFBO, 0, Настройки.РежимОкругленияЦен);
			ТекущаяЦена    = Окр(Выборка.Цена, 0, Настройки.РежимОкругленияЦен);
			
		КонецЕсли;
		
		Если ТекущаяЦенаFBO <> 0 И МассивДляУстановкиЦен.Найти(Выборка.Штрихкод) <> Неопределено Тогда
			
			НоваяСтрока = ТаблицаВыгрузкиЦен.Добавить();
			
			НоваяСтрока.Штрихкод = Выборка.Штрихкод;
			НоваяСтрока.Размер   = Выборка.РазмерWB;
			НоваяСтрока.ЦенаFBO  = ТекущаяЦенаFBO;
			НоваяСтрока.Цена  	 = ТекущаяЦена;
			
		КонецЕсли;
		
	КонецЦикла;
	
	НаборЗаписей = РегистрыСведений.ИС_МП_РучныеЦены.СоздатьНаборЗаписей();
	НаборЗаписей.Отбор.Профиль.Установить(Профиль);
	НаборЗаписей.Отбор.Маркетплейс.Установить(Перечисления.ИС_МП_Маркетплейсы.ВБ);
	НаборЗаписей.Записать();
	
	Если ТаблицаВыгрузкиЦен.Количество() > 0 Тогда	
		
		Для Каждого Строка Из ТаблицаВыгрузкиЦен Цикл
			
			ИС_МП_УправлениеЦенами.ЗаписатьРучнуюЦену(Профиль, Перечисления.ИС_МП_Маркетплейсы.ВБ, Строка.Размер, Строка.ЦенаFBO, Перечисления.ИС_МП_ВидыЦенМаркетплейса.ВидЦеныСоСкидкой); 
			ИС_МП_УправлениеЦенами.ЗаписатьРучнуюЦену(Профиль, Перечисления.ИС_МП_Маркетплейсы.ВБ, Строка.Размер, Строка.Цена, Перечисления.ИС_МП_ВидыЦенМаркетплейса.ВидЦены);  	
			
		КонецЦикла;
		
	КонецЕсли;			
	
КонецПроцедуры //- ИнфоСофт Заварин К.В. 14.08.24 УА #72696

//+ ИнфоСофт Мурсалимов Д.Р. 23.04.25 УА #99629
Функция ПолучитьАктивныйЗаказКлиента(Профиль) Экспорт
	
	Запрос = Новый Запрос;
	
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ИС_WB_Профили.АктивныйЗаказКлиента КАК АктивныйЗаказКлиента
	|ИЗ
	|	Справочник.ИС_WB_Профили КАК ИС_WB_Профили
	|ГДЕ
	|	ИС_WB_Профили.Ссылка = &Профиль";
	
	Запрос.УстановитьПараметр("Профиль", Профиль);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Выборка = РезультатЗапроса.Выбрать();
	
	Если Выборка.Следующий() Тогда
		Результат = Выборка.АктивныйЗаказКлиента;	
	Иначе	
		Результат = Неопределено;	
	КонецЕсли;
	
	Возврат Результат;

КонецФункции //- ИнфоСофт Мурсалимов Д.Р. 23.04.25 УА #99629
