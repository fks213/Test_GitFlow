Процедура ЗагрузитьДанныеОК(Профиль, ДатаНачала, ДатаКонца) Экспорт
	
	Событие = ПолучитьИмяСобытия("ЗагрузитьДанныеОК");
	
	//+ ИнфоСофт Ивонин К.А. 20.01.25 УА #89159
	//НастройкиСоединения = ПолучитьНастройкиСоединенияПрофиля(Профиль);
	//
	//Если НастройкиСоединения.Количество() = 0 Тогда
	//	ВызватьИсключение("Не удалось получить настройки подключения, проверьте настройки авторизации");
	//КонецЕсли;  
	//
	//ПараметрыЗапроса = ИС_MP_РаботаСHTTPЗапросамиСервер.ПолучитьСтруктуруHTTPЗапроса();
	//РезультатПроверки = ПроверитьИЗаполнитьПараметрыЗапросаДляСервисаСтатистики(ПараметрыЗапроса, НастройкиСоединения);
	//
	//Если Не РезультатПроверки Тогда
	//	Возврат;
	//КонецЕсли;
	
	ПараметрыЗапроса = ИС_ВБ_Сервер.ПараметрыHTTPЗапроса(Профиль, "Статистика");
	//- ИнфоСофт Ивонин К.А. 20.01.25 УА #89159
	
	rrdid = 0;
	
	Кэш = Новый Структура;
	Исключения = Новый Структура;
	
	ЗаполчитьКэшПараметров(Кэш, Исключения);
	
	Пока Истина Цикл
		
		Результат = ИС_WB_API.ПолучитьОтчетОПродажахПоРеализации(Профиль, ПараметрыЗапроса, ДатаНачала, ДатаКонца, , rrdid);
		
		Если Результат = Неопределено Тогда
			Прервать;
		КонецЕсли;
		
		Если Результат.Количество() = 0 Тогда
			Прервать;
		КонецЕсли;
		
		Для Каждого Структура Из Результат Цикл
			
			Если Структура.Свойство("rrd_id") Тогда
				rrd_id = Структура.rrd_id;
			Иначе
				ЗаписьЖурналаРегистрации(Событие, УровеньЖурналаРегистрации.Ошибка, , , "Не найдено поле rrd_id");
				Продолжить;
			КонецЕсли;
						
			Если Структура.Свойство("realizationreport_id") Тогда
				realizationreport_id = Структура.realizationreport_id;
			Иначе
				ЗаписьЖурналаРегистрации(Событие, УровеньЖурналаРегистрации.Ошибка, , , "Не найдено поле realizationreport_id");
				Продолжить;
			КонецЕсли; 
			
			Если Структура.Свойство("date_from") Тогда
				date_from = Структура.date_from;
			Иначе
				ЗаписьЖурналаРегистрации(Событие, УровеньЖурналаРегистрации.Ошибка, , , "Не найдено поле date_from");
				Продолжить;
			КонецЕсли;
			
			Если Структура.Свойство("date_to") Тогда
				date_to = Структура.date_to;
			Иначе
				ЗаписьЖурналаРегистрации(Событие, УровеньЖурналаРегистрации.Ошибка, , , "Не найдено поле date_to");
				Продолжить;
			КонецЕсли;
			
			Если Структура.Свойство("create_dt") Тогда
				create_dt = Структура.create_dt;
			Иначе
				ЗаписьЖурналаРегистрации(Событие, УровеньЖурналаРегистрации.Ошибка, , , "Не найдено поле create_dt");
				Продолжить;
			КонецЕсли;
			
			Если Структура.Свойство("site_country") Тогда
			
				Если ЗначениеЗаполнено(Структура.site_country) И Структура.site_country <> "RU" Тогда 
					Иностранные = Истина; 
				Иначе
					Иностранные = Ложь;
				КонецЕсли;
				
			Иначе
				ЗаписьЖурналаРегистрации(Событие, УровеньЖурналаРегистрации.Ошибка, , , "Не найдено поле site_country");
				Продолжить;
			КонецЕсли;
						
			date_from = ИС_MP_РаботаСHTTPЗапросамиСервер.ПрочитатьДатуИзJSON(date_from, ФорматДатыJSON.ISO);
			date_to = ИС_MP_РаботаСHTTPЗапросамиСервер.ПрочитатьДатуИзJSON(date_to, ФорматДатыJSON.ISO);
			create_dt = ИС_MP_РаботаСHTTPЗапросамиСервер.ПрочитатьДатуИзJSON(create_dt, ФорматДатыJSON.ISO);
			
			НаборЗаписей = РегистрыСведений.ИС_WB_ДанныеОтчетовРеализации.СоздатьНаборЗаписей();
            	
            НаборЗаписей.Отбор.Период.Установить(date_from);
            НаборЗаписей.Отбор.Профиль.Установить(Профиль);
            НаборЗаписей.Отбор.rrd_id.Установить(rrd_id);
			            
            Для Каждого Элемент Из Структура Цикл
                
                Если Исключения.Свойство(Элемент.Ключ) Тогда
                	Продолжить;	
                КонецЕсли;
                
                Если Кэш.Свойство(Элемент.Ключ) Тогда
                	Параметр = Кэш[Элемент.Ключ];
                Иначе
                	
                	НовыйЭлемент = Справочники.ИС_WB_ПараметрыОтчетовРеализации.СоздатьЭлемент();
                	НовыйЭлемент.Наименование = Элемент.Ключ;
                	
                	Попытка
                		НовыйЭлемент.Записать();
                	Исключение
                		ЗаписьЖурналаРегистрации(Событие, УровеньЖурналаРегистрации.Ошибка, , , ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
                		Продолжить;
                	КонецПопытки;
                	
                	Кэш.Вставить(Элемент.Ключ, НовыйЭлемент.Ссылка);
                	Параметр = НовыйЭлемент.Ссылка;
                		
				КонецЕсли; 								
                            	
            	НоваяЗапись = НаборЗаписей.Добавить();
            	НоваяЗапись.Период = date_from;
            	НоваяЗапись.rrd_id = rrd_id;
            	НоваяЗапись.Иностранные = Иностранные;
            	НоваяЗапись.realizationreport_id = realizationreport_id;
            	НоваяЗапись.date_to = date_to;
            	НоваяЗапись.create_dt = create_dt;
            	НоваяЗапись.Параметр = Параметр;
				//+ ИнфоСофт Стояк Ю.К. 08.12.2023 УА #61698				
				НоваяЗапись.Профиль = Профиль;
				Если Элемент.Ключ = "sale_dt" И ЗначениеЗаполнено(Элемент.Значение) Тогда
					sale_dt = ИС_MP_РаботаСHTTPЗапросамиСервер.ПрочитатьДатуИзJSON(Элемент.Значение, ФорматДатыJSON.ISO);
					НоваяЗапись.Значение = sale_dt;         
				Иначе
					НоваяЗапись.Значение = Элемент.Значение;
				КонецЕсли;
				//- ИнфоСофт Стояк Ю.К. 08.12.2023 УА #61698            	    	   
            
            КонецЦикла;
            
            НаборЗаписей.Записать(Истина);
            		
		КонецЦикла;
	
		rrdid = Результат[Результат.Количество() - 1].rrd_id;
			
	КонецЦикла;	
	
КонецПроцедуры //- ИнфоСофт Ивонин К.А. 27.10.23 УА #61512

