КонецПроцедуры //- ИнфоСофт Сумин Д.В. 27.02.2024 УА #71107

//+ ИнфоСофт Сумин Д.В. 27.02.2024 УА #71107
Функция ЗаписатьДанныеПродаж(СтруктураДанных)
	
	Событие = ПолучитьИмяСобытия("ЗаписатьДанныеПродаж");
	
	Профиль = СтруктураДанных.Профиль; 
	НомерОтчета = СтруктураДанных.НомерОтчета; 
	Детализация = СтруктураДанных.Детализация;
	
	НачатьТранзакцию();
	
	Попытка
						
		ПараметрыОтчета = ПолучитьПараметрыОтчета();
		
		Для Каждого Элемент Из ПараметрыОтчета Цикл
			
			Если Детализация.Колонки.Найти(Элемент.Наименование) = Неопределено Тогда 
				Продолжить;
			КонецЕсли;
			    
			НаборЗаписей = РегистрыСведений.ИС_WB_ДанныеОтчетовОПродажах.СоздатьНаборЗаписей();
			НаборЗаписей.Отбор.Профиль.Установить(Профиль); 
			НаборЗаписей.Отбор.НомерОтчета.Установить(НомерОтчета);
			НаборЗаписей.Отбор.Параметр.Установить(Элемент.Параметр);
		   
		   	СтрокаНомер = 0;
		    
		    Для Каждого Строка Из Детализация Цикл

				НоваяЗапись = НаборЗаписей.Добавить(); 
				
				НоваяЗапись.Профиль = Профиль;
				НоваяЗапись.НомерОтчета = НомерОтчета;
				НоваяЗапись.Параметр = Элемент.Параметр;
				НоваяЗапись.ЗначениеПараметра = Строка[Элемент.Наименование];
				НоваяЗапись.СтрокаНомер = СтрокаНомер; 
				
				СтрокаНомер = СтрокаНомер + 1; 
			
			КонецЦикла; 
			
			НаборЗаписей.Записать();
					
		КонецЦикла; 
		
		ЗафиксироватьТранзакцию(); 
		
		Результат = Новый Структура;
		
		Результат.Вставить("НомерСтраницы", 1);
		
		Возврат Результат; 
		
	Исключение
	
		ОтменитьТранзакцию();
		Текст = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
		ИС_MP_Сервер.ЗаписатьВЖРИСообщитьПользователю(Событие, Текст);
		Возврат Неопределено;

	КонецПопытки;
	
КонецФункции //- ИнфоСофт Сумин Д.В. 27.02.2024 УА #71107

//+ ИнфоСофт Сумин Д.В. 27.02.2024 УА #71107
Функция ПолучитьПараметрыОтчета()
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ИС_WB_ПараметрыОтчетовОПродажах.Наименование КАК Наименование,
	|	ИС_WB_ПараметрыОтчетовОПродажах.Ссылка КАК Параметр
	|ИЗ
	|	Справочник.ИС_WB_ПараметрыОтчетовОПродажах КАК ИС_WB_ПараметрыОтчетовОПродажах";
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Выборка = РезультатЗапроса.Выбрать();
	
	Результат = Новый Массив;
	
	Пока Выборка.Следующий() Цикл
		ДанныеПараметра = Новый Структура;
		ДанныеПараметра.Вставить("Наименование", Выборка.Наименование);
		ДанныеПараметра.Вставить("Параметр", Выборка.Параметр);
		
		Результат.Добавить(ДанныеПараметра);  
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции //- ИнфоСофт Сумин Д.В. 27.02.2024 УА #71107

