	|	ВТ_Размер.Баркод КАК Баркод,
	|	ВТ_Размер.Артикул КАК Артикул,
	|	ВТ_Размер.РазмерПоставщика КАК РазмерПоставщика,
	|	ВТ_Размер.Код КАК Код,
	|	ЕСТЬNULL(ИС_WB_СоответствиеРазмеров.Номенклатура, ЗНАЧЕНИЕ(Справочник.Номенклатура.ПустаяСсылка)) КАК Номенклатура,
