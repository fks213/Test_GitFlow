		ОстаткиFBO = ПолучитьИнфорамциюОбОстаткахFBO(Профиль); 
	Исключение
		Текст = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
		ЗаписьЖурналаРегистрации("ИС.WB.ВыполнениеАлгоритмаПоОсновнойСхемеFbo", УровеньЖурналаРегистрации.Ошибка, , , Текст);
		Возврат;
	КонецПопытки;
	
	Если ОстаткиFBO.Количество() = 0 Тогда
		Текст = "Wildberries не предоставляет информацию по остаткам. Проверьте корректность токена статистики. Если токен корректный, необходимо обратиться в техническую поддержку Wildberries для уточнения сроков исправления неисправностей.";
		ЗаписьЖурналаРегистрации("ИС.WB.ВыполнениеАлгоритмаПоОсновнойСхемеFbo", УровеньЖурналаРегистрации.Ошибка, , , Текст);
		Возврат;	
	КонецЕсли;	
	
	ОстаткиFBO.Свернуть("Штрихкод", "НаСкладе");
	
	МассивПараметров = ПолучитьСписокПараметровЦен();
	
	Результат = ИС_MP_Сервер.ПолучитьЗначениеНастроек(Профиль, Перечисления.ИС_МП_Маркетплейсы.ВБ, МассивПараметров);
	
	СтруктураЦен = ПолучитьСтруктуруПараметровЦен();
	
	ЗаполнитьЗначенияСвойств(СтруктураЦен, Результат);
	
	КоличествоОстаткаДляПереходаНаFBS = СтруктураЦен.КоличествоОстаткаДляПереходаНаFBS;
	ВидЦены    						  = СтруктураЦен.ВидЦены;
	ВидЦеныFBO 						  = СтруктураЦен.ВидЦеныFBO;
	ИспользоватьИзменениеЦенFboFbs 	  = СтруктураЦен.ИспользоватьИзменениеЦенFboFbs;
	
	// цены
	МассивДляУстановкиЦен = Новый Массив;	
	
	Для Каждого Элемент Из ОстаткиFBO Цикл
		
		Если ИспользоватьИзменениеЦенFboFbs И Элемент.НаСкладе > КоличествоОстаткаДляПереходаНаFBS Тогда
			МассивДляУстановкиЦен.Добавить(Элемент.Штрихкод); 
		КонецЕсли;
			
	КонецЦикла;	
	
	Если ИспользоватьИзменениеЦенFboFbs Тогда
		Если МассивДляУстановкиЦен.Количество() > 0 И НЕ ВидЦеныFBO = Справочники.ВидыЦен.ПустаяСсылка() Тогда	
			ПерезаписатьЦеныWBПоМассивуШтихкодов(Профиль, МассивДляУстановкиЦен, ВидЦеныFBO);	
		КонецЕсли;		
	КонецЕсли;
	
	// остатки
	ЗапросСклады = Новый Запрос;
	ЗапросСклады.Текст =
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ИС_ВБ_Склады.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.ИС_ВБ_Склады КАК ИС_ВБ_Склады
	|ГДЕ
	|	ИС_ВБ_Склады.Профиль = &Профиль
	|	И ИС_ВБ_Склады.ЗагруженИзЛК";
	
	ЗапросСклады.УстановитьПараметр("Профиль", Профиль);
	РезультатЗапросаСклады = ЗапросСклады.Выполнить();
	
	Если РезультатЗапросаСклады.Пустой() Тогда
		Текст = "В информационной базе не найден ни один склад fbs. Выполните загрузку складов.";
		ЗаписьЖурналаРегистрации("ИС.WB.ВыполнениеАлгоритмаПоОсновнойСхемеFbo", УровеньЖурналаРегистрации.Ошибка, , , Текст);
		Возврат;	
	КонецЕсли;
	
	ВыборкаСклады = РезультатЗапросаСклады.Выбрать();
	
	МассивСкладов = Новый Массив;
	
	Пока ВыборкаСклады.Следующий() Цикл
		
		МассивСкладов.Добавить(ВыборкаСклады.Ссылка);
		
	КонецЦикла;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ОстаткиFBO.НаСкладе КАК НаСкладе,
	|	ОстаткиFBO.Штрихкод КАК Штрихкод
	|ПОМЕСТИТЬ ВТ_Остатки
	|ИЗ
	|	&ОстаткиFBO КАК ОстаткиFBO
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ИС_WB_ШтрихкодыРазмеров.Размер КАК Размер,
	|	ИС_ВБ_Склады.Ссылка КАК Склад
	|ИЗ
	|	РегистрСведений.ИС_WB_ШтрихкодыРазмеров КАК ИС_WB_ШтрихкодыРазмеров
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТ_Остатки КАК ВТ_Остатки
	|		ПО ИС_WB_ШтрихкодыРазмеров.Штрихкод = ВТ_Остатки.Штрихкод,
	|	Справочник.ИС_ВБ_Склады КАК ИС_ВБ_Склады
	|ГДЕ
	|	ИС_WB_ШтрихкодыРазмеров.Профиль = &Профиль
	|	И ИС_ВБ_Склады.Ссылка В(&МассивСкладов)
	|	И ВЫБОР
	|			КОГДА ИС_ВБ_Склады.КоличествоОстаткаДляПереходаНаFBS > 0
	|				ТОГДА ВТ_Остатки.НаСкладе > ИС_ВБ_Склады.КоличествоОстаткаДляПереходаНаFBS
	|			ИНАЧЕ ВТ_Остатки.НаСкладе > ИС_ВБ_Склады.КоличествоОстаткаДляПереходаНаFBS
	|		КОНЕЦ
	|
	|СГРУППИРОВАТЬ ПО
	|	ИС_WB_ШтрихкодыРазмеров.Размер,
	|	ИС_ВБ_Склады.Ссылка
	|ИТОГИ ПО
	|	Склад";
	
	Запрос.УстановитьПараметр("ТЗ_Остатки", ОстаткиFBO);
	Запрос.УстановитьПараметр("МассивСкладов", МассивСкладов);
	Запрос.УстановитьПараметр("Профиль", Профиль);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаСклад = РезультатЗапроса.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам, "Склад");
	
	Пока ВыборкаСклад.Следующий() Цикл
		
		НаборЗаписей = РегистрыСведений.ИС_MP_РучныеОстатки.СоздатьНаборЗаписей();
		НаборЗаписей.Отбор.Профиль.Установить(Профиль);
		НаборЗаписей.Отбор.Маркетплейс.Установить(Перечисления.ИС_МП_Маркетплейсы.ВБ);
		НаборЗаписей.Отбор.Склад.Установить(ВыборкаСклад.Склад);
		НаборЗаписей.Записать();
	
		ВыборкаДетальныеЗаписи = ВыборкаСклад.Выбрать();
	
		Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
			ИС_МП_УправлениеОстатками.ЗаписатьРучнойОстаток(Профиль, Перечисления.ИС_МП_Маркетплейсы.ВБ, ВыборкаСклады.Ссылка, ВыборкаДетальныеЗаписи.Размер, 0);
		КонецЦикла;
	КонецЦикла;
	
КонецПроцедуры //- ИнфоСофт Макарова Н.Е. 11.04.2025 УА #94883	 

//+ ИнфоСофт Сумин Д.В. 30.06.2023 УА #60267
Функция СтрокаВЧисло(Знач Значение) Экспорт
	
	Значение  = СтрЗаменить(Значение, " ", "");
	Если СтрНачинаетсяС(Значение, "(") Тогда
		Значение = СтрЗаменить(Значение, "(", "-");
		Значение = СтрЗаменить(Значение, ")", "");
	КонецЕсли; 
	
	Значение = СтрЗаменить(Значение, "руб.", ""); 
	Значение = СтрЗаменить(Значение, ".", "");
	
	СтрокаБезНулей = СтрЗаменить(Значение, "0", "");
	Если ПустаяСтрока(СтрокаБезНулей) Или СтрокаБезНулей = "-" Тогда
		Возврат 0;
	КонецЕсли;
	
	ТипЧисло  = Новый ОписаниеТипов("Число");
	Результат = ТипЧисло.ПривестиЗначение(Значение);
	
	Возврат ?(Результат <> 0 И Не ПустаяСтрока(СтрокаБезНулей), Результат, Неопределено);
	
КонецФункции //- ИнфоСофт Сумин Д.В. 30.06.2023 УА #60267

