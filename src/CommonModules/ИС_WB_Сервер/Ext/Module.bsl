//+ ИнфоСофт Ивонин К.А. 23.01.23 УА #53535
// Получает список сборочных заданий поставщика по переданным параметрам
//
// Параметры:
//  Профиль - СправочникСсылка.ИС_WB_Профили - профиль магазина поставщика WildBerries
//  ДатаНачала - Дата - дата с которой необходимо получить заказы
//  Статус	   - Число - число обозначающее статус в котором находится сборочное задание 
//  ИДЗадания  - Строка - идентификатор сборочного задания 
//  ПроверятьФО - Булево - признак обозначающий, что необходимо произвести действия в связи с функциональными опциями 
//
Процедура ПолучитьСписокСборочныхЗаданий(Профиль, ДатаНачала, ДатаОкончания = Неопределено) Экспорт

	Событие = ПолучитьИмяСобытия("ПолучитьСписокСборочныхЗаданий");

	//+ ИнфоСофт Ивонин К.А. 20.01.25 УА #89159
	//НастройкиСоединения = ПолучитьНастройкиСоединенияПрофиля(Профиль);
	//	
	//Если НастройкиСоединения.Количество() = 0 Тогда
	//	ВызватьИсключение("Не удалось получить настройки подключения, проверьте настройки авторизации");
	//КонецЕсли;  
	//	
	//ПараметрыЗапроса = ИС_MP_РаботаСHTTPЗапросамиСервер.ПолучитьСтруктуруHTTPЗапроса();
	//РезультатПроверки = ПроверитьИЗаполнитьПараметрыЗапросаДляСервисаAPI(ПараметрыЗапроса, НастройкиСоединения);
	//
	//Если Не РезультатПроверки Тогда
	//	Возврат;
	//КонецЕсли;
    	
	ПараметрыЗапроса = ИС_ВБ_Сервер.ПараметрыHTTPЗапроса(Профиль, "Маркетплейс");
	
	КоличествоЭлементовНаЗапрос = 100;
    КоличествоПопытокЗапроса = 10;
	//- ИнфоСофт Ивонин К.А. 20.01.25 УА #89159
		
	СтруктураПараметров = ИС_WB_API.ПолучитьСтруктуруПараметровЗапросаСборочныхЗаданий();
	
	//+ ИнфоСофт Ивонин К.А. 20.01.25 УА #89159
	//СтруктураПараметров.limit = НастройкиСоединения.КоличествоЭлементовНаЗапрос;
	СтруктураПараметров.limit = КоличествоЭлементовНаЗапрос;
	//- ИнфоСофт Ивонин К.А. 20.01.25 УА #89159
	СтруктураПараметров.dateFrom = ДатаНачала;
	СтруктураПараметров.dateTo = ДатаОкончания;
	
	Всего = 0;
	КоличествоОшибок = 0;
	
	ДатаПоследнегоЗадания = ДатаНачала;	
	МассивЗагруженныхЗаданий = Новый Массив;
	
	Пока Истина Цикл 
	
		//+ ИнфоСофт Ивонин К.А. 20.01.25 УА #89159
		//Если КоличествоОшибок = НастройкиСоединения.КоличествоОшибокЗапросов Тогда
        Если КоличествоОшибок = КоличествоПопытокЗапроса Тогда
		//- ИнфоСофт Ивонин К.А. 20.01.25 УА #89159
			Текст = "Превышено количество ошибок запросов к API";
			ИС_MP_Сервер.ЗаписатьВЖРИСообщитьПользователю(Событие, Текст);
			Возврат;
		КонецЕсли;
				
		РезультатЗапроса = ИС_WB_API.ПолучитьСписокСборочныхЗаданий(Профиль, ПараметрыЗапроса, СтруктураПараметров);
		
		Если РезультатЗапроса = Неопределено Тогда
			КоличествоОшибок = КоличествоОшибок + 1;
			Продолжить;
		КонецЕсли;
	
		Если Не РезультатЗапроса.Свойство("next") Тогда
			Прервать;
		КонецЕсли;
		
		Если РезультатЗапроса.orders.Количество() = 0 Тогда
			Прервать;
		КонецЕсли;
		
		СтруктураПараметров.next = РезультатЗапроса.next;
	
		Всего = Всего + РезультатЗапроса.orders.Количество();
		
		Для Каждого СборочноеЗадание Из РезультатЗапроса.orders Цикл	
		    
		    Если ИС_MP_РаботаСHTTPЗапросамиСервер.ПрочитатьДатуИзJSON(СборочноеЗадание.createdAt, ФорматДатыJSON.ISO) < ДатаНачала Тогда
		    	Продолжить;
		    КонецЕсли;
		    
			СсылкаЗадания = СоздатьИлиОбновитьСборочноеЗадание(Профиль, СборочноеЗадание, ДатаПоследнегоЗадания);		
		
			Если Не СсылкаЗадания.Пустая() Тогда
				МассивЗагруженныхЗаданий.Добавить(СсылкаЗадания);
			КонецЕсли;
		
		КонецЦикла;
			
	КонецЦикла;
	
	Если МассивЗагруженныхЗаданий.Количество() > 0 Тогда
		ПроверитьФункциональныеОпцииСборочныхЗаданий(Профиль, МассивЗагруженныхЗаданий);	
	КонецЕсли;
    
    Если Всего = 0 Тогда
		Текст = СтрШаблон("С %1 нет сборочных заданий для загрузки", ДатаНачала);
	Иначе
		Текст = СтрШаблон("Сборочные задания в количестве %1 успешно загружены", Всего);
		
		ПрофильОбъект = Профиль.ПолучитьОбъект();
		ПрофильОбъект.ДатаПоследнегоСборочногоЗадания = ДатаПоследнегоЗадания;
		ДатаНачала = ДатаПоследнегоЗадания;
		
		Попытка
			ПрофильОбъект.Записать();		
		Исключение
			ИнформацияОбОшибке = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
			ТекстОшибки = 
				СтрШаблон("Произошла ошибка при записи элемента Сборочное задание WildBerries: %1", ИнформацияОбОшибке);
			ИС_MP_Сервер.ЗаписатьВЖРИСообщитьПользователю(Событие, ТекстОшибки);
		КонецПопытки;
		
	КонецЕсли;	
	
	Если ДатаОкончания = Неопределено Тогда
		ОбщегоНазначения.СообщитьПользователю(Текст); 
	КонецЕсли;
			
КонецПроцедуры //- ИнфоСофт Ивонин К.А. 23.01.23 УА #53535

//+ ИнфоСофт Ивонин К.А. 23.01.23 УА #53535
Функция СоздатьИлиОбновитьСборочноеЗадание(Профиль, Данные, ДатаПоследнегоЗадания)

    Событие = "СоздатьИлиОбновитьСборочноеЗадание";
	
	СборочноеЗадание = Документы.ИС_WB_СборочноеЗадание.НайтиПоНомеру(Данные.id);
	
	Если СборочноеЗадание.Пустая() Тогда
		СборочноеЗадание = Документы.ИС_WB_СборочноеЗадание.СоздатьДокумент();
		СборочноеЗадание.ДатаЗагрузки = ТекущаяДатаСеанса();
	Иначе
		СборочноеЗадание = СборочноеЗадание.ПолучитьОбъект();
	КонецЕсли;
		
	ЗаполнитьЗначенияСвойств(СборочноеЗадание, Данные);
	
	Если Данные.Свойство("address") И ТипЗнч(Данные.address) = Тип("Структура") Тогда
		ЗаполнитьЗначенияСвойств(СборочноеЗадание, Данные.address);	
	КонецЕсли; 
	
	Если Данные.Свойство("deliveryType") Тогда
		СборочноеЗадание.ТипДоставки = ИС_ВБ_Сервер.ОпределитьТипДоставкиСборочногоЗадания(Данные.deliveryType);
	КонецЕсли; 
	
	Если Данные.Свойство("cargoType") Тогда
		СборочноеЗадание.ТипТовара = ИС_ВБ_Сервер.ЗначениеПеречисленияТипаТовара(Данные.cargoType);
	КонецЕсли;
	
	СборочноеЗадание.Профиль = Профиль;
	СборочноеЗадание.Номер = Данные.id;
	СборочноеЗадание.Дата = ИС_MP_РаботаСHTTPЗапросамиСервер.ПрочитатьДатуИзJSON(Данные.createdAt, ФорматДатыJSON.ISO);			
	СборочноеЗадание.Склад = Справочники.ИС_ВБ_Склады.НайтиПоКоду(Данные.warehouseId);	
	СборочноеЗадание.НоменклатураWB = Справочники.ИС_WB_Номенклатура.НайтиПоКоду(Данные.nmId);
	СборочноеЗадание.РазмерWB = Справочники.ИС_WB_РазмерыНоменклатур.НайтиПоКоду(Данные.chrtId); 
		
	// TO DO Работа с карточкой
	
	КоличествоКопеекВРубле = 100;	
	
	//+ ИнфоСофт Сумин Д.В. 26.04.2024 УА #70825
	ВалютаУчета = Константы.ВалютаУправленческогоУчета.Получить(); 
	
	СборочноеЗадание.price = СборочноеЗадание.price / КоличествоКопеекВРубле;
	СборочноеЗадание.convertedPrice = СборочноеЗадание.convertedPrice / КоличествоКопеекВРубле;
	
	//+ ИнфоСофт Ивонин К.А. 25.06.24 УА #78411
	КодВалюты = Формат(Данные.ConvertedCurrencyCode, "ЧЦ=3; ЧВН=");	
	СборочноеЗадание.Валюта = Справочники.Валюты.НайтиПоКоду(КодВалюты);
	КодВалюты = Формат(Данные.CurrencyCode, "ЧЦ=3; ЧВН=");
	СборочноеЗадание.ВалютаПродажи = Справочники.Валюты.НайтиПоКоду(КодВалюты);
	//- ИнфоСофт Ивонин К.А. 25.06.24 УА #78411
	
	Если ВалютаУчета <> СборочноеЗадание.ВалютаПродажи Тогда	
		Если Не ЗначениеЗаполнено(СборочноеЗадание.ВалютаПродажи) Тогда
			Текст = СтрШаблон("Требуется обновить классификатор валют. Валюта продажи с кодом не найдена %1. Сборочное задание номер: %2", Данные.CurrencyCode, СборочноеЗадание.Номер);
			ИС_MP_Сервер.ЗаписатьВЖРИСообщитьПользователю(Событие, Текст);	
			СборочноеЗадание.ЦенаВВалютеУчета = СборочноеЗадание.convertedPrice;
		ИначеЕсли ВалютаУчета <> СборочноеЗадание.Валюта Тогда
			СборочноеЗадание.ЦенаВВалютеУчета = РаботаСКурсамиВалют.ПересчитатьВВалюту(СборочноеЗадание.price, СборочноеЗадание.ВалютаПродажи, СборочноеЗадание.Валюта, СборочноеЗадание.Дата);	
			Текст = СтрШаблон("Валюта управленческого учета отличается от валюты продавца. Сборочное задание: %1", СборочноеЗадание.Номер);
			ИС_MP_Сервер.ЗаписатьВЖРИСообщитьПользователю(Событие, Текст);
		Иначе
			СборочноеЗадание.ЦенаВВалютеУчета = РаботаСКурсамиВалют.ПересчитатьВВалюту(СборочноеЗадание.price, СборочноеЗадание.ВалютаПродажи, ВалютаУчета, СборочноеЗадание.Дата); 	
		КонецЕсли;		
	Иначе
		СборочноеЗадание.ЦенаВВалютеУчета = СборочноеЗадание.price;	
	КонецЕсли;	
	
	//СборочноеЗадание.price = СборочноеЗадание.price / КоличествоКопеекВРубле;
	//СборочноеЗадание.convertedPrice = СборочноеЗадание.convertedPrice / КоличествоКопеекВРубле;
	//
	//СборочноеЗадание.Валюта = Справочники.Валюты.НайтиПоКоду(Данные.currencyCode);
	//СборочноеЗадание.ВалютаПродажи = Справочники.Валюты.НайтиПоКоду(Данные.convertedCurrencyCode);
	//- ИнфоСофт Сумин Д.В. 26.04.2024 УА #70825
	
	СборочноеЗадание.skus.Очистить();
	
	Если Данные.skus <> Неопределено Тогда
		
		Для Каждого Элемент Из Данные.skus Цикл	
			НоваяСтрока = СборочноеЗадание.skus.Добавить();
			НоваяСтрока.Штрихкод = Элемент;	
		КонецЦикла;
	
	КонецЕсли;
	
	//СборочноеЗадание.prioritySc.Очистить(); 
	//
	//Если Данные.prioritySc <> Неопределено Тогда
	//	
	//	Для Каждого Элемент Из Данные.prioritySc Цикл	
	//		НоваяСтрока = СборочноеЗадание.prioritySc.Добавить();
	//		НоваяСтрока.Имя = Элемент;	
	//	КонецЦикла;
	//
	//КонецЕсли;
	
	СборочноеЗадание.offices.Очистить();
	
	Если Данные.offices <> Неопределено Тогда
		
		Для Каждого Элемент Из Данные.offices Цикл	
			НоваяСтрока = СборочноеЗадание.offices.Добавить();
			НоваяСтрока.Имя = Элемент;	
		КонецЦикла;
	
	КонецЕсли;
	
	Попытка	
		СборочноеЗадание.Записать(РежимЗаписиДокумента.Запись);
		ДатаПоследнегоЗадания = СборочноеЗадание.Дата;
		
		Если Данные.Свойство("supplyId") И ЗначениеЗаполнено(Данные.supplyId) Тогда
	         
			Поставка = ИС_ВБ_Сервер.НайтиИлиСоздатьПоставку(Профиль, Данные.supplyId);
			Если Не Поставка.Пустая() Тогда
				ИС_ВБ_Сервер.ЗаписатьПоставкуСборочногоЗадания(Профиль, СборочноеЗадание.Ссылка, Поставка);
			КонецЕсли; 
				
		КонецЕсли;
			
		Возврат СборочноеЗадание.Ссылка;		
	
	Исключение
		ИнформацияОбОшибке = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
		Текст = СтрШаблон("Произошла ошибка при записи элемента Сборочное задание WildBerries: %1",	ИнформацияОбОшибке);
		ИС_MP_Сервер.ЗаписатьВЖРИСообщитьПользователю(Событие, Текст);
	КонецПопытки;
	
	Возврат Документы.ИС_WB_СборочноеЗадание.ПустаяСсылка();

КонецФункции //- ИнфоСофт Ивонин К.А. 23.01.23 УА #53535

//+ ИнфоСофт Ивонин К.А. 24.01.23 УА #53535
Процедура ОбновитьСтатусыСборочныхЗаданий(Профиль, МассивЗаданий = Неопределено, _30Дней = 2592000) Экспорт
	
	Событие = ПолучитьИмяСобытия("ОбновитьСтатусыСборочныхЗаданий");
		
	Запрос = Новый Запрос;
	
	ТипДоставки = Новый Массив;
	ТипДоставки.Добавить(Перечисления.ИС_ВБ_ТипыДоставки.FBS);
	ТипДоставки.Добавить(Перечисления.ИС_ВБ_ТипыДоставки.DBW);
	
	ТекстЗапроса = 
	"ВЫБРАТЬ
	|	ИС_WB_СборочноеЗадание.Ссылка КАК Ссылка,
	|	ИС_WB_СборочноеЗадание.Номер КАК Номер,
	|	ИС_WB_СтатусыИЭтикеткиСборочныхЗаданий.Статус КАК Статус,
	|	ИС_WB_СтатусыИЭтикеткиСборочныхЗаданий.СтатусWB КАК СтатусWB
	|ИЗ
	|	Документ.ИС_WB_СборочноеЗадание КАК ИС_WB_СборочноеЗадание
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ИС_WB_СтатусыИЭтикеткиСборочныхЗаданий КАК ИС_WB_СтатусыИЭтикеткиСборочныхЗаданий
	|		ПО ИС_WB_СборочноеЗадание.Ссылка = ИС_WB_СтатусыИЭтикеткиСборочныхЗаданий.СборочноеЗадание
	|ГДЕ
	|	ИС_WB_СборочноеЗадание.Профиль = &Профиль
	|	И ИС_WB_СборочноеЗадание.ТипДоставки В(&ТипДоставки)
	|	И (ИС_WB_СтатусыИЭтикеткиСборочныхЗаданий.СтатусWB ЕСТЬ NULL
	|			ИЛИ ИС_WB_СтатусыИЭтикеткиСборочныхЗаданий.СтатусWB = ЗНАЧЕНИЕ(Перечисление.ИС_WB_СтатусыСборочныхЗаданийВСистемеWildBerries.waiting)
	|			ИЛИ ИС_WB_СтатусыИЭтикеткиСборочныхЗаданий.СтатусWB = ЗНАЧЕНИЕ(Перечисление.ИС_WB_СтатусыСборочныхЗаданийВСистемеWildBerries.sorted)
	//+ ИнфоСофт Стояк Ю.К. 31.03.2025 УА #96862	
	|			ИЛИ ИС_WB_СтатусыИЭтикеткиСборочныхЗаданий.СтатусWB = ЗНАЧЕНИЕ(Перечисление.ИС_WB_СтатусыСборочныхЗаданийВСистемеWildBerries.ready_for_pickup)
	|			ИЛИ ИС_WB_СтатусыИЭтикеткиСборочныхЗаданий.СтатусWB = ЗНАЧЕНИЕ(Перечисление.ИС_WB_СтатусыСборочныхЗаданийВСистемеWildBerries.postponed_delivery)
	//- ИнфоСофт Стояк Ю.К. 31.03.2025 УА #96862
	|			ИЛИ ИС_WB_СтатусыИЭтикеткиСборочныхЗаданий.СтатусWB = ЗНАЧЕНИЕ(Перечисление.ИС_WB_СтатусыСборочныхЗаданийВСистемеWildBerries.ПустаяСсылка)
	|			ИЛИ ИС_WB_СтатусыИЭтикеткиСборочныхЗаданий.Статус = ЗНАЧЕНИЕ(Перечисление.ИС_WB_СтатусыСборочныхЗаданий.ПустаяСсылка))
	|	И %1";
	
	Запрос.УстановитьПараметр("Профиль", Профиль);
	Запрос.УстановитьПараметр("ТипДоставки", ТипДоставки);
		
	Если МассивЗаданий = Неопределено Тогда
		//+ ИнфоСофт Стояк Ю.К. 08.04.2024 УА #68800		
		//_30Дней = 2592000;                          
		//- ИнфоСофт Стояк Ю.К. 08.04.2024 УА #68800
		ТекстЗапроса = СтрШаблон(ТекстЗапроса, "ИС_WB_СборочноеЗадание.Дата >= &Дата");
		Запрос.УстановитьПараметр("Дата", ТекущаяДатаСеанса() - _30Дней);
	Иначе
		ТекстЗапроса = СтрШаблон(ТекстЗапроса, "ИС_WB_СборочноеЗадание.Ссылка В (&МассивСсылок)");
		Запрос.УстановитьПараметр("МассивСсылок", МассивЗаданий);
	КонецЕсли;
    
    Запрос.Текст = ТекстЗапроса;
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Выборка = РезультатЗапроса.Выбрать();
	
	МассивДляЗапроса = Новый Массив;
	
	Пока Выборка.Следующий() Цикл
		МассивДляЗапроса.Добавить(Выборка.Номер);
	КонецЦикла;
	
	Если МассивДляЗапроса.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	РазбитыйМассив = ИС_MP_Сервер.РазбитьМассивПоNЭлементов(МассивДляЗапроса, 1000);
	
	Для Каждого ЭлементМассив Из РазбитыйМассив Цикл 
		
		ИнформацияОСтатусах = ПолучитьИнформациюПоСтатусамСборочныхЗаданий(Профиль, ЭлементМассив);
		
		Если ИнформацияОСтатусах <> Неопределено Тогда
			
			Выборка.Сбросить();
			
			Пока Выборка.Следующий() Цикл
				
				Для Итер = 0 по ИнформацияОСтатусах.ВГраница() Цикл
				
					Элемент = ИнформацияОСтатусах[Итер];
					
					Если Элемент.id = Выборка.Номер Тогда
						
						Статус = ПолучитьСтатусСборочногоЗадания(Элемент.supplierStatus);
						СтатусWB = ПолучитьСтатусВСистемеWildBerries(Элемент.wbStatus); 
						Если Статус <> Выборка.Статус Или СтатусWB <> Выборка.СтатусWB Тогда	
							ЗаписатьСтатусыСборочногоЗадания(Профиль, Выборка.Ссылка, Статус, СтатусWB);		
						КонецЕсли;
						//+ ИнфоСофт Заварин К.В. 1.04.24 УА #67778
						Если СтатусWB = Перечисления.ИС_WB_СтатусыСборочныхЗаданийВСистемеWildBerries.canceled
								Или СтатусWB = Перечисления.ИС_WB_СтатусыСборочныхЗаданийВСистемеWildBerries.declined_by_client
								//+ ИнфоСофт Власова И.С. 14.03.25 УА #84167
								//Или СтатусWB = Перечисления.ИС_WB_СтатусыСборочныхЗаданийВСистемеWildBerries.defect Тогда
								Тогда
								//- ИнфоСофт Власова И.С. 14.03.25 УА #84167
							ОтменитьЗаказ(Выборка.Ссылка, Профиль);
						КонецЕсли;
						//- ИнфоСофт Заварин К.В. 01.04.24 УА #67778
						ИнформацияОСтатусах.Удалить(Итер);						
						Прервать;
						
					КонецЕсли;
					
				КонецЦикла; 
				
			КонецЦикла
			
		КонецЕсли; 
		
	КонецЦикла;
	
	ПолучитьЭтикеткиСборочныхЗаданий(Профиль, МассивЗаданий);
	
	Если МассивЗаданий = Неопределено Тогда
		ИС_ВБ_Сервер.ОбновитьИнформациюОПоставках(Профиль);
	КонецЕсли;
			
КонецПроцедуры //- ИнфоСофт Ивонин К.А. 24.01.23 УА #53535

//+ ИнфоСофт Ивонин К.А. 24.01.23 УА #53535
Процедура ПолучитьЭтикеткиСборочныхЗаданий(Профиль, МассивЗаданий = Неопределено) Экспорт
	
	Событие = ПолучитьИмяСобытия("ПолучитьЭтикеткиСборочныхЗаданий");
	
	ТипыДоставки = Новый Массив;
	ТипыДоставки.Добавить(Перечисления.ИС_ВБ_ТипыДоставки.FBS);
	ТипыДоставки.Добавить(Перечисления.ИС_ВБ_ТипыДоставки.DBW);
	ТипыДоставки.Добавить(Перечисления.ИС_ВБ_ТипыДоставки.DBS);
	ТипыДоставки.Добавить(Перечисления.ИС_ВБ_ТипыДоставки.EDBS);
	
	Запрос = Новый Запрос;
	
	ТекстЗапроса = 
	"ВЫБРАТЬ
	|	ИС_WB_СборочноеЗадание.Ссылка КАК Ссылка,
	|	ИС_WB_СборочноеЗадание.Номер КАК Номер,
	|	ИС_WB_СборочноеЗадание.Дата КАК Дата,
	//+ ИнфоСофт Мурсалимов Д.Р. 31.10.23 УА #62063
	|	ИС_WB_СборочноеЗадание.Заказ КАК Заказ
	//- ИнфоСофт Мурсалимов Д.Р. 31.10.23 УА #62063
	|ИЗ
	|	Документ.ИС_WB_СборочноеЗадание КАК ИС_WB_СборочноеЗадание
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ИС_WB_СтатусыИЭтикеткиСборочныхЗаданий КАК ИС_WB_СтатусыИЭтикеткиСборочныхЗаданий
	|		ПО (ИС_WB_СтатусыИЭтикеткиСборочныхЗаданий.СборочноеЗадание = ИС_WB_СборочноеЗадание.Ссылка)
	|ГДЕ
	|	ИС_WB_СборочноеЗадание.ТипДоставки В(&ТипДоставки)
	|	И %1
	|	И ИС_WB_СборочноеЗадание.Профиль = &Профиль
	|	И (ИС_WB_СтатусыИЭтикеткиСборочныхЗаданий.partA ЕСТЬ NULL
	|			ИЛИ ИС_WB_СтатусыИЭтикеткиСборочныхЗаданий.partA = """")";
	//+ ИнфоСофт Заварин К.В. 24.05.24 УА #69946
	//|	И НЕ ИС_WB_СтатусыИЭтикеткиСборочныхЗаданий.Статус = ЗНАЧЕНИЕ(Перечисление.ИС_WB_СтатусыСборочныхЗаданий.new)";
	//- ИнфоСофт Заварин К.В. 24.05.24 УА #69946	
	
	Запрос.УстановитьПараметр("Профиль", Профиль);
	Запрос.УстановитьПараметр("ТипДоставки", ТипыДоставки);
	
	Если МассивЗаданий = Неопределено Тогда
		_30Дней = 2592000;
		ТекстЗапроса = СтрШаблон(ТекстЗапроса, "ИС_WB_СборочноеЗадание.Дата >= &Дата");
		Запрос.УстановитьПараметр("Дата", ТекущаяДатаСеанса() - _30Дней);
	Иначе
		ТекстЗапроса = СтрШаблон(ТекстЗапроса, "ИС_WB_СборочноеЗадание.Ссылка В (&МассивСсылок)");
		Запрос.УстановитьПараметр("МассивСсылок", МассивЗаданий);
	КонецЕсли;
	
	Запрос.Текст = ТекстЗапроса;
		
	РезультатЗапроса = Запрос.Выполнить();
	
	Выборка = РезультатЗапроса.Выбрать();
	
	МассивДляЗапроса = Новый Массив;
	
	Пока Выборка.Следующий() Цикл
		МассивДляЗапроса.Добавить(Выборка.Номер);
	КонецЦикла;
	
	Если МассивДляЗапроса.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	РазбитыйМассив = ИС_MP_Сервер.РазбитьМассивПоNЭлементов(МассивДляЗапроса, 100);
	
	Для Каждого ЭлементМассив Из РазбитыйМассив Цикл 
		
		ИнформацияПоЭтикеткам = ПолучитьИнформациюПоЭтикеткамСборочныхЗаданий(Профиль, ЭлементМассив);
		
		Если ИнформацияПоЭтикеткам <> Неопределено Тогда
			
			Выборка.Сбросить();
			
			Пока Выборка.Следующий() Цикл
				
				Для Итер = 0 По ИнформацияПоЭтикеткам.ВГраница() Цикл
					
					Элемент = ИнформацияПоЭтикеткам[Итер];
					Если Элемент.orderId = Выборка.Номер Тогда
							
						ЗаписатьЭтикеткуСборочногоЗадания(Профиль, Выборка.Ссылка, Элемент);			
						ИнформацияПоЭтикеткам.Удалить(Итер);
						
						//+ ИнфоСофт Мурсалимов Д.Р. 12.03.25 УА #95433
						Если ЗначениеЗаполнено(Выборка.Заказ) Тогда
							
							НомерЭтикетки = ИС_WB_Сервер.ПолучитьНомерЭтикеткиДляСборочногоЗадания(Выборка.Ссылка);							
							
							Заказ = Выборка.Заказ.ПолучитьОбъект();	
							
							Если СтрНайти(Заказ.Комментарий, НомерЭтикетки) = 0 Тогда
								Заказ.Комментарий = Заказ.Комментарий + НомерЭтикетки + ";";
							КонецЕсли;
							
							Попытка	
								Заказ.Записать();	
							Исключение	
								Текст = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
					        	ИС_MP_Сервер.ЗаписатьВЖРИСообщитьПользователю(Событие, Текст);	
							КонецПопытки;
							
							//+ ИнфоСофт Заварин К.В. 17.02.25 УА #83515
							МассивРеализаций = ИС_MP_РаботаСЗаказами.ПолучитьРеализацииПоЗаказуМП(Профиль,Перечисления.ИС_МП_Маркетплейсы.ВБ, Выборка.Ссылка);
							
							Для	Каждого Реализация Из МассивРеализаций Цикл 
								
								Реализация = Реализация.ПолучитьОбъект();
								
								Реализация.Комментарий = Заказ.Комментарий;	
								
								Попытка	
									Реализация.Записать();	
								Исключение	
									Текст = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
									ИС_MP_Сервер.ЗаписатьВЖРИСообщитьПользователю(Событие, Текст);	
								КонецПопытки;
								
							КонецЦикла;
							//- ИнфоСофт Заварин К.В. 17.02.25 УА #83515
							
						КонецЕсли;
						//- ИнфоСофт Мурсалимов Д.Р. 12.03.25 УА #95433
						
						Прервать;
						
					КонецЕсли;
					
				КонецЦикла; 
				
			КонецЦикла
			
		КонецЕсли; 
		
	КонецЦикла;
	
