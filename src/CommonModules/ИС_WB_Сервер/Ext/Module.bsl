Функция ПолучитьИнформациюОСкидках(Профиль, quantity) Экспорт
	
	ТаблицаТекущихЦен = ПолучитьЦеныFBS(Профиль);	
	
	Если ТаблицаТекущихЦен = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;	
				
	ТаблицаЦен = Новый ТаблицаЗначений;

	ТаблицаЦен.Колонки.Добавить("nmId", 	Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(15, 0, ДопустимыйЗнак.Неотрицательный)));
	ТаблицаЦен.Колонки.Добавить("Цена", 	Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(13, 0, ДопустимыйЗнак.Неотрицательный)));
	ТаблицаЦен.Колонки.Добавить("Скидка", 	Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(3, 0, ДопустимыйЗнак.Неотрицательный)));
	
	Для Каждого Строка Из ТаблицаТекущихЦен Цикл 
		
		НоваяСтрока = ТаблицаЦен.Добавить();
		НоваяСтрока.nmId 	= Строка.nmId;
		НоваяСтрока.Цена 	= Строка.Цена;
		НоваяСтрока.Скидка 	= Строка.Скидка;	
		
	КонецЦикла;
	
	Возврат ТаблицаЦен; 	         
			
