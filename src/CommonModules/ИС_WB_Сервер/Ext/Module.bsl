	//РезультатПроверки = ПроверитьИЗаполнитьПараметрыЗапросаДляСервисаAPI(ПараметрыЗапроса, НастройкиСоединения);
	//
	//Если Не РезультатПроверки Тогда
	//	Возврат Неопределено;
	//КонецЕсли;
	
	ПараметрыЗапроса = ИС_ВБ_Сервер.ПараметрыHTTPЗапроса(Профиль, "Контент");
	//- ИнфоСофт Ивонин К.А. 20.01.25 УА #89159
			
	Если Справочник = "tnved" Тогда
		
		СписокЗначенийХарактеристики = ИС_WB_API.ПолучитьЗначенияХарактеристики(
			Профиль, ПараметрыЗапроса, Справочник, Параметр1, Параметр2);

	Иначе
		СписокЗначенийХарактеристики = ИС_WB_API.ПолучитьЗначенияХарактеристики(
			Профиль, ПараметрыЗапроса, Справочник);
	КонецЕсли;
		
	Если СписокЗначенийХарактеристики = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Результат = Новый СписокЗначений;
	
	Если Справочник = "tnved" Тогда  
			
		Для Каждого Элемент Из СписокЗначенийХарактеристики Цикл
			Результат.Добавить(Элемент.tnved);
		КонецЦикла;
	
	ИначеЕсли Справочник = "colors" Или Справочник = "countries" Тогда
		
		Для Каждого Элемент Из СписокЗначенийХарактеристики Цикл
			Результат.Добавить(Элемент.name);
		КонецЦикла;
		
	Иначе

		Для Каждого Элемент Из СписокЗначенийХарактеристики Цикл
			Результат.Добавить(Элемент);
		КонецЦикла;	

	КонецЕсли;
					
	Возврат Результат;

