Функция ЗагрузитьИзображениеНаWB(Профиль, ДанныеФайла, ДоичныеДанные, NMid) Экспорт

	//+ ИнфоСофт Ивонин К.А. 20.01.25 УА #89159
	//НастройкиСоединения = ПолучитьНастройкиСоединенияПрофиля(Профиль);
	//ПараметрыЗапроса = ПроверитьИЗаполнитьПараметрыЗапроса(НастройкиСоединения);
	//ПараметрыЗапроса.Сервер = "content-api.wildberries.ru";
	ПараметрыЗапроса = ИС_ВБ_Сервер.ПараметрыHTTPЗапроса(Профиль, "Контент");
	//- ИнфоСофт Ивонин К.А. 20.01.25 УА #89159

	ПолеФормы = Новый Структура;
	ПолеФормы.Вставить("ИмяПоля",  "uploadfile");
	ПолеФормы.Вставить("ИмяФайла", ДанныеФайла.ИмяФайла);
	ПолеФормы.Вставить("Тип",      "image/" + ДанныеФайла.Расширение);
	ПолеФормы.Вставить("Тело",     ДоичныеДанные);
	
	ПоляФормы = Новый Массив;
	ПоляФормы.Добавить(ПолеФормы);
	
	ДанныеПреобразования = ИС_МП_РаботаСHTTPЗапросами.ДвоичныеДанныеPOSTЗапросаКакФорма(ПоляФормы);
	ТелоЗапроса = ДанныеПреобразования.ДвоичныеДанные;
	Размер      = ДанныеПреобразования.Размер;
	
	ПараметрыЗапроса.Заголовки.Вставить("Content-Type",   "multipart/form-data; boundary=" + ДанныеПреобразования.Разделитель);
	ПараметрыЗапроса.Заголовки.Вставить("Content-Lenght", Формат(Размер, "ЧН=0; ЧГ=0;"));
	ПараметрыЗапроса.Заголовки.Вставить("X-Nm-Id", Формат(NMid, "ЧН=0; ЧГ=0;"));	
	ПараметрыЗапроса.Заголовки.Вставить("X-Photo-Number", 1);
	
	Результат = ИС_WB_API.ДобавитьМедиафайлы(Профиль, ПараметрыЗапроса, ТелоЗапроса);
	
	Возврат Результат;

