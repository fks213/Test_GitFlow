//+ ИнфоСофт Сумин Д.В. 27.02.2024 УА #71107
Функция СоздатьИлиОбновитьНомерациюОтчета(СтруктураДанных)
	
	ЭлементСправочника = Справочники.ИС_WB_НомерацияОтчетовОПродажах.НайтиПоРеквизиту("НомерОтчета", СтруктураДанных.ДанныеОтчета.НомерОтчета);
	
	Если Не ЗначениеЗаполнено(ЭлементСправочника) Тогда
		ЭлементСправочника = Справочники.ИС_WB_НомерацияОтчетовОПродажах.СоздатьЭлемент();
	Иначе
		ЭлементСправочника = ЭлементСправочника.ПолучитьОбъект();	
	КонецЕсли;
	
	ЭлементСправочника.Профиль		  = СтруктураДанных.Профиль;
	ЭлементСправочника.Наименование   = СтруктураДанных.ДанныеОтчета.Комментарий;
	ЭлементСправочника.НомерОтчета    = СтруктураДанных.ДанныеОтчета.НомерОтчета;
	ЭлементСправочника.ДатаНачала     = СтруктураДанных.ДанныеОтчета.НачалоПериода;
	ЭлементСправочника.ДатаОкончания  = СтруктураДанных.ДанныеОтчета.КонецПериода; 
	
	Если СтруктураДанных.ДанныеОтчета.РоссийскиеПродажи Тогда
		ВидОтчета = Перечисления.ИС_WB_ВидыОтчетов.Российский;	
	Иначе
		ВидОтчета = Перечисления.ИС_WB_ВидыОтчетов.Иностранный;	
	КонецЕсли;	
	
	ЭлементСправочника.ВидОтчета = ВидОтчета;
	
	//Заполнение данных по услугам	
	Если СтруктураДанных.ДанныеУслуг <> Неопределено Тогда
		//+ ИнфоСофт Сумин Д.В. 27.02.2024 УА #73531	
		ЭлементСправочника.ДополнительнаяИнформация.Очистить(); 
		//- ИнфоСофт Сумин Д.В. 27.02.2024 УА #73531
		Для Каждого Элемент Из СтруктураДанных.ДанныеУслуг Цикл
			
			НоваяСтрока = ЭлементСправочника.ДополнительнаяИнформация.Добавить();
			
			Если Элемент.Свойство("Наименование") Тогда
				
				//+ ИнфоСофт Мурсалимов Д.Р. 27.05.24 УА #76549
				Услуга = Справочники.ИС_WB_НаименованиеУслугИзОтчетаWildberries.НайтиПоНаименованию(Элемент.Наименование);
	
				Если Услуга.Пустая() Тогда
					Услуга = Справочники.ИС_WB_НаименованиеУслугИзОтчетаWildberries.СоздатьЭлемент();
				Иначе
					Услуга = Услуга.ПолучитьОбъект();
				КонецЕсли;
				
				НоваяСтрока.Услуга = Услуга;
				//- ИнфоСофт Мурсалимов Д.Р. 27.05.24 УА #76549
						
			КонецЕсли;
			
			Если Элемент.Свойство("Сумма") Тогда
				НоваяСтрока.Сумма = Элемент.Сумма;		
			КонецЕсли;
			
			Если Элемент.Свойство("ТипДокумента") Тогда
				НоваяСтрока.ТипДокумента = Элемент.ТипДокумента;		
			КонецЕсли;
			
			Если Элемент.Свойство("ОбоснованиеДляОплаты") Тогда
				НоваяСтрока.ОбоснованиеДляОплаты = Элемент.ОбоснованиеДляОплаты;		
			КонецЕсли;
			
		КонецЦикла;	
	КонецЕсли;
	
	ЭлементСправочника.Записать(); 
	
	Возврат ЭлементСправочника.Ссылка;
	
КонецФункции //- ИнфоСофт Сумин Д.В. 27.02.2024 УА #71107 

//+ ИнфоСофт Сумин Д.В. 27.02.2024 УА #71107
Функция ОбработатьДанныеОПродажах(ДанныеПродаж) Экспорт
		
	НомерОтчета = СоздатьИлиОбновитьНомерациюОтчета(ДанныеПродаж.СтруктураДанных); 
	
	ПроверитьИлиСоздатьПараметрыОтчетов(ДанныеПродаж.СтруктураДанных.Детализация);
	
	СтруктураДанных = Новый Структура;	
	СтруктураДанных.Вставить("Детализация", ДанныеПродаж.СтруктураДанных.Детализация);
	СтруктураДанных.Вставить("НомерОтчета", НомерОтчета);
	СтруктураДанных.Вставить("Профиль", ДанныеПродаж.СтруктураДанных.Профиль);
	
	Возврат ЗаписатьДанныеПродаж(СтруктураДанных);
	
КонецФункции //- ИнфоСофт Сумин Д.В. 27.02.2024 УА #71107	

//+ ИнфоСофт Сумин Д.В. 27.02.2024 УА #71107
Процедура ПроверитьИлиСоздатьПараметрыОтчетов(Детализация)
	
	НаименованиеКолонок = Новый ТаблицаЗначений; 
	НаименованиеКолонок.Колонки.Добавить("ИмяКолонки", Новый ОписаниеТипов("Строка",,,,Новый КвалификаторыСтроки(50)));
	
	Для Каждого Элемент Из Детализация.Колонки Цикл 
		НоваяСтрока = НаименованиеКолонок.Добавить();
		НоваяСтрока.ИмяКолонки = Элемент.Имя;	
	КонецЦикла;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	НаименованиеКолонок.ИмяКолонки КАК ИмяКолонки
	|ПОМЕСТИТЬ ВТ_НаименованияКолонок
	|ИЗ
	|	&НаименованиеКолонок КАК НаименованиеКолонок
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_НаименованияКолонок.ИмяКолонки КАК ИмяКолонки,
	|	ЕСТЬNULL(ИС_WB_ПараметрыОтчетовОПродажах.Наименование, 0) КАК ЕстьВБазе
	|ПОМЕСТИТЬ ВТ_Результирующая
	|ИЗ
	|	ВТ_НаименованияКолонок КАК ВТ_НаименованияКолонок
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ИС_WB_ПараметрыОтчетовОПродажах КАК ИС_WB_ПараметрыОтчетовОПродажах
	|		ПО ВТ_НаименованияКолонок.ИмяКолонки = ИС_WB_ПараметрыОтчетовОПродажах.Наименование
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_Результирующая.ИмяКолонки КАК ИмяКолонки
	|ИЗ
	|	ВТ_Результирующая КАК ВТ_Результирующая
	|ГДЕ
	|	ВТ_Результирующая.ЕстьВБазе = 0";
	
	Запрос.УстановитьПараметр("НаименованиеКолонок", НаименованиеКолонок);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Если РезультатЗапроса.Пустой() Тогда
		Возврат;	
	КонецЕсли;	
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		СоздатьПараметрОтчетаОПродажах(ВыборкаДетальныеЗаписи.ИмяКолонки);	
	КонецЦикла;
		
КонецПроцедуры //- ИнфоСофт Сумин Д.В. 27.02.2024 УА #71107

//+ ИнфоСофт Сумин Д.В. 27.02.2024 УА #71107
Процедура СоздатьПараметрОтчетаОПродажах(ИмяКолонки)
	ЭлементСправочника = Справочники.ИС_WB_ПараметрыОтчетовОПродажах.СоздатьЭлемент();
	ЭлементСправочника.Наименование = ИмяКолонки;
