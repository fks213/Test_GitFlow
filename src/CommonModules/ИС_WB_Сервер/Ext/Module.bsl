					ПрофильОбъект.ПоставкаСГТ = Поставка;
					
					Попытка
						ПрофильОбъект.Записать();
					Исключение
						ИС_MP_Сервер.ЗаписатьВЖРИСообщитьПользователю(Событие, ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));	
					КонецПопытки;
					
				КонецЕсли;
				
			Иначе
				
				Если Профиль.ПоставкаСГТ <> Справочники.ИС_ВБ_ПоставкиFBS.ПустаяСсылка() Тогда
					
					Выборка = РезультатЗапроса.Выбрать();
					
					МассивСсылок = Новый Массив;
					
					Пока Выборка.Следующий() Цикл
						МассивСсылок.Добавить(Выборка.Ссылка);
					КонецЦикла;
					
					ИС_ВБ_Сервер.ДобавитьСборочныеЗаданияВПоставку(Профиль, Профиль.ПоставкаСГТ, МассивСсылок);
					
				Иначе  
					
					Поставка = ИС_ВБ_Сервер.СоздатьНовуюПоставку(Профиль, СтрШаблон("СГТ от %1", Формат(ТекущаяДатаСеанса(), "ДФ=dd.MM.yy")));	
					
					Если Поставка <> Неопределено Тогда
						
						Выборка = РезультатЗапроса.Выбрать();
						
						МассивСсылок = Новый Массив;
						
						Пока Выборка.Следующий() Цикл
							МассивСсылок.Добавить(Выборка.Ссылка);
						КонецЦикла;
						
						ИС_ВБ_Сервер.ДобавитьСборочныеЗаданияВПоставку(Профиль, Поставка, МассивСсылок);
						
						ПрофильОбъект = Профиль.ПолучитьОбъект();
						ПрофильОбъект.ПоставкаСГТ = Поставка;
						
						Попытка
							ПрофильОбъект.Записать();
						Исключение
							ИС_MP_Сервер.ЗаписатьВЖРИСообщитьПользователю(Событие, ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));	
						КонецПопытки;
						
					КонецЕсли;
					
				КонецЕсли;
				
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЕсли;
	//- ИнфоСофт Стояк Ю.К. 24.09.2024 УА #72283
		
	ИС_ВБ_Сервер.ОбновитьИнформациюОПоставках(Профиль);	
	
КонецПроцедуры //- ИнфоСофт Ивонин К.А. 19.02.23 УА #53535

