//+ ИнфоСофт Мурсалимов Д.Р. 27.01.25 УА #67818
Функция СоздатьОтчетПлатногоХранения(Профиль, Период) Экспорт
	
	ДатаНачала 			= НачалоДня(Период.ДатаНачала);
	ДатаОкончания 		= КонецДня(Период.ДатаОкончания);
	
	//+ ИнфоСофт Ивонин К.А. 20.01.25 УА #89159	
	ПараметрыЗапроса = ИС_ВБ_Сервер.ПараметрыHTTPЗапроса(Профиль, "Аналитика");
	//- ИнфоСофт Ивонин К.А. 20.01.25 УА #89159
	
	Результат 			= ИС_WB_API.СоздатьОтчетПлатногоХранения(Профиль, ПараметрыЗапроса, ДатаНачала, ДатаОкончания);
	
	Если Результат = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Если Не Результат.Свойство("taskId") Тогда
		Возврат Неопределено;
	КонецЕсли;  
	
	Пока Истина Цикл
		
		Статус = ИС_WB_Сервер.ПроверитьСтатусОтчетаПлатногоХранения(Профиль, Результат.taskId);	
		
		Если Статус = Неопределено Тогда
			Возврат Неопределено;
		КонецЕсли;
		
		Если Статус.Свойство("status") Тогда
			
			СтатусОтчета = Статус.status;
			
			ИС_MP_Сервер.Пауза(5);
			
		КонецЕсли; 
		
		Если СтатусОтчета = "done" Тогда			
			Прервать;	
		КонецЕсли;
		
		Если СтатусОтчета = "purged" Тогда			
			Возврат Неопределено;
		КонецЕсли;
		
		Если СтатусОтчета = "canceled" Тогда			
			Возврат Неопределено;	
		КонецЕсли;
			
	КонецЦикла;
	
	Возврат Результат.taskId;

КонецФункции //- ИнфоСофт Мурсалимов Д.Р. 27.01.25 УА #67818

