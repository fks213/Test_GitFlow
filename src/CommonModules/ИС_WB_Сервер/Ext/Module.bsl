//+ ИнфоСофт Мурсалимов Д.Р. 28.02.25 УА #74987
Функция ПолучитьДанныеОК(Профиль, ДатаНачала, ДатаКонца) Экспорт
	
	Событие = ПолучитьИмяСобытия("ПолучитьДанныеОК");
	
	//+ ИнфоСофт Ивонин К.А. 20.01.25 УА #89159
	ПараметрыЗапроса = ИС_ВБ_Сервер.ПараметрыHTTPЗапроса(Профиль, "Статистика");
	//- ИнфоСофт Ивонин К.А. 20.01.25 УА #89159 
	
	rrdid = 0;
	ОтчетОПродажахПоРеализации = Новый Массив;
	
	Пока Истина Цикл

		Результат = ИС_WB_API.ПолучитьОтчетОПродажахПоРеализации(Профиль, ПараметрыЗапроса, ДатаНачала, ДатаКонца, , rrdid);	
	
		Если Результат = Неопределено Тогда
			Возврат Неопределено;
		КонецЕсли;
		
		Для Каждого Элемент Из Результат Цикл
			ОтчетОПродажахПоРеализации.Добавить(Элемент);
		КонецЦикла; 
	    
	    Если Результат.Количество() = 100000 Тогда
	    	rrdid = Результат[Результат.ВГраница()].rrd_id;
	    Иначе
	    	Прервать;		
	    КонецЕсли;
	    
	КонецЦикла; 
	
	ПоследнийНомер 	= 0;
	Российский 		= Истина;
	
	ТаблицаЗначенийРезультирующая = Новый ТаблицаЗначений;
	
	ТаблицаЗначенийРезультирующая.Колонки.Добавить("НоменклатураWB", 		Новый ОписаниеТипов("СправочникСсылка.ИС_WB_Номенклатура"));			
	ТаблицаЗначенийРезультирующая.Колонки.Добавить("РазмерWB", 				Новый ОписаниеТипов("СправочникСсылка.ИС_WB_РазмерыНоменклатур"));
	ТаблицаЗначенийРезультирующая.Колонки.Добавить("Баркод", 				Новый ОписаниеТипов("Строка", , Новый КвалификаторыСтроки(50)));
	ТаблицаЗначенийРезультирующая.Колонки.Добавить("Количество", 			Новый ОписаниеТипов("Число"));
	ТаблицаЗначенийРезультирующая.Колонки.Добавить("ЦенаРозничная", 		Новый ОписаниеТипов("Число"));
	ТаблицаЗначенийРезультирующая.Колонки.Добавить("СуммаПродажи",			Новый ОписаниеТипов("Число"));
	ТаблицаЗначенийРезультирующая.Колонки.Добавить("ЦенаПродажи", 			Новый ОписаниеТипов("Число"));
	ТаблицаЗначенийРезультирующая.Колонки.Добавить("РазмерыНоменклатурWB", 	Новый ОписаниеТипов("СправочникСсылка.ИС_WB_РазмерыНоменклатур"));
	ТаблицаЗначенийРезультирующая.Колонки.Добавить("Код", 					Новый ОписаниеТипов("Число"));
	ТаблицаЗначенийРезультирующая.Колонки.Добавить("Бренд", 				Новый ОписаниеТипов("Строка"));
	ТаблицаЗначенийРезультирующая.Колонки.Добавить("Название", 				Новый ОписаниеТипов("Строка"));
	ТаблицаЗначенийРезультирующая.Колонки.Добавить("Размер", 				Новый ОписаниеТипов("Строка")); 
	ТаблицаЗначенийРезультирующая.Колонки.Добавить("Штрихкод", 				Новый ОписаниеТипов("Строка"));
	ТаблицаЗначенийРезультирующая.Колонки.Добавить("Номер", 				Новый ОписаниеТипов("Число"));
	ТаблицаЗначенийРезультирующая.Колонки.Добавить("СтранаПродажи", 		Новый ОписаниеТипов("Строка"));
	ТаблицаЗначенийРезультирующая.Колонки.Добавить("Артикул", 				Новый ОписаниеТипов("Строка"));
	ТаблицаЗначенийРезультирующая.Колонки.Добавить("РазмерПоставщика", 		Новый ОписаниеТипов("Строка"));
	
	СуммаБрака = 0;
	
	Для Каждого Элемент Из ОтчетОПродажахПоРеализации Цикл
		
		Коэффициент = -1;
		
		Если Нрег(Элемент.doc_type_name) = "продажа" Тогда
			Коэффициент = 1;
		КонецЕсли;
		
		Если Элемент.report_type = 2 Тогда
			Продолжить;
		КонецЕсли;
		
		Если Нрег(Элемент.supplier_oper_name) 		= "оплата брака" 
			Или Нрег(Элемент.supplier_oper_name) 	= "частичная компенсация брака" Тогда        
			
			СуммаБрака = СуммаБрака + Число(Элемент.retail_amount) * Коэффициент;
			Продолжить;
			
		КонецЕсли;
		
		Если Нрег(Элемент.supplier_oper_name) 		= "компенсация брака" 
			Или Нрег(Элемент.supplier_oper_name) 	= "компенсация подмененного товара" 
			Или Нрег(Элемент.supplier_oper_name) 	= "компенсация потерянного товара"
			Или Нрег(Элемент.supplier_oper_name) 	= "компенсация ущерба"
			Или Нрег(Элемент.supplier_oper_name) 	= "добровольная компенсация при возврате" Тогда
			
			СуммаБрака = СуммаБрака + Число(Элемент.ppvz_for_pay) * Коэффициент;
			Продолжить;
			
		КонецЕсли;
		
		Если Элемент.quantity = 0 Тогда
			Продолжить;
		КонецЕсли; 
		
		Если Нрег(Элемент.supplier_oper_name) = "возмещение издержек по перевозке" Тогда
			Продолжить;
		КонецЕсли;
		
		Если Нрег(Элемент.supplier_oper_name) = "возмещение издержек по перевозке/по складским операциям с товаром" Тогда
			Продолжить;
		КонецЕсли;
		
		МенеджерЗаписи = РегистрыСведений.ИС_WB_ДанныеОК.СоздатьМенеджерЗаписи();
		
		Если ПоследнийНомер <> Элемент.realizationreport_id Тогда 
			ПоследнийНомер = Элемент.realizationreport_id;
		КонецЕсли;
		
		НоваяСтрока = ТаблицаЗначенийРезультирующая.Добавить();
		НоваяСтрока.Номер 				= Число(Элемент.realizationreport_id);
		НоваяСтрока.СтранаПродажи 		= Элемент.site_country;   
		
		НоваяСтрока.Код 				= Число(Элемент.nm_id);
		НоваяСтрока.Бренд 				= Элемент.brand_name;
		НоваяСтрока.Название 			= Элемент.subject_name;
		НоваяСтрока.Размер 				= Элемент.ts_name;
		НоваяСтрока.Баркод 				= Элемент.barcode;
		НоваяСтрока.Количество 			= Коэффициент * Число(Элемент.quantity);
		НоваяСтрока.ЦенаРозничная 		= Число(Элемент.retail_price); 
		НоваяСтрока.СуммаПродажи 		= Коэффициент * Число(Элемент.retail_amount);	   	
		НоваяСтрока.ЦенаПродажи 		= ?(НоваяСтрока.Количество = 0, 0, НоваяСтрока.СуммаПродажи / НоваяСтрока.Количество);
		НоваяСтрока.Штрихкод 			= Элемент.shk_id;
		НоваяСтрока.Артикул 			= Элемент.sa_name;
		НоваяСтрока.РазмерПоставщика 	= Элемент.ts_name;
		
		МенеджерЗаписи.НомерОтчета 		= НоваяСтрока.Номер;
		МенеджерЗаписи.СтранаПродажи 	= НоваяСтрока.СтранаПродажи;
		МенеджерЗаписи.КодНоменклатуры 	= НоваяСтрока.Код; 
		МенеджерЗаписи.НачалоПериода 	= ИС_MP_РаботаСHTTPЗапросамиСервер.ПрочитатьДатуИзJSON(Элемент.date_from, ФорматДатыJSON.ISO);
		МенеджерЗаписи.КонецПериода 	= ИС_MP_РаботаСHTTPЗапросамиСервер.ПрочитатьДатуИзJSON(Элемент.date_to, ФорматДатыJSON.ISO);
		МенеджерЗаписи.srId 			= Элемент.srId;
		МенеджерЗаписи.Бренд 			= НоваяСтрока.Бренд;
		МенеджерЗаписи.Название 		= НоваяСтрока.Название;
		МенеджерЗаписи.Размер 			= НоваяСтрока.Размер;
		МенеджерЗаписи.Баркод 			= НоваяСтрока.Баркод;
		МенеджерЗаписи.Количество 		= НоваяСтрока.Количество;
		МенеджерЗаписи.ЦенаРозничная 	= НоваяСтрока.ЦенаРозничная;
		МенеджерЗаписи.СуммаПродажи 	= НоваяСтрока.СуммаПродажи;
		МенеджерЗаписи.ЦенаПродажи 		= НоваяСтрока.ЦенаПродажи;
		МенеджерЗаписи.Штрихкод 		= НоваяСтрока.Штрихкод; 
		
		МенеджерЗаписи.Записать();	
		
	КонецЦикла;
		
	Результат = Новый Структура;
	
	Результат.Вставить("Таблица", 	ТаблицаЗначенийРезультирующая); 
	Результат.Вставить("НомерРФ", 	ПоследнийНомер);
	Результат.Вставить("Брак", 		СуммаБрака);
	
	Возврат Результат;	 				
	
