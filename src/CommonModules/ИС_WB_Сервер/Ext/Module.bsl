	//	Возврат Неопределено;
	//КонецЕсли;
	
	ПараметрыЗапроса = ИС_ВБ_Сервер.ПараметрыHTTPЗапроса(Профиль, "Цены");
	//- ИнфоСофт Ивонин К.А. 20.01.25 УА #89159
	
	СтруктураЗапроса = ИС_WB_API.ПолучитьСтруктуруПараметровЗапросаСпискаПредметов();
	
	ТаблицаЦенСкидок = Новый ТаблицаЗначений;
	
	ТаблицаЦенСкидок.Колонки.Добавить("nmId", Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(15, 0, ДопустимыйЗнак.Неотрицательный)));
	ТаблицаЦенСкидок.Колонки.Добавить("РазмерWB", Новый ОписаниеТипов("СправочникСсылка.ИС_WB_РазмерыНоменклатур"));                       
	ТаблицаЦенСкидок.Колонки.Добавить("Цена", Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(13, 0, ДопустимыйЗнак.Неотрицательный)));
	ТаблицаЦенСкидок.Колонки.Добавить("Скидка", Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(3, 0, ДопустимыйЗнак.Неотрицательный)));                       
	ТаблицаЦенСкидок.Колонки.Добавить("ЦенаСоСкидкой", Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(13, 0, ДопустимыйЗнак.Неотрицательный)));
	
	offset = 0;
	
	Пока Истина Цикл
		
		СтруктураЗапроса.offset = offset;
		
		ИнформацияЦеныСкидки = ИС_WB_API.ПолучитьИнформациюОЦенахИСкидках(Профиль, ПараметрыЗапроса, СтруктураЗапроса);
		
		Если ИнформацияЦеныСкидки = Неопределено Тогда
			Возврат Неопределено;
		КонецЕсли; 
		
		Если ИнформацияЦеныСкидки.error Тогда
			ОбщегоНазначения.СообщитьПользователю("Ошибка при получении списка цен и скидок: " + ИнформацияЦеныСкидки.errorText);
			Возврат Неопределено;
		КонецЕсли;
		
		Если ИнформацияЦеныСкидки.data.listGoods = Неопределено Тогда
			Прервать;
		КонецЕсли;
		
		Если ИнформацияЦеныСкидки.data.listGoods.Количество() = 0 Тогда
			Прервать;
		КонецЕсли; 		
		
		Для Каждого Элемент Из ИнформацияЦеныСкидки.data.listGoods Цикл 
			
			Для Каждого ЭлементРазмер Из Элемент.sizes Цикл
				
				НоваяСтрока = ТаблицаЦенСкидок.Добавить();
				
				НоваяСтрока.nmId 			= Элемент.nmID;
				НоваяСтрока.РазмерWB 		= Справочники.ИС_WB_РазмерыНоменклатур.НайтиПоКоду(ЭлементРазмер.sizeID);
				НоваяСтрока.Цена			= ЭлементРазмер.price;
				НоваяСтрока.Скидка			= Элемент.discount;	
				НоваяСтрока.ЦенаСоСкидкой 	= ЭлементРазмер.discountedPrice;							
				
			КонецЦикла;
			
		КонецЦикла;
		
		offset = offset + СтруктураЗапроса.limit;
		
	КонецЦикла;	
	
	Возврат ТаблицаЦенСкидок; 	
			
КонецФункции //- ИнфоСофт Мурсалимов Д.Р. 29.03.24 УА #72003

