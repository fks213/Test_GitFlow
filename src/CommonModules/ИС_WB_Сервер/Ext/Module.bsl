Функция ПолучитьПроцентНДС(НДС) Экспорт
	
	Если НДС = Перечисления.СтавкиНДС.НДС20 Тогда
		Возврат 20;
		
	ИначеЕсли НДС = Перечисления.СтавкиНДС.НДС20_120 Тогда
		Возврат 20;
		
	ИначеЕсли НДС = Перечисления.СтавкиНДС.НДС10 Тогда
		Возврат 10;
		
	ИначеЕсли НДС = Перечисления.СтавкиНДС.НДС10_110 Тогда	
		Возврат 10;
		
	ИначеЕсли НДС = Перечисления.СтавкиНДС.НДС18 Тогда
		Возврат 18;
		
	ИначеЕсли НДС = Перечисления.СтавкиНДС.НДС18_118 Тогда	
		Возврат 18;
		
	ИначеЕсли НДС = Перечисления.СтавкиНДС.НДС0 Тогда	
		Возврат 0;
		
	Иначе
		Возврат Неопределено
		
	КонецЕсли;	
		
КонецФункции //- ИнфоСофт Сумин Д.В. 09.12.2021 УА #40614  

