//+ ИнфоСофт Ивонин К.А. 29.09.22 УА #49591
Процедура ЗаполнитьКатегориюХарактеристиками(Поля, ТЧ, Перезаполнять)
	
	Событие = "ЗаполнитьКатегориюХарактеристиками";
	
	Для Каждого Элемент Из Поля Цикл
		
		Если Элемент.Свойство("name") Тогда
			ХарактеристикаКатегории = Справочники.ИС_WB_ХарактеристикиКатегорий.НайтиПоНаименованию(Элемент.name, Истина);
		Иначе
			Продолжить;
		КонецЕсли;
		
		НоваяХарактеристика = ТЧ.Добавить();
		
		Если ХарактеристикаКатегории.Пустая() Тогда		
			ХарактеристикаКатегории = Справочники.ИС_WB_ХарактеристикиКатегорий.СоздатьЭлемент();
			ХарактеристикаКатегории = ЗаполнитьСвойстваХарактеристики(ХарактеристикаКатегории, Элемент);						
		Иначе
			
			Если Перезаполнять Тогда
				ХарактеристикаКатегории = ХарактеристикаКатегории.ПолучитьОбъект();
				ХарактеристикаКатегории = ЗаполнитьСвойстваХарактеристики(ХарактеристикаКатегории, Элемент);
			КонецЕсли;
			
		КонецЕсли;
		
		НоваяХарактеристика.Поле = ХарактеристикаКатегории;
		НоваяХарактеристика.Обязательное = ХарактеристикаКатегории.required;		
		
	КонецЦикла;
	
КонецПроцедуры //- ИнфоСофт Ивонин К.А. 29.09.22 УА #49591

//+ ИнфоСофт Ивонин К.А. 10.02.23 УА #53535
Функция ЗаполнитьСвойстваХарактеристики(Характеристика, ДанныеЗаполнения)
	
	Событие = ПолучитьИмяСобытия("ЗаполнитьСвойстваХарактеристики");
	
	Результат = Справочники.ИС_WB_ХарактеристикиКатегорий.ПустаяСсылка();
	
	Характеристика.Наименование = ДанныеЗаполнения.name;
	//Характеристика.Код = ДанныеЗаполнения.charcID; Неуникальные коды у одинаковых параметров
	Характеристика.charcID = ДанныеЗаполнения.charcID;
	ЗаполнитьЗначенияСвойств(Характеристика, ДанныеЗаполнения);
	
	Если ДанныеЗаполнения.name = "Цвет" Тогда
		Характеристика.dictionary = "colors";
	ИначеЕсли ДанныеЗаполнения.name = "Пол" Тогда
		Характеристика.dictionary = "kinds";	 
	ИначеЕсли ДанныеЗаполнения.name = "Страна производства" Тогда
		Характеристика.dictionary = "countries";	
	ИначеЕсли ДанныеЗаполнения.name = "Сезон" Тогда
		Характеристика.dictionary = "seasons";	
	ИначеЕсли ДанныеЗаполнения.name = "ТНВЭД" Тогда
		Характеристика.dictionary = "tnved";
	ИначеЕсли ДанныеЗаполнения.name = "Ставка НДС" Тогда
		Характеристика.dictionary = "vat";
	КонецЕсли;  
	
	Попытка		
		Характеристика.Записать();	
		Результат = Характеристика.Ссылка;		
	Исключение		
		Текст = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
		ИС_MP_Сервер.ЗаписатьВЖРИСообщитьПользователю(Событие, Текст);				
	КонецПопытки;
	
	Возврат Результат;
	
КонецФункции //- ИнфоСофт Ивонин К.А. 10.02.23 УА #53535

//+ ИнфоСофт Ивонин К.А. 29.03.23 УА #55822
Функция ПроверитьЗаполненностьОбязательныхРеквизитов(Профиль)
	
	Событие = ПолучитьИмяСобытия("ПроверитьЗаполненностьОбязательныхРеквизитов");
	
	ФункциональныеОпции = ИС_WB_СерверПовтИсп.ПолучитьНастройкиФункциональностиСборочныхЗвданий(Профиль);

	//+ ИнфоСофт Мурсалимов Д.Р. 23.04.25 УА #99629
	АктивныйЗаказКлиента = ПолучитьАктивныйЗаказКлиента(Профиль);
	
	Если АктивныйЗаказКлиента <> Неопределено Тогда	
		ФункциональныеОпции.Вставить("АктивныйЗаказКлиента", АктивныйЗаказКлиента);	
	КонецЕсли;
	//- ИнфоСофт Мурсалимов Д.Р. 23.04.25 УА #99629
	
	Результат = Истина;
	
	Если ФункциональныеОпции.Количество() = 0 Тогда
		Результат = Ложь;
	КонецЕсли;
	
	Сообщение = "Не заполнены параметры Профиля: ";
	
	Если Не ЗначениеЗаполнено(ФункциональныеОпции.Организация) Тогда
		Сообщение = Сообщение + "Организация; ";
		Результат = Ложь;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(ФункциональныеОпции.Партнер) Тогда
		Сообщение = Сообщение + "Партнер; ";
		Результат = Ложь;
	КонецЕсли;
	
	//+ ИнфоСофт Стояк Ю.К. 25.04.2023 УА #58008
	Если Константы.ИспользоватьСоглашенияСКлиентами.Получить() Тогда	
		Если Не ЗначениеЗаполнено(ФункциональныеОпции.Соглашение) Тогда
			Сообщение = Сообщение + "Соглашение; ";
			Результат = Ложь;
		КонецЕсли;
	КонецЕсли; 
	
	Если Константы.ИспользоватьДоговорыСКлиентами.Получить() Тогда
		Если Не ЗначениеЗаполнено(ФункциональныеОпции.Договор) Тогда
			Сообщение = Сообщение + "Договор; ";
			Результат = Ложь;
		КонецЕсли;
	КонецЕсли;
	
	Если Константы.ИспользоватьРасширенныеВозможностиЗаказаКлиента.Получить() Тогда
		Если Не ЗначениеЗаполнено(ФункциональныеОпции.СтатусЗаказаКлиента) Тогда
			Сообщение = Сообщение + "Статус Заказа Клиента; ";
			Результат = Ложь;
		КонецЕсли;  
	КонецЕсли;
	
	Если Константы.ИспользоватьПострочнуюОтгрузкуВЗаказеКлиента.Получить() Тогда
		Если Не ЗначениеЗаполнено(ФункциональныеОпции.ВариантОбеспечения) Тогда
			Сообщение = Сообщение + "Вариант Обеспечения; ";
			Результат = Ложь;
		КонецЕсли;
	КонецЕсли;
	//- ИнфоСофт Стояк Ю.К. 25.04.2023 УА #58008
	
	Если Не Результат Тогда
		ИС_MP_Сервер.ЗаписатьВЖРИСообщитьПользователю(Событие, Сообщение);
	КонецЕсли;
	
	Возврат Результат; 
	
КонецФункции //- ИнфоСофт Ивонин К.А. 29.03.23 УА #55822

