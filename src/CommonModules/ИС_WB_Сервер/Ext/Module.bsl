//+ ИнфоСофт Власова И.С. 04.02.25 УА #92612
Функция ЗагрузитьКатегорию(Профиль, Имя, Перезаполнять = Ложь, КэшКатегорий = Неопределено, ИдентификаторПредмета = Неопределено) Экспорт
	
	Событие = ПолучитьИмяСобытия("ЗагрузитьКатегорию");
	
	//+ ИнфоСофт Ивонин К.А. 20.01.25 УА #89159
	//НастройкиСоединения = ПолучитьНастройкиСоединенияПрофиля(Профиль);
	//	
	//Если НастройкиСоединения.Количество() = 0 Тогда
	//	ВызватьИсключение("Не удалось получить настройки подключения, проверьте настройки авторизации");
	//КонецЕсли;  
	//	
	//ПараметрыЗапроса = ИС_MP_РаботаСHTTPЗапросамиСервер.ПолучитьСтруктуруHTTPЗапроса();
	//РезультатПроверки = ПроверитьИЗаполнитьПараметрыЗапросаДляСервисаAPI(ПараметрыЗапроса, НастройкиСоединения);
	//
	//Если Не РезультатПроверки Тогда
	//	Возврат Неопределено;
	//КонецЕсли;
	
	ПараметрыЗапроса = ИС_ВБ_Сервер.ПараметрыHTTPЗапроса(Профиль, "Контент");
	//- ИнфоСофт Ивонин К.А. 20.01.25 УА #89159
	
	СтруктураЗапроса = ИС_WB_API.ПолучитьСтруктуруПараметровЗапросаСпискаПредметов();
	СтруктураЗапроса.name = Имя;
		
	КатегорияТоваров = ИС_WB_API.ПолучитьКатегорию(Профиль, ПараметрыЗапроса, СтруктураЗапроса);
		
	Если КатегорияТоваров = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Если КатегорияТоваров.error Тогда
		ОбщегоНазначения.СообщитьПользователю("Ошибка при получении списка предметов: " + КатегорияТоваров.errorText);
		Возврат Неопределено;
	КонецЕсли;	
	
	//+ ИнфоСофт Власова И.С. 04.02.25 УА #92612
	//JSON = КатегорияТоваров.data[0];
	
	Если КатегорияТоваров.data.Количество() = 0 Тогда
		
		Если ИдентификаторПредмета = Неопределено Тогда
			Возврат Неопределено;
		КонецЕсли;
		
		JSON = Новый Структура;
		JSON.Вставить("subjectName", Имя);
		JSON.Вставить("subjectID",   ИдентификаторПредмета);
		JSON.Вставить("parentName",  "");
		
	Иначе	
		JSON = КатегорияТоваров.data[0];
	КонецЕсли;
	//- ИнфоСофт Власова И.С. 04.02.25 УА #92612
	
	Если Перезаполнять Тогда
		Категория = Справочники.ИС_WB_Категории.НайтиПоНаименованию(Имя, Истина);
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(Категория) Тогда
		Категория = Справочники.ИС_WB_Категории.СоздатьЭлемент();
	Иначе
		Категория = Категория.ПолучитьОбъект();
	КонецЕсли;
	
	Категория.Наименование = JSON.subjectName;
	//Категория.Код = JSON.subjectID; Поддержка обратной совместимости
	Категория.subjectID = JSON.subjectID;
	Категория.РодительскаяКатегория = JSON.parentName; 
	
	СписокХарактеристик = ИС_WB_API.ПолучитьСписокХарактеристик(Профиль, ПараметрыЗапроса, JSON.subjectID);
	
	Если СписокХарактеристик <> Неопределено Тогда
		Категория.Характеристики.Очистить();
		ЗаполнитьКатегориюХарактеристиками(СписокХарактеристик.data, Категория.Характеристики, Перезаполнять);
		Категория.Характеристики.Сортировать("Поле");
	КонецЕсли;
									
	Попытка	
		
		Категория.Записать();
		
		Если КэшКатегорий <> Неопределено Тогда
			КэшКатегорий.Добавить(Имя);
		КонецЕсли;
								
		Возврат Категория.Ссылка;	
	
	Исключение	
		ИнформацияОбОшибке = ИнформацияОбОшибке();
		Текст = СтрШаблон("Не удалось записать элемент справочника Предметы WildBerries: %1", ИнформацияОбОшибке.Описание);
		ИС_MP_Сервер.ЗаписатьВЖРИСообщитьПользователю(Событие, Текст);			
	КонецПопытки;
						
КонецФункции //- ИнфоСофт Власова И.С. 04.02.25 УА #92612

