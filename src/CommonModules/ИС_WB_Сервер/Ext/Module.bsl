Процедура ОтменитьЗаказ(Заказ, Профиль) Экспорт 
	
	Событие = ПолучитьИмяСобытия("ОтменитьЗаказ");
	
	ФункциональныеОпции = ИС_WB_СерверПовтИсп.ПолучитьНастройкиФункциональностиСборочныхЗвданий(Профиль);
	
	//+ ИнфоСофт Мурсалимов Д.Р. 23.04.25 УА #99629
	АктивныйЗаказКлиента = ПолучитьАктивныйЗаказКлиента(Профиль);
	
	Если АктивныйЗаказКлиента <> Неопределено Тогда
		ФункциональныеОпции.Вставить("АктивныйЗаказКлиента", АктивныйЗаказКлиента);	
	КонецЕсли;
	//- ИнфоСофт Мурсалимов Д.Р. 23.04.25 УА #99629
	
	Если ФункциональныеОпции.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	//+ ИнфоСофт Стояк Ю.К. 09.08.2024 УА #81140	
	//Если ФункциональныеОпции.РежимСозданияЗаказов > 0 Тогда
	//	Возврат;
	//КонецЕсли;                                  
	//- ИнфоСофт Стояк Ю.К. 09.08.2024 УА #81140
	
	Если Не ФункциональныеОпции.УдалятьРТУ Тогда
		Возврат;
	КонецЕсли;
	
	ИспользоватьПричины = Ложь;
	
	Если Константы.ИспользоватьПричиныОтменыЗаказовКлиентов.Получить() Тогда
		ИспользоватьПричины = Истина;
		Если Не ЗначениеЗаполнено(ФункциональныеОпции.ПричинаОтмены) Тогда
			Возврат;
		КонецЕсли;
	КонецЕсли;
		
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ИС_WB_СборочноеЗадание.Ссылка КАК Ссылка,
