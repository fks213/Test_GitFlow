Функция ПроверитьСтатусОтчетаПлатногоХранения(Профиль, taskId) Экспорт
	
	//+ ИнфоСофт Ивонин К.А. 20.01.25 УА #89159
	ПараметрыЗапроса = ИС_ВБ_Сервер.ПараметрыHTTPЗапроса(Профиль, "Аналитика");
	//- ИнфоСофт Ивонин К.А. 20.01.25 УА #89159
	
	Результат = ИС_WB_API.ПроверитьСтатусОтчетаПлатногоХранения(Профиль, ПараметрыЗапроса, taskId);
	
	Если Результат = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
		
	Возврат Результат;

КонецФункции //- ИнфоСофт Мурсалимов Д.Р. 27.01.25 УА #67818

