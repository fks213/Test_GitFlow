Процедура ЗаписатьСтатусыСборочногоЗадания(Профиль, СборочноеЗадание, Статус, СтатусWB)
    
    Событие = ПолучитьИмяСобытия("ЗаписатьСтатусыСборочногоЗадания");
    
	МенеджерЗаписи = РегистрыСведений.ИС_WB_СтатусыИЭтикеткиСборочныхЗаданий.СоздатьМенеджерЗаписи();
	МенеджерЗаписи.Профиль = Профиль;
	МенеджерЗаписи.СборочноеЗадание = СборочноеЗадание;
	
	МенеджерЗаписи.Прочитать();
	
