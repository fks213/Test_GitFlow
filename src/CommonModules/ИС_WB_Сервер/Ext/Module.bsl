Функция ПолучитьПродажиПоРегионам(Профиль) Экспорт 
	
	Событие = ПолучитьИмяСобытия("ПолучитьПродажиПоРегионам");
	
	//+ ИнфоСофт Ивонин К.А. 20.01.25 УА #89159
	//НастройкиСоединения = ПолучитьНастройкиСоединенияПрофиля(Профиль);
	//	
	//Если НастройкиСоединения.Количество() = 0 Тогда
	//	ВызватьИсключение("Не удалось получить настройки подключения, проверьте настройки авторизации");
	//КонецЕсли;  
	//
	//ПараметрыЗапроса = ПроверитьИЗаполнитьПараметрыЗапроса(НастройкиСоединения);
	//
	//ЗаполнитьПараметрыЗапросаАналитики(ПараметрыЗапроса);
	
	ПараметрыЗапроса = ИС_ВБ_Сервер.ПараметрыHTTPЗапроса(Профиль, "Аналитика");
	//- ИнфоСофт Ивонин К.А. 20.01.25 УА #89159
		
	ТаблицаПоставок = Новый ТаблицаЗначений;	
				
	ТаблицаПоставок.Колонки.Добавить("Город", 			   Новый ОписаниеТипов("Строка"));
	ТаблицаПоставок.Колонки.Добавить("Страна", 			   Новый ОписаниеТипов("Строка"));
	ТаблицаПоставок.Колонки.Добавить("ФедеральныйОкруг",   Новый ОписаниеТипов("Строка"));
	ТаблицаПоставок.Колонки.Добавить("АртикулWB", 		   Новый ОписаниеТипов("Число"));
	ТаблицаПоставок.Колонки.Добавить("Регион", 			   Новый ОписаниеТипов("Строка"));
	ТаблицаПоставок.Колонки.Добавить("АртикулПродавца",    Новый ОписаниеТипов("Строка"));
	ТаблицаПоставок.Колонки.Добавить("КПеречислению", 	   Новый ОписаниеТипов("Число")); 
	ТаблицаПоставок.Колонки.Добавить("Доля", 			   Новый ОписаниеТипов("Число"));
	ТаблицаПоставок.Колонки.Добавить("Выкупили", 		   Новый ОписаниеТипов("Число")); 
	
	ТаблицаПоставок.Колонки.Добавить("НоменклатураWB", 	   Новый ОписаниеТипов("СправочникСсылка.ИС_WB_Номенклатура")); 
	
	_30Дней = 2592000;
	ДатаОкончания = ТекущаяДатаСеанса();
	ДатаНачала 	  = ДатаОкончания - 2592000; 
	
	СтруктураПараметров = Новый Структура;
	
	СтруктураПараметров.Вставить("dateFrom", ДатаНачала);
	СтруктураПараметров.Вставить("dateTo",   ДатаОкончания);
	
	СписокПоставок = ИС_WB_API.ПолучитьПродажиПоРегионам(Профиль, ПараметрыЗапроса, СтруктураПараметров);
	
	Если СписокПоставок = Неопределено Тогда 
		
		ИС_MP_Сервер.ЗаписатьВЖРИСообщитьПользователю(Событие, "Не удалось получить продажи по регионам за 30 дней");
		
		Возврат ТаблицаПоставок;
	КонецЕсли;
	
	Для Каждого Элемент Из СписокПоставок.report Цикл
		
		НоваяСтрока = ТаблицаПоставок.Добавить(); 
		
		НоваяСтрока.Город 			  = Элемент.cityName;
		НоваяСтрока.Страна 			  = Элемент.countryName;
		НоваяСтрока.ФедеральныйОкруг  = Элемент.foName;
		НоваяСтрока.АртикулWB 		  = Элемент.nmID;
		НоваяСтрока.Регион  		  = Элемент.regionName;
		НоваяСтрока.АртикулПродавца   = Элемент.sa;
		НоваяСтрока.КПеречислению  	  = Элемент.saleInvoiceCostPrice;
		НоваяСтрока.Доля   			  = Элемент.saleInvoiceCostPricePerc;  
		НоваяСтрока.Выкупили	      = Элемент.saleItemInvoiceQty;
		НоваяСтрока.НоменклатураWB    = Справочники.ИС_WB_Номенклатура.НайтиПоРеквизиту("vendorCode", Элемент.sa);
	КонецЦикла;	
	
	Возврат ТаблицаПоставок;
	
