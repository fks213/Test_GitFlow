//+ ИнфоСофт Мурсалимов Д.Р. 31.03.24 УА #72003
Процедура ВыгрузитьЦеныИСкидки(Профиль, ТаблицаВыгрузки = Неопределено) Экспорт
	
	Событие = ПолучитьИмяСобытия("ВыгрузитьЦеныИСкидки");
	
	//+ ИнфоСофт Ивонин К.А. 20.01.25 УА #89159
	//НастройкиСоединения = ПолучитьНастройкиСоединенияПрофиля(Профиль);
	//	
	//Если НастройкиСоединения.Количество() = 0 Тогда
	//	ВызватьИсключение("Не удалось получить настройки подключения, проверьте настройки авторизации");
	//КонецЕсли;  
	//	
	//ПараметрыЗапроса = ИС_MP_РаботаСHTTPЗапросамиСервер.ПолучитьСтруктуруHTTPЗапроса();
	//РезультатПроверки = ПроверитьИЗаполнитьПараметрыЗапросаДляСервисаAPI(ПараметрыЗапроса, НастройкиСоединения);
	//
	////ПараметрыЗапроса.Сервер = "discounts-prices-api-sandbox.wildberries.ru";
	//ПараметрыЗапроса.Сервер = "discounts-prices-api.wb.ru";
	//
	//Если Не РезультатПроверки Тогда
	//	Возврат;
	//КонецЕсли;
	
	ПараметрыЗапроса = ИС_ВБ_Сервер.ПараметрыHTTPЗапроса(Профиль, "Цены");
	//- ИнфоСофт Ивонин К.А. 20.01.25 УА #89159
	
	Если ТаблицаВыгрузки = Неопределено Тогда
	
		Настройки = ИС_WB_СерверПовтИсп.ПолучитьПараметрыВыгрузкиЦен(Профиль);
		
		Если Настройки = Неопределено Тогда
			ВызватьИсключение("Не удалость получить настройки для выгрузки цен и скидок");
		КонецЕсли;	
	
		ВидЦен = Настройки.ВидЦены;              
		ВидЦеныСоСкидкой = Настройки.ВидЦеныСоСкидкой;		
	
		Запрос = Новый Запрос;			
		Запрос.Текст = ПолучитьТекстЗапросаЦен();   		
		
		Запрос.УстановитьПараметр("ВидЦены", ВидЦен);
		Запрос.УстановитьПараметр("ВидЦеныСоСкидкой", ВидЦеныСоСкидкой);		
		Запрос.УстановитьПараметр("Профиль", Профиль);
		//+ ИнфоСофт Заварин К.В. 16.05.24 УА #76023
		//Запрос.УстановитьПараметр("Период", ТекущаяДатаСеанса());
		//- ИнфоСофт Заварин К.В. 16.05.24 УА #76023
		
		РезультатЗапроса = Запрос.Выполнить();
		Выборка = РезультатЗапроса.Выбрать();
		
		ТаблицаВыгрузки = Новый ТаблицаЗначений;		
		ТаблицаВыгрузки.Колонки.Добавить("НоменклатураWB");
		ТаблицаВыгрузки.Колонки.Добавить("nmId");
		ТаблицаВыгрузки.Колонки.Добавить("Цена");
		ТаблицаВыгрузки.Колонки.Добавить("Скидка");

		Пока Выборка.Следующий() Цикл
			
			Если Не Выборка.ЕстьСопоставление И Не Выборка.ЕстьРучнаяЦена Тогда	
				Продолжить;	
			КонецЕсли;
			
			Если Выборка.ЕстьРучнаяЦена Тогда
				Цена = Выборка.РучнаяЦена;
			Иначе
				Цена = Выборка.Цена;	
			КонецЕсли;
			
			Цена = Окр(Цена, 0, Настройки.РежимОкругленияЦен);
			
			Если Выборка.ЦенаСоСкидкой = 0 Тогда
				Скидка = 0;	
			Иначе
				Скидка = ?(Цена = 0, 0, 100 - Окр(Выборка.ЦенаСоСкидкой / Цена * 100, 0, Настройки.РежимОкругленияЦен));
			КонецЕсли;
			
			НоваяСтрока = ТаблицаВыгрузки.Добавить();
			НоваяСтрока.НоменклатураWB = Выборка.НоменклатураWB;
			НоваяСтрока.nmId = Выборка.nmId;
			НоваяСтрока.Цена = Цена;
			НоваяСтрока.Скидка = Скидка;				
				
		КонецЦикла;
	
	КонецЕсли;
	
	data = Новый Массив;
	 
	Для Каждого Строка Из ТаблицаВыгрузки Цикл
		
		dataStructure = Новый Структура;		
		dataStructure.Вставить("nmId", Строка.nmId);
		dataStructure.Вставить("price", Строка.Цена);
		dataStructure.Вставить("discount", Строка.Скидка);
			  
		data.Добавить(dataStructure);
		
	КонецЦикла;
	
	Если data.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	РазбитыйМассив = ИС_MP_Сервер.РазбитьМассивПоNЭлементов(data, 1000);
	
	Для Каждого Элемент Из РазбитыйМассив Цикл
    
    	РезультатВыгрузки = ИС_WB_API.ВыгрузитьЦеныИСкидки(Профиль, ПараметрыЗапроса, Элемент);
	
		Если РезультатВыгрузки = Неопределено Тогда
			Продолжить;
		КонецЕсли;  
		
		Если РезультатВыгрузки.Свойство("id") Тогда
			
			Если РезультатВыгрузки.alreadyExists Тогда
				
				ОбщегоНазначения.СообщитьПользователю("Все передаваемые цены и скидки уже установлены"); 
				Возврат;
				
			КонецЕсли;
			
		Иначе
			
			Текст = СтрШаблон("Не удалось выгрузить цены и скидки!");
			ОбщегоНазначения.СообщитьПользователю(Текст);
			Возврат;
			
		КонецЕсли;		
		
		ОбщегоНазначения.СообщитьПользователю("Загрузка цен и скидок создана, id: " + Формат(РезультатВыгрузки.id, "ЧГ=0"));	

    КонецЦикла;					
			
КонецПроцедуры //- ИнфоСофт Мурсалимов Д.Р. 31.03.24 УА #72003

