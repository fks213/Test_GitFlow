//+ ИнфоСофт Ивонин К.А. 14.03.24 УА #71892
Функция ПолучитьСкладПоУмолчанию(Профиль) Экспорт

	Результат = Справочники.ИС_ВБ_Склады.ПустаяСсылка();
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ ПЕРВЫЕ 2
	|	ИС_ВБ_Склады.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.ИС_ВБ_Склады КАК ИС_ВБ_Склады
	|ГДЕ
	|	ИС_ВБ_Склады.Профиль = &Профиль
	|	И НЕ ИС_ВБ_Склады.ПометкаУдаления";

	Запрос.УстановитьПараметр("Профиль", Профиль);
		
	РезультатЗапроса = Запрос.Выполнить();
	
	Выборка = РезультатЗапроса.Выбрать();

	Если Выборка.Количество() = 1 Тогда
		Выборка.Следующий();
		Результат = Выборка.Ссылка;
	КонецЕсли; 
	
	Возврат Результат;
	
КонецФункции //- ИнфоСофт Ивонин К.А. 14.03.24 УА #71892

//+ ИнфоСофт Ивонин К.А. 15.03.24 УА #71892
Функция ПолучитьОстаткиFBS(Профиль, Склад) Экспорт
	
	//+ ИнфоСофт Ивонин К.А. 20.01.25 УА #89159
	//НастройкиСоединения = ПолучитьНастройкиСоединенияПрофиля(Профиль);	
	//ПараметрыЗапроса = ПроверитьИЗаполнитьПараметрыЗапроса(НастройкиСоединения);
	
	ПараметрыЗапроса = ИС_ВБ_Сервер.ПараметрыHTTPЗапроса(Профиль, "Маркетплейс");
	//- ИнфоСофт Ивонин К.А. 20.01.25 УА #89159
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ИС_ВБ_Склады.Код КАК Код,
	|	ИС_ВБ_Склады.ТипТовара КАК ТипТовара,
	|	ИС_ВБ_Склады.ИспользоватьКГТ КАК ИспользоватьКГТ
	|ИЗ
	|	Справочник.ИС_ВБ_Склады КАК ИС_ВБ_Склады
	|ГДЕ
	|	ИС_ВБ_Склады.Ссылка = &Ссылка";
	
	Запрос.УстановитьПараметр("Ссылка", Склад);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаСклад = РезультатЗапроса.Выбрать();
	
	ВыборкаСклад.Следующий();
	
	warehouseId = Формат(ВыборкаСклад.Код, "ЧГ=0");
	
	ТипТовара = Новый Массив;
	ТипТовара.Добавить(ВыборкаСклад.ТипТовара);
	
	Если ВыборкаСклад.ИспользоватьКГТ Тогда
		ТипТовара.Добавить(Перечисления.ИС_ВБ_ТипыТоваров.КГТ);
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ИС_WB_Номенклатура.Ссылка КАК Ссылка
	|ПОМЕСТИТЬ ВТ_НоменклатураWB
	|ИЗ
	|	Справочник.ИС_WB_Номенклатура КАК ИС_WB_Номенклатура
	|ГДЕ
	|	НЕ ИС_WB_Номенклатура.ПометкаУдаления
	|	И ИС_WB_Номенклатура.Профиль = &Профиль
	|	И ИС_WB_Номенклатура.ТипТовара В (&ТипТовара)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ИС_WB_РазмерыНоменклатур.Ссылка КАК Ссылка
	|ПОМЕСТИТЬ ВТ_РазмерыWB
	|ИЗ
	|	Справочник.ИС_WB_РазмерыНоменклатур КАК ИС_WB_РазмерыНоменклатур
	|ГДЕ
	|	ИС_WB_РазмерыНоменклатур.Владелец В
	|			(ВЫБРАТЬ
	|				ВТ.Ссылка КАК Ссылка
	|			ИЗ
	|				ВТ_НоменклатураWB КАК ВТ)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_РазмерыWB.Ссылка КАК Ссылка,
	|	МАКСИМУМ(ИС_WB_ШтрихкодыРазмеров.Штрихкод) КАК Штрихкод
	|ИЗ
	|	ВТ_РазмерыWB КАК ВТ_РазмерыWB
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.ИС_WB_ШтрихкодыРазмеров КАК ИС_WB_ШтрихкодыРазмеров
	|		ПО ВТ_РазмерыWB.Ссылка = ИС_WB_ШтрихкодыРазмеров.Размер
	|ГДЕ
	|	НЕ ИС_WB_ШтрихкодыРазмеров.Штрихкод = """"
	|
	|СГРУППИРОВАТЬ ПО
	|	ВТ_РазмерыWB.Ссылка";
	
	Запрос.УстановитьПараметр("Профиль", Профиль);
	Запрос.УстановитьПараметр("ТипТовара", ТипТовара);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаШтрихкоды = РезультатЗапроса.Выбрать();
	
	МассивSKU = Новый Массив;
	
	Результат = Новый ТаблицаЗначений;
	Результат.Колонки.Добавить("РазмерWB");
	Результат.Колонки.Добавить("Штрихкод");
	Результат.Колонки.Добавить("Остаток");
	
	Пока ВыборкаШтрихкоды.Следующий() Цикл
	
		НоваяСтрока = Результат.Добавить();
		НоваяСтрока.РазмерWB = ВыборкаШтрихкоды.Ссылка;
		НоваяСтрока.Штрихкод = ВыборкаШтрихкоды.Штрихкод;
		
		МассивSKU.Добавить(ВыборкаШтрихкоды.Штрихкод);
	
	КонецЦикла;
			
	МассивДляВыгрузки = ИС_MP_Сервер.РазбитьМассивПоNЭлементов(МассивSKU, 1000);

	Для Каждого Массив Из МассивДляВыгрузки Цикл
		
		ОстаткиТоваров = ИС_WB_API.ПолучитьОстаткиТоваров(Профиль, ПараметрыЗапроса, warehouseId, Массив);
			
		Если ОстаткиТоваров = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		Для Каждого Элемент Из ОстаткиТоваров.stocks Цикл
		
			НайденныеСтроки = Результат.НайтиСтроки(Новый Структура("Штрихкод", Элемент.sku));
			
			Если НайденныеСтроки.Количество() > 0 Тогда
				НайденныеСтроки[0].Остаток = Элемент.amount;	
			КонецЕсли;
		
		КонецЦикла;	
                
	КонецЦикла; 
							
	Возврат Результат;
	
КонецФункции //- ИнфоСофт Ивонин К.А. 15.03.24 УА #71892

//+ ИнфоСофт Ивонин К.А. 01.04.24 УА #71892
Функция ПолучитьИнформациюОСкладе(Склад) Экспорт

	ЗапросСклада = Новый Запрос;
	ЗапросСклада.Текст = 
	"ВЫБРАТЬ
	|	ИС_ВБ_Склады.Ссылка КАК Ссылка,
	|	ИС_ВБ_Склады.ТипТовара КАК ТипТовара,
	|	ИС_ВБ_Склады.ВыгружатьОстаткиИзГруппыСкладов КАК ВыгружатьОстаткиИзГруппыСкладов,
	|	ИС_ВБ_Склады.Склад КАК Склад,	
	|	ИС_ВБ_Склады.ОбщаяГруппаСкладов КАК ОбщаяГруппаСкладов,
	|	ИС_ВБ_СкладыГруппаСкладов.Склад КАК СкладГруппы
	|ИЗ
	|	Справочник.ИС_ВБ_Склады КАК ИС_ВБ_Склады
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ИС_ВБ_Склады.ГруппаСкладов КАК ИС_ВБ_СкладыГруппаСкладов
	|		ПО ИС_ВБ_Склады.Ссылка = ИС_ВБ_СкладыГруппаСкладов.Ссылка
	|ГДЕ
	|	ИС_ВБ_Склады.Ссылка = &Ссылка
	|ИТОГИ ПО
	|	Ссылка";
	
	ЗапросСклада.УстановитьПараметр("Ссылка", Склад);
	
	РезультатЗапроса = ЗапросСклада.Выполнить();
	
	ВыборкаСклад = РезультатЗапроса.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	Результат = "";
		
	Пока ВыборкаСклад.Следующий() Цикл
		
		Результат = Результат + "ТипТовара: " + ВыборкаСклад.ТипТовара + Символы.ПС;				
				
		Если ВыборкаСклад.ВыгружатьОстаткиИзГруппыСкладов Тогда 
		    
		    Результат = Результат + "Группа складов: " + Символы.ПС;
		    
			ВыборкаГруппаСкладов = ВыборкаСклад.Выбрать();
		
			Пока ВыборкаГруппаСкладов.Следующий() Цикл
			
				Если ВыборкаГруппаСкладов.СкладГруппы <> Null Тогда
			    	Результат = Результат + Символы.Таб + " - " + ВыборкаГруппаСкладов.СкладГруппы + Символы.ПС;
			    КонецЕсли;
			    
			КонецЦикла;				
		
		ИначеЕсли ЗначениеЗаполнено(ВыборкаСклад.ОбщаяГруппаСкладов) Тогда
			Результат = Результат + "Общая группа складов: " + ВыборкаСклад.ОбщаяГруппаСкладов + Символы.ПС;
		Иначе
			Результат = Результат + "Склад: " + ВыборкаСклад.Склад + Символы.ПС;		
		КонецЕсли;
	
	КонецЦикла;
    
    Возврат Результат;

КонецФункции //- ИнфоСофт Ивонин К.А. 01.04.24 УА #71892

