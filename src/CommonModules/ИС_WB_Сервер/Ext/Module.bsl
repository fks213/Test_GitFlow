//+ ИнфоСофт Ивонин К.А. 19.02.23 УА #53535
Процедура ПроверитьФункциональныеОпцииСборочныхЗаданий(Профиль, МассивЗаданий)

	ОбновитьСтатусыСборочныхЗаданий(Профиль, МассивЗаданий);
	
	ФукнциональныеОпции = ИС_WB_СерверПовтИсп.ПолучитьНастройкиФункциональностиСборочныхЗвданий(Профиль);
	
	//+ ИнфоСофт Мурсалимов Д.Р. 23.04.25 УА #99629
	АктивныйЗаказКлиента = ПолучитьАктивныйЗаказКлиента(Профиль);
	
	Если АктивныйЗаказКлиента <> Неопределено Тогда	
		ФукнциональныеОпции.Вставить("АктивныйЗаказКлиента", АктивныйЗаказКлиента);	
	КонецЕсли;
	//- ИнфоСофт Мурсалимов Д.Р. 23.04.25 УА #99629
	
	Если ФукнциональныеОпции.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	Если ФукнциональныеОпции.АвтоматическиДобавлятьВПоставку Тогда	
		ИС_ВБ_Сервер.СписокПоставок(Профиль);
		РазбитьСборочныеЗаданияПоПоставкам(Профиль, МассивЗаданий);		
	КонецЕсли;
	
	Если ФукнциональныеОпции.АвтоматическиСоздаватьЗаказы Тогда	
		СоздатьЗаказы(Профиль, МассивЗаданий);		
	КонецЕсли;
	
	Если ФукнциональныеОпции.АвтоматическиСоздаватьРеализации 
		И ФукнциональныеОпции.РежимСозданияЗаказов <> 2 Тогда	
		СоздатьРеализации(Профиль, МассивЗаданий);		
	КонецЕсли;
	
КонецПроцедуры //- ИнфоСофт Ивонин К.А. 19.02.23 УА #53535

//+ ИнфоСофт Ивонин К.А. 19.02.23 УА #53535
Процедура РазбитьСборочныеЗаданияПоПоставкам(Профиль, МассивЗаданий)
		
	Событие = ПолучитьИмяСобытия("РазбитьСборочныеЗаданияПоПоставкам");
	
	//+ ИнфоСофт Стояк Ю.К. 24.09.2024 УА #72283	
	Если Профиль.РежимСозданияЗаказов <> 2 Тогда
		
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	ИС_WB_СборочноеЗадание.Ссылка КАК Ссылка,
		|	ИС_WB_СборочноеЗадание.Склад КАК Склад,
		|	ИС_WB_СборочноеЗадание.Склад.ТипТовара КАК ТипТовара,
		|	ЕСТЬNULL(ИС_ВБ_АктивныеПоставки.ПоставкаWB, ЗНАЧЕНИЕ(Справочник.ИС_ВБ_ПоставкиFBS.ПустаяСсылка)) КАК ПоставкаWB,
		|	ЕСТЬNULL(ИС_ВБ_АктивныеПоставки.ПоставкаWB.done, ИСТИНА) КАК Закрыта
		|ИЗ
		|	Документ.ИС_WB_СборочноеЗадание КАК ИС_WB_СборочноеЗадание
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ИС_ВБ_АктивныеПоставки КАК ИС_ВБ_АктивныеПоставки
		|		ПО (ИС_WB_СборочноеЗадание.Склад = ИС_ВБ_АктивныеПоставки.СкладWB)
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ИС_WB_СтатусыИЭтикеткиСборочныхЗаданий КАК ИС_WB_СтатусыИЭтикеткиСборочныхЗаданий
		|		ПО (ИС_WB_СборочноеЗадание.Ссылка = ИС_WB_СтатусыИЭтикеткиСборочныхЗаданий.СборочноеЗадание)
		|ГДЕ
		|	ИС_WB_СборочноеЗадание.Ссылка В(&МассивСсылок)
		|	И ИС_WB_СтатусыИЭтикеткиСборочныхЗаданий.Поставка = ЗНАЧЕНИЕ(Справочник.ИС_ВБ_ПоставкиFBS.ПустаяСсылка)	
		|ИТОГИ ПО
		|	ТипТовара,
		|	Склад";
		
