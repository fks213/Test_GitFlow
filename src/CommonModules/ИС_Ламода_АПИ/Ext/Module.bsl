//+ ИнфоСофт Власова И.С. 23.12.24 УА #90120
Функция ПолучитьТокенB2B(Профиль, ПараметрыЗапроса, СтруктураПараметров) Экспорт
	
	ЗаполнитьЗаголовкиHTTP(ПараметрыЗапроса);
	
	ТелоЗапроса = ИС_МП_РаботаСHTTPЗапросами.ПолучитьСтрокуJSON(СтруктураПараметров);
	
	ПараметрыЗапроса.АдресРесурса = "/auth/token";
	ПараметрыЗапроса.ФорматОтвета = "Строка";
	ПараметрыЗапроса.ТелоСтрока   = ТелоЗапроса;
		
	РезультатЗапроса = ИС_МП_РаботаСHTTPЗапросами.ОтправитьGETЗапрос(ПараметрыЗапроса);
	
	ЗаписатьДанныеОтладки(Профиль, ПараметрыЗапроса, РезультатЗапроса);
	
	Если РезультатЗапроса.ЕстьОшибки Тогда
		Текст = СтрШаблон("Произошла ошибка при отправке запроса: %1", РезультатЗапроса.ИнформацияОбОшибке.Описание);
		ОбщегоНазначения.СообщитьПользователю(Текст); 
		Возврат Неопределено;	
	КонецЕсли;
	
	Если РезультатЗапроса.КодОтвета = 200 Тогда
		
		JSON = ИС_МП_РаботаСHTTPЗапросами.ПолучитьОбъектJSON(РезультатЗапроса.Ответ);
		
		Если Не JSON = Неопределено Тогда				
			Возврат JSON;	
		Иначе
			Текст = "Получен нераспознанный ответ от сервера: " + РезультатЗапроса.Ответ;
			ОбщегоНазначения.СообщитьПользователю(Текст);
			Возврат Неопределено;
		КонецЕсли;
		
	КонецЕсли;
	
	РазобратьHTTPОтветПоКоду(РезультатЗапроса);
	Возврат Неопределено;
	
КонецФункции //- ИнфоСофт Власова И.С. 23.12.24 УА #90120

