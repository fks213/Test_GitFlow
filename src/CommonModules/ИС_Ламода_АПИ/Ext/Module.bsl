//+ ИнфоСофт Власова И.С. 23.12.24 УА #90120
Процедура ЗаполнитьЗаголовкиHTTP(ПараметрыЗапроса)
	
	ПараметрыЗапроса.Заголовки.Вставить("Content-Type", "application/json");
	ПараметрыЗапроса.Заголовки.Вставить("Accept",       "application/json");
	
