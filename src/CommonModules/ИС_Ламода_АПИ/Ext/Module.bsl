//+ ИнфоСофт Власова И.С. 14.01.25 УА #90120
Функция ПроверитьОтветСервиса(СтруктураОтвета)
	
	ЕстьОшибки = Ложь;
	
	Если ЕстьКлюч(СтруктураОтвета, "error") Тогда
		
		ТекстСообщения = СтрШаблон(
			НСтр("ru = 'Ошибка при проверке ответа от сервиса.
				|Код ошибки: %1,
				|Сообщение: %2.'"), 
			СтруктураОтвета["error"]["code"], 
			СтруктураОтвета["error"]["message"]);
			
		ОбщегоНазначения.СообщитьПользователю(ТекстСообщения);
		
		ЕстьОшибки = Истина;
		
	КонецЕсли;
	
	Если Не ЕстьКлюч(СтруктураОтвета, "result") Тогда
		
		ТекстСообщения = НСтр("ru = 'Ошибка при проверке ответа от сервиса.
			|Отсутствует поле result.'");
		
		ОбщегоНазначения.СообщитьПользователю(ТекстСообщения);
		
		ЕстьОшибки = Истина;
		
	КонецЕсли;
	
	Возврат ЕстьОшибки;
	
КонецФункции //- ИнфоСофт Власова И.С. 14.01.25 УА #90120

//+ ИнфоСофт Власова И.С. 14.01.25 УА #90120
Функция ЕстьКлюч(Коллекция, Ключ)
	
	Если Коллекция = Неопределено
		ИЛИ Не ТипЗнч(Коллекция) = Тип("Структура") Тогда
		
		Возврат Ложь;
		
	Иначе
		Возврат Не Коллекция.Свойство(Ключ) = Неопределено;
	КонецЕсли;
	
КонецФункции //- ИнфоСофт Власова И.С. 14.01.25 УА #90120

