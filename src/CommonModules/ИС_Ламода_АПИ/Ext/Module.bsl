//+ ИнфоСофт Власова И.С. 23.12.24 УА #90120
Процедура РазобратьHTTPОтветПоКоду(СтруктураОтвета)
	
	Если СтруктураОтвета.КодОтвета = 400 Тогда
		
		Текст = СтрШаблон("Передан неверный параметр, код ответа: %1, ошибка: %2", 
			СтруктураОтвета.КодОтвета, СтруктураОтвета.Ответ);
	
	ИначеЕсли СтруктураОтвета.КодОтвета = 401 Тогда
		
		Текст = СтрШаблон("Отказ в доступе, код ответа: %1, ошибка: %2", 
			СтруктураОтвета.КодОтвета, СтруктураОтвета.Ответ);
	
	ИначеЕсли СтруктураОтвета.КодОтвета = 403 Тогда
		
		Текст = СтрШаблон("Доступ запрещен, код ответа: %1, ошибка: %2", 
			СтруктураОтвета.КодОтвета, СтруктураОтвета.Ответ);
		
	ИначеЕсли СтруктураОтвета.КодОтвета = 500 Тогда
		
		Текст = СтрШаблон("Произошла внутренняя ошибка сервера, код ответа: %1, ошибка: %2", 
			СтруктураОтвета.КодОтвета, СтруктураОтвета.Ответ);
		
	Иначе
		
		Текст = СтрШаблон("Произошла неизвестная ошибка, код ответа: %1, ошибка: %2", 
			СтруктураОтвета.КодОтвета, СтруктураОтвета.Ответ);
		
	КонецЕсли;
	
	ОбщегоНазначения.СообщитьПользователю(Текст);

КонецПроцедуры //- ИнфоСофт Власова И.С. 23.12.24 УА #90120

//+ ИнфоСофт Власова И.С. 23.12.24 УА #90120
Процедура ЗаписатьДанныеОтладки(Профиль, ПараметрыЗапроса, РезультатЗапроса)
       
	Если Не Профиль.РежимОтладки Тогда
		Возврат;
	КонецЕсли;
	
	Маркетплейс = Перечисления.ИС_МП_Маркетплейсы.Ламода;
		
	ИС_МП_Сервер.ЗаписатьДанныеОтладки(Профиль, Маркетплейс, ПараметрыЗапроса, РезультатЗапроса);	

КонецПроцедуры //- ИнфоСофт Власова И.С. 23.12.24 УА #90120

