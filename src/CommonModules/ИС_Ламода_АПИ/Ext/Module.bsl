Функция ПолучитьНоменклатуру(Профиль, ПараметрыЗапроса, СтруктураПараметров) Экспорт
	
	ЗаполнитьЗаголовкиHTTP(ПараметрыЗапроса);
	
	ИмяМетода = "v1.nomenclatures.list";
	
	СтруктураЗапроса = СформироватьСтруктуруJsonRPC(ИмяМетода, СтруктураПараметров);
	
	ТелоЗапроса = ИС_МП_РаботаСHTTPЗапросами.ПолучитьСтрокуJSON(СтруктураЗапроса);
	
	ПараметрыЗапроса.АдресРесурса = "";
	ПараметрыЗапроса.ФорматОтвета = "Строка";
	ПараметрыЗапроса.ТелоСтрока   = ТелоЗапроса;
		
	РезультатЗапроса = ИС_МП_РаботаСHTTPЗапросами.ОтправитьPOSTЗапрос(ПараметрыЗапроса);
	
	ЗаписатьДанныеОтладки(Профиль, ПараметрыЗапроса, РезультатЗапроса);
	
	Если РезультатЗапроса.ЕстьОшибки Тогда
		Текст = СтрШаблон("Произошла ошибка при отправке запроса: %1",	РезультатЗапроса.ИнформацияОбОшибке.Описание);
		ОбщегоНазначения.СообщитьПользователю(Текст); 
		Возврат Неопределено;
	КонецЕсли;	
	
	Если РезультатЗапроса.КодОтвета = 200 Тогда
		
		СтруктураОтвета = ИС_МП_РаботаСHTTPЗапросами.ПолучитьОбъектJSON(РезультатЗапроса.Ответ);
		
		Если ТипЗнч(СтруктураОтвета) = Тип("Структура") Тогда				
			
			ЕстьОшибки = ПроверитьОтветСервиса(СтруктураОтвета);
			
			Если ЕстьОшибки Тогда
				Возврат Неопределено;
			Иначе
				Возврат СтруктураОтвета.result;
			КонецЕсли;
			
		КонецЕсли;
		
		Текст = "Получен нераспознанный ответ от сервера: " + РезультатЗапроса.Ответ;
		ОбщегоНазначения.СообщитьПользователю(Текст);
		Возврат Неопределено;
		
	КонецЕсли;
	
	РазобратьHTTPОтветПоКоду(РезультатЗапроса);
	Возврат Неопределено;
	
КонецФункции //- ИнфоСофт Власова И.С. 23.12.24 УА #90120

