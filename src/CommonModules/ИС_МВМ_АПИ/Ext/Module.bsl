//+ ИнфоСофт Ивонин К.А. 22.10.24 УА #68001
Функция ПолучитьТокен(Профиль, ПараметрыЗапроса, ТелоСтруктура, refreshToken = "") Экспорт
	
	ЗаполнитьЗаголовкиHTTP(ПараметрыЗапроса);
		              
	ПараметрыЗапроса.АдресРесурса = "/api/v3/auth/realms/master/openid-connect/token";
	ПараметрыЗапроса.ФорматОтвета = "Строка";
 
	Если ЗначениеЗаполнено(refreshToken) Тогда
		ТелоСтруктура.Вставить("grantType", "REFRESH_TOKEN");
		ТелоСтруктура.Вставить("refreshToken", refreshToken);
	Иначе
		ТелоСтруктура.Вставить("grantType", "CLIENT_CREDENTIALS");
	КонецЕсли;
	
	ПараметрыЗапроса.ТелоСтрока = ИС_МП_РаботаСHTTPЗапросами.ПолучитьСтрокуJSON(ТелоСтруктура);
		
	РезультатЗапроса = ИС_МП_РаботаСHTTPЗапросами.ОтправитьPOSTЗапрос(ПараметрыЗапроса);
	
	ЗаписатьДанныеОтладки(Профиль, ПараметрыЗапроса, РезультатЗапроса);
	
	Если РезультатЗапроса.ЕстьОшибки Тогда
		Текст = СтрШаблон("Произошла ошибка при отправке запроса: %1",	РезультатЗапроса.ИнформацияОбОшибке.Описание);
		ОбщегоНазначения.СообщитьПользователю(Текст); 
		Возврат Неопределено;	
	КонецЕсли;
	
	Если РезультатЗапроса.КодОтвета = 200 Тогда
	
		JSON = ИС_МП_РаботаСHTTPЗапросами.ПолучитьОбъектJSON(РезультатЗапроса.Ответ);
		
		Если ТипЗнч(JSON) = Тип("Структура") Тогда				
			Возврат JSON;	
		Иначе
			Текст = "Получен нераспознанный ответ от сервера: " + РезультатЗапроса.Ответ;
		 	ОбщегоНазначения.СообщитьПользователю(Текст);
			Возврат Неопределено;
		КонецЕсли;
		
	ИначеЕсли РезультатЗапроса.КодОтвета = 400 Тогда
         
        Текст = "Ошибка в запросе: " + РезультатЗапроса.Ответ; 
  		ОбщегоНазначения.СообщитьПользователю(Текст);
		Возврат Неопределено;
		
	КонецЕсли;
			
	РазобратьHTTPОтветПоКоду(РезультатЗапроса);
	Возврат Неопределено;
	
КонецФункции //- ИнфоСофт Ивонин К.А. 22.10.24 УА #68001

#КонецОбласти

