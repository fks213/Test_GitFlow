//+ ИнфоСофт Ивонин К.А. 08.02.24 УА #70082
Процедура ЗаполнитьЗаголовкиHTTP(ПараметрыЗапроса)
	ПараметрыЗапроса.Заголовки.Вставить("Content-Type", "application/json");
	ПараметрыЗапроса.Заголовки.Вставить("Accept", "application/json");
КонецПроцедуры //- ИнфоСофт Ивонин К.А. 08.02.24 УА #70082

//+ ИнфоСофт Ивонин К.А. 22.10.24 УА #68001
Процедура РазобратьHTTPОтветПоКоду(СтруктураОтвета)

	Если СтруктураОтвета.КодОтвета = 500 Тогда
		
		Текст = "Произошла внутренняя ошибка сервера, код ответа: 500, ошибка: " + СтруктураОтвета.Ответ;			
		ОбщегоНазначения.СообщитьПользователю(Текст);
		
	Иначе
		Текст = СтрШаблон("Произошла неизвестная ошибка, код ответа: %1, ошибка: %2", 
			СтруктураОтвета.КодОтвета, СтруктураОтвета.Ответ);			
		ОбщегоНазначения.СообщитьПользователю(Текст);				
	КонецЕсли;

КонецПроцедуры //- ИнфоСофт Ивонин К.А. 22.10.24 УА #68001

//+ ИнфоСофт Ивонин К.А. 27.06.22 УА #46999
Процедура ЗаписатьДанныеОтладки(Профиль, ПараметрыЗапроса, РезультатЗапроса)
       
	Если Не ПараметрыЗапроса.РежимОтладки Тогда
		Возврат;
	КонецЕсли;
		
	ИС_МП_Сервер.ЗаписатьДанныеОтладки(Профиль, 
		Перечисления.ИС_МП_Маркетплейсы.МВМ, ПараметрыЗапроса, РезультатЗапроса);	

КонецПроцедуры //- ИнфоСофт Ивонин К.А. 27.06.22 УА #46999

