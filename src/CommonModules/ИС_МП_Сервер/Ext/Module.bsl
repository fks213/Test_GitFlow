//+ ИнфоСофт Ивонин К.А. 28.01.21 УА #30203
//
// Функция - Получить ссылку на перечисление
// Пытается получить ссылку на значение указанного перечисления по названию,
// при неудаче возвращает пустую ссылку
//
// Параметры:
//  Перечисление - ПеречислениеСсылка - Объект метаданных конфигурации перечисление 
//  Значение	 - Строка - Искомое перечисление 
// 
// Возвращаемое значение:
// СсылкаНаПеречисление - Возвращает ссылку на найденное по имени значение или пустую ссылку  
//
Функция ЗначениеПеречисленияПоЗначению(Перечисление, Значение) Экспорт

	Результат = Перечисление.ПустаяСсылка();
	
	Попытка
		Результат = Перечисление[Значение];
	Исключение
	КонецПопытки;
	
	Возврат Результат;

КонецФункции //- ИнфоСофт Ивонин К.А. 28.01.21 УА #30203

//+ ИнфоСофт Ивонин К.А. 31.03.24 УА #71892
Функция ТаблицаЗначенийИзExcel(Адрес, Параметры = Неопределено) Экспорт 
	
	Событие = ИмяСобытия("ТаблицаЗначенийИзExcel");
	
	Если ТипЗнч(Параметры) = Тип("Структура") Тогда
		
		Если Параметры.Свойство("СпособЧтенияЗначений") Тогда
			СпособЧтенияЗначений = Параметры.СпособЧтенияЗначений;
		Иначе
			СпособЧтенияЗначений = СпособЧтенияЗначенийТабличногоДокумента.Текст;		
		КонецЕсли;
		
	КонецЕсли;
	
	ФайлВременногоХранилища = ПолучитьИзВременногоХранилища(Адрес);
	Имя = ПолучитьИмяВременногоФайла("xlsx");
	ФайлВременногоХранилища.Записать(Имя);
	
	ТабличныйДокумент = Новый ТабличныйДокумент;
	
	ТабличныйДокумент.Прочитать(Имя, СпособЧтенияЗначений);
	
	Попытка
		УдалитьФайлы(Имя);
	Исключение
		ЗаписатьВЖРИСообщитьПользователю(Событие, "Не удалось удалить временный файл" + Имя);
	КонецПопытки;
	
	ТабличныйДокумент.Область().Разъединить();
	
	ПерваяСтрока = 1;
	ПерваяКолонка = 1;	
	ПоследняяСтрока = ТабличныйДокумент.ВысотаТаблицы;
	ПоследняяКолонка = ТабличныйДокумент.ШиринаТаблицы;
		
	Если ПоследняяСтрока = 0 Тогда	
		ОбщегоНазначения.СообщитьПользователю("Файл excel пуст");
		Возврат Неопределено;	
	КонецЕсли;
	
	Если ТипЗнч(Параметры) = Тип("Структура") Тогда
		
		Если Параметры.Свойство("ПерваяСтрока") Тогда
			ПерваяСтрока = Параметры.ПерваяСтрока;
		КонецЕсли;
		
		Если Параметры.Свойство("ПерваяКолонка") Тогда
			ПерваяКолонка = Параметры.ПерваяКолонка;
		КонецЕсли;
		
		Если Параметры.Свойство("ПоследняяСтрока") Тогда
			ПоследняяСтрока = Параметры.ПоследняяСтрока;
		КонецЕсли;
		
		Если Параметры.Свойство("ПоследняяКолонка") Тогда
			ПоследняяКолонка = Параметры.ПоследняяКолонка;
		КонецЕсли;
		
	КонецЕсли;
	
	ОбластьЯчеек = ТабличныйДокумент.Область(ПерваяСтрока, ПерваяКолонка, ПоследняяСтрока, ПоследняяКолонка);
	
	ИсточникДанных = Новый ОписаниеИсточникаДанных(ОбластьЯчеек);
	
	ПостроительОтчета = Новый ПостроительОтчета;
	ПостроительОтчета.ИсточникДанных = ИсточникДанных;
	ПостроительОтчета.Выполнить();
	
	Результат = ПостроительОтчета.Результат.Выгрузить();
	
	Возврат Результат;
		
КонецФункции //- ИнфоСофт Ивонин К.А. 31.03.24 УА #71892

