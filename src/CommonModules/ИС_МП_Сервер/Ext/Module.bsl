//+ ИнфоСофт Ивонин К.А. 06.02.25 УА #92406
Функция ЛокализоватьДату(Дата) Экспорт

	ЧПИБ = ИС_МП_СерверПовтИсп.ЧасовойПоясИнформационнойБазы();
	
	Если ЧПИБ = Неопределено Тогда
		Возврат Дата;
	КонецЕсли;

	ЧПСервера = ЧасовойПояс();    
	
	Если ЧПСервера = ЧПИБ Тогда
		Возврат Дата;
	КонецЕсли;
		                                                   	         
    Возврат МестноеВремя(УниверсальноеВремя(Дата, ЧПСервера), ЧПИБ);

КонецФункции //- ИнфоСофт Ивонин К.А. 06.02.25 УА #92406

//+ ИнфоСофт Ивонин К.А. 13.04.23 УА #57127
// Останавливает выполнение кода на заданное время.
//
// Параметры:
//  Секунд - Число - время ожидания в секундах.
//
Процедура Пауза(Секунд) Экспорт
	
	ТекущийСеансИнформационнойБазы = ПолучитьТекущийСеансИнформационнойБазы();
	ФоновоеЗадание = ТекущийСеансИнформационнойБазы.ПолучитьФоновоеЗадание();
	
	Если ФоновоеЗадание = Неопределено Тогда
		Параметры = Новый Массив;
		Параметры.Добавить(Секунд);
		ФоновоеЗадание = ФоновыеЗадания.Выполнить("ИС_МП_Сервер.Пауза", Параметры);
	КонецЕсли;
		
	ФоновоеЗадание.ОжидатьЗавершенияВыполнения(Секунд);
	
КонецПроцедуры //- ИнфоСофт Ивонин К.А. 13.04.23 УА #57127

//+ ИнфоСофт Ивонин К.А. 20.03.25 УА #96356
Функция УдалитьПустыеЭлементыМассива(Массив) Экспорт

	Результат = Новый Массив;
	
	Для Каждого Элемент Из Массив Цикл

		Если ЗначениеЗаполнено(Элемент) Или Элемент = 0 Тогда
			Результат.Добавить(Элемент);
		КонецЕсли;

	КонецЦикла;

	Возврат Результат;

КонецФункции //- ИнфоСофт Ивонин К.А. 20.03.25 УА #96356

//+ ИнфоСофт Ивонин К.А. 01.04.25 УА #63915
Функция УдалитьНедопустимыеСимволыXML(Знач Стр) Экспорт
	
	Позиция = НайтиНедопустимыеСимволыXML(Стр);

	Пока Позиция > 0 Цикл
		
		Стр = Лев(Стр, Позиция - 1) + Сред(Стр, Позиция + 1);
		Позиция = НайтиНедопустимыеСимволыXML(Стр);
		
	КонецЦикла;

	Возврат Стр;
	
КонецФункции //- ИнфоСофт Ивонин К.А. 01.04.25 УА #63915

