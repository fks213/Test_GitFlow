#Область РаботаСНастройками

// + ИнфоСофт Ивонин К.А. 02.04.24 УА #71892
//
// Параметры:
//  Профиль			 - СправочникСсылка.ИС_WB_Профили - Профиль 
//  Маркетплейс		 - ПеречислениеСсылка.ИС_МП_Маркетплейсы - Маркетплейс 
//  МассивПараметров - Массив - Массив строчных наименований настроек, которые необходимо получить
//  РежимЧтения		 - Строка - Тип хранения значения: Значение, Строка, Хранилище
// 
// Возвращаемое значение:
//  Структура - Структура содержащая полученнные настройки
//
Функция ПолучитьЗначениеНастроек(Профиль, Маркетплейс, МассивПараметров, РежимЧтения = "Значение") Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ИС_MP_Настройки.Параметр КАК Параметр,
	|	ИС_MP_Настройки.&РежимЧтения КАК Значение
	|ИЗ
	|	РегистрСведений.ИС_MP_Настройки КАК ИС_MP_Настройки
	|ГДЕ
	|	ИС_MP_Настройки.Профиль = &Профиль
	|	И ИС_MP_Настройки.Маркетплейс = &Маркетплейс
	|	И ИС_MP_Настройки.Параметр В(&МассивПараметров)";
	
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "&РежимЧтения", РежимЧтения);
	
	Запрос.УстановитьПараметр("Маркетплейс", Маркетплейс);
	Запрос.УстановитьПараметр("МассивПараметров", МассивПараметров);
	Запрос.УстановитьПараметр("Профиль", Профиль);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаПараметров = РезультатЗапроса.Выбрать();

	Результат = Новый Структура;
	
	Для Каждого Элемент Из МассивПараметров Цикл
		Результат.Вставить(Элемент, Неопределено);	
	КонецЦикла;

	Пока ВыборкаПараметров.Следующий() Цикл
		Если РежимЧтения = "Хранилище" Тогда
    		Результат[ВыборкаПараметров.Параметр] = ВыборкаПараметров.Значение.Получить();
		Иначе
			Результат[ВыборкаПараметров.Параметр] = ВыборкаПараметров.Значение;
		КонецЕсли;
	КонецЦикла;
		
	Возврат Результат;

КонецФункции //- ИнфоСофт Ивонин К.А. 02.04.24 УА #71892

//+ ИнфоСофт Ивонин К.А. 02.04.24 УА #71892
//
// Параметры:
//  Профиль			 - СправочникСсылка.ИС_WB_Профили - Профиль 
//  Маркетплейс		 - ПеречислениеСсылка.ИС_МП_Маркетплейсы - Маркетплейс 
//  МассивПараметров - Структура - Структура настроек, которые необходимо записать
//  РежимЧтения		 - Строка - Тип хранения значения: Значение, Строка, Хранилище
// 
// Возвращаемое значение:
//  Булеов - Результат успеха записи
//
Функция ЗаписатьЗначениеНастроек(Профиль, Маркетплейс, СтруктураПараметров, РежимЗаписи = "Значение") Экспорт
		
	Событие = ИмяСобытия("ЗаписатьЗначениеНастроек");
	
	ОбрабатываемаяСтруктура = ОбщегоНазначенияКлиентСервер.СкопироватьСтруктуру(СтруктураПараметров);
	
	Успех = Истина;
	
	МассивНаименований = Новый Массив;
	
	Для Каждого Элемент Из ОбрабатываемаяСтруктура Цикл
		МассивНаименований.Добавить(Элемент.Ключ);
	КонецЦикла;

	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ИС_MP_Настройки.Параметр КАК Параметр,
	|	ИС_MP_Настройки.Значение КАК Значение
	|ИЗ
	|	РегистрСведений.ИС_MP_Настройки КАК ИС_MP_Настройки
	|ГДЕ
	|	ИС_MP_Настройки.Профиль = &Профиль
	|	И ИС_MP_Настройки.Маркетплейс = &Маркетплейс
	|	И ИС_MP_Настройки.Параметр В(&МассивПараметров)";
	
	Запрос.УстановитьПараметр("Маркетплейс", Маркетплейс);
	Запрос.УстановитьПараметр("МассивПараметров", МассивНаименований);
	Запрос.УстановитьПараметр("Профиль", Профиль);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаПараметров = РезультатЗапроса.Выбрать();

	Пока ВыборкаПараметров.Следующий() Цикл

		МенеджерЗаписи = РегистрыСведений.ИС_MP_Настройки.СоздатьМенеджерЗаписи();
		МенеджерЗаписи.Профиль = Профиль;
		МенеджерЗаписи.Маркетплейс = Маркетплейс;
		МенеджерЗаписи.Параметр = ВыборкаПараметров.Параметр;
		
		Если РежимЗаписи = "Значение" Тогда
			МенеджерЗаписи.Значение = ОбрабатываемаяСтруктура[ВыборкаПараметров.Параметр];
		ИначеЕсли РежимЗаписи = "Строка" Тогда
			МенеджерЗаписи.Строка = ОбрабатываемаяСтруктура[ВыборкаПараметров.Параметр];
		ИначеЕсли РежимЗаписи = "Хранилище" Тогда
			МенеджерЗаписи.Хранилище = Новый ХранилищеЗначения(ОбрабатываемаяСтруктура[ВыборкаПараметров.Параметр]);
		Иначе 
			Возврат Ложь;
		КонецЕсли;
			
		Попытка
			МенеджерЗаписи.Записать(Истина);
		Исключение
			Текст = ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
		    ЗаписатьВЖРИСообщитьПользователю(Событие, Текст);
			Успех = Ложь;
		КонецПопытки;

		ОбрабатываемаяСтруктура.Удалить(ВыборкаПараметров.Параметр);
	
	КонецЦикла;	
	
	Для Каждого Элемент Из ОбрабатываемаяСтруктура Цикл
	
		МенеджерЗаписи = РегистрыСведений.ИС_MP_Настройки.СоздатьМенеджерЗаписи();
		МенеджерЗаписи.Профиль = Профиль;
		МенеджерЗаписи.Маркетплейс = Маркетплейс;
		МенеджерЗаписи.Параметр = Элемент.Ключ;
		Если РежимЗаписи = "Значение" Тогда
			МенеджерЗаписи.Значение = Элемент.Значение;
		ИначеЕсли РежимЗаписи = "Строка" Тогда
			МенеджерЗаписи.Строка = Элемент.Значение;
		ИначеЕсли РежимЗаписи = "Хранилище" Тогда
			МенеджерЗаписи.Хранилище = Новый ХранилищеЗначения(Элемент.Значение);
		Иначе
			Возврат Ложь;
		КонецЕсли; 
		
		Попытка
			МенеджерЗаписи.Записать();
		Исключение    
		   	Текст = ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
		    ЗаписатьВЖРИСообщитьПользователю(Событие, Текст);
			Успех = Ложь;
		КонецПопытки;
	
	КонецЦикла;
	
	Возврат Успех;

КонецФункции //- ИнфоСофт Ивонин К.А. 02.04.24 УА #71892

#КонецОбласти

//+ ИнфоСофт Ивонин К.А. 13.08.23 УА #61542
Процедура ЗаписатьДанныеОтладки(Профиль, Маркетплейс, ПараметрыЗапроса, РезультатЗапроса) Экспорт
		
	МенеджерЗаписи = РегистрыСведений.ИС_МП_ДанныеОтладки.СоздатьМенеджерЗаписи();
	МенеджерЗаписи.Период = ТекущаяДатаСеанса();
	МенеджерЗаписи.Профиль = Профиль;
	МенеджерЗаписи.Маркетплейс = Маркетплейс;
	
	ЧислоМиллисек = ТекущаяУниверсальнаяДатаВМиллисекундах() / 100000;
	МенеджерЗаписи.Разделитель = (ЧислоМиллисек - Цел(ЧислоМиллисек)) * 100000;

	ПортПоУмолчанию = ?(ПараметрыЗапроса.ЗащищенноеСоединение, ":443", ":80");
	
	Запрос = ?(ПараметрыЗапроса.ЗащищенноеСоединение, "https://", "http://") 
		+ ПараметрыЗапроса.Сервер 
		+ ?(ПараметрыЗапроса.Порт = 0, ПортПоУмолчанию, ":" + ПараметрыЗапроса.Порт)
		+ ПараметрыЗапроса.АдресРесурса;

	МенеджерЗаписи.Запрос = Запрос;
	МенеджерЗаписи.Метод = ПараметрыЗапроса.Метод;
	МенеджерЗаписи.ЗаголовкиЗапроса = ИС_МП_РаботаСHTTPЗапросами.ПолучитьСтрокуJSON(ПараметрыЗапроса.Заголовки); 

	Если ПараметрыЗапроса.ИмяФайлаТела <> Неопределено 
		И ТипЗнч(ПараметрыЗапроса.ИмяФайлаТела) = Тип("Строка")  Тогда

		ТелоЗапроса = СтрШаблон("Файл: %1", ПараметрыЗапроса.ИмяФайлаТела);	

	ИначеЕсли ПараметрыЗапроса.ТелоДвоичныеДанные <> Неопределено 
		И ТипЗнч(ПараметрыЗапроса.ТелоДвоичныеДанные) = Тип("ДвоичныеДанные") Тогда
		
		ТелоЗапроса = "ДвоичныеДанные";
		
	ИначеЕсли ПараметрыЗапроса.ТелоСтрока <> Неопределено 
		И ТипЗнч(ПараметрыЗапроса.ТелоСтрока) = Тип("Строка") Тогда
		
		ТелоЗапроса = ПараметрыЗапроса.ТелоСтрока;
	
	Иначе
		ТелоЗапроса = "Тело запроса отсутствует";
	КонецЕсли;  
		
	МенеджерЗаписи.ТелоЗапроса = ТелоЗапроса;
	МенеджерЗаписи.КодОтвета = РезультатЗапроса.КодОтвета;
		
	Если РезультатЗапроса.ЕстьОшибки Тогда	 
		МенеджерЗаписи.ТелоОтвета = ПодробноеПредставлениеОшибки(РезультатЗапроса.ИнформацияОбОшибке);
	Иначе    
	
		МенеджерЗаписи.ЗаголовкиОтвета = ИС_МП_РаботаСHTTPЗапросами.ПолучитьСтрокуJSON(РезультатЗапроса.Заголовки); 
		МенеджерЗаписи.ТелоОтвета = РезультатЗапроса.Ответ;
	
	КонецЕсли;	

	МенеджерЗаписи.Записать(Ложь);	

КонецПроцедуры //- ИнфоСофт Ивонин К.А. 13.08.23 УА #61542

