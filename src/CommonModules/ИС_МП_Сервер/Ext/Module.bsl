//+ ИнфоСофт Ивонин К.А. 24.01.23 УА #53535
Функция РазбитьМассивПоNЭлементов(Массив, N) Экспорт

	Результат = Новый Массив;
	
	Если Массив.Количество() < N Тогда
		Результат.Добавить(Массив);
		Возврат Результат;
	КонецЕсли;
	                                                            
	Счетчик = 1;
	ВременныйМассив = Новый Массив;
	
	Для Каждого Элемент Из Массив Цикл
	
		Если Счетчик = N Тогда
		
			Счетчик = 1;
			Результат.Добавить(ВременныйМассив);
			ВременныйМассив = Новый Массив;
			
		КонецЕсли;
		
		ВременныйМассив.Добавить(Элемент);
		
		Счетчик = Счетчик + 1;	
	
	КонецЦикла; 
	
	Если ВременныйМассив.Количество() > 0 Тогда
		Результат.Добавить(ВременныйМассив);
	КонецЕсли;
	
	Возврат Результат;

КонецФункции //- ИнфоСофт Ивонин К.А. 24.01.23 УА #53535

