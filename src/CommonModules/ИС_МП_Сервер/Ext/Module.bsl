//+ ИнфоСофт Ивонин К.А. 21.10.24 УА #68001
Функция ОбщийМодульМаркетплейса(Маркетплейс) Экспорт
	
	Если Маркетплейс = Перечисления.ИС_МП_Маркетплейсы.ВБ Или Маркетплейс = "ВБ" Тогда
		Возврат ОбщегоНазначения.ОбщийМодуль("ИС_ВБ_Сервер");	
	КонецЕсли;
	
	Если Маркетплейс = Перечисления.ИС_МП_Маркетплейсы.Озон Или Маркетплейс = "Озон" Тогда
		Возврат ОбщегоНазначения.ОбщийМодуль("ИС_Ozon_Сервер");
	КонецЕсли;
	
	Если Маркетплейс = Перечисления.ИС_МП_Маркетплейсы.ЯМ Или Маркетплейс = "ЯМ" Тогда
		Возврат ОбщегоНазначения.ОбщийМодуль("ИС_ЯМ_Сервер");
	КонецЕсли;
	
	Если Маркетплейс = Перечисления.ИС_МП_Маркетплейсы.Сбер Или Маркетплейс = "Сбер" Тогда
		Возврат ОбщегоНазначения.ОбщийМодуль("ИС_Сбер_Сервер");
	КонецЕсли;
	
	Если Маркетплейс = Перечисления.ИС_МП_Маркетплейсы.Али Или Маркетплейс = "Али" Тогда
		Возврат ОбщегоНазначения.ОбщийМодуль("ИС_АЛИ_Сервер");
	КонецЕсли;
	
	Если Маркетплейс = Перечисления.ИС_МП_Маркетплейсы.МВМ Или Маркетплейс = "МВМ" Тогда
		Возврат ОбщегоНазначения.ОбщийМодуль("ИС_МВМ_Сервер");	
	КонецЕсли;
	
	//+ ИнфоСофт Власова И.С. 23.12.24 УА #90120
	Если Маркетплейс = Перечисления.ИС_МП_Маркетплейсы.Ламода Или Маркетплейс = "Ламода" Тогда
		Возврат ОбщегоНазначения.ОбщийМодуль("ИС_Ламода_Сервер");	
	КонецЕсли;
	//- ИнфоСофт Власова И.С. 23.12.24 УА #90120
		
	ВызватьИсключение("Неизвестный тип маркетплейса");
	
КонецФункции //- ИнфоСофт Ивонин К.А. 21.10.24 УА #68001

