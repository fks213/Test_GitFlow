//+ ИнфоСофт Мурсалимов Д.Р. 28.02.24 УА #67173
Процедура СоздатьЗаказНаСборкуКомплектов(Маркетплейс, ЗаказКлиента, Склад, Элемент) Экспорт
	
	Событие = ПолучитьИмяСобытия("СоздатьЗаказНаСборкуКомплектов");
	
	ЗаказНаСборку = Документы.ЗаказНаСборку.СоздатьДокумент(); 
	ЗаказНаСборку.Комментарий = ЗаказКлиента.Комментарий; 
	ЗаказНаСборку.Дата = ЗаказКлиента.Дата;
	ЗаказНаСборку.Подразделение = ЗаказКлиента.Подразделение; 
	
	//+ ИнфоСофт Заварин К.В. 22.11.24 УА #79380
	//+ ИнфоСофт Стояк Ю.К. 02.11.2024 УА #86689	
	//МассивСтрок = Новый Массив; 
	//Для Каждого Строка Из ЗаказКлиента.Товары Цикл 
	//	Если Строка.НомерСтроки = Элемент.НомерСтроки Тогда
	//		МассивСтрок.Добавить(Строка); 
	//	КонецЕсли;
	//КонецЦикла; 
	//ТЗ = ЗаказКлиента.Товары.Выгрузить(МассивСтрок); 	
	//- ИнфоСофт Стояк Ю.К. 02.11.2024 УА #86689
	//- ИнфоСофт Заварин К.В. 22.11.24 УА #79380
	
	СтруктураДанных = Новый Структура;          
	
	//+ ИнфоСофт Заварин К.В. 22.11.24 УА #79380
	
	//+ ИнфоСофт Стояк Ю.К. 02.11.2024 УА #86689
	//СтруктураДанных.Вставить("АдресТовары", ПоместитьВоВременноеХранилище(ЗаказКлиента.Товары.Выгрузить(), Новый УникальныйИдентификатор)); 
	//СтруктураДанных = Новый Структура; СтруктураДанных.Вставить("АдресТовары", ПоместитьВоВременноеХранилище(ТЗ, Новый УникальныйИдентификатор));
	//- ИнфоСофт Стояк Ю.К. 02.11.2024 УА #86689
	
	МассивСтрок = Новый Массив;
	МассивСтрок.Добавить(ЗаказКлиента.Товары[Элемент.НомерСтроки - 1]);	
	
	СтруктураДанных.Вставить("АдресТовары", ПоместитьВоВременноеХранилище(ЗаказКлиента.Товары.Выгрузить(МассивСтрок), Новый УникальныйИдентификатор));
	//- ИнфоСофт Заварин К.В. 22.11.24 УА #79380
	
	СтруктураДанных.Вставить("Основание", ЗаказКлиента.Ссылка);
	СтруктураДанных.Вставить("Склад", ЗаказКлиента.Склад);
	
	ЗаказНаСборку.Заполнить(СтруктураДанных);
	
	ЗаказНаСборку.Организация = ЗаказКлиента.Организация;
	
	ЗаказНаСборку.Статус = Перечисления.СтатусыВнутреннихЗаказов.КВыполнению;  
	
	ЗаказНаСборку.ДокументОснование = ЗаказКлиента.Ссылка;
	
	ЗаказНаСборку.Подразделение = ЗаказКлиента.Подразделение;
	
	ЗаказНаСборку.НачалоСборкиРазборки = ЗаказКлиента.Дата;
	ЗаказНаСборку.ОкончаниеСборкиРазборки = ЗаказКлиента.Дата; 
	
	ОбеспечиватьОбособленно = ЗаказКлиента.Соглашение.ОбеспечиватьЗаказыОбособленно;
	//+ ИнфоСофт Сумин Д.В. 10.04.2024 УА #74033
	Если Маркетплейс = Перечисления.ИС_МП_Маркетплейсы.ВБ Или Маркетплейс = Перечисления.ИС_МП_Маркетплейсы.Озон Или Маркетплейс = Перечисления.ИС_МП_Маркетплейсы.ЯМ Тогда 
		НаправленияДеятельностиИспользуются = Склад.НаправленияДеятельности.Количество() > 0;	
	Иначе
		НаправленияДеятельностиИспользуются = Ложь;	
	КонецЕсли;	
	//НаправленияДеятельностиИспользуются = Склад.НаправленияДеятельности.Количество() > 0;
	//НаправленияДеятельностиИспользуются = Ложь;
	//- ИнфоСофт Сумин Д.В. 10.04.2024 УА #74033
	Если ОбеспечиватьОбособленно И НаправленияДеятельностиИспользуются Тогда
		
		ЗаказНаСборку.НаправлениеДеятельности = ЗаказКлиента.Договор.НаправлениеДеятельности;
		
		ЗаказНаСборку.Назначение = Справочники.Назначения.НайтиПоРеквизиту("НаправлениеДеятельности", ЗаказКлиента.Договор.НаправлениеДеятельности);

	КонецЕсли;	
	
	Для Каждого Элемент Из ЗаказНаСборку.Товары Цикл
		
		Элемент.ВариантОбеспечения = Перечисления.ВариантыОбеспечения.Отгрузить;
		
		Если ОбеспечиватьОбособленно И НаправленияДеятельностиИспользуются Тогда
			
			Элемент.Обособленно = Истина;		
			
		КонецЕсли;
		
	КонецЦикла;
	
	//Если используется обособление, то сначала выполняется попытка проведения с обособлением товара. При неудаче выполняется поптыка проведения без обособления. 
	Попытка
		
		ЗаказНаСборку.Записать(РежимЗаписиДокумента.Проведение);
		
	Исключение 
		
		Если ОбеспечиватьОбособленно И НаправленияДеятельностиИспользуются Тогда	
			
			Попытка
				
				Для Каждого Элемент Из ЗаказНаСборку.Товары Цикл
					
					Элемент.Обособленно = Ложь;
					
				КонецЦикла;	
				
				ЗаказНаСборку.Записать(РежимЗаписиДокумента.Проведение);
				
			Исключение
				
				ЗаказНаСборку.Статус = Перечисления.ВариантыОбеспечения.КОбеспечению;
				
				Для Каждого Элемент Из ЗаказНаСборку.Товары Цикл
					
					Элемент.ВариантОбеспечения = Перечисления.ВариантыОбеспечения.КОбеспечению;
					Элемент.Обособленно = Ложь;	
					
				КонецЦикла; 
				
				
				Текст = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
				ИС_MP_Сервер.ЗаписатьВЖРИСообщитьПользователю(Событие, Текст);
				
				ЗаказНаСборку.Записать();
				
			КонецПопытки;
			
		Иначе
			
			ЗаказНаСборку.Статус = Перечисления.ВариантыОбеспечения.КОбеспечению;
			
			Для Каждого Элемент Из ЗаказНаСборку.Товары Цикл
				
				Элемент.ВариантОбеспечения = Перечисления.ВариантыОбеспечения.КОбеспечению;
				Элемент.Обособленно = Ложь;	
				
			КонецЦикла;  
			
			Текст = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
			ИС_MP_Сервер.ЗаписатьВЖРИСообщитьПользователю(Событие, Текст);
			
			ЗаказНаСборку.Записать(); 
			
		КонецЕсли;
		
	КонецПопытки;
	
КонецПроцедуры //- ИнфоСофт Мурсалимов Д.Р. 28.02.24 УА #67173

