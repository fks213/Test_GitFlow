//+ ИнфоСофт Заварин К.В. 13.11.24 УА #85881
Процедура ПометитьНаУдалениеПривязанныеДокументы(Заказ) Экспорт
	
	Событие = "ИС_MP_РаботаСЗаказами.ОтменитьОтборИРасходныйОрдер";
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	РасходныйОрдерНаТовары.Ссылка КАК РасходныйОрдер,
	|	ОтборРазмещениеТоваров.Ссылка КАК Отбор,
	|	СвязанныеДокументы.Ссылка КАК Ссылка
	|ПОМЕСТИТЬ ВТ_ОтборИРО
	|ИЗ
	|	КритерийОтбора.СвязанныеДокументы(&Заказ) КАК СвязанныеДокументы
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.РасходныйОрдерНаТовары КАК РасходныйОрдерНаТовары
	|		ПО (СвязанныеДокументы.Ссылка = РасходныйОрдерНаТовары.Ссылка)
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ОтборРазмещениеТоваров КАК ОтборРазмещениеТоваров
	|		ПО (РасходныйОрдерНаТовары.Ссылка = ОтборРазмещениеТоваров.Распоряжение)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	РеализацияТоваровУслуг.ЗаказКлиента.Ссылка КАК Ссылка,
	|	РеализацияТоваровУслуг.Ссылка КАК реализация
	|ПОМЕСТИТЬ ВТ_Реализации
	|ИЗ
	|	Документ.ЗаказКлиента КАК ИС_WB_СборочноеЗадание
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.РеализацияТоваровУслуг КАК РеализацияТоваровУслуг
	|		ПО (РеализацияТоваровУслуг.ЗаказКлиента.Ссылка = РеализацияТоваровУслуг.ЗаказКлиента)
	|			И (НЕ РеализацияТоваровУслуг.ЗаказКлиента.Ссылка = ЗНАЧЕНИЕ(Документ.ЗаказКлиента.ПустаяСсылка))
	|ГДЕ
	|	РеализацияТоваровУслуг.ЗаказКлиента.Ссылка = &Заказ
	|	И НЕ РеализацияТоваровУслуг.Ссылка ЕСТЬ NULL
	|
	|ОБЪЕДИНИТЬ
	|
	|ВЫБРАТЬ
	|	РеализацияТоваровУслугТовары.ЗаказКлиента.Ссылка,
	|	РеализацияТоваровУслугТовары.Ссылка
	|ИЗ
	|	Документ.ЗаказКлиента КАК ИС_WB_СборочноеЗадание
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.РеализацияТоваровУслуг.Товары КАК РеализацияТоваровУслугТовары
	|		ПО (РеализацияТоваровУслугТовары.ЗаказКлиента.Ссылка = РеализацияТоваровУслугТовары.ЗаказКлиента)
	|			И (НЕ РеализацияТоваровУслугТовары.ЗаказКлиента.Ссылка = ЗНАЧЕНИЕ(Документ.ЗаказКлиента.ПустаяСсылка))
	|ГДЕ
	|	РеализацияТоваровУслугТовары.ЗаказКлиента.Ссылка = &Заказ
	|	И НЕ РеализацияТоваровУслугТовары.Ссылка ЕСТЬ NULL
	|
	|ОБЪЕДИНИТЬ
	|
	|ВЫБРАТЬ
	|	ПередачаТоваровХранителю.ЗаказКлиента.Ссылка,
	|	ПередачаТоваровХранителю.Ссылка
	|ИЗ
	|	Документ.ЗаказКлиента КАК ИС_WB_СборочноеЗадание
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ПередачаТоваровХранителю КАК ПередачаТоваровХранителю
	|		ПО (ПередачаТоваровХранителю.ЗаказКлиента.Ссылка = ПередачаТоваровХранителю.ЗаказКлиента)
	|			И (НЕ ПередачаТоваровХранителю.ЗаказКлиента.Ссылка = ЗНАЧЕНИЕ(Документ.ЗаказКлиента.ПустаяСсылка))
	|ГДЕ
	|	ПередачаТоваровХранителю.ЗаказКлиента.Ссылка = &Заказ
	|	И НЕ ПередачаТоваровХранителю.Ссылка ЕСТЬ NULL
	|
	|ОБЪЕДИНИТЬ
	|
	|ВЫБРАТЬ
	|	ПередачаТоваровХранителюТовары.ЗаказКлиента.Ссылка,
	|	ПередачаТоваровХранителюТовары.Ссылка
	|ИЗ
	|	Документ.ЗаказКлиента КАК ИС_WB_СборочноеЗадание
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ПередачаТоваровХранителю.Товары КАК ПередачаТоваровХранителюТовары
	|		ПО (ПередачаТоваровХранителюТовары.ЗаказКлиента.Ссылка = ПередачаТоваровХранителюТовары.ЗаказКлиента)
	|			И (НЕ ПередачаТоваровХранителюТовары.ЗаказКлиента.Ссылка = ЗНАЧЕНИЕ(Документ.ЗаказКлиента.ПустаяСсылка))
	|ГДЕ
	|	ПередачаТоваровХранителюТовары.ЗаказКлиента.Ссылка = &Заказ
	|	И НЕ ПередачаТоваровХранителюТовары.Ссылка ЕСТЬ NULL
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_Реализации.Ссылка КАК Ссылка,
	|	МАКСИМУМ(ВТ_Реализации.реализация) КАК Реализация,
	|	СУММА(1) КАК Количество
	|ПОМЕСТИТЬ ВТ_КоличествоРеализаций
	|ИЗ
	|	ВТ_Реализации КАК ВТ_Реализации
	|
	|СГРУППИРОВАТЬ ПО
	|	ВТ_Реализации.Ссылка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ ПЕРВЫЕ 1
	|	ВТ_КоличествоРеализаций.Ссылка КАК Заказ,
	|	ВТ_КоличествоРеализаций.Реализация КАК Реализация,
	|	ВТ_ОтборИРО.РасходныйОрдер КАК РасходныйОрдер,
	|	ВТ_ОтборИРО.Отбор КАК Отбор
	|ИЗ
	|	ВТ_ОтборИРО КАК ВТ_ОтборИРО,
	|	ВТ_КоличествоРеализаций КАК ВТ_КоличествоРеализаций";
	
	Запрос.УстановитьПараметр("Заказ", Заказ);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		
		Если ЗначениеЗаполнено(ВыборкаДетальныеЗаписи.Отбор)  Тогда 
			
			Отбор = ВыборкаДетальныеЗаписи.Отбор.ПолучитьОбъект();	
			
			Попытка	
				Отбор.Записать(РежимЗаписиДокумента.ОтменаПроведения);
			Исключение 
				
				Текст = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
				ИС_MP_Сервер.ЗаписатьВЖРИСообщитьПользователю(Событие, Текст);
				Возврат;
				
			КонецПопытки;
			
			Отбор.ПометкаУдаления = Истина; 			
			
			Попытка	
				Отбор.Записать();
			Исключение 
				
				Текст = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
				ИС_MP_Сервер.ЗаписатьВЖРИСообщитьПользователю(Событие, Текст);
				Возврат;
				
			КонецПопытки; 
			
		КонецЕсли;
		
		Если ЗначениеЗаполнено(ВыборкаДетальныеЗаписи.РасходныйОрдер)  Тогда 
			
			РасходныйОрдер = ВыборкаДетальныеЗаписи.РасходныйОрдер.ПолучитьОбъект();	
			
			Попытка	
				РасходныйОрдер.Записать(РежимЗаписиДокумента.ОтменаПроведения);
			Исключение 
				
				Текст = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
				ИС_MP_Сервер.ЗаписатьВЖРИСообщитьПользователю(Событие, Текст);
				Возврат;
				
			КонецПопытки;
			
			РасходныйОрдер.ПометкаУдаления = Истина; 			
			
			Попытка	
				РасходныйОрдер.Записать();
			Исключение 
				
				Текст = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
				ИС_MP_Сервер.ЗаписатьВЖРИСообщитьПользователю(Событие, Текст);
				Возврат;
				
			КонецПопытки; 
			
		КонецЕсли;
		
		Если ЗначениеЗаполнено(ВыборкаДетальныеЗаписи.Реализация)  Тогда 
			
			Реализация = ВыборкаДетальныеЗаписи.Реализация.ПолучитьОбъект();	
			
			Попытка	
				Реализация.Записать(РежимЗаписиДокумента.ОтменаПроведения);
			Исключение 
				
				Текст = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
				ИС_MP_Сервер.ЗаписатьВЖРИСообщитьПользователю(Событие, Текст);
				Возврат;
				
			КонецПопытки;
			
			Реализация.ПометкаУдаления = Истина; 			
			
			Попытка	
				Реализация.Записать();
			Исключение 
				
				Текст = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
				ИС_MP_Сервер.ЗаписатьВЖРИСообщитьПользователю(Событие, Текст);
				Возврат;
				
			КонецПопытки; 
			
		КонецЕсли;
		
	КонецЦикла;  
	
	Если ЗначениеЗаполнено(Заказ)  Тогда 
			
			ЗаказОсновной = Заказ.ПолучитьОбъект();	
			
			Попытка
				ЗаказОсновной.Заблокировать();    
			Исключение   
				
				ИС_MP_Сервер.ЗаписатьВЖРИСообщитьПользователю("Отмена заказа", "Заказ " + ЗаказОсновной.Ссылка + " заблокирован для изменения данных");     
				
			КонецПопытки;
			
			Попытка	
				ЗаказОсновной.Записать(РежимЗаписиДокумента.ОтменаПроведения);
			Исключение 
				
				Текст = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
				ИС_MP_Сервер.ЗаписатьВЖРИСообщитьПользователю(Событие, Текст);
				
			КонецПопытки;
			
			ЗаказОсновной.ПометкаУдаления = Истина; 			
			
			Попытка	
				ЗаказОсновной.Записать();
			Исключение 
				
				Текст = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
				ИС_MP_Сервер.ЗаписатьВЖРИСообщитьПользователю(Событие, Текст);
				
			КонецПопытки; 
			
		КонецЕсли;
	
	
	КонецПроцедуры //- ИнфоСофт Заварин К.В. 13.11.24 УА #85881 

//+ ИнфоСофт Заварин К.В. 17.02.25 УА #83515
Функция ПолучитьРеализацииПоЗаказуМП(Профиль, Маркетплейс, ЗаказыМП = Неопределено) Экспорт
	
	МассивРеализаций = Новый Массив;
	
	Если ЗаказыМП = Неопределено Тогда
		Возврат	МассивРеализаций;		
	КонецЕсли;
	
	Если Маркетплейс = Перечисления.ИС_МП_Маркетплейсы.ВБ Тогда
		
		Запрос = Новый Запрос;
		Запрос.Текст =	
		"ВЫБРАТЬ
		|	ИС_WB_СборочноеЗадание.Ссылка КАК Ссылка,
		|	ПередачаТоваровХранителю.Ссылка КАК Реализация
		|ПОМЕСТИТЬ ВТ_Реализации
		|ИЗ
		|	Документ.ИС_WB_СборочноеЗадание КАК ИС_WB_СборочноеЗадание
		|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ПередачаТоваровХранителю КАК ПередачаТоваровХранителю
		|		ПО (ИС_WB_СборочноеЗадание.Заказ = ПередачаТоваровХранителю.ЗаказКлиента)
		|			И (НЕ ИС_WB_СборочноеЗадание.Заказ = ЗНАЧЕНИЕ(Документ.ЗаказКлиента.ПустаяСсылка))
		|ГДЕ
		|	ИС_WB_СборочноеЗадание.Профиль = &Профиль
		|	И ИС_WB_СборочноеЗадание.Ссылка В(&МассивСсылок)
		|	И НЕ ИС_WB_СборочноеЗадание.Заказ = ЗНАЧЕНИЕ(Документ.ЗаказКлиента.ПустаяСсылка)
		|	И НЕ ПередачаТоваровХранителю.Ссылка ЕСТЬ NULL
		|
		|ОБЪЕДИНИТЬ
		|
		|ВЫБРАТЬ
		|	ИС_WB_СборочноеЗадание.Ссылка,
		|	ПередачаТоваровХранителюТовары.Ссылка
		|ИЗ
		|	Документ.ИС_WB_СборочноеЗадание КАК ИС_WB_СборочноеЗадание
		|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ПередачаТоваровХранителю.Товары КАК ПередачаТоваровХранителюТовары
		|		ПО ИС_WB_СборочноеЗадание.Заказ = ПередачаТоваровХранителюТовары.ЗаказКлиента
		|			И (НЕ ИС_WB_СборочноеЗадание.Заказ = ЗНАЧЕНИЕ(Документ.ЗаказКлиента.ПустаяСсылка))
		|ГДЕ
		|	ИС_WB_СборочноеЗадание.Профиль = &Профиль
		|	И ИС_WB_СборочноеЗадание.Ссылка В(&МассивСсылок)
		|	И НЕ ИС_WB_СборочноеЗадание.Заказ = ЗНАЧЕНИЕ(Документ.ЗаказКлиента.ПустаяСсылка)
		|	И НЕ ПередачаТоваровХранителюТовары.Ссылка ЕСТЬ NULL
		|
		|ОБЪЕДИНИТЬ
		|
		|ВЫБРАТЬ
		|	ИС_WB_СборочноеЗадание.Ссылка,
		|	РеализацияТоваровУслуг.Ссылка
		|ИЗ
		|	Документ.ИС_WB_СборочноеЗадание КАК ИС_WB_СборочноеЗадание
		|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.РеализацияТоваровУслуг КАК РеализацияТоваровУслуг
		|		ПО ИС_WB_СборочноеЗадание.Заказ = РеализацияТоваровУслуг.ЗаказКлиента
		|			И (НЕ ИС_WB_СборочноеЗадание.Заказ = ЗНАЧЕНИЕ(Документ.ЗаказКлиента.ПустаяСсылка))
		|ГДЕ
		|	ИС_WB_СборочноеЗадание.Профиль = &Профиль
		|	И ИС_WB_СборочноеЗадание.Ссылка В(&МассивСсылок)
		|	И НЕ ИС_WB_СборочноеЗадание.Заказ = ЗНАЧЕНИЕ(Документ.ЗаказКлиента.ПустаяСсылка)
		|	И НЕ РеализацияТоваровУслуг.Ссылка ЕСТЬ NULL
		|
		|ОБЪЕДИНИТЬ
		|
		|ВЫБРАТЬ
		|	ИС_WB_СборочноеЗадание.Ссылка,
		|	РеализацияТоваровУслугТовары.Ссылка
		|ИЗ
		|	Документ.ИС_WB_СборочноеЗадание КАК ИС_WB_СборочноеЗадание
		|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.РеализацияТоваровУслуг.Товары КАК РеализацияТоваровУслугТовары
		|		ПО ИС_WB_СборочноеЗадание.Заказ = РеализацияТоваровУслугТовары.ЗаказКлиента
		|			И (НЕ ИС_WB_СборочноеЗадание.Заказ = ЗНАЧЕНИЕ(Документ.ЗаказКлиента.ПустаяСсылка))
		|ГДЕ
		|	ИС_WB_СборочноеЗадание.Профиль = &Профиль
		|	И ИС_WB_СборочноеЗадание.Ссылка В(&МассивСсылок)
		|	И НЕ ИС_WB_СборочноеЗадание.Заказ = ЗНАЧЕНИЕ(Документ.ЗаказКлиента.ПустаяСсылка)
		|	И НЕ РеализацияТоваровУслугТовары.Ссылка ЕСТЬ NULL
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ДокументИС_WB_СборочноеЗадание.Ссылка КАК Ссылка,
		|	ДокументИС_WB_СборочноеЗадание.ПометкаУдаления КАК ПометкаУдаления,
		|	ДокументИС_WB_СборочноеЗадание.Заказ КАК Заказ1С,
		|	ВТ_Реализации.Реализация КАК РТУ,
		|	ИС_WB_СоответствиеРазмеров.Номенклатура КАК Номенклатура,
		|	ИС_WB_СоответствиеРазмеров.Характеристика КАК Характеристика,
		|	ИС_WB_СоответствиеРазмеров.Упаковка КАК Упаковка
		|ИЗ
		|	Документ.ИС_WB_СборочноеЗадание КАК ДокументИС_WB_СборочноеЗадание
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ИС_WB_СоответствиеРазмеров КАК ИС_WB_СоответствиеРазмеров
		|		ПО (ИС_WB_СоответствиеРазмеров.РазмерWB = ДокументИС_WB_СборочноеЗадание.РазмерWB)
		|			И (ИС_WB_СоответствиеРазмеров.Профиль = &Профиль)
		|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_Реализации КАК ВТ_Реализации
		|		ПО ДокументИС_WB_СборочноеЗадание.Ссылка = ВТ_Реализации.Ссылка
		|ГДЕ
		|	ДокументИС_WB_СборочноеЗадание.Профиль = &Профиль
		|	И ДокументИС_WB_СборочноеЗадание.Ссылка В(&МассивСсылок)
		|	И ВТ_Реализации.Реализация.ПометкаУдаления = ЛОЖЬ";
		
		Запрос.УстановитьПараметр("МассивСсылок", ЗаказыМП);
		Запрос.УстановитьПараметр("Профиль", Профиль);
		
		
		Выборка = Запрос.Выполнить().Выбрать();
		
		Пока Выборка.Следующий() Цикл
			
			Если ЗначениеЗаполнено(Выборка.РТУ) Тогда
				МассивРеализаций.Добавить(Выборка.РТУ);	
			КонецЕсли;		
			
		КонецЦикла;
		
		Возврат	МассивРеализаций;
		
	КонецЕсли;
	
КонецФункции //- ИнфоСофт Заварин К.В. 17.02.25 УА #83515	
	
#КонецОбласти
