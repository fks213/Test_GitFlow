
#Область СлужебныйПрограммныйИнтерфейс

//+ ИнфоСофт Ивонин К.А. 13.11.23 УА #55166
//+ ИнфоСофт Стояк Ю.К. 18.11.2024 УА #74083
Функция СоздатьИлиДополнитьЗаказ(Шапка, Товары, ФукнциональныеОпции, Маркетплейс, Заказ = Неопределено, Назначения = Неопределено) Экспорт
//Функция СоздатьИлиДополнитьЗаказ(Шапка, Товары, ФукнциональныеОпции, Маркетплейс, Заказ = Неопределено) Экспорт
//- ИнфоСофт Стояк Ю.К. 18.11.2024 УА #74083
	
	Событие = ПолучитьИмяСобытия("СоздатьИлиДополнитьЗаказ");
	
	Если Заказ = Неопределено Или Заказ.Пустая() Тогда
		НовыйДокумент = Документы.ЗаказКлиента.СоздатьДокумент();
	Иначе
		НовыйДокумент = Заказ.ПолучитьОбъект();
	КонецЕсли;
	
	ГруппаСкладов = Шапка.ОбщаяГруппаСкладов;	
	Организация = ФукнциональныеОпции.Организация; 
	Партнер = ФукнциональныеОпции.Партнер; 
	Соглашение = ФукнциональныеОпции.Соглашение;
	Контрагент = ФукнциональныеОпции.Контрагент;
	Договор = ФукнциональныеОпции.Договор;
	
	ПродажаОблагаетсяНДС = ПолучитьПрименениеНДСОрганизации(Организация);
	
	Если ПродажаОблагаетсяНДС = Неопределено Тогда
	    ВызватьИсключение("Не заполнена учетная политика организации");
	КонецЕсли; 
	
	Если Заказ = Неопределено Тогда				
	    
	    Если ФукнциональныеОпции.РежимСозданияЗаказов = 2 Тогда
			НовыйДокумент.Дата = ТекущаяДатаСеанса();
		Иначе
			НовыйДокумент.Дата = Шапка.Дата;
		КонецЕсли;

		НовыйДокумент.Организация = Организация;
		НовыйДокумент.Подразделение = ФукнциональныеОпции.Подразделение; 
		
		НовыйДокумент.Партнер = Партнер;
		НовыйДокумент.Контрагент = Контрагент;      
		
		НовыйДокумент.НеОтгружатьЧастями = Ложь;
		
		ИспользоватьСоглашенияСКлиентами = ПолучитьФункциональнуюОпцию("ИспользоватьСоглашенияСКлиентами");
		
		Если ИспользоватьСоглашенияСКлиентами Тогда
			НовыйДокумент.ПорядокРасчетов = Соглашение.ПорядокРасчетов;
			НовыйДокумент.Менеджер = Соглашение.Менеджер;
			//+ ИнфоСофт Стояк Ю.К. 27.11.2024 УА #87103
			Если ЗначениеЗаполнено(Соглашение.НаправлениеДеятельности) Тогда
				НовыйДокумент.НаправлениеДеятельности 			= Соглашение.НаправлениеДеятельности;            
			КонецЕсли;
			//- ИнфоСофт Стояк Ю.К. 27.11.2024 УА #87103
		Иначе
			НовыйДокумент.Менеджер = Договор.Менеджер;
			//+ ИнфоСофт Стояк Ю.К. 27.11.2024 УА #87103
			Если ЗначениеЗаполнено(Договор.НаправлениеДеятельности) Тогда
				НовыйДокумент.НаправлениеДеятельности 			= Договор.НаправлениеДеятельности;            
			КонецЕсли;
			//- ИнфоСофт Стояк Ю.К. 27.11.2024 УА #87103
		КонецЕсли;
		
		НовыйДокумент.Договор = Договор;
		НовыйДокумент.Соглашение = Соглашение;
					
		НовыйДокумент.Статус = ФукнциональныеОпции.СтатусЗаказаКлиента; 
		НовыйДокумент.Приоритет = ФукнциональныеОпции.ПриоритетЗаказа;
	     
	    НовыйДокумент.ЦенаВключаетНДС = Соглашение.ЦенаВключаетНДС;
		
		Если ЗначениеЗаполнено(Соглашение.Валюта) Тогда
			НовыйДокумент.Валюта = Соглашение.Валюта;
		ИначеЕсли ЗначениеЗаполнено(Договор.ВалютаВзаиморасчетов) Тогда
			НовыйДокумент.Валюта = Договор.ВалютаВзаиморасчетов;
		Иначе
			НовыйДокумент.Валюта = Справочники.Валюты.НайтиПоКоду("643");
		КонецЕсли;		

		Если ЗначениеЗаполнено(Договор) Тогда
			НовыйДокумент.ХозяйственнаяОперация = Договор.ХозяйственнаяОперация; 
		ИначеЕсли ЗначениеЗаполнено(Соглашение) Тогда                                                                       
			НовыйДокумент.ХозяйственнаяОперация = Соглашение.ХозяйственнаяОперация; 
		КонецЕсли;
		
		//+ ИнфоСофт Заварин К.В. 05.12.24 УА #79415 
		Если ЗначениеЗаполнено(Соглашение) И Не Соглашение.ИспользуютсяДоговорыКонтрагентов Тогда 
			
			Если ЗначениеЗаполнено(Соглашение.ГруппаФинансовогоУчета) Тогда
				НовыйДокумент.ГруппаФинансовогоУчета 			= Соглашение.ГруппаФинансовогоУчета;            
			КонецЕсли;
			Если ЗначениеЗаполнено(Соглашение.НаправлениеДеятельности) Тогда
				НовыйДокумент.НаправлениеДеятельности 			= Соглашение.НаправлениеДеятельности;            
			КонецЕсли;
			
		ИначеЕсли ЗначениеЗаполнено(Договор) Тогда 
			
			Если ЗначениеЗаполнено(Договор.ГруппаФинансовогоУчета) Тогда
				НовыйДокумент.ГруппаФинансовогоУчета 			= Договор.ГруппаФинансовогоУчета;            
			КонецЕсли;
			Если ЗначениеЗаполнено(Договор.НаправлениеДеятельности) Тогда
				НовыйДокумент.НаправлениеДеятельности 			= Договор.НаправлениеДеятельности;            
			КонецЕсли;
			
		КонецЕсли;
		//- ИнфоСофт Заварин К.В. 05.12.24 УА #79415
		
		Если ФукнциональныеОпции.РежимСозданияЗаказов = 0 Тогда
			НовыйДокумент.Комментарий = "Создан на основание заказа " + Маркетплейс + "а "; 
		Иначе
			НовыйДокумент.Комментарий = "Создан на основание заказов " + Маркетплейс + "а ";
		КонецЕсли;
	    
		Если ПродажаОблагаетсяНДС Тогда
			НовыйДокумент.НалогообложениеНДС = Перечисления.ТипыНалогообложенияНДС.ПродажаОблагаетсяНДС;			
		Иначе
			НовыйДокумент.НалогообложениеНДС = Перечисления.ТипыНалогообложенияНДС.ПродажаНеОблагаетсяНДС;			
		КонецЕсли;
		
		Если ЗначениеЗаполнено(Шапка.СпособДоставки) Тогда
			НовыйДокумент.СпособДоставки = Шапка.СпособДоставки; 
		Иначе
			НовыйДокумент.СпособДоставки = Перечисления.СпособыДоставки.Самовывоз;	
		КонецЕсли;
		
		НовыйДокумент.ЗонаДоставки = Шапка.ЗонаДоставки;
		
		Если ЗначениеЗаполнено(Шапка.АдресДоставки) Тогда
			НовыйДокумент.АдресДоставки = Шапка.АдресДоставки;
			НовыйДокумент.АдресДоставкиЗначение = Шапка.АдресДоставкиЗначение;
			НовыйДокумент.АдресДоставкиЗначенияПолей = Шапка.АдресДоставкиЗначенияПолей;
		КонецЕсли;                
		
		Если ПолучитьФункциональнуюОпцию("ИспользоватьАвтоматическиеСкидкиВПродажах") Тогда
			НовыйДокумент.СкидкиРассчитаны = Истина;
		КонецЕсли;    
		
		НовыйДокумент.Грузополучатель = Шапка.Грузополучатель;
		НовыйДокумент.Грузоотправитель = Шапка.Грузоотправитель;
		НовыйДокумент.ПеревозчикПартнер = Шапка.ПеревозчикПартнер;
		
		Если ИспользоватьСоглашенияСКлиентами И ЗначениеЗаполнено(Соглашение) Тогда 
			НовыйДокумент.ЗаполнитьУсловияПродажПоСоглашению();	
		КонецЕсли;
		
		//+ ИнфоСофт Заварин К.В. 09.01.25 УА #90561
		Если ПродажаОблагаетсяНДС Тогда
			НовыйДокумент.НалогообложениеНДС = Перечисления.ТипыНалогообложенияНДС.ПродажаОблагаетсяНДС;			
		Иначе
			НовыйДокумент.НалогообложениеНДС = Перечисления.ТипыНалогообложенияНДС.ПродажаНеОблагаетсяНДС;			
		КонецЕсли;
		//- ИнфоСофт Заварин К.В. 09.01.25 УА #90561
		
	КонецЕсли;	
	
	//+ ИнфоСофт Заварин К.В. 05.12.24 УА #88585
	Отбор = Новый Структура;
	
	Отбор.Вставить("Дата", НовыйДокумент.Дата);
	Отбор.Вставить("Организация", Организация);
	ТЗОтветственныеЛицаОрг = ОтветственныеЛицаСервер.ПолучитьТаблицуОтветственныхЛицПоОтбору(Отбор);
	
	НовыйДокумент.Руководитель = "";
	НовыйДокумент.ГлавныйБухгалтер = "";
	
	Для Каждого Результат Из ТЗОтветственныеЛицаОрг Цикл
		
		Если Строка(Результат.ОтветственноеЛицо) = "Руководитель" Тогда
			НовыйДокумент.Руководитель = Результат.Ссылка;
		ИначеЕсли Строка(Результат.ОтветственноеЛицо) = "Главный бухгалтер" Тогда
			НовыйДокумент.ГлавныйБухгалтер = Результат.Ссылка;
		КонецЕсли;		
	КонецЦикла;
    //- ИнфоСофт Заварин К.В. 05.12.24 УА #88585
	
	//+ ИнфоСофт Заварин К.В. 12.12.24 УА #89604
	Если ЗначениеЗаполнено(Договор) Тогда
		НовыйДокумент.БанковскийСчет = "";
		НовыйДокумент.БанковскийСчет = Договор.БанковскийСчет;		
	КонецЕсли;
	//- ИнфоСофт Заварин К.В. 12.12.24 УА #89604
	
	Номер = СтрЗаменить(Шапка.Номер, Символы.НПП, ""); 	
	НовыйДокумент.Комментарий = СтрШаблон("%1%2; ", НовыйДокумент.Комментарий, Номер);
	
	НовыйДокумент.НомерПоДаннымКлиента = Номер;
	НовыйДокумент.ДатаПоДаннымКлиента = НовыйДокумент.Дата;
	
	//+ ИнфоСофт Стояк Ю.К. 18.04.2025 УА #99444
	ПострочнаяОтгрузка = Константы.ИспользоватьПострочнуюОтгрузкуВЗаказеКлиента.Получить();
	//- ИнфоСофт Стояк Ю.К. 18.04.2025 УА #99444
	
	Для Каждого Строка Из Товары Цикл
	
		Если Строка.ТипНоменклатуры = Перечисления.ТипыНоменклатуры.Набор Тогда
			ЭтоНабор = Истина;
		Иначе 
			ЭтоНабор = Ложь;
		КонецЕсли;
		
		ТоварыЗаказа = Новый ТаблицаЗначений;
		ТоварыЗаказа.Колонки.Добавить("Номенклатура", Новый ОписаниеТипов("СправочникСсылка.Номенклатура"));
		ТоварыЗаказа.Колонки.Добавить("Характеристика", Новый ОписаниеТипов("СправочникСсылка.ХарактеристикиНоменклатуры"));
		
		//+ ИнфоСофт Мурсалимов Д.Р. 26.08.24 УА #82005
		ТоварыЗаказа.Колонки.Добавить("Упаковка");
		//- ИнфоСофт Мурсалимов Д.Р. 26.08.24 УА #82005
		
		ТоварыЗаказа.Колонки.Добавить("Количество", Новый ОписаниеТипов("Число", , , Новый КвалификаторыЧисла(10, 0)));
		ТоварыЗаказа.Колонки.Добавить("Цена", Новый ОписаниеТипов("Число", , , Новый КвалификаторыЧисла(15, 2)));
		ТоварыЗаказа.Колонки.Добавить("Сумма", Новый ОписаниеТипов("Число", , , Новый КвалификаторыЧисла(15, 2)));
		
		//+ ИнфоСофт Заварин К.В. 11.02.25 УА #93503
		ТоварыЗаказа.Колонки.Добавить("ОстатокНеСвободен", Новый ОписаниеТипов("Булево")); 
		//- ИнфоСофт Заварин К.В. 11.02.25 УА #93503
		
		СтрокаТовары = ТоварыЗаказа.Добавить();
		СтрокаТовары.Номенклатура = Строка.Номенклатура;
		СтрокаТовары.Характеристика = Строка.Характеристика;
		
		//+ ИнфоСофт Мурсалимов Д.Р. 26.08.24 УА #82005
		СтрокаТовары.Упаковка = Строка.Упаковка;
		//- ИнфоСофт Мурсалимов Д.Р. 26.08.24 УА #82005
		
		СтрокаТовары.Количество = Строка.Количество;
		//+ ИнфоСофт Стояк Ю.К. 26.01.2024 УА #67208  
		Если ФукнциональныеОпции.Свойство("ЦенаЛотаВЗаказ") И ФукнциональныеОпции.ЦенаЛотаВЗаказ Тогда
			СтрокаТовары.Цена = Строка.Цена;
		ИначеЕсли ФукнциональныеОпции.Свойство("ЦенаЛотаВЗаказ") Тогда
			СтрокаТовары.Цена = Строка.ЦенаДоСкидки;            
		Иначе
			СтрокаТовары.Цена = Строка.Цена;
		КонецЕсли;                                    
		//- ИнфоСофт Стояк Ю.К. 26.01.2024 УА #67208
		СтрокаТовары.Сумма = Строка.Количество * СтрокаТовары.Цена;
				
		Если ЭтоНабор Тогда
													
		ТоварыЗаказаТЗ = ПолучитьТаблицуТоваровНабора(ТоварыЗаказа);
		
		МассивКоэфф = РассчитатьДолюСтоимости(ТоварыЗаказаТЗ, ФукнциональныеОпции.ВидЦены, НовыйДокумент.Дата);
		Если ТоварыЗаказаТЗ[0].ВариантРасчетаЦеныНабора = Перечисления.ВариантыРасчетаЦенНаборов.ЦенаЗадаетсяЗаНаборРаспределяетсяПоДолям Тогда				
			СуммаПродажиПриДолях = ОбщегоНазначения.РаспределитьСуммуПропорциональноКоэффициентам(ТоварыЗаказаТЗ[0].Сумма, ТоварыЗаказаТЗ.ВыгрузитьКолонку("ДоляСтоимости"));
		ИначеЕсли МассивКоэфф <> Неопределено Тогда
			СуммыПродажи = ОбщегоНазначения.РаспределитьСуммуПропорциональноКоэффициентам(ТоварыЗаказаТЗ[0].Сумма, МассивКоэфф);
		Иначе
			
			МассивКоэфф = Новый Массив;
			
			Для Каждого Элемент Из ТоварыЗаказаТЗ Цикл				
				МассивКоэфф.Добавить(Элемент.Количество);			
			КонецЦикла;
			
			СуммыПродажи = ОбщегоНазначения.РаспределитьСуммуПропорциональноКоэффициентам(ТоварыЗаказаТЗ[0].Сумма, МассивКоэфф);

		КонецЕсли;                                  

		Иначе  			
			ТоварыЗаказаТЗ = ТоварыЗаказа;	
		КонецЕсли;
		
		Если ЗначениеЗаполнено(ГруппаСкладов) Тогда
			
			НовыйДокумент.Склад = ГруппаСкладов;
			//+ ИнфоСофт Стояк Ю.К. 18.11.2024 УА #74083			
			//РезультатПроверки = ПроверитьСвободныеОстатки(ТоварыЗаказаТЗ, ГруппаСкладов);
			РезультатПроверки = ПроверитьСвободныеОстатки(ТоварыЗаказаТЗ, ГруппаСкладов, Назначения);
			//- ИнфоСофт Стояк Ю.К. 18.11.2024 УА #74083
			СтрокаРезультат = РезультатПроверки[0];
			
			Если СтрокаРезультат.ОстатокВНаличии Тогда
				СкладСОстатком = СтрокаРезультат.Склад;
			Иначе 
				СкладСОстатком = Шапка.Склад;
			КонецЕсли; 
			
			//+ ИнфоСофт Заварин К.В. 02.04.25 УА #97851
		ИначеЕсли Шапка.СкладМП.ИспользоватьОсновнойСкладВЗаказах Тогда
			
			Если ЗначениеЗаполнено(Шапка.СкладМП.Склад) Тогда
				НовыйДокумент.Склад = Шапка.СкладМП.Склад;
			Иначе
				НовыйДокумент.Склад = Шапка.СкладМП.ГруппаСкладов[0].Склад;
			КонецЕсли;	
			
			СкладСОстатком = НовыйДокумент.Склад;
			
			РезультатПроверки = ПроверитьСвободныеОстатки(ТоварыЗаказаТЗ, СкладСОстатком, Назначения);			
			//- ИнфоСофт Заварин К.В. 02.04.25 УА #97851
			
		ИначеЕсли Шапка.ВыгружатьОстаткиИзГруппыСкладов И ФукнциональныеОпции.РежимСозданияЗаказов <> 2 Тогда
			
			Склады = Шапка.СкладМП.ГруппаСкладов.ВыгрузитьКолонку("Склад");			
			//+ ИнфоСофт Стояк Ю.К. 18.11.2024 УА #74083			
			//РезультатПроверки = ПроверитьСвободныеОстатки(ТоварыЗаказаТЗ, Склады);
			РезультатПроверки = ПроверитьСвободныеОстатки(ТоварыЗаказаТЗ, Склады, Назначения);
			//- ИнфоСофт Стояк Ю.К. 18.11.2024 УА #74083
			
			СкладСОстатком = Шапка.Склад;
			
			Для Каждого СкладСписка Из Склады Цикл
				
				НайденныйСклад = РезультатПроверки.НайтиСтроки(Новый Структура("Склад", СкладСписка));
				Если НайденныйСклад.Количество() > 0 Тогда
				
					Если НайденныйСклад[0].ОстатокВНаличии Тогда 
				    	СкладСОстатком = НайденныйСклад[0].Склад;
				    	Прервать;
				    КонецЕсли;
				    
				КонецЕсли;
				
			КонецЦикла;
					   	
		   	НовыйДокумент.Склад = СкладСОстатком;
			
		Иначе 

			НовыйДокумент.Склад = Шапка.Склад;
			СкладСОстатком = Шапка.Склад;			
			//+ ИнфоСофт Стояк Ю.К. 18.11.2024 УА #74083			
			//РезультатПроверки = ПроверитьСвободныеОстатки(ТоварыЗаказаТЗ, СкладСОстатком);
			РезультатПроверки = ПроверитьСвободныеОстатки(ТоварыЗаказаТЗ, СкладСОстатком, Назначения);
