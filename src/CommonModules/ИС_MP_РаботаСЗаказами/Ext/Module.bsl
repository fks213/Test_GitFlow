//+ ИнфоСофт Стояк Ю.К. 20.03.2024 УА #64801
Функция ПроверитьСвободныеОстатки(ТаблицаТоваров, Склад, Назначения = Неопределено) Экспорт
	
	//+ ИнфоСофт Стояк Ю.К. 18.11.2024 УА #74083
	Если Не ЗначениеЗаполнено(Назначения) Тогда
		Назначения = Новый Массив;
		Назначения.Добавить(Справочники.Назначения.ПустаяСсылка());
	КонецЕсли;
	//- ИнфоСофт Стояк Ю.К. 18.11.2024 УА #74083
	
	ЗапросОстатков = Новый Запрос;	
	ЗапросОстатков.Текст =	
	"ВЫБРАТЬ
	|	ТЗ.Номенклатура КАК Номенклатура,
	|	ТЗ.Характеристика КАК Характеристика
	|ПОМЕСТИТЬ ВТ_ТаблицаЗначений
	|ИЗ
	|	&ТЗ КАК ТЗ
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_ТаблицаЗначений.Номенклатура КАК Номенклатура,
	|	ВТ_ТаблицаЗначений.Характеристика КАК Характеристика,
	|	РаспределениеЗапасов.Склад КАК Склад,
	//+ ИнфоСофт Заварин К.В. 11.02.25 УА #93503
	|	РаспределениеЗапасов.Свободно как Свободно,
	//- ИнфоСофт Заварин К.В. 11.02.25 УА #93503
	|	ВЫБОР
	|		КОГДА РаспределениеЗапасов.Свободно ЕСТЬ NULL
	|			ТОГДА ЛОЖЬ
	|		ИНАЧЕ РаспределениеЗапасов.Свободно > 0
	|	КОНЕЦ КАК ОстатокВНаличии
	|ИЗ
	|	ВТ_ТаблицаЗначений КАК ВТ_ТаблицаЗначений
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.РаспределениеЗапасов КАК РаспределениеЗапасов
	|		ПО (ВТ_ТаблицаЗначений.Номенклатура = РаспределениеЗапасов.Номенклатура)
	|			И (ВТ_ТаблицаЗначений.Характеристика = РаспределениеЗапасов.Характеристика)
	|			И (РаспределениеЗапасов.Склад В ИЕРАРХИИ (&Склад))
	|			И (РаспределениеЗапасов.Состояние = ЗНАЧЕНИЕ(Перечисление.РаспределениеЗапасовСостояния.ОстатокНаСкладе))	
	//+ ИнфоСофт Стояк Ю.К. 18.11.2024 УА #74083
	|			И (РаспределениеЗапасов.Назначение В (&Назначения))
	//- ИнфоСофт Стояк Ю.К. 18.11.2024 УА #74083
	|
	|УПОРЯДОЧИТЬ ПО
	|	ОстатокВНаличии УБЫВ";	
	
	ЗапросОстатков.УстановитьПараметр("ТЗ", ТаблицаТоваров);
	ЗапросОстатков.УстановитьПараметр("Склад", Склад);
	//+ ИнфоСофт Стояк Ю.К. 19.11.2024 УА #74083
	ЗапросОстатков.УстановитьПараметр("Назначения", Назначения);
	//- ИнфоСофт Стояк Ю.К. 19.11.2024 УА #74083
	
	РезультатЗапросаОстатков = ЗапросОстатков.Выполнить();
	
	ВыгрузкаОстатков = РезультатЗапросаОстатков.Выгрузить();
	
	Возврат ВыгрузкаОстатков;
	
КонецФункции //- ИнфоСофт Стояк Ю.К. 20.03.2024 УА #64801 

//+ ИнфоСофт Мурсалимов Д.Р. 10.06.24 УА #77595
Процедура СоздатьРасходныйОрдер(Заказ, Знач Статус, Знач СтатусСтроки) Экспорт
	
	Если Не ЗначениеЗаполнено(Статус) Тогда
		Статус = Перечисления.СтатусыРасходныхОрдеров.Отгружен;
	КонецЕсли;     
	
	Если Не ЗначениеЗаполнено(СтатусСтроки) Тогда
		СтатусСтроки = Перечисления.ДействияСоСтрокамиОрдеровНаОтгрузку.Отгрузить;
	КонецЕсли;
	
	Склад = Заказ.Склад; 
	
	СтруктураПараметров = Новый Структура;
	
	СтруктураПараметров.Вставить("Получатель", Заказ.Партнер);
	СтруктураПараметров.Вставить("Склад", Склад);
	СтруктураПараметров.Вставить("РаспоряженияНаОтгрузку", Новый Массив);
	СтруктураПараметров.Вставить("Помещение", Справочники.СкладскиеПомещения.ПустаяСсылка());
	СтруктураПараметров.Вставить("ЗонаОтгрузки", Справочники.СкладскиеЯчейки.ПустаяСсылка());
	СтруктураПараметров.Вставить("ЗаданиеНаПеревозку", Документы.ЗаданиеНаПеревозку.ПустаяСсылка());
	СтруктураПараметров.Вставить("ФоновоеЗадание", Ложь);
	
	СтруктураПараметров.РаспоряженияНаОтгрузку.Добавить(Заказ);
	
	РасходныйОрдерСтруктура = СкладыСервер.ПереоформитьРасходныеОрдера(СтруктураПараметров);	
	
	Если РасходныйОрдерСтруктура.ЕстьОшибка Тогда
		ОбщегоНазначения.СообщитьПользователю("Автоматическое создание ордеров завершилось с ошибкой!");
		Возврат;	
	КонецЕсли;
	
	ВыполнитьИзменениеСтатусаРасходныхОрдеров(РасходныйОрдерСтруктура.ОформленныеОрдера, Статус, СтатусСтроки);
	
	// Получить значения функциональных опций.
	ИспользоватьАдресноеХранение = СкладыСервер.ИспользоватьАдресноеХранение(Склад);
	
	Если ИспользоватьАдресноеХранение Тогда
	
		Для Каждого Ордер Из РасходныйОрдерСтруктура.ОформленныеОрдера Цикл
			
			Если Ордер.РасходныйОрдер.Проведен Тогда
				
				ОтборРазмещениеТоваров = Документы.ОтборРазмещениеТоваров.СоздатьДокумент();
				ОтборРазмещениеТоваров.Заполнить(Ордер.РасходныйОрдер);
				
				Попытка
					ОтборРазмещениеТоваров.Записать(РежимЗаписиДокумента.Проведение);
				Исключение
					ОтборРазмещениеТоваров.Записать();
				КонецПопытки;
				
			КонецЕсли;	
			
		КонецЦикла;	
		
	КонецЕсли;
	
КонецПроцедуры //- ИнфоСофт Мурсалимов Д.Р. 10.06.24 УА #77595

//+ ИнфоСофт Мурсалимов Д.Р. 10.06.24 УА #77595
Процедура ВыполнитьИзменениеСтатусаРасходныхОрдеров(ОформленныеОрдеры, Статус, СтатусСтроки) Экспорт 
		
	Для Каждого Строка Из ОформленныеОрдеры Цикл
		
		НачатьТранзакцию();
		
		Попытка
			
			Блокировка = Новый БлокировкаДанных;
			
			ЭлементБлокировки = Блокировка.Добавить("Документ.РасходныйОрдерНаТовары");
			ЭлементБлокировки.УстановитьЗначение("Ссылка", Строка.РасходныйОрдер);
			
			Блокировка.Заблокировать();
			
			РасходныйОрдерОбъект = Строка.РасходныйОрдер.ПолучитьОбъект(); // ДокументОбъект.РасходныйОрдерНаТовары
			РасходныйОрдерОбъект.ОтгрузкаПоЗаданиюНаПеревозку = Ложь;
			РасходныйОрдерОбъект.Статус = Статус;   
			
			Для Каждого Элемент Из РасходныйОрдерОбъект.ОтгружаемыеТовары Цикл
				Элемент.Действие = СтатусСтроки;		
			КонецЦикла;
			
			РасходныйОрдерОбъект.ДатаОтгрузки = НачалоДня(ТекущаяДатаСеанса());
			РасходныйОрдерОбъект.Записать(РежимЗаписиДокумента.Проведение);
			
			ЗафиксироватьТранзакцию();
			
		Исключение
			
			ОтменитьТранзакцию();
			
			ТекстСообщения = НСтр("ru = 'Не удалось обработать %Документ% фоновым заданием изменения статуса по причине: %Причина%'");
			ТекстСообщения = СтрЗаменить(ТекстСообщения, "%Документ%", Строка.РасходныйОрдер);
			ТекстСообщения = СтрЗаменить(ТекстСообщения, "%Причина%", ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
			
			ЗаписьЖурналаРегистрации(ОбновлениеИнформационнойБазы.СобытиеЖурналаРегистрации(),
				УровеньЖурналаРегистрации.Предупреждение,
				Метаданные.Документы.РасходныйОрдерНаТовары,
				Строка.РасходныйОрдер,
				ТекстСообщения);
			
			ВызватьИсключение;
			
		КонецПопытки;
		
	КонецЦикла;
	
КонецПроцедуры //- ИнфоСофт Мурсалимов Д.Р. 10.06.24 УА #77595

//+ ИнфоСофт Ивонин К.А. 21.02.23 УА #53535
Функция ОрганизацияПименяетУСН(Организация)
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	НастройкиСистемыНалогообложенияСрезПоследних.СистемаНалогообложения КАК СистемаНалогообложения
	|ИЗ
	//+ ИнфоСофт Заварин К.В. 24.12.24 УА #90141
	//|	РегистрСведений.НастройкиСистемыНалогообложения.СрезПоследних(, Организация = &Организация) КАК НастройкиСистемыНалогообложенияСрезПоследних";
	|	РегистрСведений.НастройкиСистемыНалогообложения.СрезПоследних(&Период, Организация = &Организация) КАК НастройкиСистемыНалогообложенияСрезПоследних";
	//- ИнфоСофт Заварин К.В. 24.12.24 УА #90141
	
	Запрос.УстановитьПараметр("Организация", Организация);
	//+ ИнфоСофт Заварин К.В. 24.12.24 УА #90141
	Запрос.УстановитьПараметр("Период", ТекущаяДатаСеанса());
	//- ИнфоСофт Заварин К.В. 24.12.24 УА #90141
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Выборка = РезультатЗапроса.Выбрать();
	
	Если Выборка.Следующий() Тогда
	
		Если Выборка.СистемаНалогообложения = Перечисления.СистемыНалогообложения.Упрощенная Тогда
			Возврат Истина;
		Иначе
			Возврат Ложь;
		КонецЕсли;
		
	Иначе
		Возврат Неопределено;
	КонецЕсли;	
	
КонецФункции //- ИнфоСофт Ивонин К.А. 21.02.23 УА #53535 

