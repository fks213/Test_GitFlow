//+ ИнфоСофт Ивонин К.А. 05.06.23 УА #59411
Процедура ПриНачалеРаботыСистемы() Экспорт

 	Попытка
		ИС_MP_РаботаСРегламентнымиЗаданиями.ОбработкаЗапускаРегламентныхЗаданийЗагружена();
	Исключение
	КонецПопытки;
	
	Попытка
		ИС_МП_ОбновлениеМодуля.ВыполнитьОтложенноеОбновление();
	Исключение
	КонецПопытки;
		
	Попытка 
							
		Результат = ИС_МП_ОбновлениеМодуля.ТестПодключения(Истина);
		
		Если Результат = Неопределено Тогда
			Возврат;
		КонецЕсли;
		
		Если Результат.ТокенКорректный И Результат.ПроверкаПройдена Тогда 
			
			ИнформацияОбОбновлении = ИС_МП_ОбновлениеМодуля.ИнформацияОбОбновлении(Истина);
			
			Если ИнформацияОбОбновлении.ЕстьОшибки Тогда
				Возврат;
			КонецЕсли;
			
			Если ИнформацияОбОбновлении.ЕстьНоваяВерсия Тогда
				
				ТекстСообщения = "Обновление модуля ""Управление маркетплейсами на 1С"""; 
				
				Пояснение = СтрШаблон("Доступна новая версия модуля ""Управление маркетплейсами на 1С"": %1 (Нажмите для просмотра)",
					ИнформацияОбОбновлении.НоваяВерсия);

				ПоказатьОповещениеПользователя(ТекстСообщения, "e1cib/command/Обработка.ИС_МП_Поддержка.Команда.ОткрытьФормуПанельНавигации", Пояснение,
					БиблиотекаКартинок.ИС_MP_Оповещение, СтатусОповещенияПользователя.Важное, ИнформацияОбОбновлении.НоваяВерсия);
					
			КонецЕсли;
			
		КонецЕсли;

	Исключение
	КонецПопытки;

КонецПроцедуры //- ИнфоСофт Ивонин К.А. 05.06.23 УА #59411

//+ ИнфоСофт Ивонин К.А. 01.08.24 УА #79145
Процедура ПриОткрытии(ЭтотОбъект, Отказ, Знач ДопПараметры = Неопределено) Экспорт
	
	Если ДопПараметры = Неопределено Тогда
		ДопПараметры = Новый Структура;	
	КонецЕсли;
	
#Если ВебКлиент Тогда
	Оповещение = ?(ДопПараметры.Свойство("Оповещение"), ДопПараметры.Оповещение, Новый ОписаниеОповещения); 	
	ФайловаяСистемаКлиент.ПодключитьРасширениеДляРаботыСФайлами(Оповещение);
#КонецЕсли

КонецПроцедуры //- ИнфоСофт Ивонин К.А. 01.08.24 УА #79145

//+ ИнфоСофт Ивонин К.А. 28.08.24 УА #81109
// Исходная версия см. ФайловаяСистемаКлиент.НапечататьИзПриложенияПоИмениФайла
// Выполняет печать файла внешним приложением.
//
// Параметры:
//  ИмяОткрываемогоФайла - Строка
//  Принтер - Строка
//
Процедура НапечататьИзПриложения(ИмяОткрываемогоФайла, Принтер = "") Экспорт
	
	Если Не ЗначениеЗаполнено(ИмяОткрываемогоФайла) Тогда
		Возврат;
	КонецЕсли;
	
#Если Не МобильныйКлиент Тогда
	Если ОбщегоНазначенияКлиент.ЭтоWindowsКлиент() Тогда
		Shell = Новый COMОбъект("Shell.Application");
		Shell.ShellExecute(ИмяОткрываемогоФайла, Принтер, "", "printto", 0);
	ИначеЕсли ОбщегоНазначенияКлиент.ЭтоLinuxКлиент() Тогда
		ДополнительныеПараметры = Новый Структура;
		ДополнительныеПараметры.Вставить("ИмяОткрываемогоФайла", ИмяОткрываемогоФайла);
		ДополнительныеПараметры.Вставить("Принтер", Принтер);
		ОписаниеОповещения = Новый ОписаниеОповещения("НапечататьИзПриложенияПоИмениФайлаLinux", 
			ЭтотОбъект, ДополнительныеПараметры);
		ПроверитьПрограммаLinuxУстановлена("Unoconv", ОписаниеОповещения);
	Иначе
		ПоказатьПредупреждение(, НСтр("ru = 'Печать файлов данного типа возможна только из приложения для Windows или Linux.'"));
		Возврат;
	КонецЕсли;
#КонецЕсли

КонецПроцедуры //- ИнфоСофт Ивонин К.А. 28.08.24 УА #81109

//+ ИнфоСофт Ивонин К.А. 29.08.24 УА #81109
// Перенесено см. ФайловаяСистемаКлиент.ПроверитьПрограммаLinuxУстановленаЗавершение 
Процедура ПроверитьПрограммаLinuxУстановленаЗавершение(Результат, Параметры) Экспорт
	
	Если Результат = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	РезультатПроцедуры = СтрНайти(Результат.ПотокВывода, "Status: install ok installed") <> Ложь;
	ВыполнитьОбработкуОповещения(Параметры.Оповещение, РезультатПроцедуры);
	
КонецПроцедуры //- ИнфоСофт Ивонин К.А. 29.08.24 УА #81109

//+ ИнфоСофт Ивонин К.А. 28.08.24 УА #81109
// Перенесено см. ФайловаяСистемаКлиент.НапечататьИзПриложенияПоИмениФайлаLinux
Процедура НапечататьИзПриложенияПоИмениФайлаLinux(Результат, Параметры) Экспорт
	
	Если Результат = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если Результат = Ложь Тогда
		ПоказатьПредупреждение(, НСтр("ru = 'Требуется установка программы ""Unoconv"" в системе'"));
		Возврат;
	КонецЕсли;
	
	ОписаниеОповещения = Новый ОписаниеОповещения("НапечататьИзПриложенияПоИмениФайлаLinuxЗапускUnoconv", 
		ЭтотОбъект, Параметры);
	ПолучитьПолноеИмяВременногоФайла(ОписаниеОповещения);
		
КонецПроцедуры //- ИнфоСофт Ивонин К.А. 28.08.24 УА #81109

//+ ИнфоСофт Ивонин К.А. 28.08.24 УА #81109
// Исходная версия см. ФайловаяСистемаКлиент.НапечататьИзПриложенияПоИмениФайлаLinuxЗапускUnoconv
Процедура НапечататьИзПриложенияПоИмениФайлаLinuxЗапускUnoconv(ИмяВременногоФайла, Параметры) Экспорт
	
	ДополнительныеПараметры = Новый Структура;
	ДополнительныеПараметры.Вставить("ФайлКонвертируемыхДанных", ИмяВременногоФайла);
	
	ОписаниеОповещения = Новый ОписаниеОповещения("НапечататьИзПриложенияПоИмениФайлаLinuxЗапускLpr", 
		ЭтотОбъект, ДополнительныеПараметры);
	
	ПараметрыЗапускаПрограммы = ФайловаяСистемаКлиент.ПараметрыЗапускаПрограммы();
	ПараметрыЗапускаПрограммы.Вставить("ДождатьсяЗавершения", Истина);
	ПараметрыЗапускаПрограммы.Вставить("ПолучитьПотокОшибок", Истина);
	ПараметрыЗапускаПрограммы.Вставить("Оповещение", ОписаниеОповещения);
	
	СтрокаКоманды = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку("unoconv %1 --stdout '%2' >""%3""",
		?(Параметры.Принтер = "", "", "-P " + Параметры.Принтер)
		, Параметры.ИмяОткрываемогоФайла, ИмяВременногоФайла);
	ФайловаяСистемаКлиент.ЗапуститьПрограмму(СтрокаКоманды, ПараметрыЗапускаПрограммы);
	
КонецПроцедуры //- ИнфоСофт Ивонин К.А. 28.08.24 УА #81109

//+ ИнфоСофт Ивонин К.А. 29.08.24 УА #81109
// Исходная версия см. ФайловаяСистемаКлиент.НапечататьИзПриложенияПоИмениФайлаLinuxЗапускLpr
Процедура НапечататьИзПриложенияПоИмениФайлаLinuxЗапускLpr(Результат, Параметры) Экспорт
	
	Если Результат = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если Не Результат.ПриложениеЗапущено Тогда
		ПоказатьПредупреждение(, Результат.ОписаниеОшибки);
	Иначе
		
		Параметры.Вставить("ОписаниеОшибки", Результат.ОписаниеОшибки);
		
		ОписаниеОповещения = Новый ОписаниеОповещения("НапечататьИзПриложенияПоИмениФайлаLinuxЗавершение", ЭтотОбъект, Параметры);
		ПараметрыЗапускаПрограммы = ФайловаяСистемаКлиент.ПараметрыЗапускаПрограммы();
		ПараметрыЗапускаПрограммы.Вставить("ДождатьсяЗавершения", Истина);
		ПараметрыЗапускаПрограммы.Вставить("ПолучитьПотокОшибок", Истина);
		ПараметрыЗапускаПрограммы.Вставить("Оповещение", ОписаниеОповещения);
		
		ФайловаяСистемаКлиент.ЗапуститьПрограмму(
			СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку("lpr %1", Параметры.ФайлКонвертируемыхДанных), 
			ПараметрыЗапускаПрограммы);
		
	КонецЕсли;
	
КонецПроцедуры //- ИнфоСофт Ивонин К.А. 29.08.24 УА #81109

//+ ИнфоСофт Ивонин К.А. 29.08.24 УА #81109
// Перенесено см. ФайловаяСистемаКлиент.НапечататьИзПриложенияПоИмениФайлаLinuxЗавершение
Процедура НапечататьИзПриложенияПоИмениФайлаLinuxЗавершение(Результат, Параметры) Экспорт
	
	Если Результат = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Файл = Новый Файл(Параметры.ФайлКонвертируемыхДанных);
	Если Файл.Существует() Тогда// АПК:566 Выполняется только для Linux
		УдалитьФайлы(Параметры.ФайлКонвертируемыхДанных);// АПК:566 Выполняется только для Linux
	КонецЕсли;
	
	Если Не Результат.ПриложениеЗапущено Или ЗначениеЗаполнено(Результат.ОписаниеОшибки) Или ЗначениеЗаполнено(Результат.ПотокОшибок) Тогда
		ПоказатьПредупреждение(, ?(ЗначениеЗаполнено(Результат.ОписаниеОшибки),Результат.ОписаниеОшибки + Символы.ПС, "") + Результат.ПотокОшибок);
	КонецЕсли;
	
КонецПроцедуры //- ИнфоСофт Ивонин К.А. 29.08.24 УА #81109

//+ ИнфоСофт Ивонин К.А. 29.08.24 УА #81109
// Перенесено см. ФайловаяСистемаКлиент.ПолучитьИмяВременногоФайлаПослеПроверкиРасширенияРаботыСФайлами
// Продолжение процедуры ПолучитьПолноеИмяВременногоФайла.
// 
// Параметры:
//  РасширениеПодключено - Булево
//  Контекст - Структура:
//   * Оповещение - ОписаниеОповещения
//   * Расширение - Строка
//
Процедура ПолучитьИмяВременногоФайлаПослеПроверкиРасширенияРаботыСФайлами(РасширениеПодключено, Контекст) Экспорт
	
	Если РасширениеПодключено Тогда
#Если ВебКлиент Тогда
		Оповещение = Новый ОписаниеОповещения(
			"ПолучитьИмяВременногоФайлаПослеПолученияВременногоКаталога", ЭтотОбъект, Контекст,
			"ПолучитьИмяВременногоФайлаПриОбработкеОшибки", ЭтотОбъект);
		НачатьПолучениеКаталогаВременныхФайлов(Оповещение);
#Иначе
		ПолучитьИмяВременногоФайлаПослеПолученияВременногоКаталога("", Контекст);
#КонецЕсли
	Иначе
		ПолучитьИмяВременногоФайлаОповеститьОбОшибке(НСтр("ru = 'Не удалось установить расширение для работы с 1С:Предприятием.'"), Контекст);
	КонецЕсли;
	
КонецПроцедуры //- ИнфоСофт Ивонин К.А. 29.08.24 УА #81109

//+ ИнфоСофт Ивонин К.А. 29.08.24 УА #81109
// Перенесено см. ФайловаяСистемаКлиент.ПолучитьИмяВременногоФайлаПослеПолученияВременногоКаталога
// Продолжение процедуры ПолучитьПолноеИмяВременногоФайла.
// 
// Параметры:
//  ИмяКаталогаВременныхФайлов - Строка
//  Контекст - Структура:
//   * Оповещение - ОписаниеОповещения
//   * Расширение - Строка
//
Процедура ПолучитьИмяВременногоФайлаПослеПолученияВременногоКаталога(ИмяКаталогаВременныхФайлов, Контекст) Экспорт
	
	Оповещение = Контекст.Оповещение;
	Расширение = Контекст.Расширение;
	
#Если ВебКлиент Тогда
	ИмяВременногоФайла = ИмяКаталогаВременныхФайлов + Строка(Новый УникальныйИдентификатор);
#Иначе
	ИмяВременногоФайла = ПолучитьИмяВременногоФайла(Расширение); // АПК:441 Функция для получения имени временного файла.
#КонецЕсли
	
	Если Не ПустаяСтрока(Расширение) Тогда 
		ИмяВременногоФайла = ИмяВременногоФайла + "." + Расширение;
	КонецЕсли;
	
	ВыполнитьОбработкуОповещения(Оповещение, ИмяВременногоФайла);
	
КонецПроцедуры //- ИнфоСофт Ивонин К.А. 29.08.24 УА #81109

//+ ИнфоСофт Ивонин К.А. 29.08.24 УА #81109
// Перенесено см. ФайловаяСистемаКлиент.ПолучитьИмяВременногоФайлаПриОбработкеОшибки
// Продолжение процедуры ПолучитьПолноеИмяВременногоФайла.
Процедура ПолучитьИмяВременногоФайлаПриОбработкеОшибки(ИнформацияОбОшибке, СтандартнаяОбработка, Контекст) Экспорт
	
	СтандартнаяОбработка = Ложь;
	ОписаниеОшибки = ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке);
	ПолучитьИмяВременногоФайлаОповеститьОбОшибке(ОписаниеОшибки, Контекст);
	
КонецПроцедуры //- ИнфоСофт Ивонин К.А. 29.08.24 УА #81109

