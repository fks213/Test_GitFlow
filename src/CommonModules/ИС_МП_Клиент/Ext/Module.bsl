//+ ИнфоСофт Ивонин К.А. 21.10.24 УА #68001
Функция ОбщийМодульМаркетплейса(Маркетплейс)
	
	Если Маркетплейс = "ВБ" Тогда
		Возврат ОбщегоНазначенияКлиент.ОбщийМодуль("ИС_ВБ_Клиент");	
	КонецЕсли;
	
	Если Маркетплейс = "Озон" Тогда
		Возврат ОбщегоНазначенияКлиент.ОбщийМодуль("ИС_Озон_Клиент");	
	КонецЕсли;
	
	Если Маркетплейс = "ЯМ" Тогда
		Возврат ОбщегоНазначенияКлиент.ОбщийМодуль("ИС_ЯМ_Клиент");	
	КонецЕсли;	
	
	Если Маркетплейс = "Сбер" Тогда
		Возврат ОбщегоНазначенияКлиент.ОбщийМодуль("ИС_Сбер_Клиент");	
	КонецЕсли;
	
	Если Маркетплейс = "Али" Тогда
		Возврат ОбщегоНазначенияКлиент.ОбщийМодуль("ИС_Али_Клиент");	
	КонецЕсли;
	
	Если Маркетплейс = "МВМ" Тогда
		Возврат ОбщегоНазначенияКлиент.ОбщийМодуль("ИС_МВМ_Клиент");	
	КонецЕсли;

	//+ ИнфоСофт Власова И.С. 23.12.24 УА #90120
	Если Маркетплейс = "Ламода" Тогда
		Возврат ОбщегоНазначенияКлиент.ОбщийМодуль("ИС_Ламода_Клиент");	
	КонецЕсли;
	//- ИнфоСофт Власова И.С. 23.12.24 УА #90120
	
	ВызватьИсключение("Неизвестный маркетплейс");
	
КонецФункции //- ИнфоСофт Ивонин К.А. 21.10.24 УА #68001

//+ ИнфоСофт Ивонин К.А. 29.08.24 УА #81109
// Исходная версия см. ФайловаяСистемаКлиент.ПроверитьПрограммаLinuxУстановлена
Процедура ПроверитьПрограммаLinuxУстановлена(ИмяПрограммы, Оповещение)
	
	ДополнительныеПараметры = Новый Структура;
	ДополнительныеПараметры.Вставить("Оповещение", Оповещение);
	ПрограммаLinuxУстановленаЗавершение = Новый ОписаниеОповещения("ПроверитьПрограммаLinuxУстановленаЗавершение", 
		ЭтотОбъект, ДополнительныеПараметры);
	
	ПараметрыЗапускаПрограммы = ФайловаяСистемаКлиент.ПараметрыЗапускаПрограммы();
	ПараметрыЗапускаПрограммы.Вставить("ДождатьсяЗавершения", Истина);
	ПараметрыЗапускаПрограммы.Вставить("ПолучитьПотокВывода", Истина);
	ПараметрыЗапускаПрограммы.Вставить("ПолучитьПотокОшибок", Истина);
	ПараметрыЗапускаПрограммы.Вставить("Оповещение", ПрограммаLinuxУстановленаЗавершение);
	
	ФайловаяСистемаКлиент.ЗапуститьПрограмму(СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
		"dpkg -s '%1'", Строка(ИмяПрограммы)), ПараметрыЗапускаПрограммы);
	
КонецПроцедуры //- ИнфоСофт Ивонин К.А. 29.08.24 УА #81109

