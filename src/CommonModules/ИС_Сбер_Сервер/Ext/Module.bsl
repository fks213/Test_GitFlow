#Область РегламентныеЗадания

//+ ИнфоСофт Ивонин К.А. 11.11.23 УА #55166
Процедура ВыполнитьКомандуРеглЗадания(Профиль, ИдентификаторКомандыОбработки) Экспорт

	Событие = ИмяСобытия("ВыполнитьКомандуРеглЗадания");
	
	Если ИдентификаторКомандыОбработки = "ВыгрузкаЦенСбер" Тогда
		ВыгрузитьЦены(Профиль);
		Возврат;				
	КонецЕсли;
	
	Если ИдентификаторКомандыОбработки = "ВыгрузкаОстатковСбер" Тогда
		
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	ИС_Сбер_Склады.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.ИС_Сбер_Склады КАК ИС_Сбер_Склады
		|ГДЕ
		|	НЕ ИС_Сбер_Склады.ПометкаУдаления
		|	И ИС_Сбер_Склады.Профиль = &Профиль 
		//+ ИнфоСофт Заварин К.В. 13.08.24 УА #81097
		|	И НЕ(ИС_Сбер_Склады.ОбщаяГруппаСкладов = ЗНАЧЕНИЕ(Справочник.Склады.ПустаяСсылка)
		|				И ИС_Сбер_Склады.Склад = ЗНАЧЕНИЕ(Справочник.Склады.ПустаяСсылка)
		|				И ИС_Сбер_Склады.ВыгружатьОстаткиИзГруппыСкладов = ЛОЖЬ)";
		//- ИнфоСофт Заварин К.В. 13.08.24 УА #81097
		
		Запрос.УстановитьПараметр("Профиль", Профиль);
		
		РезультатЗапроса = Запрос.Выполнить();
		
		Выборка = РезультатЗапроса.Выбрать();
		
		Пока Выборка.Следующий() Цикл
			ВыгрузитьОстатки(Профиль, Выборка.Ссылка);
		КонецЦикла;
	
		Возврат;
						
	КонецЕсли;
	
	Если ИдентификаторКомандыОбработки = "СберЗагрузкаОтправлений" Тогда
		ПолучитьСписокОтправлений(Профиль, ПолучитьДатуПоследнегоЗаказа(Профиль));
		Возврат;
	КонецЕсли;
	
	Если ИдентификаторКомандыОбработки = "СберОбновлениеСтатусов" Тогда
		ОбновитьСтатусы(Профиль);
		Возврат;
	КонецЕсли;
	
	//+ ИнфоСофт Стояк Ю.К. 09.04.2024 УА #73643
	Если ИдентификаторКомандыОбработки = "СберЗакрыватьЗаказВТечениеДня" Тогда
		ВыполнитьЗакрытиеЗаказов(Профиль);
		Возврат;
	КонецЕсли;
	//- ИнфоСофт Стояк Ю.К. 09.04.2024 УА #73643
	
КонецПроцедуры //- ИнфоСофт Ивонин К.А. 11.11.23 УА #55166

