//+ ИнфоСофт Мурсалимов Д.Р. 13.06.24 УА #77595
Процедура СоздатьРеализацию(Выборка, ФукнциональныеОпции, Комиссия25)
	
	Событие = ИмяСобытия("СоздатьРеализации1С");
	
	Если Комиссия25 Тогда
		ДокументРеализация = Документы.ПередачаТоваровХранителю.СоздатьДокумент();	
	Иначе
		ДокументРеализация = Документы.РеализацияТоваровУслуг.СоздатьДокумент();
	КонецЕсли;
	
	Попытка
		ДокументРеализация.Заполнить(Выборка.Заказ); 
	Исключение
		Текст = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
		ИС_MP_Сервер.ЗаписатьВЖРИСообщитьПользователю(Событие, Текст);
	КонецПопытки;  
	
	//+ ИнфоСофт Мурсалимов Д.Р. 04.03.25 УА #95186
	Если ДокументРеализация.Товары.Количество() = 0 Тогда
		
		ДокументРеализация.ЗаказКлиента 	= Неопределено;
		ДокументРеализация.ПометкаУдаления 	= Истина;
		 
		Попытка
			ДокументРеализация.Записать(РежимЗаписиДокумента.Запись);			
		Исключение
			Текст = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
			ИС_MP_Сервер.ЗаписатьВЖРИСообщитьПользователю(Событие, Текст);
		КонецПопытки;
			
	КонецЕсли;
	//- ИнфоСофт Мурсалимов Д.Р. 04.03.25 УА #95186
	
	Если Не ФукнциональныеОпции.ДатаОтгрузкиИлиТекущаяДатаВРеализацию Тогда
		Если ЗначениеЗаполнено(Выборка.ДатаОтгрузки) Тогда
			ДокументРеализация.Дата = Выборка.ДатаОтгрузки;		
		Иначе                                                 
			ДокументРеализация.Дата = ТекущаяДатаСеанса();
		КонецЕсли;	
	Иначе
		ДокументРеализация.Дата = ТекущаяДатаСеанса();	
	КонецЕсли;
	
	ДокументРеализация.Комментарий = Выборка.Комментарий;
	
	Если Не Комиссия25 Тогда
		ДокументРеализация.СкидкиРассчитаны = Истина;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ФукнциональныеОпции.Подразделение) Тогда  
		ДокументРеализация.Подразделение = ФукнциональныеОпции.Подразделение;
	КонецЕсли;		
	
	ЗаписыватьДокумент = Ложь;
	
	Если ФукнциональныеОпции.ПроводитьРеализации Тогда
		
		Попытка
			ДокументРеализация.Записать(РежимЗаписиДокумента.Проведение);
		Исключение
			ЗаписыватьДокумент = Истина;
			Текст = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
			ИС_MP_Сервер.ЗаписатьВЖРИСообщитьПользователю(Событие, Текст); 
		КонецПопытки;
		
	Иначе
		ЗаписыватьДокумент = Истина;	
	КонецЕсли;
	
	Если ЗаписыватьДокумент Тогда	
		
		Попытка
			ДокументРеализация.Записать();			
		Исключение
			Текст = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
			ИС_MP_Сервер.ЗаписатьВЖРИСообщитьПользователю(Событие, Текст);
		КонецПопытки;
		
	КонецЕсли;
	
КонецПроцедуры //- ИнфоСофт Мурсалимов Д.Р. 13.06.24 УА #77595

//+ ИнфоСофт Ивонин К.А. 02.03.25 УА #92887
Процедура СоздатьИлиОбновитьТовар(Профиль, Ссылка, СтрокаТовара)
	
	Событие = ИмяСобытия("СоздатьИлиОбновитьТовар");
	
	Если Ссылка.Пустая() Тогда
		Товар = Справочники.ИС_Сбер_Номенклатура.СоздатьЭлемент();	
	Иначе
		Товар = Ссылка.ПолучитьОбъект();
	КонецЕсли;
	
	Товар.Профиль = Профиль;
	
	Товар.Наименование = СтрокаТовара.НаименованиеМерчанта;
	Товар.offer_id     = СтрокаТовара.КодТовараПродавца_offerId_;
	Товар.Штрихкод     = СтрокаТовара.ШтрихкодМерчанта;		
	Товар.Бренд        = СтрокаТовара.БрендМерчанта;
	Товар.vendorCode   = СтрокаТовара.ВендорКод_артикулПроизводителя_;
	
	Попытка
		Товар.Записать();
	Исключение
		ТестОшибки = ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
		ИС_МП_Сервер.ЗаписатьВЖРИСообщитьПользователю(Событие, ТестОшибки);
	КонецПопытки;
	
