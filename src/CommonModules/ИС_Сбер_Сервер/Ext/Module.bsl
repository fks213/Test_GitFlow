//+ ИнфоСофт Стояк Ю.К. 18.11.2024 УА #74083
Функция ПолучитьНазначения(Склад)
	
	Если Метаданные.Перечисления.Найти("ТипыОбъектовНазначений") = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	ЗапросНазначений = Новый Запрос;
	ЗапросНазначений.Текст = 
	"ВЫБРАТЬ
	|	ЕСТЬNULL(Назначения.Ссылка, ЗНАЧЕНИЕ(Справочник.Назначения.ПустаяСсылка)) КАК Назначение
	|ИЗ
	|	Справочник.ИС_Сбер_Склады.НаправленияДеятельности КАК ИС_Сбер_СкладыНаправленияДеятельности
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Назначения КАК Назначения
	|		ПО ИС_Сбер_СкладыНаправленияДеятельности.НаправлениеДеятельности = Назначения.НаправлениеДеятельности
	|			И (Назначения.НаправлениеДеятельности <> ЗНАЧЕНИЕ(Справочник.НаправленияДеятельности.ПустаяСсылка))
	|ГДЕ
	|	ИС_Сбер_СкладыНаправленияДеятельности.Ссылка = &Ссылка
	|	И Назначения.ТипОбъектаНазначения = ЗНАЧЕНИЕ(Перечисление.ТипыОбъектовНазначений.НаправлениеДеятельности)";		
	
	ЗапросНазначений.УстановитьПараметр("Ссылка", Склад);
	
	РезультатЗапросаНазначений = ЗапросНазначений.Выполнить();
	
	Назначения = Новый Массив;
	
	ВыборкаНазначения = РезультатЗапросаНазначений.Выбрать();
	
	Пока ВыборкаНазначения.Следующий() Цикл	
		Назначения.Добавить(ВыборкаНазначения.Назначение);
	КонецЦикла;
	
	Если Назначения.Количество() = 0 Тогда		
		Назначения.Добавить(Справочники.Назначения.ПустаяСсылка());
	КонецЕсли;
	
	Возврат Назначения;
	
КонецФункции //- ИнфоСофт Стояк Ю.К. 18.11.2024 УА #74083

