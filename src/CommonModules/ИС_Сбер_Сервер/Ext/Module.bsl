//+ ИнфоСофт Мурсалимов Д.Р. 13.05.24 УА #66901
Процедура ВыгрузитьЦены(Профиль, ТаблицаВыгрузки = Неопределено) Экспорт

	Событие = ИмяСобытия("ВыгрузитьЦены");
	
	НастройкиСоединения = ПолучитьНастройкиСоединенияПрофиля(Профиль);  
	ПараметрыЗапроса = ИС_MP_РаботаСHTTPЗапросамиСервер.ПолучитьСтруктуруHTTPЗапроса();
	РезультатПроверки = ПроверитьИЗаполнитьПараметрыЗапросаДляСервисаAPI(ПараметрыЗапроса, НастройкиСоединения);
	
	Если Не РезультатПроверки Тогда
		Возврат;
	КонецЕсли;
	
	ПеречислениеМП = Перечисления.ИС_МП_Маркетплейсы.Сбер;
	
	МассивПараметров = ПолучитьСписокПараметровЦен();
	
	Результат = ИС_MP_Сервер.ПолучитьЗначениеНастроек(Профиль, Перечисления.ИС_МП_Маркетплейсы.Сбер, МассивПараметров);
	
	СтруктураЦен = ПолучитьСтруктуруПараметровЦен(); 
	
	ЗаполнитьЗначенияСвойств(СтруктураЦен, Результат);
	
	РежимОкругленияЦен = СтруктураЦен.РежимОкругленияЦен;
	ИспользоватьПоследниеЦены = СтруктураЦен.ИспользоватьПоследниеЦены;
	
	Если ТаблицаВыгрузки = Неопределено Тогда
				
		Запрос = Новый Запрос;
		Запрос.Текст = ПолучитьТекстЗапросаЦен(); 
		
		УстановитьПараметрыЗапросаЦен(Запрос, Профиль);                                                       
		
		РезультатЗапроса = Запрос.Выполнить();
		
		Если РезультатЗапроса.Пустой() Тогда
			Возврат;
		КонецЕсли;
		
		Выборка = РезультатЗапроса.Выбрать();
		
		ТаблицаВыгрузки = Новый ТаблицаЗначений;	
		
		ИС_МП_УправлениеЦенами.ЗаполнитьКолонкиТаблицыВыгрузкиЦен(ПеречислениеМП, ТаблицаВыгрузки);
		
		МассивПолей = ИС_МП_УправлениеЦенами.ПолучитьПоляДляВыгрузки(ПеречислениеМП);
		
		Пока Выборка.Следующий() Цикл
		
			Если Не Выборка.ЕстьСопоставление И Не Выборка.ЕстьРучнаяЦена Тогда
				Продолжить;
			КонецЕсли; 
			
			Если Не ЗначениеЗаполнено(Выборка.offerID) Тогда
				Продолжить;
			КонецЕсли;
			
			НоваяСтрока = ТаблицаВыгрузки.Добавить();
		
			Для Каждого Элемент Из МассивПолей Цикл
				НоваяСтрока[Элемент] = Выборка[Элемент];
			КонецЦикла;
			
			ЭтоНабор = Выборка.ЭтоНабор;
			
			Если Выборка.ЕстьРучнаяЦена Тогда
				Цена = Выборка.РучнаяЦена;
			Иначе  
				Цена = Выборка.Цена;
			КонецЕсли;
			
			Цена = Окр(Цена, 0, РежимОкругленияЦен);
			
			НоваяСтрока.Цена = Цена;
				
			//Если Выборка.ЕстьРучнаяЦенаСоСкидкой Тогда
			//	ЦенаСоСкидкой = Выборка.РучнаяЦенаСоСкидкой;
			//Иначе
			//	ЦенаСоСкидкой = Выборка.ЦенаСоСкидкой;	
			//КонецЕсли;
			//
			//ЦенаСоСкидкой = Окр(ЦенаСоСкидкой, 0, РежимОкругленияЦен);
			//	
			//Если ЦенаСоСкидкой = 0 Тогда
			//	Скидка = 0;	
			//Иначе
			//	Скидка = ?(Цена = 0, 0, 100 - Окр(ЦенаСоСкидкой / Цена * 100, 0, РежимОкругленияЦен));
			//КонецЕсли;
			//
			//Если ЗначениеЗаполнено(Скидка) И Скидка > 0 Тогда 
			//	НоваяСтрока.Скидка = Скидка; 
			//КонецЕсли;
			
			Если НоваяСтрока.Цена = 0 Тогда 
				ТаблицаВыгрузки.Удалить(НоваяСтрока);
			КонецЕсли;
			
			Если Не ИспользоватьПоследниеЦены Тогда
				Продолжить;
			КонецЕсли;
			
			Если Не Выборка.ЕстьРучнаяЦена Тогда
			
				Если Не ИС_МП_УправлениеЦенами.ПроверитьПоследниеЦены(ПеречислениеМП, Выборка, НоваяСтрока) Тогда		
					ТаблицаВыгрузки.Удалить(НоваяСтрока);			
				КонецЕсли; 
				
			КонецЕсли;
			
		КонецЦикла;
				
	КонецЕсли;
	
	Если ТаблицаВыгрузки.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;  	
	
	МассивЦены = Новый Массив;
		
	Для Каждого Элемент Из ТаблицаВыгрузки Цикл
		
		Цены = Новый Структура;
		Цены.Вставить("offerId", 	Элемент.offerID);
		Цены.Вставить("price", 		Элемент.Цена);
		Цены.Вставить("isDeleted", 	Ложь);
		МассивЦены.Добавить(Цены);
		
	КонецЦикла;
	
	Data = Новый Структура;
	Data.Вставить("token", НастройкиСоединения["СберТокен"]);	
	
	//+ ИнфоСофт Стояк Ю.К. 25.11.2024 УА #88226	         
	//Data.Вставить("prices", МассивЦены);
	Data.Вставить("prices", Новый Массив);
	РазбитыйМассив = ИС_MP_Сервер.РазбитьМассивПоNЭлементов(МассивЦены, 300);
	//- ИнфоСофт Стояк Ю.К. 25.11.2024 УА #88226
	
	//+ ИнфоСофт Стояк Ю.К. 25.11.2024 УА #88226
	Для Каждого Элемент Из РазбитыйМассив Цикл						
		
		Data.prices = Элемент;
		//- ИнфоСофт Стояк Ю.К. 25.11.2024 УА #88226
		
		Результат = ИС_Сбер_API.ВыгрузитьЦены(Профиль, ПараметрыЗапроса, Data);
		
		БылиОшибкиВыгрузки = Ложь;
		
		Если Результат = Неопределено Тогда
			БылиОшибкиВыгрузки = Истина;
			//+ ИнфоСофт Стояк Ю.К. 25.11.2024 УА #88226		
			//Иначе	
			//	ОбщегоНазначения.СообщитьПользователю("Цены успешно выгружены");
			//- ИнфоСофт Стояк Ю.К. 25.11.2024 УА #88226
		КонецЕсли;
		
		Если Не БылиОшибкиВыгрузки И ИспользоватьПоследниеЦены Тогда
			
			//+ ИнфоСофт Стояк Ю.К. 25.11.2024 УА #88226			
			//Для Каждого Строка Из ТаблицаВыгрузки Цикл	
			//	
			//	ИС_МП_УправлениеЦенами.ЗаписатьПоследнююВыгруженнуюЦену(Профиль, 
			//	Перечисления.ИС_МП_Маркетплейсы.Сбер, Строка.НоменклатураСбер, Строка.Цена, Перечисления.ИС_МП_ВидыЦенМаркетплейса.ВидЦены);
			//	
			//КонецЦикла;	
			
			Для Каждого Строка Из Элемент Цикл	   
				
				Отбор = Новый Структура("offerID", Строка.offerId);
				НайденныеСтроки = ТаблицаВыгрузки.НайтиСтроки(Отбор);
				
				Если НайденныеСтроки.Количество() = 1 Тогда	
					
					ИС_МП_УправлениеЦенами.ЗаписатьПоследнююВыгруженнуюЦену(Профиль, 
					Перечисления.ИС_МП_Маркетплейсы.Сбер, НайденныеСтроки[0].НоменклатураСбер, НайденныеСтроки[0].Цена, Перечисления.ИС_МП_ВидыЦенМаркетплейса.ВидЦены);
					
				КонецЕсли;
				
			КонецЦикла;	
			//- ИнфоСофт Стояк Ю.К. 25.11.2024 УА #88226
			
		КонецЕсли; 
		//+ ИнфоСофт Стояк Ю.К. 25.11.2024 УА #88226	
	КонецЦикла; 
	
	ОбщегоНазначения.СообщитьПользователю("Выгрузка цен завершена.");
	//- ИнфоСофт Стояк Ю.К. 25.11.2024 УА #88226
	
КонецПроцедуры //- ИнфоСофт Мурсалимов Д.Р. 13.05.24 УА #66901

