//+ ИнфоСофт Стояк Ю.К. 07.06.2024 УА #76167
Функция ПолучитьДанныеОтправлений(Профиль, МассивОтправлений) Экспорт
	
	Событие = ИмяСобытия("ПолучитьОтправления");
	
	НастройкиСоединения = ПолучитьНастройкиСоединенияПрофиля(Профиль);  
	ПараметрыЗапроса = ИС_MP_РаботаСHTTPЗапросамиСервер.ПолучитьСтруктуруHTTPЗапроса();
	РезультатПроверки = ПроверитьИЗаполнитьПараметрыЗапросаДляСервисаAPI(ПараметрыЗапроса, НастройкиСоединения);
	
	Если Не РезультатПроверки Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	СтруктураПараметров = Новый Структура;
	СтруктураПараметров.Вставить("token", НастройкиСоединения["СберТокен"]);
	СтруктураПараметров.Вставить("shipments", МассивОтправлений);
	
	РезультатЗапроса = ИС_Сбер_API.ПолучитьОтправления(Профиль, ПараметрыЗапроса, СтруктураПараметров);
	
	Если РезультатЗапроса = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Возврат РезультатЗапроса.shipments;
	
КонецФункции //- ИнфоСофт Стояк Ю.К. 07.06.2024 УА #76167

//+ ИнфоСофт Заварин К.В. 26.09.24 УА #77549
Процедура ОтменитьЗаказ(Заказ, Профиль) Экспорт 
	
	ФукнциональныеОпции = ПолучитьИПроверитьФункциональныеОпции(Профиль);
	
	Если ФукнциональныеОпции.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	Если Не ФукнциональныеОпции.УдалятьРТУ Тогда
		Возврат;
	КонецЕсли;
  
	Если ФукнциональныеОпции.ПроверятьДатуПередУдалением Тогда
				
		Если ЗначениеЗаполнено(Заказ.shippingTimeLimit) И ТекущаяДатаСеанса() >= Заказ.shippingTimeLimit Тогда
			Возврат;	
		КонецЕсли;
		
	КонецЕсли;
	
	ИспользоватьПричины = Ложь;
	
	Если Константы.ИспользоватьПричиныОтменыЗаказовКлиентов.Получить() Тогда
		ИспользоватьПричины = Истина;
		Если Не ЗначениеЗаполнено(ФукнциональныеОпции.ПричинаОтмены) Тогда
			Возврат;
		КонецЕсли;
	КонецЕсли;
	
