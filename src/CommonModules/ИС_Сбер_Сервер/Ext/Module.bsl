#Область Товары

//+ ИнфоСофт Ивонин К.А. 03.03.25 УА #92887
Функция КоличествоТоваров(Профиль) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	КОЛИЧЕСТВО(1) КАК Количество
	|ИЗ
	|	Справочник.ИС_Сбер_Номенклатура КАК ИС_Сбер_Номенклатура
	|ГДЕ
	|	ИС_Сбер_Номенклатура.Профиль = &Профиль";
	
	Запрос.УстановитьПараметр("Профиль", Профиль);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаКоличества = РезультатЗапроса.Выбрать();
	
	Если ВыборкаКоличества.Следующий() Тогда
		Возврат ВыборкаКоличества.Количество;
	КонецЕсли;
	
	Возврат 0;
	
КонецФункции //- ИнфоСофт Ивонин К.А. 03.03.25 УА #92887

//+ ИнфоСофт Ивонин К.А. 07.02.25 УА #92406
Функция ОбработатьДопПараметрыЗагрузкиТоваров(ДопПараметры) Экспорт
	
	ПараметрыТаблицы = Новый Структура;
	ПараметрыТаблицы.Вставить("СпособЧтенияЗначений", СпособЧтенияЗначенийТабличногоДокумента.Текст);
	ПараметрыТаблицы.Вставить("ПерваяСтрока", 1);
	ТаблицаТоваров = ИС_МП_Сервер.ТаблицаЗначенийИзExcel(ДопПараметры.Адрес, ПараметрыТаблицы);
	
	Если ТаблицаТоваров = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	МассивУдаляемыхКолонок = Новый Массив;
	
	Для Каждого Колонка Из ТаблицаТоваров.Колонки Цикл
		
		Имя = Колонка.Имя;
		Если Имя = "КодТовараПродавца_offerId_" Или Имя = "НаименованиеМерчанта"
				Или Имя = "ШтрихкодМерчанта" Или Имя = "БрендМерчанта"
				Или Имя = "ВендорКод_артикулПроизводителя_" Тогда
				
			Продолжить;
			
		КонецЕсли;
		
		МассивУдаляемыхКолонок.Добавить(Колонка);
		
	КонецЦикла;

	Для Каждого Колонка Из МассивУдаляемыхКолонок Цикл
		ТаблицаТоваров.Колонки.Удалить(Колонка);
	КонецЦикла;
		
	ДопПараметры = Новый Структура("Таблица", ТаблицаТоваров);
	Возврат ДопПараметры;
	
КонецФункции //- ИнфоСофт Ивонин К.А. 07.02.25 УА #92406

//+ ИнфоСофт Ивонин К.А. 02.03.25 УА #92887
Функция ЗагрузитьТовары(Профиль, Перезаполнять = Ложь, ДопПараметры = Неопределено) Экспорт
	
	ТЗ = Новый ТаблицаЗначений;
	ТЗ.Колонки.Добавить("offerId", ОбщегоНазначения.ОписаниеТипаСтрока(50));
	
	Для Каждого Строка Из ДопПараметры.Таблица Цикл
		
		НоваяСтрока = ТЗ.Добавить();
		НоваяСтрока.offerId = Строка.КодТовараПродавца_offerId_;	
		
	КонецЦикла;
		
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ТЗ.offerId КАК offerId
	|ПОМЕСТИТЬ ВТ_Товары
	|ИЗ
	|	&ТЗ КАК ТЗ
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_Товары.offerId КАК offerId,
	|	ЕСТЬNULL(ИС_Сбер_Номенклатура.Ссылка, ЗНАЧЕНИЕ(Справочник.ИС_Сбер_Номенклатура.ПустаяСсылка)) КАК Ссылка
	|ИЗ
	|	ВТ_Товары КАК ВТ_Товары
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ИС_Сбер_Номенклатура КАК ИС_Сбер_Номенклатура
	|		ПО ВТ_Товары.offerId = ИС_Сбер_Номенклатура.offer_id
	|			И (ИС_Сбер_Номенклатура.Профиль = &Профиль)";
	
	Если Не Перезаполнять Тогда
		
		Запрос.Текст = Запрос.Текст + 
		"
		|ГДЕ
		|	ИС_Сбер_Номенклатура.Ссылка ЕСТЬ NULL";
		
	КонецЕсли;
		
	Запрос.УстановитьПараметр("ТЗ", ТЗ);
	Запрос.УстановитьПараметр("Профиль", Профиль);
		
	РезультатЗапроса = Запрос.Выполнить();
	Выборка = РезультатЗапроса.Выбрать();
	
	ВсегоТоваров = Выборка.Количество();
	
	Счетчик = 0;
	
	Пока Выборка.Следующий() Цикл
		
		НайденныеСтроки = ДопПараметры.Таблица.НайтиСтроки(Новый Структура("КодТовараПродавца_offerId_", Выборка.offerId));
		
		Если НайденныеСтроки.Количество() = 0 Тогда
			Продолжить;
		КонецЕсли;
		
		СоздатьИлиОбновитьТовар(Профиль, Выборка.Ссылка, НайденныеСтроки[0]);

		Если Счетчик % 50 = 0 Тогда
			ДлительныеОперации.СообщитьПрогресс( , "Уже обработано " + Счетчик + " из " + ВсегоТоваров + " товаров");
		КонецЕсли;
		
		Счетчик = Счетчик + 1;
		
	КонецЦикла;
		
	Возврат "Загрузка завершена. Всего обработкано " + Счетчик + " элементов";
	
КонецФункции //- ИнфоСофт Ивонин К.А. 02.03.25 УА #92887

