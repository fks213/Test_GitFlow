Функция ПолучитьНастройкиСоединенияПрофиля(Профиль)
	
	МассивНастроек = Новый Массив;
	МассивНастроек.Добавить("СберАдресСервисаAPI");
	МассивНастроек.Добавить("СберТокен");
	
	Результат = ИС_MP_Сервер.ПолучитьНастройки(Профиль, МассивНастроек);
	
	Если Результат.Количество() = 0 Тогда
		ВызватьИсключение("Не удалось получить настройки подключения, проверьте настройки авторизации");
	КонецЕсли; 
	
	Возврат Результат;
	
