	Событие = ИмяСобытия("СоздатьРеализации");
	
	ФукнциональныеОпции = ПолучитьИПроверитьФункциональныеОпции(Профиль);
	
	Если ФукнциональныеОпции = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ИС_Сбер_Отправление.Ссылка КАК Ссылка,
	|	ИС_Сбер_Отправление.Заказ КАК Заказ,
	|	ИС_Сбер_Отправление.shippingTimeLimit КАК ДатаОтгрузки
	|ПОМЕСТИТЬ ВТ_Заказы
	|ИЗ
	|	Документ.ИС_Сбер_Отправление КАК ИС_Сбер_Отправление
	|ГДЕ
	|	ИС_Сбер_Отправление.Профиль = &Профиль
	|	И НЕ ИС_Сбер_Отправление.Заказ = &Заказ
	|	И ИС_Сбер_Отправление.Ссылка В(&МассивСсылок)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_Заказы.Ссылка КАК Ссылка,
	|	ВТ_Заказы.Заказ КАК Заказ,
	|	ВТ_Заказы.ДатаОтгрузки КАК ДатаОтгрузки,
	|	ВЫБОР КОГДА РеализацияТоваровУслуг.Ссылка IS NULL
	|		ТОГДА 0
	|		ИНАЧЕ 1
	|	КОНЕЦ КАК Реализация
	|ПОМЕСТИТЬ ВТ_Реализации
	|ИЗ
	|	ВТ_Заказы КАК ВТ_Заказы
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.РеализацияТоваровУслуг КАК РеализацияТоваровУслуг
	|		ПО ВТ_Заказы.Заказ = РеализацияТоваровУслуг.ЗаказКлиента
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ВТ_Заказы.Ссылка,
	|	ВТ_Заказы.Заказ,
	|	ВТ_Заказы.ДатаОтгрузки,
	|	ВЫБОР КОГДА РеализацияТоваровУслугТовары.Ссылка IS NULL
	|		ТОГДА 0
	|		ИНАЧЕ 1
	|	КОНЕЦ
	|ИЗ
	|	ВТ_Заказы КАК ВТ_Заказы
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.РеализацияТоваровУслуг.Товары КАК РеализацияТоваровУслугТовары
	|		ПО ВТ_Заказы.Заказ = РеализацияТоваровУслугТовары.ЗаказКлиента
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ВТ_Заказы.Ссылка,
	|	ВТ_Заказы.Заказ,
	|	ВТ_Заказы.ДатаОтгрузки,
	|	ВЫБОР КОГДА ПередачаТоваровХранителю.Ссылка IS NULL
	|		ТОГДА 0
	|		ИНАЧЕ 1
	|	КОНЕЦ
	|ИЗ
	|	ВТ_Заказы КАК ВТ_Заказы
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ПередачаТоваровХранителю.Товары КАК ПередачаТоваровХранителю
	|		ПО ВТ_Заказы.Заказ = ПередачаТоваровХранителю.ЗаказКлиента
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ВТ_Заказы.Ссылка,
	|	ВТ_Заказы.Заказ,
	|	ВТ_Заказы.ДатаОтгрузки,
	|	ВЫБОР КОГДА ПередачаТоваровХранителюТовары.Ссылка IS NULL
	|		ТОГДА 0
	|		ИНАЧЕ 1
	|	КОНЕЦ
	|ИЗ
	|	ВТ_Заказы КАК ВТ_Заказы
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ПередачаТоваровХранителю.Товары КАК ПередачаТоваровХранителюТовары
	|		ПО ВТ_Заказы.Заказ = ПередачаТоваровХранителюТовары.ЗаказКлиента
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_ПолучениеРеализаций.Заказ КАК Заказ,
	|	ВТ_ПолучениеРеализаций.ДатаОтгрузки КАК ДатаОтгрузки,
	|	СУММА(ВТ_ПолучениеРеализаций.Реализация) КАК КоличествоРеализаций
	|ПОМЕСТИТЬ ВТ_КоличествоРеализаций
	|ИЗ
	|	ВТ_Реализации КАК ВТ_ПолучениеРеализаций
	|ГДЕ
	|	НЕ ВТ_ПолучениеРеализаций.Реализация ЕСТЬ NULL
	|
	|СГРУППИРОВАТЬ ПО
	|	ВТ_ПолучениеРеализаций.Заказ,
	|	ВТ_ПолучениеРеализаций.ДатаОтгрузки
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_КоличествоРеализаций.Заказ КАК Заказ,
	|	ВТ_КоличествоРеализаций.ДатаОтгрузки КАК ДатаОтгрузки,
	|	ВТ_КоличествоРеализаций.Заказ.Комментарий КАК Комментарий,
	|	ИС_Сбер_Склады.СтатусРасходногоОрдера КАК СтатусРасходногоОрдера,
	|	ИС_Сбер_Склады.СтатусСтрокиРасходногоОрдера КАК СтатусСтрокиРасходногоОрдера
	|ИЗ
	|	ВТ_КоличествоРеализаций КАК ВТ_КоличествоРеализаций
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ИС_Сбер_Склады КАК ИС_Сбер_Склады
	|		ПО (ИС_Сбер_Склады.Профиль = &Профиль)
	|ГДЕ
	|	ВТ_КоличествоРеализаций.КоличествоРеализаций = 0";

	Запрос.УстановитьПараметр("Профиль", Профиль);
	Запрос.УстановитьПараметр("МассивСсылок", МассивОтправлений);
	Запрос.УстановитьПараметр("Заказ", ИС_MP_СерверЛокализация.ПустаяСсылкаЗаказа());
		
	РезультатЗапроса = Запрос.Выполнить();
	
	Если РезультатЗапроса.Пустой() Тогда
		Возврат;
	КонецЕсли;
	
	ФукнциональныеОпции = ПолучитьИПроверитьФункциональныеОпции(Профиль);
	
	Если ФукнциональныеОпции = Неопределено Тогда
		Возврат;
	КонецЕсли; 
	
	Комиссия25 = ФукнциональныеОпции.Договор.КомиссионныеПродажи25;
	
	Выборка = РезультатЗапроса.Выбрать();
    
    //+ ИнфоСофт Мурсалимов Д.Р. 13.06.24 УА #77595
	ПорядокОформленияНакладныхРасходныхОрдеров = Константы.ПорядокОформленияНакладныхРасходныхОрдеров.Получить();
	//- ИнфоСофт Мурсалимов Д.Р. 13.06.24 УА #77595
	
    Пока Выборка.Следующий() Цикл

		//+ ИнфоСофт Мурсалимов Д.Р. 10.06.24 УА #77595
		Если ПорядокОформленияНакладныхРасходныхОрдеров 
			= Перечисления.ПорядокОформленияНакладныхРасходныхОрдеров.СначалаНакладные Тогда
			
			СоздатьРеализацию(Выборка, ФукнциональныеОпции, Комиссия25);
			
			//+ ИнфоСофт Мурсалимов Д.Р. 19.06.24 УА #77872
			Если ФукнциональныеОпции.АвтоматическиСоздаватьОрдерНаОтгрузку И Выборка.Заказ.Склад.ИспользоватьОрдернуюСхемуПриОтгрузке Тогда		
				ИС_MP_РаботаСЗаказами.СоздатьРасходныйОрдер(  Выборка.Заказ
															, Выборка.СтатусРасходногоОрдера
															, Выборка.СтатусСтрокиРасходногоОрдера);	
			КонецЕсли;
			//- ИнфоСофт Мурсалимов Д.Р. 19.06.24 УА #77872
					
		Иначе
			
			//+ ИнфоСофт Мурсалимов Д.Р. 19.06.24 УА #77872
			Если ФукнциональныеОпции.АвтоматическиСоздаватьОрдерНаОтгрузку И Выборка.Заказ.Склад.ИспользоватьОрдернуюСхемуПриОтгрузке Тогда		
				ИС_MP_РаботаСЗаказами.СоздатьРасходныйОрдер(  Выборка.Заказ
															, Выборка.СтатусРасходногоОрдера
															, Выборка.СтатусСтрокиРасходногоОрдера);	
			КонецЕсли;
			//- ИнфоСофт Мурсалимов Д.Р. 19.06.24 УА #77872
			
			СоздатьРеализацию(Выборка, ФукнциональныеОпции, Комиссия25);
			
		КонецЕсли;
		//- ИнфоСофт Мурсалимов Д.Р. 10.06.24 УА #77595				
			
	КонецЦикла;

КонецПроцедуры //- ИнфоСофт Ивонин К.А. 28.11.23 УА #55166

//+ ИнфоСофт Ивонин К.А. 17.02.24 УА #67209
Процедура ПодтвердитьЛоты(Профиль, МассивShipments) Экспорт

	НастройкиСоединения = ПолучитьНастройкиСоединенияПрофиля(Профиль);  
	ПараметрыЗапроса = ИС_MP_РаботаСHTTPЗапросамиСервер.ПолучитьСтруктуруHTTPЗапроса();
	РезультатПроверки = ПроверитьИЗаполнитьПараметрыЗапросаДляСервисаAPI(ПараметрыЗапроса, НастройкиСоединения);
	
	Если Не РезультатПроверки Тогда
		Возврат;
	КонецЕсли;
	
	Data = Новый Структура;
	Data.Вставить("token", НастройкиСоединения["СберТокен"]);
	Data.Вставить("shipments", МассивShipments);
	
	Результат = ИС_Сбер_API.ПодтвердитьЛотыВОтрпавлении(Профиль, ПараметрыЗапроса, Data);
	
	Если Результат <> Неопределено Тогда
		ОбщегоНазначения.СообщитьПользователю("Лоты подтверждены");
	КонецЕсли;

КонецПроцедуры //- ИнфоСофт Ивонин К.А. 17.02.24 УА #67209

//+ ИнфоСофт Ивонин К.А. 17.02.24 УА #67209
Процедура СкомплектоватьЛоты(Профиль, МассивShipments) Экспорт

	НастройкиСоединения = ПолучитьНастройкиСоединенияПрофиля(Профиль);  
	ПараметрыЗапроса = ИС_MP_РаботаСHTTPЗапросамиСервер.ПолучитьСтруктуруHTTPЗапроса();
	РезультатПроверки = ПроверитьИЗаполнитьПараметрыЗапросаДляСервисаAPI(ПараметрыЗапроса, НастройкиСоединения);
	
	Если Не РезультатПроверки Тогда
		Возврат;
	КонецЕсли;
	
	Data = Новый Структура;
	Data.Вставить("token", НастройкиСоединения["СберТокен"]);
	Data.Вставить("shipments", МассивShipments);
	
	Результат = ИС_Сбер_API.ПодтвердитьКомплектацию(Профиль, ПараметрыЗапроса, Data);
	
	Если Результат <> Неопределено Тогда
		
		//+ ИнфоСофт Заварин К.В. 24.02.25 УА #73904
		Для Каждого Элемент Из МассивShipments Цикл 
			
			ЗаказМП = Документы.ИС_Сбер_Отправление.НайтиПоНомеру(Элемент.shipmentId);
			Запрос = Новый Запрос;
			Запрос.Текст =	
			"ВЫБРАТЬ
			|	ИС_Сбер_Отправление.Ссылка КАК Ссылка
			|ПОМЕСТИТЬ ВТ_СборочныеЗадания
			|ИЗ
			|	Документ.ИС_Сбер_Отправление КАК ИС_Сбер_Отправление
			|ГДЕ
			|	ИС_Сбер_Отправление.Профиль = &Профиль
			|	И ИС_Сбер_Отправление.Ссылка В(&МассивЗаказов)
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ
			|	ИС_Сбер_Отправление_items.Ссылка КАК Заказ,
			|	ИС_Сбер_Товары.Номенклатура КАК Номенклатура,
			|	ИС_Сбер_Товары.Характеристика КАК Характеристика,
			|	СУММА(ИС_Сбер_Отправление_items.quantity) КАК Количество
			|ИЗ
			|	Документ.ИС_Сбер_Отправление.items КАК ИС_Сбер_Отправление_items
			|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ИС_Сбер_Товары КАК ИС_Сбер_Товары
			|		ПО ИС_Сбер_Отправление_items.offerId = ИС_Сбер_Товары.offerID
			|			И (ИС_Сбер_Товары.ЛичныйКабинет = &Профиль)
			|ГДЕ
			|	ИС_Сбер_Отправление_items.Ссылка В
			|			(ВЫБРАТЬ
			|				ВТ_СборочныеЗадания.Ссылка КАК Ссылка
			|			ИЗ
			|				ВТ_СборочныеЗадания КАК ВТ_СборочныеЗадания)
			|
			|СГРУППИРОВАТЬ ПО
			|	ИС_Сбер_Отправление_items.Ссылка,
			|	ИС_Сбер_Товары.Номенклатура,
			|	ИС_Сбер_Товары.Характеристика";
			
			Запрос.УстановитьПараметр("МассивЗаказов", ЗаказМП);
			Запрос.УстановитьПараметр("Профиль", Профиль);
			
			РезультатЗапроса = Запрос.Выполнить();
			
			Выборка = РезультатЗапроса.Выгрузить();
			
			МассивКодов = Новый Массив;
			
			МассивКодов.Добавить(Выборка);
			
			ИС_MP_Сервер.ЗаписатьДанныеКИЗ(Профиль, Перечисления.ИС_МП_Маркетплейсы.Сбер, ЗаказМП, Выборка);
			
		КонецЦикла;                                    
		//- ИнфоСофт Заварин К.В. 24.02.25 УА #73904
		
		ОбщегоНазначения.СообщитьПользователю("Лоты подтверждены");
	КонецЕсли;

КонецПроцедуры //- ИнфоСофт Ивонин К.А. 17.02.24 УА #67209

