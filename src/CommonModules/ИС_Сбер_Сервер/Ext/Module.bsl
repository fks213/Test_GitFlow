#Область ТестПодключения

//+ ИнфоСофт Ивонин К.А. 13.08.23 УА #61542
Функция ТестПодключенияAPI(СтруктураПроверки) Экспорт
                 
	ПараметрыЗапроса = ИС_MP_РаботаСHTTPЗапросамиСервер.ПолучитьСтруктуруHTTPЗапроса(); 
	ПараметрыЗапроса.Сервер = СтруктураПроверки.АдресСервиса;
	ПараметрыЗапроса.Порт = СтруктураПроверки.Порт;
	ПараметрыЗапроса.ЗащищенноеСоединение = СтруктураПроверки.ЗащищенноеСоединение;
	
	СтруктураПараметров = ИС_Сбер_API.ПолучитьСтруктуруЗапросаСпискаОтправлений();
	СтруктураПараметров.token = СтруктураПроверки.Токен;
		                                                       
	Результат = ИС_Сбер_API.ПолучитьСписокОтправлений(СтруктураПроверки.Профиль, ПараметрыЗапроса, СтруктураПараметров);

	Если Результат = Неопределено Тогда	
		Возврат Ложь;	
	Иначе
		Возврат Истина;
	КонецЕсли;

КонецФункции //- ИнфоСофт Ивонин К.А. 13.08.23 УА #61542

