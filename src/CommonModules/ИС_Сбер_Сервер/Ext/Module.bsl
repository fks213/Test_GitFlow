//+ ИнфоСофт Ивонин К.А. 13.08.23 УА #55166
Функция ПроверитьИЗаполнитьПараметрыЗапросаДляСервисаAPI(ПараметрыЗапроса, НастройкиСоединения)
	
	Если Не ЗначениеЗаполнено(НастройкиСоединения["СберАдресСервисаAPI"]) Тогда
		ОбщегоНазначения.СообщитьПользователю(
		"Для данного профиля не заполнен ""Адрес Сервиса API"" Мега Маркета, проверьте настройки авторизации");
		Возврат Ложь;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(НастройкиСоединения["СберТокен"]) Тогда
		ОбщегоНазначения.СообщитьПользователю(
		"Для данного профиля не заполнен ""Токен"" Мега Маркета, проверьте настройки авторизации");
		Возврат Ложь;
	КонецЕсли;
	
	ПараметрыЗапроса.Сервер = НастройкиСоединения["СберАдресСервисаAPI"];
	
	//ПараметрыЗапроса.Порт = НастройкиСоединения.Порт;
	//ПараметрыЗапроса.ЗащищенноеСоединение = НастройкиСоединения.ЗащищенноеСоединение;
	ПараметрыЗапроса.Порт = 443;
	ПараметрыЗапроса.ЗащищенноеСоединение = Истина;
	
	Возврат Истина;	
	
КонецФункции //- ИнфоСофт Ивонин К.А. 13.08.23 УА #55166

//+ ИнфоСофт Ивонин К.А. 28.08.23 УА #61542
Процедура ПолучитьОтправления(Профиль, МассивОтправлений)
	
	Событие = ИмяСобытия("ПолучитьОтправления");
	
	НастройкиСоединения = ПолучитьНастройкиСоединенияПрофиля(Профиль);  
	ПараметрыЗапроса = ИС_MP_РаботаСHTTPЗапросамиСервер.ПолучитьСтруктуруHTTPЗапроса();
	РезультатПроверки = ПроверитьИЗаполнитьПараметрыЗапросаДляСервисаAPI(ПараметрыЗапроса, НастройкиСоединения);
	
	Если Не РезультатПроверки Тогда
		Возврат;
	КонецЕсли;
	
	СтруктураПараметров = Новый Структура;
	СтруктураПараметров.Вставить("token", НастройкиСоединения["СберТокен"]);
	СтруктураПараметров.Вставить("shipments", МассивОтправлений);
	
	РезультатЗапроса = ИС_Сбер_API.ПолучитьОтправления(Профиль, ПараметрыЗапроса, СтруктураПараметров);
	
	Если РезультатЗапроса = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	МассивСозданныхОтправлений = Новый Массив;
	
	Для Каждого Отправление Из РезультатЗапроса.shipments Цикл
		
		Результат = НайтиИлиСоздатьОтправление(Профиль, Отправление);
		
		Если Не Результат.Пустая() Тогда
			МассивСозданныхОтправлений.Добавить(Результат);
		КонецЕсли;
		
	КонецЦикла; 
	
	ПроверитьФункциональныеОпцииОтправлений(Профиль, МассивСозданныхОтправлений);
	
КонецПроцедуры //- ИнфоСофт Ивонин К.А. 28.08.23 УА #61542

//+ ИнфоСофт Ивонин К.А. 29.08.23 УА #61542
Функция НайтиИлиСоздатьОтправление(Профиль, Данные) 
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ИС_Сбер_Отправление.Ссылка КАК Ссылка
	|ИЗ
	|	Документ.ИС_Сбер_Отправление КАК ИС_Сбер_Отправление
	|ГДЕ
	|	ИС_Сбер_Отправление.Профиль = &Профиль
	|	И ИС_Сбер_Отправление.Номер = &Номер";
	
	Запрос.УстановитьПараметр("Номер", Данные.shipmentId);
	Запрос.УстановитьПараметр("Профиль", Профиль);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Отправление = Документы.ИС_Сбер_Отправление.НайтиПоНомеру(Данные.shipmentId);
	
	Если РезультатЗапроса.Пустой() Тогда 
		ОтправлениеОбъект = Документы.ИС_Сбер_Отправление.СоздатьДокумент();
	Иначе
		
		Выборка = РезультатЗапроса.Выбрать();
		Выборка.Следующий();
		ОтправлениеОбъект = Выборка.Ссылка.ПолучитьОбъект();
		
	КонецЕсли;
	
	ОтправлениеОбъект.Профиль = Профиль;
	ОтправлениеОбъект.Номер = Данные.shipmentId;
	ОтправлениеОбъект.Дата = ИС_MP_РаботаСHTTPЗапросамиСервер.ПрочитатьДатуИзJSON(Данные.creationDate, ФорматДатыJSON.ISO); 
	
	ЗаполнитьЗначенияСвойств(ОтправлениеОбъект, Данные);
	
	ОтправлениеОбъект.status = ИС_MP_Сервер.ПолучитьПеречислениеПоЗначению(Перечисления.ИС_Сбер_СтатусыОтправлений, Данные.status);
	
	ОтправлениеОбъект.confirmedTimeLimit = ИС_MP_РаботаСHTTPЗапросамиСервер.ПрочитатьДатуИзJSON(Данные.confirmedTimeLimit, ФорматДатыJSON.ISO);
	ОтправлениеОбъект.packingTimeLimit = ИС_MP_РаботаСHTTPЗапросамиСервер.ПрочитатьДатуИзJSON(Данные.packingTimeLimit, ФорматДатыJSON.ISO);
	ОтправлениеОбъект.shippingTimeLimit = ИС_MP_РаботаСHTTPЗапросамиСервер.ПрочитатьДатуИзJSON(Данные.shippingTimeLimit, ФорматДатыJSON.ISO);
	ОтправлениеОбъект.shipmentDateFrom = ИС_MP_РаботаСHTTPЗапросамиСервер.ПрочитатьДатуИзJSON(Данные.shipmentDateFrom, ФорматДатыJSON.ISO);
	ОтправлениеОбъект.shipmentDateTo = ИС_MP_РаботаСHTTPЗапросамиСервер.ПрочитатьДатуИзJSON(Данные.shipmentDateTo, ФорматДатыJSON.ISO);
	ОтправлениеОбъект.deliveryDate = ИС_MP_РаботаСHTTPЗапросамиСервер.ПрочитатьДатуИзJSON(Данные.deliveryDate, ФорматДатыJSON.ISO);
	ОтправлениеОбъект.deliveryDateFrom = ИС_MP_РаботаСHTTPЗапросамиСервер.ПрочитатьДатуИзJSON(Данные.deliveryDateFrom, ФорматДатыJSON.ISO);
	ОтправлениеОбъект.deliveryDateTo = ИС_MP_РаботаСHTTPЗапросамиСервер.ПрочитатьДатуИзJSON(Данные.deliveryDateTo, ФорматДатыJSON.ISO);
	
	ОтправлениеОбъект.items.Очистить();
	
	Для Каждого Элемент Из Данные.items Цикл 
		
		//+ ИнфоСофт Стояк Ю.К. 19.11.2024 УА #87738		
		Если Элемент.offerId = "delivery" Тогда
			Продолжить;
		КонецЕсли;                                  
		//- ИнфоСофт Стояк Ю.К. 19.11.2024 УА #87738
		
		НоваяСтрока = ОтправлениеОбъект.items.Добавить();
		
		ЗаполнитьЗначенияСвойств(НоваяСтрока, Элемент);
		
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	ИС_Сбер_Номенклатура.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.ИС_Сбер_Номенклатура КАК ИС_Сбер_Номенклатура
		|ГДЕ
		|	ИС_Сбер_Номенклатура.Профиль = &Профиль
		|	И ИС_Сбер_Номенклатура.offer_id = &offer_id";
		
		Запрос.УстановитьПараметр("offer_id", Элемент.offerId);
		Запрос.УстановитьПараметр("Профиль", Профиль);
		
		РезультатЗапроса = Запрос.Выполнить();
		
		Выборка = РезультатЗапроса.Выбрать();
		
		Если Выборка.Следующий() Тогда
			НоваяСтрока.НоменклатураМегаМаркета = Выборка.Ссылка;	
		КонецЕсли;
		
		НоваяСтрока.status = ИС_MP_Сервер.ПолучитьПеречислениеПоЗначению(Перечисления.ИС_Сбер_СтатусыОтправлений, Элемент.status); 
		НоваяСтрока.subStatus = ИС_MP_Сервер.ПолучитьПеречислениеПоЗначению(Перечисления.ИС_Сбер_ДетализацияСтатусовОтмены, Элемент.subStatus);
		
	КонецЦикла;      
	
	//  "items": [
	//    {
	//      "discounts": [
	//        {
	//          "discountType": "SPASIBO",
	//          "discountDescription": "Скидка от СберСпасибо для ЕПЛ (МРЦ-2023)",
	//          "discountAmount": 8225
	//        }
	//      ],
	//      "priceAdjustments": [
	//        {
	//          "priceAdjustmentType": "SuperPrice",
	//          "priceAdjustmentDescription": "SuperPrice",
	//          "priceAdjustmentAmount": 6400
	//        }
	//      ],
	//      "goodsData": {
	//        "name": "Вытяжка встраиваемая Schaub Lorenz SLD EY5004 1М Black",
	//        "isDelivery": false,
	//        "categoryName": "",
	//        "isDigitalMarkRequired": false
	//      },                      
	
	// Нет смысла добавлять, выглядит как бесполезная информация
	//      "events": [
	//        {
	//          "eventDate": "2023-08-28T19:10:40+03:00",
	//          "eventName": "СТАТУС_РЕЗУЛЬТАТ_ВЫПОЛНЕНИЯ",
	//          "eventValue": "Выполняется"
	//        },
	//		...
	//	    ]
	
	Попытка
		
		ОтправлениеОбъект.Записать();
		Возврат ОтправлениеОбъект.Ссылка;
		
	Исключение
		ОбщегоНазначения.СообщитьПользователю(ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;
	
	Возврат Документы.ИС_Сбер_Отправление.ПустаяСсылка();
	
КонецФункции //- ИнфоСофт Ивонин К.А. 29.08.23 УА #61542

//+ ИнфоСофт Ивонин К.А. 29.03.23 УА #55822
Функция ПолучитьИПроверитьФункциональныеОпции(Профиль)
	
	Событие = ИмяСобытия("ПолучитьИПроверитьФункциональныеОпции");
	
	ФункциональныеОпции = ИС_Сбер_СерверПовтИсп.ПолучитьНастройкиФункциональностиЗаказов(Профиль);
	
	Результат = Истина;
	
	Если ФункциональныеОпции.Количество() = 0 Тогда
		Результат = Ложь;
	КонецЕсли;
	
	Сообщение = "Не заполнены параметры создания заказов МегаМаркета: ";
	
	Если Не ФункциональныеОпции.Свойство("Организация") И Не ЗначениеЗаполнено(ФункциональныеОпции.Организация) Тогда
		Сообщение = Сообщение + "Организация; ";
		Результат = Ложь;
	КонецЕсли;
	
	//Если Не ЗначениеЗаполнено(ФункциональныеОпции.Контрагент) Тогда
	//	Сообщение = Сообщение + "Контрагент; ";
	//	Результат = Ложь;
	//КонецЕсли;
	
	Если Не ФункциональныеОпции.Свойство("Партнер") И Не ЗначениеЗаполнено(ФункциональныеОпции.Партнер) Тогда
		Сообщение = Сообщение + "Партнер; ";
		Результат = Ложь;
	КонецЕсли;
	
	Если Константы.ИспользоватьСоглашенияСКлиентами.Получить() Тогда	
		Если Не ФункциональныеОпции.Свойство("Соглашение") И Не ЗначениеЗаполнено(ФункциональныеОпции.Соглашение) Тогда
			Сообщение = Сообщение + "Соглашение; ";
			Результат = Ложь;
		КонецЕсли;
	КонецЕсли; 
	
	Если Константы.ИспользоватьДоговорыСКлиентами.Получить() Тогда
		Если Не ФункциональныеОпции.Свойство("Договор") И Не ЗначениеЗаполнено(ФункциональныеОпции.Договор) Тогда
			Сообщение = Сообщение + "Договор; ";
			Результат = Ложь;
		КонецЕсли;
	КонецЕсли;
	
	Если Константы.ИспользоватьРасширенныеВозможностиЗаказаКлиента.Получить() Тогда
		Если ФункциональныеОпции.Свойство("СтатусЗаказаКлиента") И Не ЗначениеЗаполнено(ФункциональныеОпции.СтатусЗаказаКлиента) Тогда
			Сообщение = Сообщение + "Статус Заказа Клиента; ";
			Результат = Ложь;
		КонецЕсли;  
	КонецЕсли;
	
	Если Константы.ИспользоватьПострочнуюОтгрузкуВЗаказеКлиента.Получить() Тогда
		Если ФункциональныеОпции.Свойство("ВариантОбеспечения") И Не ЗначениеЗаполнено(ФункциональныеОпции.ВариантОбеспечения) Тогда
			Сообщение = Сообщение + "Вариант Обеспечения; ";
			Результат = Ложь;
		КонецЕсли;
	КонецЕсли;
	
	//+ ИнфоСофт Стояк Ю.К. 26.01.2024 УА #67208	
	Если Не ФункциональныеОпции.Свойство("ЦенаЛотаВЗаказ") И Не ЗначениеЗаполнено(ФункциональныеОпции.ЦенаЛотаВЗаказ) Тогда
		ФункциональныеОпции.Вставить("ЦенаЛотаВЗаказ", Ложь);
	КонецЕсли;                                  
	//- ИнфоСофт Стояк Ю.К. 26.01.2024 УА #67208  
	
	//+ ИнфоСофт Стояк Ю.К. 07.03.2024 УА #66113
	Если Не ФункциональныеОпции.Свойство("ДатаОтгрузкиИлиТекущаяДатаВРеализацию") Тогда
		ФункциональныеОпции.Вставить("ДатаОтгрузкиИлиТекущаяДатаВРеализацию", Ложь);
	КонецЕсли; 
	//- ИнфоСофт Стояк Ю.К. 07.03.2024 УА #66113
	
	//+ ИнфоСофт Стояк Ю.К. 07.03.2024 УА #66113
	Если Не ФункциональныеОпции.Свойство("ВариантОбеспеченияПриНехватке") Тогда
		ФункциональныеОпции.Вставить("ВариантОбеспеченияПриНехватке", Неопределено);
	КонецЕсли; 
	//- ИнфоСофт Стояк Ю.К. 07.03.2024 УА #66113
	
	//+ ИнфоСофт Заварин К.В. 26.09.24 УА #77549
	//+ ИнфоСофт Мурсалимов Д.Р. 22.03.24 УА #71529
	//Если Не ФункциональныеОпции.Свойство("СберРассчитатьНесобранныеКомплекты") Тогда
	//	ФункциональныеОпции.Вставить("СберРассчитатьНесобранныеКомплекты", Ложь);
	//КонецЕсли;
	//
	//Если Не ФункциональныеОпции.Свойство("СберСоздатьЗаказНаСборку") Тогда
	//	ФункциональныеОпции.Вставить("СберСоздатьЗаказНаСборку", Ложь);
	//КонецЕсли;
	//- ИнфоСофт Мурсалимов Д.Р. 22.03.24 УА #71529
	Если Не ФункциональныеОпции.Свойство("РассчитатьНесобранныеКомплекты") Тогда
		ФункциональныеОпции.Вставить("РассчитатьНесобранныеКомплекты", Ложь);
	КонецЕсли;
	
	Если Не ФункциональныеОпции.Свойство("СоздатьЗаказНаСборку") Тогда
		ФункциональныеОпции.Вставить("СоздатьЗаказНаСборку", Ложь);
	КонецЕсли;
	//- ИнфоСофт Заварин К.В. 26.09.24 УА #77549
	
	//+ ИнфоСофт Стояк Ю.К. 09.04.2024 УА #73643
		Если Не ФункциональныеОпции.Свойство("ФормироватьЕдиныйЗаказБезРазбиения") Тогда
		ФункциональныеОпции.Вставить("ФормироватьЕдиныйЗаказБезРазбиения", Ложь);
	КонецЕсли;
	//- ИнфоСофт Стояк Ю.К. 09.04.2024 УА #73643
	
	//+ ИнфоСофт Заварин К.В. 26.04.24 УА #74175
	Если Не ФункциональныеОпции.Свойство("ЗакрытиеЗаказаПоДатеОтгрузки") Тогда
		ФункциональныеОпции.Вставить("ЗакрытиеЗаказаПоДатеОтгрузки", Ложь);
	КонецЕсли;
	//- ИнфоСофт Заварин К.В. 26.04.24 УА #74175 
	
	//+ ИнфоСофт Заварин К.В. 26.09.24 УА #77549
	Если Не ФункциональныеОпции.Свойство("УдалятьРТУ") Тогда
		ФункциональныеОпции.Вставить("УдалятьРТУ", Ложь);
	КонецЕсли;
	
	Если Не ФункциональныеОпции.Свойство("ПроверятьДатуПередУдалением") Тогда
		ФункциональныеОпции.Вставить("ПроверятьДатуПередУдалением", Ложь);
	КонецЕсли; 
	
	Если Не ФункциональныеОпции.Свойство("ПричинаОтмены") Тогда
		ФункциональныеОпции.Вставить("ПричинаОтмены", Ложь);
	КонецЕсли;
	//- ИнфоСофт Заварин К.В. 26.09.24 УА #77549
	
	//+ ИнфоСофт Заварин К.В. 26.04.24 УА #72472
	Если Не ФункциональныеОпции.Свойство("АвтоматическиПодтверждатьЗаказы") Тогда
		ФункциональныеОпции.Вставить("АвтоматическиПодтверждатьЗаказы", Ложь);
	КонецЕсли;
	//- ИнфоСофт Заварин К.В. 26.04.24 УА #72472
	
	//+ ИнфоСофт Заварин К.В. 13.02.25 УА #93503
	Если Не ФункциональныеОпции.Свойство("ОтделятьТоварыПриНехватке") Тогда
		ФункциональныеОпции.Вставить("ОтделятьТоварыПриНехватке", Ложь);
	КонецЕсли;
	//- ИнфоСофт Заварин К.В. 13.02.25 УА #93503
	
	//+ ИнфоСофт Мурсалимов Д.Р. 19.06.24 УА #77872
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ИС_Сбер_Склады.АвтоматическиСоздаватьОрдерНаОтгрузку КАК АвтоматическиСоздаватьОрдерНаОтгрузку
	|ИЗ
	|	Справочник.ИС_Сбер_Склады КАК ИС_Сбер_Склады
	|ГДЕ
	|	ИС_Сбер_Склады.Профиль = &Профиль";
	
	Запрос.УстановитьПараметр("Профиль", Профиль);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Если ВыборкаДетальныеЗаписи.Следующий() Тогда
		ФункциональныеОпции.Вставить("АвтоматическиСоздаватьОрдерНаОтгрузку", ВыборкаДетальныеЗаписи.АвтоматическиСоздаватьОрдерНаОтгрузку);
	Иначе
		ФункциональныеОпции.Вставить("АвтоматическиСоздаватьОрдерНаОтгрузку", Ложь);
	КонецЕсли;;
	//- ИнфоСофт Мурсалимов Д.Р. 19.06.24 УА #77872
	
	Если Не Результат Тогда
		ИС_MP_Сервер.ЗаписатьВЖРИСообщитьПользователю(Событие, Сообщение);
		Возврат Неопределено;
	КонецЕсли;
	
	Возврат ФункциональныеОпции; 
	
КонецФункции //- ИнфоСофт Ивонин К.А. 29.03.23 УА #55822

//+ ИнфоСофт Ивонин К.А. 28.11.23 УА #55166
Процедура ПроверитьФункциональныеОпцииОтправлений(Профиль, МассивОтправлений)
	
	ФукнциональныеОпции = ПолучитьИПроверитьФункциональныеОпции(Профиль);
	
	Если ФукнциональныеОпции = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если ФукнциональныеОпции.СоздаватьЗаказы Тогда	
		СоздатьЗаказы(Профиль, МассивОтправлений);		
	КонецЕсли;
	
	Если ФукнциональныеОпции.СоздаватьРеализации 
		И ФукнциональныеОпции.РежимСозданияЗаказов <> 2 Тогда	
		СоздатьРеализации(Профиль, МассивОтправлений);		
	КонецЕсли;
	
КонецПроцедуры //- ИнфоСофт Ивонин К.А. 28.11.23 УА #55166

//+ ИнфоСофт Стояк Ю.К. 09.04.2024 УА #73643
Функция ПолучитьАктивныйЗаказКлиента(СборочноеЗадание, ДатаОтгрузки)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ИС_Сбер_ЗаказыВТеченииДня.ЗаказКлиента КАК ЗаказКлиента
	|ИЗ
	|	РегистрСведений.ИС_Сбер_ЗаказыВТеченииДня КАК ИС_Сбер_ЗаказыВТеченииДня
	|ГДЕ
	|	ИС_Сбер_ЗаказыВТеченииДня.ЗаказОткрыт
	|	И ИС_Сбер_ЗаказыВТеченииДня.ДатаОтгрузки = &ДатаОтгрузки
	|	И ИС_Сбер_ЗаказыВТеченииДня.Профиль = &Профиль";
	
	Запрос.УстановитьПараметр("ДатаОтгрузки", ДатаОтгрузки);
	Запрос.УстановитьПараметр("Профиль", СборочноеЗадание.Профиль);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Если РезультатЗапроса.Пустой() Тогда
		Возврат Неопределено;	
	КонецЕсли; 	
	
	ВыборкаДетальныеЗаписи.Следующий();	
	
	Возврат ВыборкаДетальныеЗаписи.ЗаказКлиента;
	
