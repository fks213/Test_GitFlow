#Область Отправления

//+ ИнфоСофт Ивонин К.А. 13.08.23 УА #61542
Процедура ПолучитьСписокОтправлений(Профиль, ДатаНачала, ДатаОкончания = Неопределено) Экспорт

	Событие = ИмяСобытия("ПолучитьСписокОтправлений");

	НастройкиСоединения = ПолучитьНастройкиСоединенияПрофиля(Профиль);  
	ПараметрыЗапроса = ИС_MP_РаботаСHTTPЗапросамиСервер.ПолучитьСтруктуруHTTPЗапроса();
	РезультатПроверки = ПроверитьИЗаполнитьПараметрыЗапросаДляСервисаAPI(ПараметрыЗапроса, НастройкиСоединения);
	
	Если Не РезультатПроверки Тогда
		Возврат;
	КонецЕсли;
	
	СтруктураПараметров = ИС_Сбер_API.ПолучитьСтруктуруЗапросаСпискаОтправлений();
	СтруктураПараметров.token = НастройкиСоединения["СберТокен"];
	СтруктураПараметров.dateFrom = ДатаНачала;
	СтруктураПараметров.dateTo = ДатаОкончания;
	СтруктураПараметров.count = 1000;
	//СтруктураПараметров.statuses = Новый Массив;
	
	РезультатЗапроса = ИС_Сбер_API.ПолучитьСписокОтправлений(Профиль, ПараметрыЗапроса, СтруктураПараметров);
	
	Если РезультатЗапроса = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	МассивОтправлений = Новый Массив;
	
	Для Каждого Отправление Из РезультатЗапроса.shipments Цикл
		МассивОтправлений.Добавить(Отправление);
	КонецЦикла;
	
	Если МассивОтправлений.Количество() = 0 Тогда
		ОбщегоНазначения.СообщитьПользователю("Нет новых заказов от " + ДатаНачала);
		Возврат;
	КонецЕсли;
	
	ПолучитьОтправления(Профиль, МассивОтправлений);	
				
КонецПроцедуры //- ИнфоСофт Ивонин К.А. 13.08.23 УА #61542

//+ ИнфоСофт Ивонин К.А. 12.11.23 УА #55166
Функция ПолучитьДатуПоследнегоЗаказа(Профиль) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	ИС_Сбер_Отправление.Дата КАК Дата
	|ИЗ
	|	Документ.ИС_Сбер_Отправление КАК ИС_Сбер_Отправление
	|ГДЕ
	|	ИС_Сбер_Отправление.Профиль = &Профиль
	|
	|УПОРЯДОЧИТЬ ПО
	|	Дата УБЫВ";
	
	Запрос.УстановитьПараметр("Профиль", Профиль);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Если РезультатЗапроса.Пустой() Тогда
		Возврат НачалоДня(ТекущаяДатаСеанса());
	КонецЕсли;
	
	Выборка = РезультатЗапроса.Выбрать();
	
	Выборка.Следующий();
	
	Возврат Выборка.Дата;
	
КонецФункции //- ИнфоСофт Ивонин К.А. 12.11.23 УА #55166

//+ ИнфоСофт Ивонин К.А. 12.11.23 УА #55156
Процедура ОбновитьСтатусы(Профиль) Экспорт
	
	Событие = ИмяСобытия("ОбновитьСтатусы");
	
	НастройкиСоединения = ПолучитьНастройкиСоединенияПрофиля(Профиль);  
	ПараметрыЗапроса = ИС_MP_РаботаСHTTPЗапросамиСервер.ПолучитьСтруктуруHTTPЗапроса();
	РезультатПроверки = ПроверитьИЗаполнитьПараметрыЗапросаДляСервисаAPI(ПараметрыЗапроса, НастройкиСоединения);
	
	//+ ИнфоСофт Заварин К.В. 30.09.24 УА #72472
	ФункциональныеОпции = ПолучитьИПроверитьФункциональныеОпции(Профиль);
	//- ИнфоСофт Заварин К.В. 30.09.24 УА #72472
	
	Если Не РезультатПроверки Тогда
		Возврат;
	КонецЕсли;
	
	МассивСтатусов = Новый Массив;
	МассивСтатусов.Добавить(Перечисления.ИС_Сбер_СтатусыОтправлений.CONFIRMED);
	МассивСтатусов.Добавить(Перечисления.ИС_Сбер_СтатусыОтправлений.NEW);
	МассивСтатусов.Добавить(Перечисления.ИС_Сбер_СтатусыОтправлений.PACKED);
	МассивСтатусов.Добавить(Перечисления.ИС_Сбер_СтатусыОтправлений.PENDING);
	МассивСтатусов.Добавить(Перечисления.ИС_Сбер_СтатусыОтправлений.PENDING_CONFIRMATION);
	МассивСтатусов.Добавить(Перечисления.ИС_Сбер_СтатусыОтправлений.PENDING_PACKING);   
	// Почему-то имеются зависшие статусы более чем месяц назад
	//МассивСтатусов.Добавить(Перечисления.ИС_Сбер_СтатусыОтправлений.PENDING_SHIPPING);
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ИС_Сбер_Отправление.Ссылка КАК Ссылка,
	|	ИС_Сбер_Отправление.Номер КАК Номер,
	|	ИС_Сбер_Отправление.status КАК status
	|ИЗ
	|	Документ.ИС_Сбер_Отправление КАК ИС_Сбер_Отправление
	|ГДЕ
	|	ИС_Сбер_Отправление.status В(&status)
	|	И ИС_Сбер_Отправление.Профиль = &Профиль";
	
	Запрос.УстановитьПараметр("Профиль", Профиль);
	Запрос.УстановитьПараметр("status", МассивСтатусов);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Если РезультатЗапроса.Пустой() Тогда
		Возврат;
	КонецЕсли;
	
	СписокОтправлений = РезультатЗапроса.Выгрузить();
	
	МассивОтправлений = Новый Массив;
	
	Для Каждого Строка Из СписокОтправлений Цикл
		МассивОтправлений.Добавить(Строка.Номер);
	КонецЦикла;
	
	СтруктураПараметров = Новый Структура;
	СтруктураПараметров.Вставить("token", НастройкиСоединения["СберТокен"]);
	СтруктураПараметров.Вставить("shipments", МассивОтправлений);
	
	РезультатЗапроса = ИС_Сбер_API.ПолучитьОтправления(Профиль, ПараметрыЗапроса, СтруктураПараметров);
	
	Если РезультатЗапроса = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	СтруктураПоиска = Новый Структура("Номер", "0");
	
	Для Каждого Отправление Из РезультатЗапроса.shipments Цикл
		
		СтруктураПоиска.Номер = Отправление.shipmentId;
		НайденныеСтроки = СписокОтправлений.НайтиСтроки(СтруктураПоиска);
		
		Если НайденныеСтроки.Количество() = 0 Тогда
			Продолжить;
		КонецЕсли;
		
		Статус = ИС_MP_Сервер.ПолучитьПеречислениеПоЗначению(Перечисления.ИС_Сбер_СтатусыОтправлений, Отправление.status);
		
		Если НайденныеСтроки[0].status = Статус Тогда
			Продолжить;
		КонецЕсли;
		
		ОтправлениеОбъект = НайденныеСтроки[0].Ссылка.ПолучитьОбъект();
		ОтправлениеОбъект.status = Статус; 
		//+ ИнфоСофт Стояк Ю.К. 12.04.2024 УА #73943
		ОтправлениеОбъект.orderCode = Отправление.orderCode;
		//- ИнфоСофт Стояк Ю.К. 12.04.2024 УА #73943
		
		//+ ИнфоСофт Заварин К.В. 26.09.24 УА #77549
		Если ОтправлениеОбъект.status = Перечисления.ИС_Сбер_СтатусыОтправлений.CUSTOMER_CANCELED 
			ИЛИ ОтправлениеОбъект.status = Перечисления.ИС_Сбер_СтатусыОтправлений.MERCHANT_CANCELED Тогда
			Заказ = НайденныеСтроки[0].Ссылка; 
			ОтменитьЗаказ(Заказ, Профиль);	
		КонецЕсли;
		//- ИнфоСофт Заварин К.В. 26.09.24 УА #77549
		
		Попытка
			ОтправлениеОбъект.Записать();
			СписокОтправлений.Удалить(НайденныеСтроки[0]);	
		Исключение
			ИС_MP_Сервер.ЗаписатьВЖРИСообщитьПользователю(Событие, ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		КонецПопытки;
		
	КонецЦикла;
	
	//+ ИнфоСофт Заварин К.В. 30.09.24 УА #72472 
	Если ФункциональныеОпции.АвтоматическиПодтверждатьЗаказы Тогда
		
		МассивСтатусовПодтверждения = Новый Массив;
		МассивСтатусовПодтверждения.Добавить(Перечисления.ИС_Сбер_СтатусыОтправлений.NEW); 
		
		Запрос = Новый Запрос;
		Запрос.Текст =	
		"ВЫБРАТЬ
		|	ИС_Сбер_Отправлениеitems.Ссылка.Номер КАК Номер,
		|	ИС_Сбер_Отправлениеitems.itemIndex КАК ПорядковыйНомер,
		|	ИС_Сбер_Отправлениеitems.offerId КАК Артикул,
		|	ЕСТЬNULL(ИС_Сбер_Отправлениеitems.Ссылка.Заказ.Номер, """") КАК НомерЗаказа
		|ПОМЕСТИТЬ ВТ_Заказы
		|ИЗ
		|	Документ.ИС_Сбер_Отправление.items КАК ИС_Сбер_Отправлениеitems
		|ГДЕ
		|	ИС_Сбер_Отправлениеitems.status В(&Статусы)
		|	И ИС_Сбер_Отправлениеitems.Ссылка.Заказ.Номер ЕСТЬ НЕ NULL
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ВТ_Заказы.Номер КАК Номер,
		|	ВТ_Заказы.ПорядковыйНомер КАК ПорядковыйНомер,
		|	ВТ_Заказы.Артикул КАК Артикул,
		|	ВТ_Заказы.НомерЗаказа КАК НомерЗаказа
		|ИЗ
		|	ВТ_Заказы КАК ВТ_Заказы  
		|ИТОГИ ПО
		|	Номер,
		|	НомерЗаказа";
		
		Запрос.УстановитьПараметр("Статусы", МассивСтатусовПодтверждения);
		
		РезультатЗапроса = Запрос.Выполнить();
		
		ВыборкаНомер = РезультатЗапроса.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
		
		МассивShipments = Новый Массив;
		
		Пока ВыборкаНомер.Следующий() Цикл
			
			СтруктураShipment = Новый Структура;
			СтруктураShipment.Вставить("shipmentId", ВыборкаНомер.Номер);
			
			ВыборкаНомерЗаказа = ВыборкаНомер.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
			
			Пока ВыборкаНомерЗаказа.Следующий() Цикл
				
				Если Не ПустаяСтрока(ВыборкаНомерЗаказа.НомерЗаказа) Тогда
					
					МассивНомерЗаказа = СтрРазделить(ВыборкаНомерЗаказа.НомерЗаказа, "-");
					МассивНомерЗаказа = СтрШаблон("%1%2", 
					Формат(Год(ТекущаяДатаСеанса()), "ЧГ=0"), МассивНомерЗаказа[МассивНомерЗаказа.ВГраница()]); 
					
					СтруктураShipment.Вставить("orderCode", МассивНомерЗаказа);
				Иначе
					СтруктураShipment.Вставить("orderCode", ВыборкаНомерЗаказа.НомерЗаказа);	
				КонецЕсли;	
					
				МассивItems = Новый Массив;
				ВыборкаЛотов = ВыборкаНомерЗаказа.Выбрать();
				
				Пока ВыборкаЛотов.Следующий() Цикл
					
					СтруктураItem = Новый Структура;
					СтруктураItem.Вставить("itemIndex", ВыборкаЛотов.ПорядковыйНомер);
					СтруктураItem.Вставить("offerId", ВыборкаЛотов.Артикул);
					
					МассивItems.Добавить(СтруктураItem);
					
				КонецЦикла;
				
				СтруктураShipment.Вставить("items", МассивItems);
				
			КонецЦикла;
			
			МассивShipments.Добавить(СтруктураShipment);
			
		КонецЦикла;
		
		Если Не МассивShipments.Количество() = 0 Тогда
			ПодтвердитьЛоты(Профиль, МассивShipments);
		КонецЕсли;
		
	КонецЕсли;
	//- ИнфоСофт Заварин К.В. 30.09.24 УА #72472
	
КонецПроцедуры //- ИнфоСофт Ивонин К.А. 12.11.23 УА #55156

//+ ИнфоСофт Ивонин К.А. 12.11.23 УА #55166
Функция ПолучитьЭтикетки(Профиль, МассивЗаказов) Экспорт
	
	Событие = ИмяСобытия("ПолучитьСписокОтправлений");
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ИС_MP_Настройки.Значение КАК Значение
	|ИЗ
	|	Справочник.ИС_MP_Настройки КАК ИС_MP_Настройки
	|ГДЕ
	|	ИС_MP_Настройки.ЛичныйКабинет = &Профиль
	|	И ИС_MP_Настройки.Наименование = ""СберИдКабинета""";
	
	Запрос.УстановитьПараметр("Профиль", Профиль);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Если РезультатЗапроса.Пустой() Тогда
		ОбщегоНазначения.СообщитьПользователю("Необходимо заполнить ""ID Личного кабинета"" МегаМаркета в настройках профиля");
		Возврат Неопределено;
	КонецЕсли; 
	
	Выборка = РезультатЗапроса.Выбрать();
	Выборка.Следующий();
	
	Ид = Выборка.Значение;	
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ИС_Сбер_Отправление.Ссылка КАК Ссылка,
	|	ИС_Сбер_Отправление.Номер КАК Номер,
	|	ИС_Сбер_Отправление.orderCode КАК orderCode
	|ПОМЕСТИТЬ ВТ_Заказы
	|ИЗ
	|	Документ.ИС_Сбер_Отправление КАК ИС_Сбер_Отправление
	|ГДЕ
	|	ИС_Сбер_Отправление.Ссылка В(&Ссылка)
	|	И ИС_Сбер_Отправление.status В(&Статус)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_Заказы.Номер КАК Номер,
	|	ВТ_Заказы.orderCode КАК orderCode,
	|	ИС_Сбер_Отправлениеitems.boxIndex КАК boxIndex
	|ИЗ
	|	ВТ_Заказы КАК ВТ_Заказы
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ИС_Сбер_Отправление.items КАК ИС_Сбер_Отправлениеitems
	|		ПО ВТ_Заказы.Ссылка = ИС_Сбер_Отправлениеitems.Ссылка
	|ИТОГИ ПО
	|	Номер";
	
	МассивСтатусов = Новый Массив;
	МассивСтатусов.Добавить(Перечисления.ИС_Сбер_СтатусыОтправлений.PACKED);
	МассивСтатусов.Добавить(Перечисления.ИС_Сбер_СтатусыОтправлений.CONFIRMED);
	
	Запрос.УстановитьПараметр("Ссылка", МассивЗаказов);
	Запрос.УстановитьПараметр("Статус", МассивСтатусов);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Если РезультатЗапроса.Пустой() Тогда
		ОбщегоНазначения.СообщитьПользователю("Не выбрано ни одного заказа находящегося в статусе ""Подтверждено Мерчантом"" или ""Скомплектовано Мерчантом""");
		Возврат Неопределено;
	КонецЕсли;
	
	ВыборкаЗаказов = РезультатЗапроса.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	НастройкиСоединения = ПолучитьНастройкиСоединенияПрофиля(Профиль);  
	ПараметрыЗапроса = ИС_MP_РаботаСHTTPЗапросамиСервер.ПолучитьСтруктуруHTTPЗапроса();
	РезультатПроверки = ПроверитьИЗаполнитьПараметрыЗапросаДляСервисаAPI(ПараметрыЗапроса, НастройкиСоединения);
	
	Если Не РезультатПроверки Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Data = Новый Структура;
	Data.Вставить("token", НастройкиСоединения["СберТокен"]);
	Data.Вставить("printAsPdf", Истина);
	
	Отправления = Новый Массив;
	
	Пока ВыборкаЗаказов.Следующий() Цикл
		
		Выборка = ВыборкаЗаказов.Выбрать();
		
		СтруктураОтправления = Новый Структура;
		СтруктураОтправления.Вставить("shipmentId", ВыборкаЗаказов.Номер);
		
		Пока Выборка.Следующий() Цикл
			
			МассивГрузовыхМест = Новый Массив;
			
			ГрузовоеМесто = СтрШаблон("%1*%2*%3", Ид, Выборка.orderCode, Выборка.boxIndex);
			
			МассивГрузовыхМест.Добавить(ГрузовоеМесто);
			
		КонецЦикла;
		
		СтруктураОтправления.Вставить("boxCodes", МассивГрузовыхМест);
		
		Отправления.Добавить(СтруктураОтправления);
		
	КонецЦикла;
	
	Data.Вставить("shipments", Отправления);
	
	РезультатЗапроса = ИС_Сбер_API.ПолучитьЭтикетки(Профиль, ПараметрыЗапроса, Data);
	
	Если РезультатЗапроса = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Возврат ПоместитьВоВременноеХранилище(РезультатЗапроса);
	
КонецФункции //- ИнфоСофт Ивонин К.А. 12.11.23 УА #55166

//+ ИнфоСофт Ивонин К.А. 20.11.23 УА #55166
Процедура СоздатьЗаказы(Профиль, МассивОтправлений) Экспорт
	
	Событие = ИмяСобытия("СоздатьЗаказы");
	
	ФукнциональныеОпции = ПолучитьИПроверитьФункциональныеОпции(Профиль);
	
	Если ФукнциональныеОпции = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	//+ ИнфоСофт Заварин К.В. 30.09.24 УА #75830
	МассивСтатусовОтмены = Новый Массив;
	МассивСтатусовОтмены.Добавить(Перечисления.ИС_Сбер_СтатусыОтправлений.CUSTOMER_CANCELED);
	МассивСтатусовОтмены.Добавить(Перечисления.ИС_Сбер_СтатусыОтправлений.MERCHANT_CANCELED);
	//- ИнфоСофт Заварин К.В. 30.09.24 УА #75830
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ИС_Сбер_Отправление.Ссылка КАК Ссылка,
	|	ИС_Сбер_Отправление.Номер КАК Номер,
	|	ИС_Сбер_Отправление.Дата КАК Дата,
	|	ИС_Сбер_Отправление.shippingTimeLimit КАК ДатаОтгрузки,
	|	ИС_Сбер_Склады.Ссылка КАК СкладМП,
	|	ИС_Сбер_Склады.Склад КАК Склад,
	|	ИС_Сбер_Склады.ОбщаяГруппаСкладов КАК ОбщаяГруппаСкладов,
	|	ИС_Сбер_Склады.ВыгружатьОстаткиИзГруппыСкладов КАК ВыгружатьОстаткиИзГруппыСкладов,
	|	ИС_Сбер_Склады.АдресДоставки КАК АдресДоставки,
	|	ИС_Сбер_Склады.АдресДоставкиЗначенияПолей КАК АдресДоставкиЗначенияПолей,
	|	ИС_Сбер_Склады.АдресДоставкиЗначение КАК АдресДоставкиЗначение,
	|	ИС_Сбер_Склады.СпособДоставки КАК СпособДоставки,
	|	ИС_Сбер_Склады.ЗонаДоставки КАК ЗонаДоставки,
	|	ИС_Сбер_Склады.Грузополучатель КАК Грузополучатель,
	|	ИС_Сбер_Склады.Грузоотправитель КАК Грузоотправитель,
	|	ИС_Сбер_Склады.ПеревозчикПартнер КАК ПеревозчикПартнер
	|ИЗ
	|	Документ.ИС_Сбер_Отправление КАК ИС_Сбер_Отправление
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ИС_Сбер_Склады КАК ИС_Сбер_Склады
	|		ПО (ИС_Сбер_Склады.Профиль = &Профиль)
	|ГДЕ
	|	ИС_Сбер_Отправление.Ссылка В(&МассивСсылок)
	|	И ИС_Сбер_Отправление.Заказ = &Заказ
	//+ ИнфоСофт Заварин К.В. 30.09.24 УА #75830
	|	И НЕ ИС_Сбер_Отправление.status В (&МассивСтатусовОтмены)";
    //- ИнфоСофт Заварин К.В. 30.09.24 УА #75830
	
	Запрос.УстановитьПараметр("Профиль", Профиль);
	Запрос.УстановитьПараметр("МассивСсылок", МассивОтправлений); 
	Запрос.УстановитьПараметр("Заказ", ИС_MP_СерверЛокализация.ПустаяСсылкаЗаказа()); 
	
	//+ ИнфоСофт Заварин К.В. 30.09.24 УА #75830
	Запрос.УстановитьПараметр("МассивСтатусовОтмены", МассивСтатусовОтмены);
	//- ИнфоСофт Заварин К.В. 30.09.24 УА #75830
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Если РезультатЗапроса.Пустой() Тогда
		Возврат;
	КонецЕсли;
	
	ВыборкаШапка = РезультатЗапроса.Выбрать();
	
	Если ФукнциональныеОпции.РежимСозданияЗаказов = 0 Тогда // Один к одному
		
		Пока ВыборкаШапка.Следующий() Цикл
			
			Запрос = Новый Запрос;
			Запрос.Текст = 
			"ВЫБРАТЬ
			|	ИС_Сбер_Товары.Номенклатура КАК Номенклатура,
			|	ИС_Сбер_Товары.Характеристика КАК Характеристика,
			|	ИС_Сбер_Отправлениеitems.quantity КАК Количество,
			|	ИС_Сбер_Отправлениеitems.finalPrice КАК Цена,
			//+ ИнфоСофт Стояк Ю.К. 26.01.2024 УА #67208			
			|	ИС_Сбер_Отправлениеitems.price КАК ЦенаДоСкидки,
			//- ИнфоСофт Стояк Ю.К. 26.01.2024 УА #67208
			|	ИС_Сбер_Товары.Номенклатура.ТипНоменклатуры КАК ТипНоменклатуры,
			//+ ИнфоСофт Мурсалимов Д.Р. 04.09.24 УА #82005
			|	ИС_Сбер_Товары.Упаковка КАК Упаковка,
			|	ВЫБОР
			|		КОГДА ИС_Сбер_Товары.Упаковка ЕСТЬ NULL ИЛИ ИС_Сбер_Товары.Упаковка.Числитель = 0
			|			ТОГДА 1
			|		ИНАЧЕ ИС_Сбер_Товары.Упаковка.Числитель
			|	КОНЕЦ / ВЫБОР
			|		КОГДА ИС_Сбер_Товары.Упаковка ЕСТЬ NULL ИЛИ ИС_Сбер_Товары.Упаковка.Знаменатель = 0
			|			ТОГДА 1
			|		ИНАЧЕ ИС_Сбер_Товары.Упаковка.Знаменатель
			|	КОНЕЦ КАК КоэффициентУпаковки
			//- ИнфоСофт Мурсалимов Д.Р. 04.09.24 УА #82005
			|ИЗ
			|	Документ.ИС_Сбер_Отправление.items КАК ИС_Сбер_Отправлениеitems
			|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ИС_Сбер_Товары КАК ИС_Сбер_Товары
			|		ПО (ИС_Сбер_Отправлениеitems.offerId = ИС_Сбер_Товары.offerID)
			|			И (ИС_Сбер_Товары.ЛичныйКабинет = &Профиль)
