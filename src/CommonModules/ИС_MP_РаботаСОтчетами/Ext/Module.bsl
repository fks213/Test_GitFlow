
#Область СлужебныйПрограммныйИнтерфейс

//+ ИнфоСофт Заварин К.В. 25.10.24 УА #67817
Функция ПолучитьУпорядоченнуюТаблицуABCXYZ(Профиль, НачалоПериода, КонецПериода) Экспорт
	
	СтруктураТаблиц = Новый Структура;
	
	Запрос = Новый Запрос;
	Запрос.Текст =	
	"ВЫБРАТЬ
	|	ИС_WB_ДанныеОтчетовРеализации.rrd_id КАК НомерСтроки,
	|	ВЫБОР
	|		КОГДА ИС_WB_ДанныеОтчетовРеализации.Значение = ""Возврат""
	|			ТОГДА -1
	|		ИНАЧЕ 1
	|	КОНЕЦ КАК Коэффициент,
	|	ИС_WB_ДанныеОтчетовРеализации.Значение КАК Операция,
	|	ИС_WB_ДанныеОтчетовРеализации.Профиль КАК Профиль
	|ПОМЕСТИТЬ ВТ_СтрокиПродаж
	|ИЗ
	|	РегистрСведений.ИС_WB_ДанныеОтчетовРеализации КАК ИС_WB_ДанныеОтчетовРеализации
	|ГДЕ
	|	ИС_WB_ДанныеОтчетовРеализации.Параметр.Наименование = ""supplier_oper_name""
	|	И (ИС_WB_ДанныеОтчетовРеализации.Значение = ""Продажа""
	|			ИЛИ ИС_WB_ДанныеОтчетовРеализации.Значение = ""Возврат"")
	|	И ИС_WB_ДанныеОтчетовРеализации.Период >= НАЧАЛОПЕРИОДА(&НачалоПериода, НЕДЕЛЯ)
	|	И ИС_WB_ДанныеОтчетовРеализации.date_to <= КОНЕЦПЕРИОДА(&КонецПериода, НЕДЕЛЯ)
	|	И ИС_WB_ДанныеОтчетовРеализации.Профиль В(&Профиль)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_СтрокиПродаж.НомерСтроки КАК НомерСтроки,
	|	ВТ_СтрокиПродаж.Коэффициент КАК Коэффициент,
	|	ВТ_СтрокиПродаж.Операция КАК Операция,
	|	ВТ_СтрокиПродаж.Профиль КАК Профиль,
	|	ВЫРАЗИТЬ(ИС_WB_ДанныеОтчетовРеализации.Значение КАК ЧИСЛО(15, 2)) КАК Сумма
	|ПОМЕСТИТЬ ВТ_Суммы
	|ИЗ
	|	ВТ_СтрокиПродаж КАК ВТ_СтрокиПродаж
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ИС_WB_ДанныеОтчетовРеализации КАК ИС_WB_ДанныеОтчетовРеализации
	|		ПО ВТ_СтрокиПродаж.НомерСтроки = ИС_WB_ДанныеОтчетовРеализации.rrd_id
	|			И (ИС_WB_ДанныеОтчетовРеализации.Параметр.Наименование = ""retail_amount"")
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_Суммы.НомерСтроки КАК НомерСтроки,
	|	ВТ_Суммы.Коэффициент КАК Коэффициент,
	|	ВТ_Суммы.Операция КАК Операция,
	|	ВТ_Суммы.Сумма КАК Сумма,
	|	ВТ_Суммы.Профиль КАК Профиль,
	|	ИС_WB_ДанныеОтчетовРеализации.Значение КАК ДатаПродажи
	|ПОМЕСТИТЬ ВТ_Даты
	|ИЗ
	|	ВТ_Суммы КАК ВТ_Суммы
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ИС_WB_ДанныеОтчетовРеализации КАК ИС_WB_ДанныеОтчетовРеализации
	|		ПО ВТ_Суммы.НомерСтроки = ИС_WB_ДанныеОтчетовРеализации.rrd_id
	|			И (ИС_WB_ДанныеОтчетовРеализации.Параметр.Наименование = ""sale_dt"")
	|ГДЕ
	|	ИС_WB_ДанныеОтчетовРеализации.Значение МЕЖДУ &НачалоПериода И &КонецПериода
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_Даты.НомерСтроки КАК НомерСтроки,
	|	ВТ_Даты.Операция КАК Операция,
	|	ВТ_Даты.Коэффициент КАК Количество,
	|	ВТ_Даты.Сумма * ВТ_Даты.Коэффициент КАК Сумма,
	|	ИС_WB_ДанныеОтчетовРеализации.Значение КАК Штрихкод,
	|	ИС_WB_ШтрихкодыРазмеров.Размер КАК Размер,
	|	ВТ_Даты.Профиль КАК Профиль,
	|	МЕСЯЦ(НАЧАЛОПЕРИОДА(ВЫРАЗИТЬ(ВТ_Даты.ДатаПродажи КАК ДАТА), ДЕНЬ)) КАК ДатаПродажи
	|ПОМЕСТИТЬ ВТ_Размеры
	|ИЗ
	|	ВТ_Даты КАК ВТ_Даты
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ИС_WB_ДанныеОтчетовРеализации КАК ИС_WB_ДанныеОтчетовРеализации
	|			ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ИС_WB_ШтрихкодыРазмеров КАК ИС_WB_ШтрихкодыРазмеров
	|			ПО (ИС_WB_ШтрихкодыРазмеров.Штрихкод = ИС_WB_ДанныеОтчетовРеализации.Значение)
	|		ПО ВТ_Даты.НомерСтроки = ИС_WB_ДанныеОтчетовРеализации.rrd_id
	|			И (ИС_WB_ДанныеОтчетовРеализации.Параметр.Наименование = ""barcode"")
	|ГДЕ
	|	НЕ ИС_WB_ШтрихкодыРазмеров.Размер ЕСТЬ NULL
	|	И ИС_WB_ШтрихкодыРазмеров.Профиль В(&Профиль)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	СУММА(ВТ_Размеры.Количество) КАК Количество,
	|	СУММА(ВТ_Размеры.Сумма) КАК Сумма,
	|	ВТ_Размеры.Штрихкод КАК Штрихкод,
	|	ВТ_Размеры.Размер КАК Размер,
	|	ВТ_Размеры.ДатаПродажи КАК ДатаПродажи,
	|	ВТ_Размеры.Профиль КАК Профиль,
	|	ИС_WB_СоответствиеРазмеров.Номенклатура КАК Номенклатура,
	|	ИС_WB_СоответствиеРазмеров.Характеристика КАК Характеристика,
	|	ЗНАЧЕНИЕ(Перечисление.ИС_МП_Маркетплейсы.ВБ) КАК Маркетплейс
	|ПОМЕСТИТЬ ВТ_СтрокиВБ
	|ИЗ
	|	ВТ_Размеры КАК ВТ_Размеры
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ИС_WB_СоответствиеРазмеров КАК ИС_WB_СоответствиеРазмеров
	|		ПО ВТ_Размеры.Размер = ИС_WB_СоответствиеРазмеров.РазмерWB
	|ГДЕ
	|	НЕ ИС_WB_СоответствиеРазмеров.Номенклатура ЕСТЬ NULL
	|
	|СГРУППИРОВАТЬ ПО
	|	ВТ_Размеры.Штрихкод,
	|	ВТ_Размеры.Размер,
	|	ВТ_Размеры.ДатаПродажи,
	|	ВТ_Размеры.Профиль,
	|	ИС_WB_СоответствиеРазмеров.Номенклатура,
	|	ИС_WB_СоответствиеРазмеров.Характеристика
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	СУММА(ВТ_СтрокиВБ.Сумма) КАК Сумма,
	|	ВТ_СтрокиВБ.Профиль КАК Профиль
	|ПОМЕСТИТЬ ВТ_СуммаВБ
	|ИЗ
	|	ВТ_СтрокиВБ КАК ВТ_СтрокиВБ
	|ГДЕ
	|	ВТ_СтрокиВБ.Количество > 0
	|
	|СГРУППИРОВАТЬ ПО
	|	ВТ_СтрокиВБ.Профиль
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ИС_Ozon_Продажи.offer_id КАК offer_id,
	|	ИС_Ozon_Продажи.SKU КАК SKU,
	|	ИС_Ozon_Продажи.Профиль КАК Профиль,
	|	ИС_Ozon_Продажи.НомерОтправления КАК НомерОтправления,
	|	ИС_Ozon_Продажи.Количество КАК Количество,
	|	ИС_Ozon_Продажи.РеализованоНаСумму КАК Сумма,
	|	ИС_Ozon_СоответствиеХарактеристик.Номенклатура КАК Номенклатура,
	|	ИС_Ozon_СоответствиеХарактеристик.Характеристика КАК Характеристика,
	|	ВЫБОР
	|		КОГДА ИС_Ozon_Продажи.ДатаОтправления ЕСТЬ NULL
	|				ИЛИ ИС_Ozon_Продажи.ДатаОтправления = ДАТАВРЕМЯ(1, 1, 1)
	|			ТОГДА ВЫБОР
	|					КОГДА ИС_Ozon_Заказ.Дата ЕСТЬ NULL
	|							ИЛИ ИС_Ozon_Заказ.Дата = ДАТАВРЕМЯ(1, 1, 1)
	|						ТОГДА НАЧАЛОПЕРИОДА(&НачалоПериода, ДЕНЬ)
	|					ИНАЧЕ НАЧАЛОПЕРИОДА(ИС_Ozon_Заказ.Дата, ДЕНЬ)
	|				КОНЕЦ
	|		ИНАЧЕ ИС_Ozon_Продажи.ДатаОтправления
	|	КОНЕЦ КАК ДатаПродажи,
	|	ВЫБОР
	|		КОГДА ИС_Ozon_Заказ.Дата ЕСТЬ NULL
	|				ИЛИ ИС_Ozon_Заказ.Дата = ДАТАВРЕМЯ(1, 1, 1)
	|			ТОГДА ""FBO""
	|		ИНАЧЕ ""FBS""
	|	КОНЕЦ КАК ТипПродажи,
	|	ЗНАЧЕНИЕ(Перечисление.ИС_МП_Маркетплейсы.Озон) КАК Маркетплейс
	|ПОМЕСТИТЬ ВТ_ПродажиОзон
	|ИЗ
	|	РегистрСведений.ИС_Ozon_Продажи КАК ИС_Ozon_Продажи
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ИС_Ozon_СоответствиеХарактеристик КАК ИС_Ozon_СоответствиеХарактеристик
	|		ПО (ИС_Ozon_СоответствиеХарактеристик.НоменклатураOzon.Профиль В (&Профиль))
	|			И (ИС_Ozon_Продажи.offer_id = ИС_Ozon_СоответствиеХарактеристик.НоменклатураOzon.offer_id
	|				ИЛИ ИС_Ozon_Продажи.SKU = ИС_Ozon_СоответствиеХарактеристик.НоменклатураOzon.sku_fbs
	|				ИЛИ ИС_Ozon_Продажи.SKU = ИС_Ozon_СоответствиеХарактеристик.НоменклатураOzon.sku_fbo)
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ИС_Ozon_Заказ КАК ИС_Ozon_Заказ
	|		ПО ИС_Ozon_Продажи.НомерОтправления = ИС_Ozon_Заказ.Номер
	|ГДЕ
	|	ИС_Ozon_Продажи.Профиль В(&Профиль)
	|	И ИС_Ozon_Продажи.ДатаНачала >= НАЧАЛОПЕРИОДА(&НачалоПериода, МЕСЯЦ)
	|	И НЕ ИС_Ozon_СоответствиеХарактеристик.Номенклатура ЕСТЬ NULL
	|	И ИС_Ozon_Продажи.ДатаОкончания <= КОНЕЦПЕРИОДА(&КонецПериода, МЕСЯЦ)
	|	И (ИС_Ozon_Продажи.ДатаОтправления МЕЖДУ &НачалоПериода И &КонецПериода
	|			ИЛИ ИС_Ozon_Продажи.ДатаОтправления = ДАТАВРЕМЯ(1, 1, 1))
	|	И ИС_Ozon_Продажи.Количество > 0
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ИС_Ozon_Продажи.offer_id,
	|	ИС_Ozon_Продажи.SKU,
	|	ИС_Ozon_Продажи.Профиль,
	|	ИС_Ozon_Продажи.НомерОтправления,
	|	-ИС_Ozon_Продажи.ВозвратКоличество,
	|	-ИС_Ozon_Продажи.ВозвращеноНаСумму,
	|	ИС_Ozon_СоответствиеХарактеристик.Номенклатура,
	|	ИС_Ozon_СоответствиеХарактеристик.Характеристика,
	|	ВЫБОР
	|		КОГДА ИС_Ozon_Продажи.ДатаОтправления ЕСТЬ NULL
	|				ИЛИ ИС_Ozon_Продажи.ДатаОтправления = ДАТАВРЕМЯ(1, 1, 1)
	|			ТОГДА ВЫБОР
	|					КОГДА ИС_Ozon_Заказ.Дата ЕСТЬ NULL
	|							ИЛИ ИС_Ozon_Заказ.Дата = ДАТАВРЕМЯ(1, 1, 1)
	|						ТОГДА НАЧАЛОПЕРИОДА(&НачалоПериода, ДЕНЬ)
	|					ИНАЧЕ НАЧАЛОПЕРИОДА(ИС_Ozon_Заказ.Дата, ДЕНЬ)
	|				КОНЕЦ
	|		ИНАЧЕ ИС_Ozon_Продажи.ДатаОтправления
	|	КОНЕЦ,
	|	ВЫБОР
	|		КОГДА ИС_Ozon_Заказ.Дата ЕСТЬ NULL
	|				ИЛИ ИС_Ozon_Заказ.Дата = ДАТАВРЕМЯ(1, 1, 1)
	|			ТОГДА ""FBO""
	|		ИНАЧЕ ""FBS""
	|	КОНЕЦ,
	|	ЗНАЧЕНИЕ(Перечисление.ИС_МП_Маркетплейсы.Озон)
	|ИЗ
	|	РегистрСведений.ИС_Ozon_Продажи КАК ИС_Ozon_Продажи
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ИС_Ozon_СоответствиеХарактеристик КАК ИС_Ozon_СоответствиеХарактеристик
	|		ПО (ИС_Ozon_СоответствиеХарактеристик.НоменклатураOzon.Профиль В (&Профиль))
	|			И (ИС_Ozon_Продажи.offer_id = ИС_Ozon_СоответствиеХарактеристик.НоменклатураOzon.offer_id
	|				ИЛИ ИС_Ozon_Продажи.SKU = ИС_Ozon_СоответствиеХарактеристик.НоменклатураOzon.sku_fbs
	|				ИЛИ ИС_Ozon_Продажи.SKU = ИС_Ozon_СоответствиеХарактеристик.НоменклатураOzon.sku_fbo)
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ИС_Ozon_Заказ КАК ИС_Ozon_Заказ
	|		ПО ИС_Ozon_Продажи.НомерОтправления = ИС_Ozon_Заказ.Номер
	|ГДЕ
	|	ИС_Ozon_Продажи.Профиль В(&Профиль)
	|	И ИС_Ozon_Продажи.ДатаНачала >= НАЧАЛОПЕРИОДА(&НачалоПериода, МЕСЯЦ)
	|	И НЕ ИС_Ozon_СоответствиеХарактеристик.Номенклатура ЕСТЬ NULL
	|	И ИС_Ozon_Продажи.ДатаОкончания <= КОНЕЦПЕРИОДА(&КонецПериода, МЕСЯЦ)
	|	И (ИС_Ozon_Продажи.ДатаОтправления МЕЖДУ &НачалоПериода И &КонецПериода
	|			ИЛИ ИС_Ozon_Продажи.ДатаОтправления = ДАТАВРЕМЯ(1, 1, 1))
	|	И ИС_Ozon_Продажи.ВозвратКоличество > 0
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_ПродажиОзон.offer_id КАК offer_id,
	|	ВТ_ПродажиОзон.SKU КАК SKU,
	|	ВТ_ПродажиОзон.Профиль КАК Профиль,
	|	ВТ_ПродажиОзон.НомерОтправления КАК НомерОтправления,
	|	ВТ_ПродажиОзон.Количество КАК Количество,
	|	ВТ_ПродажиОзон.Сумма КАК Сумма,
	|	ВТ_ПродажиОзон.Номенклатура КАК Номенклатура,
	|	ВТ_ПродажиОзон.Характеристика КАК Характеристика,
	|	ВТ_ПродажиОзон.ДатаПродажи КАК ДатаПродажи,
	|	ВТ_ПродажиОзон.ТипПродажи КАК ТипПродажи,
	|	ВТ_ПродажиОзон.Маркетплейс КАК Маркетплейс
	|ПОМЕСТИТЬ ВТ_ПозицииОзон
	|ИЗ
	|	ВТ_ПродажиОзон КАК ВТ_ПродажиОзон
	|ГДЕ
	|	ВТ_ПродажиОзон.ДатаПродажи МЕЖДУ &НачалоПериода И &КонецПериода
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_ПозицииОзон.Номенклатура КАК Номенклатура,
	|	ВТ_ПозицииОзон.Характеристика КАК Характеристика,
	|	СУММА(ВТ_ПозицииОзон.Количество) КАК Количество,
	|	СУММА(ВТ_ПозицииОзон.Сумма) КАК Сумма,
	|	ВТ_ПозицииОзон.Профиль КАК Профиль,
	|	ВТ_ПозицииОзон.Маркетплейс КАК Маркетплейс,
	|	МЕСЯЦ(ВТ_ПозицииОзон.ДатаПродажи) КАК ДатаПродажи
	|ПОМЕСТИТЬ ВТ_СтрокиОзон
	|ИЗ
	|	ВТ_ПозицииОзон КАК ВТ_ПозицииОзон
	|
	|СГРУППИРОВАТЬ ПО
	|	ВТ_ПозицииОзон.Номенклатура,
	|	ВТ_ПозицииОзон.Характеристика,
	|	ВТ_ПозицииОзон.Профиль,
	|	ВТ_ПозицииОзон.Маркетплейс,
	|	ВТ_ПозицииОзон.ДатаПродажи
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_СтрокиОзон.Маркетплейс КАК Маркетплейс,
	|	СУММА(ВТ_СтрокиОзон.Сумма) КАК Сумма
	|ПОМЕСТИТЬ ВТ_СуммаОзон
	|ИЗ
	|	ВТ_СтрокиОзон КАК ВТ_СтрокиОзон
	|ГДЕ
	|	ВТ_СтрокиОзон.Количество > 0
	|
	|СГРУППИРОВАТЬ ПО
	|	ВТ_СтрокиОзон.Маркетплейс
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ИС_ЯМ_Продажи.Sku КАК Sku,
	|	ИС_ЯМ_Продажи.НомерЗаказа КАК НомерЗаказа,
	|	ИС_ЯМ_Продажи.Количество КАК Количество,
	|	ИС_ЯМ_Продажи.РеализованоНаСумму КАК Сумма,
	|	ИС_ЯМ_Продажи.ДатаОформленияЗаказа КАК ДатаПродажи,
	|	ИС_ЯМ_Продажи.Профиль КАК Профиль,
