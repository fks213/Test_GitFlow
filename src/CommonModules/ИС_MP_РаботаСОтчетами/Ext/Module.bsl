	Запрос.УстановитьПараметр("ТЗ", УпорядоченнаяТаблица);
	
	РезультатНарастающийИтог = Запрос.Выполнить();
	
	НарастающийИтогТаблица = РезультатНарастающийИтог.Выгрузить();
	
	СтруктураТаблиц.Вставить("УпорядоченнаяТаблица",   УпорядоченнаяТаблица);
