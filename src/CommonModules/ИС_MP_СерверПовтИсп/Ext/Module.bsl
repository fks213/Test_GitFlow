//+ ИнфоСофт Ивонин К.А. 13.02.24 УА #70076
Функция ПолучитьВерсиюБезРедакции() Экспорт

	Версия = ПолучитьВерсиюКонфигурации();
	КолУдаляемыхСим = СтрНайти(Версия, ".");
	ДлинаСтроки = СтрДлина(Версия) - КолУдаляемыхСим;
	
	Версия = Прав(Версия, ДлинаСтроки);
	
	Возврат Версия;
	
КонецФункции //- ИнфоСофт Ивонин К.А. 13.02.24 УА #70076

