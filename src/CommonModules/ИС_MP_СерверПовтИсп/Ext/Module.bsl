//+ ИнфоСофт Ивонин К.А. 06.07.22 УА #46999
Функция ПолучитьПрофильПоУмолчанию() Экспорт

	Результат = Справочники.ИС_WB_Профили.ПустаяСсылка();
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ ПЕРВЫЕ 2
	|	ИС_WB_Профили.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.ИС_WB_Профили КАК ИС_WB_Профили
	|ГДЕ
	|	НЕ ИС_WB_Профили.ПометкаУдаления";
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Выборка = РезультатЗапроса.Выбрать();

	Если Выборка.Количество() = 1 Тогда
		Выборка.Следующий();
		Результат = Выборка.Ссылка;
	КонецЕсли; 
	
	Возврат Результат;	
	
КонецФункции //- ИнфоСофт Ивонин К.А. 06.07.22 УА #46999

