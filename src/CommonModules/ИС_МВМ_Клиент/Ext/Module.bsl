//+ ИнфоСофт Ивонин К.А. 22.10.24 УА #68001
Функция ПараметрыТестаПодключения(Форма) Экспорт
	
	ТекстОшибки = "";
	
	Результат = Новый Структура;
	Результат.Вставить("АдресСервисаAPI", Форма.МВМАдресСервисаAPI);
	Результат.Вставить("Порт", Форма.МВМПорт);
	Результат.Вставить("ЗащищенноеСоединение", Форма.МВМЗащищенноеСоединение);
	Результат.Вставить("ClientId", Форма.МВМClientId);
	Результат.Вставить("ApiKey", Форма.МВМApiKey);
	
	Если Не ЗначениеЗаполнено(Форма.МВМClientId) Тогда
		ТекстОшибки = ТекстОшибки + "Не заполнен ""Client Id""" + Символы.ПС;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(Форма.МВМApiKey) Тогда
		ТекстОшибки = ТекстОшибки + "Не заполнен ""Api Key""" + Символы.ПС;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(Форма.МВМАдресСервисаAPI) Тогда
		ТекстОшибки = ТекстОшибки + "Не заполнен ""Адрес сервиса API""" + Символы.ПС;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(Форма.МВМПорт) Тогда
		ТекстОшибки = ТекстОшибки + "Не заполнен ""Порт""" + Символы.ПС;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ТекстОшибки) Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю(ТекстОшибки);
		Возврат Неопределено;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции //- ИнфоСофт Ивонин К.А. 22.10.24 УА #68001

