//+ ИнфоСофт Ивонин К.А. 25.10.24 УА #68001
Функция ДопПараметрыЗагрузкиТоваров(Форма) Экспорт	
	
	Если Не ЗначениеЗаполнено(Форма.АдресВременногоХранилищаМВМ) Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю("Для начала необходимо выбрать файл с Товарами", , , "ПутьФайлаМВМ");
		Возврат Неопределено;
	КонецЕсли;
	
	ДопПараметры = Новый Структура;
	ДопПараметры.Вставить("Адрес", Форма.АдресВременногоХранилищаМВМ);
	
	Возврат ДопПараметры;
	
КонецФункции //- ИнфоСофт Ивонин К.А. 25.10.24 УА #68001

