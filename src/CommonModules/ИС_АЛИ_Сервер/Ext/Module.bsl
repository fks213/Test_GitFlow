				Заказ = ИС_MP_РаботаСЗаказами.СоздатьИлиДополнитьЗаказ(ВыборкаШапка, ВыборкаТовары, ФукнциональныеОпции, Перечисления.ИС_МП_Маркетплейсы.Али, Заказ, Назначения);
				//Заказ = ИС_MP_РаботаСЗаказами.СоздатьИлиДополнитьЗаказ(ВыборкаШапка, ВыборкаТовары, ФукнциональныеОпции, Перечисления.ИС_МП_Маркетплейсы.Али, Заказ);
				//- ИнфоСофт Стояк Ю.К. 18.11.2024 УА #74083				
				
				ДокОбъект = ВыборкаШапка.Ссылка.ПолучитьОбъект();
				ДокОбъект.Заказ = Заказ;
				
				Попытка
					ДокОбъект.Записать();
				Исключение
					Текст = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
					ИС_MP_Сервер.ЗаписатьВЖРИСообщитьПользователю(Событие, Текст);
				КонецПопытки;
				
			КонецЦикла;	
			
			Возврат;
			
		КонецЕсли;   
		
		Пока ВыборкаШапка.Следующий() Цикл
			
			Запрос = Новый Запрос;
			Запрос.Текст = 
			"ВЫБРАТЬ
			|	ИС_АЛИ_СоответствиеХарактеристик.Номенклатура КАК Номенклатура,
			|	ИС_АЛИ_СоответствиеХарактеристик.Характеристика КАК Характеристика,
			|	ИС_АЛИ_Заказorder_lines.quantity КАК Количество,
			|	ИС_АЛИ_Заказorder_lines.item_price КАК Цена,
			|	ИС_АЛИ_СоответствиеХарактеристик.Номенклатура.ТипНоменклатуры КАК ТипНоменклатуры,
			//+ ИнфоСофт Мурсалимов Д.Р. 04.09.24 УА #82005
			|	ИС_АЛИ_СоответствиеХарактеристик.Упаковка КАК Упаковка,
			|	ВЫБОР
			|		КОГДА ИС_АЛИ_СоответствиеХарактеристик.Упаковка ЕСТЬ NULL ИЛИ ИС_АЛИ_СоответствиеХарактеристик.Упаковка.Числитель = 0
			|			ТОГДА 1
			|		ИНАЧЕ ИС_АЛИ_СоответствиеХарактеристик.Упаковка.Числитель
			|	КОНЕЦ / ВЫБОР
			|		КОГДА ИС_АЛИ_СоответствиеХарактеристик.Упаковка ЕСТЬ NULL ИЛИ ИС_АЛИ_СоответствиеХарактеристик.Упаковка.Знаменатель = 0
			|			ТОГДА 1
			|		ИНАЧЕ ИС_АЛИ_СоответствиеХарактеристик.Упаковка.Знаменатель
			|	КОНЕЦ КАК КоэффициентУпаковки
			//- ИнфоСофт Мурсалимов Д.Р. 04.09.24 УА #82005
			|ИЗ
			|	Документ.ИС_АЛИ_Заказ.order_lines КАК ИС_АЛИ_Заказorder_lines
			|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ИС_АЛИ_СоответствиеХарактеристик КАК ИС_АЛИ_СоответствиеХарактеристик
			|		ПО (ИС_АЛИ_Заказorder_lines.ВариацияАли = ИС_АЛИ_СоответствиеХарактеристик.ВариацияАЛИ)
			|			И (ИС_АЛИ_СоответствиеХарактеристик.Профиль = &Профиль)
			|ГДЕ
			|	ИС_АЛИ_Заказorder_lines.Ссылка = &Ссылка
			|	И НЕ ИС_АЛИ_СоответствиеХарактеристик.Номенклатура ЕСТЬ NULL";
			
			Запрос.УстановитьПараметр("Профиль", Профиль);
			Запрос.УстановитьПараметр("Ссылка", ВыборкаШапка.Ссылка);
			
			РезультатЗапроса = Запрос.Выполнить();
			
			ВыборкаТовары = РезультатЗапроса.Выгрузить(); 
			
			Если РезультатЗапроса.Пустой() Тогда
				ОбщегоНазначения.СообщитьПользователю("Проверьте сопоставление по заказу " + ВыборкаШапка.Ссылка);
				Продолжить;
			КонецЕсли;				
			
			ДобавитьЗапись = Ложь;
			
			АктивныйЗаказ = ПолучитьАктивныйЗаказКлиента(ВыборкаШапка.Ссылка, ВыборкаШапка.ДатаОтгрузки);
			
			Если АктивныйЗаказ = Неопределено Тогда
				ДобавитьЗапись = Истина;	
			КонецЕсли;
			
			Заказ = ИС_MP_РаботаСЗаказами.СоздатьИлиДополнитьЗаказ(ВыборкаШапка, ВыборкаТовары, ФукнциональныеОпции, Перечисления.ИС_МП_Маркетплейсы.Али, АктивныйЗаказ);
			
			Если ДобавитьЗапись Тогда
				ДобавитьЗаписьВРегистрЗаказов(Заказ, ВыборкаШапка.Ссылка, ВыборкаШапка.ДатаОтгрузки);	
			КонецЕсли;
			
			ДокОбъект = ВыборкаШапка.Ссылка.ПолучитьОбъект();
			ДокОбъект.Заказ = Заказ;
			
			Попытка
				ДокОбъект.Записать();
			Исключение
				Текст = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
				ИС_MP_Сервер.ЗаписатьВЖРИСообщитьПользователю(Событие, Текст);
			КонецПопытки;
			
		КонецЦикла; 
		
	Иначе
		ВызватьИсключение("Неизвестный режим формирования заказов");
	КонецЕсли;
	
КонецПроцедуры //- ИнфоСофт Стояк Ю.К. 04.03.2024 УА #56408 

//+ ИнфоСофт Стояк Ю.К. 04.03.2024 УА #56408
Процедура СоздатьРеализации(Профиль, МассивОтправлений) Экспорт
	
	Событие = ПолучитьИмяСобытия("СоздатьРеализации");
	
	ФукнциональныеОпции = ПолучитьНастройкиФункциональностиСборочныхЗаданий(Профиль);
	
	Если ФукнциональныеОпции = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ИС_АЛИ_Заказ.Заказ КАК Заказ,
	//+ ИнфоСофт Стояк Ю.К. 12.03.2025 УА #95754	
	//|	ИС_АЛИ_СтатусыСборочныхЗаданий.cut_off_date КАК ДатаОтгрузки
	|	МАКСИМУМ(ИС_АЛИ_СтатусыСборочныхЗаданий.cut_off_date) КАК ДатаОтгрузки
	//- ИнфоСофт Стояк Ю.К. 12.03.2025 УА #95754
	|ПОМЕСТИТЬ ВТ_Заказы
	|ИЗ
	|	Документ.ИС_АЛИ_Заказ КАК ИС_АЛИ_Заказ
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ИС_АЛИ_СтатусыСборочныхЗаданий КАК ИС_АЛИ_СтатусыСборочныхЗаданий
	|		ПО (ИС_АЛИ_СтатусыСборочныхЗаданий.Заказ = ИС_АЛИ_Заказ.Ссылка)
	|ГДЕ
	|	ИС_АЛИ_Заказ.Ссылка В(&МассивСсылок)
	|	И НЕ ИС_АЛИ_Заказ.Заказ = ЗНАЧЕНИЕ(Документ.ЗаказКлиента.ПустаяСсылка)
	|
	|СГРУППИРОВАТЬ ПО
	|	ИС_АЛИ_Заказ.Заказ
	//+ ИнфоСофт Стояк Ю.К. 12.03.2025 УА #95754	
	//|	ИС_АЛИ_СтатусыСборочныхЗаданий.cut_off_date
	//- ИнфоСофт Стояк Ю.К. 12.03.2025 УА #95754
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_Заказы.Заказ КАК Заказ,
	|	ВТ_Заказы.ДатаОтгрузки КАК ДатаОтгрузки,
	|	ВЫБОР
	|		КОГДА РеализацияТоваровУслуг.Ссылка ЕСТЬ NULL
	|			ТОГДА 0
	|		ИНАЧЕ 1
	|	КОНЕЦ КАК Реализация
	|ПОМЕСТИТЬ ВТ_Реализации
	|ИЗ
	|	ВТ_Заказы КАК ВТ_Заказы
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.РеализацияТоваровУслуг КАК РеализацияТоваровУслуг
	|		ПО ВТ_Заказы.Заказ = РеализацияТоваровУслуг.ЗаказКлиента
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ВТ_Заказы.Заказ,
	|	ВТ_Заказы.ДатаОтгрузки,
	|	ВЫБОР
	|		КОГДА РеализацияТоваровУслугТовары.Ссылка ЕСТЬ NULL
	|			ТОГДА 0
	|		ИНАЧЕ 1
	|	КОНЕЦ
	|ИЗ
	|	ВТ_Заказы КАК ВТ_Заказы
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.РеализацияТоваровУслуг.Товары КАК РеализацияТоваровУслугТовары
	|		ПО ВТ_Заказы.Заказ = РеализацияТоваровУслугТовары.ЗаказКлиента
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ВТ_Заказы.Заказ,
	|	ВТ_Заказы.ДатаОтгрузки,
	|	ВЫБОР
	|		КОГДА ПередачаТоваровХранителю.Ссылка ЕСТЬ NULL
	|			ТОГДА 0
	|		ИНАЧЕ 1
	|	КОНЕЦ
	|ИЗ
	|	ВТ_Заказы КАК ВТ_Заказы
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ПередачаТоваровХранителю.Товары КАК ПередачаТоваровХранителю
	|		ПО ВТ_Заказы.Заказ = ПередачаТоваровХранителю.ЗаказКлиента
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ВТ_Заказы.Заказ,
	|	ВТ_Заказы.ДатаОтгрузки,
	|	ВЫБОР
	|		КОГДА ПередачаТоваровХранителюТовары.Ссылка ЕСТЬ NULL
	|			ТОГДА 0
	|		ИНАЧЕ 1
	|	КОНЕЦ
	|ИЗ
	|	ВТ_Заказы КАК ВТ_Заказы
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ПередачаТоваровХранителю.Товары КАК ПередачаТоваровХранителюТовары
	|		ПО ВТ_Заказы.Заказ = ПередачаТоваровХранителюТовары.ЗаказКлиента
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_ПолучениеРеализаций.Заказ КАК Заказ,
	|	ВТ_ПолучениеРеализаций.ДатаОтгрузки КАК ДатаОтгрузки,
	|	СУММА(ВТ_ПолучениеРеализаций.Реализация) КАК КоличествоРеализаций
	|ПОМЕСТИТЬ ВТ_КоличествоРеализаций
	|ИЗ
	|	ВТ_Реализации КАК ВТ_ПолучениеРеализаций
	|ГДЕ
	|	НЕ ВТ_ПолучениеРеализаций.Реализация ЕСТЬ NULL
	|
	|СГРУППИРОВАТЬ ПО
	|	ВТ_ПолучениеРеализаций.Заказ,
	|	ВТ_ПолучениеРеализаций.ДатаОтгрузки
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_КоличествоРеализаций.Заказ КАК Заказ,
	|	ВТ_КоличествоРеализаций.ДатаОтгрузки КАК ДатаОтгрузки,
	|	ВТ_КоличествоРеализаций.Заказ.Комментарий КАК Комментарий,
	|	ИС_Али_Склады.СтатусРасходногоОрдера КАК СтатусРасходногоОрдера,
	|	ИС_Али_Склады.СтатусСтрокиРасходногоОрдера КАК СтатусСтрокиРасходногоОрдера
	|ИЗ
	|	ВТ_КоличествоРеализаций КАК ВТ_КоличествоРеализаций
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ИС_Али_Склады КАК ИС_Али_Склады
	|		ПО (ИС_Али_Склады.Профиль = &Профиль)
	|ГДЕ
	|	ВТ_КоличествоРеализаций.КоличествоРеализаций = 0";
	
	Запрос.УстановитьПараметр("Профиль", Профиль);
	Запрос.УстановитьПараметр("МассивСсылок", МассивОтправлений);
	Запрос.УстановитьПараметр("Заказ", ИС_MP_СерверЛокализация.ПустаяСсылкаЗаказа());
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Выборка = РезультатЗапроса.Выбрать(); 
		
	Комиссия25 = ФукнциональныеОпции.Договор.КомиссионныеПродажи25;
	
	//+ ИнфоСофт Мурсалимов Д.Р. 13.06.24 УА #77595
	ПорядокОформленияНакладныхРасходныхОрдеров = Константы.ПорядокОформленияНакладныхРасходныхОрдеров.Получить();
	//- ИнфоСофт Мурсалимов Д.Р. 13.06.24 УА #77595
	
	Пока Выборка.Следующий() Цикл
		
		//+ ИнфоСофт Мурсалимов Д.Р. 10.06.24 УА #77595
		Если ПорядокОформленияНакладныхРасходныхОрдеров 
			= Перечисления.ПорядокОформленияНакладныхРасходныхОрдеров.СначалаНакладные Тогда
			
			СоздатьРеализацию(Выборка, ФукнциональныеОпции, Комиссия25);
			
			//+ ИнфоСофт Мурсалимов Д.Р. 19.06.24 УА #77872
			Если ФукнциональныеОпции.АвтоматическиСоздаватьОрдерНаОтгрузку И Выборка.Заказ.Склад.ИспользоватьОрдернуюСхемуПриОтгрузке Тогда		
				ИС_MP_РаботаСЗаказами.СоздатьРасходныйОрдер(  Выборка.Заказ
															, Выборка.СтатусРасходногоОрдера
															, Выборка.СтатусСтрокиРасходногоОрдера);		
			КонецЕсли;	                                   
			//- ИнфоСофт Мурсалимов Д.Р. 19.06.24 УА #77872
			
		Иначе
			
			//+ ИнфоСофт Мурсалимов Д.Р. 19.06.24 УА #77872
			Если ФукнциональныеОпции.АвтоматическиСоздаватьОрдерНаОтгрузку И Выборка.Заказ.Склад.ИспользоватьОрдернуюСхемуПриОтгрузке Тогда		
				ИС_MP_РаботаСЗаказами.СоздатьРасходныйОрдер(  Выборка.Заказ
															, Выборка.СтатусРасходногоОрдера
															, Выборка.СтатусСтрокиРасходногоОрдера);		
			КонецЕсли;		                               
			//- ИнфоСофт Мурсалимов Д.Р. 19.06.24 УА #77872
			
			СоздатьРеализацию(Выборка, ФукнциональныеОпции, Комиссия25);
			
		КонецЕсли;
		//- ИнфоСофт Мурсалимов Д.Р. 10.06.24 УА #77595				
		
	КонецЦикла;
	
КонецПроцедуры //- ИнфоСофт Стояк Ю.К. 04.03.2024 УА #56408

//+ ИнфоСофт Стояк Ю.К. 04.03.2024 УА #56408
Функция ПолучитьТекстЗапросаСборочныхЗаданий() Экспорт
		
	Текст =  	
	"ВЫБРАТЬ
	|	ИС_АЛИ_Заказ.Ссылка КАК Ссылка,
	//+ ИнфоСофт Конышев А.Е. 11.12.24 УА #77940
	|	ИС_АЛИ_Заказ.Заказ КАК Заказ1C,
	//- ИнфоСофт Конышев А.Е. 11.12.24 УА #77940
	|	ПередачаТоваровХранителю.Ссылка КАК Реализация
	|ПОМЕСТИТЬ ВТ_Реализации
	|ИЗ
	|	Документ.ИС_АЛИ_Заказ КАК ИС_АЛИ_Заказ
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ПередачаТоваровХранителю КАК ПередачаТоваровХранителю
	|		ПО ИС_АЛИ_Заказ.Заказ = ПередачаТоваровХранителю.ЗаказКлиента
	|			И (НЕ ИС_АЛИ_Заказ.Заказ = ЗНАЧЕНИЕ(Документ.ЗаказКлиента.ПустаяСсылка))
	|ГДЕ
	|	ИС_АЛИ_Заказ.Профиль = &Профиль
	|	И НЕ ИС_АЛИ_Заказ.Заказ = ЗНАЧЕНИЕ(Документ.ЗаказКлиента.ПустаяСсылка)
	|	И НЕ ПередачаТоваровХранителю.Ссылка ЕСТЬ NULL
	|
	|ОБЪЕДИНИТЬ
	|
	|ВЫБРАТЬ
	|	ИС_АЛИ_Заказ.Ссылка,
	//+ ИнфоСофт Конышев А.Е. 11.12.24 УА #77940
	|	ИС_АЛИ_Заказ.Заказ КАК Заказ1C,
	//- ИнфоСофт Конышев А.Е. 11.12.24 УА #77940
	|	ПередачаТоваровХранителюТовары.Ссылка
	|ИЗ
	|	Документ.ИС_АЛИ_Заказ КАК ИС_АЛИ_Заказ
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ПередачаТоваровХранителю.Товары КАК ПередачаТоваровХранителюТовары
	|		ПО ИС_АЛИ_Заказ.Заказ = ПередачаТоваровХранителюТовары.ЗаказКлиента
	|			И (НЕ ИС_АЛИ_Заказ.Заказ = ЗНАЧЕНИЕ(Документ.ЗаказКлиента.ПустаяСсылка))
	|ГДЕ
	|	ИС_АЛИ_Заказ.Профиль = &Профиль
	|	И НЕ ИС_АЛИ_Заказ.Заказ = ЗНАЧЕНИЕ(Документ.ЗаказКлиента.ПустаяСсылка)
	|	И НЕ ПередачаТоваровХранителюТовары.Ссылка ЕСТЬ NULL
	|
	|ОБЪЕДИНИТЬ
    |
	|ВЫБРАТЬ
	|	ИС_АЛИ_Заказ.Ссылка,
	//+ ИнфоСофт Конышев А.Е. 11.12.24 УА #77940
	|	ИС_АЛИ_Заказ.Заказ КАК Заказ1C,
	//- ИнфоСофт Конышев А.Е. 11.12.24 УА #77940
	|	РеализацияТоваровУслуг.Ссылка
	|ИЗ
	|	Документ.ИС_АЛИ_Заказ КАК ИС_АЛИ_Заказ
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.РеализацияТоваровУслуг КАК РеализацияТоваровУслуг
	|		ПО ИС_АЛИ_Заказ.Заказ = РеализацияТоваровУслуг.ЗаказКлиента
	|		И (НЕ ИС_АЛИ_Заказ.Заказ = ЗНАЧЕНИЕ(Документ.ЗаказКлиента.ПустаяСсылка))
