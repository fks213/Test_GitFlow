Функция ЕстьНастройкиОсновныхРеквизитовДляКатегории(Категория) Экспорт

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ИС_АЛИ_СоответствиеОсновныхРеквизитовТовара.Категория КАК Категория
	|ИЗ
	|	РегистрСведений.ИС_АЛИ_СоответствиеОсновныхРеквизитовТовара КАК ИС_АЛИ_СоответствиеОсновныхРеквизитовТовара
	|ГДЕ
	|	ИС_АЛИ_СоответствиеОсновныхРеквизитовТовара.Категория = &Категория";

	Запрос.УстановитьПараметр("Категория", Категория);

	РезультатЗапроса = Запрос.Выполнить();

	Возврат Не РезультатЗапроса.Пустой();

