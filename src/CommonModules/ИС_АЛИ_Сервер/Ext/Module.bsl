	|	ИС_АЛИ_СоответствиеОсновныхРеквизитовТовара.Множитель,
	//- ИнфоСофт Заварин К.В. 18.05.24 УА #71157
	|	ЛОЖЬ
	|ИЗ
	|	РегистрСведений.ИС_АЛИ_СоответствиеОсновныхРеквизитовТовара КАК ИС_АЛИ_СоответствиеОсновныхРеквизитовТовара
	|ГДЕ
	|	ИС_АЛИ_СоответствиеОсновныхРеквизитовТовара.Категория = &КатегорияДляОсновныхРеквизитов
	|	И ИС_АЛИ_СоответствиеОсновныхРеквизитовТовара.ВидРеквизита1С = ЗНАЧЕНИЕ(Перечисление.ИС_Ozon_ВидРеквизитаСопоставления.РеквизитНоменклатуры)
	|	И ИС_АЛИ_СоответствиеОсновныхРеквизитовТовара.Реквизит1С В(&МассивСинонимов)";

	ТаблицаСоответствийЗначений = Запрос.Выполнить().Выгрузить();
	ТаблицаСоответствийЗначений.Колонки.ЗначениеХарактеристики.Имя = "ЗначениеВРегистре";

	МассивТипов 	= ОбщегоНазначенияКлиентСервер.СвернутьМассив(МассивТипов);
	ОписаниеТипов 	= Новый ОписаниеТипов(МассивТипов, , Новый КвалификаторыСтроки(1024, ДопустимаяДлина.Переменная));
