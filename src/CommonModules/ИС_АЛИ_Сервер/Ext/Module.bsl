//+ ИнфоСофт Стояк Ю.К. 04.03.2024 УА #56408
Функция ПолучитьДатуПоследнегоЗаказа(Профиль) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	ИС_АЛИ_Заказ.Дата КАК Дата
	|ИЗ
	|	Документ.ИС_АЛИ_Заказ КАК ИС_АЛИ_Заказ
	|ГДЕ
	|	ИС_АЛИ_Заказ.Профиль = &Профиль
	|
	|УПОРЯДОЧИТЬ ПО
	|	Дата УБЫВ";
	
	Запрос.УстановитьПараметр("Профиль", Профиль);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Если РезультатЗапроса.Пустой() Тогда
		Возврат НачалоДня(ТекущаяДатаСеанса());
	КонецЕсли;
	
	Выборка = РезультатЗапроса.Выбрать();
	
	Выборка.Следующий();
	
	Возврат Выборка.Дата;
	
КонецФункции //- ИнфоСофт Стояк Ю.К. 04.03.2024 УА #56408

//+ ИнфоСофт Стояк Ю.К. 14.06.2024 УА #62573
Функция ПолучитьСписокОтправлений(Профиль, МассивID) Экспорт

	Если Не ЗначениеЗаполнено(Профиль) Тогда
		ОбщегоНазначения.СообщитьПользователю("Не выбран Профиль. Загрузка товаров невозможна");
		Возврат Неопределено;
	КонецЕсли;
	
	ПараметрыСоединения = Неопределено;
	Если Не ПолучитьПараметрыСоединения(Профиль, ПараметрыСоединения) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Заголовки = Неопределено;
	Если Не CформироватьЗаголовкиЗапроса(Заголовки, ПараметрыСоединения) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	ПараметрыЗапроса = ИС_MP_РаботаСHTTPЗапросамиСервер.ПолучитьСтруктуруHTTPЗапроса();
	ПараметрыЗапроса.Сервер = ПараметрыСоединения.АдресСервиса;
	ПараметрыЗапроса.Порт = ПараметрыСоединения.Порт;
	ПараметрыЗапроса.ЗащищенноеСоединение = ПараметрыСоединения.ЗащищенноеСоединение;
	ПараметрыЗапроса.Заголовки = Заголовки;
	
	КодСтраницы = 1;
	КоличествоЭлементовНаСтранице = 50;
	ПределОшибок = 10;
	КоличествоОшибок = 0;   
	ОсталосьЭлементов = Неопределено; 
	
	rawData = Новый Структура;
	rawData.Вставить("trade_order_ids", МассивID);
	rawData.Вставить("page_size", КоличествоЭлементовНаСтранице);
	rawData.Вставить("page", КодСтраницы);
	rawData.Вставить("logistic_order_info", "PackageItems");
	
	ТЗ_Отправления = Новый ТаблицаЗначений; 
	
	КвалификаторыЧислаОтправлений = Новый КвалификаторыЧисла(30, 0, ДопустимыйЗнак.Неотрицательный);	
		
	ТЗ_Отправления.Колонки.Добавить("logistic_order_id", Новый ОписаниеТипов("Число", КвалификаторыЧислаОтправлений));
	ТЗ_Отправления.Колонки.Добавить("trade_order_id", Новый ОписаниеТипов("Число", КвалификаторыЧислаОтправлений));
	ТЗ_Отправления.Колонки.Добавить("sku_id", Новый ОписаниеТипов("Число", КвалификаторыЧислаОтправлений));
	ТЗ_Отправления.Колонки.Добавить("quantity", Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(3, 0, ДопустимыйЗнак.Неотрицательный)));
	
	Пока Истина Цикл	                                         
				
		Если КоличествоОшибок >= ПределОшибок Тогда
			Возврат Неопределено;
		КонецЕсли;
		
		Результат = ИС_АЛИ_API.ПолучитьСписокОтправлений(Профиль, ПараметрыЗапроса, rawData); 
		
		Если Результат = Неопределено Тогда
			КоличествоОшибок = КоличествоОшибок + 1;
			Продолжить;
		КонецЕсли;
		
		Если Не ЗначениеЗаполнено(ОсталосьЭлементов) Тогда
			ОсталосьЭлементов = Результат["page_info"]["total"];
		КонецЕсли;
		
		Для Каждого Элемент Из Результат["logistic_orders"] Цикл 
			
			Для Каждого item Из Элемент["items"] Цикл
				
				НСтр = ТЗ_Отправления.Добавить();				
				
				НСтр.logistic_order_id = Элемент["logistic_order_id"];
				НСтр.trade_order_id = Элемент["trade_order_id"];
				НСтр.sku_id = item["sku_id"];
				НСтр.quantity = item["quantity"];
						
			КонецЦикла; 				
			
		КонецЦикла;    
		
		ОсталосьЭлементов = ОсталосьЭлементов - КоличествоЭлементовНаСтранице;
		
		Если ОсталосьЭлементов <= 0 Тогда
			Прервать;
		КонецЕсли;
				
	КонецЦикла;
	
	Возврат ТЗ_Отправления;
	
КонецФункции //- ИнфоСофт Стояк Ю.К. 14.06.2024 УА #62573

//+ ИнфоСофт Стояк Ю.К. 14.06.2024 УА #62573
Функция ВыгрузитьКиЗ(Профиль, ТелоВыгрузки) Экспорт

	Если Не ЗначениеЗаполнено(Профиль) Тогда
		ОбщегоНазначения.СообщитьПользователю("Не выбран Профиль. Загрузка товаров невозможна");
		Возврат Неопределено;
	КонецЕсли;
	
	ПараметрыСоединения = Неопределено;
	Если Не ПолучитьПараметрыСоединения(Профиль, ПараметрыСоединения) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Заголовки = Неопределено;
	Если Не CформироватьЗаголовкиЗапроса(Заголовки, ПараметрыСоединения) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	ПараметрыЗапроса = ИС_MP_РаботаСHTTPЗапросамиСервер.ПолучитьСтруктуруHTTPЗапроса();
	ПараметрыЗапроса.Сервер = ПараметрыСоединения.АдресСервиса;
	ПараметрыЗапроса.Порт = ПараметрыСоединения.Порт;
	ПараметрыЗапроса.ЗащищенноеСоединение = ПараметрыСоединения.ЗащищенноеСоединение;
	ПараметрыЗапроса.Заголовки = Заголовки;
	
	МассивЗагруженныхЗаданий = Новый Массив;
		
	//+ ИнфоСофт Ивонин К.А. 03.02.25 УА #92887
	//Результат = ИС_АЛИ_API.ВыгрузитьКиЗ(Профиль, ТелоВыгрузки);
	Результат = ИС_АЛИ_API.ВыгрузитьКиЗ(Профиль, ПараметрыЗапроса, ТелоВыгрузки);
	//- ИнфоСофт Ивонин К.А. 03.02.25 УА #92406 
		
	Если Результат = Неопределено Тогда
		Возврат Неопределено;	
	КонецЕсли;
	
	Если Результат.marking_errors.Количество() = 0 Тогда
		Возврат Истина;
	КонецЕсли;
	
	Для Каждого Элемент Из Результат.marking_errors Цикл 
		ОбщегоНазначения.СообщитьПользователю("Произошла ошибка при выгрузке маркировки по заказу " + Элемент.sku_id + " по номенклатуре с артикулом "
		+ Элемент.product_source_id + ". Текст ошибки: " + Элемент.message);
	КонецЦикла;    
		
КонецФункции //- ИнфоСофт Стояк Ю.К. 14.06.2024 УА #62573

