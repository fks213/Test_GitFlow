Процедура ЗаполнитьЗначениеКолонки(Выборка, СтрокаТаблицы, РазделительФотографий, ИмяЗаполняемойКолонки) Экспорт

	Если ЗначениеЗаполнено(Выборка.ИС_АЛИ_АтрибутКод) Тогда
		ИмяКолонки = "Атрибут_" + СтрЗаменить(Строка(Выборка.ИС_АЛИ_АтрибутКод), Символы.НПП, "");
	Иначе
		ИмяКолонки = Выборка.АтрибутАли;
	КонецЕсли;

	Если Не СтрокаТаблицы.Свойство(ИмяКолонки) Или (ЗначениеЗаполнено(ИмяЗаполняемойКолонки) И ИмяКолонки
		<> ИмяЗаполняемойКолонки) Тогда
		Возврат;
	КонецЕсли;

	Если Выборка.ВидРеквизита1С = ПредопределенноеЗначение(
		"Перечисление.ИС_Ozon_ВидРеквизитаСопоставления.ШтрихкодНоменклатуры") Тогда
		ЗначениеАтрибутаАли = СтрокаТаблицы.Штрихкод;
	ИначеЕсли ЗначениеЗаполнено(Выборка.ТекстоваяСтрока) И Не Выборка.ТребуетсяСопоставление Тогда
		ЗначениеАтрибутаАли = Выборка.ТекстоваяСтрока;
	Иначе
		//+ ИнфоСофт Заварин К.В. 18.05.24 УА #71157
		//ЗначениеАтрибутаАли = Выборка.ЗначениеАтрибутаАли;
		Если Выборка.Множитель <> 0 Тогда
			ЗначениеАтрибутаАли = Выборка.ЗначениеАтрибутаАли * Выборка.Множитель;
		Иначе
			ЗначениеАтрибутаАли = Выборка.ЗначениеАтрибутаАли;
		КонецЕсли;
		//- ИнфоСофт Заварин К.В. 18.05.24 УА #71157
	КонецЕсли;

	Если ТипЗнч(СтрокаТаблицы[ИмяКолонки]) = Тип("СписокЗначений") Тогда
		//Если ИмяКолонки = "Изображения" Тогда
		//	Если ТипЗнч(ЗначениеАтрибутаАли) = Тип("Строка") И РазделительФотографий <> "" Тогда
		//		МассивЗначений = СтрРазделить(ЗначениеАтрибутаАли, РазделительФотографий, Ложь);
		//	Иначе
		//		Ozon_Константы = ПолучитьНастройкиСопоставления();
		//		РазделительФотографий = Ozon_Константы.РазделительФотографий;
		//		//Ozon_Константы = Ozon_КонстантыВызовСервера.ПрочитатьКонстанты();
		//		РасширенияДляВыгрузкиКартинок = Ozon_Константы.РасширенияДляВыгрузкиКартинок;
		//		Если ЗначениеЗаполнено(РасширенияДляВыгрузкиКартинок) Тогда

		//			//@skip-check wrong-string-literal-content
		//			Если (КраткоеНаименованиеОсновнойПодсистемы() = "УНФ"
		//				И ТипЗнч(ЗначениеАтрибутаАли) = Тип("СправочникСсылка.ХарактеристикиНоменклатурыПрисоединенныеФайлы")) Тогда
		//				ВладелецФайлов = СтрокаТаблицы.ХарактеристикаНоменклатуры;
		//			Иначе
		//				ВладелецФайлов = СтрокаТаблицы.Номенклатура;
		//			КонецЕсли;

		//			МассивЗначений = ПолучитьКартинкиПоВладельцу(ВладелецФайлов,
		//				РасширенияДляВыгрузкиКартинок);
		//		Иначе
		//			МассивЗначений = Новый Массив;
		//		КонецЕсли;

		//	КонецЕсли;
		//	МассивЗначений = ОбработатьСсылки(МассивЗначений);
		//Иначе
			Если ТипЗнч(ЗначениеАтрибутаАли) = Тип("Строка") И Выборка.ТребуетсяСопоставление Тогда
				МассивЗначений = ЗначенияАтрибутовАлиИзСтроки(
					ЗначениеАтрибутаАли);
			Иначе
				МассивЗначений = Новый Массив;
				МассивЗначений.Добавить(ЗначениеАтрибутаАли);
			КонецЕсли;
		//КонецЕсли;
		СтрокаТаблицы[ИмяКолонки].ЗагрузитьЗначения(МассивЗначений);
	Иначе

		Если ИмяКолонки = "main_image_urls_list" Тогда
			ЗначениеАтрибутаАли = ИС_Ozon_Сервер.ОбработатьСсылки(ЗначениеАтрибутаАли);
		КонецЕсли;

		Если ТипЗнч(СтрокаТаблицы[ИмяКолонки]) <> ТипЗнч(ЗначениеАтрибутаАли) Тогда

			Если Не ИС_Ozon_Сервер.ЭтоПримитивныйТип(ЗначениеАтрибутаАли) Тогда
				ЗначениеАтрибутаАли = Строка(ЗначениеАтрибутаАли);
