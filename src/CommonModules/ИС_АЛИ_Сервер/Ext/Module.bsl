#Область РегламентныеЗадания

//+ ИнфоСофт Ивонин К.А. 11.11.23 УА #55166
Процедура ВыполнитьКомандуРеглЗадания(Профиль, ИдентификаторКомандыОбработки) Экспорт

	Событие = ПолучитьИмяСобытия("ВыполнитьКомандуРеглЗадания");
	
	Если ИдентификаторКомандыОбработки = "ВыгрузкаЦенАли" Тогда
		ВыгрузитьЦены(Профиль);
		Возврат;				
	КонецЕсли;  
	
	Если ИдентификаторКомандыОбработки = "ВыгрузкаОстатковАли" Тогда
	
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	ИС_Али_Склады.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.ИС_Али_Склады КАК ИС_Али_Склады
		|ГДЕ
		|	НЕ ИС_Али_Склады.ПометкаУдаления
		|	И ИС_Али_Склады.Профиль = &Профиль
		//+ ИнфоСофт Заварин К.В. 13.08.24 УА #81097
		|	И НЕ(ИС_Али_Склады.ОбщаяГруппаСкладов = ЗНАЧЕНИЕ(Справочник.Склады.ПустаяСсылка)
		|				И ИС_Али_Склады.Склад = ЗНАЧЕНИЕ(Справочник.Склады.ПустаяСсылка)
		|				И ИС_Али_Склады.ВыгружатьОстаткиИзГруппыСкладов = ЛОЖЬ)";
		//- ИнфоСофт Заварин К.В. 13.08.24 УА #81097
		
		Запрос.УстановитьПараметр("Профиль", Профиль);
		
		РезультатЗапроса = Запрос.Выполнить();
		
		Выборка = РезультатЗапроса.Выбрать();
		
		Пока Выборка.Следующий() Цикл
			ВыгрузитьОстатки(Профиль, Выборка.Ссылка);
		КонецЦикла;
		
		Возврат;
		
	КонецЕсли;
	
	Если ИдентификаторКомандыОбработки = "ПолучениеСборочныхЗаданийАли" Тогда
		ПолучитьСписокЗаказов(Профиль, ПолучитьДатуПоследнегоЗаказа(Профиль));
		Возврат;			
	КонецЕсли;
	
	Если ИдентификаторКомандыОбработки = "ЗакрыватьЗаказВТечениеДняАли" Тогда 
        ВыполнитьЗакрытиеЗаказов(Профиль);
		Возврат;	
    КонецЕсли;
    
	Если ИдентификаторКомандыОбработки = "ОбновлениеСтатусовСборочныхЗаданийАли" Тогда
		ПолучитьСтатусы(Профиль);
		Возврат;
	КонецЕсли; 

КонецПроцедуры //- ИнфоСофт Ивонин К.А. 11.11.23 УА #55166

