//+ ИнфоСофт Стояк Ю.К. 04.03.2023 УА #54628    
Функция ПолучитьКарточкиТоваров(Профиль, Перезаполнять = Ложь, ДопПараметры = Неопределено) Экспорт
	
	Если Не ЗначениеЗаполнено(Профиль) Тогда
		ОбщегоНазначения.СообщитьПользователю("Не выбран Профиль. Загрузка товаров невозможна");
		Возврат Неопределено;
	КонецЕсли;
	
	ПараметрыСоединения = Неопределено;
	Если Не ПолучитьПараметрыСоединения(Профиль, ПараметрыСоединения) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Заголовки = Неопределено;
	Если Не CформироватьЗаголовкиЗапроса(Заголовки, ПараметрыСоединения) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	ПараметрыЗапроса = ИС_MP_РаботаСHTTPЗапросамиСервер.ПолучитьСтруктуруHTTPЗапроса();
	ПараметрыЗапроса.Сервер = ПараметрыСоединения.АдресСервиса;
	ПараметрыЗапроса.Порт = ПараметрыСоединения.Порт;
	ПараметрыЗапроса.ЗащищенноеСоединение = ПараметрыСоединения.ЗащищенноеСоединение;
	ПараметрыЗапроса.Заголовки = Заголовки;
	
	СписокТоваров = Новый Массив;
	
	ТаблицаТоваров = Новый ТаблицаЗначений;
	ТаблицаТоваров.Колонки.Добавить("Номер", Новый ОписаниеТипов("Строка", , , , Новый КвалификаторыСтроки(30)));
	ТаблицаТоваров.Колонки.Добавить("ДатаПоследнегоИзменения", Новый ОписаниеТипов("Дата"));
	
	КоличествоЭлементовНаСтранице = 50;
	ПределОшибок = 10;
	КоличествоОшибок = 0;
	last_id = Неопределено;
	Обработано = 0;
	Всего = 0;
	
	rawData = Новый Структура;
	rawData.Вставить("limit", КоличествоЭлементовНаСтранице);
	
	Пока Истина Цикл	                                         
		
		Если ЗначениеЗаполнено(last_id) Тогда
			rawData.Вставить("last_product_id", last_id);  
		КонецЕсли;
		
		Если КоличествоОшибок >= ПределОшибок Тогда
			Возврат Неопределено;
		КонецЕсли;
		
		Результат = ИС_АЛИ_API.ЗагрузитьКарточкиТоваров(Профиль, ПараметрыЗапроса, rawData); 
		
		Если Результат = Неопределено Тогда
			КоличествоОшибок = КоличествоОшибок + 1;
			Продолжить;
		КонецЕсли;
		
		Если Результат.Количество() = 0 Тогда
			Прервать;
		КонецЕсли;
		
		Для Каждого Элемент Из Результат Цикл
			
			НоваяСтрока = ТаблицаТоваров.Добавить();
			НоваяСтрока.Номер = Элемент.id;
			НоваяСтрока.ДатаПоследнегоИзменения = ИС_MP_РаботаСHTTPЗапросамиСервер.ПрочитатьДатуИзJSON(Элемент.ali_updated_at, ФорматДатыJSON.ISO); 
			
		КонецЦикла;               
		
		last_id = Результат[Результат.ВГраница()].id; 
		
		Всего = ТаблицаТоваров.Количество();
		
		ДлительныеОперации.СообщитьПрогресс( , СтрШаблон("Уже обработано %1 товаров из %2", Обработано, Всего));
		
	КонецЦикла;
	
	Если Перезаполнять Тогда
		
		Для Каждого Элемент Из ТаблицаТоваров Цикл
			СписокТоваров.Добавить(Элемент.Номер);
		КонецЦикла;
		
	Иначе
		
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	ТЧ.Номер КАК Номер,
		|	ТЧ.ДатаПоследнегоИзменения КАК ДатаПоследнегоИзменения
		|ПОМЕСТИТЬ ВТ_ТЧ
		|ИЗ
		|	&ТЧ КАК ТЧ
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ВТ_ТЧ.Номер КАК Номер
		|ИЗ
		|	ВТ_ТЧ КАК ВТ_ТЧ
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ИС_АЛИ_Номенклатура КАК ИС_АЛИ_Номенклатура
		|		ПО ВТ_ТЧ.Номер = ИС_АЛИ_Номенклатура.Код
		|			И (ИС_АЛИ_Номенклатура.Профиль = &Профиль)
		|ГДЕ
		|	ВТ_ТЧ.ДатаПоследнегоИзменения > ЕСТЬNULL(ИС_АЛИ_Номенклатура.ali_updated_at, ДАТАВРЕМЯ(1, 1, 1))";
		
		Запрос.УстановитьПараметр("ТЧ", ТаблицаТоваров);
		Запрос.УстановитьПараметр("Профиль", Профиль);
		
		РезультатЗапроса = Запрос.Выполнить();
		
		ВыборкаТовары = РезультатЗапроса.Выбрать();
		
		Пока ВыборкаТовары.Следующий() Цикл
			СписокТоваров.Добавить(ВыборкаТовары.Номер);	
		КонецЦикла;
		
		Всего = СписокТоваров.Количество();
		
	КонецЕсли;
	
	МассивОшибок = Новый Массив;
	
	Счетчик = 0;
	
	Для Каждого Элемент Из СписокТоваров Цикл 
		
		Если Счетчик % 10 = 0 Тогда
			ДлительныеОперации.СообщитьПрогресс( , СтрШаблон("Уже обработано %1 товаров из %2", Обработано, Всего));
		КонецЕсли;
		
		rawData = Новый Структура;                                  
		rawData.Вставить("product_id", Элемент);
		
		ИнформацияОТоваре = ИС_АЛИ_API.ПолучитьДанныеОТоваре(Профиль, ПараметрыЗапроса, rawData);						
		
		Если ИнформацияОТоваре = Неопределено Тогда
			МассивОшибок.Добавить(Элемент);
			Продолжить;
		КонецЕсли;  
		
		//+ ИнфоСофт Мурсалимов Д.Р. 18.06.24 УА #77964
		//AliНоменклатура = Справочники.ИС_АЛИ_Номенклатура.НайтиПоКоду(ИнформацияОТоваре.id);
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	ИС_АЛИ_Номенклатура.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.ИС_АЛИ_Номенклатура КАК ИС_АЛИ_Номенклатура
		|ГДЕ
		|	ИС_АЛИ_Номенклатура.Профиль = &Профиль
		|	И ИС_АЛИ_Номенклатура.Код = &Код";
		
		Запрос.УстановитьПараметр("Профиль", Профиль);
		Запрос.УстановитьПараметр("Код", ИнформацияОТоваре.id); 
				
		РезультатЗапроса = Запрос.Выполнить();
		
		ВыборкаНоменклатуры = РезультатЗапроса.Выбрать();
		
		Если ВыборкаНоменклатуры.Следующий() Тогда
			AliНоменклатура = ВыборкаНоменклатуры.Ссылка;
		Иначе
			AliНоменклатура = Справочники.ИС_АЛИ_Номенклатура.ПустаяСсылка();
		КонецЕсли;
		//- ИнфоСофт Мурсалимов Д.Р. 18.06.24 УА #77964
		
		Если Не AliНоменклатура.Пустая() Тогда				
			AliНоменклатура = AliНоменклатура.ПолучитьОбъект();	
		Иначе
			AliНоменклатура = Справочники.ИС_АЛИ_Номенклатура.СоздатьЭлемент();
		КонецЕсли; 
		
		AliНоменклатура.Код = ИнформацияОТоваре.id;
		AliНоменклатура.ali_updated_at = ИС_MP_РаботаСHTTPЗапросамиСервер.ПрочитатьДатуИзJSON(ИнформацияОТоваре.ali_updated_at, ФорматДатыJSON.ISO);
		
		Попытка 
			
			subject = "";
			
			Для Каждого Элем Из ИнформацияОТоваре.subject Цикл
				
				Если Элем.locale = "ru_RU" Тогда
					subject = Элем.name;
				КонецЕсли; 	
				
			КонецЦикла;
			
			AliНоменклатура.Наименование = subject;
			AliНоменклатура.ПолноеНаименование = subject;
			
		Исключение
		КонецПопытки;
		
		AliНоменклатура.category_id = ИнформацияОТоваре.category_id;									
		AliНоменклатура.Профиль = Профиль;
		
		Обработано = Обработано + 1;
		
		Попытка
			AliНоменклатура.Записать();
		Исключение
			ОбщегоНазначения.СообщитьПользователю(ОписаниеОшибки());
			Продолжить;
		КонецПопытки;
		
		Для Каждого Вариация Из ИнформацияОТоваре.sku Цикл
			
			//+ ИнфоСофт Мурсалимов Д.Р. 18.06.24 УА #77964
			//AliВариация = Справочники.ИС_АЛИ_Вариации.НайтиПоКоду(Вариация.code);
			Запрос = Новый Запрос;
			Запрос.Текст = 
			"ВЫБРАТЬ
			|	ИС_АЛИ_Вариации.Ссылка КАК Ссылка
			|ИЗ
			|	Справочник.ИС_АЛИ_Вариации КАК ИС_АЛИ_Вариации
			|ГДЕ
			|	ИС_АЛИ_Вариации.Профиль = &Профиль
			|	И ИС_АЛИ_Вариации.Код = &Код";
			
			Запрос.УстановитьПараметр("Профиль", Профиль);
			Запрос.УстановитьПараметр("Код", Вариация.sku_id); 
			
			РезультатЗапроса = Запрос.Выполнить();
			
			ВыборкаВариации = РезультатЗапроса.Выбрать();
			
			Если ВыборкаВариации.Следующий() Тогда
				AliВариация = ВыборкаВариации.Ссылка;
			Иначе
				AliВариация = Справочники.ИС_АЛИ_Вариации.ПустаяСсылка();
			КонецЕсли;
			//- ИнфоСофт Мурсалимов Д.Р. 18.06.24 УА #77964
			
			Если Не AliВариация = Справочники.ИС_АЛИ_Вариации.ПустаяСсылка() Тогда				
				AliВариация = AliВариация.ПолучитьОбъект();					
			Иначе
				AliВариация = Справочники.ИС_АЛИ_Вариации.СоздатьЭлемент();
			КонецЕсли;
			
			AliВариация.Владелец = AliНоменклатура.Ссылка;
			AliВариация.id = Вариация.id;				
			AliВариация.Код = Вариация.sku_id;
			AliВариация.КодВариации = Вариация.code;
			AliВариация.Наименование = Вариация.id;						
			AliВариация.sku_id = Вариация.sku_id;			
			AliВариация.gtin = Вариация.gtin;
			AliВариация.Профиль = Профиль;
			
			Для Каждого Код Из Вариация.classifier_codes Цикл					
				НоваяСтрока	= AliВариация.classifier_codes.Добавить();
				НоваяСтрока.type = Код.type;
				НоваяСтрока.value = Код.value;					
			КонецЦикла;                         				
			
			Для Каждого Характеристика Из Вариация.property Цикл
				НоваяСтрока	= AliВариация.property.Добавить();				
				НоваяСтрока.name_id = Характеристика.name_id;					
				НоваяСтрока.name = Характеристика.name;
				НоваяСтрока.value_id = Характеристика.value_id;			
				НоваяСтрока.value = Характеристика.value;
				НоваяСтрока.value_definition = Характеристика.value_definition;					
			КонецЦикла;
			
			Попытка
				AliВариация.Записать();
			Исключение
				ОбщегоНазначения.СообщитьПользователю(ОписаниеОшибки());
				Продолжить;
			КонецПопытки;				
			
		КонецЦикла;
		
		Счетчик = Счетчик + 1;
		
	КонецЦикла;
	
	Если МассивОшибок.Количество() > 0 Тогда
		Возврат "Загрузка завершена с ошибками. Не все товары были загруженны, повторите загрузку позже...";
	КонецЕсли;
	
	Возврат "Загрузка завершена";
	
КонецФункции //- ИнфоСофт Стояк Ю.К. 20.01.2023 УА #52524

//+ ИнфоСофт Стояк Ю.К. 10.04.2024 УА #62574
Функция СоздатьОбновитьКатегориюТоваров(Профиль, ПараметрыЗапроса, ДанныеКатегории, РодительId = Неопределено,
	КатегорияСсылка = Неопределено)
	
	Если КатегорияСсылка = Неопределено Тогда
		Если ДанныеКатегории.children_ids.Количество() Тогда
			КатегорияОбъект = Справочники.ИС_АЛИ_КатегорииТоваров.СоздатьГруппу();
		Иначе
			КатегорияОбъект = Справочники.ИС_АЛИ_КатегорииТоваров.СоздатьЭлемент();
		КонецЕсли;
	Иначе
		КатегорияОбъект = КатегорияСсылка.ПолучитьОбъект();
	КонецЕсли;   
	
	КатегорияОбъект.Код 			= Число(ДанныеКатегории.id); 		
	КатегорияОбъект.Наименование 	= ДанныеКатегории.name; 	
	
	Если Не КатегорияОбъект.ЭтоГруппа Тогда
		КатегорияОбъект.is_visible = ДанныеКатегории.is_visible;                                  
		КатегорияОбъект.parent_id 	= РодительId;
	КонецЕсли;
	
	Если РодительId <> Неопределено Тогда
		КатегорияОбъект.Родитель 	= Справочники.ИС_АЛИ_КатегорииТоваров.НайтиПоКоду(РодительId);		
	КонецЕсли;   
	
	Для Каждого Элемент Из ДанныеКатегории.sku_properties Цикл
		
		Атрибут = СоздатьИлиОбновитьАтрибут(Элемент); 
		
		Отбор = Новый Структура();
		Отбор.Вставить("Атрибут", Атрибут);
		НайденноеЗначение = КатегорияОбъект.sku_properties.НайтиСтроки(Отбор); 
		
		Если НайденноеЗначение.Количество() = 0 Тогда
		
			НСтр = КатегорияОбъект.sku_properties.Добавить();
					
			НСтр.Атрибут		= Атрибут;
			НСтр.is_required 	= Элемент.is_required;
			
		КонецЕсли;
	
	КонецЦикла;   
	
	Для Каждого Элемент Из ДанныеКатегории.properties Цикл
		
		Атрибут = СоздатьИлиОбновитьАтрибут(Элемент); 
		
		Отбор = Новый Структура();
		Отбор.Вставить("Атрибут", Атрибут);
		НайденноеЗначение = КатегорияОбъект.properties.НайтиСтроки(Отбор);
		
		Если НайденноеЗначение.Количество() = 0 Тогда
		
			НСтр = КатегорияОбъект.properties.Добавить();
					
			НСтр.Атрибут		= Атрибут;
			НСтр.is_required 	= Элемент.is_required;
			
		КонецЕсли;
	
	КонецЦикла;
	
	Попытка
		КатегорияОбъект.Записать();
	Исключение
		ИмяСобытия = ПолучитьИмяСобытия("ЗагрузкаКатегорийТоваров");
		Комментарий = "Не удалось записать категорию товаров: " + КатегорияОбъект.Наименование + Символы.ПС
			+ ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());		
	КонецПопытки; 
	
	МассивДочернихКатегорий = Новый Массив;
	
	Для Каждого Элемент Из ДанныеКатегории.children_ids Цикл
		МассивДочернихКатегорий.Добавить(Строка(Элемент));	
	КонецЦикла; 
	
	Если МассивДочернихКатегорий.Количество() > 0 Тогда
		
		РазбитыйМассив = ИС_MP_Сервер.РазбитьМассивПоNЭлементов(МассивДочернихКатегорий, 20);
		
		Для Каждого Элемент Из РазбитыйМассив Цикл 
			
			rawData = Новый Структура("ids", Элемент);
			
			Результат = ИС_АЛИ_API.ПолучитьДочерниеКатегории(Профиль, ПараметрыЗапроса, rawData); 
			
			Если Результат = Неопределено Или Результат.Количество() = 0 Тогда			
				Продолжить;
			КонецЕсли; 
			
			Для Каждого Категория Из Результат Цикл						
				
				КатегорияСсылка = Справочники.ИС_АЛИ_КатегорииТоваров.НайтиПоКоду(Категория.id);
				
				Если ЗначениеЗаполнено(КатегорияСсылка) Тогда
					СоздатьОбновитьКатегориюТоваров(Профиль, ПараметрыЗапроса, Категория, Число(Категория.parent_id), КатегорияСсылка); 
				Иначе
					СоздатьОбновитьКатегориюТоваров(Профиль, ПараметрыЗапроса, Категория, Число(Категория.parent_id)); 
				КонецЕсли;
				
			КонецЦикла;
			
		КонецЦикла;
		
	КонецЕсли;

	Возврат КатегорияОбъект.Ссылка;

КонецФункции //- ИнфоСофт Стояк Ю.К. 10.04.2024 УА #62574

//+ ИнфоСофт Стояк Ю.К. 10.04.2024 УА #62574
Функция СоздатьИлиОбновитьАтрибут(ДанныеАтрибута)
	
	
	MD5 = ПолучитьMD5Хэш(ДанныеАтрибута);
	
	СсылкаАтрибут = Справочники.ИС_АЛИ_Атрибут.НайтиПоКоду(Число(ДанныеАтрибута.id));	
	
	Если СсылкаАтрибут.Пустая() Тогда
		АтрибутОбъект = Справочники.ИС_АЛИ_Атрибут.СоздатьЭлемент();
	Иначе
		
		Если СсылкаАтрибут.MD5 = MD5 Тогда
			Возврат СсылкаАтрибут.Ссылка;
		КонецЕсли;					
		
		АтрибутОбъект = СсылкаАтрибут.ПолучитьОбъект();
		
	КонецЕсли;					
	
	АтрибутОбъект.MD5 					= MD5; 		
	АтрибутОбъект.Код 					= Число(ДанныеАтрибута.id); 		
	АтрибутОбъект.Наименование 			= ДанныеАтрибута.name; 	 
		
	АтрибутОбъект.is_key 				= ДанныеАтрибута.is_key;
	АтрибутОбъект.is_brand 				= ДанныеАтрибута.is_brand;
	АтрибутОбъект.is_enum_prop 			= ДанныеАтрибута.is_enum_prop;
	АтрибутОбъект.is_multi_select 		= ДанныеАтрибута.is_multi_select;
	АтрибутОбъект.is_input_prop 		= ДанныеАтрибута.is_input_prop;
	АтрибутОбъект.has_unit 				= ДанныеАтрибута.has_unit;
	АтрибутОбъект.has_customized_pic 	= ДанныеАтрибута.has_customized_pic;
	АтрибутОбъект.has_customized_name	= ДанныеАтрибута.has_customized_name;
	
	
	Если АтрибутОбъект.has_unit Тогда 
		
		Для Каждого Элемент Из ДанныеАтрибута.units Цикл
			
			НСтр = АтрибутОбъект.units.Добавить(); 
			
			НСтр.rate 				= Элемент.rate;
			НСтр.name 				= Элемент.name;
			
		КонецЦикла;  
		
	КонецЕсли;
	
	Попытка
		АтрибутОбъект.Записать();
	Исключение
		ИмяСобытия = ПолучитьИмяСобытия("СоздатьИлиОбновитьАтрибут");
		Комментарий = "Не удалось записать атрибут категории: " + АтрибутОбъект.Наименование + Символы.ПС
			+ ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());		
	КонецПопытки; 
	
	Возврат АтрибутОбъект.Ссылка;

КонецФункции //- ИнфоСофт Стояк Ю.К. 10.04.2024 УА #62574

//+ ИнфоСофт Стояк Ю.К. 10.04.2024 УА #62574
Функция ЗагрузитьКатегорииТоваров(Профиль) Экспорт
	
	Если Не ЗначениеЗаполнено(Профиль) Тогда
		ОбщегоНазначения.СообщитьПользователю("Не выбран Профиль. Загрузка категорий невозможна");
		Возврат Неопределено;
	КонецЕсли;
	
	ПараметрыСоединения = Неопределено;
	Если Не ПолучитьПараметрыСоединения(Профиль, ПараметрыСоединения) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Заголовки = Неопределено;
	Если Не CформироватьЗаголовкиЗапроса(Заголовки, ПараметрыСоединения) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	ПараметрыЗапроса = ИС_MP_РаботаСHTTPЗапросамиСервер.ПолучитьСтруктуруHTTPЗапроса();
	ПараметрыЗапроса.Сервер = ПараметрыСоединения.АдресСервиса;
	ПараметрыЗапроса.Порт = ПараметрыСоединения.Порт;
	ПараметрыЗапроса.ЗащищенноеСоединение = ПараметрыСоединения.ЗащищенноеСоединение;
	ПараметрыЗапроса.Заголовки = Заголовки;
	
	ПределОшибок = 10;
	КоличествоОшибок = 0;			
	
	Пока Истина Цикл	                                         
				
		Если КоличествоОшибок >= ПределОшибок Тогда
			Возврат Неопределено;
		КонецЕсли;
		
		Результат = ИС_АЛИ_API.ПолучитьКатегорииВерхнегоУровня(Профиль, ПараметрыЗапроса); 
		
		Если Результат = Неопределено Тогда
			КоличествоОшибок = КоличествоОшибок + 1;
			Продолжить;
		КонецЕсли;
		
		Если Результат.Количество() = 0 Тогда
			Прервать;
		КонецЕсли;
		
		Для Каждого Элемент Из Результат Цикл						
			
			КатегорияСсылка = Справочники.ИС_АЛИ_КатегорииТоваров.НайтиПоКоду(Число(Элемент.id));
			
			Если ЗначениеЗаполнено(КатегорияСсылка) Тогда
				СоздатьОбновитьКатегориюТоваров(Профиль, ПараметрыЗапроса, Элемент, , КатегорияСсылка); 
			Иначе
			    СоздатьОбновитьКатегориюТоваров(Профиль, ПараметрыЗапроса, Элемент); 
			КонецЕсли;
		КонецЦикла;
		
		Прервать;
		
	КонецЦикла;				
	
КонецФункции //- ИнфоСофт Стояк Ю.К. 10.04.2024 УА #62574

//+ ИнфоСофт Стояк Ю.К. 10.04.2024 УА #62574
Процедура ЗагрузитьЗнченияАтрибутов(Профиль, Категория = Неопределено, Свойство = Неопределено, ШаблонДоствки = Неопределено) Экспорт

	Если Не ЗначениеЗаполнено(Профиль) Тогда
		ОбщегоНазначения.СообщитьПользователю("Не выбран Профиль. Загрузка категорий невозможна");
		Возврат;
	КонецЕсли;
	
	ПараметрыСоединения = Неопределено;
	Если Не ПолучитьПараметрыСоединения(Профиль, ПараметрыСоединения) Тогда
		Возврат;
	КонецЕсли;
	
	Заголовки = Неопределено;
	Если Не CформироватьЗаголовкиЗапроса(Заголовки, ПараметрыСоединения) Тогда
		Возврат;
	КонецЕсли; 
	
	ПараметрыЗапроса = ИС_MP_РаботаСHTTPЗапросамиСервер.ПолучитьСтруктуруHTTPЗапроса();
	ПараметрыЗапроса.Сервер = ПараметрыСоединения.АдресСервиса;
	ПараметрыЗапроса.Порт = ПараметрыСоединения.Порт;
	ПараметрыЗапроса.ЗащищенноеСоединение = ПараметрыСоединения.ЗащищенноеСоединение;
	ПараметрыЗапроса.Заголовки = Заголовки;
	
	Если Не ЗначениеЗаполнено(Категория) Тогда 
		
		ПределОшибок = 10;
		КоличествоОшибок = 0;
		
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	ИС_АЛИ_КатегорииТоваровproperties.Ссылка.Код КАК Код,
		|	ИС_АЛИ_КатегорииТоваровproperties.Атрибут.Код КАК АтрибутКод,
		|	ЛОЖЬ КАК СвойствоВариации,
		|	ИС_АЛИ_КатегорииТоваровproperties.Атрибут.Ссылка КАК АтрибутСсылка
		|ИЗ
		|	Справочник.ИС_АЛИ_КатегорииТоваров.properties КАК ИС_АЛИ_КатегорииТоваровproperties
		|ГДЕ
		|	НЕ ИС_АЛИ_КатегорииТоваровproperties.Ссылка.ЭтоГруппа
		|	И ИС_АЛИ_КатегорииТоваровproperties.Ссылка.Используется
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	ИС_АЛИ_КатегорииТоваровsku_properties.Ссылка.Код,
		|	ИС_АЛИ_КатегорииТоваровsku_properties.Атрибут.Код,
		|	ИСТИНА,
		|	ИС_АЛИ_КатегорииТоваровsku_properties.Атрибут.Ссылка
		|ИЗ
		|	Справочник.ИС_АЛИ_КатегорииТоваров.sku_properties КАК ИС_АЛИ_КатегорииТоваровsku_properties
		|ГДЕ
		|	НЕ ИС_АЛИ_КатегорииТоваровsku_properties.Ссылка.ЭтоГруппа
		|	И ИС_АЛИ_КатегорииТоваровsku_properties.Ссылка.Используется";
		
		РезультатЗапроса = Запрос.Выполнить();
		
		ВыборкаДетальныеЗаписи = РезультатЗапроса.Выгрузить();
		
		Для Каждого Выборка Из ВыборкаДетальныеЗаписи Цикл
			
			rawData = Новый Структура("category_id, property_id, is_sku_property",
			Выборка.Код, Выборка.АтрибутКод, Выборка.СвойствоВариации);
			
			Результат = ИС_АЛИ_API.ПолучитьЗначенияАтрибутов(Профиль, ПараметрыЗапроса, rawData);
			
			Если Результат = Неопределено Тогда
				КоличествоОшибок = КоличествоОшибок + 1;
				Продолжить;
			КонецЕсли;
			
			Если КоличествоОшибок = ПределОшибок Тогда
				Возврат;
			КонецЕсли;
			
			ОбработатьЗначенияАтрибута(Результат, Выборка.АтрибутСсылка);				
			
		КонецЦикла;
		
	КонецЕсли;
	
	
КонецПроцедуры //- ИнфоСофт Стояк Ю.К. 10.04.2024 УА #62574

//+ ИнфоСофт Стояк Ю.К. 10.04.2024 УА #62574
Процедура ОбработатьЗначенияАтрибута(Результат, Атрибут)

	Для Каждого Значение Из Результат Цикл
		
		ЗначениеАтрибута = Справочники.ИС_АЛИ_ЗначенияАтрибутов.НайтиПоКоду(Число(Значение.id));
		
		Если ЗначениеЗаполнено(ЗначениеАтрибута) И Не ЗначениеАтрибута.Пустая() Тогда
			ЗначениеАтрибута = ЗначениеАтрибута.ПолучитьОбъект();	
		Иначе                                                                                  
			ЗначениеАтрибута = Справочники.ИС_АЛИ_ЗначенияАтрибутов.СоздатьЭлемент();									
		КонецЕсли;   
		
		ЗначениеАтрибута.Код 			= Число(Значение.id);
		ЗначениеАтрибута.Наименование 	= Значение.name;
		ЗначениеАтрибута.Владелец		= Атрибут; 
		
		Попытка
			ЗначениеАтрибута.Записать();
		Исключение
			ИмяСобытия = ПолучитьИмяСобытия("ОбработатьЗначенияАтрибута");
			Комментарий = "Не удалось записать значение атрибута: " + ЗначениеАтрибута.Наименование + Символы.ПС
			+ ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());		
		КонецПопытки;	
		
	КонецЦикла;
	
