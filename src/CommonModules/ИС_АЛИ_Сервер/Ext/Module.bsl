//+ ИнфоСофт Стояк Ю.К. 04.03.2024 УА #56408
Функция ПолучитьАктивныйЗаказКлиента(СборочноеЗадание, ДатаОтгрузки)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ИС_АЛИ_ЗаказыВТеченииДня.ЗаказКлиента КАК ЗаказКлиента
	|ИЗ
	|	РегистрСведений.ИС_АЛИ_ЗаказыВТеченииДня КАК ИС_АЛИ_ЗаказыВТеченииДня
	|ГДЕ
	|	ИС_АЛИ_ЗаказыВТеченииДня.ЗаказОткрыт
	|	И ИС_АЛИ_ЗаказыВТеченииДня.ДатаОтгрузки = &ДатаОтгрузки
	|	И ИС_АЛИ_ЗаказыВТеченииДня.Профиль = &Профиль";
	
	Запрос.УстановитьПараметр("ДатаОтгрузки", ДатаОтгрузки);
	Запрос.УстановитьПараметр("Профиль", СборочноеЗадание.Профиль);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Если РезультатЗапроса.Пустой() Тогда
		Возврат Неопределено;	
	КонецЕсли; 	
	
	ВыборкаДетальныеЗаписи.Следующий();	
	
	Возврат ВыборкаДетальныеЗаписи.ЗаказКлиента;
	
