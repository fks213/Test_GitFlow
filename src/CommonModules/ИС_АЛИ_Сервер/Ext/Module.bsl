//+ ИнфоСофт Стояк Ю.К. 04.03.2023 УА #54628
Функция ПолучитьЦеныТовара(Профиль) Экспорт
	
	Если Не ЗначениеЗаполнено(Профиль) Тогда
		ОбщегоНазначения.СообщитьПользователю("Не выбран Профиль. Загрузка товаров невозможна");
		Возврат Неопределено;
	КонецЕсли;
	
	ПараметрыСоединения = Неопределено;
	Если Не ПолучитьПараметрыСоединения(Профиль, ПараметрыСоединения) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Заголовки = Неопределено;
	Если Не CформироватьЗаголовкиЗапроса(Заголовки, ПараметрыСоединения) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	ПараметрыЗапроса = ИС_MP_РаботаСHTTPЗапросамиСервер.ПолучитьСтруктуруHTTPЗапроса();
	ПараметрыЗапроса.Сервер = ПараметрыСоединения.АдресСервиса;
	ПараметрыЗапроса.Порт = ПараметрыСоединения.Порт;
	ПараметрыЗапроса.ЗащищенноеСоединение = ПараметрыСоединения.ЗащищенноеСоединение;
	ПараметрыЗапроса.Заголовки.Вставить("x-auth-token", Заголовки["x-auth-token"]);		
	
	СписокТоваров = Неопределено;
	
	КоличествоЭлементовНаСтранице = 50;
	last_id = Неопределено;
	
	ТаблицаЦен = Новый ТаблицаЗначений;  
	
	КвалификаторыЧисла = Новый КвалификаторыЧисла(10, 2, ДопустимыйЗнак.Неотрицательный);
	КвалификаторыСтроки = Новый КвалификаторыСтроки(20);
	
	ТаблицаЦен.Колонки.Добавить("id", Новый ОписаниеТипов("Строка",КвалификаторыСтроки));
	ТаблицаЦен.Колонки.Добавить("price", Новый ОписаниеТипов("Число",КвалификаторыЧисла));
	ТаблицаЦен.Колонки.Добавить("discount_price", Новый ОписаниеТипов("Число",КвалификаторыЧисла));
	
	Пока Истина Цикл	
		
		rawData = Новый Структура;		
		Если ЗначениеЗаполнено(last_id) Тогда
			rawData.Вставить("last_product_id", last_id);  
		Иначе
			last_id = 0;
		КонецЕсли;                                     		
		rawData.Вставить("limit", КоличествоЭлементовНаСтранице);
		
		СписокТоваров = ИС_АЛИ_API.ЗагрузитьКарточкиТоваров(Профиль, ПараметрыЗапроса, rawData); 
		
		Если Не ЗначениеЗаполнено(СписокТоваров) Тогда
			Возврат Неопределено;
		КонецЕсли;               
		
		Если Не СписокТоваров.Количество() > 0 Тогда
			Прервать;
		КонецЕсли;
		
		Для Каждого Элемент Из СписокТоваров Цикл 
			
			rawData = Новый Структура;                                  
			rawData.Вставить("product_id", Элемент.id);
			
			ИнформацияОТоваре = ИС_АЛИ_API.ПолучитьДанныеОТоваре(Профиль, ПараметрыЗапроса, rawData);						
			
			Если Не ЗначениеЗаполнено(ИнформацияОТоваре) Тогда
				Продолжить;
			КонецЕсли;  
			
			Для Каждого Вариация Из ИнформацияОТоваре.sku Цикл
				
				НоваяСтрока = ТаблицаЦен.Добавить();
				НоваяСтрока.id = Вариация.sku_id;			
				НоваяСтрока.price = Вариация.price;
				НоваяСтрока.discount_price = Вариация.discount_price;			
				
			КонецЦикла;
			
		КонецЦикла;
		
	КонецЦикла;
	
	Возврат ТаблицаЦен;
	
КонецФункции //- ИнфоСофт Стояк Ю.К. 20.01.2023 УА #52524

