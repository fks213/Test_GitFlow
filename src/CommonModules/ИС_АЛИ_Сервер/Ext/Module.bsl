//+ ИнфоСофт Ивонин К.А. 14.03.24 УА #71892
Функция ПолучитьСкладПоУмолчанию(Профиль) Экспорт

	Результат = Справочники.ИС_Али_Склады.ПустаяСсылка();
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ ПЕРВЫЕ 2
	|	ИС_Али_Склады.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.ИС_Али_Склады КАК ИС_Али_Склады
	|ГДЕ
	|	ИС_Али_Склады.Профиль = &Профиль
	|	И НЕ ИС_Али_Склады.ПометкаУдаления";

	Запрос.УстановитьПараметр("Профиль", Профиль);
		
	РезультатЗапроса = Запрос.Выполнить();
	
	Выборка = РезультатЗапроса.Выбрать();

	Если Выборка.Количество() = 1 Тогда
		Выборка.Следующий();
		Результат = Выборка.Ссылка;
	КонецЕсли; 
	
	Возврат Результат;
	
КонецФункции //- ИнфоСофт Ивонин К.А. 14.03.24 УА #71892

//+ ИнфоСофт Ивонин К.А. 15.03.24 УА #71892
Функция ПолучитьОстаткиFBS(Профиль, Склад) Экспорт
	
	НастройкиСоединения = ПолучитьНастройкиСоединенияПрофиля(Профиль);	
	ПараметрыЗапроса = ПроверитьИЗаполнитьПараметрыЗапроса(НастройкиСоединения);
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ИС_АЛИ_Вариации.Ссылка КАК Ссылка,
	|	ИС_АЛИ_Вариации.sku_id КАК sku_id
	|ИЗ
	|	Справочник.ИС_АЛИ_Вариации КАК ИС_АЛИ_Вариации
	|ГДЕ
	|	ИС_АЛИ_Вариации.Профиль = &Профиль
	|	И НЕ ИС_АЛИ_Вариации.ПометкаУдаления
	|	И НЕ ИС_АЛИ_Вариации.sku_id = """"";
	
	Запрос.УстановитьПараметр("Профиль", Профиль);
		
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаSku = РезультатЗапроса.Выбрать();
	
	МассивSku = Новый Массив;
	
	Результат = Новый ТаблицаЗначений;
	Результат.Колонки.Добавить("ВариацияAli");
	Результат.Колонки.Добавить("sku_id");
	Результат.Колонки.Добавить("Остаток");
	
	Пока ВыборкаSku.Следующий() Цикл
	
		НоваяСтрока = Результат.Добавить();
		НоваяСтрока.ВариацияAli = ВыборкаSku.Ссылка;
		НоваяСтрока.sku_id = ВыборкаSku.sku_id;
		
		МассивSku.Добавить(Новый Структура("sku", ВыборкаSku.sku_id));
	
	КонецЦикла;
				
	ОстаткиТоваров = ИС_АЛИ_API.ПолучитьОстаткиТовара(Профиль, ПараметрыЗапроса, МассивSku);
	
	Если ОстаткиТоваров = Неопределено Тогда
		Возврат Результат;
	КонецЕсли;
				
	Для Каждого Элемент Из ОстаткиТоваров.skus_info Цикл
	    	    
    	НайденныеСтроки = Результат.НайтиСтроки(Новый Структура("sku_id", Элемент.sku));
		НайденныеСтроки[0].Остаток = Число(Элемент.max_sellable_quantity);
	    	
	КонецЦикла;	
                							
	Возврат Результат;
	
КонецФункции //- ИнфоСофт Ивонин К.А. 15.03.24 УА #71892

//+ ИнфоСофт Ивонин К.А. 01.04.24 УА #71892
Функция ПолучитьИнформациюОСкладе(Склад) Экспорт

	ЗапросСклада = Новый Запрос;
	ЗапросСклада.Текст = 
	"ВЫБРАТЬ
	|	ИС_Али_Склады.Ссылка КАК Ссылка,
	|	ИС_Али_Склады.ВыгружатьОстаткиИзГруппыСкладов КАК ВыгружатьОстаткиИзГруппыСкладов,
	|	ИС_Али_Склады.Склад КАК Склад,
	|	ИС_Али_Склады.ОбщаяГруппаСкладов КАК ОбщаяГруппаСкладов,
	|	ИС_Али_СкладыГруппаСкладов.Склад КАК СкладГруппы
	|ИЗ
	|	Справочник.ИС_Али_Склады КАК ИС_Али_Склады
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ИС_Али_Склады.ГруппаСкладов КАК ИС_Али_СкладыГруппаСкладов
	|		ПО ИС_Али_Склады.Ссылка = ИС_Али_СкладыГруппаСкладов.Ссылка
	|ГДЕ
	|	ИС_Али_Склады.Ссылка = &Ссылка
	|ИТОГИ ПО
	|	Ссылка";
	
	ЗапросСклада.УстановитьПараметр("Ссылка", Склад);
	
	РезультатЗапроса = ЗапросСклада.Выполнить();
	
	ВыборкаСклад = РезультатЗапроса.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	Результат = "";
		
	Пока ВыборкаСклад.Следующий() Цикл				
				
		Если ВыборкаСклад.ВыгружатьОстаткиИзГруппыСкладов Тогда 
		    
		    Результат = Результат + "Группа складов: " + Символы.ПС;
		    
			ВыборкаГруппаСкладов = ВыборкаСклад.Выбрать();
		
			Пока ВыборкаГруппаСкладов.Следующий() Цикл
			
				Если ВыборкаГруппаСкладов.СкладГруппы <> Null Тогда
			    	Результат = Результат + Символы.Таб + " - " + ВыборкаГруппаСкладов.СкладГруппы + Символы.ПС;
			    КонецЕсли;
			    
			КонецЦикла;				
		
		ИначеЕсли ЗначениеЗаполнено(ВыборкаСклад.ОбщаяГруппаСкладов) Тогда
			Результат = Результат + "Общая группа складов: " + ВыборкаСклад.ОбщаяГруппаСкладов + Символы.ПС;
		Иначе
			Результат = Результат + "Склад: " + ВыборкаСклад.Склад + Символы.ПС;		
		КонецЕсли;
	
	КонецЦикла;
    
    Возврат Результат;

КонецФункции //- ИнфоСофт Ивонин К.А. 01.04.24 УА #71892

//+ ИнфоСофт Мурсалимов Д.Р. 12.05.24 УА #66901
Функция ПолучитьЦеныFBS(Профиль) Экспорт
	
	НастройкиСоединения = ПолучитьНастройкиСоединенияПрофиля(Профиль);	
	ПараметрыЗапроса = ПроверитьИЗаполнитьПараметрыЗапроса(НастройкиСоединения);
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ИС_АЛИ_Вариации.Ссылка КАК Ссылка,
	|	ИС_АЛИ_Вариации.Владелец.Код КАК product_id,
	|	ИС_АЛИ_Вариации.sku_id КАК sku_id
	|ИЗ
	|	Справочник.ИС_АЛИ_Вариации КАК ИС_АЛИ_Вариации
	|ГДЕ
	|	ИС_АЛИ_Вариации.Профиль = &Профиль
	|	И НЕ ИС_АЛИ_Вариации.sku_id = """"
	|	И НЕ ИС_АЛИ_Вариации.ПометкаУдаления";
	
	Запрос.УстановитьПараметр("Профиль", Профиль);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаProductId = РезультатЗапроса.Выбрать();
	
	МассивProductId = Новый Массив;
	
	Результат = Новый ТаблицаЗначений;
	Результат.Колонки.Добавить("ВариацияAli");
	Результат.Колонки.Добавить("product_id");
	Результат.Колонки.Добавить("sku_id");
	Результат.Колонки.Добавить("Цена");
	Результат.Колонки.Добавить("ЦенаСоСкидкой");
	
	Пока ВыборкаProductId.Следующий() Цикл
		
		НоваяСтрока = Результат.Добавить();
		НоваяСтрока.ВариацияAli = ВыборкаProductId.Ссылка;
		НоваяСтрока.product_id = ВыборкаProductId.product_id;
		НоваяСтрока.sku_id = ВыборкаProductId.sku_id;
		
		МассивProductId.Добавить(Новый Структура("product_id", ВыборкаProductId.product_id));
		
	КонецЦикла;
	
	Для Каждого Элемент Из МассивProductId Цикл
		
		ЦеныТоваров = ИС_АЛИ_API.ПолучитьДанныеОТоваре(Профиль, ПараметрыЗапроса, Элемент);
		
		Если ЦеныТоваров = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		Для Каждого Элемент Из ЦеныТоваров.sku Цикл
			
			НайденныеСтроки = Результат.НайтиСтроки(Новый Структура("sku_id", Элемент.sku_id));
			
			Если НайденныеСтроки.Количество() > 0 Тогда
				
				НайденныеСтроки[0].Цена 			= Элемент.price;
				НайденныеСтроки[0].ЦенаСоСкидкой 	= Элемент.discount_price;
				
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции //- ИнфоСофт Мурсалимов Д.Р. 12.05.24 УА #66901

//+ ИнфоСофт Мурсалимов Д.Р. 03.05.24 УА #66901
Процедура УстановитьПараметрыЗапросаЦен(Запрос, Профиль) Экспорт
	
