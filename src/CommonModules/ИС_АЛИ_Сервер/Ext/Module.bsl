//+ ИнфоСофт Стояк Ю.К. 13.05.2024 УА #62574
Процедура СозданиеКТ(Профиль, Тело) Экспорт  
	
	Событие = "ИС_АЛИ_СозданиеКТ";
	
	Если Не ЗначениеЗаполнено(Профиль) Тогда
		ОбщегоНазначения.СообщитьПользователю("Не заполнен Профиль. Выгрузка остатков невозможна");
		Возврат;
	КонецЕсли;	
	
	ПараметрыСоединения = Неопределено;
	Если Не ПолучитьПараметрыСоединения(Профиль, ПараметрыСоединения) Тогда
		Возврат;
	КонецЕсли;
	
	Заголовки = Неопределено;
	Если Не CформироватьЗаголовкиЗапроса(Заголовки, ПараметрыСоединения) Тогда
		Возврат;
	КонецЕсли;
	
	ПараметрыЗапроса = ИС_MP_РаботаСHTTPЗапросамиСервер.ПолучитьСтруктуруHTTPЗапроса();
	ПараметрыЗапроса.Сервер = ПараметрыСоединения.АдресСервиса;
	ПараметрыЗапроса.Порт = ПараметрыСоединения.Порт;
	ПараметрыЗапроса.ЗащищенноеСоединение = ПараметрыСоединения.ЗащищенноеСоединение;
	ПараметрыЗапроса.Заголовки.Вставить("x-auth-token", Заголовки["x-auth-token"]);  
			
	РазбитыйМассив = ИС_MP_Сервер.РазбитьМассивПоNЭлементов(Тело, 1000);
	Ошибка = Ложь;
	
	Для Каждого Элемент Из РазбитыйМассив Цикл
				
		products = Новый Структура;			
		products.Вставить("products", Элемент);
		
		ПараметрыЗапроса.ТелоСтрока = ИС_MP_РаботаСHTTPЗапросамиСервер.ПолучитьСтрокуJSON(products);
		
		Результат = ИС_АЛИ_API.СоздатьКТ(Профиль, ПараметрыЗапроса);
		
		Если ЗначениеЗаполнено(Результат) Тогда	
			//+ ИнфоСофт Стояк Ю.К. 17.02.2025 УА #93751			
			//ОбщегоНазначения.СообщитьПользователю("Выгрузка прошла со следующим статусом:" + Результат.ok);	
			Если Результат.Количество() > 0 Тогда
				ОбщегоНазначения.СообщитьПользователю("Выгрузка прошла со следующим статусом:" + Результат[0].ok);	
			КонецЕсли;
			//- ИнфоСофт Стояк Ю.К. 17.02.2025 УА #93751
			//+ ИнфоСофт Заварин К.В. 16.04.25 УА #98617
			//ОбщегоНазначения.СообщитьПользователю("Номер задания на создание КТ:" + Результат.task_id); 
			ОбщегоНазначения.СообщитьПользователю("Номер задания на создание КТ:" + Результат[0].task_id);
			//- ИнфоСофт Заварин К.В. 16.04.25 УА #98617	
		Иначе			
			ЗаписьЖурналаРегистрации("Не удалось создать КТ!", УровеньЖурналаРегистрации.Ошибка);			
		КонецЕсли; 		
		
	КонецЦикла; 
	
