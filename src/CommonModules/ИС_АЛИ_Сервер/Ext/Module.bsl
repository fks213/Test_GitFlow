//+ ИнфоСофт Ивонин К.А. 09.03.24 УА #66733
Функция ПроверитьИЗаполнитьПараметрыЗапроса(НастройкиСоединения)
    
   	Если Не ЗначениеЗаполнено(НастройкиСоединения["АлиАдресСервисаAPI"]) Тогда
		ВызватьИсключение("Для данного профиля не заполнен ""Адрес Сервиса API"" Алиэкспресс, проверьте настройки авторизации");
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(НастройкиСоединения["АлиТокен"]) Тогда
		ВызватьИсключение("Для данного профиля не заполнен ""Токен"" Алиэкспресс, проверьте настройки авторизации");
	КонецЕсли;

	ПараметрыЗапроса = ИС_MP_РаботаСHTTPЗапросамиСервер.ПолучитьСтруктуруHTTPЗапроса();
		
	ПараметрыЗапроса.Сервер = НастройкиСоединения["АлиАдресСервисаAPI"];
	
	//ПараметрыЗапроса.Порт = НастройкиСоединения.Порт;
	//ПараметрыЗапроса.ЗащищенноеСоединение = НастройкиСоединения.ЗащищенноеСоединение;
	ПараметрыЗапроса.Порт = 443;
	ПараметрыЗапроса.ЗащищенноеСоединение = Истина;
	
	ПараметрыЗапроса.Заголовки.Вставить("x-auth-token", НастройкиСоединения["АлиТокен"]);
	ПараметрыЗапроса.Заголовки.Вставить("x-request-locale", "ru_RU");
	
	Возврат ПараметрыЗапроса;

КонецФункции //- ИнфоСофт Ивонин К.А. 09.03.24 УА #66733

//+ ИнфоСофт Стояк Ю.К. 20.01.2023 УА #52524
Функция ПолучитьПараметрыСоединения(Профиль, ПараметрыСоединения)

	Событие = "ПолучитьПараметрыСоединенияАли";
	
	МассивНаименованийПараметров = Новый Массив;  
		
	МассивНаименованийПараметров.Добавить("АлиТокен");
	МассивНаименованийПараметров.Добавить("АлиАдресСервисаAPI");
	
	ПараметрыСоединения = Новый Структура;
	
	Настройки = ИС_MP_Сервер.ПолучитьНастройки(Профиль, МассивНаименованийПараметров);
	
	Если Настройки = Неопределено Тогда
		
		Текст = "Параметры соединения не установлены";
		ЗаписьЖурналаРегистрации("ИС.АЛИ." + Событие, УровеньЖурналаРегистрации.Ошибка, , , Текст);
		ОбщегоНазначения.СообщитьПользователю(Текст);
		Возврат Ложь;
		
	КонецЕсли;
					
	Если Настройки["АлиАдресСервисаAPI"] <> Неопределено Тогда
		ПараметрыСоединения.Вставить("АдресСервиса", Настройки["АлиАдресСервисаAPI"]);
	Иначе
		
