//+ ИнфоСофт Стояк Ю.К. 28.02.2024 УА #56408
Функция ПолучитьСписокЗаказов(Профиль, ДатаПоследнегоОтправления) Экспорт                        
	
	Если Не ЗначениеЗаполнено(Профиль) Тогда
		ОбщегоНазначения.СообщитьПользователю("Не выбран Профиль. Загрузка товаров невозможна");
		Возврат Неопределено;
	КонецЕсли;
	
	ПараметрыСоединения = Неопределено;
	Если Не ПолучитьПараметрыСоединения(Профиль, ПараметрыСоединения) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Заголовки = Неопределено;
	Если Не CформироватьЗаголовкиЗапроса(Заголовки, ПараметрыСоединения) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	ПараметрыЗапроса = ИС_MP_РаботаСHTTPЗапросамиСервер.ПолучитьСтруктуруHTTPЗапроса();
	ПараметрыЗапроса.Сервер = ПараметрыСоединения.АдресСервиса;
	ПараметрыЗапроса.Порт = ПараметрыСоединения.Порт;
	ПараметрыЗапроса.ЗащищенноеСоединение = ПараметрыСоединения.ЗащищенноеСоединение;
	ПараметрыЗапроса.Заголовки = Заголовки;
	
	КодСтраницы = 1;
	КоличествоЭлементовНаСтранице = 50;
	ПределОшибок = 10;
	КоличествоОшибок = 0;   
	ОсталосьЭлементов = Неопределено; 
	
	rawData = Новый Структура;
	rawData.Вставить("date_start", ИС_MP_РаботаСHTTPЗапросамиСервер.ЗаписатьДатуВJSON(ДатаПоследнегоОтправления, ФорматДатыJSON.ISO
		, ВариантЗаписиДатыJSON.УниверсальнаяДата));
	rawData.Вставить("page_size", КоличествоЭлементовНаСтранице);
	rawData.Вставить("page", КодСтраницы);
	rawData.Вставить("trade_order_info", "LogisticInfo");
	
	МассивЗагруженныхЗаданий = Новый Массив;
	
	Пока Истина Цикл	                                         
				
		Если КоличествоОшибок >= ПределОшибок Тогда
			Возврат Неопределено;
		КонецЕсли;
		
		Результат = ИС_АЛИ_API.ПолучитьСписокЗаказов(Профиль, ПараметрыЗапроса, rawData); 
		
		Если Результат = Неопределено Тогда
			КоличествоОшибок = КоличествоОшибок + 1;
			Продолжить;
		КонецЕсли;
		
		Если Не ЗначениеЗаполнено(ОсталосьЭлементов) Тогда
			ОсталосьЭлементов = Результат["total_count"];
		КонецЕсли;
		
		Для Каждого Элемент Из Результат["orders"] Цикл
			СсылкаЗадания = СоздатьИлиОбновитьЗаказ(Профиль, Элемент, ДатаПоследнегоОтправления);	
			
			Если Не СсылкаЗадания.Пустая() Тогда
				МассивЗагруженныхЗаданий.Добавить(СсылкаЗадания);	
				ОбновитьСтатусыЗаказов(Профиль, СсылкаЗадания, Элемент); 
			КонецЕсли;
		КонецЦикла;    
		
		ОсталосьЭлементов = ОсталосьЭлементов - КоличествоЭлементовНаСтранице;
		
		Если ОсталосьЭлементов <= 0 Тогда
			Прервать;
		КонецЕсли;
				
	КонецЦикла;
	
	ПроверитьФункциональныеОпцииОтправлений(Профиль, МассивЗагруженныхЗаданий);
	
КонецФункции //- ИнфоСофт Стояк Ю.К. 28.02.2024 УА #56408

//+ ИнфоСофт Стояк Ю.К. 28.02.2024 УА #56408
Функция СоздатьИлиОбновитьЗаказ(Профиль, Данные, ДатаПоследнегоОтправления)

    Событие = ПолучитьИмяСобытия("СоздатьИлиОбновитьЗаказ");
	
	Заказ = Документы.ИС_АЛИ_Заказ.НайтиПоНомеру(Данные["id"]);
	
	Если Заказ.Пустая() Тогда
		Заказ = Документы.ИС_АЛИ_Заказ.СоздатьДокумент();			
	Иначе
		Заказ = Заказ.ПолучитьОбъект();
	КонецЕсли;		
	
	Заказ.Профиль = Профиль;
	Заказ.Номер = Данные["id"];
		
	Заказ.Дата = ИС_MP_РаботаСHTTPЗапросамиСервер.ПрочитатьДатуИзJSON(Данные["created_at"], ФорматДатыJSON.ISO);			
	
	Заказ.total_amount = Данные["total_amount"] / 100;
	Заказ.delivery_address = Данные["delivery_address"];
	
	Заказ.buyer_country_code = Данные["buyer_country_code"];
	Заказ.buyer_name = Данные["buyer_name"];
	Заказ.buyer_phone = Данные["buyer_phone"];
		
	Заказ.order_lines.Очистить();
		
	Для Каждого Элемент Из Данные["order_lines"] Цикл	
		
		НоваяСтрока = Заказ.order_lines.Добавить();  
		
		НоваяСтрока.id = Элемент["id"];
		НоваяСтрока.item_id = Элемент["item_id"];
		НоваяСтрока.product_source_id = Элемент["product_source_id"];
		НоваяСтрока.sku_id = Элемент["sku_id"];
		НоваяСтрока.sku_code = Элемент["sku_code"];
		НоваяСтрока.quantity = Элемент["quantity"];
		
		НоваяСтрока.total_amount = Элемент["total_amount"] / 100;
		НоваяСтрока.item_price = Элемент["item_price"] / 100;
		
		НоваяСтрока.buyer_comment = Элемент["buyer_comment"];
		НоваяСтрока.discount_currency = Элемент["discount_currency"];
		НоваяСтрока.original_discount = Элемент["original_discount"];
						
		НоваяСтрока.ВариацияАли = Справочники.ИС_АЛИ_Вариации.НайтиПоРеквизиту("sku_id", Элемент["sku_id"]); 
		
		Если ЗначениеЗаполнено(НоваяСтрока.ВариацияАли) Тогда
			НоваяСтрока.НоменклатураАли = НоваяСтрока.ВариацияАли.Владелец;
		КонецЕсли;
				
	КонецЦикла; 
	
	Если Данные["pre_split_postings"] <> Неопределено Тогда 
		
		Заказ.pre_split_postings.Очистить();
			
		Для Каждого Отправление Из Данные["pre_split_postings"] Цикл
						
			Для Каждого Элемент Из Отправление["posting_lines"] Цикл  
				
				НоваяСтрока = Заказ.pre_split_postings.Добавить(); 
				
				ЗаполнитьЗначенияСвойств(НоваяСтрока, Элемент);
				
				НоваяСтрока.id = Отправление["id"];
				НоваяСтрока.item_id = Элемент["item_id"];
				НоваяСтрока.product_source_id = Элемент["product_source_id"];
				НоваяСтрока.sku_id = Элемент["sku_id"];
				НоваяСтрока.num_id = Элемент["id"];
				НоваяСтрока.quantity = Элемент["quantity"];
				НоваяСтрока.order_line_id = Элемент["order_line_id"];
				НоваяСтрока.item_price = Элемент["item_price"] / 100;
				НоваяСтрока.logistics_type = Отправление["logistics_type"];
				
				НоваяСтрока.weight = Элемент["weight"];
				НоваяСтрока.height = Элемент["height"];
				НоваяСтрока.width = Элемент["width"];
				НоваяСтрока.length = Элемент["length"];
				
				НоваяСтрока.ВариацияАли = Справочники.ИС_АЛИ_Вариации.НайтиПоРеквизиту("sku_id", Элемент["sku_id"]); 
				
				Если ЗначениеЗаполнено(НоваяСтрока.ВариацияАли) Тогда
					НоваяСтрока.НоменклатураАли = НоваяСтрока.ВариацияАли.Владелец;
				КонецЕсли;  
				
			КонецЦикла;
			
		КонецЦикла;

	КонецЕсли;
		
	Попытка	      
		
		Заказ.Записать(РежимЗаписиДокумента.Запись);
		ДатаПоследнегоОтправления = Заказ.Дата;
		
		Возврат Заказ.Ссылка;		
		
	Исключение
		
		ИнформацияОбОшибке = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
		Текст = СтрШаблон("Произошла ошибка при записи элемента Заказ Aliexpress: %1",	ИнформацияОбОшибке);
		ИС_MP_Сервер.ЗаписатьВЖРИСообщитьПользователю(Событие, Текст);
		
	КонецПопытки;
	
	Возврат Документы.ИС_АЛИ_Заказ.ПустаяСсылка();
	
КонецФункции //- ИнфоСофт Стояк Ю.К. 28.02.2024 УА #56408

//+ ИнфоСофт Стояк Ю.К. 28.02.2024 УА #56408
Процедура ОбновитьСтатусыЗаказов(Профиль, Заказ, Данные)
	
	Событие = ПолучитьИмяСобытия("СоздатьИлиОбновитьСтатус");
	
	Если Заказ = Документы.ИС_АЛИ_Заказ.ПустаяСсылка() Тогда
		Возврат;
	КонецЕсли; 
	
	МенеджерЗаписи = РегистрыСведений.ИС_АЛИ_СтатусыСборочныхЗаданий.СоздатьМенеджерЗаписи();
	МенеджерЗаписи.Профиль = Профиль;
	МенеджерЗаписи.Заказ = Заказ;
	
	МенеджерЗаписи.Прочитать();
	
	МенеджерЗаписи.Профиль = Профиль;
	МенеджерЗаписи.Заказ = Заказ;
	
	МенеджерЗаписи.status = Перечисления.ИС_АЛИ_СтатусыЗаказов[Данные["status"]];
	МенеджерЗаписи.payment_status = Перечисления.ИС_АЛИ_СтатусыОплаты[Данные["payment_status"]];
	МенеджерЗаписи.delivery_status = Перечисления.ИС_АЛИ_СтатусыДоставки[Данные["delivery_status"]];
	МенеджерЗаписи.order_display_status = Перечисления.ИС_АЛИ_СтатусыЗаказовПродавца[Данные["order_display_status"]]; 
	
	Если ЗначениеЗаполнено(Данные["cut_off_date"]) Тогда
		МенеджерЗаписи.cut_off_date = ИС_MP_РаботаСHTTPЗапросамиСервер.ПрочитатьДатуИзJSON(Данные["cut_off_date"], ФорматДатыJSON.ISO);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Данные["shipping_deadline"]) Тогда
		МенеджерЗаписи.shipping_deadline = ИС_MP_РаботаСHTTPЗапросамиСервер.ПрочитатьДатуИзJSON(Данные["shipping_deadline"], ФорматДатыJSON.ISO);
	КонецЕсли;
	
	Попытка
		МенеджерЗаписи.Записать(Истина);	
	Исключение
		Текст = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
		ИС_MP_Сервер.ЗаписатьВЖРИСообщитьПользователю(Событие, Текст);
	КонецПопытки;
	
КонецПроцедуры //- ИнфоСофт Стояк Ю.К. 28.02.2024 УА #56408

//+ ИнфоСофт Стояк Ю.К. 28.02.2024 УА #56408
Процедура ПолучитьСтатусы(Профиль) Экспорт                        
	
	Если Не ЗначениеЗаполнено(Профиль) Тогда
		ОбщегоНазначения.СообщитьПользователю("Не выбран Профиль. Загрузка товаров невозможна");
		Возврат;
	КонецЕсли;
	
	ПараметрыСоединения = Неопределено;
	Если Не ПолучитьПараметрыСоединения(Профиль, ПараметрыСоединения) Тогда
		Возврат;
	КонецЕсли;
	
	Заголовки = Неопределено;
	Если Не CформироватьЗаголовкиЗапроса(Заголовки, ПараметрыСоединения) Тогда
		Возврат;
	КонецЕсли;  
	
	//МассивСтатусов = Новый Массив;
	//МассивСтатусов.Добавить(Перечисления.ИС_АЛИ_СтатусыЗаказов.Created);
	//МассивСтатусов.Добавить(Перечисления.ИС_АЛИ_СтатусыЗаказов.InProgress); 
	//МассивСтатусов.Добавить(Перечисления.ИС_АЛИ_СтатусыЗаказов.ПустаяСсылка());
	
	Запрос = Новый Запрос;
	Запрос.Текст =	
	"ВЫБРАТЬ
	|	ИС_АЛИ_Заказ.Ссылка КАК Ссылка,
	|	ИС_АЛИ_Заказ.Номер КАК Номер,
	|	ЕСТЬNULL(ИС_АЛИ_СтатусыСборочныхЗаданий.status, ЗНАЧЕНИЕ(Перечисление.ИС_АЛИ_СтатусыЗаказов.ПустаяСсылка)) КАК status
	|ПОМЕСТИТЬ ВТ_Заказы
	|ИЗ
	|	Документ.ИС_АЛИ_Заказ КАК ИС_АЛИ_Заказ
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ИС_АЛИ_СтатусыСборочныхЗаданий КАК ИС_АЛИ_СтатусыСборочныхЗаданий
	|		ПО (ИС_АЛИ_Заказ.Ссылка = ИС_АЛИ_СтатусыСборочныхЗаданий.Заказ)
	|ГДЕ
	|	ИС_АЛИ_Заказ.Профиль = &Профиль
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_Заказы.Ссылка КАК Ссылка,
	|	ВТ_Заказы.Номер КАК Номер
	|ИЗ
	|	ВТ_Заказы КАК ВТ_Заказы
	|ГДЕ
	|	ВТ_Заказы.status <> ЗНАЧЕНИЕ(Перечисление.ИС_АЛИ_СтатусыЗаказов.Cancelled)
	|	И ВТ_Заказы.status <> ЗНАЧЕНИЕ(Перечисление.ИС_АЛИ_СтатусыЗаказов.Finished)";
	
	//Запрос.УстановитьПараметр("status", МассивСтатусов);
	Запрос.УстановитьПараметр("Профиль", Профиль);
	
	РезультатЗапроса = Запрос.Выполнить();   
	
	Если РезультатЗапроса.Пустой() Тогда
		Возврат;
	КонецЕсли;

	Отправления = РезультатЗапроса.Выгрузить();
	
	ПараметрыЗапроса = ИС_MP_РаботаСHTTPЗапросамиСервер.ПолучитьСтруктуруHTTPЗапроса();
	ПараметрыЗапроса.Сервер = ПараметрыСоединения.АдресСервиса;
	ПараметрыЗапроса.Порт = ПараметрыСоединения.Порт;
	ПараметрыЗапроса.ЗащищенноеСоединение = ПараметрыСоединения.ЗащищенноеСоединение;
	ПараметрыЗапроса.Заголовки = Заголовки;
	
	КодСтраницы = 1;
	КоличествоЭлементовНаСтранице = 50;
	ПределОшибок = 10;
	КоличествоОшибок = 0;   
	ОсталосьЭлементов = Неопределено; 
	
	rawData = Новый Структура;
	rawData.Вставить("page_size", КоличествоЭлементовНаСтранице);
	rawData.Вставить("page", КодСтраницы);
	rawData.Вставить("order_ids", Отправления.ВыгрузитьКолонку("Номер"));
	rawData.Вставить("trade_order_info", "LogisticInfo");
	
	СтруктураПоиска = Новый Структура("Номер", "0");
	
	Пока Истина Цикл	                                         
				
		Если КоличествоОшибок >= ПределОшибок Тогда
			Возврат;
		КонецЕсли;
		
		Результат = ИС_АЛИ_API.ПолучитьСписокЗаказов(Профиль, ПараметрыЗапроса, rawData); 
		
		Если Результат = Неопределено Тогда
			КоличествоОшибок = КоличествоОшибок + 1;
			Продолжить;
		КонецЕсли;
		
		Если Не ЗначениеЗаполнено(ОсталосьЭлементов) Тогда
			ОсталосьЭлементов = Результат["total_count"];
		КонецЕсли;
		
		Для Каждого Элемент Из Результат["orders"] Цикл
			
			СтруктураПоиска.Номер = Элемент["id"];
			НайденныеСтроки = Отправления.НайтиСтроки(СтруктураПоиска);
			
			Если НайденныеСтроки.Количество() = 0 Тогда
				Продолжить;
			КонецЕсли;           
			
			ОбновитьСтатусыЗаказов(Профиль, НайденныеСтроки[0].Ссылка, Элемент); 
			
		КонецЦикла;    
		
		ОсталосьЭлементов = ОсталосьЭлементов - КоличествоЭлементовНаСтранице;
		
		Если ОсталосьЭлементов <= 0 Тогда
			Прервать;
		КонецЕсли;
				
	КонецЦикла;	
	
КонецПроцедуры //- ИнфоСофт Стояк Ю.К. 28.02.2024 УА #56408

//+ ИнфоСофт Стояк Ю.К. 04.03.2024 УА #56408
Процедура СоздатьЗаказы(Профиль, МассивЗаданий) Экспорт  
	
	Событие = ПолучитьИмяСобытия("СоздатьЗаказы");
                                                    
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ИС_АЛИ_Заказ.Ссылка КАК Ссылка,
	|	ИС_АЛИ_Заказ.Номер КАК Номер,
	|	ИС_АЛИ_Заказ.Дата КАК Дата,
	|	ИС_АЛИ_СтатусыСборочныхЗаданий.cut_off_date КАК ДатаОтгрузки,
	|	ИС_Али_Склады.Ссылка КАК СкладМП,
	|	ИС_Али_Склады.Склад КАК Склад,
	|	ИС_Али_Склады.ОбщаяГруппаСкладов КАК ОбщаяГруппаСкладов,
	|	ИС_Али_Склады.ВыгружатьОстаткиИзГруппыСкладов КАК ВыгружатьОстаткиИзГруппыСкладов,
	|	ИС_Али_Склады.АдресДоставки КАК АдресДоставки,
	|	ИС_Али_Склады.АдресДоставкиЗначенияПолей КАК АдресДоставкиЗначенияПолей,
	|	ИС_Али_Склады.АдресДоставкиЗначение КАК АдресДоставкиЗначение,
	|	ИС_Али_Склады.СпособДоставки КАК СпособДоставки,
	|	ИС_Али_Склады.ЗонаДоставки КАК ЗонаДоставки,
	|	ИС_Али_Склады.Грузополучатель КАК Грузополучатель,
	|	ИС_Али_Склады.Грузоотправитель КАК Грузоотправитель,
	|	ИС_Али_Склады.ПеревозчикПартнер КАК ПеревозчикПартнер
	|ИЗ
	|	Документ.ИС_АЛИ_Заказ КАК ИС_АЛИ_Заказ
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ИС_АЛИ_СтатусыСборочныхЗаданий КАК ИС_АЛИ_СтатусыСборочныхЗаданий
