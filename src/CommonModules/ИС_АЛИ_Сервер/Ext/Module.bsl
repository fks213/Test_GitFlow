Процедура ПроверитьФункциональныеОпцииОтправлений(Профиль, МассивОтправлений)
	
	ФукнциональныеОпции = ПолучитьНастройкиФункциональностиСборочныхЗаданий(Профиль);
	
	Если ФукнциональныеОпции = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если ФукнциональныеОпции.АвтоматическиСоздаватьЗаказы Тогда	
		СоздатьЗаказы(Профиль, МассивОтправлений);		
	КонецЕсли;
	
	Если ФукнциональныеОпции.АвтоматическиСоздаватьРеализации 
		И ФукнциональныеОпции.РежимСозданияЗаказов <> 2 Тогда	
		СоздатьРеализации(Профиль, МассивОтправлений);		
	КонецЕсли;
	
КонецПроцедуры //- ИнфоСофт Стояк Ю.К. 04.03.2024 УА #56408

//+ ИнфоСофт Стояк Ю.К. 07.03.2024 УА #56408
Процедура ВыполнитьЗакрытиеЗаказов(Профиль)
	
	Событие = ПолучитьИмяСобытия("ВыполнитьЗакрытиеЗаказов");
		
	ФукнциональныеОпции = ПолучитьНастройкиФункциональностиСборочныхЗаданий(Профиль);
	
	Если ФукнциональныеОпции.ФормироватьЕдиныйЗаказБезРазбиения Тогда
		
		Если Не ЗначениеЗаполнено(ФукнциональныеОпции.АктивныйЗаказКлиента) Тогда
			Возврат;
		КонецЕсли;
		
		МассивЗаданий = Новый Массив;
		МассивЗаданий.Добавить(ФукнциональныеОпции.АктивныйЗаказКлиента);
		
		Если ФукнциональныеОпции.АвтоматическиСоздаватьРеализации Тогда
			СоздатьРеализации(Профиль, МассивЗаданий);  
		КонецЕсли;
		
		СоответствиеПараметровЗаписи = Новый Соответствие;
		СоответствиеПараметровЗаписи.Вставить("АктивныйЗаказКлиентаАли", Документы.ЗаказКлиента.ПустаяСсылка());
		ИС_MP_Сервер.ЗаписатьНастройкиСправочника(Профиль.Ссылка, СоответствиеПараметровЗаписи); 
		
		Возврат;  
		
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ИС_АЛИ_ЗаказыВТеченииДня.Профиль КАК Профиль,
	|	ИС_АЛИ_ЗаказыВТеченииДня.ЗаказКлиента КАК ЗаказКлиента,
	|	ИС_АЛИ_ЗаказыВТеченииДня.ДатаОтгрузки КАК ДатаОтгрузки,
	|	ИС_АЛИ_ЗаказыВТеченииДня.ЗаказКлиента.Комментарий КАК Комментарий
	|ИЗ
	|	РегистрСведений.ИС_АЛИ_ЗаказыВТеченииДня КАК ИС_АЛИ_ЗаказыВТеченииДня
	|ГДЕ
	|	ИС_АЛИ_ЗаказыВТеченииДня.Профиль = &Профиль
	|	И ИС_АЛИ_ЗаказыВТеченииДня.ЗаказОткрыт";
	
	Запрос.УстановитьПараметр("Профиль", Профиль);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Выборка = РезультатЗапроса.Выбрать();
	
	Комиссия25 = ФукнциональныеОпции.Договор.КомиссионныеПродажи25;
	
	Пока Выборка.Следующий() Цикл
		
		МенеджерЗаписи = РегистрыСведений.ИС_АЛИ_ЗаказыВТеченииДня.СоздатьМенеджерЗаписи(); 
		
		МенеджерЗаписи.Профиль = Выборка.Профиль;
		МенеджерЗаписи.ЗаказКлиента = Выборка.ЗаказКлиента;
		МенеджерЗаписи.ДатаОтгрузки = Выборка.ДатаОтгрузки;
		
		МенеджерЗаписи.ЗаказОткрыт = Ложь;
		
		МенеджерЗаписи.Записать();
		
		Если Комиссия25 Тогда
			ДокументРеализация = Документы.ПередачаТоваровХранителю.СоздатьДокумент();	
		Иначе
			ДокументРеализация = Документы.РеализацияТоваровУслуг.СоздатьДокумент();
		КонецЕсли;	
		
		Попытка
			//+ ИнфоСофт Стояк Ю.К. 24.06.2024 УА #78102			
			//ДокументРеализация.Заполнить(Выборка.Заказ); 
			ДокументРеализация.Заполнить(Выборка.ЗаказКлиента); 
		Исключение
			//Продолжить;
			Текст = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
			ИС_MP_Сервер.ЗаписатьВЖРИСообщитьПользователю(Событие, Текст);
			//- ИнфоСофт Стояк Ю.К. 24.06.2024 УА #78102
		КонецПопытки;
		
		ДокументРеализация.Дата = Выборка.ДатаОтгрузки;
		ДокументРеализация.Комментарий = Выборка.Комментарий;
		
		Если ЗначениеЗаполнено(ФукнциональныеОпции.Подразделение) Тогда  
			ДокументРеализация.Подразделение = ФукнциональныеОпции.Подразделение;
		КонецЕсли;
		
		Если Не Комиссия25 Тогда
			ДокументРеализация.СкидкиРассчитаны = Истина;	
		КонецЕсли;
		
		ЗаписыватьДокумент = Ложь;
		Если ФукнциональныеОпции.ПроводитьРеализации Тогда
			
			Попытка
				ДокументРеализация.Записать(РежимЗаписиДокумента.Проведение);
			Исключение
				ЗаписыватьДокумент = Истина;
				Текст = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
				ИС_MP_Сервер.ЗаписатьВЖРИСообщитьПользователю(Событие, Текст);
			КонецПопытки;
			
		Иначе
			ЗаписыватьДокумент = Истина;	
		КонецЕсли;
		
		Если ЗаписыватьДокумент Тогда	
			
			Попытка
				ДокументРеализация.Записать();			
			Исключение
				Текст = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
				ИС_MP_Сервер.ЗаписатьВЖРИСообщитьПользователю(Событие, Текст);
			КонецПопытки;
		
		КонецЕсли;
		
	КонецЦикла;
		
КонецПроцедуры //- ИнфоСофт Стояк Ю.К. 07.03.2024 УА #56408

