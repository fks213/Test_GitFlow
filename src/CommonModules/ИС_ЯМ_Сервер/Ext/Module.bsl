//+ ИнфоСофт Стояк Ю.К. 06.02.2023 УА #54628
Функция ПолучитьСписокЦен(Профиль) Экспорт
			
	НастройкиСоединения = ПолучитьНастройкиСоединенияПрофиля(Профиль);	
	ПараметрыЗапроса = ПроверитьИЗаполнитьПараметрыЗапроса(НастройкиСоединения);
	
	СтруктураПараметров = Новый Структура;
	СтруктураПараметров.Вставить("businessId", СтрЗаменить(Строка(НастройкиСоединения["ЯМКодБизнеса"]), Символы.НПП, ""));
		
	ТаблицаЦен = Новый ТаблицаЗначений;   
	
	//+ ИнфоСофт Стояк Ю.К. 11.08.2023 УА #61971	
	МассивSKU = Новый Массив;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ИС_ЯМ_Номенклатура.shopSku КАК shopSku
	|ИЗ
	|	Справочник.ИС_ЯМ_Номенклатура КАК ИС_ЯМ_Номенклатура
	|ГДЕ
	|	ИС_ЯМ_Номенклатура.Профиль = &Профиль
	|	И НЕ ИС_ЯМ_Номенклатура.shopSku ЕСТЬ NULL";
	
	Запрос.УстановитьПараметр("Профиль", Профиль);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		МассивSKU.Добавить(Строка(ВыборкаДетальныеЗаписи.shopSku));
	КонецЦикла;  
	//- ИнфоСофт Стояк Ю.К. 11.08.2023 УА #61971
	
	КвалификаторыЧисла = Новый КвалификаторыЧисла(20, 2, ДопустимыйЗнак.Неотрицательный);
	КвалификаторыСтроки = Новый КвалификаторыСтроки(80);
	
	//ТаблицаЦен.Колонки.Добавить("id", Новый ОписаниеТипов("Строка",КвалификаторыСтроки));
	ТаблицаЦен.Колонки.Добавить("shopSku", Новый ОписаниеТипов("Строка",КвалификаторыСтроки));
	ТаблицаЦен.Колонки.Добавить("discountBase", Новый ОписаниеТипов("Число", КвалификаторыЧисла));
	ТаблицаЦен.Колонки.Добавить("value", Новый ОписаниеТипов("Число", КвалификаторыЧисла)); 
			
	РазбитыйМассив = ИС_MP_Сервер.РазбитьМассивПоNЭлементов(МассивSKU, 200); 
	
	Для Каждого Элемент Из РазбитыйМассив Цикл 
		
		ТелоЗапроса = Новый Структура;
		ТелоЗапроса.Вставить("offerIds", Элемент);
	
		Результат = ИС_ЯМ_API.ЗагрузитьКарточкиТоваров(Профиль, ПараметрыЗапроса, СтруктураПараметров, ТелоЗапроса); 
		
		Если Результат = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		Для Каждого Элемент Из Результат.offerMappings Цикл	
			
			Если Элемент.Свойство("offer") Тогда 
				Оффер = Элемент.offer;
			Иначе
				Продолжить;
			КонецЕсли; 
			
			Если Оффер.Свойство("basicPrice") Тогда 
				Цены = Оффер.basicPrice;
			Иначе
				Продолжить;
			КонецЕсли; 
			
			НоваяСтрока = ТаблицаЦен.Добавить();
			НоваяСтрока.shopSku = Оффер.offerId; 
			
			Если Цены.Свойство("discountBase") Тогда 
				НоваяСтрока.discountBase = Цены.discountBase;
			КонецЕсли;  
			
			Если Цены.Свойство("value") Тогда 
				НоваяСтрока.value = Цены.value;
			КонецЕсли;			
			
		КонецЦикла;
		
	КонецЦикла;
	
	Возврат ТаблицаЦен;
	
КонецФункции //+ ИнфоСофт Стояк Ю.К. 06.02.2023 УА #54628

//+ ИнфоСофт Стояк Ю.К. 02.07.2023 УА #59330
Функция ПолучитьОстатки(Профиль, КампанияID = Неопределено) Экспорт
	
	НастройкиСоединения = ПолучитьНастройкиСоединенияПрофиля(Профиль);	
	ПараметрыЗапроса = ПроверитьИЗаполнитьПараметрыЗапроса(НастройкиСоединения);
	
	МассивSKU = Новый Массив;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ИС_ЯМ_Номенклатура.shopSku КАК shopSku
	|ИЗ
	|	Справочник.ИС_ЯМ_Номенклатура КАК ИС_ЯМ_Номенклатура
	|ГДЕ
	|	ИС_ЯМ_Номенклатура.Профиль = &Профиль
	|	И НЕ ИС_ЯМ_Номенклатура.shopSku ЕСТЬ NULL";
	
	Запрос.УстановитьПараметр("Профиль", Профиль);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		МассивSKU.Добавить(Строка(ВыборкаДетальныеЗаписи.shopSku));
	КонецЦикла;
	
	Если КампанияID = Неопределено Тогда
		КампанияID = Формат(НастройкиСоединения["ЯМКампанияID"], "ЧГ=0");
	КонецЕсли;
	
	ТаблицаОстатков = Новый ТаблицаЗначений;  
	
	КвалификаторыЧисла = Новый КвалификаторыЧисла(20, 2, ДопустимыйЗнак.Неотрицательный);
	КвалификаторыСтроки = Новый КвалификаторыСтроки(80);
	
	//+ ИнфоСофт Стояк Ю.К. 11.08.2023 УА #61971		
	ТаблицаОстатков.Колонки.Добавить("Склад", Новый ОписаниеТипов("Строка",КвалификаторыСтроки));
	ТаблицаОстатков.Колонки.Добавить("shopSku", Новый ОписаниеТипов("Строка",КвалификаторыСтроки));
	//- ИнфоСофт Стояк Ю.К. 11.08.2023 УА #61971
	ТаблицаОстатков.Колонки.Добавить("stock", Новый ОписаниеТипов("Число", КвалификаторыЧисла));
	ТаблицаОстатков.Колонки.Добавить("id", Новый ОписаниеТипов("Число", КвалификаторыЧисла));	
	
	РазбитыйМассив = ИС_MP_Сервер.РазбитьМассивПоNЭлементов(МассивSKU, 500);	
	
	//+ ИнфоСофт Заварин К.В. 02.10.24 УА #79966
	Счетчик = 0;
	//- ИнфоСофт Заварин К.В. 02.10.24 УА #79966
	
	Для Каждого Элемент Из РазбитыйМассив Цикл	
		
		Результат = ИС_ЯМ_API.ПолучитьОстатки(Профиль, ПараметрыЗапроса, КампанияID, Элемент);
		
		Если ЗначениеЗаполнено(Результат) Тогда	
			
			Для Каждого Элемент Из Результат Цикл
				
				Если Не Элемент.Свойство("warehouses") Тогда
					Продолжить;
				КонецЕсли;
				
				Для Каждого Склад Из Элемент.warehouses Цикл 
					
					НоваяСтрока = ТаблицаОстатков.Добавить();
					НоваяСтрока.shopSku = Элемент.shopSku;
				   	НоваяСтрока.Склад = Склад.name; 
					НоваяСтрока.id = Склад.id;
					
					Для Каждого Остаток Из Склад.stocks Цикл 
						Если Остаток.type = "AVAILABLE" Тогда
							НоваяСтрока.stock = Остаток.count;
						КонецЕсли;
					КонецЦикла;
				КонецЦикла;  
				
			КонецЦикла;
			
		КонецЕсли; 
		
		//+ ИнфоСофт Заварин К.В. 02.10.24 УА #79966
		//+ ИнфоСофт Стояк Ю.К. 01.07.2024 УА #78595
		//Если РазбитыйМассив.Количество() > 1 Тогда
		//	ИС_MP_Сервер.Пауза(60);
		//КонецЕсли;
		//- ИнфоСофт Стояк Ю.К. 01.07.2024 УА #78595
		Счетчик = Счетчик + 1;
		
		Если Счетчик = 10 Тогда
			Счетчик = 0;
			ИС_MP_Сервер.Пауза(60);
		КонецЕсли;
		//- ИнфоСофт Заварин К.В. 02.10.24 УА #79966
						
	КонецЦикла; 
		
	Возврат ТаблицаОстатков;
	
КонецФункции //- ИнфоСофт Стояк Ю.К. 02.07.2023 УА #59330

//+ ИнфоСофт Ивонин К.А. 04.03.24 УА #66733
Функция ПолучитьТекстЗапросаОстатков() Экспорт
	
	Текст =
	"ВЫБРАТЬ
	|	ИС_ЯМ_Номенклатура.Ссылка КАК ПолеСопоставления,
	|	ИС_ЯМ_Номенклатура.shopSku КАК shopSku,
	|	ИС_ЯМ_СоответствиеХарактеристик.Номенклатура КАК Номенклатура,
	|	ИС_ЯМ_СоответствиеХарактеристик.Характеристика КАК Характеристика,
	|	ЕСТЬNULL(ИС_ЯМ_СоответствиеХарактеристик.Упаковка, &ПустаяУпаковка) КАК Упаковка,
	|	ИС_MP_ОграничениеОстатков.Остаток КАК СкрываемыйОстаток,
	|	НЕ ИС_MP_ОграничениеОстатков.Остаток ЕСТЬ NULL КАК ЕстьСкрываемыйОстаток,
	|	ИС_MP_РучныеОстатки.Остаток КАК РучнойОстаток,
	|	НЕ ИС_ЯМ_СоответствиеХарактеристик.Номенклатура ЕСТЬ NULL КАК ЕстьСопоставление,
	|	НЕ ИС_MP_РучныеОстатки.Остаток ЕСТЬ NULL КАК ЕстьРучнойОстаток,
	|	ЕСТЬNULL(ИС_ЯМ_СоответствиеХарактеристик.Номенклатура.ТипНоменклатуры, ЗНАЧЕНИЕ(Перечисление.ТипыНоменклатуры.ПустаяСсылка)) = ЗНАЧЕНИЕ(Перечисление.ТипыНоменклатуры.Набор) КАК ЭтоНабор,
	|	ВЫБОР
	|		КОГДА ИС_ЯМ_СоответствиеХарактеристик.Упаковка.Числитель = 0
	|			ТОГДА 1
	|		ИНАЧЕ ЕСТЬNULL(ИС_ЯМ_СоответствиеХарактеристик.Упаковка.Числитель, 1)
	|	КОНЕЦ / ВЫБОР
	|		КОГДА ИС_ЯМ_СоответствиеХарактеристик.Упаковка.Знаменатель = 0
	|			ТОГДА 1
	|		ИНАЧЕ ЕСТЬNULL(ИС_ЯМ_СоответствиеХарактеристик.Упаковка.Знаменатель, 1)
	|	КОНЕЦ КАК КоэффициентУпаковки,
	|	ЕСТЬNULL(ИС_MP_ПоследниеВыгруженныеОстатки.Остаток, 0) КАК ПоследнийВыгруженныйОстаток,
	|	НЕ ИС_MP_ПоследниеВыгруженныеОстатки.Остаток ЕСТЬ NULL КАК ЕстьПоследнийВыгруженныйОстаток
	|ПОМЕСТИТЬ ВТ_Сопоставление
	|ИЗ
	|	Справочник.ИС_ЯМ_Номенклатура КАК ИС_ЯМ_Номенклатура
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ИС_ЯМ_СоответствиеХарактеристик КАК ИС_ЯМ_СоответствиеХарактеристик
	|		ПО ИС_ЯМ_Номенклатура.Ссылка = ИС_ЯМ_СоответствиеХарактеристик.НоменклатураЯМ
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ИС_MP_ОграничениеОстатков КАК ИС_MP_ОграничениеОстатков
	|		ПО (ИС_MP_ОграничениеОстатков.Профиль = &Профиль)
	|			И (ИС_MP_ОграничениеОстатков.Маркетплейс = &Маркетплейс)
	|			И ((ВЫРАЗИТЬ(ИС_MP_ОграничениеОстатков.Склад КАК Справочник.ИС_ЯМ_Склады)) = &Склад)
	|			И ((ВЫРАЗИТЬ(ИС_MP_ОграничениеОстатков.КарточкаМП КАК Справочник.ИС_ЯМ_Номенклатура)) = ИС_ЯМ_Номенклатура.Ссылка)
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ИС_MP_РучныеОстатки КАК ИС_MP_РучныеОстатки
	|		ПО (ИС_MP_РучныеОстатки.Профиль = &Профиль)
	|			И (ИС_MP_РучныеОстатки.Маркетплейс = &Маркетплейс)
	|			И ((ВЫРАЗИТЬ(ИС_MP_РучныеОстатки.Склад КАК Справочник.ИС_ЯМ_Склады)) = &Склад)
	|			И ((ВЫРАЗИТЬ(ИС_MP_РучныеОстатки.КарточкаМП КАК Справочник.ИС_ЯМ_Номенклатура)) = ИС_ЯМ_Номенклатура.Ссылка)
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ИС_MP_ПоследниеВыгруженныеОстатки КАК ИС_MP_ПоследниеВыгруженныеОстатки
	|		ПО (ИС_MP_ПоследниеВыгруженныеОстатки.Профиль = &Профиль)
	|			И (ИС_MP_ПоследниеВыгруженныеОстатки.Маркетплейс = &Маркетплейс)
	|			И ((ВЫРАЗИТЬ(ИС_MP_ПоследниеВыгруженныеОстатки.Склад КАК Справочник.ИС_ЯМ_Склады)) = &Склад)
	|			И ((ВЫРАЗИТЬ(ИС_MP_ПоследниеВыгруженныеОстатки.КарточкаМП КАК Справочник.ИС_ЯМ_Номенклатура)) = ИС_ЯМ_Номенклатура.Ссылка)
	|ГДЕ
	|	ИС_ЯМ_Номенклатура.Профиль = &Профиль
	|	И НЕ ИС_ЯМ_Номенклатура.ПометкаУдаления";
	
	Текст = Текст + ";";
		
	Текст = Текст + ИС_МП_УправлениеОстатками.ТекстЗапросаОстатков();
	
	Текст = Текст +
	"ВЫБРАТЬ
	|	ВТ_Сопоставление.ПолеСопоставления КАК НоменклатураЯМ,
	|	ВТ_Сопоставление.shopSku КАК shopSku,
	|	ВТ_Сопоставление.Номенклатура КАК Номенклатура,
	|	ВТ_Сопоставление.Характеристика КАК Характеристика,
	|	ВТ_Сопоставление.Упаковка КАК Упаковка,
	|	ВТ_Остатки.Свободно КАК Свободно,
	|	ВТ_Остатки.Резерв КАК Резерв,
	|	ВЫБОР
	|		КОГДА ВТ_Сопоставление.СкрываемыйОстаток ЕСТЬ NULL
	|			ТОГДА &КоличествоСкрываемогоОстатка
	|		ИНАЧЕ ВТ_Сопоставление.СкрываемыйОстаток
	|	КОНЕЦ КАК СкрываемыйОстаток,
	|	ВТ_Сопоставление.ЕстьСкрываемыйОстаток КАК ЕстьСкрываемыйОстаток,
	|	ВТ_Сопоставление.РучнойОстаток КАК РучнойОстаток,
	|	ВТ_Сопоставление.ЕстьСопоставление КАК ЕстьСопоставление,
	|	ВТ_Сопоставление.ЕстьРучнойОстаток КАК ЕстьРучнойОстаток,
	|	МАКСИМУМ(ИС_ЯМ_Штрихкоды.Наименование) КАК Штрихкод,
	|	ВТ_Сопоставление.ПоследнийВыгруженныйОстаток КАК ПоследнийВыгруженныйОстаток,
	|	ВТ_Сопоставление.ЕстьПоследнийВыгруженныйОстаток КАК ЕстьПоследнийВыгруженныйОстаток
	|ИЗ
	|	ВТ_Сопоставление КАК ВТ_Сопоставление
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_Остатки КАК ВТ_Остатки
	|		ПО ВТ_Сопоставление.ПолеСопоставления = ВТ_Остатки.ПолеСопоставления
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ИС_ЯМ_Штрихкоды КАК ИС_ЯМ_Штрихкоды
	|		ПО (ИС_ЯМ_Штрихкоды.Профиль = &Профиль)
	|			И ВТ_Сопоставление.ПолеСопоставления = ИС_ЯМ_Штрихкоды.Владелец
	|
	|СГРУППИРОВАТЬ ПО
	|	ВТ_Сопоставление.ПолеСопоставления,
	|	ВТ_Сопоставление.shopSku,
	|	ВТ_Сопоставление.Номенклатура,
	|	ВТ_Сопоставление.ЕстьСопоставление,
	|	ВТ_Сопоставление.Характеристика,
	|	ВТ_Сопоставление.Упаковка,
	|	ВТ_Сопоставление.ЕстьРучнойОстаток,
	|	ВТ_Сопоставление.РучнойОстаток,
	|	ВЫБОР
	|		КОГДА ВТ_Сопоставление.СкрываемыйОстаток ЕСТЬ NULL
	|			ТОГДА &КоличествоСкрываемогоОстатка
	|		ИНАЧЕ ВТ_Сопоставление.СкрываемыйОстаток
	|	КОНЕЦ,
	|	ВТ_Сопоставление.ЕстьСкрываемыйОстаток,
	|	ВТ_Остатки.Свободно,
	|	ВТ_Остатки.Резерв,
	|	ВТ_Сопоставление.ПоследнийВыгруженныйОстаток,
	|	ВТ_Сопоставление.ЕстьПоследнийВыгруженныйОстаток
	|
	|УПОРЯДОЧИТЬ ПО
	|	ВТ_Сопоставление.ЕстьСопоставление УБЫВ";
	
	Возврат Текст;
	
КонецФункции //- ИнфоСофт Ивонин К.А. 04.03.24 УА #66733

//+ ИнфоСофт Ивонин К.А. 04.03.24 УА #66733                                                                                  
Процедура УстановитьПараметрыЗапросаОстатков(Запрос, Профиль, Склад) Экспорт
	
	Событие = ПолучитьИмяСобытия("УстановитьПараметрыЗапросаОстатков");
	
	Организация = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Профиль, "Организация");
	
	ПеречислениеМП = Перечисления.ИС_МП_Маркетплейсы.ЯМ; 
	
	МассивПараметров = ИС_МП_УправлениеОстатками.МассивНастроекОстатков(ПеречислениеМП);
	
	Настройки = ИС_МП_Сервер.ПолучитьЗначениеНастроек(Профиль, ПеречислениеМП, МассивПараметров); 
	
	РассчитыватьНесобранныеКомплекты = Ложь;
	ВыгружатьОстаткиВРазрезеОрганизации = Ложь;
	СкрываемыйОстаток = 0;

	Если Настройки.РассчитыватьНесобранныеКомплекты <> Неопределено Тогда
		РассчитыватьНесобранныеКомплекты = Настройки.РассчитыватьНесобранныеКомплекты;	
	КонецЕсли; 

	Если Настройки.ВыгружатьОстаткиВРазрезеОрганизации <> Неопределено Тогда
		ВыгружатьОстаткиВРазрезеОрганизации = Настройки.ВыгружатьОстаткиВРазрезеОрганизации;	
	КонецЕсли;

	Если Настройки.СкрываемыйОстаток <> Неопределено Тогда
		СкрываемыйОстаток = Настройки.СкрываемыйОстаток;	
	КонецЕсли;
		
	Запрос.УстановитьПараметр("Профиль", Профиль);
	Запрос.УстановитьПараметр("Маркетплейс", ПеречислениеМП);
	Запрос.УстановитьПараметр("Склад", Склад); 
	Запрос.УстановитьПараметр("КоличествоСкрываемогоОстатка", СкрываемыйОстаток);
	Запрос.УстановитьПараметр("РассчитыватьНесобранныеКомплекты", РассчитыватьНесобранныеКомплекты);
	Запрос.УстановитьПараметр("ВыгружатьОстаткиВРазрезеОрганизации", ВыгружатьОстаткиВРазрезеОрганизации);
	Запрос.УстановитьПараметр("Организация", Организация);
	Запрос.УстановитьПараметр("ПустаяУпаковка", ИС_МП_СерверЛокализация.ПустаяСсылкаУпаковка());
	
	СГТ = Ложь;
	Заменитель = "ИЕРАРХИИ";
	ПараметрСклад = Неопределено;
	
	ЗапросНазначений = Новый Запрос;
	ЗапросНазначений.Текст = 
	"ВЫБРАТЬ
	|	ЕСТЬNULL(Назначения.Ссылка, ЗНАЧЕНИЕ(Справочник.Назначения.ПустаяСсылка)) КАК Назначение
	|ИЗ
	|	Справочник.ИС_ЯМ_Склады.НаправленияДеятельности КАК ИС_ЯМ_СкладыНаправленияДеятельности
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Назначения КАК Назначения
	|		ПО ИС_ЯМ_СкладыНаправленияДеятельности.НаправлениеДеятельности = Назначения.НаправлениеДеятельности
	|			И (Назначения.НаправлениеДеятельности <> ЗНАЧЕНИЕ(Справочник.НаправленияДеятельности.ПустаяСсылка))
	|ГДЕ
	|	ИС_ЯМ_СкладыНаправленияДеятельности.Ссылка = &Ссылка";
	
	ЗапросНазначений.УстановитьПараметр("Ссылка", Склад);
	
	РезультатЗапросаНазначений = ЗапросНазначений.Выполнить();
	
	Назначения = Новый Массив;
	
	ВыборкаНазначения = РезультатЗапросаНазначений.Выбрать();
	
	Пока ВыборкаНазначения.Следующий() Цикл	
		Назначения.Добавить(ВыборкаНазначения.Назначение);
	КонецЦикла;
	
	Если Назначения.Количество() = 0 Тогда		
		Назначения = Справочники.Назначения.ПустаяСсылка();
	КонецЕсли;

	Запрос.УстановитьПараметр("Назначение", Назначения);
	
	ЗапросСклада = Новый Запрос;
	ЗапросСклада.Текст = 
	"ВЫБРАТЬ
	|	ИС_ЯМ_Склады.Ссылка КАК Ссылка,
	|	ИС_ЯМ_Склады.ВыгружатьОстаткиИзГруппыСкладов КАК ВыгружатьОстаткиИзГруппыСкладов,
	|	ИС_ЯМ_Склады.Склад КАК Склад,
	|	ИС_ЯМ_Склады.ОбщаяГруппаСкладов КАК ОбщаяГруппаСкладов,
	|	ИС_ЯМ_СкладыГруппаСкладов.Склад КАК СкладГруппы
	|ИЗ
	|	Справочник.ИС_ЯМ_Склады КАК ИС_ЯМ_Склады
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ИС_ЯМ_Склады.ГруппаСкладов КАК ИС_ЯМ_СкладыГруппаСкладов
	|		ПО ИС_ЯМ_Склады.Ссылка = ИС_ЯМ_СкладыГруппаСкладов.Ссылка
	|ГДЕ
	|	ИС_ЯМ_Склады.Ссылка = &Ссылка
	|ИТОГИ ПО
	|	Ссылка";

	ЗапросСклада.УстановитьПараметр("Ссылка", Склад);
	
	РезультатЗапроса = ЗапросСклада.Выполнить();
	
	ВыборкаСклад = РезультатЗапроса.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	Пока ВыборкаСклад.Следующий() Цикл
			
        //СГТ = ВыборкаСклад.СГТ;			
				
		Если ВыборкаСклад.ВыгружатьОстаткиИзГруппыСкладов Тогда 
		    
		    ПараметрСклад = Новый Массив;
		    
			ВыборкаГруппаСкладов = ВыборкаСклад.Выбрать();
		
			Пока ВыборкаГруппаСкладов.Следующий() Цикл
			
				Если ВыборкаГруппаСкладов.СкладГруппы <> Null Тогда
			    	ПараметрСклад.Добавить(ВыборкаГруппаСкладов.СкладГруппы);
			    КонецЕсли;
			    
			КонецЦикла;				
		
		ИначеЕсли ЗначениеЗаполнено(ВыборкаСклад.ОбщаяГруппаСкладов) Тогда
			Заменитель = "";
			ПараметрСклад = ВыборкаСклад.ОбщаяГруппаСкладов;
		Иначе
			ПараметрСклад = ВыборкаСклад.Склад;
		КонецЕсли;
	
	КонецЦикла;
	
	//Запрос.УстановитьПараметр("СГТ", СГТ); 
	Если ЗначениеЗаполнено(Заменитель) Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, Заменитель, ""); 
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(ПараметрСклад) Тогда
		Текст = СтрШаблон("Не заполнено сопоставление склада %1 (%2)", Склад, Профиль);
		ИС_MP_Сервер.ЗаписатьВЖРИСообщитьПользователю(Событие, Текст); 
	КонецЕсли;
	 
	Запрос.УстановитьПараметр("Склад1С", ПараметрСклад);
	
КонецПроцедуры //- ИнфоСофт Ивонин К.А. 04.03.24 УА #66733

//+ ИнфоСофт Ивонин К.А. 08.03.24 УА #66733
Процедура ВыгрузитьОстатки(Профиль, Склад, ТаблицаВыгрузки = Неопределено) Экспорт  
	
	Событие = ПолучитьИмяСобытия("ВыгрузитьОстатки");

	НастройкиСоединения = ПолучитьНастройкиСоединенияПрофиля(Профиль);	
	ПараметрыЗапроса = ПроверитьИЗаполнитьПараметрыЗапроса(НастройкиСоединения);
	
	ПеречислениеМП = Перечисления.ИС_МП_Маркетплейсы.ЯМ;
	
	МассивНастроек = ИС_МП_УправлениеОстатками.МассивПараметровВыгрузкиОстатков();	
	
	Настройки = ИС_МП_Сервер.ПолучитьЗначениеНастроек(Профиль, ПеречислениеМП, МассивНастроек);
		
	ИспользоватьПоследниеОстатки = Ложь;
	
	Если Настройки.ИспользоватьПоследниеОстатки <> Неопределено Тогда
		ИспользоватьПоследниеОстатки = Настройки.ИспользоватьПоследниеОстатки;
	КонецЕсли;
		
	Если ТаблицаВыгрузки = Неопределено Тогда		
		ТаблицаВыгрузки = ИС_МП_УправлениеОстатками.СформироватьТаблицуВыгрузки(Профиль, Склад, ПеречислениеМП, Настройки);		
	КонецЕсли;  
	
	Если ТаблицаВыгрузки.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	skus = Новый Массив;
	Дата = ИС_MP_РаботаСHTTPЗапросамиСервер.ЗаписатьДатуВJSON(ТекущаяДатаСеанса(), ФорматДатыJSON.ISO, ВариантЗаписиДатыJSON.УниверсальнаяДата); 
	
	//+ ИнфоСофт Стояк Ю.К. 03.03.2025 УА #88575	
	//КампанияID = Формат(НастройкиСоединения["ЯМКампанияID"], "ЧГ=");
	Если Склад.ИДМагазинаОсновногоСкладаГруппы = 0 Тогда
		КампанияID = Формат(НастройкиСоединения["ЯМКампанияID"], "ЧГ=");
		ИДСклада = Склад.id;
	Иначе
		КампанияID = Формат(Склад.ИДМагазинаОсновногоСкладаГруппы, "ЧГ=");
		ИДСклада = Склад.ИДОсновногоСкладаГруппы;
	КонецЕсли;                                  
	//- ИнфоСофт Стояк Ю.К. 03.03.2025 УА #88575

	Для Каждого Строка Из ТаблицаВыгрузки Цикл
		
		stock = Новый Структура;
		items = Новый Массив;
		item = Новый Структура;
		
		stock.Вставить("sku", Строка.shopSku);
		//+ ИнфоСофт Стояк Ю.К. 03.03.2025 УА #88575		
		//stock.Вставить("warehouseId", Склад.id);	
		stock.Вставить("warehouseId", ИДСклада);	
		//- ИнфоСофт Стояк Ю.К. 03.03.2025 УА #88575
		
		item.Вставить("type", "FIT");
		item.Вставить("count", Строка.Остаток);
		item.Вставить("updatedAt", Дата);
		
		items.Добавить(item);
		
		stock.Вставить("items", items);
		
		skus.Добавить(stock);
				
	КонецЦикла; 
	
	РазбитыйМассив = ИС_MP_Сервер.РазбитьМассивПоNЭлементов(skus, 500);
	
	БылиОшибкиВыгрузки = Ложь;
	
	Для Каждого Элемент Из РазбитыйМассив Цикл	
		
		Результат = ИС_ЯМ_API.ВыгрузитьОстатки(Профиль, ПараметрыЗапроса, КампанияID, Элемент);
		
		Если Результат = Неопределено Тогда
			БылиОшибкиВыгрузки = Истина;
			Продолжить;
		КонецЕсли;
		
		ОбщегоНазначения.СообщитьПользователю("Выгрузка завершилась со следующим статусом: " + Результат);	
		
	КонецЦикла;
	
	Если Не ИспользоватьПоследниеОстатки Тогда
		Возврат;
	КонецЕсли;
	
	Если Не БылиОшибкиВыгрузки Тогда
	
		Для Каждого Строка Из ТаблицаВыгрузки Цикл
			ИС_МП_УправлениеОстатками.ЗаписатьПоследнийВыгруженныйОстаток(Профиль, 
				Перечисления.ИС_МП_Маркетплейсы.ЯМ, Склад, Строка.НоменклатураЯМ, Строка.Остаток);
		КонецЦикла;
	
	КонецЕсли; 
	
КонецПроцедуры //- ИнфоСофт Ивонин К.А. 08.03.24 УА #66733 

//+ ИнфоСофт Мурсалимов Д.Р. 13.05.24 УА #66901
Процедура ВыгрузитьЦены(Профиль, ТаблицаВыгрузки = Неопределено) Экспорт

	Событие = ПолучитьИмяСобытия("ВыгрузитьЦены");
	
	НастройкиСоединения = ПолучитьНастройкиСоединенияПрофиля(Профиль);	
	ПараметрыЗапроса = ПроверитьИЗаполнитьПараметрыЗапроса(НастройкиСоединения);
	
	МассивПараметров = ПолучитьСписокПараметровЦен();
	
	Результат = ИС_MP_Сервер.ПолучитьЗначениеНастроек(Профиль, Перечисления.ИС_МП_Маркетплейсы.ЯМ, МассивПараметров);
	
	СтруктураЦен = ПолучитьСтруктуруПараметровЦен();
	
	ЗаполнитьЗначенияСвойств(СтруктураЦен, Результат);
	
	РежимОкругленияЦен = СтруктураЦен.РежимОкругленияЦен;
	ИспользоватьПоследниеЦены = СтруктураЦен.ИспользоватьПоследниеЦены;
	ИспользоватьНовыеМетодыApi = СтруктураЦен.ИспользоватьНовыеМетодыApi;
	
	ПеречислениеМП = Перечисления.ИС_МП_Маркетплейсы.ЯМ;
	
	Если ТаблицаВыгрузки = Неопределено Тогда
				
		Запрос = Новый Запрос;
		Запрос.Текст = ПолучитьТекстЗапросаЦен(); 
		
		УстановитьПараметрыЗапросаЦен(Запрос, Профиль);                                                       
		
		РезультатЗапроса = Запрос.Выполнить();
		
		Если РезультатЗапроса.Пустой() Тогда
			Возврат;
		КонецЕсли;
		
		Выборка = РезультатЗапроса.Выбрать();
		
		ТаблицаВыгрузки = Новый ТаблицаЗначений;	
		
		ИС_МП_УправлениеЦенами.ЗаполнитьКолонкиТаблицыВыгрузкиЦен(ПеречислениеМП, ТаблицаВыгрузки);
		
		МассивПолей = ИС_МП_УправлениеЦенами.ПолучитьПоляДляВыгрузки(ПеречислениеМП);
		
		Пока Выборка.Следующий() Цикл
		
			Если Не Выборка.ЕстьСопоставление И Не Выборка.ЕстьРучнаяЦена И Не Выборка.ЕстьРучнаяЦенаСоСкидкой Тогда
				Продолжить;
			КонецЕсли;  
			
			Если Не ЗначениеЗаполнено(Выборка.shopSku) Тогда
				Продолжить;
			КонецЕсли;
						
			НоваяСтрока = ТаблицаВыгрузки.Добавить();
		
			Для Каждого Элемент Из МассивПолей Цикл
				НоваяСтрока[Элемент] = Выборка[Элемент];
			КонецЦикла;
			
			ЭтоНабор = Выборка.ЭтоНабор;
			
			Если Выборка.ЕстьРучнаяЦена Тогда
				Цена = Выборка.РучнаяЦена;
			Иначе  
				Цена = Выборка.Цена;
			КонецЕсли;
			
			Цена = Окр(Цена, 0, РежимОкругленияЦен);
			
			НоваяСтрока.Цена = Цена;
			
			Если Выборка.ЕстьРучнаяЦенаСоСкидкой Тогда
				ЦенаСоСкидкой = Выборка.РучнаяЦенаСоСкидкой;
			Иначе
				ЦенаСоСкидкой = Выборка.ЦенаСоСкидкой;	
			КонецЕсли;
			
			ЦенаСоСкидкой = Окр(ЦенаСоСкидкой, 0, РежимОкругленияЦен);
			
			НоваяСтрока.ЦенаСоСкидкой = ЦенаСоСкидкой;
			
			Если НоваяСтрока.Цена = 0 И НоваяСтрока.ЦенаСоСкидкой = 0 Тогда 
				ТаблицаВыгрузки.Удалить(НоваяСтрока);
			КонецЕсли;
			
			Если Не ИспользоватьПоследниеЦены Тогда
				Продолжить;
			КонецЕсли;
			
			Если Не Выборка.ЕстьРучнаяЦена И Не Выборка.ЕстьРучнаяЦенаСоСкидкой Тогда
			
				Если Не ИС_МП_УправлениеЦенами.ПроверитьПоследниеЦены(ПеречислениеМП, Выборка, НоваяСтрока) Тогда
					ТаблицаВыгрузки.Удалить(НоваяСтрока);
				КонецЕсли; 
				
			КонецЕсли;
			
		КонецЦикла;
				
	КонецЕсли;
	
	Если ТаблицаВыгрузки.Количество() = 0 Тогда
		ОбщегоНазначения.СообщитьПользователю("Отсутствуют данные для выгрузки!");
		Возврат;
	КонецЕсли;  	
	
	offers = Новый Массив;	
	
	КодБизнеса = СтрЗаменить(Строка(НастройкиСоединения["ЯМКодБизнеса"]), Символы.НПП, "");
	КампанияID = Формат(НастройкиСоединения["ЯМКампанияID"], "ЧГ=");
	
	Для Каждого Строка Из ТаблицаВыгрузки Цикл
		
		offer = Новый Структура; 
		
		price = Новый Структура;  
		
		offer.Вставить("offerId", 			Строка.shopSku);		
		
		price.Вставить("currencyId", 		"RUR");  
		
		Если ЗначениеЗаполнено(Строка.Цена) И Строка.Цена > 0 Тогда
			price.Вставить("discountBase", 	Строка.Цена); 
		КонецЕсли;
			
		price.Вставить("value", 			Строка.ЦенаСоСкидкой);
		
		offer.Вставить("price", 			price);
		
		offers.Добавить(offer);
		
	КонецЦикла; 
	
	РазбитыйМассив = ИС_MP_Сервер.РазбитьМассивПоNЭлементов(offers, 500);
	
	БылиОшибкиВыгрузки = Ложь;
	//+ ИнфоСофт Стояк Ю.К. 11.06.2024 УА #69782
	Счетчик = 0;
	//- ИнфоСофт Стояк Ю.К. 11.06.2024 УА #69782
	
	Если ИспользоватьНовыеМетодыApi Тогда 
					
		Для Каждого Элемент Из РазбитыйМассив Цикл	
			
			Результат = ИС_ЯМ_API.ВыгрузитьЦеныNEW(Профиль, ПараметрыЗапроса, КодБизнеса, Элемент);
			
			Если Результат = Неопределено Тогда
				БылиОшибкиВыгрузки = Истина;
				Продолжить;
			КонецЕсли;
			
			ОбщегоНазначения.СообщитьПользователю("Выгрузка прошла со следующим статусом:" + Результат);
			
			//+ ИнфоСофт Стояк Ю.К. 11.06.2024 УА #69782		
			Счетчик = Счетчик + 1;
			
			Если Счетчик = 10 Тогда
				Счетчик = 0;
				ИС_MP_Сервер.Пауза(60);
			КонецЕсли;
			//- ИнфоСофт Стояк Ю.К. 11.06.2024 УА #69782
			
		КонецЦикла; 		
		
	Иначе
		
		Для Каждого Элемент Из РазбитыйМассив Цикл	
			
			Результат = ИС_ЯМ_API.ВыгрузитьЦены(Профиль, ПараметрыЗапроса, КампанияID, Элемент);
			
			Если Результат = Неопределено Тогда
				БылиОшибкиВыгрузки = Истина;
				Продолжить;
			КонецЕсли;
			
			ОбщегоНазначения.СообщитьПользователю("Выгрузка прошла со следующим статусом:" + Результат);		
			
			//+ ИнфоСофт Стояк Ю.К. 11.06.2024 УА #69782		
			Счетчик = Счетчик + 1;
			
			Если Счетчик = 10 Тогда
				Счетчик = 0;
				ИС_MP_Сервер.Пауза(60);
			КонецЕсли;
			//- ИнфоСофт Стояк Ю.К. 11.06.2024 УА #69782
			
		КонецЦикла;
		
	КонецЕсли;
	
	Если Не БылиОшибкиВыгрузки И ИспользоватьПоследниеЦены Тогда
		
		Для Каждого Строка Из ТаблицаВыгрузки Цикл	
			
			ИС_МП_УправлениеЦенами.ЗаписатьПоследнююВыгруженнуюЦену(Профиль, 
			Перечисления.ИС_МП_Маркетплейсы.ЯМ, Строка.НоменклатураЯМ, Строка.Цена, Перечисления.ИС_МП_ВидыЦенМаркетплейса.ВидЦены);
			
			ИС_МП_УправлениеЦенами.ЗаписатьПоследнююВыгруженнуюЦену(Профиль, 
			Перечисления.ИС_МП_Маркетплейсы.ЯМ, Строка.НоменклатураЯМ, Строка.ЦенаСоСкидкой, Перечисления.ИС_МП_ВидыЦенМаркетплейса.ВидЦеныСоСкидкой);
			
		КонецЦикла;	
		
	КонецЕсли;
	
КонецПроцедуры //- ИнфоСофт Мурсалимов Д.Р. 13.05.24 УА #66901

//+ ИнфоСофт Мурсалимов Д.Р. 03.05.24 УА #66901
Функция ПолучитьТекстЗапросаЦен() Экспорт 
	
	Текст = 
	"ВЫБРАТЬ
	|	ИС_ЯМ_Номенклатура.Ссылка КАК ПолеСопоставления,
	|	ИС_МП_РучныеЦены.Цена КАК Цена,
	|	NULL КАК ЦенаСоСкидкой
	|ПОМЕСТИТЬ ВТ_РучныеЦеныОбъединение
	|ИЗ
	|	Справочник.ИС_ЯМ_Номенклатура КАК ИС_ЯМ_Номенклатура
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ИС_МП_РучныеЦены КАК ИС_МП_РучныеЦены
	|		ПО (ИС_МП_РучныеЦены.Профиль = &Профиль)
	|			И (ИС_МП_РучныеЦены.Маркетплейс = &Маркетплейс)
	|			И (ИС_ЯМ_Номенклатура.Ссылка = (ВЫРАЗИТЬ(ИС_МП_РучныеЦены.КарточкаМП КАК Справочник.ИС_ЯМ_Номенклатура)))
	|			И (ИС_МП_РучныеЦены.ВидЦеныМаркетплейса = ЗНАЧЕНИЕ(Перечисление.ИС_МП_ВидыЦенМаркетплейса.ВидЦены))
	|ГДЕ
	|	ИС_МП_РучныеЦены.Профиль = &Профиль
	|	И ИС_МП_РучныеЦены.Маркетплейс = &Маркетплейс
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ИС_ЯМ_Номенклатура.Ссылка,
	|	NULL,
	|	ИС_МП_РучныеЦеныСоСкидкой.Цена
	|ИЗ
	|	Справочник.ИС_ЯМ_Номенклатура КАК ИС_ЯМ_Номенклатура
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ИС_МП_РучныеЦены КАК ИС_МП_РучныеЦеныСоСкидкой
	|		ПО (ИС_МП_РучныеЦеныСоСкидкой.Профиль = &Профиль)
	|			И (ИС_МП_РучныеЦеныСоСкидкой.Маркетплейс = &Маркетплейс)
	|			И (ИС_ЯМ_Номенклатура.Ссылка = (ВЫРАЗИТЬ(ИС_МП_РучныеЦеныСоСкидкой.КарточкаМП КАК Справочник.ИС_ЯМ_Номенклатура)))
	|			И (ИС_МП_РучныеЦеныСоСкидкой.ВидЦеныМаркетплейса = ЗНАЧЕНИЕ(Перечисление.ИС_МП_ВидыЦенМаркетплейса.ВидЦеныСоСкидкой))
	|ГДЕ
	|	ИС_МП_РучныеЦеныСоСкидкой.Профиль = &Профиль
	|	И ИС_МП_РучныеЦеныСоСкидкой.Маркетплейс = &Маркетплейс
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ИС_ЯМ_Номенклатура.Ссылка КАК ПолеСопоставления,
	|	ИС_МП_ПоследниеЦены.Цена КАК Цена,
	|	NULL КАК ЦенаСоСкидкой
	|ПОМЕСТИТЬ ВТ_ПоследниеЦеныОбъединение
	|ИЗ
	|	Справочник.ИС_ЯМ_Номенклатура КАК ИС_ЯМ_Номенклатура
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ИС_МП_ПоследниеВыгруженныеЦены КАК ИС_МП_ПоследниеЦены
	|		ПО (ИС_МП_ПоследниеЦены.Профиль = &Профиль)
	|			И (ИС_МП_ПоследниеЦены.Маркетплейс = &Маркетплейс)
	|			И (ИС_ЯМ_Номенклатура.Ссылка = (ВЫРАЗИТЬ(ИС_МП_ПоследниеЦены.КарточкаМП КАК Справочник.ИС_ЯМ_Номенклатура)))
	|			И (ИС_МП_ПоследниеЦены.ВидЦеныМаркетплейса = ЗНАЧЕНИЕ(Перечисление.ИС_МП_ВидыЦенМаркетплейса.ВидЦены))
	|ГДЕ
	|	ИС_МП_ПоследниеЦены.Профиль = &Профиль
	|	И ИС_МП_ПоследниеЦены.Маркетплейс = &Маркетплейс
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ИС_ЯМ_Номенклатура.Ссылка,
	|	NULL,
	|	ИС_МП_ПоследниеЦеныСоСкидкой.Цена
	|ИЗ
	|	Справочник.ИС_ЯМ_Номенклатура КАК ИС_ЯМ_Номенклатура
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ИС_МП_ПоследниеВыгруженныеЦены КАК ИС_МП_ПоследниеЦеныСоСкидкой
	|		ПО (ИС_МП_ПоследниеЦеныСоСкидкой.Профиль = &Профиль)
	|			И (ИС_МП_ПоследниеЦеныСоСкидкой.Маркетплейс = &Маркетплейс)
	|			И (ИС_ЯМ_Номенклатура.Ссылка = (ВЫРАЗИТЬ(ИС_МП_ПоследниеЦеныСоСкидкой.КарточкаМП КАК Справочник.ИС_ЯМ_Номенклатура)))
	|			И (ИС_МП_ПоследниеЦеныСоСкидкой.ВидЦеныМаркетплейса = ЗНАЧЕНИЕ(Перечисление.ИС_МП_ВидыЦенМаркетплейса.ВидЦеныСоСкидкой))
	|ГДЕ
	|	ИС_МП_ПоследниеЦеныСоСкидкой.Профиль = &Профиль
	|	И ИС_МП_ПоследниеЦеныСоСкидкой.Маркетплейс = &Маркетплейс
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_РучныеЦеныОбъединение.ПолеСопоставления КАК ПолеСопоставления,
	|	СУММА(ВТ_РучныеЦеныОбъединение.Цена) КАК Цена,
	|	СУММА(ВТ_РучныеЦеныОбъединение.ЦенаСоСкидкой) КАК ЦенаСоСкидкой
	|ПОМЕСТИТЬ ВТ_РучныеЦены
	|ИЗ
	|	ВТ_РучныеЦеныОбъединение КАК ВТ_РучныеЦеныОбъединение
	|
	|СГРУППИРОВАТЬ ПО
	|	ВТ_РучныеЦеныОбъединение.ПолеСопоставления
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_ПоследниеЦеныОбъединение.ПолеСопоставления КАК ПолеСопоставления,
	|	СУММА(ВТ_ПоследниеЦеныОбъединение.Цена) КАК Цена,
	|	СУММА(ВТ_ПоследниеЦеныОбъединение.ЦенаСоСкидкой) КАК ЦенаСоСкидкой
	|ПОМЕСТИТЬ ВТ_ПоследниеЦены
	|ИЗ
	|	ВТ_ПоследниеЦеныОбъединение КАК ВТ_ПоследниеЦеныОбъединение
	|
	|СГРУППИРОВАТЬ ПО
	|	ВТ_ПоследниеЦеныОбъединение.ПолеСопоставления
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ИС_ЯМ_Номенклатура.Ссылка КАК ПолеСопоставления,
	|	ИС_ЯМ_Номенклатура.shopSku КАК shopSku,
	|	ИС_ЯМ_СоответствиеХарактеристик.Номенклатура КАК Номенклатура,
	|	ИС_ЯМ_СоответствиеХарактеристик.Характеристика КАК Характеристика,
	|	ЕСТЬNULL(ИС_ЯМ_СоответствиеХарактеристик.Характеристика.ХарактеристикаНоменклатурыДляЦенообразования, ЗНАЧЕНИЕ(Справочник.ХарактеристикиНоменклатурыДляЦенообразования.ПустаяСсылка)) КАК ХарактеристикаЦО,
	|	ЕСТЬNULL(ИС_ЯМ_СоответствиеХарактеристик.Номенклатура.ТипНоменклатуры, ЗНАЧЕНИЕ(Перечисление.ТипыНоменклатуры.ПустаяСсылка)) = ЗНАЧЕНИЕ(Перечисление.ТипыНоменклатуры.Набор) КАК ЭтоНабор,
	|	ЕСТЬNULL(ИС_ЯМ_СоответствиеХарактеристик.Упаковка, &ПустаяУпаковка) КАК Упаковка,
	|	ВЫБОР
	|		КОГДА ИС_ЯМ_СоответствиеХарактеристик.Упаковка.Числитель = 0
	|			ТОГДА 1
	|		ИНАЧЕ ЕСТЬNULL(ИС_ЯМ_СоответствиеХарактеристик.Упаковка.Числитель, 1)
	|	КОНЕЦ / ВЫБОР
	|		КОГДА ИС_ЯМ_СоответствиеХарактеристик.Упаковка.Знаменатель = 0
	|			ТОГДА 1
	|		ИНАЧЕ ЕСТЬNULL(ИС_ЯМ_СоответствиеХарактеристик.Упаковка.Знаменатель, 1)
	|	КОНЕЦ КАК КоэффициентУпаковки,
	|	НЕ ИС_ЯМ_СоответствиеХарактеристик.Номенклатура ЕСТЬ NULL КАК ЕстьСопоставление,
	|	ВТ_РучныеЦены.Цена КАК РучнаяЦена,
	|	НЕ ВТ_РучныеЦены.Цена ЕСТЬ NULL КАК ЕстьРучнаяЦена,
	|	ВТ_РучныеЦены.ЦенаСоСкидкой КАК РучнаяЦенаСоСкидкой,
	|	НЕ ВТ_РучныеЦены.ЦенаСоСкидкой ЕСТЬ NULL КАК ЕстьРучнаяЦенаСоСкидкой,
	|	ЕСТЬNULL(ВТ_ПоследниеЦены.Цена, 0) КАК ПоследняяВыгруженнаяЦена,
	|	НЕ ВТ_ПоследниеЦены.Цена ЕСТЬ NULL КАК ЕстьПоследняяВыгруженнаяЦена,
	|	ЕСТЬNULL(ВТ_ПоследниеЦены.ЦенаСоСкидкой, 0) КАК ПоследняяВыгруженнаяЦенаСоСкидкой,
	|	НЕ ВТ_ПоследниеЦены.ЦенаСоСкидкой ЕСТЬ NULL КАК ЕстьПоследняяВыгруженнаяЦенаСоСкидкой
	|ПОМЕСТИТЬ ВТ_Сопоставление
	|ИЗ
	|	Справочник.ИС_ЯМ_Номенклатура КАК ИС_ЯМ_Номенклатура
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ИС_ЯМ_СоответствиеХарактеристик КАК ИС_ЯМ_СоответствиеХарактеристик
	|		ПО ИС_ЯМ_Номенклатура.Ссылка = ИС_ЯМ_СоответствиеХарактеристик.НоменклатураЯМ
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_РучныеЦены КАК ВТ_РучныеЦены
	|		ПО (ВТ_РучныеЦены.ПолеСопоставления = ИС_ЯМ_Номенклатура.Ссылка)
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_ПоследниеЦены КАК ВТ_ПоследниеЦены
	|		ПО (ВТ_ПоследниеЦены.ПолеСопоставления = ИС_ЯМ_Номенклатура.Ссылка)
	|ГДЕ
	|	ИС_ЯМ_Номенклатура.Профиль = &Профиль
	|	И НЕ ИС_ЯМ_Номенклатура.ПометкаУдаления";	
	
	Текст = Текст + ";";
	
	Текст = Текст + ИС_МП_УправлениеЦенами.ТекстЗапросаЦен();
	
	Текст = Текст +	
	
	"ВЫБРАТЬ
	|	ВТ_Сопоставление.ПолеСопоставления КАК НоменклатураЯМ,
	|	ВТ_Сопоставление.shopSku КАК shopSku,
	|	ВТ_Сопоставление.Номенклатура КАК Номенклатура,
	|	ВТ_Сопоставление.Характеристика КАК Характеристика,
	|	ВТ_Сопоставление.Упаковка КАК Упаковка, 
	|	ВТ_Сопоставление.ЭтоНабор КАК ЭтоНабор,
	|	ВТ_Сопоставление.РучнаяЦена КАК РучнаяЦена,
	|	ВТ_Сопоставление.РучнаяЦенаСоСкидкой КАК РучнаяЦенаСоСкидкой,
	|	ВТ_Сопоставление.ЕстьРучнаяЦена КАК ЕстьРучнаяЦена,
	|	ВТ_Сопоставление.ЕстьРучнаяЦенаСоСкидкой КАК ЕстьРучнаяЦенаСоСкидкой,
	|	ВТ_Сопоставление.ЕстьСопоставление КАК ЕстьСопоставление,
	|	ВТ_Сопоставление.ПоследняяВыгруженнаяЦена КАК ПоследняяВыгруженнаяЦена,
	|	ВТ_Сопоставление.ПоследняяВыгруженнаяЦенаСоСкидкой КАК ПоследняяВыгруженнаяЦенаСоСкидкой,
	|	ВТ_Сопоставление.ЕстьПоследняяВыгруженнаяЦена КАК ЕстьПоследняяВыгруженнаяЦена,
	|	ВТ_Сопоставление.ЕстьПоследняяВыгруженнаяЦенаСоСкидкой КАК ЕстьПоследняяВыгруженнаяЦенаСоСкидкой,
	|	ВТ_Цены.Цена КАК Цена,
	|	ВТ_Цены.ЦенаСоСкидкой КАК ЦенаСоСкидкой,
	|	МАКСИМУМ(ИС_ЯМ_Штрихкоды.Наименование) КАК Штрихкод
	|ИЗ
	|	ВТ_Сопоставление КАК ВТ_Сопоставление
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_Цены КАК ВТ_Цены
	|		ПО ВТ_Сопоставление.ПолеСопоставления = ВТ_Цены.ПолеСопоставления
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ИС_ЯМ_Штрихкоды КАК ИС_ЯМ_Штрихкоды
	|		ПО (ИС_ЯМ_Штрихкоды.Профиль = &Профиль)
	|			И ВТ_Сопоставление.ПолеСопоставления = ИС_ЯМ_Штрихкоды.Владелец
	|
	|СГРУППИРОВАТЬ ПО
	|	ВТ_Сопоставление.ПолеСопоставления,
	|	ВТ_Сопоставление.shopSku,
	|	ВТ_Сопоставление.Номенклатура,
	|	ВТ_Сопоставление.Характеристика,
	|	ВТ_Сопоставление.Упаковка, 
	|	ВТ_Сопоставление.ЭтоНабор,
	|	ВТ_Сопоставление.ЕстьСопоставление,
	|	ВТ_Сопоставление.РучнаяЦена,
	|	ВТ_Сопоставление.ЕстьРучнаяЦена,
	|	ВТ_Сопоставление.РучнаяЦенаСоСкидкой,
	|	ВТ_Сопоставление.ЕстьРучнаяЦенаСоСкидкой,
	|	ВТ_Сопоставление.ПоследняяВыгруженнаяЦена,
	|	ВТ_Сопоставление.ЕстьПоследняяВыгруженнаяЦена,
	|	ВТ_Сопоставление.ПоследняяВыгруженнаяЦенаСоСкидкой,
	|	ВТ_Сопоставление.ЕстьПоследняяВыгруженнаяЦенаСоСкидкой,
	|	ВТ_Цены.Цена,
	|	ВТ_Цены.ЦенаСоСкидкой
	|
	|УПОРЯДОЧИТЬ ПО
	|	ВТ_Сопоставление.ЕстьСопоставление УБЫВ,
	|	ВТ_Сопоставление.РучнаяЦена УБЫВ";
	
	Возврат Текст;
		
