			КонецПопытки;                               
			//- ИнфоСофт Стояк Ю.К. 19.03.2024 УА #72349 
			
			//+ ИнфоСофт Стояк Ю.К. 02.07.2024 УА #67813			
			Если ФукнциональныеОпции.РежимСозданияЗаказовЯМ <> 0 Тогда
				
