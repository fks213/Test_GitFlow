Функция ПолучитьЗаказПоНомеру(id) 
	
	Попытка 
		НомерЗаказ = ПреобразоватьВСтрокуБезПробелов(id);
	Исключение
		Возврат Документы.ИС_ЯМ_Заказ.ПустаяСсылка();
	КонецПопытки;
	
	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	ЕСТЬNULL(ИС_ЯМ_Заказ.Ссылка, ЗНАЧЕНИЕ(Документ.ИС_ЯМ_Заказ.ПустаяСсылка)) КАК Ссылка
	|ИЗ
	|	Документ.ИС_ЯМ_Заказ КАК ИС_ЯМ_Заказ
	|ГДЕ
	|	ИС_ЯМ_Заказ.Номер = &Номер"); 
	
	Запрос.УстановитьПараметр("Номер", НомерЗаказ);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Если РезультатЗапроса.Пустой() Тогда
		Возврат Документы.ИС_ЯМ_Заказ.ПустаяСсылка();
    КонецЕсли;
		
	Выборка = РезультатЗапроса.Выбрать();
	
	Выборка.Следующий();
	
	Возврат Выборка.Ссылка; 
	
