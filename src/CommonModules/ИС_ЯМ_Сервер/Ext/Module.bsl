//+ ИнфоСофт Стояк Ю.К. 12.03.2024 УА #66043
Процедура ПометитьНаУдалениеКарточкиНеИзМагазина(Профиль, МассивОфферов)
		
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ИС_ЯМ_Номенклатура.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.ИС_ЯМ_Номенклатура КАК ИС_ЯМ_Номенклатура
		|ГДЕ
		|	ИС_ЯМ_Номенклатура.Профиль = &Профиль
		|	И НЕ ИС_ЯМ_Номенклатура.shopSku В (&shopSku)";
	
	Запрос.УстановитьПараметр("shopSku", МассивОфферов);
	Запрос.УстановитьПараметр("Профиль", Профиль);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		
		НоменклатураЯМ = ВыборкаДетальныеЗаписи.Ссылка.ПолучитьОбъект();
		НоменклатураЯМ.ПометкаУдаления = Истина;
		НоменклатураЯМ.Записать(); 
		
	КонецЦикла;
		
КонецПроцедуры //- ИнфоСофт Стояк Ю.К. 12.03.2024 УА #66043

//+ ИнфоСофт Стояк Ю.К. 22.05.2024 УА #65724
Процедура ЗагрузитьКатегорииТоваров(Профиль) Экспорт 
	
	Если Не ЗначениеЗаполнено(Профиль) Тогда
		ОбщегоНазначения.СообщитьПользователю("Не выбран Профиль. Загрузка категорий невозможна");
		Возврат;
	КонецЕсли;
	
	НастройкиСоединения = ПолучитьНастройкиСоединенияПрофиля(Профиль);	
	ПараметрыЗапроса = ПроверитьИЗаполнитьПараметрыЗапроса(НастройкиСоединения); 
	
	КоличествоЭлементовНаЗапрос = НастройкиСоединения["КоличествоЭлементовНаЗапрос"];
	КоличествоПопытокЗапроса = НастройкиСоединения["КоличествоОшибокЗапросов"];
	
	ТелоЗапроса = Новый Структура("language", "RU");
	
	Результат = ИС_ЯМ_API.ЗагрузитьКатегории(Профиль, ПараметрыЗапроса, ТелоЗапроса); 
	
	Если Результат.status = "OK" Тогда  
		
		КатегорияСсылка = Справочники.ИС_ЯМ_КатегорииТоваров.НайтиПоКоду(Результат.result.id);
		
		Если ЗначениеЗаполнено(КатегорияСсылка) Тогда
			СоздатьОбновитьКатегориюТоваров(Результат.result, КатегорияСсылка.parent_id, КатегорияСсылка); 
		Иначе
			СоздатьОбновитьКатегориюТоваров(Результат.result);
		КонецЕсли;
				
	Иначе
		ОбщегоНазначения.СообщитьПользователю(Результат.result);	
	КонецЕсли;
	
КонецПроцедуры //- ИнфоСофт Стояк Ю.К. 22.05.2024 УА #65724

//+ ИнфоСофт Стояк Ю.К. 22.05.2024 УА #65724
Функция СоздатьОбновитьКатегориюТоваров(ДанныеКатегории, РодительId = Неопределено, КатегорияСсылка = Неопределено)
	
	Если КатегорияСсылка = Неопределено Тогда
		Если ДанныеКатегории.Свойство("children") Тогда
			КатегорияОбъект = Справочники.ИС_ЯМ_КатегорииТоваров.СоздатьГруппу();
		Иначе
			КатегорияОбъект = Справочники.ИС_ЯМ_КатегорииТоваров.СоздатьЭлемент();
		КонецЕсли;
	Иначе
		КатегорияОбъект = КатегорияСсылка.ПолучитьОбъект();
	КонецЕсли;   
	
	КатегорияОбъект.Код 			= Число(ДанныеКатегории.id); 		
	КатегорияОбъект.Наименование 	= ДанныеКатегории.name; 	
	
	Если Не КатегорияОбъект.ЭтоГруппа Тогда		
		КатегорияОбъект.parent_id 	= РодительId;
	КонецЕсли;
	
	Если РодительId <> Неопределено Тогда
		КатегорияОбъект.Родитель 	= Справочники.ИС_ЯМ_КатегорииТоваров.НайтиПоКоду(РодительId);		
	КонецЕсли;   
	
	Попытка
		КатегорияОбъект.Записать();
	Исключение
		ИмяСобытия = ПолучитьИмяСобытия("СоздатьОбновитьКатегориюТоваров");
		Комментарий = "Не удалось записать категорию товаров: " + КатегорияОбъект.Наименование + Символы.ПС
			+ ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());		
	КонецПопытки; 
	
	Если ДанныеКатегории.Свойство("children") Тогда 
		
		Для Каждого Категория Из ДанныеКатегории.children Цикл
			
			КатегорияСсылка = Справочники.ИС_ЯМ_КатегорииТоваров.НайтиПоКоду(Категория.id);
			
			Если ЗначениеЗаполнено(КатегорияСсылка) Тогда
				СоздатьОбновитьКатегориюТоваров(Категория, Число(КатегорияОбъект.Код), КатегорияСсылка); 
			Иначе
				СоздатьОбновитьКатегориюТоваров(Категория, Число(КатегорияОбъект.Код)); 
			КонецЕсли;
			
		КонецЦикла;    
		
	КонецЕсли;
					
	Возврат КатегорияОбъект.Ссылка;

КонецФункции //- ИнфоСофт Стояк Ю.К. 22.05.2024 УА #65724  

//+ ИнфоСофт Стояк Ю.К. 24.05.2024 УА #65724
Процедура ЗагрузитьХарактеристики(Профиль, Категория = Неопределено) Экспорт

	Если Не ЗначениеЗаполнено(Профиль) Тогда
		ОбщегоНазначения.СообщитьПользователю("Не выбран Профиль. Загрузка характеристик невозможна");
		Возврат;
	КонецЕсли;
	
	НастройкиСоединения = ПолучитьНастройкиСоединенияПрофиля(Профиль);	
	ПараметрыЗапроса = ПроверитьИЗаполнитьПараметрыЗапроса(НастройкиСоединения); 
	
	КоличествоЭлементовНаЗапрос = НастройкиСоединения["КоличествоЭлементовНаЗапрос"];
	КоличествоПопытокЗапроса = НастройкиСоединения["КоличествоОшибокЗапросов"];
		
	Если Не ЗначениеЗаполнено(Категория) Тогда 
		
		ПределОшибок = 10;
		КоличествоОшибок = 0;
		
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	ИС_ЯМ_КатегорииТоваров.Ссылка.Код КАК Код,
		|	ИС_ЯМ_КатегорииТоваров.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.ИС_ЯМ_КатегорииТоваров КАК ИС_ЯМ_КатегорииТоваров
		|ГДЕ
		|	НЕ ИС_ЯМ_КатегорииТоваров.Ссылка.ЭтоГруппа
		|	И ИС_ЯМ_КатегорииТоваров.Ссылка.Используется";
		
		РезультатЗапроса = Запрос.Выполнить();
		
		ВыборкаДетальныеЗаписи = РезультатЗапроса.Выгрузить();
		
		Для Каждого Выборка Из ВыборкаДетальныеЗаписи Цикл
						
			Результат = ИС_ЯМ_API.ЗагрузитьХарактеристики(Профиль, ПараметрыЗапроса, Выборка.Код);
			
			Если Результат = Неопределено Или Результат.status <> "OK" Тогда
				КоличествоОшибок = КоличествоОшибок + 1;
				Продолжить;
			КонецЕсли;
			
			Если КоличествоОшибок = ПределОшибок Тогда
				Возврат;
			КонецЕсли;   
			
			Для Каждого Элемент Из Результат.result.parameters Цикл
						
				Характеристика = СоздатьИлиОбновитьХарактеристику(Элемент, Выборка.Ссылка);				
				ОбновитьКатегорию(Выборка.Ссылка, Характеристика, Элемент.required);
			
			КонецЦикла;
			
		КонецЦикла;
		
	КонецЕсли;
	
	
КонецПроцедуры //- ИнфоСофт Стояк Ю.К. 24.05.2024 УА #65724

//+ ИнфоСофт Стояк Ю.К. 24.05.2024 УА #65724
Функция СоздатьИлиОбновитьХарактеристику(ДанныеХарактеристики, Категория)
		
	MD5 = ПолучитьMD5Хэш(ДанныеХарактеристики);
	
	СсылкаХарактеристика = Справочники.ИС_ЯМ_Характеристика.НайтиПоКоду(Число(ДанныеХарактеристики.id));	
	
	Если СсылкаХарактеристика.Пустая() Тогда
		ХарактеристикаОбъект = Справочники.ИС_ЯМ_Характеристика.СоздатьЭлемент();
	Иначе
		
		Если СсылкаХарактеристика.MD5 = MD5 Тогда
			Возврат СсылкаХарактеристика.Ссылка;
		КонецЕсли;					
		
		ХарактеристикаОбъект = СсылкаХарактеристика.ПолучитьОбъект();
		
	КонецЕсли;					
	
	ХарактеристикаОбъект.MD5 					= MD5; 		
	ХарактеристикаОбъект.Код 					= Число(ДанныеХарактеристики.id); 		
	ХарактеристикаОбъект.Наименование 			= ДанныеХарактеристики.name; 	 
		
	ХарактеристикаОбъект.type 					= ДанныеХарактеристики.type;
	ХарактеристикаОбъект.filtering 				= ДанныеХарактеристики.filtering;
	ХарактеристикаОбъект.distinctive 			= ДанныеХарактеристики.distinctive;
	ХарактеристикаОбъект.multivalue 			= ДанныеХарактеристики.multivalue;
	ХарактеристикаОбъект.allowCustomValues 		= ДанныеХарактеристики.allowCustomValues;
	
	Если ДанныеХарактеристики.Свойство("description") Тогда                                     
		ХарактеристикаОбъект.ОписаниеХарактеристики 		= ДанныеХарактеристики.description;		
	КонецЕсли;		
	
	Если ДанныеХарактеристики.Свойство("unit") Тогда 
		
		ХарактеристикаОбъект.unit.Очистить();
		
		ХарактеристикаОбъект.defaultUnitId 		= ДанныеХарактеристики.unit.defaultUnitId;
						
		Для Каждого Юнит Из ДанныеХарактеристики.unit.units Цикл
			
			СсылкаЕдИзм = Справочники.ИС_ЯМ_ЗначенияЕдиницИзмерения.НайтиПоКоду(Юнит.id);	
			
			Если СсылкаЕдИзм.Пустая() Тогда
				ОбъектЕдИзм = Справочники.ИС_ЯМ_ЗначенияЕдиницИзмерения.СоздатьЭлемент();
			Иначе										
				ОбъектЕдИзм = СсылкаЕдИзм.ПолучитьОбъект();				
			КонецЕсли;
			
			ОбъектЕдИзм.Код = Юнит.id;
			ОбъектЕдИзм.Наименование = Юнит.fullName; 
			
			Попытка
				ОбъектЕдИзм.Записать();
				НСтр = ХарактеристикаОбъект.unit.Добавить();
				НСтр.ЕдИзм = ОбъектЕдИзм.Ссылка;
			Исключение
				ИмяСобытия = ПолучитьИмяСобытия("СоздатьИлиОбновитьХарактеристику");
				Комментарий = "Не удалось записать значение единицы измерения: " + ОбъектЕдИзм.Наименование + Символы.ПС
				+ ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());		
			КонецПопытки; 						
			
		КонецЦикла;
		
	КонецЕсли;
	
	Если ДанныеХарактеристики.Свойство("valueRestrictions") Тогда  
		
		ХарактеристикаОбъект.valueRestrictions.Очистить();
		
		Для Каждого Ограничение Из ДанныеХарактеристики.valueRestrictions Цикл 
			
			ХарактеристикаОбъект.limitingParameterId = Ограничение.limitingParameterId;						
			
			Для Каждого Значение Из Ограничение.limitedValues Цикл
				
				ИдЗначенияОграничения = Значение.limitingOptionValueId;
				
				Для Каждого Ид Из Значение.optionValueIds Цикл
					
					НСтр = ХарактеристикаОбъект.valueRestrictions.Добавить();
					НСтр.limitingOptionValueId = ИдЗначенияОграничения;
					НСтр.id = Ид;         
					
				КонецЦикла;
				
			КонецЦикла;
			
		КонецЦикла;
		
	КонецЕсли;
	
	Попытка
		ХарактеристикаОбъект.Записать();
	Исключение
		ИмяСобытия = ПолучитьИмяСобытия("СоздатьИлиОбновитьХарактеристику");
		Комментарий = "Не удалось записать характеристику категории: " + ХарактеристикаОбъект.Наименование + Символы.ПС
		+ ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());	
		Возврат Справочники.ИС_ЯМ_Характеристика.ПустаяСсылка();
	КонецПопытки;      
	
	Если ДанныеХарактеристики.Свойство("values") Тогда                                     			 
		
		Для Каждого Значение Из ДанныеХарактеристики.values Цикл
						
			СсылкаЗначение = Справочники.ИС_ЯМ_ЗначенияХарактеристик.НайтиПоКоду(Значение.id);	
			
			Если СсылкаЗначение.Пустая() Тогда
				ЗначениеОбъект = Справочники.ИС_ЯМ_ЗначенияХарактеристик.СоздатьЭлемент();
			Иначе										
				ЗначениеОбъект = СсылкаЗначение.ПолучитьОбъект();				
			КонецЕсли;
			
			ЗначениеОбъект.Код = Значение.id;
			ЗначениеОбъект.Наименование = Значение.value;  
			ЗначениеОбъект.Владелец = ХарактеристикаОбъект.Ссылка; 
			
			Отбор = Новый Структура();
			Отбор.Вставить("Категория", Категория);
			
			НайденноеЗначение = ЗначениеОбъект.Категории.НайтиСтроки(Отбор);
			
			Если НайденноеЗначение.Количество() = 0 Тогда
				
				НСтр = ЗначениеОбъект.Категории.Добавить();
				НСтр.Категория = Категория;				
				
			КонецЕсли;
			
			Попытка
				ЗначениеОбъект.Записать();
			Исключение
				ИмяСобытия = ПолучитьИмяСобытия("СоздатьИлиОбновитьХарактеристику");
				Комментарий = "Не удалось записать значение характеристики категории: " + ЗначениеОбъект.Наименование + Символы.ПС
				+ ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());		
			КонецПопытки;
			
		КонецЦикла;
				
	КонецЕсли;
	
	Возврат ХарактеристикаОбъект.Ссылка;

КонецФункции //- ИнфоСофт Стояк Ю.К. 24.05.2024 УА #65724 

//+ ИнфоСофт Стояк Ю.К. 24.05.2024 УА #65724
Процедура ОбновитьКатегорию(КатегорияСсылка, ХарактеристикаСсылка, Обязательная)
		
	Категория = КатегорияСсылка.ПолучитьОбъект(); 
	
	Отбор = Новый Структура();
	Отбор.Вставить("Характеристика", ХарактеристикаСсылка);
	
	НайденноеЗначение = Категория.properties.НайтиСтроки(Отбор);
	
	Если НайденноеЗначение.Количество() = 0 Тогда
		
		НСтр = Категория.properties.Добавить();
		НСтр.Характеристика = ХарактеристикаСсылка;
		НСтр.required = Обязательная;
		
	Иначе	
		Возврат;
	КонецЕсли;	
	
	Попытка
		Категория.Записать();
	Исключение
		ИмяСобытия = ПолучитьИмяСобытия("ОбновитьКатегорию");
		Комментарий = "Не удалось записать категорию: " + Категория.Наименование + Символы.ПС
			+ ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());		
	КонецПопытки; 
	
КонецПроцедуры //- ИнфоСофт Стояк Ю.К. 24.05.2024 УА #65724

