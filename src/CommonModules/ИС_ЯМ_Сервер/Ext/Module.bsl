	|	ИС_ЯМ_СоответствиеОсновныхРеквизитовТовара.ФиксированноеЗначение КАК ФиксированноеЗначение
	|ИЗ
	|	вт_ОсновныеРеквизитыТовара КАК вт_ОсновныеРеквизитыТовара
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ИС_ЯМ_СоответствиеОсновныхРеквизитовТовара КАК ИС_ЯМ_СоответствиеОсновныхРеквизитовТовара
	|		ПО вт_ОсновныеРеквизитыТовара.РеквизитТовара = ИС_ЯМ_СоответствиеОсновныхРеквизитовТовара.РеквизитТовара
	|			И (ИС_ЯМ_СоответствиеОсновныхРеквизитовТовара.Категория = &Категория)";

	РезультатЗапроса = Запрос.Выполнить();
	ТаблицаРеквизитов = РезультатЗапроса.Выгрузить();

	СоответствиеРеквизитовНоменклатуры = ИС_MP_ВыгрузкаКарточек.СоответствиеРеквизитовНоменклатуры();

	Для Каждого стр Из ТаблицаРеквизитов Цикл
		Если стр.ВидРеквизита1С = Перечисления.ИС_Ozon_ВидРеквизитаСопоставления.РеквизитНоменклатуры
			И СоответствиеРеквизитовНоменклатуры.Получить(стр.Реквизит1С) = Неопределено Тогда

			ИС_MP_ВыгрузкаКарточек.УдалитьСопоставлениеОсновногоРеквизита(Категория, стр.РеквизитТовара, "ИС_ЯМ_СоответствиеОсновныхРеквизитовТовара");
			стр.ВидРеквизита1С 	= Неопределено;
			стр.Реквизит1С 		= Неопределено;

		КонецЕсли;
	КонецЦикла;

	Возврат ТаблицаРеквизитов;

КонецФункции //- ИнфоСофт Стояк Ю.К. 27.05.2024 УА #65724

//+ ИнфоСофт Стояк Ю.К. 27.05.2024 УА #65724
Функция ТаблицаСоответствийЗначений(Категория, ХарактеристикаЯМ, ВидРеквизита1С, Реквизит1С) Экспорт

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Категория", Категория);
	Запрос.УстановитьПараметр("ХарактеристикаЯМ", ХарактеристикаЯМ);
	Запрос.УстановитьПараметр("ВидРеквизита1С", ВидРеквизита1С);
	Запрос.УстановитьПараметр("Реквизит1С", Реквизит1С);

	ИмяРеквизита 	= Неопределено;
	ТипРеквизита 	= Неопределено;

	Если ВидРеквизита1С = Перечисления.ИС_Ozon_ВидРеквизитаСопоставления.РеквизитНоменклатуры Тогда

		СтандартныеРеквизиты = Метаданные.Справочники["Номенклатура"].СтандартныеРеквизиты;
		Для Каждого Реквизит Из СтандартныеРеквизиты Цикл
			Если Реквизит.Имя = Реквизит1С Тогда
				ИмяРеквизита = Реквизит.Имя;
				ТипРеквизита = Реквизит.Тип;
				Прервать;
			КонецЕсли;
		КонецЦикла;

		Если ИмяРеквизита = Неопределено Тогда
			РеквизитыНоменклатуры = Метаданные.Справочники["Номенклатура"].Реквизиты;
			Для Каждого Реквизит Из РеквизитыНоменклатуры Цикл
				Если Реквизит.Синоним = Реквизит1С Тогда
					ИмяРеквизита = Реквизит.Имя;
					ТипРеквизита = Реквизит.Тип;
					Прервать;
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;

	ИначеЕсли ВидРеквизита1С = Перечисления.ИС_Ozon_ВидРеквизитаСопоставления.РеквизитХарактеристикиНоменклатуры Тогда

		СтандартныеРеквизиты = Метаданные.Справочники["ХарактеристикиНоменклатуры"].СтандартныеРеквизиты;
		Для Каждого Реквизит Из СтандартныеРеквизиты Цикл
			Если Реквизит.Имя = Реквизит1С Тогда
				ИмяРеквизита = Реквизит.Имя;
				ТипРеквизита = Реквизит.Тип;
				Прервать;
			КонецЕсли;
		КонецЦикла;

		Если ИмяРеквизита = Неопределено Тогда
			РеквизитыХарактеристики = Метаданные.Справочники["ХарактеристикиНоменклатуры"].Реквизиты;
			Для Каждого Реквизит Из РеквизитыХарактеристики Цикл
				Если Реквизит.Синоним = Реквизит1С Тогда
					ИмяРеквизита = Реквизит.Имя;
					ТипРеквизита = Реквизит.Тип;
					Прервать;
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;

	ИначеЕсли ВидРеквизита1С = Перечисления.ИС_Ozon_ВидРеквизитаСопоставления.ХарактеристикаНоменклатуры Тогда

		ТипРеквизита = Новый ОписаниеТипов("СправочникСсылка.ХарактеристикиНоменклатуры");
		ИмяРеквизита = "Ссылка";

	Иначе
		
		ТипРеквизита = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Реквизит1С, "ТипЗначения");
		ИмяРеквизита = "Значение";

	КонецЕсли;

	Если ИС_Ozon_Сервер.ЭтоПримитивныйТип(ТипРеквизита) Тогда

		Отбор = "ГДЕ ЗначенияВ1С.Свойство = &Реквизит1С";

		Если ВидРеквизита1С = Перечисления.ИС_Ozon_ВидРеквизитаСопоставления.РеквизитНоменклатуры Тогда
			ПолноеИмяОбъекта =  "Справочник.Номенклатура";
			Отбор = "ГДЕ НЕ ЗначенияВ1С.Ссылка.ПометкаУдаления";
		ИначеЕсли ВидРеквизита1С = Перечисления.ИС_Ozon_ВидРеквизитаСопоставления.ДопРеквизитНоменклатуры Тогда
			ПолноеИмяОбъекта =  "Справочник.Номенклатура.ДополнительныеРеквизиты";
		ИначеЕсли ВидРеквизита1С = Перечисления.ИС_Ozon_ВидРеквизитаСопоставления.ДопСвойствоНоменклатуры Тогда
			ПолноеИмяОбъекта =  "РегистрСведений.ДополнительныеСведения";
		ИначеЕсли ВидРеквизита1С = Перечисления.ИС_Ozon_ВидРеквизитаСопоставления.РеквизитХарактеристикиНоменклатуры Тогда
			ПолноеИмяОбъекта =  "Справочник.ХарактеристикиНоменклатуры";
			Отбор = "ГДЕ НЕ ЗначенияВ1С.Ссылка.ПометкаУдаления";
		ИначеЕсли ВидРеквизита1С = Перечисления.ИС_Ozon_ВидРеквизитаСопоставления.ДопРеквизитХарактеристикиНоменклатуры Тогда
			ПолноеИмяОбъекта =  "Справочник.ХарактеристикиНоменклатуры.ДополнительныеРеквизиты";
		КонецЕсли;

		Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
					   |	ЗначенияВ1С.ИмяРеквизита КАК ЗначениеВ1С
					   |ПОМЕСТИТЬ вт_ЗначенияВ1С
					   |ИЗ
					   | " + ПолноеИмяОбъекта + " КАК ЗначенияВ1С
												| " + Отбор + "
															  |;
															  |
															  |////////////////////////////////////////////////////////////////////////////////
															  |ВЫБРАТЬ РАЗРЕШЕННЫЕ
															  |	ИС_ЯМ_СоответствиеЗначенийХарактеристик.ЗначениеХарактеристикиЯМ КАК ЗначениеХарактеристикиЯМ,
															  |	вт_ЗначенияВ1С.ЗначениеВ1С КАК ЗначениеВ1С
															  |ИЗ
															  |	вт_ЗначенияВ1С КАК вт_ЗначенияВ1С
															  |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ИС_ЯМ_СоответствиеЗначенийХарактеристик КАК ИС_ЯМ_СоответствиеЗначенийХарактеристик
															  |		ПО вт_ЗначенияВ1С.ЗначениеВ1С = ИС_ЯМ_СоответствиеЗначенийХарактеристик.ЗначениеХарактеристики
															  |			И (ИС_ЯМ_СоответствиеЗначенийХарактеристик.Категория = &Категория)
															  |			И (ИС_ЯМ_СоответствиеЗначенийХарактеристик.ХарактеристикаЯМ = &ХарактеристикаЯМ)
															  |			И (ИС_ЯМ_СоответствиеЗначенийХарактеристик.ВидРеквизита1С = &ВидРеквизита1С)
															  |			И (ИС_ЯМ_СоответствиеЗначенийХарактеристик.Реквизит1С = &Реквизит1С)
															  |ГДЕ
															  |	НЕ вт_ЗначенияВ1С.ЗначениеВ1С ЕСТЬ null
															  |СГРУППИРОВАТЬ ПО
															  |	ИС_ЯМ_СоответствиеЗначенийХарактеристик.ЗначениеХарактеристикиЯМ,
															  |	вт_ЗначенияВ1С.ЗначениеВ1С
															  |
															  |УПОРЯДОЧИТЬ ПО
															  |	ЗначениеВ1С";

		Запрос.Текст = СтрЗаменить(Запрос.Текст, "ИмяРеквизита", ИмяРеквизита);

	Иначе   
		
 		ОбъектМетаданных 	= Метаданные.НайтиПоТипу(ТипРеквизита.Типы()[0]);
		ПолноеИмяОбъекта 	= ОбъектМетаданных.ПолноеИмя();
		ЭтоСправочник		= СтрНайти(ПолноеИмяОбъекта, "Справочник.") = 1;
		ЭтоПеречисление		= СтрНайти(ПолноеИмяОбъекта, "Перечисление.") = 1;

		Запрос.Текст =
		"ВЫБРАТЬ
		|	ИС_ЯМ_СоответствиеЗначенийХарактеристик.Категория КАК Категория,
		|	ИС_ЯМ_СоответствиеЗначенийХарактеристик.ХарактеристикаЯМ КАК ХарактеристикаЯМ,
		|	ИС_ЯМ_СоответствиеЗначенийХарактеристик.ЗначениеХарактеристикиЯМ КАК ЗначениеХарактеристикиЯМ,
		|	ИС_ЯМ_СоответствиеЗначенийХарактеристик.ВидРеквизита1С КАК ВидРеквизита1С,
		|	ИС_ЯМ_СоответствиеЗначенийХарактеристик.Реквизит1С КАК Реквизит1С,
		|	ИС_ЯМ_СоответствиеЗначенийХарактеристик.ЗначениеХарактеристики КАК ЗначениеХарактеристики,
		|	ИС_ЯМ_СоответствиеЗначенийХарактеристик.ЕдиницаИзмерения КАК ЕдиницаИзмерения
		|ИЗ
		|	РегистрСведений.ИС_ЯМ_СоответствиеЗначенийХарактеристик КАК ИС_ЯМ_СоответствиеЗначенийХарактеристик
		|ГДЕ
		|	ИС_ЯМ_СоответствиеЗначенийХарактеристик.Категория = &Категория
		|	И ИС_ЯМ_СоответствиеЗначенийХарактеристик.ХарактеристикаЯМ = &ХарактеристикаЯМ
		|	И ИС_ЯМ_СоответствиеЗначенийХарактеристик.ВидРеквизита1С = &ВидРеквизита1С
		|	И ИС_ЯМ_СоответствиеЗначенийХарактеристик.Реквизит1С = &Реквизит1С";
		РезультатЗапроса = Запрос.Выполнить().Выгрузить();
		РезультатЗапроса.Колонки.ЗначениеХарактеристики.Имя = "ЗначениеВРегистре";
		РезультатЗапроса.Колонки.Добавить("ЗначениеХарактеристики", ТипРеквизита);
		Для Каждого стр Из РезультатЗапроса Цикл
			Если ЭтоСправочник Тогда

				Если ЗначениеЗаполнено(стр.ЗначениеВРегистре) Тогда
					стр.ЗначениеХарактеристики = Справочники[ОбъектМетаданных.Имя].ПолучитьСсылку(
						Новый УникальныйИдентификатор(стр.ЗначениеВРегистре));
				КонецЕсли;

			ИначеЕсли ЭтоПеречисление Тогда

				Если ЗначениеЗаполнено(стр.ЗначениеВРегистре) Тогда
					стр.ЗначениеХарактеристики = Перечисления[ОбъектМетаданных.Имя].Получить(стр.ЗначениеВРегистре - 1);
				КонецЕсли;

			КонецЕсли;
		КонецЦикла;

		Отбор = "";
		Если ЭтоСправочник Тогда
			Отбор = "ГДЕ НЕ ЗначенияОбъекта.ПометкаУдаления ";
			Если ТипРеквизита.СодержитТип(Тип("СправочникСсылка.ЗначенияСвойствОбъектов")) Или ТипРеквизита.СодержитТип(
				Тип("СправочникСсылка.ЗначенияСвойствОбъектовИерархия")) Тогда
				Отбор = Отбор + "И ЗначенияОбъекта.Владелец = &Реквизит1С";
			ИначеЕсли ТипРеквизита.СодержитТип(Тип("СправочникСсылка.ХарактеристикиНоменклатуры")) Тогда
				Отбор = Отбор + "И ЗначенияОбъекта.ВидНоменклатуры = &Реквизит1С";
			КонецЕсли;
		КонецЕсли;

		Запрос.УстановитьПараметр("ТаблицаСоответствийЗначений", РезультатЗапроса);
		Запрос.Текст = "ВЫБРАТЬ
					   |	ТаблицаСоответствийЗначений.Категория КАК Категория,
					   |	ТаблицаСоответствийЗначений.ХарактеристикаЯМ КАК ХарактеристикаЯМ,
					   |	ТаблицаСоответствийЗначений.ЗначениеХарактеристикиЯМ КАК ЗначениеХарактеристикиЯМ,
					   |	ТаблицаСоответствийЗначений.ВидРеквизита1С КАК ВидРеквизита1С,
					   |	ТаблицаСоответствийЗначений.Реквизит1С КАК Реквизит1С,
					   |	ТаблицаСоответствийЗначений.ЗначениеВРегистре КАК ЗначениеВРегистре,
					   |	ТаблицаСоответствийЗначений.ЗначениеХарактеристики КАК ЗначениеХарактеристики,
					   |	ТаблицаСоответствийЗначений.ЕдиницаИзмерения КАК ЕдиницаИзмерения
					   |ПОМЕСТИТЬ вт_СоответствиеЗначенийХарактеристик
					   |ИЗ
					   |	&ТаблицаСоответствийЗначений КАК  ТаблицаСоответствийЗначений
					   |;
					   |
					   |////////////////////////////////////////////////////////////////////////////////
					   |ВЫБРАТЬ РАЗРЕШЕННЫЕ
					   |	ИС_ЯМ_СоответствиеЗначенийХарактеристик.ЗначениеХарактеристикиЯМ КАК ЗначениеХарактеристикиЯМ,
					   |	ЗначенияОбъекта.Ссылка КАК ЗначениеВ1С
					   |ИЗ
					   |	" + ПолноеИмяОбъекта + " КАК ЗначенияОбъекта
												   |		ЛЕВОЕ СОЕДИНЕНИЕ вт_СоответствиеЗначенийХарактеристик КАК ИС_ЯМ_СоответствиеЗначенийХарактеристик
												   |		ПО ЗначенияОбъекта.Ссылка = ИС_ЯМ_СоответствиеЗначенийХарактеристик.ЗначениеХарактеристики
												   | " + Отбор + " 								
																 |СГРУППИРОВАТЬ ПО
																 |	ИС_ЯМ_СоответствиеЗначенийХарактеристик.ЗначениеХарактеристикиЯМ,
																 |	ЗначенияОбъекта.Ссылка
																 |
																 |УПОРЯДОЧИТЬ ПО
																 |	ЗначениеВ1С";

	КонецЕсли;

	РезультатЗапроса = Запрос.Выполнить();

	Возврат РезультатЗапроса.Выгрузить();

КонецФункции //- ИнфоСофт Стояк Ю.К. 27.05.2024 УА #65724

//+ ИнфоСофт Стояк Ю.К. 27.05.2024 УА #65724
Функция ЗначенияХарактеристикЯМИзСтроки(ЗначенияСтрокой) Экспорт

	Результат = Новый Массив;

	МассивСтрок = СтрРазделить(ЗначенияСтрокой, ";", Ложь);
	Для Каждого стр Из МассивСтрок Цикл
		Если СтрДлина(стр) = 36 Тогда
			ЗначениеХарактеристики = Справочники.ИС_ЯМ_ЗначенияХарактеристик.ПолучитьСсылку(
				Новый УникальныйИдентификатор(стр));
			Если ЗначениеЗаполнено(ЗначениеХарактеристики) Тогда
				Результат.Добавить(ЗначениеХарактеристики);
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;

	Возврат Результат;

КонецФункции //- ИнфоСофт Стояк Ю.К. 27.05.2024 УА #65724

//+ ИнфоСофт Стояк Ю.К. 27.05.2024 УА #65724
Функция ТекстКоличествоСопоставленныхЗначений(Категория, ХарактеристикаЯМ, ВидРеквизита1С, Реквизит1С,
	ТребуетсяСопоставление) Экспорт

	Если Не ТребуетсяСопоставление Тогда
		Возврат "Сопоставление не требуется";
	КонецЕсли;

	Результат = "Сопоставлено 0 из 0";

	Если ЗначениеЗаполнено(Реквизит1С) Тогда

		Запрос = Новый Запрос;
		Запрос.Текст =
		"ВЫБРАТЬ
		|	ТаблицаСоответствийЗначений.ЗначениеВ1С КАК ЗначениеВ1С,
		|	ТаблицаСоответствийЗначений.ЗначениеХарактеристикиЯМ КАК ЗначениеХарактеристикиЯМ
		|ПОМЕСТИТЬ вт_Значения
		|ИЗ
		|	&ТаблицаСоответствийЗначений КАК  ТаблицаСоответствийЗначений
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ вт_Значения.ЗначениеВ1С) КАК Всего,
		|	КОЛИЧЕСТВО(вт_Значения.ЗначениеХарактеристикиЯМ) КАК Сопоставлено
		|ИЗ
		|	вт_Значения КАК вт_Значения";

		Запрос.УстановитьПараметр("ТаблицаСоответствийЗначений", ТаблицаСоответствийЗначений(Категория,
			ХарактеристикаЯМ, ВидРеквизита1С, Реквизит1С));

		РезультатЗапроса = Запрос.Выполнить();

		Выборка = РезультатЗапроса.Выбрать();
		Если Выборка.Следующий() Тогда
			Результат = СтрШаблон("Сопоставлено %1 из %2", ?(Выборка.Сопоставлено = Null, 0, Выборка.Сопоставлено),
				Выборка.Всего);
		КонецЕсли;
	КонецЕсли;

	Возврат Результат;

КонецФункции //- ИнфоСофт Стояк Ю.К. 27.05.2024 УА #65724

//+ ИнфоСофт Стояк Ю.К. 27.05.2024 УА #65724
Процедура УдалитьСопоставлениеХарактеристики(Категория, ХарактеристикаЯМ) Экспорт

	НаборЗаписей = РегистрыСведений.ИС_ЯМ_СоответствиеЗначенийХарактеристик.СоздатьНаборЗаписей();
	НаборЗаписей.Отбор.Категория.Установить(Категория);
	НаборЗаписей.Отбор.ХарактеристикаЯМ.Установить(ХарактеристикаЯМ);
	НаборЗаписей.Прочитать();
	НаборЗаписей.Очистить();
	НаборЗаписей.Записать(Истина);

КонецПроцедуры //- ИнфоСофт Стояк Ю.К. 27.05.2024 УА #65724

//+ ИнфоСофт Стояк Ю.К. 27.05.2024 УА #65724
Процедура ДобавитьСопоставлениеХарактеристики(Категория, ХарактеристикаЯМ, ВидРеквизита1С, Реквизит1С,
	ФиксированноеЗначение, ЕдиницаИзмерения) Экспорт

	НаборЗаписей = РегистрыСведений.ИС_ЯМ_СоответствиеЗначенийХарактеристик.СоздатьНаборЗаписей();
	НаборЗаписей.Отбор.Категория.Установить(Категория);
	НаборЗаписей.Отбор.ХарактеристикаЯМ.Установить(ХарактеристикаЯМ);
	НаборЗаписей.Прочитать();
	НаборЗаписей.Очистить();

	ЗаписьНабора = НаборЗаписей.Добавить();
	ЗаписьНабора.Категория 				= Категория;
	ЗаписьНабора.ХарактеристикаЯМ 		= ХарактеристикаЯМ;
	ЗаписьНабора.ВидРеквизита1С 		= ВидРеквизита1С;
	ЗаписьНабора.Реквизит1С 			= Реквизит1С;
	ЗаписьНабора.ФиксированноеЗначение 	= ФиксированноеЗначение;
	ЗаписьНабора.ЕдиницаИзмерения 		= ЕдиницаИзмерения;
	НаборЗаписей.Записать(Истина);

КонецПроцедуры //- ИнфоСофт Стояк Ю.К. 27.05.2024 УА #65724

