КонецПроцедуры //- ИнфоСофт Ивонин К.А. 02.10.23 УА #64020

//+ ИнфоСофт Стояк Ю.К. 03.03.2025 УА #88575
Процедура СоздатьОбъектСклада(Профиль, Данные, ДанныеОсновногоСкладаГруппы = Неопределено, НазваниеГруппы = Неопределено)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	ИС_ЯМ_Склады.Ссылка КАК Ссылка,
	|	ИС_ЯМ_Склады.Наименование КАК Наименование
	|ИЗ
	|	Справочник.ИС_ЯМ_Склады КАК ИС_ЯМ_Склады
	|ГДЕ
	|	ИС_ЯМ_Склады.id = &id
	|	И ИС_ЯМ_Склады.ЛичныйКабинет = &Профиль";
	
	Запрос.УстановитьПараметр("Профиль", Профиль);
	Запрос.УстановитьПараметр("id", Данные.id);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаСклад = РезультатЗапроса.Выбрать();
	
	Если ВыборкаСклад.Следующий() Тогда
		
		Если ВыборкаСклад.Наименование <> Данные.name Тогда
			СкладОбъект = ВыборкаСклад.Ссылка.ПолучитьОбъект();			
		Иначе
			Возврат;
		КонецЕсли;
		
	Иначе
		СкладОбъект = Справочники.ИС_ЯМ_Склады.СоздатьЭлемент();		
	КонецЕсли;
	
	СкладОбъект.ЛичныйКабинет = Профиль;
	СкладОбъект.Наименование = Данные.name;
	СкладОбъект.id = Данные.id;
	СкладОбъект.ИспользоватьВЗаказах = Истина;
	
	Если ТипЗнч(ДанныеОсновногоСкладаГруппы) = Тип("Структура") Тогда
		
		СкладОбъект.ИДМагазинаОсновногоСкладаГруппы = ДанныеОсновногоСкладаГруппы.campaignId;
		СкладОбъект.ИДОсновногоСкладаГруппы = ДанныеОсновногоСкладаГруппы.id;
		СкладОбъект.НаименованиеГруппыСкладов = НазваниеГруппы;
		
	КонецЕсли;
	
	Попытка
		СкладОбъект.Записать();	
	Исключение
		ОбщегоНазначения.СообщитьПользователю(ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));	
	КонецПопытки;
	
КонецПроцедуры //- ИнфоСофт Стояк Ю.К. 03.03.2025 УА #88575

