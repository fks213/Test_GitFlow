Функция ПолучитьТаблицуТоваровНабора(ТоварыЗаказа) Экспорт
	
	Запрос = Новый Запрос;		
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ТоварыВзаказе.Сумма КАК Сумма,
	|	ТоварыВзаказе.Номенклатура КАК Номенклатура,
	|	ТоварыВзаказе.Характеристика КАК Характеристика,
	|	ТоварыВзаказе.Цена КАК Цена,
	|	ТоварыВзаказе.Количество КАК Количество
	|ПОМЕСТИТЬ ВТ_ТоварыВЗаказе
	|ИЗ
	|	&ТоварыВзаказе КАК ТоварыВзаказе
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	СУММА(ВариантыКомплектацииНоменклатурыТовары.ДоляСтоимости) КАК ОбщаяДоляСтоимости,
	|	СУММА(1) КАК Количество,
	|	ВТ_ТоварыВЗаказе.Сумма КАК Сумма,
	|	ВТ_ТоварыВЗаказе.Цена КАК Цена,
	|	ВТ_ТоварыВЗаказе.Номенклатура КАК Набор,
	|	ВТ_ТоварыВЗаказе.Характеристика КАК Характеристика,
	|	МАКСИМУМ(ВТ_ТоварыВЗаказе.Количество) КАК КоличествоВЗаказе
	|ПОМЕСТИТЬ ВТ_Количество
	|ИЗ
	|	ВТ_ТоварыВЗаказе КАК ВТ_ТоварыВЗаказе
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ВариантыКомплектацииНоменклатуры.Товары КАК ВариантыКомплектацииНоменклатурыТовары
	|		ПО ВТ_ТоварыВЗаказе.Номенклатура = ВариантыКомплектацииНоменклатурыТовары.Ссылка.Владелец
	|			И ВТ_ТоварыВЗаказе.Характеристика = ВариантыКомплектацииНоменклатурыТовары.Ссылка.Характеристика
	|
	|СГРУППИРОВАТЬ ПО
	|	ВТ_ТоварыВЗаказе.Номенклатура,
	|	ВТ_ТоварыВЗаказе.Характеристика,
	|	ВТ_ТоварыВЗаказе.Сумма,
	|	ВТ_ТоварыВЗаказе.Цена
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВариантыКомплектацииНоменклатурыТовары.Номенклатура КАК Номенклатура,
	|	ВариантыКомплектацииНоменклатурыТовары.Характеристика КАК Характеристика,
	|	ВариантыКомплектацииНоменклатурыТовары.ДоляСтоимости КАК ДоляСтоимости,
	|	ЕСТЬNULL(ВариантыКомплектацииНоменклатурыТовары.Количество, 1) * ВТ_Количество.КоличествоВЗаказе КАК Количество,
	|	ВТ_Количество.ОбщаяДоляСтоимости КАК ОбщаяДоляСтоимости,
	|	ВТ_Количество.Количество КАК КоличествоОбщее,
	|	ВТ_Количество.Набор КАК Набор,
	|	ВТ_Количество.Сумма КАК Сумма,
	|	ВТ_Количество.Цена КАК Цена,
	|	ВариантыКомплектацииНоменклатурыТовары.Ссылка.ВариантРасчетаЦеныНабора КАК ВариантРасчетаЦеныНабора
	|ИЗ
	|	ВТ_Количество КАК ВТ_Количество
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ВариантыКомплектацииНоменклатуры.Товары КАК ВариантыКомплектацииНоменклатурыТовары
	|		ПО ВТ_Количество.Набор = ВариантыКомплектацииНоменклатурыТовары.Ссылка.Владелец
	|			И ВТ_Количество.Характеристика = ВариантыКомплектацииНоменклатурыТовары.Ссылка.Характеристика
	//+ ИнфоСофт Стояк Ю.К. 19.03.2024 УА #72423	
	|
	|УПОРЯДОЧИТЬ ПО
	|	Номенклатура"; 
	//- ИнфоСофт Стояк Ю.К. 19.03.2024 УА #72423
	
	Запрос.УстановитьПараметр("ТоварыВзаказе", ТоварыЗаказа);
	РезультатЗапроса = Запрос.Выполнить();
	
	Возврат РезультатЗапроса.Выгрузить();
	
КонецФункции //- ИнфоСофт Сумин Д.В. 26.04.2023 УА #58166

//+ ИнфоСофт Мурсалимов Д.Р. 05.09.24 УА #82005
Функция ДобавитьСопоставление(ТаблицаТранзакций, Профиль) Экспорт
	
	ТекстЗапроса =
	"ВЫБРАТЬ
	|	ТаблицаТранзакций.НаименованиеТовара КАК НаименованиеТовара,
	|	ТаблицаТранзакций.SKU КАК SKU,
	|	ТаблицаТранзакций.ЦенаПродавца КАК ЦенаПродавца,
	|	ТаблицаТранзакций.ЦенаРеализация КАК ЦенаРеализация,
	|	ТаблицаТранзакций.Количество КАК Количество,
	|	ТаблицаТранзакций.РеализованоНаСумму КАК РеализованоНаСумму,
	|	ТаблицаТранзакций.ВозвратЦенаРеализации КАК ВозвратЦенаРеализации,
	|	ТаблицаТранзакций.ВозвратКоличество КАК ВозвратКоличество,
	|	ТаблицаТранзакций.ВозвращеноНаСумму КАК ВозвращеноНаСумму
	|ПОМЕСТИТЬ втТаблицаТранзакций
	|ИЗ
	|	&ТаблицаТранзакций КАК ТаблицаТранзакций
	|;
	|  
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	втТаблицаТранзакций.SKU КАК SKU,
	|	МАКСИМУМ(ИС_ЯМ_СоответствиеХарактеристик.Номенклатура) КАК Номенклатура,
	|	МАКСИМУМ(ИС_ЯМ_СоответствиеХарактеристик.Характеристика) КАК Характеристика,
	|	МАКСИМУМ(ВЫБОР
	|			КОГДА ИС_ЯМ_СоответствиеХарактеристик.Номенклатура.ТипНоменклатуры = ЗНАЧЕНИЕ(Перечисление.ТипыНоменклатуры.Набор)
	|				ТОГДА ИСТИНА
	|			ИНАЧЕ ЛОЖЬ
	|		КОНЕЦ) КАК ЭтоНабор, 
	|	МАКСИМУМ(ИС_ЯМ_СоответствиеХарактеристик.Упаковка) КАК Упаковка,
	|	МАКСИМУМ(ВЫБОР
	|		КОГДА ИС_ЯМ_СоответствиеХарактеристик.Упаковка ЕСТЬ NULL ИЛИ ИС_ЯМ_СоответствиеХарактеристик.Упаковка.Числитель = 0
	|			ТОГДА 1
	|		ИНАЧЕ ИС_ЯМ_СоответствиеХарактеристик.Упаковка.Числитель
	|	КОНЕЦ / ВЫБОР
	|		КОГДА ИС_ЯМ_СоответствиеХарактеристик.Упаковка ЕСТЬ NULL ИЛИ ИС_ЯМ_СоответствиеХарактеристик.Упаковка.Знаменатель = 0
	|			ТОГДА 1
	|		ИНАЧЕ ИС_ЯМ_СоответствиеХарактеристик.Упаковка.Знаменатель
	|	КОНЕЦ) КАК КоэффициентУпаковки
	|ПОМЕСТИТЬ ВТ_Номенклатура
	|ИЗ
	|	втТаблицаТранзакций КАК втТаблицаТранзакций
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ИС_ЯМ_СоответствиеХарактеристик КАК ИС_ЯМ_СоответствиеХарактеристик
	|		ПО (втТаблицаТранзакций.SKU = ИС_ЯМ_СоответствиеХарактеристик.НоменклатураЯМ.shopSku
	|				И ИС_ЯМ_СоответствиеХарактеристик.НоменклатураЯМ.Профиль = &Профиль)
	|
	|СГРУППИРОВАТЬ ПО
	|	втТаблицаТранзакций.SKU 
	|;
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_Номенклатура.Номенклатура КАК Номенклатура,
	|	ВТ_Номенклатура.Характеристика КАК ХарактеристикаНоменклатуры,
	|	ВТ_Номенклатура.ЭтоНабор КАК ЭтоНабор,
	|	ВТ_Номенклатура.SKU КАК SKU,
	|	ВТ_Номенклатура.Упаковка КАК Упаковка,
	|	ВТ_Номенклатура.КоэффициентУпаковки КАК КоэффициентУпаковки,
	|	втТаблицаТранзакций.НаименованиеТовара КАК НаименованиеТовара,
	|	втТаблицаТранзакций.ЦенаПродавца КАК ЦенаПродавца,
	|	втТаблицаТранзакций.ЦенаРеализация КАК ЦенаРеализация,
	|	втТаблицаТранзакций.Количество КАК Количество,
	|	втТаблицаТранзакций.РеализованоНаСумму КАК РеализованоНаСумму,
	|	втТаблицаТранзакций.ВозвратЦенаРеализации КАК ВозвратЦенаРеализации,
	|	втТаблицаТранзакций.ВозвратКоличество КАК ВозвратКоличество,
	|	втТаблицаТранзакций.ВозвращеноНаСумму КАК ВозвращеноНаСумму
	|ИЗ
	|	втТаблицаТранзакций КАК втТаблицаТранзакций
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_Номенклатура КАК ВТ_Номенклатура
	|		ПО втТаблицаТранзакций.SKU = ВТ_Номенклатура.SKU";
	
	Запрос = Новый Запрос;
	
	Запрос.УстановитьПараметр("Профиль", 			Профиль);
	Запрос.УстановитьПараметр("ТаблицаТранзакций", 	ТаблицаТранзакций);		
	
	Запрос.Текст = ТекстЗапроса;
	
	РезультатЗапроса = Запрос.Выполнить().Выгрузить(); 
	
	Возврат РезультатЗапроса;

КонецФункции //- ИнфоСофт Мурсалимов Д.Р. 05.09.24 УА #82005 

//+ ИнфоСофт Стояк Ю.К. 04.05.2023 УА #58008
Функция СоздатьДокументОтчетКомиссионера(Профиль, Период, ТаблицаТранзакций, Комментарий, СтруктураПараметров = Неопределено) Экспорт
	
	УстановитьПривилегированныйРежим(Истина);
	Событие = "Создание отчета комиссионеров";

	ФукнциональныеОпции = ПолучитьНастройкиФункциональностиСборочныхЗвданий(Профиль);

	Если Не ЗначениеЗаполнено(ФукнциональныеОпции.КонтрагентЯМ) Тогда

		ТекстСообщения = СтрШаблон(
			"Не заполнен контрагент в настройках ЯМ для аккаунта: %1. Документ отчет комиссионера не создан.",
			Профиль);
		ИС_MP_Сервер.ЗаписатьВЖРИСообщитьПользователю(Событие, ТекстСообщения);
		ОбщегоНазначения.СообщитьПользователю(ТекстСообщения);
		Возврат Неопределено;

	КонецЕсли;

	ХозОперация = ПредопределенноеЗначение("Перечисление.ХозяйственныеОперации.ПередачаНаКомиссию");

	ИспользоватьДоговорыСКлиентами = ПолучитьФункциональнуюОпцию("ИспользоватьДоговорыСКлиентами");
	Если ИспользоватьДоговорыСКлиентами Тогда

		Если ЗначениеЗаполнено(ФукнциональныеОпции.ДоговорЯМ) Тогда

			Если Не Общегоназначения.ЗначениеРеквизитаОбъекта(ФукнциональныеОпции.ДоговорЯМ, "ХозяйственнаяОперация") = ХозОперация Тогда

				ТекстСообщения = СтрШаблон(
					"В выбранный договор контрагента в настройках ЯМ для аккаунта: %1 имеет хозяйственную операцию отличающуюся от ""Передача на комиссию"". Документ отчет комиссионера не создан.",
					Профиль);
				ИС_MP_Сервер.ЗаписатьВЖРИСообщитьПользователю(Событие, ТекстСообщения);
				ОбщегоНазначения.СообщитьПользователю(ТекстСообщения);
				Возврат Неопределено;

			КонецЕсли;

		Иначе

			ТекстСообщения = СтрШаблон(
				"Не заполнен договор контрагента в настройках ЯМ для аккаунта: %1. Документ отчет комиссионера не создан.",
				Профиль);
			ИС_MP_Сервер.ЗаписатьВЖРИСообщитьПользователю(Событие, ТекстСообщения);
			ОбщегоНазначения.СообщитьПользователю(ТекстСообщения);
			Возврат Неопределено;

		КонецЕсли;
	КонецЕсли;

	ИспользоватьСоглашенияСКлиентами = ПолучитьФункциональнуюОпцию("ИспользоватьСоглашенияСКлиентами");
	Если ИспользоватьСоглашенияСКлиентами Тогда

		Если ЗначениеЗаполнено(ФукнциональныеОпции.СоглашениеЯМ) Тогда

			Если Не Общегоназначения.ЗначениеРеквизитаОбъекта(ФукнциональныеОпции.СоглашениеЯМ, "ХозяйственнаяОперация") = ХозОперация Тогда

				ТекстСообщения = СтрШаблон(
					"В выбранное соглашение с клиентом в настройках ЯМ для аккаунта: %1 имеет хозяйственную операцию отличающуюся от ""Передача на комиссию"". Документ отчет комиссионера не создан.",
					Профиль);
				ИС_MP_Сервер.ЗаписатьВЖРИСообщитьПользователю(Событие, ТекстСообщения);
				ОбщегоНазначения.СообщитьПользователю(ТекстСообщения);
				Возврат Неопределено;

			КонецЕсли;

		Иначе

			ТекстСообщения = СтрШаблон(
				"Не заполнено соглашение с клиентом в настройках ЯМ для аккаунта: %1. Документ отчет комиссионера не создан.",
				Профиль);
			ИС_MP_Сервер.ЗаписатьВЖРИСообщитьПользователю(Событие, ТекстСообщения);
			ОбщегоНазначения.СообщитьПользователю(ТекстСообщения);
			Возврат Неопределено;

		КонецЕсли;

	КонецЕсли;  
	
	ОбъектОтчетКомиссионера = Документы["ОтчетКомиссионера"].СоздатьДокумент();
	
	ОбъектОтчетКомиссионера.Дата 			= Период.ДатаОкончания;
	ОбъектОтчетКомиссионера.НачалоПериода 	= Период.ДатаНачала;
	ОбъектОтчетКомиссионера.КонецПериода 	= Период.ДатаОкончания;
	ОбъектОтчетКомиссионера.Комментарий		= Комментарий;
	
	//+ ИнфоСофт Стояк Ю.К. 12.08.2024 УА #81449                                   
	ИспользоватьПодразделения = ПолучитьФункциональнуюОпцию("ИспользоватьПодразделения");
	
	Если ИспользоватьПодразделения Тогда		
		ОбъектОтчетКомиссионера.Подразделение = ФукнциональныеОпции.ПодразделениеЯМ;
	КонецЕсли;
	//- ИнфоСофт Стояк Ю.К. 12.08.2024 УА #81449
	
	ДанныеЗаполнения = Новый Структура;
	ДанныеЗаполнения.Вставить("Организация", ФукнциональныеОпции.Организация);
	ДанныеЗаполнения.Вставить("Партнер", ФукнциональныеОпции.ПартнерЯМ);
	ДанныеЗаполнения.Вставить("Контрагент", ФукнциональныеОпции.КонтрагентЯМ);
	ДанныеЗаполнения.Вставить("Договор", ФукнциональныеОпции.ДоговорЯМ);
	//+ ИнфоСофт Сумин Д.В. 19.04.2024 УА #72638
	Если ИспользоватьСоглашенияСКлиентами Тогда
		ДанныеЗаполнения.Вставить("Соглашение", ФукнциональныеОпции.СоглашениеЯМ); 
		ДанныеЗаполнения.Вставить("ЗаполнятьПоСоглашению", Истина); 
	//+ ИнфоСофт Стояк Ю.К. 25.06.2024 УА #78446	
	Иначе
		ДанныеЗаполнения.Вставить("Соглашение", Неопределено); 
	//- ИнфоСофт Стояк Ю.К. 25.06.2024 УА #78446
	КонецЕсли; 
	//ДанныеЗаполнения.Вставить("Соглашение", ФукнциональныеОпции.СоглашениеЯМ);
	//ДанныеЗаполнения.Вставить("ЗаполнятьПоСоглашению", Истина);
	//- ИнфоСофт Сумин Д.В. 19.04.2024 УА #72638
	ДанныеЗаполнения.Вставить("КонецПериода", Период.ДатаОкончания);
	ОбъектОтчетКомиссионера.Заполнить(ДанныеЗаполнения);
	
	ПроцентНДС = ЦенообразованиеКлиентСервер.ПолучитьСтавкуНДСЧислом(ОбъектОтчетКомиссионера.СтавкаНДСВознаграждения);	

	ОбъектОтчетКомиссионера.СпособРасчетаВознаграждения = ПредопределенноеЗначение(
		"Перечисление.СпособыРасчетаКомиссионногоВознаграждения.НеРассчитывается");
	ОбъектОтчетКомиссионера.ПроцентВознаграждения  		= 0;
	
	//+ ИнфоСофт Тимофеева А.А. 09.04.2025 УА #97340
	НастройкиУчета = УчетНДСУП.ПараметрыУчетаПоОрганизации(Профиль.Организация, ТекущаяДатаСеанса());
	ОбъектОтчетКомиссионера.НалогообложениеНДС = НастройкиУчета.ОсновноеНалогообложениеНДСПродажи;
	//- ИнфоСофт Тимофеева А.А. 09.04.2025 УА #97340
	
	//+ ИнфоСофт Стояк Ю.К. 31.05.2024 УА #74897
	ЗаполнитьТЧОтчетаКомиссионера(ОбъектОтчетКомиссионера, ТаблицаТранзакций, СтруктураПараметров);
	//ЗаполнитьТЧОтчетаКомиссионера(ОбъектОтчетКомиссионера, ТаблицаТранзакций);
	//- ИнфоСофт Стояк Ю.К. 31.05.2024 УА #74897

	СтруктураДействий = Новый Структура;
	СтруктураДействий.Вставить("ПересчитатьКоличествоЕдиниц");
	СтруктураДействий.Вставить("ЗаполнитьСтавкуНДС", Новый Структура("Организация, НалогообложениеНДС, Дата",
		ОбъектОтчетКомиссионера.Организация, ОбъектОтчетКомиссионера.НалогообложениеНДС, ОбъектОтчетКомиссионера.Дата));
	СтруктураДействий.Вставить("ПересчитатьСуммуНДС",
		ОбработкаТабличнойЧастиКлиентСервер.ПараметрыПересчетаСуммыНДСВСтрокеТЧ(ОбъектОтчетКомиссионера));
	СтруктураДействий.Вставить("ПересчитатьСумму");
	СтруктураДействий.Вставить("ПересчитатьСуммуСНДС", Новый Структура("ЦенаВключаетНДС",
		ОбъектОтчетКомиссионера.ЦенаВключаетНДС));	
	СтруктураДействий.Вставить("ПересчитатьСуммуПродажиНДС");
	ОбработкаТабличнойЧастиСервер.ОбработатьТЧ(ОбъектОтчетКомиссионера.Товары, СтруктураДействий, Неопределено);

	ОбъектОтчетКомиссионера.СуммаВознаграждения = ОбъектОтчетКомиссионера.Товары.Итог("СуммаВознаграждения");
	ОбъектОтчетКомиссионера.СуммаНДСВознаграждения = Окр(ОбъектОтчетКомиссионера.СуммаВознаграждения * ПроцентНДС
		/ (100 + ПроцентНДС), 2, РежимОкругления.Окр15как20);
		
	//+ ИнфоСофт Мурсалимов Д.Р. 04.02.24 УА #62781
	ОбъектОтчетКомиссионера.ПорядокРасчетов = ВзаиморасчетыСервер.ПорядокРасчетов(,, ДанныеЗаполнения.Соглашение, ДанныеЗаполнения.Договор);	
	//- ИнфоСофт Мурсалимов Д.Р. 04.02.24 УА #62781	
		
	Попытка

		ОбъектОтчетКомиссионера.Записать(РежимЗаписиДокумента.Проведение);

	Исключение

		ТекстСообщения = СтрШаблон("Не удалось провести документ отчет комиссионера: %1%2", Символы.ПС,
			ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		ОбщегоНазначения.СообщитьПользователю(ТекстСообщения);

		Попытка
			ОбъектОтчетКомиссионера.Записать(РежимЗаписиДокумента.Запись);
		Исключение
			ТекстСообщения = СтрШаблон("Не удалось записать документ отчет комиссионера: %1%2", Символы.ПС,
				ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
			ОбщегоНазначения.СообщитьПользователю(ТекстСообщения);
		КонецПопытки;

	КонецПопытки;        
	
	Возврат ОбъектОтчетКомиссионера.Ссылка;
	
КонецФункции //- ИнфоСофт Стояк Ю.К. 04.05.2023 УА #58008

//+ ИнфоСофт Стояк Ю.К. 04.05.2023 УА #58008
Процедура ЗаполнитьТЧОтчетаКомиссионера(ОтчетКомиссионера, ТаблицаТранзакций, СтруктураПараметров = Неопределено)
	
	//+ ИнфоСофт Стояк Ю.К. 30.05.2024 УА #74897
	Если ЗначениеЗаполнено(СтруктураПараметров) И СтруктураПараметров.Свойство("СпособРасчетаЦеныВозврата") Тогда
		
		ЦеныВозвратаПоВидуЦен = ?(СтруктураПараметров.СпособРасчетаЦеныВозврата.СпособРасчета = 1, Истина, Ложь);
	
		ВидЦены = СтруктураПараметров.СпособРасчетаЦеныВозврата.ВидЦены; 
		
	Иначе
		
		ЦеныВозвратаПоВидуЦен = Ложь;		
		
	КонецЕсли; 
	//- ИнфоСофт Стояк Ю.К. 30.05.2024 УА #74897
	//+ ИнфоСофт Стояк Ю.К. 27.02.2025 УА #94609
	МассивПараметров = ПолучитьСписокПараметровЦен();
	Результат = ИС_MP_Сервер.ПолучитьЗначениеНастроек(СтруктураПараметров.Профиль, Перечисления.ИС_МП_Маркетплейсы.ЯМ, МассивПараметров);	
	СтруктураЦен = ПолучитьСтруктуруПараметровЦен();
	ЗаполнитьЗначенияСвойств(СтруктураЦен, Результат);
	//- ИнфоСофт Стояк Ю.К. 27.02.2025 УА #94609
	ОтчетКомиссионера.Товары.Очистить();
	ОтчетКомиссионера.ВидыЗапасов.Очистить();
	Для Каждого Транзакция Из ТаблицаТранзакций Цикл
		
		//+ ИнфоСофт Заварин К.В. 19.09.24 УА #83149
		Если СтруктураПараметров.ЗаполнитьКолонкуПокупательЯМ И Не Транзакция = Неопределено Тогда
			
			//+ ИнфоСофт Власова И.С. 10.12.24 УА #87450
			//Покупатель = ?(ЗначениеЗаполнено(ОтчетКомиссионера.Контрагент), ОтчетКомиссионера.Контрагент, Справочники.Контрагенты.ПустаяСсылка());
			Покупатель = СтруктураПараметров.РозничныйПокупательЯМ;
			//- ИнфоСофт Власова И.С. 10.12.24 УА #87450
			
			Если ЗначениеЗаполнено(Транзакция.ИннПокупателя) Тогда
				Покупатель = Справочники.Контрагенты.НайтиПоРеквизиту("ИНН", Транзакция.ИннПокупателя);
			КонецЕсли;
				
		КонецЕсли;                     
		//- ИнфоСофт Заварин К.В. 19.09.24 УА #83149
		
		Если Транзакция.ЭтоНабор Тогда
			РеквизитыНоменклатуры = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Транзакция.Номенклатура,
				"ТипНоменклатуры, ВидНоменклатуры");

			Если Транзакция.Количество > 0 Тогда
				
				ПараметрыКомплектующих = ПодборТоваровКлиентСервер.ПараметрыТовара();
				ПараметрыКомплектующих.Номенклатура   		= Транзакция.Номенклатура;
				ПараметрыКомплектующих.НоменклатураНабора   = Транзакция.Номенклатура;
				ПараметрыКомплектующих.ХарактеристикаНабора = Транзакция.ХарактеристикаНоменклатуры;				
				ПараметрыКомплектующих.КоличествоУпаковок	= Транзакция.Количество;
				ПараметрыКомплектующих.ТипНоменклатуры 		= РеквизитыНоменклатуры.ТипНоменклатуры;
				ПараметрыКомплектующих.ВидНоменклатуры 		= РеквизитыНоменклатуры.ВидНоменклатуры;
				ПараметрыКомплектующих.ЭтоТовар 			= Истина;
				ПараметрыКомплектующих.Вставить("ВариантКомплектацииНоменклатуры", Неопределено);
	
				Склады = Новый Массив;
	
				ДополнительныеПараметры = Новый Структура;
				ДополнительныеПараметры.Вставить("Дата", 		ОтчетКомиссионера.Дата);
				ДополнительныеПараметры.Вставить("Валюта", 		ОтчетКомиссионера.Валюта);
				ДополнительныеПараметры.Вставить("Склады", 		Склады);
				ДополнительныеПараметры.Вставить("Соглашение", 	ОтчетКомиссионера.Соглашение);
				ДополнительныеПараметры.Вставить("Цена", 		Транзакция.ЦенаПродавца);
				//+ ИнфоСофт Сумин Д.В. 21.08.2023 УА #61252	
				//+ ИнфоСофт Власова И.С. 25.03.25 УА #96707
				//ДополнительныеПараметры.Вставить("СуммаПродажиКРаспределению", Транзакция.ЦенаПродавца);
				//+ ИнфоСофт Заварин К.В. 10.04.25 УА #98479
				//ДополнительныеПараметры.Вставить("СуммаПродажиКРаспределению", Транзакция.ЦенаРеализация); 
				ДополнительныеПараметры.Вставить("СуммаПродажиКРаспределению", Транзакция.РеализованоНаСумму);
				//- ИнфоСофт Заварин К.В. 10.04.25 УА #98479
				//- ИнфоСофт Власова И.С. 25.03.25 УА #96707
				ДополнительныеПараметры.Вставить("Комиссия", 0);
				//- ИнфоСофт Сумин Д.В. 21.08.2023 УА #61252
				ДополнительныеПараметры.Вставить("ЦенаПродажи", Транзакция.ЦенаРеализация);				
				ДополнительныеПараметры.Вставить("СтоимостьДопУслуг", 0);	
				//+ ИнфоСофт Стояк Ю.К. 27.02.2025 УА #94609				
				//ДополнительныеПараметры.Вставить("ВидЦены", ПредопределенноеЗначение("Справочник.ВидыЦен.ПустаяСсылка"));
				ДополнительныеПараметры.Вставить("ВидЦены", СтруктураЦен.ВидЦеныСоСкидкой);
				//- ИнфоСофт Стояк Ю.К. 27.02.2025 УА #94609
				
				//+ ИнфоСофт Мурсалимов Д.Р. 20.08.24 УА #81483
				Комплектующие = ИС_МП_УправлениеЗаказами.Комплектующие(ПараметрыКомплектующих, ДополнительныеПараметры);
				//- ИнфоСофт Мурсалимов Д.Р. 20.08.24 УА #81483
				
				Для Каждого стрКомплекта Из Комплектующие Цикл
	
					НоваяСтрока = ОтчетКомиссионера.Товары.Добавить();
					ЗаполнитьЗначенияСвойств(НоваяСтрока, стрКомплекта);
					НоваяСтрока.КоличествоУпаковокУчет 	= НоваяСтрока.КоличествоУпаковок;
					НоваяСтрока.Сумма 					= НоваяСтрока.Цена * НоваяСтрока.КоличествоУпаковок
														+ стрКомплекта.Погрешность;
														
					//+ ИнфоСофт Мурсалимов Д.Р. 09.09.24 УА #83291									
					НоваяСтрока.СуммаПродажи            = НоваяСтрока.ЦенаПродажи * НоваяСтрока.КоличествоУпаковок
														+ стрКомплекта.ПогрешностьСуммаПродажи;
					НоваяСтрока.СуммаВознаграждения 	= стрКомплекта.Комиссия * НоваяСтрока.КоличествоУпаковок
														+ стрКомплекта.ПогрешностьКомиссия;
					//- ИнфоСофт Мурсалимов Д.Р. 09.09.24 УА #83291
					
					//+ ИнфоСофт Заварин К.В. 19.09.24 УА #83149
					НоваяСтрока.Покупатель 			    = Покупатель; 
					//- ИнфоСофт Заварин К.В. 19.09.24 УА #83149
					
				КонецЦикла;
			КонецЕсли;
			
			Если Транзакция.ВозвратКоличество > 0 Тогда
				ПараметрыКомплектующих = ПодборТоваровКлиентСервер.ПараметрыТовара();
				ПараметрыКомплектующих.Номенклатура   		= Транзакция.Номенклатура;
				ПараметрыКомплектующих.НоменклатураНабора   = Транзакция.Номенклатура;
				ПараметрыКомплектующих.ХарактеристикаНабора = Транзакция.ХарактеристикаНоменклатуры;				
				ПараметрыКомплектующих.КоличествоУпаковок	= Транзакция.ВозвратКоличество;
				ПараметрыКомплектующих.ТипНоменклатуры 		= РеквизитыНоменклатуры.ТипНоменклатуры;
				ПараметрыКомплектующих.ВидНоменклатуры 		= РеквизитыНоменклатуры.ВидНоменклатуры;
				ПараметрыКомплектующих.ЭтоТовар 			= Истина;
				ПараметрыКомплектующих.Вставить("ВариантКомплектацииНоменклатуры", Неопределено);
	
				Склады = Новый Массив;
	
				ДополнительныеПараметры = Новый Структура;
				ДополнительныеПараметры.Вставить("Дата", 		ОтчетКомиссионера.Дата);
				ДополнительныеПараметры.Вставить("Валюта", 		ОтчетКомиссионера.Валюта);
				ДополнительныеПараметры.Вставить("Склады", 		Склады);
				ДополнительныеПараметры.Вставить("Соглашение", 	ОтчетКомиссионера.Соглашение);
				ДополнительныеПараметры.Вставить("Цена", 		Транзакция.ЦенаПродавца);
				//+ ИнфоСофт Сумин Д.В. 21.08.2023 УА #61252	
				ДополнительныеПараметры.Вставить("СуммаПродажиКРаспределению", Транзакция.ВозвратЦенаРеализации);
				ДополнительныеПараметры.Вставить("Комиссия", 0);
				//- ИнфоСофт Сумин Д.В. 21.08.2023 УА #61252
				ДополнительныеПараметры.Вставить("ЦенаПродажи", Транзакция.ВозвратЦенаРеализации);				
				ДополнительныеПараметры.Вставить("СтоимостьДопУслуг", 0);
				//+ ИнфоСофт Стояк Ю.К. 27.02.2025 УА #94609				
				//ДополнительныеПараметры.Вставить("ВидЦены", ПредопределенноеЗначение("Справочник.ВидыЦен.ПустаяСсылка"));
				ДополнительныеПараметры.Вставить("ВидЦены", СтруктураЦен.ВидЦеныСоСкидкой);
				//- ИнфоСофт Стояк Ю.К. 27.02.2025 УА #94609
				
				//+ ИнфоСофт Мурсалимов Д.Р. 20.08.24 УА #81483
				Комплектующие = ИС_МП_УправлениеЗаказами.Комплектующие(ПараметрыКомплектующих, ДополнительныеПараметры);
				//- ИнфоСофт Мурсалимов Д.Р. 20.08.24 УА #81483
	
				Для Каждого стрКомплекта Из Комплектующие Цикл
	
					НоваяСтрока = ОтчетКомиссионера.Товары.Добавить();
					ЗаполнитьЗначенияСвойств(НоваяСтрока, стрКомплекта);
					НоваяСтрока.КоличествоУпаковок 		= -стрКомплекта.КоличествоУпаковок;
					НоваяСтрока.КоличествоУпаковокУчет 	= -стрКомплекта.КоличествоУпаковок;
					
					//+ ИнфоСофт Стояк Ю.К. 30.05.2024 УА #74897
					Если Не ЦеныВозвратаПоВидуЦен Тогда
						
						НоваяСтрока.Сумма 					= НоваяСтрока.Цена * НоваяСтрока.КоличествоУпаковок
						+ стрКомплекта.Погрешность;
						
					Иначе
						
						ЦенаРозничная = ЗаполнитьСуммыПоВидуЦен(ВидЦены, ОтчетКомиссионера.Дата, ОтчетКомиссионера.Валюта, НоваяСтрока.Номенклатура, НоваяСтрока.Характеристика, НоваяСтрока.Упаковка);
						
						НоваяСтрока.Цена = -(ЦенаРозничная / НоваяСтрока.КоличествоУпаковок);
						НоваяСтрока.Сумма = -(ЦенаРозничная); 						
						
					КонецЕсли;
					//- ИнфоСофт Стояк Ю.К. 30.05.2024 УА #74897 
										
					//+ ИнфоСофт Мурсалимов Д.Р. 09.09.24 УА #83291
					НоваяСтрока.СуммаПродажи            = (НоваяСтрока.ЦенаПродажи * НоваяСтрока.КоличествоУпаковок
														+ стрКомплекта.ПогрешностьСуммаПродажи);
					НоваяСтрока.СуммаВознаграждения 	= -(стрКомплекта.Комиссия * стрКомплекта.КоличествоУпаковок
														+ стрКомплекта.ПогрешностьКомиссия);
					//- ИнфоСофт Мурсалимов Д.Р. 09.09.24 УА #83291
					
					//+ ИнфоСофт Заварин К.В. 19.09.24 УА #83149
					НоваяСтрока.Покупатель 			    = Покупатель; 
					//- ИнфоСофт Заварин К.В. 19.09.24 УА #83149
										
				КонецЦикла;	
			КонецЕсли;
			
		Иначе
			
			Если Транзакция.Количество > 0 Тогда
				НоваяСтрока = ОтчетКомиссионера.Товары.Добавить();
				НоваяСтрока.Номенклатура 			= Транзакция.Номенклатура;
				НоваяСтрока.Характеристика 			= Транзакция.ХарактеристикаНоменклатуры;
				//+ ИнфоСофт Мурсалимов Д.Р. 23.01.24 УА #66705 
				//+ ИнфоСофт Мурсалимов Д.Р. 05.09.24 УА #82005
				//НоваяСтрока.Количество 				= Транзакция.КоличествоВУпаковке * Транзакция.Количество;
                НоваяСтрока.Количество 				= Транзакция.КоэффициентУпаковки * Транзакция.Количество;
				//- ИнфоСофт Мурсалимов Д.Р. 05.09.24 УА #82005
				НоваяСтрока.Упаковка 				= Транзакция.Упаковка;
				НоваяСтрока.КоличествоУпаковокУчет 	= Транзакция.Количество;
				НоваяСтрока.КоличествоУпаковок 		= Транзакция.Количество;
				//+ ИнфоСофт Сумин Д.В. 19.04.2024 УА #72638
				НоваяСтрока.Цена 					= Транзакция.ЦенаПродавца / НоваяСтрока.КоличествоУпаковок;
				НоваяСтрока.ЦенаПродажи             = Транзакция.РеализованоНаСумму / НоваяСтрока.КоличествоУпаковок;
				//НоваяСтрока.Цена 					= Транзакция.ЦенаПродавца / НоваяСтрока.Количество;
				//НоваяСтрока.ЦенаПродажи             = Транзакция.РеализованоНаСумму / НоваяСтрока.Количество;
				//- ИнфоСофт Сумин Д.В. 19.04.2024 УА #72638
				НоваяСтрока.Сумма 					= Транзакция.ЦенаПродавца;
				//НоваяСтрока.КоличествоУпаковокУчет 	= Транзакция.Количество;
				//НоваяСтрока.КоличествоУпаковок 		= Транзакция.Количество;
				//НоваяСтрока.Цена 					= Транзакция.ЦенаПродавца;
				//НоваяСтрока.ЦенаПродажи             = Транзакция.РеализованоНаСумму / Транзакция.Количество;
				//НоваяСтрока.Сумма 					= НоваяСтрока.Цена * НоваяСтрока.КоличествоУпаковок;
				//- ИнфоСофт Мурсалимов Д.Р. 23.01.24 УА #66705	
				НоваяСтрока.СуммаПродажи            = Транзакция.РеализованоНаСумму;
				НоваяСтрока.СуммаВознаграждения 	= 0;
				
				//+ ИнфоСофт Заварин К.В. 19.09.24 УА #83149
				НоваяСтрока.Покупатель 			    = Покупатель; 
				//- ИнфоСофт Заварин К.В. 19.09.24 УА #83149
				
			КонецЕсли;
			
			Если Транзакция.ВозвратКоличество > 0 Тогда
				
				НоваяСтрока = ОтчетКомиссионера.Товары.Добавить();
				НоваяСтрока.Номенклатура 			= Транзакция.Номенклатура;
				НоваяСтрока.Характеристика 			= Транзакция.ХарактеристикаНоменклатуры;
				//+ ИнфоСофт Мурсалимов Д.Р. 05.09.24 УА #82005
				//НоваяСтрока.Количество 				= -Транзакция.КоличествоВУпаковке * Транзакция.ВозвратКоличество;
				НоваяСтрока.Количество 				= -Транзакция.КоэффициентУпаковки * Транзакция.ВозвратКоличество;	
				//- ИнфоСофт Мурсалимов Д.Р. 05.09.24 УА #82005
				НоваяСтрока.Упаковка 				= Транзакция.Упаковка;			
				НоваяСтрока.КоличествоУпаковокУчет 	= -Транзакция.ВозвратКоличество;
				НоваяСтрока.КоличествоУпаковок 		= -Транзакция.ВозвратКоличество;
				//+ ИнфоСофт Сумин Д.В. 14.05.2024 УА #67999				
				НоваяСтрока.ЦенаПродажи             = -(Транзакция.ВозвращеноНаСумму) / НоваяСтрока.КоличествоУпаковок;
				//НоваяСтрока.Цена 					= Транзакция.ЦенаПродавца / НоваяСтрока.Количество;
				//НоваяСтрока.ЦенаПродажи             = -(Транзакция.ВозвращеноНаСумму) / НоваяСтрока.Количество;
				// ИнфоСофт Сумин Д.В. 14.05.2024 УА #67999
				
				//+ ИнфоСофт Стояк Ю.К. 30.05.2024 УА #74897
				Если Не ЦеныВозвратаПоВидуЦен Тогда 
					
					НоваяСтрока.Цена 					= -(Транзакция.ЦенаПродавца) / НоваяСтрока.КоличествоУпаковок;
					НоваяСтрока.Сумма 					= -Транзакция.ЦенаПродавца;
					
				Иначе
					
					ЦенаРозничная = ЗаполнитьСуммыПоВидуЦен(ВидЦены, ОтчетКомиссионера.Дата, ОтчетКомиссионера.Валюта, НоваяСтрока.Номенклатура, НоваяСтрока.Характеристика, НоваяСтрока.Упаковка);
					
					НоваяСтрока.Цена = -(ЦенаРозничная / НоваяСтрока.КоличествоУпаковок);
					НоваяСтрока.Сумма = -(ЦенаРозничная); 					
					
				КонецЕсли;
				//- ИнфоСофт Стояк Ю.К. 30.05.2024 УА #74897
								
				НоваяСтрока.СуммаПродажи            = -(Транзакция.ВозвращеноНаСумму);   
				НоваяСтрока.СуммаВознаграждения 	= 0;
				
				//+ ИнфоСофт Заварин К.В. 19.09.24 УА #83149
				НоваяСтрока.Покупатель 			    = Покупатель; 
				//- ИнфоСофт Заварин К.В. 19.09.24 УА #83149
								
			КонецЕсли;
			
		КонецЕсли;

	КонецЦикла;

КонецПроцедуры //- ИнфоСофт Стояк Ю.К. 04.05.2023 УА #58008 

