	//- ИнфоСофт Макарова Н.Е. 01.04.2025 УА #77424
		
		Если Не ЗначениеЗаполнено(ФукнциональныеОпции.АктивныйЗаказКлиентаЯМ) Тогда
			Возврат;
		КонецЕсли;
		
		МассивЗаданий = Новый Массив;
		МассивЗаданий.Добавить(ФукнциональныеОпции.АктивныйЗаказКлиентаЯМ);
		
		Если ФукнциональныеОпции.АвтоматическиСоздаватьРеализацииЯМ Тогда
			СоздатьРеализации(Профиль, МассивЗаданий);  
		КонецЕсли;
		
		СоответствиеПараметровЗаписи = Новый Соответствие;
		СоответствиеПараметровЗаписи.Вставить("АктивныйЗаказКлиентаЯМ", Документы.ЗаказКлиента.ПустаяСсылка());
		ИС_MP_Сервер.ЗаписатьНастройкиСправочника(Профиль.Ссылка, СоответствиеПараметровЗаписи); 
		
		Возврат;  
		
	КонецЕсли;
	//- ИнфоСофт Стояк Ю.К. 27.10.2023 УА #65146
	
