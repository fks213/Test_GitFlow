//+ ИнфоСофт Стояк Ю.К. 21.03.2023 УА #54628
Процедура СоздатьРеализации(Профиль, МассивЗаданий) Экспорт
    
    Событие = "СоздатьРеализацииЯМ";
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	//+ ИнфоСофт Стояк Ю.К. 18.12.2023 УА #63805
	"ВЫБРАТЬ
	|	ИС_ЯМ_Заказ.Заказ КАК Заказ,
	|	ИС_ЯМ_Заказ.Номер КАК Номер,
	//+ ИнфоСофт Мурсалимов Д.Р. 19.06.24 УА #77872
	|	ИС_ЯМ_Заказ.Склад.АвтоматическиСоздаватьОрдерНаОтгрузку КАК АвтоматическиСоздаватьОрдерНаОтгрузку,
	//- ИнфоСофт Мурсалимов Д.Р. 19.06.24 УА #77872
	|	ИС_ЯМ_Заказ.Склад.СтатусСтрокиРасходногоОрдера КАК СтатусСтрокиРасходногоОрдера,
	//+ ИнфоСофт Ивонин К.А. 01.07.24 УА #76413
	|	ИС_ЯМ_Заказ.Склад.СтатусРасходногоОрдера КАК СтатусРасходногоОрдера,
	//- ИнфоСофт Ивонин К.А. 01.07.24 УА #76413
	|	ИС_ЯМ_СтатусыСборочныхЗаданий.status КАК status,
	|	ИС_ЯМ_СтатусыСборочныхЗаданий.substatus КАК substatus,
	//+ ИнфоСофт Заварин К.В. 19.03.25 УА #96732 
	|	ИС_ЯМ_Заказ.Склад КАК Склад,
	//- ИнфоСофт Заварин К.В. 19.03.25 УА #96732
	|	ИС_ЯМ_Заказ.shipmentDate КАК shipmentDate
	|ПОМЕСТИТЬ ВТ_Заказы
	|ИЗ
	|	Документ.ИС_ЯМ_Заказ КАК ИС_ЯМ_Заказ
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ИС_ЯМ_СтатусыСборочныхЗаданий КАК ИС_ЯМ_СтатусыСборочныхЗаданий
	|		ПО (ИС_ЯМ_СтатусыСборочныхЗаданий.Заказ = ИС_ЯМ_Заказ.Ссылка)
	|ГДЕ
	|	ИС_ЯМ_Заказ.Ссылка В(&МассивСсылок)
	|	И НЕ ИС_ЯМ_Заказ.Заказ = ЗНАЧЕНИЕ(Документ.ЗаказКлиента.ПустаяСсылка)
	|
	|СГРУППИРОВАТЬ ПО
	|	ИС_ЯМ_Заказ.Заказ,
	|	ИС_ЯМ_Заказ.Номер,
	//+ ИнфоСофт Мурсалимов Д.Р. 19.06.24 УА #77872
	|	ИС_ЯМ_Заказ.Склад.АвтоматическиСоздаватьОрдерНаОтгрузку,
	//- ИнфоСофт Мурсалимов Д.Р. 19.06.24 УА #77872
	|	ИС_ЯМ_Заказ.Склад.СтатусСтрокиРасходногоОрдера,
	//+ ИнфоСофт Заварин К.В. 19.03.25 УА #96732 
	|	ИС_ЯМ_Заказ.Склад,
	//- ИнфоСофт Заварин К.В. 19.03.25 УА #96732
	|	ИС_ЯМ_СтатусыСборочныхЗаданий.status,
	|	ИС_ЯМ_СтатусыСборочныхЗаданий.substatus,
	|	ИС_ЯМ_Заказ.shipmentDate,
	|	ИС_ЯМ_Заказ.Склад.СтатусРасходногоОрдера
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_Заказы.Заказ КАК Заказ,
	|	СУММА(ВЫБОР
	|			КОГДА РеализацияТоваровУслуг.Ссылка ЕСТЬ NULL
	|				ТОГДА 0
	|			ИНАЧЕ 1
	|		КОНЕЦ) КАК КоличествоРТУ,
	|	ВТ_Заказы.Номер КАК Номер,
	|	ВТ_Заказы.status КАК status,
	|	ВТ_Заказы.substatus КАК substatus
	|ПОМЕСТИТЬ ВТ_РТУ
	|ИЗ
	|	ВТ_Заказы КАК ВТ_Заказы
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.РеализацияТоваровУслуг КАК РеализацияТоваровУслуг
	|		ПО (РеализацияТоваровУслуг.ЗаказКлиента = ВТ_Заказы.Заказ.Ссылка)
	|
	|СГРУППИРОВАТЬ ПО
	|	ВТ_Заказы.Заказ,
	|	ВТ_Заказы.Номер,
	|	ВТ_Заказы.status,
	|	ВТ_Заказы.substatus
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ВТ_Заказы.Заказ,
	|	СУММА(ВЫБОР
	|			КОГДА ПередачаТоваровХранителю.Ссылка ЕСТЬ NULL
	|				ТОГДА 0
	|			ИНАЧЕ 1
	|		КОНЕЦ),
	|	ВТ_Заказы.Номер,
	|	ВТ_Заказы.status,
	|	ВТ_Заказы.substatus
	|ИЗ
	|	ВТ_Заказы КАК ВТ_Заказы
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ПередачаТоваровХранителю КАК ПередачаТоваровХранителю
	|		ПО ВТ_Заказы.Заказ = ПередачаТоваровХранителю.ЗаказКлиента
	|
	|СГРУППИРОВАТЬ ПО
	|	ВТ_Заказы.Заказ,
	|	ВТ_Заказы.Номер,
	|	ВТ_Заказы.status,
	|	ВТ_Заказы.substatus
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_РТУ.Заказ КАК Заказ,
	|	СУММА(ВТ_РТУ.КоличествоРТУ) КАК КоличествоРТУ,
	|	ВТ_РТУ.Номер КАК Номер,
	|	ВТ_РТУ.status КАК status,
	|	ВТ_РТУ.substatus КАК substatus
	|ПОМЕСТИТЬ ВТ_РТУ_Группировка
	|ИЗ
	|	ВТ_РТУ КАК ВТ_РТУ
	|
	|СГРУППИРОВАТЬ ПО
	|	ВТ_РТУ.Заказ,
	|	ВТ_РТУ.Номер,
	|	ВТ_РТУ.status,
	|	ВТ_РТУ.substatus
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_Заказы.Заказ КАК Заказ,
	//+ ИнфоСофт Мурсалимов Д.Р. 19.06.24 УА #77872
	|	ВТ_Заказы.АвтоматическиСоздаватьОрдерНаОтгрузку КАК АвтоматическиСоздаватьОрдерНаОтгрузку,
	//- ИнфоСофт Мурсалимов Д.Р. 19.06.24 УА #77872 
	|	ВТ_Заказы.СтатусСтрокиРасходногоОрдера КАК СтатусСтрокиРасходногоОрдера,
	//+ ИнфоСофт Ивонин К.А. 01.07.24 УА #76413
	|	ВТ_Заказы.СтатусРасходногоОрдера КАК СтатусРасходногоОрдера,
	//- ИнфоСофт Ивонин К.А. 01.07.24 УА #76413
	|	ВТ_РТУ_Группировка.КоличествоРТУ КАК КоличествоРТУ,
	|	ВТ_Заказы.Номер КАК Номер,
	|	ВТ_Заказы.status КАК Статус,
	|	ВТ_Заказы.substatus КАК Подстатус,
	//+ ИнфоСофт Заварин К.В. 19.03.25 УА #96732
	|	ВТ_Заказы.Склад КАК СкладЯМ,
	|	ВТ_Заказы.Заказ.Склад КАК Склад,
	//- ИнфоСофт Заварин К.В. 19.03.25 УА #96732
	|	ВТ_Заказы.shipmentDate КАК shipmentDate
	|ИЗ
	|	ВТ_Заказы КАК ВТ_Заказы
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_РТУ_Группировка КАК ВТ_РТУ_Группировка
	|		ПО ВТ_Заказы.Заказ = ВТ_РТУ_Группировка.Заказ
	//+ ИнфоСофт Стояк Ю.К. 11.03.2025 УА #95754
	|			И ВТ_Заказы.Номер = ВТ_РТУ_Группировка.Номер
	//- ИнфоСофт Стояк Ю.К. 11.03.2025 УА #95754
	|ГДЕ
	|	ВТ_РТУ_Группировка.КоличествоРТУ = 0
	//+ ИнфоСофт Заварин К.В. 19.03.25 УА #96732 
	|ИТОГИ
	|	МАКСИМУМ(СкладЯМ)
	|ПО
	|	Склад";
	//- ИнфоСофт Заварин К.В. 19.03.25 УА #96732
	//- ИнфоСофт Стояк Ю.К. 18.12.2023 УА #63805
	
	Запрос.УстановитьПараметр("МассивСсылок", МассивЗаданий);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Выборка = РезультатЗапроса.Выбрать();
	
	ФукнциональныеОпции = ПолучитьНастройкиФункциональностиСборочныхЗвданий(Профиль);  
	
	Комиссия25 = ФукнциональныеОпции.ДоговорЯМ.КомиссионныеПродажи25;
	
	Если ФукнциональныеОпции.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;  
	
	//+ ИнфоСофт Стояк Ю.К. 11.03.2025 УА #95754		
	МассивТиповРеализацитй = Новый Массив;
	МассивТиповРеализацитй.Добавить(Новый ОписаниеТипов("ДокументСсылка.РеализацияТоваровУслуг"));
	МассивТиповРеализацитй.Добавить(Новый ОписаниеТипов("ДокументСсылка.ПередачаТоваровХранителю"));
	
	ТаблицаДанныхПоЗаказам = Новый ТаблицаЗначений;	
	ТаблицаДанныхПоЗаказам.Колонки.Добавить("Заказ", Новый ОписаниеТипов("ДокументСсылка.ЗаказКлиента"));
	ТаблицаДанныхПоЗаказам.Колонки.Добавить("Реализация", Новый ОписаниеТипов(МассивТиповРеализацитй));	
	//- ИнфоСофт Стояк Ю.К. 11.03.2025 УА #95754
    
    //+ ИнфоСофт Мурсалимов Д.Р. 13.06.24 УА #77595
	ПорядокОформленияНакладныхРасходныхОрдеров = Константы.ПорядокОформленияНакладныхРасходныхОрдеров.Получить();
	//- ИнфоСофт Мурсалимов Д.Р. 13.06.24 УА #77595
	
	//+ ИнфоСофт Заварин К.В. 20.03.25 УА #96732
	Если ФукнциональныеОпции.ЯндексРежимСозданияРеализаций = 1 Тогда // Пакетный режим
		
		ВыборкаСклад = РезультатЗапроса.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
		
		Пока ВыборкаСклад.Следующий() Цикл
		    
		    Выборка = ВыборкаСклад.Выбрать();
			
			МассивДляЗаполнения = Новый Массив;
			
			Пока Выборка.Следующий() Цикл		
				МассивДляЗаполнения.Добавить(Выборка.Заказ);			
			КонецЦикла;
			
			Если ПорядокОформленияНакладныхРасходныхОрдеров 
				= Перечисления.ПорядокОформленияНакладныхРасходныхОрдеров.СначалаНакладные Тогда
				
				Выборка.Сбросить();
				Выборка.Следующий();
				
				СоздатьРеализацию(Профиль, Выборка, ФукнциональныеОпции, Комиссия25, МассивДляЗаполнения);
				
				Выборка.Сбросить();
				
				Пока Выборка.Следующий() Цикл
					
					Если Выборка.АвтоматическиСоздаватьОрдерНаОтгрузку И Выборка.Заказ.Склад.ИспользоватьОрдернуюСхемуПриОтгрузке Тогда
						ИС_MP_РаботаСЗаказами.СоздатьРасходныйОрдер(  Выборка.Заказ
																	, Выборка.СтатусРасходногоОрдера
																	, Выборка.СтатусСтрокиРасходногоОрдера);	
					КонецЕсли;
					
				КонецЦикла;
				
			Иначе
				
				Выборка.Сбросить();
				
				Пока Выборка.Следующий() Цикл
					
					Если Выборка.АвтоматическиСоздаватьОрдерНаОтгрузку И Выборка.Заказ.Склад.ИспользоватьОрдернуюСхемуПриОтгрузке Тогда
						ИС_MP_РаботаСЗаказами.СоздатьРасходныйОрдер(  Выборка.Заказ
																	, Выборка.СтатусРасходногоОрдера
																	, Выборка.СтатусСтрокиРасходногоОрдера);	
					КонецЕсли;
					
				КонецЦикла;
				
				Выборка.Сбросить();
				Выборка.Следующий();
				
				СоздатьРеализацию(Профиль, Выборка, ФукнциональныеОпции, Комиссия25, МассивДляЗаполнения);
							
			КонецЕсли;
					
		КонецЦикла;
		
		Возврат; 
		
	КонецЕсли;
	//- ИнфоСофт Заварин К.В. 20.03.25 УА #96732
	
    Пока Выборка.Следующий() Цикл
		
		//+ ИнфоСофт Заварин К.В. 19.03.25 УА #96732
		Если Выборка.Заказ = Null Тогда
			Продолжить;
		КонецЕсли;
		//- ИнфоСофт Заварин К.В. 19.03.25 УА #96732
		
		//+ ИнфоСофт Стояк Ю.К. 11.03.2025 УА #95754
		НайденныеСтроки = ТаблицаДанныхПоЗаказам.НайтиСтроки(Новый Структура("Заказ", Выборка.Заказ));
		
		Если НайденныеСтроки.Количество() > 0 Тогда
			
			Если ФукнциональныеОпции.ПереводитьЗаказВГотовностьЯМ И НайденныеСтроки[0].Реализация.Проведен Тогда 
				
				Если Выборка.Статус = Перечисления.ИС_ЯМ_СтатусыЗаказов.PROCESSING И Выборка.Подстатус = Перечисления.ИС_ЯМ_ДетальныеСтатусы.STARTED Тогда			
					Массив = Новый Массив;
					Массив.Добавить(Новый Структура("Номер", Выборка.Номер));
					ИзменитьСтатусыЗаказов(Профиль,	Массив,	Перечисления.ИС_ЯМ_СтатусыЗаказов.PROCESSING, Перечисления.ИС_ЯМ_ДетальныеСтатусы.READY_TO_SHIP);			
				КонецЕсли;
				
			КонецЕсли;
			
			Продолжить;
				
		ИначеЕсли ПорядокОформленияНакладныхРасходныхОрдеров 
			= Перечисления.ПорядокОформленияНакладныхРасходныхОрдеров.СначалаНакладные Тогда                                       		
