		Если СтруктураДанных.Свойство("НомерУПД") И ЗначениеЗаполнено(СтруктураДанных.НомерУПД) Тогда
			ДокументОбъект.Комментарий = СтрШаблон("Номер УПД: %1", СтруктураДанных.НомерУПД);
		КонецЕсли;
		//- ИнфоСофт Власова И.С. 01.04.25 УА #97214
		
		Если СтруктураДанных.ЗаказКлиента = Неопределено Тогда			
