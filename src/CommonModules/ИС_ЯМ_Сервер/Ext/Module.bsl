//+ ИнфоСофт Стояк Ю.К. 13.05.2024 УА #62574
Процедура ЗаполнитьЗначенияПоРеквизитамХарактеристикиНоменклатуры(СтрокаТаблицы, СтруктураПараметров,
	РазделительФотографий, ИмяЗаполняемойКолонки = Неопределено) Экспорт

	ТаблицаСоответствийЗначений = СтруктураПараметров.ТаблицаСоответствийЗначений;
	Если ТаблицаСоответствийЗначений.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
				   |	" + СтруктураПараметров.СписокРеквизитов + Символы.ПС + "
