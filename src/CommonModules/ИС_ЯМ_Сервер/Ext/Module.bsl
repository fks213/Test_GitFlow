//+ ИнфоСофт Ивонин К.А. 14.03.24 УА #71892
Функция ПолучитьСкладПоУмолчанию(Профиль) Экспорт

	Результат = Справочники.ИС_ЯМ_Склады.ПустаяСсылка();
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ ПЕРВЫЕ 2
	|	ИС_ЯМ_Склады.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.ИС_ЯМ_Склады КАК ИС_ЯМ_Склады
	|ГДЕ
	|	НЕ ИС_ЯМ_Склады.ПометкаУдаления
	|	И ИС_ЯМ_Склады.ЛичныйКабинет = &Профиль";

	Запрос.УстановитьПараметр("Профиль", Профиль);
		
	РезультатЗапроса = Запрос.Выполнить();
	
	Выборка = РезультатЗапроса.Выбрать();

	Если Выборка.Количество() = 1 Тогда
		Выборка.Следующий();
		Результат = Выборка.Ссылка;
	КонецЕсли; 
	
	Возврат Результат;
	
КонецФункции //- ИнфоСофт Ивонин К.А. 14.03.24 УА #71892

//+ ИнфоСофт Ивонин К.А. 15.03.24 УА #71892
Функция ПолучитьОстаткиFBS(Профиль, Склад) Экспорт
	
	НастройкиСоединения = ПолучитьНастройкиСоединенияПрофиля(Профиль);	
	ПараметрыЗапроса = ПроверитьИЗаполнитьПараметрыЗапроса(НастройкиСоединения);
	
	КампанияID = Формат(НастройкиСоединения["ЯМКампанияID"], "ЧГ=0");
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ИС_ЯМ_Склады.id КАК id
	|ИЗ
	|	Справочник.ИС_ЯМ_Склады КАК ИС_ЯМ_Склады
	|ГДЕ
	|	ИС_ЯМ_Склады.Ссылка = &Ссылка";
	
	Запрос.УстановитьПараметр("Ссылка", Склад);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаСклад = РезультатЗапроса.Выбрать();
	
	ВыборкаСклад.Следующий();
	
	Id = ВыборкаСклад.id;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ИС_ЯМ_Номенклатура.Ссылка КАК Ссылка,
	|	ИС_ЯМ_Номенклатура.shopSku КАК shopSku
	|ИЗ
	|	Справочник.ИС_ЯМ_Номенклатура КАК ИС_ЯМ_Номенклатура
	|ГДЕ
	|	ИС_ЯМ_Номенклатура.Профиль = &Профиль
	//+ ИнфоСофт Стояк Ю.К. 21.01.2025 УА #91012	
	//|	И НЕ ИС_ЯМ_Номенклатура.vendorCode = """"";
	|	И НЕ ИС_ЯМ_Номенклатура.shopSku = """"";
	//- ИнфоСофт Стояк Ю.К. 21.01.2025 УА #91012
	
	Запрос.УстановитьПараметр("Профиль", Профиль);
		
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаOfferIds = РезультатЗапроса.Выбрать();
	
	МассивOfferIds = Новый Массив;
	
	Результат = Новый ТаблицаЗначений;
	Результат.Колонки.Добавить("НоменклатураЯМ");
	Результат.Колонки.Добавить("OfferId");
	Результат.Колонки.Добавить("Остаток");
	
	Пока ВыборкаOfferIds.Следующий() Цикл
	
		НоваяСтрока = Результат.Добавить();
		НоваяСтрока.НоменклатураЯМ = ВыборкаOfferIds.Ссылка;
		НоваяСтрока.OfferId = ВыборкаOfferIds.shopSku;
		
		МассивOfferIds.Добавить(ВыборкаOfferIds.shopSku);
	
	КонецЦикла;
		
	РазбитыйМассив = ИС_MP_Сервер.РазбитьМассивПоNЭлементов(МассивOfferIds, 500);
	
	Для Каждого Элемент Из РазбитыйМассив Цикл
		
		СтруктураТела = Новый Структура;
		//"withTurnover": false,
	    //"archived": false,
		СтруктураТела.Вставить("offerIds", Элемент);
			
		ОстаткиТоваров = ИС_ЯМ_API.ПолучитьОстаткиИОборачиваемость(Профиль, ПараметрыЗапроса, КампанияID, СтруктураТела);
		
		Если ОстаткиТоваров = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		Если ОстаткиТоваров.status = "ERROR" Тогда 
			Продолжить;
		КонецЕсли;
				
		Для Каждого warehouse Из ОстаткиТоваров.result.warehouses Цикл
		    
		    Если warehouse.warehouseId <> Id Тогда
		    	Продолжить;
		    КонецЕсли;
		    
		    Для Каждого Элемент Из warehouse.offers Цикл

		    	НайденныеСтроки = Результат.НайтиСтроки(Новый Структура("OfferId", Элемент.offerId));
				
				//+ ИнфоСофт Стояк Ю.К. 26.06.2024 УА #78464
				Если НайденныеСтроки.Количество() > 0 Тогда		
				//- ИнфоСофт Стояк Ю.К. 26.06.2024 УА #78464					
					Для Каждого stock Из Элемент.stocks Цикл
				
					Если stock.type = "FIT" Тогда 
						НайденныеСтроки[0].Остаток = stock.count;
						Прервать;	
					КонецЕсли;
		
					КонецЦикла;
				//+ ИнфоСофт Стояк Ю.К. 26.06.2024 УА #78464				
				КонецЕсли;
				//- ИнфоСофт Стояк Ю.К. 26.06.2024 УА #78464;
				
		    КонецЦикла;
		    	
		КонецЦикла;
	
	КонецЦикла;	
                							
	Возврат Результат;
	
КонецФункции //- ИнфоСофт Ивонин К.А. 15.03.24 УА #71892

//+ ИнфоСофт Ивонин К.А. 01.04.24 УА #71892
Функция ПолучитьИнформациюОСкладе(Склад) Экспорт

	ЗапросСклада = Новый Запрос;
	ЗапросСклада.Текст = 
	"ВЫБРАТЬ
	|	ИС_ЯМ_Склады.Ссылка КАК Ссылка,
	|	ИС_ЯМ_Склады.ВыгружатьОстаткиИзГруппыСкладов КАК ВыгружатьОстаткиИзГруппыСкладов,
	|	ИС_ЯМ_Склады.Склад КАК Склад,
	|	ИС_ЯМ_Склады.ОбщаяГруппаСкладов КАК ОбщаяГруппаСкладов,
	|	ИС_ЯМ_СкладыГруппаСкладов.Склад КАК СкладГруппы
	|ИЗ
	|	Справочник.ИС_ЯМ_Склады КАК ИС_ЯМ_Склады
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ИС_ЯМ_Склады.ГруппаСкладов КАК ИС_ЯМ_СкладыГруппаСкладов
	|		ПО ИС_ЯМ_Склады.Ссылка = ИС_ЯМ_СкладыГруппаСкладов.Ссылка
	|ГДЕ
	|	ИС_ЯМ_Склады.Ссылка = &Ссылка
	|ИТОГИ ПО
	|	Ссылка";
	
	ЗапросСклада.УстановитьПараметр("Ссылка", Склад);
	
	РезультатЗапроса = ЗапросСклада.Выполнить();
	
	ВыборкаСклад = РезультатЗапроса.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	Результат = "";
		
	Пока ВыборкаСклад.Следующий() Цикл				
				
		Если ВыборкаСклад.ВыгружатьОстаткиИзГруппыСкладов Тогда 
		    
		    Результат = Результат + "Группа складов: " + Символы.ПС;
		    
			ВыборкаГруппаСкладов = ВыборкаСклад.Выбрать();
		
			Пока ВыборкаГруппаСкладов.Следующий() Цикл
			
				Если ВыборкаГруппаСкладов.СкладГруппы <> Null Тогда
			    	Результат = Результат + Символы.Таб + " - " + ВыборкаГруппаСкладов.СкладГруппы + Символы.ПС;
			    КонецЕсли;
			    
			КонецЦикла;				
		
		ИначеЕсли ЗначениеЗаполнено(ВыборкаСклад.ОбщаяГруппаСкладов) Тогда
			Результат = Результат + "Общая группа складов: " + ВыборкаСклад.ОбщаяГруппаСкладов + Символы.ПС;
		Иначе
			Результат = Результат + "Склад: " + ВыборкаСклад.Склад + Символы.ПС;		
		КонецЕсли;
	
	КонецЦикла;
    
    Возврат Результат;

КонецФункции //- ИнфоСофт Ивонин К.А. 01.04.24 УА #71892

//+ ИнфоСофт Мурсалимов Д.Р. 12.05.24 УА #66901
Функция ПолучитьЦеныFBS(Профиль) Экспорт	
	
	//+ ИнфоСофт Мурсалимов Д.Р. 03.07.24 УА #66901
	МассивПараметров = Новый Массив;
	
	МассивПараметров.Добавить("ЯндексИспользоватьНовыеМетодыApi");
	
	Настройки = ИС_MP_Сервер.ПолучитьНастройки(Профиль, МассивПараметров);
	
	ИспользоватьНовыеМетодыApi = Ложь;
	
	Если Настройки <> Неопределено Тогда		
		
		Если Настройки["ЯндексИспользоватьНовыеМетодыApi"] <> Неопределено Тогда
			ИспользоватьНовыеМетодыApi = Настройки["ЯндексИспользоватьНовыеМетодыApi"];
		КонецЕсли;
		
	КонецЕсли;
	
	Если ИспользоватьНовыеМетодыApi Тогда
		Возврат ПолучитьЦеныFBSNEW(Профиль);
	КонецЕсли;
	//- ИнфоСофт Мурсалимов Д.Р. 03.07.24 УА #66901	
	
	НастройкиСоединения = ПолучитьНастройкиСоединенияПрофиля(Профиль);	
	ПараметрыЗапроса = ПроверитьИЗаполнитьПараметрыЗапроса(НастройкиСоединения);
	
	СтруктураПараметров = Новый Структура;
	СтруктураПараметров.Вставить("businessId", СтрЗаменить(Строка(НастройкиСоединения["ЯМКодБизнеса"]), Символы.НПП, ""));
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ИС_ЯМ_Номенклатура.Ссылка КАК Ссылка,
	|	ИС_ЯМ_Номенклатура.shopSku КАК shopSku
	|ИЗ
	|	Справочник.ИС_ЯМ_Номенклатура КАК ИС_ЯМ_Номенклатура
	|ГДЕ
	|	ИС_ЯМ_Номенклатура.Профиль = &Профиль
	|	И НЕ ИС_ЯМ_Номенклатура.shopSku = """"
	|	И НЕ ИС_ЯМ_Номенклатура.ПометкаУдаления";
	
	Запрос.УстановитьПараметр("Профиль", Профиль);
		
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаOfferIds = РезультатЗапроса.Выбрать();
	
	МассивOfferIds = Новый Массив;
	
	Результат = Новый ТаблицаЗначений;
	Результат.Колонки.Добавить("НоменклатураЯМ");
	Результат.Колонки.Добавить("OfferId");
	Результат.Колонки.Добавить("Цена");
	Результат.Колонки.Добавить("ЦенаСоСкидкой");
	
	Пока ВыборкаOfferIds.Следующий() Цикл
	
		НоваяСтрока = Результат.Добавить();
		НоваяСтрока.НоменклатураЯМ = ВыборкаOfferIds.Ссылка;
		НоваяСтрока.OfferId = ВыборкаOfferIds.shopSku;
		
		МассивOfferIds.Добавить(ВыборкаOfferIds.shopSku);
	
	КонецЦикла;
	
	РазбитыйМассив = ИС_MP_Сервер.РазбитьМассивПоNЭлементов(МассивOfferIds, 200); 
	
	Для Каждого Элемент Из РазбитыйМассив Цикл
		
		СтруктураТела = Новый Структура;
		СтруктураТела.Вставить("offerIds", Элемент);
		
		ЦеныТоваров = ИС_ЯМ_API.ЗагрузитьКарточкиТоваров(Профиль, ПараметрыЗапроса, СтруктураПараметров, СтруктураТела);
		
		Если ЦеныТоваров = Неопределено Тогда
			Возврат Результат;
		КонецЕсли;
		
		Для Каждого Элемент Из ЦеныТоваров.offerMappings Цикл	
			
			Если Элемент.Свойство("offer") Тогда 
				Оффер = Элемент.offer;
			Иначе
				Продолжить;
			КонецЕсли; 
			
			Если Оффер.Свойство("basicPrice") Тогда 
				Цены = Оффер.basicPrice;
			Иначе
				Продолжить;
			КонецЕсли;
			
			НайденныеСтроки = Результат.НайтиСтроки(Новый Структура("OfferId", Оффер.offerId));
			
			Если Цены.Свойство("discountBase") Тогда 
				НайденныеСтроки[0].Цена = Цены.discountBase;
			КонецЕсли;  
			
			Если Цены.Свойство("value") Тогда 
				НайденныеСтроки[0].ЦенаСоСкидкой = Цены.value;
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции //- ИнфоСофт Мурсалимов Д.Р. 12.05.24 УА #66901

//+ ИнфоСофт Мурсалимов Д.Р. 03.02.25 УА #92578
Функция ПолучитьЦеныFBSNEW(Профиль) Экспорт	
	
	НастройкиСоединения = ПолучитьНастройкиСоединенияПрофиля(Профиль);	
	ПараметрыЗапроса 	= ПроверитьИЗаполнитьПараметрыЗапроса(НастройкиСоединения);
	
	КоличествоЭлементовНаЗапрос = НастройкиСоединения["КоличествоЭлементовНаЗапрос"];
	КоличествоПопытокЗапроса 	= НастройкиСоединения["КоличествоОшибокЗапросов"];
	
	КодСтраницы 		= "";
	КоличествоОшибок 	= 0;
	
	СтруктураПараметров = Новый Структура;
	СтруктураПараметров.Вставить("КампанияID", 	Формат(НастройкиСоединения["ЯМКампанияID"], "ЧГ=0"));
	
	Запрос = Новый Запрос;
	
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ИС_ЯМ_Номенклатура.Ссылка КАК Ссылка,
	|	ИС_ЯМ_Номенклатура.shopSku КАК shopSku
	|ИЗ
	|	Справочник.ИС_ЯМ_Номенклатура КАК ИС_ЯМ_Номенклатура
	|ГДЕ
	|	ИС_ЯМ_Номенклатура.Профиль = &Профиль
	|	И НЕ ИС_ЯМ_Номенклатура.shopSku = """"
	|	И НЕ ИС_ЯМ_Номенклатура.ПометкаУдаления";
	
	Запрос.УстановитьПараметр("Профиль", Профиль);
		
	РезультатЗапроса 	= Запрос.Выполнить();
	
	ВыборкаOfferIds 	= РезультатЗапроса.Выбрать();
	
	МассивOfferIds 		= Новый Массив;
	
	Результат = Новый ТаблицаЗначений;
	Результат.Колонки.Добавить("НоменклатураЯМ");
	Результат.Колонки.Добавить("OfferId");
	Результат.Колонки.Добавить("Цена");
	Результат.Колонки.Добавить("ЦенаСоСкидкой");
	
	Пока ВыборкаOfferIds.Следующий() Цикл
	
		НоваяСтрока 				= Результат.Добавить();
		
		НоваяСтрока.НоменклатураЯМ 	= ВыборкаOfferIds.Ссылка;
		НоваяСтрока.OfferId 		= ВыборкаOfferIds.shopSku;
		
		МассивOfferIds.Добавить(ВыборкаOfferIds.shopSku);
	
	КонецЦикла;
	
	РазбитыйМассив = ИС_MP_Сервер.РазбитьМассивПоNЭлементов(МассивOfferIds, 200); 
	
	Для Каждого Элемент Из РазбитыйМассив Цикл
		
		СтруктураТела = Новый Структура;
		СтруктураТела.Вставить("offerIds", Элемент);
		
		ЦеныТоваров = ИС_ЯМ_API.ПолучитьСписокЦенNEW(Профиль, ПараметрыЗапроса, СтруктураПараметров, СтруктураТела);
		
		Если ЦеныТоваров = Неопределено Тогда
			Возврат Результат;
		КонецЕсли;
		
		Для Каждого Элемент Из ЦеныТоваров.offers Цикл	
			
			НайденныеСтроки = Результат.НайтиСтроки(Новый Структура("OfferId", Элемент.OfferId));
			
			Если Элемент.price.Свойство("discountBase") Тогда 
				НайденныеСтроки[0].Цена = Элемент.price.discountBase;
			КонецЕсли;  
			
			Если Элемент.price.Свойство("value") Тогда 
				НайденныеСтроки[0].ЦенаСоСкидкой = Элемент.price.value;
			КонецЕсли;
							
		КонецЦикла;
		
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции //- ИнфоСофт Мурсалимов Д.Р. 03.02.25 УА #92578

//+ ИнфоСофт Мурсалимов Д.Р. 03.05.24 УА #66901
Процедура УстановитьПараметрыЗапросаЦен(Запрос, Профиль) Экспорт
	
	Событие = ПолучитьИмяСобытия("УстановитьПараметрыЗапросаЦен");
		
	МассивПараметров = ПолучитьСписокПараметровЦен();
	
	Результат = ИС_MP_Сервер.ПолучитьЗначениеНастроек(Профиль, Перечисления.ИС_МП_Маркетплейсы.ЯМ, МассивПараметров);
	
	СтруктураЦен = ПолучитьСтруктуруПараметровЦен();
	
	ЗаполнитьЗначенияСвойств(СтруктураЦен, Результат);
		
	Запрос.УстановитьПараметр("Маркетплейс"			, Перечисления.ИС_МП_Маркетплейсы.ЯМ);
	Запрос.УстановитьПараметр("ВидЦены"				, СтруктураЦен.ВидЦены); 
	Запрос.УстановитьПараметр("ВидЦеныСоСкидкой"	, СтруктураЦен.ВидЦеныСоСкидкой);
	Запрос.УстановитьПараметр("ВидЦеныМинимальный"	, Справочники.ВидыЦен.ПустаяСсылка());
	//+ ИнфоСофт Заварин К.В. 03.09.24 УА #72696
	Запрос.УстановитьПараметр("ВидЦеныFBO"			, Справочники.ВидыЦен.ПустаяСсылка());
	//- ИнфоСофт Заварин К.В. 03.09.24 УА #72696
	Запрос.УстановитьПараметр("Профиль"				, Профиль); 
	Запрос.УстановитьПараметр("ПустаяУпаковка"		, ИС_MP_СерверЛокализация.ПустаяСсылкаУпаковка());
		
