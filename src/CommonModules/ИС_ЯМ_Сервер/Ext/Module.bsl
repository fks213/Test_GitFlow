Функция НапечататьЭтикетки(Профиль, МассивЗаданий) Экспорт
	
	Если Не ЗначениеЗаполнено(Профиль) Тогда
		ОбщегоНазначения.СообщитьПользователю("Не заполнен Профиль. Загрузка товаров невозможна");
		Возврат Неопределено;
	КонецЕсли;
	
	НастройкиСоединения = ПолучитьНастройкиСоединенияПрофиля(Профиль);	
	ПараметрыЗапроса = ПроверитьИЗаполнитьПараметрыЗапроса(НастройкиСоединения);	
	
	КодыОтправлений = Новый Массив;
	Для Каждого Задание Из МассивЗаданий Цикл
		КодыОтправлений.Добавить(СтрЗаменить(Задание.Номер, Символы.НПП, ""));		
	КонецЦикла;
	
	КампанияID = Формат(НастройкиСоединения["ЯМКампанияID"], "ЧГ=0");
	МассивФайлов = Новый Массив;
	Для Каждого Элемент Из КодыОтправлений Цикл		 
		МассивФайлов.Добавить(ИС_ЯМ_API.НапечататьЭтикетки(Профиль, ПараметрыЗапроса, КампанияID, Элемент));
	КонецЦикла;
	
	Возврат МассивФайлов;
	
КонецФункции //- ИнфоСофт Стояк Ю.К. 21.03.2023 УА #54628

//+ ИнфоСофт Мурсалимов Д.Р. 23.04.25 УА #99629 
Функция ПолучитьАктивныйЗаказКлиентаЯМ(СборочноеЗадание, РазбиениеПоДатам, РазбиениеПоСкладам)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ИС_ЯМ_ЗаказыВТеченииДня.ЗаказКлиента КАК ЗаказКлиента
	|ИЗ
	|	РегистрСведений.ИС_ЯМ_ЗаказыВТеченииДня КАК ИС_ЯМ_ЗаказыВТеченииДня
	|ГДЕ
	|	ИС_ЯМ_ЗаказыВТеченииДня.ЗаказОткрыт
	|	И ИС_ЯМ_ЗаказыВТеченииДня.Профиль = &Профиль";
	
	Если РазбиениеПоДатам Тогда
		
		Запрос.Текст = Запрос.Текст + "
		|	И ИС_ЯМ_ЗаказыВТеченииДня.ДатаОтгрузки = &ДатаОтгрузки";
		
		Запрос.УстановитьПараметр("ДатаОтгрузки", СборочноеЗадание.items[0].shipmentDate);
		
	КонецЕсли;
	
	Если РазбиениеПоСкладам Тогда
		
		Запрос.Текст = Запрос.Текст + "
		|	И ИС_ЯМ_ЗаказыВТеченииДня.СкладМП = &Склад";
		
		Запрос.УстановитьПараметр("Склад", СборочноеЗадание.Склад);
		
	КонецЕсли;
	
	Запрос.УстановитьПараметр("Профиль", СборочноеЗадание.Профиль);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Если РезультатЗапроса.Пустой() Тогда
		Возврат Неопределено;	
	КонецЕсли; 	
	
	ВыборкаДетальныеЗаписи.Следующий();	
	
	Возврат ВыборкаДетальныеЗаписи.ЗаказКлиента;
	
КонецФункции //- ИнфоСофт Мурсалимов Д.Р. 23.04.25 УА #99629

//+ ИнфоСофт Мурсалимов Д.Р. 23.04.25 УА #99629
Процедура ДобавитьЗаписьВРегистрЗаказовЯМ(Заказ, СборочноеЗадание)
	
	МенеджерЗаписи = РегистрыСведений.ИС_ЯМ_ЗаказыВТеченииДня.СоздатьМенеджерЗаписи(); 
	
	МенеджерЗаписи.ДатаОтгрузки = СборочноеЗадание.items[0].shipmentDate;
	МенеджерЗаписи.ЗаказКлиента = Заказ;
	МенеджерЗаписи.СкладМП 		= СборочноеЗадание.Склад; 
	МенеджерЗаписи.Профиль 		= СборочноеЗадание.Профиль;
	МенеджерЗаписи.ЗаказОткрыт 	= Истина;
	
	МенеджерЗаписи.Записать();
	
КонецПроцедуры //- ИнфоСофт Мурсалимов Д.Р. 23.04.25 УА #99629

