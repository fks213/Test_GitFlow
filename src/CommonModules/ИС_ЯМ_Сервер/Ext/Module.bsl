			ДокументОбъект.Контрагент				= ФукнциональныеОпции.КонтрагентЯМ;
			ДокументОбъект.Договор					= ФукнциональныеОпции.ДоговорЯМ;
			ДокументОбъект.Соглашение				= ФукнциональныеОпции.СоглашениеЯМ;
			ДокументОбъект.КлиентКонтрагент			= СтруктураДанных.ТаблицаПродаж[0].Контрагент;
			ДокументОбъект.КлиентПартнер			= СтруктураДанных.ТаблицаПродаж[0].Партнер;
			ДокументОбъект.КлиентДоговор			= СтруктураДанных.ТаблицаПродаж[0].Договор;	
		Иначе
