//+ ИнфоСофт Стояк Ю.К. 04.04.2023 УА #54628
Функция ПолучитьСписокЗаказов(Профиль, ДатаПоследнегоОтправления) Экспорт
	
	Событие = "ПолучитьСписокЗаказовЯМ";
	
	Если Не ЗначениеЗаполнено(Профиль) Тогда
		ОбщегоНазначения.СообщитьПользователю("Не заполнен Профиль. Загрузка товаров невозможна");
		Возврат Неопределено;
	КонецЕсли;
		
	НастройкиСоединения = ПолучитьНастройкиСоединенияПрофиля(Профиль);	
	ПараметрыЗапроса = ПроверитьИЗаполнитьПараметрыЗапроса(НастройкиСоединения); 
	
	КодСтраницы = 1;
	КампанияID = Формат(НастройкиСоединения["ЯМКампанияID"], "ЧГ=0");
	ЕстьСтраницы = Истина; 
	
	МассивЗагруженныхЗаданий = Новый Массив;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	ИС_ЯМ_Склады.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.ИС_ЯМ_Склады КАК ИС_ЯМ_Склады
		|ГДЕ
		|	ИС_ЯМ_Склады.ИспользоватьВЗаказах = ИСТИНА
		|	И ИС_ЯМ_Склады.ЛичныйКабинет = &Профиль";
	
	Запрос.УстановитьПараметр("Профиль", Профиль);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
	 	Склад = ВыборкаДетальныеЗаписи.Ссылка;
	КонецЦикла;	
	
	//+ ИнфоСофт Сумин Д.В. 04.09.2023 УА #63046
	ОбрабатываемаяДата = ДатаПоследнегоОтправления;
	//- ИнфоСофт Сумин Д.В. 04.09.2023 УА #6304
	
	Пока ЕстьСтраницы Цикл                  
		//+ ИнфоСофт Сумин Д.В. 04.09.2023 УА #63046
		Результат = ИС_ЯМ_API.ПолучитьСписокЗаказов(Профиль, ПараметрыЗапроса, КампанияID, Строка(КодСтраницы), ОбрабатываемаяДата);
		//Результат = ИС_ЯМ_API.ПолучитьСписокЗаказов(Профиль, ПараметрыЗапроса, КампанияID, Строка(КодСтраницы), ДатаПоследнегоОтправления - (24 * 3600)); 
		//- ИнфоСофт Сумин Д.В. 04.09.2023 УА #6304
		
		Если ЗначениеЗаполнено(Результат) Тогда
			pager = Результат.pager;
			orders = Результат.orders;
			КодСтраницы = КодСтраницы + 1;
			ЕстьСтраницы = ?(КодСтраницы <= pager.pagesCount, Истина, Ложь); 
		Иначе
			Прервать;
		КонецЕсли;
		
		Для Каждого order Из orders Цикл
			
			//+ ИнфоСофт Мурсалимов Д.Р. 28.11.23 УА #65333
			Если order.status <> Перечисления.ИС_ЯМ_СтатусыЗаказов.UNPAID Тогда 
				СсылкаЗадания = СоздатьИлиОбновитьЗаказ(Профиль, order, ДатаПоследнегоОтправления, Склад);	
			КонецЕсли;
			//- ИнфоСофт Мурсалимов Д.Р. 28.11.23 УА #65333				 
			
			Если Не СсылкаЗадания.Пустая() Тогда					
				
				МассивЗагруженныхЗаданий.Добавить(СсылкаЗадания);
				
				//+ ИнфоСофт Стояк Ю.К. 21.04.2025 УА #97604				
				ЗаписатьСтатусЗаказа(Профиль, СсылкаЗадания, order);
				//+ ИнфоСофт Стояк Ю.К. 03.05.2023 УА #58008				
				//МенеджерЗаписи = РегистрыСведений.ИС_ЯМ_СтатусыСборочныхЗаданий.СоздатьМенеджерЗаписи();								
				//МенеджерЗаписи.Профиль = Профиль;
				//МенеджерЗаписи.Заказ = СсылкаЗадания;  
				//
				//Попытка
				//	МенеджерЗаписи.status = Перечисления.ИС_ЯМ_СтатусыЗаказов[order.status];
				//Исключение
				//КонецПопытки;
				//
				//Попытка
				//	МенеджерЗаписи.substatus = Перечисления.ИС_ЯМ_ДетальныеСтатусы[order.substatus]; 
				//Исключение
				//КонецПопытки;
				//
				//Попытка
				//	МенеджерЗаписи.Записать(Истина);	
				//Исключение
				//	Текст = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
				//	ИС_MP_Сервер.ЗаписатьВЖРИСообщитьПользователю(Событие, Текст);
				//КонецПопытки;
				////- ИнфоСофт Стояк Ю.К. 03.05.2023 УА #58008
				//- ИнфоСофт Стояк Ю.К. 21.04.2025 УА #97604
				
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЦикла;
	
	Если МассивЗагруженныхЗаданий.Количество() > 0 Тогда
		ПроверитьФункциональныеОпцииСборочныхЗаданий(Профиль, МассивЗагруженныхЗаданий);	
	КонецЕсли;
	
КонецФункции //- ИнфоСофт Стояк Ю.К. 04.04.2023 УА #54628

//+ ИнфоСофт Стояк Ю.К. 20.03.2023 УА #54628
Функция СоздатьИлиОбновитьЗаказ(Профиль, Данные, ДатаПоследнегоОтправления, Склад)

    Событие = "СоздатьИлиОбновитьЗаказ";
	
	НомерЗаказа = Формат(Данные.id, "ЧГ=0"); 
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ИС_ЯМ_Заказ.Ссылка КАК Ссылка
	|ИЗ
	|	Документ.ИС_ЯМ_Заказ КАК ИС_ЯМ_Заказ
	|ГДЕ
	|	ИС_ЯМ_Заказ.Профиль = &Профиль
	|	И ИС_ЯМ_Заказ.Номер = &Номер";
	
	Запрос.УстановитьПараметр("Номер", НомерЗаказа);
	Запрос.УстановитьПараметр("Профиль", Профиль);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Выборка = РезультатЗапроса.Выбрать();
	
	Если Выборка.Следующий() Тогда
		Заказ = Выборка.Ссылка.ПолучитьОбъект();
	Иначе
		Заказ = Документы.ИС_ЯМ_Заказ.СоздатьДокумент();
	КонецЕсли;
		
	Заказ.Профиль = Профиль;
	Заказ.Номер = НомерЗаказа;
	
	СтрокаДата = СтрЗаменить(Данные.creationDate, "-",".");
    //+ ИнфоСофт Стояк Ю.К. 02.07.2024 УА #78828	
    //НоваяДата = Дата(СтрокаДата);               
	НоваяДата = ИС_MP_Сервер.СтрокаВДату(СтрокаДата);               
	//- ИнфоСофт Стояк Ю.К. 02.07.2024 УА #78828
	
	Заказ.Дата = НоваяДата; 			
	Заказ.Склад = Склад;
	
	//+ ИнфоСофт Власова И.С. 06.02.25 УА #83194
	МассивПараметров = ПолучитьСписокПараметровЗаказов();
	
	Результат = ИС_MP_Сервер.ПолучитьЗначениеНастроек(Профиль, Перечисления.ИС_МП_Маркетплейсы.ЯМ, МассивПараметров);
	
	СтруктураЗаказов = ПолучитьСтруктуруПараметровЗаказов();
	
	ЗаполнитьЗначенияСвойств(СтруктураЗаказов, Результат);
	
	МодельРаботы = СтруктураЗаказов.МодельРаботы;
	
	ЭтоDBS = Ложь;
	
	Если МодельРаботы = Перечисления.ИС_МП_МодельРаботы.DBS Тогда
		ЭтоDBS = Истина;
	КонецЕсли;
	
	ЗаполнятьЦеныСУчетомСкидок = СтруктураЗаказов.ЗаполнятьЦеныСУчетомСкидок;
	//- ИнфоСофт Власова И.С. 06.02.25 УА #83194
	
	subsidyTotal = 0;
	
	//+ ИнфоСофт Власова И.С. 06.02.25 УА #83194
	//Если Данные.Свойство("subsidies") И ТипЗнч(Данные.subsidies) = Тип("Массив") Тогда
	Если Данные.Свойство("subsidies") И ТипЗнч(Данные.subsidies) = Тип("Массив") 
		И Не ЗаполнятьЦеныСУчетомСкидок Тогда
	//- ИнфоСофт Власова И.С. 06.02.25 УА #83194
	
		Для Каждого Строка Из Данные.subsidies Цикл
			subsidyTotal = subsidyTotal + Строка.amount;	
		КонецЦикла; 
	
	КонецЕсли;
	
	Заказ.itemsTotal = Данные.itemsTotal + subsidyTotal; 
	Заказ.total = Заказ.itemsTotal + Данные.deliveryTotal;
	
	//+ ИнфоСофт Власова И.С. 06.02.25 УА #83194
	////+ ИнфоСофт Мурсалимов Д.Р. 10.09.24 УА #83277
	//МассивПараметров = ПолучитьСписокПараметровЗаказов();
	//
	//Результат = ИС_MP_Сервер.ПолучитьЗначениеНастроек(Профиль, Перечисления.ИС_МП_Маркетплейсы.ЯМ, МассивПараметров);
	//
	//СтруктураЗаказов = ПолучитьСтруктуруПараметровЗаказов();
	//
	//ЗаполнитьЗначенияСвойств(СтруктураЗаказов, Результат);
	//
	//МодельРаботы = СтруктураЗаказов.МодельРаботы;
	//
	//ЭтоDBS = Ложь;
	//
	//Если МодельРаботы = Перечисления.ИС_МП_МодельРаботы.DBS Тогда
	//	ЭтоDBS = Истина;
	//КонецЕсли;
	////- ИнфоСофт Мурсалимов Д.Р. 10.09.24 УА #83277
	//- ИнфоСофт Власова И.С. 06.02.25 УА #83194
	
	//+ ИнфоСофт Мурсалимов Д.Р. 25.12.23 УА #67982
	Если Данные.delivery.Свойство("address") Тогда
		
		Адрес = Данные.delivery.address; 
		
		Если Адрес.Свойство("recipient") Тогда		
			Заказ.recipient = Адрес.recipient;
		//+ ИнфоСофт Стояк Ю.К. 04.04.2025 УА #96991
		ИначеЕсли Данные.Свойство("buyer") И Данные.buyer.Свойство("firstName") Тогда
			//+ ИнфоСофт Стояк Ю.К. 21.04.2025 УА #97604
			//В Апи сказано, что возвращаются все поля, если есть работа с ДБС. Фактически приходит случайный набор.
			//Заказ.recipient = Данные.buyer.lastName + " " + Данные.buyer.firstName + " " + Данные.buyer.middleName;			
			Попытка
				Заказ.recipient = Данные.buyer.lastName + " " + Данные.buyer.firstName + " " + Данные.buyer.middleName;			
			Исключение
				Заказ.recipient = Данные.buyer.firstName;			
			КонецПопытки;
			//- ИнфоСофт Стояк Ю.К. 21.04.2025 УА #97604
		//- ИнфоСофт Стояк Ю.К. 04.04.2025 УА #96991
		КонецЕсли;
		
		Если Адрес.Свойство("phone") Тогда		
			Заказ.phone = Адрес.phone;	
		КонецЕсли;
		
		МассивАдреса = Новый Массив;
		
		Если Адрес.Свойство("country") Тогда	
			МассивАдреса.Добавить(Адрес.country);	
		КонецЕсли;
		
		Если Адрес.Свойство("city") Тогда
			МассивАдреса.Добавить(Адрес.city);	
		КонецЕсли;
		
		Если Адрес.Свойство("street") Тогда	
			МассивАдреса.Добавить(Адрес.street);	
		КонецЕсли;
		
		Если Адрес.Свойство("house") Тогда
			МассивАдреса.Добавить(Адрес.house);
		КонецЕсли;	
		
		Если МассивАдреса.Количество() > 0 Тогда
			Заказ.address = СтрСоединить(МассивАдреса, ", "); 	
		КонецЕсли;						
				
	КонецЕсли;
	//- ИнфоСофт Мурсалимов Д.Р. 25.12.23 УА #67982	
		
	Если Данные.delivery.shipments[0].Свойство("shipmentDate") Тогда
		ДатаОтгрузкиМассив = СтрРазделить(Данные.delivery.shipments[0].shipmentDate, "-");	
		ДатаОтгрузки = Дата(СтрШаблон("%3%2%(1)000000", ДатаОтгрузкиМассив[0], ДатаОтгрузкиМассив[1], ДатаОтгрузкиМассив[2]));
		Заказ.shipmentDate = ДатаОтгрузки;
	КонецЕсли;                                  
    
    Если Данные.Свойство("cancelRequested") И ТипЗнч(Данные.cancelRequested) = Тип("Булево") Тогда
		Заказ.cancelRequested = Данные.cancelRequested;
	КонецЕсли;
		
	Заказ.serviceName = Данные.delivery.serviceName; 
	Заказ.price = Данные.deliveryTotal; 
	Заказ.type = Данные.delivery.type; 
	
	//+ ИнфоСофт Мурсалимов Д.Р. 10.09.24 УА #83277
	Заказ.ЭтоDBS = ЭтоDBS;
	//- ИнфоСофт Мурсалимов Д.Р. 10.09.24 УА #83277
	
	Заказ.items.Очистить();
	
	items = Данные.items;	
	
	Для Каждого Элемент Из items Цикл	
		
		НоваяСтрока = Заказ.items.Добавить();
		
		ЗаполнитьЗначенияСвойств(НоваяСтрока, Элемент);
		
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	ИС_ЯМ_Номенклатура.Ссылка КАК Ссылка,
		|	ИС_ЯМ_Штрихкоды.Ссылка КАК Штрихкод
		|ИЗ
		|	Справочник.ИС_ЯМ_Номенклатура КАК ИС_ЯМ_Номенклатура
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ИС_ЯМ_Штрихкоды КАК ИС_ЯМ_Штрихкоды
		|		ПО (ИС_ЯМ_Штрихкоды.Владелец = ИС_ЯМ_Номенклатура.Ссылка)
		|			И (ИС_ЯМ_Номенклатура.Профиль = &Профиль)
		|ГДЕ
		|	ИС_ЯМ_Номенклатура.shopSku = &shopSku
		|	И ИС_ЯМ_Номенклатура.Профиль = &Профиль";
		
		Запрос.УстановитьПараметр("shopSku", Элемент.offerId);
		Запрос.УстановитьПараметр("Профиль", Профиль);
		
		РезультатЗапроса = Запрос.Выполнить();
		
		Выборка = РезультатЗапроса.Выбрать();
		
		Пока Выборка.Следующий() Цикл
			НоваяСтрока.НоменклатураЯМ = Выборка.Ссылка;
			НоваяСтрока.ШтрихкодЯМ = Выборка.Штрихкод;
		КонецЦикла;

		itemsubsidyTotal = 0;
		
		//+ ИнфоСофт Власова И.С. 06.02.25 УА #83194
		//Если Элемент.Свойство("subsidies") И ТипЗнч(Элемент.subsidies) = Тип("Массив") Тогда
		Если Элемент.Свойство("subsidies") И ТипЗнч(Элемент.subsidies) = Тип("Массив")
			И Не ЗаполнятьЦеныСУчетомСкидок Тогда
		//- ИнфоСофт Власова И.С. 06.02.25 УА #83194
		
			Для Каждого Строка Из Элемент.subsidies Цикл
				itemsubsidyTotal = itemsubsidyTotal + Строка.amount;	
			КонецЦикла; 
		
		КонецЕсли;

		НоваяСтрока.price = Число(Элемент.price) + itemsubsidyTotal;	
		НоваяСтрока.Сумма = НоваяСтрока.price * Элемент.count;		
		НоваяСтрока.count = Элемент.count;
		НоваяСтрока.shipmentDate = ДатаОтгрузки;

	КонецЦикла;  
	
	Попытка	      
		
		Заказ.Записать(РежимЗаписиДокумента.Запись);
		ДатаПоследнегоОтправления = Заказ.Дата;
		
		Возврат Заказ.Ссылка;		
		
	Исключение

		ИнформацияОбОшибке = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
		Текст = СтрШаблон("Произошла ошибка при записи элемента Заказ ЯМ: %1",	ИнформацияОбОшибке);
		ИС_MP_Сервер.ЗаписатьВЖРИСообщитьПользователю(Событие, Текст);

	КонецПопытки;
	
	Возврат Документы.ИС_ЯМ_Заказ.ПустаяСсылка();
	
КонецФункции //- ИнфоСофт Стояк Ю.К. 20.03.2023 УА #54628

//+ ИнфоСофт Сумин Д.В. 12.04.2023 УА #57537
Процедура ОбновитьСтатусыСборочныхЗаданий(Профиль, _30Дней = 2592000) Экспорт
	
	Событие = ПолучитьИмяСобытия("ОбновитьСтатусыСборочныхЗаданий");	
	
	НастройкиСоединения = ПолучитьНастройкиСоединенияПрофиля(Профиль);	
	ПараметрыЗапроса = ПроверитьИЗаполнитьПараметрыЗапроса(НастройкиСоединения);
	
	//+ ИнфоСофт Стояк Ю.К. 08.04.2024 УА #68800	
	//_30Дней = 2592000;                          
	//- ИнфоСофт Стояк Ю.К. 08.04.2024 УА #68800
	
	ДатаПоследнегоОтправления = ТекущаяДатаСеанса() - _30Дней;
		
	КодСтраницы = 1;
	КампанияID = Формат(НастройкиСоединения["ЯМКампанияID"], "ЧГ=0");
	ЕстьСтраницы = Истина; 
	
	МассивЗагруженныхЗаданий = Новый Массив;	
	
	//+ ИнфоСофт Заварин К.В. 13.09.24 УА #83741
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	ИС_ЯМ_Склады.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.ИС_ЯМ_Склады КАК ИС_ЯМ_Склады
		|ГДЕ
		|	ИС_ЯМ_Склады.ИспользоватьВЗаказах = ИСТИНА
		|	И ИС_ЯМ_Склады.ЛичныйКабинет = &Профиль";
	
	Запрос.УстановитьПараметр("Профиль", Профиль);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
	 	Склад = ВыборкаДетальныеЗаписи.Ссылка;
	КонецЦикла;
	//- ИнфоСофт Заварин К.В. 13.09.24 УА #83741
	
	//+ ИнфоСофт Стояк Ю.К. 04.10.2024 УА #76537
	МассивЗаданий = Новый Массив;
	//- ИнфоСофт Стояк Ю.К. 04.10.2024 УА #76537
	
	Пока ЕстьСтраницы Цикл                  
		
		Результат = ИС_ЯМ_API.ПолучитьСписокЗаказов(Профиль, ПараметрыЗапроса, КампанияID, Строка(КодСтраницы), ДатаПоследнегоОтправления - (24 * 3600)); 
		
		Если ЗначениеЗаполнено(Результат) Тогда
			pager = Результат.pager;
			orders = Результат.orders;
			КодСтраницы = КодСтраницы + 1;
			ЕстьСтраницы = ?(КодСтраницы <= pager.pagesCount, Истина, Ложь); 
		Иначе
			Прервать;
		КонецЕсли;
		
		Для Каждого order Из orders Цикл
			
			//+ ИнфоСофт Сумин Д.В. 07.11.2023 УА #65561
			Заказ = ПолучитьЗаказПоНомеру(order.id);
			//Заказ = Документы.ИС_ЯМ_Заказ.НайтиПоНомеру(order.id);
			//- ИнфоСофт Сумин Д.В. 07.11.2023 УА #65561
			
			Если Заказ.Пустая() Тогда
				Продолжить;
			КонецЕсли;		 
			
			//+ ИнфоСофт Стояк Ю.К. 04.10.2024 УА #76537
			Если Заказ.shipmentDate = Дата('00010101') Тогда 					
				Заказ = СоздатьИлиОбновитьЗаказ(Профиль, order, ДатаПоследнегоОтправления, Склад);					
				МассивЗаданий.Добавить(Заказ);
			КонецЕсли;
			//- ИнфоСофт Стояк Ю.К. 04.10.2024 УА #76537
			
			//+ ИнфоСофт Стояк Ю.К. 21.04.2025 УА #97604			
			ЗаписатьСтатусЗаказа(Профиль, Заказ, order);
			//+ ИнфоСофт Стояк Ю.К. 03.05.2023 УА #58008
			//МенеджерЗаписи = РегистрыСведений.ИС_ЯМ_СтатусыСборочныхЗаданий.СоздатьМенеджерЗаписи();
			//МенеджерЗаписи.Профиль = Профиль;
			//МенеджерЗаписи.Заказ = Заказ;
			//
			//МенеджерЗаписи.Прочитать();
			//
			//МенеджерЗаписи.Профиль = Профиль;
			//МенеджерЗаписи.Заказ = Заказ;   
			//
			////+ ИнфоСофт Стояк Ю.К. 16.09.2024 УА #82955
			//БылОтменён = Ложь;
			//
			//Если МенеджерЗаписи.status = Перечисления.ИС_ЯМ_СтатусыЗаказов.CANCELLED Тогда
			//	БылОтменён = Истина;
			//КонецЕсли;
			////- ИнфоСофт Стояк Ю.К. 16.09.2024 УА #82955
			//
			//Попытка
			//	МенеджерЗаписи.status = Перечисления.ИС_ЯМ_СтатусыЗаказов[order.status];
			//Исключение
			//КонецПопытки;
			//
			//Попытка
			//	МенеджерЗаписи.substatus = Перечисления.ИС_ЯМ_ДетальныеСтатусы[order.substatus]; 
			//Исключение
			//КонецПопытки;
			//
			////+ ИнфоСофт Стояк Ю.К. 16.08.2023 УА #61318			
			////+ ИнфоСофт Стояк Ю.К. 16.09.2024 УА #82955
			////Если МенеджерЗаписи.status = Перечисления.ИС_ЯМ_СтатусыЗаказов.CANCELLED Тогда
			//Если МенеджерЗаписи.status = Перечисления.ИС_ЯМ_СтатусыЗаказов.CANCELLED И Не БылОтменён Тогда
			////- ИнфоСофт Стояк Ю.К. 16.09.2024 УА #82955			
			//	ОтменитьЗаказ(Заказ, Профиль);	
			//КонецЕсли;
			////- ИнфоСофт Стояк Ю.К. 16.08.2023 УА #61318
			//
			//Попытка
			//	МенеджерЗаписи.Записать(Истина);	
			//Исключение
			//	Текст = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
			//	ИС_MP_Сервер.ЗаписатьВЖРИСообщитьПользователю(Событие, Текст);
			//КонецПопытки;
			//- ИнфоСофт Стояк Ю.К. 03.05.2023 УА #58008
			//- ИнфоСофт Стояк Ю.К. 21.04.2025 УА #97604
			
		КонецЦикла;
		
	КонецЦикла;
	
	//+ ИнфоСофт Стояк Ю.К. 04.10.2024 УА #76537	
	Если МассивЗаданий.Количество() > 0 Тогда
		ПроверитьФункциональныеОпцииСборочныхЗаданий(Профиль, МассивЗаданий);
	КонецЕсли;                                  
	//- ИнфоСофт Стояк Ю.К. 04.10.2024 УА #76537
	
КонецПроцедуры //- ИнфоСофт Сумин Д.В. 12.04.2023 УА #57537

//+ ИнфоСофт Стояк Ю.К. 20.03.2023 УА #54628
Процедура СоздатьЗаказы(Профиль, МассивЗаданий) Экспорт  
	
	Событие = "СоздатьЗаказыЯМ";
	
	ФукнциональныеОпции = ПолучитьНастройкиФункциональностиСборочныхЗвданий(Профиль);
	
	Если ФукнциональныеОпции.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ИС_ЯМ_Заказ.Ссылка КАК Ссылка
	|ИЗ
	|	Документ.ИС_ЯМ_Заказ КАК ИС_ЯМ_Заказ
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ИС_ЯМ_СтатусыСборочныхЗаданий КАК ИС_ЯМ_СтатусыСборочныхЗаданий
	|		ПО (ИС_ЯМ_СтатусыСборочныхЗаданий.Заказ = ИС_ЯМ_Заказ.Ссылка)
	|ГДЕ
	|	ИС_ЯМ_Заказ.Ссылка В(&МассивСсылок)
	|	И ИС_ЯМ_Заказ.Заказ = ЗНАЧЕНИЕ(Документ.ЗаказКлиента.ПустаяСсылка)
	//+ ИнфоСофт Стояк Ю.К. 01.04.2025 УА #97627	
	//+ ИнфоСофт Мурсалимов Д.Р. 13.11.23 УА #65333
	//|	И ИС_ЯМ_СтатусыСборочныхЗаданий.status <> ЗНАЧЕНИЕ(Перечисление.ИС_ЯМ_СтатусыЗаказов.UNPAID)
	//- ИнфоСофт Мурсалимов Д.Р. 13.11.23 УА #65333
	//- ИнфоСофт Стояк Ю.К. 01.04.2025 УА #97627
	|	И ИС_ЯМ_СтатусыСборочныхЗаданий.status <> ЗНАЧЕНИЕ(Перечисление.ИС_ЯМ_СтатусыЗаказов.CANCELLED)";
	//+ ИнфоСофт Стояк Ю.К. 05.11.2024 УА #86321
	////+ ИнфоСофт Стояк Ю.К. 04.10.2024 УА #76537
	//|	И ИС_ЯМ_Заказ.shipmentDate <> ДАТАВРЕМЯ(1, 1, 1, 0, 0, 0)";
	////- ИнфоСофт Стояк Ю.К. 04.10.2024 УА #76537
	
	Если Не ФукнциональныеОпции.ЯндексСоздаватьЗаказыПоЮрЛицам Тогда
		Запрос.Текст = Запрос.Текст + "	И ИС_ЯМ_Заказ.shipmentDate <> ДАТАВРЕМЯ(1, 1, 1, 0, 0, 0)
		//+ ИнфоСофт Стояк Ю.К. 01.04.2025 УА #97627		
		|	И ИС_ЯМ_СтатусыСборочныхЗаданий.status <> ЗНАЧЕНИЕ(Перечисление.ИС_ЯМ_СтатусыЗаказов.UNPAID)";		
		//- ИнфоСофт Стояк Ю.К. 01.04.2025 УА #97627
	КонецЕсли;
	//- ИнфоСофт Стояк Ю.К. 05.11.2024 УА #86321
	
	Запрос.УстановитьПараметр("МассивСсылок", МассивЗаданий);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Выборка = РезультатЗапроса.Выбрать();
	
	МассивКСозданию = Новый Массив();
	Пока Выборка.Следующий() Цикл
		МассивКСозданию.Добавить(Выборка.Ссылка);	
	КонецЦикла;
	
	Если МассивКСозданию.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
    	
	Если ФукнциональныеОпции.РежимСозданияЗаказовЯМ = 0 Тогда // Один к одному
	
		Для Каждого СборочноеЗадание Из МассивКСозданию Цикл
			
			Заказ = СоздатьИлиДополнитьЗаказУТ11_5(СборочноеЗадание, ФукнциональныеОпции);
			
			Если Не Заказ.Пустая() Тогда
			
				ДокОбъект = СборочноеЗадание.ПолучитьОбъект();
				ДокОбъект.Заказ = Заказ;
				
				Попытка
					ДокОбъект.Записать();
				Исключение
					Текст = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
					ИС_MP_Сервер.ЗаписатьВЖРИСообщитьПользователю(Событие, Текст);
				КонецПопытки;
			
			КонецЕсли; 	
			
		КонецЦикла;
		
	ИначеЕсли ФукнциональныеОпции.РежимСозданияЗаказовЯМ = 1 Тогда // Пакетный режим
	   	//+ ИнфоСофт Заварин К.В. 02.08.24 УА #80812
		МассивСтатусов = Новый Массив;
		МассивСтатусов.Добавить(Перечисления.ИС_ЯМ_СтатусыЗаказов.UNPAID);
		МассивСтатусов.Добавить(Перечисления.ИС_ЯМ_СтатусыЗаказов.CANCELLED);
		
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	ИС_ЯМ_Заказ.Ссылка КАК Ссылка,
		|	ИС_ЯМ_Заказ.Склад КАК Склад
		|ИЗ
		|	Документ.ИС_ЯМ_Заказ КАК ИС_ЯМ_Заказ
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ИС_ЯМ_СтатусыСборочныхЗаданий КАК ИС_ЯМ_СтатусыСборочныхЗаданий
		|		ПО (ИС_ЯМ_СтатусыСборочныхЗаданий.Заказ = ИС_ЯМ_Заказ.Ссылка)
		|ГДЕ
		|	ИС_ЯМ_Заказ.Ссылка В (&МассивСсылок)
		|	И ИС_ЯМ_Заказ.Заказ = ЗНАЧЕНИЕ(Документ.ЗаказКлиента.ПустаяСсылка)
		|	И НЕ ИС_ЯМ_СтатусыСборочныхЗаданий.status В(&МассивСтатусов)
		|ИТОГИ ПО
		|	Склад";
		Запрос.УстановитьПараметр("МассивСсылок", МассивЗаданий);
		Запрос.УстановитьПараметр("МассивСтатусов", МассивСтатусов);
		
		РезультатЗапроса = Запрос.Выполнить();
				
		Выборка = РезультатЗапроса.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
		
		Пока Выборка.Следующий() Цикл
			ВыборкаДетальныеЗаписи = Выборка.Выбрать();
			Заказ = Неопределено;
			Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
				Заказ = СоздатьИлиДополнитьЗаказУТ11_5(ВыборкаДетальныеЗаписи.Ссылка, ФукнциональныеОпции, Заказ);
				
				Если Не Заказ.Пустая() И Заказ <> Неопределено Тогда	
					ДокОбъект = ВыборкаДетальныеЗаписи.Ссылка.ПолучитьОбъект();
					ДокОбъект.Заказ = Заказ;
					
					Попытка	
						ДокОбъект.Записать();
						
					Исключение
						Текст = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
						ИС_MP_Сервер.ЗаписатьВЖРИСообщитьПользователю(Событие, Текст);
					КонецПопытки; 
				КонецЕсли;	
			КонецЦикла;	
		КонецЦикла;
		
		//Заказ = СоздатьИлиДополнитьЗаказУТ11_5(МассивКСозданию[0], ФукнциональныеОпции);
		//	
		//Если Не Заказ.Пустая() Тогда
		//
		//	ДокОбъект = МассивКСозданию[0].ПолучитьОбъект();
		//	ДокОбъект.Заказ = Заказ;
		//	
		//	Попытка
		//		ДокОбъект.Записать();
		//	Исключение
		//		Текст = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
		//		ИС_MP_Сервер.ЗаписатьВЖРИСообщитьПользователю(Событие, Текст);
		//	КонецПопытки;
		//	
		//КонецЕсли;
		//
		//МассивКСозданию.Удалить(0);
		//
		//Для Каждого СборочноеЗадание Из МассивКСозданию Цикл
		//	
		//	Заказ = СоздатьИлиДополнитьЗаказУТ11_5(СборочноеЗадание, ФукнциональныеОпции, Заказ);
		//	
		//	Если Не Заказ.Пустая() Тогда
		//		
		//		ДокОбъект = СборочноеЗадание.ПолучитьОбъект();
		//		ДокОбъект.Заказ = Заказ;
		//		
		//		Попытка
		//			ДокОбъект.Записать();
		//		Исключение
		//			Текст = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
		//			ИС_MP_Сервер.ЗаписатьВЖРИСообщитьПользователю(Событие, Текст);
		//		КонецПопытки;
		//		
		//	КонецЕсли; 	
		//	
		//КонецЦикла;
		//- ИнфоСофт Заварин К.В. 02.08.24 УА #80812
	ИначеЕсли ФукнциональныеОпции.РежимСозданияЗаказовЯМ = 2 Тогда // Формирование в течение дня 		
		
		//+ ИнфоСофт Стояк Ю.К. 27.10.2023 УА #65146
		//+ ИнфоСофт Макарова Н.Е. 01.04.2025 УА #77424
		Если ФукнциональныеОпции.ФормироватьЕдиныйЗаказБезРазбиенияЯМ
			И НЕ ФукнциональныеОпции.ИспользоватьРазбиениеПоСкладамЯМ Тогда // без разбиения, создается только 1 заказ
		//- ИнфоСофт Макарова Н.Е. 01.04.2025 УА #77424  
			
			Если ФукнциональныеОпции.АктивныйЗаказКлиентаЯМ.Пустая() Тогда
				
				Заказ = СоздатьИлиДополнитьЗаказУТ11_5(МассивКСозданию[0], ФукнциональныеОпции);
				
				Если Не Заказ.Пустая() Тогда
					
					ДокОбъект = МассивКСозданию[0].ПолучитьОбъект();
					ДокОбъект.Заказ = Заказ;
					
					Попытка
						ДокОбъект.Записать();
					Исключение
						Текст = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
						ИС_MP_Сервер.ЗаписатьВЖРИСообщитьПользователю(Событие, Текст);
					КонецПопытки;
					
				КонецЕсли;
						
				СоответствиеПараметровЗаписи = Новый Соответствие;				
				СоответствиеПараметровЗаписи.Вставить("АктивныйЗаказКлиентаЯМ", Заказ.Ссылка);
				ИС_MP_Сервер.ЗаписатьНастройкиСправочника(Профиль, СоответствиеПараметровЗаписи);				
						
				МассивКСозданию.Удалить(0);
				
			Иначе
				Заказ = ФукнциональныеОпции.АктивныйЗаказКлиентаЯМ;
			КонецЕсли;
			
			Для Каждого СборочноеЗадание Из МассивКСозданию Цикл
				
				СоздатьИлиДополнитьЗаказУТ11_5(СборочноеЗадание, ФукнциональныеОпции, Заказ);
				
				ДокОбъект = СборочноеЗадание.ПолучитьОбъект();
				ДокОбъект.Заказ = Заказ;
				
				Попытка
					ДокОбъект.Записать();
				Исключение
					Текст = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
					ИС_MP_Сервер.ЗаписатьВЖРИСообщитьПользователю(Событие, Текст);
				КонецПопытки;	
				
			КонецЦикла; 
			
			Возврат; 
			
		КонецЕсли;
		//- ИнфоСофт Стояк Ю.К. 27.10.2023 УА #65146
		
		//+ ИнфоСофт Сумин Д.В. 01.06.2023 УА #59231
		Для Каждого СборочноеЗадание Из МассивКСозданию Цикл 
			
			ДобавитьЗапись = Ложь;
			
			//+ ИнфоСофт Макарова Н.Е. 01.04.2025 УА #77424
			АктивныйЗаказ = ПолучитьАктивныйЗаказКлиентаЯМ(СборочноеЗадание,
				НЕ ФукнциональныеОпции.ФормироватьЕдиныйЗаказБезРазбиенияЯМ, ФукнциональныеОпции.ИспользоватьРазбиениеПоСкладамЯМ);
			//- ИнфоСофт Макарова Н.Е. 01.04.2025 УА #77424
			
			Если АктивныйЗаказ = Неопределено Тогда
				ДобавитьЗапись = Истина;	
			КонецЕсли;	
			
			Заказ = СоздатьИлиДополнитьЗаказУТ11_5(СборочноеЗадание, ФукнциональныеОпции, АктивныйЗаказ); 
			
			Если Заказ = Документы.ЗаказКлиента.ПустаяСсылка() Тогда
				//+ ИнфоСофт Стояк Ю.К. 11.06.2024 УА #69782				
				Текст = "Отсутствует сопоставление по заказу ЯМ. Номер: " + СокрЛП(СборочноеЗадание.Номер); 
