//+ ИнфоСофт Стояк Ю.К. 04.12.2024 УА #73043
Функция ИзменитьДатуДоставкиДБС(Профиль, МассивЗаданий, НоваяДата, ПричинаПереноса) Экспорт
	
	Событие = "ИзменитьДатуДоставкиДБС";
	
	Если Не ЗначениеЗаполнено(Профиль) Тогда
		ОбщегоНазначения.СообщитьПользователю("Не заполнен Профиль. Загрузка товаров невозможна");
		Возврат Неопределено;
	КонецЕсли;
		
	НастройкиСоединения = ПолучитьНастройкиСоединенияПрофиля(Профиль);	
	ПараметрыЗапроса = ПроверитьИЗаполнитьПараметрыЗапроса(НастройкиСоединения); 
	
	КампанияID = Формат(НастройкиСоединения["ЯМКампанияID"], "ЧГ=0"); 
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ИС_ЯМ_Заказ.Номер КАК Номер,
		|	ИС_ЯМ_СтатусыСборочныхЗаданий.status КАК status
		|ИЗ
		|	Документ.ИС_ЯМ_Заказ КАК ИС_ЯМ_Заказ
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ИС_ЯМ_СтатусыСборочныхЗаданий КАК ИС_ЯМ_СтатусыСборочныхЗаданий
		|		ПО ИС_ЯМ_СтатусыСборочныхЗаданий.Заказ = ИС_ЯМ_Заказ.Ссылка
		|ГДЕ
		|	ИС_ЯМ_Заказ.Ссылка В(&МассивЗаданий)
		|	И (ИС_ЯМ_СтатусыСборочныхЗаданий.status = ЗНАЧЕНИЕ(Перечисление.ИС_ЯМ_СтатусыЗаказов.PROCESSING)
		|			ИЛИ ИС_ЯМ_СтатусыСборочныхЗаданий.status = ЗНАЧЕНИЕ(Перечисление.ИС_ЯМ_СтатусыЗаказов.DELIVERY))";
	
	Запрос.УстановитьПараметр("МассивЗаданий", МассивЗаданий);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ТаблизаЗаказов = РезультатЗапроса.Выгрузить();                   
	
	Дата = Строка(Формат(НоваяДата, "ДФ=гггг-ММ-дд")); 
	
	Для Каждого Задание Из ТаблизаЗаказов Цикл 
		
		Тело = Новый Структура;
		Даты = Новый Массив;
		
		СтруктураДаты = Новый Структура("toDate", Дата);
		Даты.Добавить(СтруктураДаты);
		
		Тело.Вставить("dates", Даты);                                 
		Тело.Вставить("reason", ПричинаПереноса);
		
		КодОтправления = СтрЗаменить(Задание.Номер, Символы.НПП, ""); 			
		
		Результат = ИС_ЯМ_API.ИзменитьДатуДоставкиДБС(Профиль, ПараметрыЗапроса, КампанияID, КодОтправления, Тело);
		
		Если ЗначениеЗаполнено(Результат) Тогда
			
			Если Результат.status = "ERROR" Тогда			
				ОбщегоНазначения.СообщитьПользователю("Не удалось обновить дату доставки заказа: " + КодОтправления);
			КонецЕсли;
		Иначе
			ЗаписьЖурналаРегистрации("Не удалось обновить дату доставки заказа!", УровеньЖурналаРегистрации.Ошибка);
		КонецЕсли;
		
	КонецЦикла;
	
КонецФункции //- ИнфоСофт Стояк Ю.К. 04.12.2024 УА #73043

