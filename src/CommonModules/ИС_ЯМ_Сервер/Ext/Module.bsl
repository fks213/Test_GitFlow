				Иначе
					Отбор = Новый Структура();							
					Отбор.Вставить("Номенклатура", ВыборкаДетальныеЗаписи.Номенклатура);
					Отбор.Вставить("Характеристика", ВыборкаДетальныеЗаписи.Характеристика);					
					//+ ИнфоСофт Стояк Ю.К. 10.04.2025 УА #98469
