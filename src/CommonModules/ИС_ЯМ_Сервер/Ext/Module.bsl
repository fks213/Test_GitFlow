//+ ИнфоСофт Ивонин К.А. 14.04.23 УА #57127
Функция ПолучитьКарточкиТоваров(Профиль, Перезаполнять = Ложь, ДопПараметры = Неопределено) Экспорт
	
	НастройкиСоединения = ПолучитьНастройкиСоединенияПрофиля(Профиль);	
	ПараметрыЗапроса = ПроверитьИЗаполнитьПараметрыЗапроса(НастройкиСоединения); 
	
	КоличествоЭлементовНаЗапрос = НастройкиСоединения["КоличествоЭлементовНаЗапрос"];
	КоличествоПопытокЗапроса = НастройкиСоединения["КоличествоОшибокЗапросов"];
	
	КодСтраницы = "";
	КоличествоОшибок = 0;
	СтруктураПараметров = Новый Структура;
	//+ ИнфоСофт Стояк Ю.К. 12.03.2024 УА #65893	
	СтруктураПараметров.Вставить("КампанияID", Формат(НастройкиСоединения["ЯМКампанияID"], "ЧГ=0"));	
	СтруктураПараметров.Вставить("limit", КоличествоЭлементовНаЗапрос);
	СтруктураПараметров.Вставить("page_token", КодСтраницы);
	//СтруктураПараметров.Вставить("businessId", СтрЗаменить(Строка(НастройкиСоединения["ЯМКодБизнеса"]), Символы.НПП, ""));
	//- ИнфоСофт Стояк Ю.К. 12.03.2024 УА #65893
	ТелоЗапроса = Новый Структура;
	
	//+ ИнфоСофт Стояк Ю.К. 12.03.2024 УА #66043		
	МассивОфферов = Новый Массив;
	
	Пока Истина Цикл
		
		Если КоличествоОшибок > КоличествоПопытокЗапроса Тогда
			ОбщегоНазначения.СообщитьПользователю("Превышено количество ошибок запросов");
			Возврат Неопределено;
		КонецЕсли;
		
		Результат = ИС_ЯМ_API.ЗагрузитьКарточкиМагазина(Профиль, ПараметрыЗапроса, СтруктураПараметров, ТелоЗапроса); 
		
		Если Результат = Неопределено Тогда
			КоличествоОшибок = КоличествоОшибок + 1;
			Продолжить;
		КонецЕсли;
		
		Для Каждого Элемент Из Результат.offers Цикл	
			МассивОфферов.Добавить(Элемент.offerId);			
		КонецЦикла;
		
		Если Результат.paging.Свойство("nextPageToken") Тогда
			СтруктураПараметров.page_token = Результат.paging.nextPageToken;			
		Иначе
			Прервать;
		КонецЕсли; 
		
	КонецЦикла; 
	
	ПометитьНаУдалениеКарточкиНеИзМагазина(Профиль, МассивОфферов); 
	  
	
	СтруктураПараметров = Новый Структура;
	СтруктураПараметров.Вставить("businessId", СтрЗаменить(Строка(НастройкиСоединения["ЯМКодБизнеса"]), Символы.НПП, ""));    
	
	РазбитыйМассив = ИС_MP_Сервер.РазбитьМассивПоNЭлементов(МассивОфферов, 200);
	
	Для Каждого Элемент Из РазбитыйМассив Цикл 
		
		ТелоЗапроса.Вставить("offerIds", Элемент);
		
		Результат = ИС_ЯМ_API.ЗагрузитьКарточкиТоваров(Профиль, ПараметрыЗапроса, СтруктураПараметров, ТелоЗапроса); 
		
		Если Результат = Неопределено Тогда
			Возврат Неопределено;
		КонецЕсли;
		
		Для Каждого Товар Из Результат.offerMappings Цикл	
			СоздатьИлиОбновитьНоменклатуру(Профиль, Товар, Перезаполнять);			
		КонецЦикла; 
		
	КонецЦикла;
	
	//Пока Истина Цикл
	//	
	//	Если КоличествоОшибок > КоличествоПопытокЗапроса Тогда
	//		ОбщегоНазначения.СообщитьПользователю("Превышено количество ошибок запросов");
	//		Возврат Неопределено;
	//	КонецЕсли;
	//	
	//	Результат = ИС_ЯМ_API.ЗагрузитьКарточкиТоваров(Профиль, ПараметрыЗапроса, СтруктураПараметров, ТелоЗапроса); 
	//	
	//	Если Результат = Неопределено Тогда
	//		КоличествоОшибок = КоличествоОшибок + 1;
	//		Продолжить;
	//	КонецЕсли;
	//	
	//	Для Каждого Элемент Из Результат.offerMappings Цикл	
	//		СоздатьИлиОбновитьНоменклатуру(Профиль, Элемент, Перезаполнять);			
	//	КонецЦикла;
	//	
	//	Если Результат.paging.Свойство("nextPageToken") Тогда
	//		СтруктураПараметров.page_token = Результат.paging.nextPageToken;			
	//	Иначе
	//		Прервать;
	//	КонецЕсли; 
	//	
	//КонецЦикла;
	//- ИнфоСофт Стояк Ю.К. 12.03.2024 УА #66043
	
КонецФункции //- ИнфоСофт Ивонин К.А. 14.04.23 УА #57127

//+ ИнфоСофт Ивонин К.А. 14.04.23 УА #57127
Процедура СоздатьИлиОбновитьНоменклатуру(Профиль, СтруктураНоменклатуры, Перезаполнять = Ложь)
	
	//+ ИнфоСофт Сумин Д.В. 22.05.23 УА #58026
	//Временное решение, пока не реализован функционал выбора
	//+ ИнфоСофт Мурсалимов Д.Р. 21.08.23 УА #61952
	//Функционал выбора реализован
	//Перезаполнять = Истина;    
	//- ИнфоСофт Мурсалимов Д.Р. 21.08.23 УА #61952
	//- ИнфоСофт Сумин Д.В. 22.05.23 УА #58026
	
	//+ ИнфоСофт Стояк Ю.К. 08.08.2023 УА #61869	
	//+ ИнфоСофт Сумин Д.В. 14.04.23 УА #57537
	Маппинг = Неопределено;	
	Оффер = Неопределено;	
	
	Если СтруктураНоменклатуры.Свойство("offer") Тогда 
		Оффер = СтруктураНоменклатуры.offer;
	КонецЕсли;
	
	Если СтруктураНоменклатуры.Свойство("mapping") Тогда 
		Маппинг = СтруктураНоменклатуры.mapping;
	КонецЕсли;
	
	//Попытка
	//	Маппинг = СтруктураНоменклатуры.mapping;
	//	Оффер = СтруктураНоменклатуры.offer;	
	//Исключение
	//	Маппинг = Неопределено;	
	//КонецПопытки;
	//Маппинг = СтруктураНоменклатуры.mapping;
	//Оффер = СтруктураНоменклатуры.offer;
	//- ИнфоСофт Сумин Д.В. 14.04.23 УА #57537
	//- ИнфоСофт Стояк Ю.К. 08.08.2023 УА #61869
	
	Если Оффер = Неопределено Тогда
		Возврат;
	КонецЕсли; 
	
	Если Не Оффер.Свойство("name") Тогда
		Возврат;
	КонецЕсли;
	
	//+ ИнфоСофт Сумин Д.В. 22.05.23 УА #58026
	ЯМНоменклатура = ПолучитьНоменклатуруЯМ(Оффер.offerId, Профиль);
	//ЯМНоменклатура = Справочники.ИС_ЯМ_Номенклатура.НайтиПоРеквизиту("shopSku", Оффер.shopSku);
	//- ИнфоСофт Сумин Д.В. 22.05.23 УА #58026
	
	MD5 = ПолучитьMD5Хэш(СтруктураНоменклатуры);
	
	Если ЯМНоменклатура.Пустая() Тогда
		ЯМНоменклатура = Справочники.ИС_ЯМ_Номенклатура.СоздатьЭлемент();
	Иначе
		
		Если ЯМНоменклатура.MD5 = MD5 И Не Перезаполнять Тогда
			Возврат;
		КонецЕсли;					
		
		ЯМНоменклатура = ЯМНоменклатура.ПолучитьОбъект();
		
	КонецЕсли;
	//+ ИнфоСофт Стояк Ю.К. 12.03.2024 УА #66043	
	ЯМНоменклатура.ПометкаУдаления = Ложь;    
	//- ИнфоСофт Стояк Ю.К. 12.03.2024 УА #66043
	
	ЯМНоменклатура.Профиль = Профиль;
	ЯМНоменклатура.MD5 = MD5;	
	ЯМНоменклатура.Наименование = Оффер.name;
	//+ ИнфоСофт Стояк Ю.К. 08.08.2023 УА #61869
	ЯМНоменклатура.shopSku = Оффер.offerId;
	//ЯМНоменклатура.shopSku = Оффер.shopSku;
	//- ИнфоСофт Стояк Ю.К. 08.08.2023 УА #61869 
	//+ ИнфоСофт Стояк Ю.К. 09.02.2024 УА #70456
	Если Оффер.Свойство("archived") Тогда
		ЯМНоменклатура.archived = Оффер.archived;
	КонецЕсли;
	//- ИнфоСофт Стояк Ю.К. 09.02.2024 УА #70456
	
	Если Оффер.Свойство("manufacturer") Тогда
		ЯМНоменклатура.manufacturer = Оффер.manufacturer;
	КонецЕсли;
	
	Если Оффер.Свойство("vendor") Тогда
		ЯМНоменклатура.vendor = Оффер.vendor;
	КонецЕсли;
	
	Если Оффер.Свойство("vendorCode") Тогда
		ЯМНоменклатура.vendorCode = Оффер.vendorCode;
	КонецЕсли;
	
	//+ ИнфоСофт Сумин Д.В. 20.02.2024 УА #66043
	Если Оффер.Свойство("weightDimensions") Тогда
		
		Если Оффер.weightDimensions.Свойство("length") Тогда
			length = Оффер.weightDimensions.length;	
		Иначе
			length = 0;	
		КонецЕсли;
		
		Если Оффер.weightDimensions.Свойство("width") Тогда
			width = Оффер.weightDimensions.width;	
		Иначе
			width = 0;	
		КонецЕсли; 
		
		Если Оффер.weightDimensions.Свойство("height") Тогда
			height = Оффер.weightDimensions.height;	
		Иначе
			height = 0;	
		КонецЕсли; 
		
		Если Оффер.weightDimensions.Свойство("weight") Тогда
			weight = Оффер.weightDimensions.weight;	
		Иначе
			weight = 0;	
		КонецЕсли;
		
		ЯМНоменклатура.length 	= length;
		ЯМНоменклатура.width 	= width;
		ЯМНоменклатура.height 	= height;
		ЯМНоменклатура.weight 	= weight; 
		//Объем считаем в метрах кубических
		ЯМНоменклатура.volume  	= length * width * height / 1000000;
		УстановитьПризнакКГТ(ЯМНоменклатура);
	КонецЕсли;	
	//- ИнфоСофт Сумин Д.В. 20.02.2024 УА #66043
	
	//+ ИнфоСофт Стояк Ю.К. 08.08.2023 УА #61869	
	Если ЗначениеЗаполнено(Маппинг) Тогда
		//+ ИнфоСофт Сумин Д.В. 06.09.2023 УА #63147
		Если Маппинг.Свойство("marketModelId") Тогда
			//Если Маппинг.Свойство("modelId") Тогда
			//- ИнфоСофт Сумин Д.В. 06.09.2023 УА #63147
			//+ ИнфоСофт Сумин Д.В. 06.09.2023 УА #63147 
			ЯМНоменклатура.modelId = Маппинг.marketModelId;
			//ЯМНоменклатура.modelId = Маппинг.modelId;
			//- ИнфоСофт Сумин Д.В. 06.09.2023 УА #63147
		КонецЕсли;
		
		//+ ИнфоСофт Стояк Ю.К. 11.09.2023 УА #62735		
		Если Маппинг.Свойство("marketSku") Тогда
			ЯМНоменклатура.marketSku = Маппинг.marketSku;
		КонецЕсли;
		//+ ИнфоСофт Сумин Д.В. 06.09.2023 УА #63147
		Если Маппинг.Свойство("marketCategoryId") Тогда
			ЯМНоменклатура.categoryId = Маппинг.marketCategoryId;
		КонецЕсли;                                  
		//- ИнфоСофт Стояк Ю.К. 11.09.2023 УА #62735
		//ЯМНоменклатура.categoryId = Маппинг.categoryId;
		//- ИнфоСофт Сумин Д.В. 06.09.2023 УА #63147
		
	КонецЕсли;
	//- ИнфоСофт Стояк Ю.К. 08.08.2023 УА #61869
	
	Попытка
		ЯМНоменклатура.Записать();
	Исключение
		ОбщегоНазначения.СообщитьПользователю(ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;
	
	Если Оффер.Свойство("barcodes") Тогда
		
		Для Каждого Штрихкод Из Оффер.barcodes Цикл 
			
			//+ ИнфоСофт Сумин Д.В. 22.05.23 УА #58026 
			ХарактеристикаЯМ = ПолучитьХарактеристикуЯМ(Штрихкод, Профиль, ЯМНоменклатура.Ссылка);
			//ХарактеристикаЯМ = Справочники.ИС_ЯМ_Штрихкоды.НайтиПоНаименованию(Штрихкод, Истина);
			//- ИнфоСофт Сумин Д.В. 22.05.23 УА #58026
			
			Если ХарактеристикаЯМ.Пустая() Тогда
				ХарактеристикаЯМ = Справочники.ИС_ЯМ_Штрихкоды.СоздатьЭлемент();							
			Иначе
				ХарактеристикаЯМ = ХарактеристикаЯМ.ПолучитьОбъект();					
			КонецЕсли;  
			
			ХарактеристикаЯМ.Владелец = ЯМНоменклатура.Ссылка;
			ХарактеристикаЯМ.Штрихкод = Штрихкод;
			ХарактеристикаЯМ.Наименование = Штрихкод;
			ХарактеристикаЯМ.Профиль = Профиль;
			
			Попытка
				ХарактеристикаЯМ.Записать();
			Исключение
				ОбщегоНазначения.СообщитьПользователю(ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
			КонецПопытки;				
			
		КонецЦикла;
		
	КонецЕсли;
	
КонецПроцедуры //- ИнфоСофт Ивонин К.А. 14.04.23 УА #57127

//+ ИнфоСофт Власова И.С. 02.12.24 УА #62619
Функция СоздатьИзменитьНоменклатуруПоИдентификаторам(Профиль, МассивИдентификаторов, Перезаполнять = Ложь) Экспорт
	
	ТелоЗапроса = Новый Структура;
	ТелоЗапроса.Вставить("offerIds", МассивИдентификаторов);
	
	Результат = ПолучитьИнформациюОКарточкахПоАртикулу(Профиль, ТелоЗапроса);
	
	Если Результат = Неопределено Тогда
		ОбщегоНазначения.СообщитьПользователю(НСтр("ru = 'Не удалось получить информацию по номенклатуре Яндекс Маркет, загрузка карточек и сопоставление не будут выполнены'"));
		Возврат Неопределено;
	КонецЕсли;
	
	МассивНоменклатуры = Новый Массив;
	
	СтруктураНоменклатура = Новый Структура("НоменклатураЯМ, offerId");
	
	Для Каждого Товар Из Результат.offerMappings Цикл	
		
		Если Товар.Свойство("offer") Тогда 
			
			НоменклатураЯМ = СоздатьОбновитьНоменклатуру(Профиль, Товар.offer, Перезаполнять);
			
			Если Не НоменклатураЯМ.Пустая() Тогда	
				
				СтруктураНоменклатура.НоменклатураЯМ = НоменклатураЯМ;
				СтруктураНоменклатура.offerId        = Товар.offer.offerId;
				
				МассивНоменклатуры.Добавить(СтруктураНоменклатура);
				
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат МассивНоменклатуры;
	
КонецФункции //- ИнфоСофт Власова И.С. 02.12.24 УА #62619

//+ ИнфоСофт Власова И.С. 02.12.24 УА #62619
Функция СоздатьОбновитьНоменклатуру(Профиль, СтруктураНоменклатуры, Перезаполнять = Ложь) Экспорт
	
	//+ ИнфоСофт Сумин Д.В. 22.05.23 УА #58026
	//Временное решение, пока не реализован функционал выбора
	//+ ИнфоСофт Мурсалимов Д.Р. 21.08.23 УА #61952
	//Функционал выбора реализован
	//Перезаполнять = Истина;    
	//- ИнфоСофт Мурсалимов Д.Р. 21.08.23 УА #61952
	//- ИнфоСофт Сумин Д.В. 22.05.23 УА #58026
	
	//+ ИнфоСофт Стояк Ю.К. 08.08.2023 УА #61869	
	//+ ИнфоСофт Сумин Д.В. 14.04.23 УА #57537
	Маппинг = Неопределено;	
	Оффер = Неопределено;	
	
	Если СтруктураНоменклатуры.Свойство("offer") Тогда 
		Оффер = СтруктураНоменклатуры.offer;
	КонецЕсли;
	
	Если СтруктураНоменклатуры.Свойство("mapping") Тогда 
		Маппинг = СтруктураНоменклатуры.mapping;
	КонецЕсли;
	
	//Попытка
	//	Маппинг = СтруктураНоменклатуры.mapping;
	//	Оффер = СтруктураНоменклатуры.offer;	
	//Исключение
	//	Маппинг = Неопределено;	
	//КонецПопытки;
	//Маппинг = СтруктураНоменклатуры.mapping;
	//Оффер = СтруктураНоменклатуры.offer;
	//- ИнфоСофт Сумин Д.В. 14.04.23 УА #57537
	//- ИнфоСофт Стояк Ю.К. 08.08.2023 УА #61869
	
	Если Оффер = Неопределено Тогда
		//+ ИнфоСофт Власова И.С. 02.12.24 УА #62619
		//Возврат;
		Возврат Неопределено;
		//- ИнфоСофт Власова И.С. 02.12.24 УА #62619
	КонецЕсли; 
	
	Если Не Оффер.Свойство("name") Тогда
