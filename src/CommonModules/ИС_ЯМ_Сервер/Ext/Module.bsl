			Возврат Неопределено;
			
		КонецПопытки;
		//- ИнфоСофт Власова И.С. 06.08.24 УА #67453
		
	КонецПопытки;        
	
	УстановитьПривилегированныйРежим(Ложь);
	
	Возврат ДокументОбъект.Ссылка;
	
КонецФункции //- ИнфоСофт Сумин Д.В. 21.08.2023 УА #61252

//+ ИнфоСофт Сумин Д.В. 22.08.2023 УА #61252
Функция СоздатьЗаказКлиента(СтруктураДанных) Экспорт 
	
	УстановитьПривилегированныйРежим(Истина);
	Событие = "Создание заказа клиента";
	
	ДокументОбъект = Документы["ЗаказКлиента"].СоздатьДокумент();
	
	ФукнциональныеОпции = ПолучитьНастройкиФункциональностиСборочныхЗвданий(СтруктураДанных.Профиль);
	
	ДанныеЗаполнения = Новый Структура;
	ДанныеЗаполнения.Вставить("Организация", ФукнциональныеОпции.Организация);
	ДанныеЗаполнения.Вставить("Соглашение", СтруктураДанных.ТаблицаПродаж[0].Соглашение);
	ДанныеЗаполнения.Вставить("ЗаполнятьПоСоглашению", Истина);
	ДанныеЗаполнения.Вставить("Контрагент", СтруктураДанных.ТаблицаПродаж[0].Контрагент);
	ДанныеЗаполнения.Вставить("Партнер", СтруктураДанных.ТаблицаПродаж[0].Партнер);
	ДанныеЗаполнения.Вставить("Договор", ФукнциональныеОпции.ДоговорЯМ);
	
	ДокументОбъект.Заполнить(ДанныеЗаполнения);
	
	ДокументОбъект.ЦенаВключаетНДС = Истина;
	
	ПродажаОблагаетсяНДС = ИС_WB_СерверУТ11_5.ПолучитьРезультатПроверкиУчетаНДС(СтруктураДанных.Профиль.Организация);
	
	Если ПродажаОблагаетсяНДС Тогда 		
		ДокументОбъект.НалогообложениеНДС = Перечисления.ТипыНалогообложенияНДС.ПродажаОблагаетсяНДС; 
	Иначе
		ДокументОбъект.НалогообложениеНДС = Перечисления.ТипыНалогообложенияНДС.ПродажаНеОблагаетсяНДС;			
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(ФукнциональныеОпции.КонтрагентЯМ) Тогда	
		ТекстСообщения = СтрШаблон(
		"Не заполнен контрагент.",
		СтруктураДанных.Профиль);
		ИС_MP_Сервер.ЗаписатьВЖРИСообщитьПользователю(Событие, ТекстСообщения);
		ОбщегоНазначения.СообщитьПользователю(ТекстСообщения);
		Возврат Неопределено;
		
	КонецЕсли; 
	
	ХозОперация = ПредопределенноеЗначение("Перечисление.ХозяйственныеОперации.РеализацияКлиенту");	
	
	ИспользоватьДоговорыСКлиентами = ПолучитьФункциональнуюОпцию("ИспользоватьДоговорыСКлиентами");
	Если ИспользоватьДоговорыСКлиентами Тогда
		Если ЗначениеЗаполнено(СтруктураДанных.ТаблицаПродаж[0].Договор) Тогда	
			Если Не Общегоназначения.ЗначениеРеквизитаОбъекта(СтруктураДанных.ТаблицаПродаж[0].Договор, "ХозяйственнаяОперация") = ХозОперация Тогда
				
				ТекстСообщения = СтрШаблон(
				"договор контрагента: %1 имеет хозяйственную операцию отличающуюся от ""Реализация клиенту"". Документ не создан.",
				СтруктураДанных.Профиль);
				ИС_MP_Сервер.ЗаписатьВЖРИСообщитьПользователю(Событие, ТекстСообщения);
				ОбщегоНазначения.СообщитьПользователю(ТекстСообщения);
				Возврат Неопределено;		
			КонецЕсли;
			
		Иначе	
			ТекстСообщения = СтрШаблон(
			"Не заполнен договор контрагента: %1. Документ не создан.",
			СтруктураДанных.Профиль);
			ИС_MP_Сервер.ЗаписатьВЖРИСообщитьПользователю(Событие, ТекстСообщения);
			ОбщегоНазначения.СообщитьПользователю(ТекстСообщения);
			Возврат Неопределено;	
		КонецЕсли;
	КонецЕсли; 
	
	ДокументОбъект.Дата 					= СтруктураДанных.Период.ДатаОкончания;
	ДокументОбъект.ДатаОтгрузки             = СтруктураДанных.Период.ДатаОкончания;
	ДокументОбъект.ХозяйственнаяОперация 	= ХозОперация;   
	ДокументОбъект.СкидкиРассчитаны         = Истина;
	ДокументОбъект.Склад           			= ПолучитьСкладПоУмолчанию(СтруктураДанных.Профиль).Склад;	
	ДокументОбъект.Соглашение				= СтруктураДанных.ТаблицаПродаж[0].Соглашение;
	ДокументОбъект.Контрагент				= СтруктураДанных.ТаблицаПродаж[0].Контрагент;
	ДокументОбъект.Партнер					= СтруктураДанных.ТаблицаПродаж[0].Партнер;
	ДокументОбъект.Договор					= СтруктураДанных.ТаблицаПродаж[0].Договор;	
	ДокументОбъект.Согласован   			= Истина;
	
	Если Не ЗначениеЗаполнено(ДокументОбъект.Соглашение) Или Не ЗначениеЗаполнено(ДокументОбъект.Соглашение.ПорядокРасчетов) Тогда
		ДокументОбъект.Порядокрасчетов = ДокументОбъект.Договор.ПорядокРасчетов;
	Иначе
		ДокументОбъект.Порядокрасчетов = ДокументОбъект.Соглашение.ПорядокРасчетов;	
	КонецЕсли;
	
	ЗаполнитьТЧРеализации(ДокументОбъект, СтруктураДанных.ТаблицаПродаж, ДокументОбъект.Склад);
	
	СтруктураДействий = Новый Структура;
	СтруктураДействий.Вставить("ПересчитатьКоличествоЕдиниц");
	СтруктураДействий.Вставить("ЗаполнитьСтавкуНДС", Новый Структура("Организация, НалогообложениеНДС, Дата",
	ДокументОбъект.Организация, ДокументОбъект.НалогообложениеНДС, ДокументОбъект.Дата));
	СтруктураДействий.Вставить("ПересчитатьСуммуНДС",
	ОбработкаТабличнойЧастиКлиентСервер.ПараметрыПересчетаСуммыНДСВСтрокеТЧ(ДокументОбъект));
	СтруктураДействий.Вставить("ПересчитатьСумму");
	СтруктураДействий.Вставить("ПересчитатьСуммуСНДС", Новый Структура("ЦенаВключаетНДС",
	ДокументОбъект.ЦенаВключаетНДС));	
	ОбработкаТабличнойЧастиСервер.ОбработатьТЧ(ДокументОбъект.Товары, СтруктураДействий, Неопределено);
	
	Попытка
		ДокументОбъект.Записать(РежимЗаписиДокумента.Проведение);
	Исключение
		ТекстСообщения = СтрШаблон("Не удалось провести документ отчет комиссионера: %1%2", Символы.ПС,
		ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		ОбщегоНазначения.СообщитьПользователю(ТекстСообщения);
		
		Попытка
			ДокументОбъект.Записать(РежимЗаписиДокумента.Запись);
		Исключение
			ТекстСообщения = СтрШаблон("Не удалось записать документ отчет комиссионера: %1%2", Символы.ПС,
			ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
			ОбщегоНазначения.СообщитьПользователю(ТекстСообщения);
		КонецПопытки;
		
	КонецПопытки;        
	
	УстановитьПривилегированныйРежим(Ложь);
	
	Возврат ДокументОбъект.Ссылка;
	
КонецФункции //- ИнфоСофт Сумин Д.В. 22.08.2023 УА #61252	

//+ ИнфоСофт Сумин Д.В. 21.08.2023 УА #61252
Процедура ЗаполнитьТЧРеализации(Документ, ТаблицаТранзакций, Склад = Неопределено, ЗаказКлиента = Неопределено)
	
	Документ.Товары.Очистить(); 
	
	Если ТипЗнч(Документ.Ссылка) <> Тип("ДокументСсылка.ЗаказКлиента") Тогда
		Документ.ВидыЗапасов.Очистить(); 	
		ТребуетсяСтатусСтроки = Ложь;
	Иначе		
		ТребуетсяСтатусСтроки = Истина;	
	КонецЕсли;
	
	Для Каждого Транзакция Из ТаблицаТранзакций Цикл
		Если Транзакция.ЭтоНабор Тогда
			РеквизитыНоменклатуры = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Транзакция.Номенклатура,
			"ТипНоменклатуры, ВидНоменклатуры");
			
			Если Транзакция.Количество > 0 Тогда
				ПараметрыКомплектующих = ПодборТоваровКлиентСервер.ПараметрыТовара();
				ПараметрыКомплектующих.Номенклатура   		= Транзакция.Номенклатура;
				ПараметрыКомплектующих.НоменклатураНабора   = Транзакция.Номенклатура;
				ПараметрыКомплектующих.ХарактеристикаНабора = Транзакция.ХарактеристикаНоменклатуры;				
				ПараметрыКомплектующих.КоличествоУпаковок	= Транзакция.Количество;
				ПараметрыКомплектующих.ТипНоменклатуры 		= РеквизитыНоменклатуры.ТипНоменклатуры;
				ПараметрыКомплектующих.ВидНоменклатуры 		= РеквизитыНоменклатуры.ВидНоменклатуры;
				ПараметрыКомплектующих.ЭтоТовар 			= Истина;
				ПараметрыКомплектующих.Вставить("ВариантКомплектацииНоменклатуры", Неопределено);
				
				Склады = Новый Массив;
				
				ДополнительныеПараметры = Новый Структура;
				ДополнительныеПараметры.Вставить("Дата", 		Документ.Дата);
				ДополнительныеПараметры.Вставить("Валюта", 		Документ.Валюта);
				ДополнительныеПараметры.Вставить("Склады", 		Склады);
				ДополнительныеПараметры.Вставить("Соглашение", 	Документ.Соглашение);
				ДополнительныеПараметры.Вставить("Цена", Транзакция.ЦенаРеализация);				
				ДополнительныеПараметры.Вставить("СтоимостьДопУслуг", 0);	
				ДополнительныеПараметры.Вставить("ВидЦены", ПредопределенноеЗначение("Справочник.ВидыЦен.ПустаяСсылка")); 
				ДополнительныеПараметры.Вставить("СуммаПродажиКРаспределению", Транзакция.ЦенаРеализация); 
				ДополнительныеПараметры.Вставить("Комиссия", 0);
				
				//+ ИнфоСофт Мурсалимов Д.Р. 20.08.24 УА #81483
				Комплектующие = ИС_МП_УправлениеЗаказами.Комплектующие(ПараметрыКомплектующих, ДополнительныеПараметры);
				//- ИнфоСофт Мурсалимов Д.Р. 20.08.24 УА #81483
				
				Для Каждого стрКомплекта Из Комплектующие Цикл			
					НоваяСтрока = Документ.Товары.Добавить();
					ЗаполнитьЗначенияСвойств(НоваяСтрока, стрКомплекта);
					НоваяСтрока.Количество 				= НоваяСтрока.КоличествоУпаковок;
					НоваяСтрока.Сумма 					= НоваяСтрока.Цена * НоваяСтрока.КоличествоУпаковок
					+ стрКомплекта.Погрешность;
					Если Склад <> Неопределено Тогда
						НоваяСтрока.Склад 			= Склад;	
					КонецЕсли;
					Если ТребуетсяСтатусСтроки Тогда
						НоваяСтрока.ВариантОбеспечения = Перечисления.ВариантыОбеспечения.Отгрузить;	
					КонецЕсли;
					Если ЗаказКлиента <> Неопределено Тогда
						НоваяСтрока.ЗаказКлиента = ЗаказКлиента.Ссылка;
					КонецЕсли;	
				КонецЦикла;
			КонецЕсли;			
		Иначе		
			Если Транзакция.Количество > 0 Тогда
				НоваяСтрока = Документ.Товары.Добавить();
				НоваяСтрока.Номенклатура 			= Транзакция.Номенклатура;
				НоваяСтрока.Характеристика 			= Транзакция.ХарактеристикаНоменклатуры;				
				НоваяСтрока.Количество 				= Транзакция.Количество;
				НоваяСтрока.КоличествоУпаковок 		= Транзакция.Количество;
				НоваяСтрока.Цена 					= Транзакция.ЦенаРеализация;
				НоваяСтрока.Сумма 					= НоваяСтрока.Цена * НоваяСтрока.КоличествоУпаковок;
				Если ТребуетсяСтатусСтроки Тогда
					НоваяСтрока.ВариантОбеспечения = Перечисления.ВариантыОбеспечения.Отгрузить;	
				КонецЕсли;
				Если Склад <> Неопределено Тогда
					НоваяСтрока.Склад 				= Склад;	
				КонецЕсли; 
				Если ЗаказКлиента <> Неопределено Тогда
						НоваяСтрока.ЗаказКлиента = ЗаказКлиента.Ссылка;
				КонецЕсли;
			КонецЕсли;	
		КонецЕсли;	
	КонецЦикла;
	
КонецПроцедуры //- ИнфоСофт Сумин Д.В. 21.08.2023 УА #61252

//+ ИнфоСофт Стояк Ю.К. 30.05.2024 УА #74897
Функция ЗаполнитьСуммыПоВидуЦен(ВидЦены, ДатаЗаполнения, ВалютаДокумента, Номенклатура, Характеристика, Упаковка)
	
	Если НЕ ЗначениеЗаполнено(ВидЦены) ИЛИ НЕ ЗначениеЗаполнено(ДатаЗаполнения) Тогда
		Возврат 0;
	КонецЕсли;
	
	СтруктураПараметровОтбора = Новый Структура;
	СтруктураПараметровОтбора.Вставить("Валюта", ВалютаДокумента);
	СтруктураПараметровОтбора.Вставить("Дата", ДатаЗаполнения);
	СтруктураПараметровОтбора.Вставить("ВидЦены", ВидЦены);
	СтруктураПараметровОтбора.Вставить("Номенклатура", Номенклатура);
	СтруктураПараметровОтбора.Вставить("Характеристика", Характеристика);
	СтруктураПараметровОтбора.Вставить("Упаковка", Упаковка);
	СтруктураПараметровОтбора.Вставить("Серия", "");
	
	Цена = ЦеныПредприятияЗаполнениеСервер.ПолучитьЦенуПоОтбору(СтруктураПараметровОтбора);
	
	Возврат Цена;
	
КонецФункции //- ИнфоСофт Стояк Ю.К. 30.05.2024 УА #74897

//+ ИнфоСофт Стояк Ю.К. 12.03.2025 УА #95754
//+ ИнфоСофт Заварин К.В. 20.03.25 УА #96732
//Функция СоздатьРеализацию(Профиль, Выборка, ФукнциональныеОпции, Комиссия25) 
Функция СоздатьРеализацию(Профиль, Выборка, ФукнциональныеОпции, Комиссия25, МассивДляЗаполнения = Неопределено)
//- ИнфоСофт Заварин К.В. 20.03.25 УА #96732
//Процедура СоздатьРеализацию(Профиль, Выборка, ФукнциональныеОпции, Комиссия25)	
//- ИнфоСофт Стояк Ю.К. 12.03.2025 УА #95754
	
	Событие = ПолучитьИмяСобытия("СоздатьРеализации1С");
	
	Если Комиссия25 Тогда
		ДокументРеализация = Документы.ПередачаТоваровХранителю.СоздатьДокумент();	
		//+ ИнфоСофт Стояк Ю.К. 12.03.2025 УА #95754		
		ПустаяСсылкаРеализации = Документы.ПередачаТоваровХранителю.ПустаяСсылка();
		//- ИнфоСофт Стояк Ю.К. 12.03.2025 УА #95754
	Иначе
		ДокументРеализация = Документы.РеализацияТоваровУслуг.СоздатьДокумент();
		//+ ИнфоСофт Стояк Ю.К. 12.03.2025 УА #95754
		ПустаяСсылкаРеализации = Документы.РеализацияТоваровУслуг.ПустаяСсылка();
		//- ИнфоСофт Стояк Ю.К. 12.03.2025 УА #95754
	КонецЕсли;
	
	//+ ИнфоСофт Заварин К.В. 20.03.25 УА #96732
	Если Не МассивДляЗаполнения = Неопределено Тогда
		
		Попытка	
			
			Если Комиссия25 Тогда
				СтруктураЗаполнения = СозданиеНаОснованииУТВызовСервера.ПередачаТоваровХранителюПараметрыОткрытияФормы(МассивДляЗаполнения);
			Иначе
				СтруктураЗаполнения = СозданиеНаОснованииУТВызовСервера.РеализацияТоваровУслугПараметрыОткрытияФормы(МассивДляЗаполнения);
			КонецЕсли;
			
			Если СтруктураЗаполнения = Неопределено Тогда
				Возврат	ПустаяСсылкаРеализации;
			КонецЕсли;
			
			ДокументРеализация.Заполнить(СтруктураЗаполнения.Основание); 
			
		Исключение
			Текст = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
			ИС_MP_Сервер.ЗаписатьВЖРИСообщитьПользователю(Событие, Текст);
		КонецПопытки; 
		
	Иначе

	//- ИнфоСофт Заварин К.В. 20.03.25 УА #96732
	
	Попытка
		ДокументРеализация.Заполнить(Выборка.Заказ); 
	Исключение
		Текст = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
		ИС_MP_Сервер.ЗаписатьВЖРИСообщитьПользователю(Событие, Текст);
		//+ ИнфоСофт Стояк Ю.К. 12.03.2025 УА #95754
		Возврат ПустаяСсылкаРеализации;
		//- ИнфоСофт Стояк Ю.К. 12.03.2025 УА #95754
	КонецПопытки;  
	
	//+ ИнфоСофт Заварин К.В. 20.03.25 УА #96732
	КонецЕсли;
	//- ИнфоСофт Заварин К.В. 20.03.25 УА #96732
	
	//+ ИнфоСофт Мурсалимов Д.Р. 04.03.25 УА #95186
	Если ДокументРеализация.Товары.Количество() = 0 Тогда
		
		ДокументРеализация.ЗаказКлиента 	= Неопределено;
		ДокументРеализация.ПометкаУдаления 	= Истина;
		 
		Попытка
			ДокументРеализация.Записать(РежимЗаписиДокумента.Запись);			
		Исключение
			Текст = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
			ИС_MP_Сервер.ЗаписатьВЖРИСообщитьПользователю(Событие, Текст);
			//+ ИнфоСофт Стояк Ю.К. 12.03.2025 УА #95754
			Возврат ПустаяСсылкаРеализации;
			//- ИнфоСофт Стояк Ю.К. 12.03.2025 УА #95754
		КонецПопытки;
			
	КонецЕсли;
	//- ИнфоСофт Мурсалимов Д.Р. 04.03.25 УА #95186
	
	Если Не ФукнциональныеОпции.ДатаОтгрузкиИлиТекущаяДатаВРеализациюЯМ Тогда
		Если ЗначениеЗаполнено(Выборка.shipmentDate) Тогда
			ДокументРеализация.Дата = Выборка.shipmentDate;		
		Иначе                                                 
			ДокументРеализация.Дата = ТекущаяДатаСеанса();
		КонецЕсли;	
	Иначе
		ДокументРеализация.Дата = ТекущаяДатаСеанса();	
	КонецЕсли;
	
	ДокументРеализация.Комментарий = Выборка.Заказ.Комментарий;
	
	Если Не Комиссия25 Тогда
		ДокументРеализация.СкидкиРассчитаны = Истина;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ФукнциональныеОпции.ПодразделениеЯМ) Тогда  
		ДокументРеализация.Подразделение = ФукнциональныеОпции.ПодразделениеЯМ;
	КонецЕсли;		
	
	ЗаписыватьДокумент = Ложь;
	
	Если ФукнциональныеОпции.ПроводитьРеализацииЯМ Тогда
		
		Попытка
			ДокументРеализация.Записать(РежимЗаписиДокумента.Проведение);
		Исключение
			ЗаписыватьДокумент = Истина;
			Текст = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
			ИС_MP_Сервер.ЗаписатьВЖРИСообщитьПользователю(Событие, Текст); 
		КонецПопытки; 
		
		//+ ИнфоСофт Стояк Ю.К. 18.12.2023 УА #63805			
		Если Не ЗаписыватьДокумент И ФукнциональныеОпции.ПереводитьЗаказВГотовностьЯМ Тогда 
			
			Если Выборка.Статус = Перечисления.ИС_ЯМ_СтатусыЗаказов.PROCESSING И Выборка.Подстатус = Перечисления.ИС_ЯМ_ДетальныеСтатусы.STARTED Тогда			
				Массив = Новый Массив;
				Массив.Добавить(Новый Структура("Номер", Выборка.Номер));
				ИзменитьСтатусыЗаказов(Профиль,	Массив,	Перечисления.ИС_ЯМ_СтатусыЗаказов.PROCESSING, Перечисления.ИС_ЯМ_ДетальныеСтатусы.READY_TO_SHIP);			
			КонецЕсли;
			
		КонецЕсли;
		//- ИнфоСофт Стояк Ю.К. 18.12.2023 УА #63805
		
	Иначе
		ЗаписыватьДокумент = Истина;	
	КонецЕсли;
	
	Если ЗаписыватьДокумент Тогда	
		
		Попытка
			ДокументРеализация.Записать();			
		Исключение
			Текст = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
			ИС_MP_Сервер.ЗаписатьВЖРИСообщитьПользователю(Событие, Текст);
			//+ ИнфоСофт Стояк Ю.К. 12.03.2025 УА #95754
			Возврат ПустаяСсылкаРеализации;
			//- ИнфоСофт Стояк Ю.К. 12.03.2025 УА #95754
		КонецПопытки;
		
	КонецЕсли; 
	
	//+ ИнфоСофт Стояк Ю.К. 12.03.2025 УА #95754
	Возврат ДокументРеализация;
	//- ИнфоСофт Стояк Ю.К. 12.03.2025 УА #95754
	
//+ ИнфоСофт Стояк Ю.К. 12.03.2025 УА #95754
//КонецПроцедуры //- ИнфоСофт Мурсалимов Д.Р. 13.06.24 УА #77595
КонецФункции //- ИнфоСофт Стояк Ю.К. 12.03.2025 УА #95754

//+ ИнфоСофт Стояк Ю.К. 04.05.2023 УА #58008
Функция Комплектующие(Параметры, ДополнительныеПараметры)
		
	УстановитьПривилегированныйРежим(Истина);

	Если Не ЗначениеЗаполнено(Параметры.ВариантКомплектацииНоменклатуры) Тогда
		ВариантКомплектацииНоменклатуры = ВариантКомплектацииНоменклатурыПоУмолчанию(
			Параметры.НоменклатураНабора, Параметры.ХарактеристикаНабора);
	Иначе
		ВариантКомплектацииНоменклатуры = Параметры.ВариантКомплектацииНоменклатуры;
	КонецЕсли;

	Если Не Параметры.Свойство("КоличествоУпаковок") Тогда
		Параметры.Вставить("КоличествоУпаковок", 1);
	КонецЕсли;

	ПодобранныеТовары = Новый Массив;

	Если Не ЗначениеЗаполнено(ВариантКомплектацииНоменклатуры) Тогда
		ТекстОшибки = СтрШаблон("Для номенклатуры %1 %2 не определен состав набора", Параметры.НоменклатураНабора,
			Параметры.ХарактеристикаНабора);
		ОбщегоНазначения.СообщитьПользователю(ТекстОшибки);
		Возврат ПодобранныеТовары;
	КонецЕсли;
	
	Колонки = Новый Массив;
	Колонки.Добавить("НомерСтроки");
	Колонки.Добавить("НоменклатураКомплекта");
	Колонки.Добавить("ХарактеристикаКомплекта");
	Колонки.Добавить("Номенклатура");
	Колонки.Добавить("Характеристика");
	Колонки.Добавить("Цена");
	Колонки.Добавить("ВидЦены");
	Колонки.Добавить("Упаковка");
	Колонки.Добавить("Количество");
	Колонки.Добавить("КоличествоУпаковок");
	Колонки.Добавить("ПроцентРучнойСкидки");
	Колонки.Добавить("СуммаРучнойСкидки");
	Колонки.Добавить("Доступно");
	Колонки.Добавить("ВНаличии");

	Комплектующие = НаборыСервер.СоздатьТаблицуСоставаНабора(Колонки);
	Комплектующие.Колонки.Добавить("ТипНоменклатуры", Новый ОписаниеТипов("ПеречислениеСсылка.ТипыНоменклатуры"));
	Комплектующие.Колонки.Добавить("ВидНоменклатуры", Новый ОписаниеТипов("СправочникСсылка.ВидыНоменклатуры"));
	Комплектующие.Колонки.Добавить("ЕдиницаИзмерения", Новый ОписаниеТипов("СправочникСсылка.УпаковкиЕдиницыИзмерения"));
	Комплектующие.Колонки.Добавить("Комиссия", Новый ОписаниеТипов("Число"));

	Запрос = Новый Запрос("ВЫБРАТЬ
						  |	ВариантыКомплектацииНоменклатурыТовары.НомерСтроки КАК НомерСтроки,
						  |	ВариантыКомплектацииНоменклатурыТовары.Номенклатура КАК Номенклатура,
						  |	ВариантыКомплектацииНоменклатурыТовары.Номенклатура.ТипНоменклатуры КАК ТипНоменклатуры,
						  |	ВариантыКомплектацииНоменклатурыТовары.Номенклатура.ЕдиницаИзмерения КАК ЕдиницаИзмерения,
						  |	ВариантыКомплектацииНоменклатурыТовары.Номенклатура.ВидНоменклатуры КАК ВидНоменклатуры,
						  |	ВариантыКомплектацииНоменклатурыТовары.Характеристика КАК Характеристика,
						  |	ВариантыКомплектацииНоменклатурыТовары.Упаковка КАК Упаковка,
						  |	ВариантыКомплектацииНоменклатурыТовары.КоличествоУпаковок КАК КоличествоУпаковок,
						  |	ВариантыКомплектацииНоменклатурыТовары.Количество КАК Количество,
						  |	ВариантыКомплектацииНоменклатурыТовары.ДоляСтоимости КАК ДоляСтоимости,
						  |	СУММА(ЕСТЬNULL(ДоступностьТоваров.ВНаличии, 0) / ЕСТЬNULL(&ТекстЗапросаКоэффициентУпаковки, 1)) КАК ВНаличии,
						  |	СУММА(ЕСТЬNULL(ДоступностьТоваров.Свободно, 0) / ЕСТЬNULL(&ТекстЗапросаКоэффициентУпаковки, 1)) КАК Доступно
						  |ИЗ
						  |	Справочник.ВариантыКомплектацииНоменклатуры.Товары КАК ВариантыКомплектацииНоменклатурыТовары
						  |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.РаспределениеЗапасов КАК ДоступностьТоваров
						  |		ПО ДоступностьТоваров.Номенклатура = ВариантыКомплектацииНоменклатурыТовары.Номенклатура
						  |			И ДоступностьТоваров.Характеристика = ВариантыКомплектацииНоменклатурыТовары.Характеристика
						  |			И ДоступностьТоваров.Состояние = ЗНАЧЕНИЕ(Перечисление.РаспределениеЗапасовСостояния.ОстатокНаСкладе)
						  |			И ДоступностьТоваров.Назначение = ЗНАЧЕНИЕ(Справочник.Назначения.ПустаяСсылка)
						  |			И &ФильтрСклады
						  |ГДЕ
						  |	ВариантыКомплектацииНоменклатурыТовары.Ссылка = &Ссылка
						  |
						  |СГРУППИРОВАТЬ ПО
						  |	ВариантыКомплектацииНоменклатурыТовары.Характеристика,
						  |	ВариантыКомплектацииНоменклатурыТовары.Упаковка,
						  |	ВариантыКомплектацииНоменклатурыТовары.Номенклатура,
						  |	ВариантыКомплектацииНоменклатурыТовары.НомерСтроки,
						  |	ВариантыКомплектацииНоменклатурыТовары.Номенклатура.ТипНоменклатуры,
						  |	ВариантыКомплектацииНоменклатурыТовары.Номенклатура.ЕдиницаИзмерения,
						  |	ВариантыКомплектацииНоменклатурыТовары.Номенклатура.ВидНоменклатуры,
						  |	ВариантыКомплектацииНоменклатурыТовары.КоличествоУпаковок,
						  |	ВариантыКомплектацииНоменклатурыТовары.Количество,
						  |	ВариантыКомплектацииНоменклатурыТовары.ДоляСтоимости");

	Запрос.Текст = СтрЗаменить(Запрос.Текст, "&ТекстЗапросаКоэффициентУпаковки",
		Справочники["УпаковкиЕдиницыИзмерения"].ТекстЗапросаКоэффициентаУпаковки(
		"ВЫРАЗИТЬ(ВариантыКомплектацииНоменклатурыТовары.Упаковка КАК Справочник.УпаковкиЕдиницыИзмерения)",
		"ВЫРАЗИТЬ(ВариантыКомплектацииНоменклатурыТовары.Номенклатура КАК Справочник.Номенклатура)"));

	Запрос.УстановитьПараметр("Ссылка", ВариантКомплектацииНоменклатуры);

	Если ДополнительныеПараметры.Свойство("Склады") Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&ФильтрСклады", "ДоступностьТоваров.Склад В (&Склады)");
		Запрос.УстановитьПараметр("Склады", ДополнительныеПараметры.Склады);
	Иначе
		Запрос.УстановитьПараметр("ФильтрСклады", Истина);
	КонецЕсли;

	РезультатЗапроса = Запрос.Выполнить();
	Выборка = РезультатЗапроса.Выбрать();
	Пока Выборка.Следующий() Цикл

		НоваяСтрока = Комплектующие.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, Выборка);
		НоваяСтрока.КоличествоУпаковок   = НоваяСтрока.КоличествоУпаковок;
		НоваяСтрока.Количество           = НоваяСтрока.Количество;
		НоваяСтрока.НоменклатураНабора   = Параметры.НоменклатураНабора;
		НоваяСтрока.ХарактеристикаНабора = Параметры.ХарактеристикаНабора;

	КонецЦикла;
	Если ПолучитьФункциональнуюОпцию("ИспользоватьСоглашенияСКлиентами") И ДополнительныеПараметры.Свойство("Соглашение")
		И ЗначениеЗаполнено(ДополнительныеПараметры.Соглашение) Тогда

		ПараметрыРасчета = Новый Структура;
		ПараметрыРасчета.Вставить("Дата", ДополнительныеПараметры.Дата);
		ПараметрыРасчета.Вставить("Валюта", ДополнительныеПараметры.Валюта);
		ПараметрыРасчета.Вставить("Соглашение", ДополнительныеПараметры.Соглашение);
		ПараметрыРасчета.Вставить("ПоляЗаполнения", "Цена");

	Иначе

		ПараметрыРасчета = Новый Структура;
		ПараметрыРасчета.Вставить("Дата", ДополнительныеПараметры.Дата);
		ПараметрыРасчета.Вставить("Валюта", ДополнительныеПараметры.Валюта);
		ПараметрыРасчета.Вставить("ВидЦены", ДополнительныеПараметры.ВидЦены);
		ПараметрыРасчета.Вставить("ПоляЗаполнения", "Цена");

	КонецЕсли;

	КоэффициентыПропорциональностиРасчетаЦенНаборов = КоэффициентыРаспределенияПоДолям(Комплектующие.Скопировать(),
		ПараметрыРасчета);

	ОбщаяСтоимость = 0;
	Для Каждого ТекущаяСтрока Из КоэффициентыПропорциональностиРасчетаЦенНаборов Цикл
		ОбщаяСтоимость = ОбщаяСтоимость + ТекущаяСтрока.Цена;
	КонецЦикла;

	СуммаКРаспределению 			= ДополнительныеПараметры.Цена * Параметры.КоличествоУпаковок;
	//+ ИнфоСофт Сумин Д.В. 28.11.2023 УА #66705
	СуммаПродажиКРаспределению 		= ДополнительныеПараметры.ЦенаПродажи;
	//СуммаПродажиКРаспределению 	= ДополнительныеПараметры.СуммаПродажиКРаспределению;
	//- ИнфоСофт Сумин Д.В. 28.11.2023 УА #66705
	СуммаКомиссииКРаспределению 	= ДополнительныеПараметры.Комиссия;

	СлужебнаяТЧ = Новый ТаблицаЗначений;
	СлужебнаяТЧ.Колонки.Добавить("СтрокаТЧ");
	СлужебнаяТЧ.Колонки.Добавить("НомерСтроки");

	Комплектующие.Сортировать("КоличествоУпаковок Убыв");
	Для Каждого ТекущаяСтрока Из Комплектующие Цикл

		Стоимость = КоэффициентыПропорциональностиРасчетаЦенНаборов.Найти(ТекущаяСтрока.НомерСтроки, "НомерСтроки").Цена;

		ПараметрыТовара = ПодборТоваровКлиентСервер.ПараметрыТовара();
		ЗаполнитьЗначенияСвойств(ПараметрыТовара, Параметры);

		ПараметрыТовара.Номенклатура       = ТекущаяСтрока.Номенклатура;
		ПараметрыТовара.Характеристика     = ТекущаяСтрока.Характеристика;
		ПараметрыТовара.Упаковка           = ТекущаяСтрока.Упаковка;
		ПараметрыТовара.ТипНоменклатуры    = ТекущаяСтрока.ТипНоменклатуры;
		ПараметрыТовара.ВидНоменклатуры    = ТекущаяСтрока.ВидНоменклатуры;
		ПараметрыТовара.ЕдиницаИзмерения   = ТекущаяСтрока.ЕдиницаИзмерения;
		ПараметрыТовара.КоличествоУпаковок = ТекущаяСтрока.КоличествоУпаковок * Параметры.КоличествоУпаковок;
		ПараметрыТовара.Количество         = ТекущаяСтрока.Количество * Параметры.КоличествоУпаковок;
		ПараметрыТовара.Вставить("ПогрешностьКомиссия", 0);
		ПараметрыТовара.Вставить("ПогрешностьСуммаПродажи", 0);

		Если ПараметрыТовара.ТипНоменклатуры = ПредопределенноеЗначение("Перечисление.ТипыНоменклатуры.Услуга")
			Или ПараметрыТовара.ТипНоменклатуры = ПредопределенноеЗначение("Перечисление.ТипыНоменклатуры.Работа") Тогда
			ПараметрыТовара.Склад = ПредопределенноеЗначение("Справочник.Склады.ПустаяСсылка");
		КонецЕсли;

		Если ДополнительныеПараметры.Свойство("ВидЦены") Тогда
			ПараметрыТовара.ВидЦены = ДополнительныеПараметры.ВидЦены;
		Иначе
			ПараметрыТовара.ВидЦены =ПредопределенноеЗначение("Справочник.ВидыЦен.ПустаяСсылка");
		КонецЕсли;

		Если ПараметрыТовара.КоличествоУпаковок <> 0 И ОбщаяСтоимость <> 0 Тогда
			ПараметрыТовара.Цена = Окр(((Стоимость / ОбщаяСтоимость) * СуммаКРаспределению)
				/ ПараметрыТовара.КоличествоУпаковок, 2);
			ПараметрыТовара.Вставить("ЦенаПродажи", Окр(((Стоимость / ОбщаяСтоимость) * СуммаПродажиКРаспределению)
				/ ПараметрыТовара.КоличествоУпаковок, 2));	
			ПараметрыТовара.Вставить("Комиссия", Окр(((Стоимость / ОбщаяСтоимость) * СуммаКомиссииКРаспределению
				/ ПараметрыТовара.КоличествоУпаковок), 2));
		Иначе
			ПараметрыТовара.Цена = 0;
			ПараметрыТовара.Вставить("ЦенаПродажи", 0);
			ПараметрыТовара.Вставить("Комиссия", 0);
		КонецЕсли;

		ОбщаяСтоимость = ОбщаяСтоимость - Стоимость;
		СуммаКРаспределению 		= СуммаКРаспределению - ПараметрыТовара.Цена * ПараметрыТовара.КоличествоУпаковок;
		СуммаПродажиКРаспределению 	= СуммаПродажиКРаспределению - ПараметрыТовара.ЦенаПродажи * ПараметрыТовара.КоличествоУпаковок;
		СуммаКомиссииКРаспределению = СуммаКомиссииКРаспределению - ПараметрыТовара.Комиссия
			* ПараметрыТовара.КоличествоУпаковок;

		ПараметрыТовара.Доступно = ТекущаяСтрока.Доступно;
		ПараметрыТовара.ВНаличии = ТекущаяСтрока.ВНаличии;

		ПараметрыТовара.ХарактеристикиИспользуются = ?(ЗначениеЗаполнено(ПараметрыТовара.Характеристика), Истина, Ложь);

		СлужебнаяСтрока = СлужебнаяТЧ.Добавить();
		СлужебнаяСтрока.СтрокаТЧ = ПараметрыТовара;
		СлужебнаяСтрока.НомерСтроки = ТекущаяСтрока.НомерСтроки;

	КонецЦикла;

	Если (СуммаКРаспределению <> 0 Или СуммаПродажиКРаспределению <> 0 Или СуммаКомиссииКРаспределению <> 0) И СлужебнаяТЧ.Количество() > 0 Тогда

		ПоследняяСтрока = СлужебнаяТЧ[СлужебнаяТЧ.Количество() - 1];
		ИсходнаяСтрока = ПоследняяСтрока.СтрокаТЧ;
		ИсходнаяСтрока.Погрешность 				= СуммаКРаспределению;
		ИсходнаяСтрока.ПогрешностьСуммаПродажи 	= СуммаПродажиКРаспределению;
		ИсходнаяСтрока.ПогрешностьКомиссия 		= СуммаКомиссииКРаспределению;

	КонецЕсли;

	СлужебнаяТЧ.Сортировать("НомерСтроки Возр");
	Для Каждого СтрокаТЧ Из СлужебнаяТЧ Цикл
		ПодобранныеТовары.Добавить(СтрокаТЧ.СтрокаТЧ);
	КонецЦикла;

	Возврат ПодобранныеТовары;

КонецФункции //- ИнфоСофт Стояк Ю.К. 04.05.2023 УА #58008

//+ ИнфоСофт Стояк Ю.К. 04.05.2023 УА #58008
Функция ВариантКомплектацииНоменклатурыПоУмолчанию(Знач Номенклатура, Знач Характеристика)

	ВариантКомплектацииНоменклатуры = Неопределено;

	Если Характеристика = Неопределено Тогда
		Характеристика = ПредопределенноеЗначение("Справочник.ХарактеристикиНоменклатуры.ПустаяСсылка");
	КонецЕсли;

	Запрос = Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ 1
						  |	ВариантыКомплектацииНоменклатуры.Ссылка КАК ВариантКомплектацииНоменклатуры
						  |ИЗ
						  |	Справочник.ВариантыКомплектацииНоменклатуры КАК ВариантыКомплектацииНоменклатуры
						  |ГДЕ
						  |	ВариантыКомплектацииНоменклатуры.Владелец = &Владелец
						  |	И ВариантыКомплектацииНоменклатуры.Характеристика = &Характеристика
						  |
						  |УПОРЯДОЧИТЬ ПО
						  |	ВариантыКомплектацииНоменклатуры.Основной УБЫВ,
						  |	ВариантыКомплектацииНоменклатуры.ПометкаУдаления");

	Запрос.УстановитьПараметр("Владелец", Номенклатура);
	Запрос.УстановитьПараметр("Характеристика", Характеристика);

	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		ВариантКомплектацииНоменклатуры = Выборка.ВариантКомплектацииНоменклатуры;
	КонецЕсли;

	Возврат ВариантКомплектацииНоменклатуры;

КонецФункции //- ИнфоСофт Стояк Ю.К. 04.05.2023 УА #58008

//+ ИнфоСофт Стояк Ю.К. 04.05.2023 УА #58008
Функция КоэффициентыРаспределенияПоДолям(ТабличнаяЧасть, Параметры)

	Запрос = Новый Запрос("ВЫБРАТЬ
						  |	Таблица.НомерСтроки                                       КАК НомерСтроки,
						  |	Таблица.НоменклатураНабора                                КАК НоменклатураНабора,
						  |	Таблица.ХарактеристикаНабора                              КАК ХарактеристикаНабора,
						  |	Таблица.Номенклатура                                      КАК Номенклатура,
						  |	Таблица.Характеристика                                    КАК Характеристика,
						  |	Таблица.Упаковка                                          КАК Упаковка,
						  |	Таблица.Количество                                        КАК Количество,
						  |	Таблица.КоличествоУпаковок                                КАК КоличествоУпаковок
						  |ПОМЕСТИТЬ Таблица
						  |ИЗ
						  |	&ТабличнаяЧасть КАК Таблица
						  |;
						  |
						  |//////////////////////////
						  |ВЫБРАТЬ
						  |	Таблица.НомерСтроки                                       КАК НомерСтроки,
						  |	Таблица.НоменклатураНабора                                КАК НоменклатураНабора,
						  |	Таблица.ХарактеристикаНабора                              КАК ХарактеристикаНабора,
						  |	Таблица.Номенклатура                                      КАК Номенклатура,
						  |	Таблица.Характеристика                                    КАК Характеристика,
						  |	Таблица.Упаковка                                          КАК Упаковка,
						  |	Таблица.Количество                                        КАК Количество,
						  |	Таблица.КоличествоУпаковок                                КАК КоличествоУпаковок,
						  |	ВариантыКомплектацииНоменклатуры.Ссылка                   КАК ВариантыКомплектацииНоменклатуры,
						  |	ВариантыКомплектацииНоменклатуры.ВариантРасчетаЦеныНабора КАК ВариантРасчетаЦеныНабора
						  |ПОМЕСТИТЬ ТаблицаСВариантамиКомплектации
						  |ИЗ
						  |	Таблица КАК Таблица
						  |		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ВариантыКомплектацииНоменклатуры КАК ВариантыКомплектацииНоменклатуры
						  |		ПО Таблица.НоменклатураНабора = ВариантыКомплектацииНоменклатуры.Владелец
						  |			И Таблица.ХарактеристикаНабора = ВариантыКомплектацииНоменклатуры.Характеристика
						  |			И ВариантыКомплектацииНоменклатуры.Основной
						  |;
						  |
						  |/////
						  |ВЫБРАТЬ
						  |	Товары.Ссылка            КАК ВариантыКомплектацииНоменклатуры,
						  |	Товары.Номенклатура      КАК Номенклатура,
						  |	Товары.Характеристика    КАК Характеристика,
						  |	СУММА(ВЫБОР
						  |			КОГДА Товары.Количество <> 0
						  |				ТОГДА Выбор Когда Товары.ДоляСтоимости = 0 Тогда 1 Иначе  Товары.ДоляСтоимости Конец/ Товары.Количество
						  |			ИНАЧЕ 0
						  |		КОНЕЦ) КАК ДоляСтоимости
						  |ПОМЕСТИТЬ ДолиСтоимости
						  |ИЗ
						  |	Справочник.ВариантыКомплектацииНоменклатуры.Товары КАК Товары
						  |
						  |СГРУППИРОВАТЬ ПО
						  |	Товары.Номенклатура,
						  |	Товары.Характеристика,
						  |	Товары.Ссылка
						  |;
						  |
						  |/////
						  |ВЫБРАТЬ
						  |	Таблица.НомерСтроки                                           КАК НомерСтроки,
						  |	Таблица.НоменклатураНабора                                    КАК НоменклатураНабора,
						  |	Таблица.ХарактеристикаНабора                                  КАК ХарактеристикаНабора,
						  |	Таблица.Номенклатура                                          КАК Номенклатура,
						  |	Таблица.Характеристика                                        КАК Характеристика,
						  |	Таблица.Упаковка                                              КАК Упаковка,
						  |	Таблица.Количество                                            КАК Количество,
						  |	Таблица.КоличествоУпаковок                                    КАК КоличествоУпаковок,
						  |	ВЫРАЗИТЬ(Таблица.Количество * ЕСТЬNULL(ДолиСтоимости.ДоляСтоимости, 0) КАК Число(15,2)) КАК Цена,
						  |	Таблица.ВариантыКомплектацииНоменклатуры                      КАК ВариантыКомплектацииНоменклатуры,
						  |	Таблица.ВариантРасчетаЦеныНабора                              КАК ВариантРасчетаЦеныНабора
						  |ИЗ
						  |	ТаблицаСВариантамиКомплектации КАК Таблица
						  |		ЛЕВОЕ СОЕДИНЕНИЕ ДолиСтоимости КАК ДолиСтоимости
						  |		ПО ДолиСтоимости.ВариантыКомплектацииНоменклатуры = Таблица.ВариантыКомплектацииНоменклатуры
						  |			И Таблица.Номенклатура = ДолиСтоимости.Номенклатура
						  |			И Таблица.Характеристика = ДолиСтоимости.Характеристика
						  |");
	
	// Выгрузить из таблицы источника
	Если ТипЗнч(ТабличнаяЧасть) = Тип("ТаблицаЗначений") Тогда
		Запрос.Параметры.Вставить("ТабличнаяЧасть", ТабличнаяЧасть.Скопировать());
	Иначе
		Запрос.Параметры.Вставить("ТабличнаяЧасть", ТабличнаяЧасть.Выгрузить());
	КонецЕсли;

	ПараметрыРасчета = Новый Структура;
	Для Каждого Параметр Из Параметры Цикл
		ПараметрыРасчета.Вставить(Параметр.Ключ, Параметр.Значение);
	КонецЦикла;
	ПараметрыРасчета.Вставить("РассчитыватьНаборы", Ложь);

	ТЧ = Запрос.Выполнить().Выгрузить();

	Для Каждого СтрокаТЧ Из ТЧ Цикл
		СтрокаТЧ.Цена = Окр(СтрокаТЧ.Цена * СтрокаТЧ.КоличествоУпаковок, 2);
	КонецЦикла;

	Возврат ТЧ;

КонецФункции //- ИнфоСофт Стояк Ю.К. 04.05.2023 УА #58008

//+ ИнфоСофт Сумин Д.В. 23.08.2023 УА #61252
Функция ПолучитьКомплектующие(Параметры, ДополнительныеПараметры)
	
	УстановитьПривилегированныйРежим(Истина);
	
	Если Не ЗначениеЗаполнено(Параметры.ВариантКомплектацииНоменклатуры) Тогда
		ВариантКомплектацииНоменклатуры = ВариантКомплектацииНоменклатурыПоУмолчанию(
		Параметры.НоменклатураНабора, Параметры.ХарактеристикаНабора);
	Иначе
		ВариантКомплектацииНоменклатуры = Параметры.ВариантКомплектацииНоменклатуры;
	КонецЕсли;
	
	Если Не Параметры.Свойство("КоличествоУпаковок") Тогда
		Параметры.Вставить("КоличествоУпаковок", 1);
	КонецЕсли;
	
	ПодобранныеТовары = Новый Массив;
	
	Если Не ЗначениеЗаполнено(ВариантКомплектацииНоменклатуры) Тогда
		ТекстОшибки = СтрШаблон("Для номенклатуры %1 %2 не определен состав набора", Параметры.НоменклатураНабора,
		Параметры.ХарактеристикаНабора);
		ОбщегоНазначения.СообщитьПользователю(ТекстОшибки);
		Возврат ПодобранныеТовары;
	КонецЕсли;
	
	Колонки = Новый Массив;
	Колонки.Добавить("НомерСтроки");
	Колонки.Добавить("НоменклатураКомплекта");
	Колонки.Добавить("ХарактеристикаКомплекта");
	Колонки.Добавить("Номенклатура");
	Колонки.Добавить("Характеристика");
	Колонки.Добавить("Цена");
	Колонки.Добавить("ВидЦены");
	Колонки.Добавить("Упаковка");
	Колонки.Добавить("Количество");
	Колонки.Добавить("КоличествоУпаковок");
	Колонки.Добавить("ПроцентРучнойСкидки");
	Колонки.Добавить("СуммаРучнойСкидки");
	Колонки.Добавить("Доступно");
	Колонки.Добавить("ВНаличии");
	
	Комплектующие = НаборыСервер.СоздатьТаблицуСоставаНабора(Колонки);
	Комплектующие.Колонки.Добавить("ТипНоменклатуры", Новый ОписаниеТипов("ПеречислениеСсылка.ТипыНоменклатуры"));
	Комплектующие.Колонки.Добавить("ВидНоменклатуры", Новый ОписаниеТипов("СправочникСсылка.ВидыНоменклатуры"));
	Комплектующие.Колонки.Добавить("ЕдиницаИзмерения", Новый ОписаниеТипов("СправочникСсылка.УпаковкиЕдиницыИзмерения"));
	Комплектующие.Колонки.Добавить("Комиссия", Новый ОписаниеТипов("Число"));
	
	Запрос = Новый Запрос("ВЫБРАТЬ
	|	ВариантыКомплектацииНоменклатурыТовары.НомерСтроки КАК НомерСтроки,
	|	ВариантыКомплектацииНоменклатурыТовары.Номенклатура КАК Номенклатура,
	|	ВариантыКомплектацииНоменклатурыТовары.Номенклатура.ТипНоменклатуры КАК ТипНоменклатуры,
	|	ВариантыКомплектацииНоменклатурыТовары.Номенклатура.ЕдиницаИзмерения КАК ЕдиницаИзмерения,
	|	ВариантыКомплектацииНоменклатурыТовары.Номенклатура.ВидНоменклатуры КАК ВидНоменклатуры,
	|	ВариантыКомплектацииНоменклатурыТовары.Характеристика КАК Характеристика,
	|	ВариантыКомплектацииНоменклатурыТовары.Упаковка КАК Упаковка,
	|	ВариантыКомплектацииНоменклатурыТовары.КоличествоУпаковок КАК КоличествоУпаковок,
	|	ВариантыКомплектацииНоменклатурыТовары.Количество КАК Количество,
	|	ВариантыКомплектацииНоменклатурыТовары.ДоляСтоимости КАК ДоляСтоимости,
	|	СУММА(ЕСТЬNULL(ДоступностьТоваров.ВНаличии, 0) / ЕСТЬNULL(&ТекстЗапросаКоэффициентУпаковки, 1)) КАК ВНаличии,
	|	СУММА(ЕСТЬNULL(ДоступностьТоваров.Свободно, 0) / ЕСТЬNULL(&ТекстЗапросаКоэффициентУпаковки, 1)) КАК Доступно
	|ИЗ
	|	Справочник.ВариантыКомплектацииНоменклатуры.Товары КАК ВариантыКомплектацииНоменклатурыТовары
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.РаспределениеЗапасов КАК ДоступностьТоваров
	|		ПО ДоступностьТоваров.Номенклатура = ВариантыКомплектацииНоменклатурыТовары.Номенклатура
	|			И ДоступностьТоваров.Характеристика = ВариантыКомплектацииНоменклатурыТовары.Характеристика
	|			И ДоступностьТоваров.Состояние = ЗНАЧЕНИЕ(Перечисление.РаспределениеЗапасовСостояния.ОстатокНаСкладе)
	|			И ДоступностьТоваров.Назначение = ЗНАЧЕНИЕ(Справочник.Назначения.ПустаяСсылка)
	|			И &ФильтрСклады
	|ГДЕ
	|	ВариантыКомплектацииНоменклатурыТовары.Ссылка = &Ссылка
	|
	|СГРУППИРОВАТЬ ПО
	|	ВариантыКомплектацииНоменклатурыТовары.Характеристика,
	|	ВариантыКомплектацииНоменклатурыТовары.Упаковка,
	|	ВариантыКомплектацииНоменклатурыТовары.Номенклатура,
	|	ВариантыКомплектацииНоменклатурыТовары.НомерСтроки,
	|	ВариантыКомплектацииНоменклатурыТовары.Номенклатура.ТипНоменклатуры,
	|	ВариантыКомплектацииНоменклатурыТовары.Номенклатура.ЕдиницаИзмерения,
	|	ВариантыКомплектацииНоменклатурыТовары.Номенклатура.ВидНоменклатуры,
	|	ВариантыКомплектацииНоменклатурыТовары.КоличествоУпаковок,
	|	ВариантыКомплектацииНоменклатурыТовары.Количество,
	|	ВариантыКомплектацииНоменклатурыТовары.ДоляСтоимости");
	
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "&ТекстЗапросаКоэффициентУпаковки",
	Справочники["УпаковкиЕдиницыИзмерения"].ТекстЗапросаКоэффициентаУпаковки(
	"ВЫРАЗИТЬ(ВариантыКомплектацииНоменклатурыТовары.Упаковка КАК Справочник.УпаковкиЕдиницыИзмерения)",
	"ВЫРАЗИТЬ(ВариантыКомплектацииНоменклатурыТовары.Номенклатура КАК Справочник.Номенклатура)"));
	
	Запрос.УстановитьПараметр("Ссылка", ВариантКомплектацииНоменклатуры);
	
	Если ДополнительныеПараметры.Свойство("Склады") Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&ФильтрСклады", "ДоступностьТоваров.Склад В (&Склады)");
		Запрос.УстановитьПараметр("Склады", ДополнительныеПараметры.Склады);
	Иначе
		Запрос.УстановитьПараметр("ФильтрСклады", Истина);
	КонецЕсли;
	
	РезультатЗапроса = Запрос.Выполнить();
	Выборка = РезультатЗапроса.Выбрать();
	Пока Выборка.Следующий() Цикл
		
		НоваяСтрока = Комплектующие.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, Выборка);
		НоваяСтрока.КоличествоУпаковок   = НоваяСтрока.КоличествоУпаковок;
		НоваяСтрока.Количество           = НоваяСтрока.Количество;
		НоваяСтрока.НоменклатураНабора   = Параметры.НоменклатураНабора;
		НоваяСтрока.ХарактеристикаНабора = Параметры.ХарактеристикаНабора;
		
	КонецЦикла;
	Если ПолучитьФункциональнуюОпцию("ИспользоватьСоглашенияСКлиентами") И ДополнительныеПараметры.Свойство("Соглашение")
		И ЗначениеЗаполнено(ДополнительныеПараметры.Соглашение) Тогда
		
		ПараметрыРасчета = Новый Структура;
		ПараметрыРасчета.Вставить("Дата", ДополнительныеПараметры.Дата);
		ПараметрыРасчета.Вставить("Валюта", ДополнительныеПараметры.Валюта);
		ПараметрыРасчета.Вставить("Соглашение", ДополнительныеПараметры.Соглашение);
		ПараметрыРасчета.Вставить("ПоляЗаполнения", "Цена");
		
	Иначе
		
		ПараметрыРасчета = Новый Структура;
		ПараметрыРасчета.Вставить("Дата", ДополнительныеПараметры.Дата);
		ПараметрыРасчета.Вставить("Валюта", ДополнительныеПараметры.Валюта);
		ПараметрыРасчета.Вставить("ВидЦены", ДополнительныеПараметры.ВидЦены);
		ПараметрыРасчета.Вставить("ПоляЗаполнения", "Цена");
		
	КонецЕсли;
	
	КоэффициентыПропорциональностиРасчетаЦенНаборов = КоэффициентыРаспределенияПоДолям(Комплектующие.Скопировать(),
	ПараметрыРасчета);
	
	ОбщаяСтоимость = 0;
	Для Каждого ТекущаяСтрока Из КоэффициентыПропорциональностиРасчетаЦенНаборов Цикл
		ОбщаяСтоимость = ОбщаяСтоимость + ТекущаяСтрока.Цена;
	КонецЦикла;
	
	СуммаКРаспределению = ДополнительныеПараметры.Цена * Параметры.КоличествоУпаковок;
	
	СлужебнаяТЧ = Новый ТаблицаЗначений;
	СлужебнаяТЧ.Колонки.Добавить("СтрокаТЧ");
	СлужебнаяТЧ.Колонки.Добавить("НомерСтроки");
	
	Комплектующие.Сортировать("КоличествоУпаковок Убыв");
	Для Каждого ТекущаяСтрока Из Комплектующие Цикл
		
		Стоимость = КоэффициентыПропорциональностиРасчетаЦенНаборов.Найти(ТекущаяСтрока.НомерСтроки, "НомерСтроки").Цена;
		
		ПараметрыТовара = ПодборТоваровКлиентСервер.ПараметрыТовара();
		ЗаполнитьЗначенияСвойств(ПараметрыТовара, Параметры);
		
		ПараметрыТовара.Номенклатура       = ТекущаяСтрока.Номенклатура;
		ПараметрыТовара.Характеристика     = ТекущаяСтрока.Характеристика;
		ПараметрыТовара.Упаковка           = ТекущаяСтрока.Упаковка;
		ПараметрыТовара.ТипНоменклатуры    = ТекущаяСтрока.ТипНоменклатуры;
		ПараметрыТовара.ВидНоменклатуры    = ТекущаяСтрока.ВидНоменклатуры;
		ПараметрыТовара.ЕдиницаИзмерения   = ТекущаяСтрока.ЕдиницаИзмерения;
		ПараметрыТовара.КоличествоУпаковок = ТекущаяСтрока.КоличествоУпаковок * Параметры.КоличествоУпаковок;
		ПараметрыТовара.Количество         = ТекущаяСтрока.Количество * Параметры.КоличествоУпаковок;
		ПараметрыТовара.Вставить("ПогрешностьКомиссия", 0);
		ПараметрыТовара.Вставить("ПогрешностьСуммаПродажи", 0);
		
		Если ПараметрыТовара.ТипНоменклатуры = ПредопределенноеЗначение("Перечисление.ТипыНоменклатуры.Услуга")
			Или ПараметрыТовара.ТипНоменклатуры = ПредопределенноеЗначение("Перечисление.ТипыНоменклатуры.Работа") Тогда
			ПараметрыТовара.Склад = ПредопределенноеЗначение("Справочник.Склады.ПустаяСсылка");
		КонецЕсли;
		
		Если ДополнительныеПараметры.Свойство("ВидЦены") Тогда
			ПараметрыТовара.ВидЦены = ДополнительныеПараметры.ВидЦены;
		Иначе
			ПараметрыТовара.ВидЦены =ПредопределенноеЗначение("Справочник.ВидыЦен.ПустаяСсылка");
		КонецЕсли;
		
		Если ПараметрыТовара.КоличествоУпаковок <> 0 И ОбщаяСтоимость <> 0 Тогда
			ПараметрыТовара.Цена = Окр(((Стоимость / ОбщаяСтоимость) * СуммаКРаспределению)
			/ ПараметрыТовара.КоличествоУпаковок, 2);
		Иначе
			ПараметрыТовара.Цена = 0;
		КонецЕсли;
		
		ОбщаяСтоимость = ОбщаяСтоимость - Стоимость;
		СуммаКРаспределению 		= СуммаКРаспределению - ПараметрыТовара.Цена * ПараметрыТовара.КоличествоУпаковок;
		
		ПараметрыТовара.Доступно = ТекущаяСтрока.Доступно;
		ПараметрыТовара.ВНаличии = ТекущаяСтрока.ВНаличии;
		
		ПараметрыТовара.ХарактеристикиИспользуются = ?(ЗначениеЗаполнено(ПараметрыТовара.Характеристика), Истина, Ложь);
		
		СлужебнаяСтрока = СлужебнаяТЧ.Добавить();
		СлужебнаяСтрока.СтрокаТЧ = ПараметрыТовара;
		СлужебнаяСтрока.НомерСтроки = ТекущаяСтрока.НомерСтроки;
		
	КонецЦикла;
	
	Если СуммаКРаспределению <> 0 И СлужебнаяТЧ.Количество() > 0 Тогда
		
		ПоследняяСтрока = СлужебнаяТЧ[СлужебнаяТЧ.Количество() - 1];
		ИсходнаяСтрока = ПоследняяСтрока.СтрокаТЧ;
		ИсходнаяСтрока.Погрешность 				= СуммаКРаспределению;
		
	КонецЕсли;
	
	СлужебнаяТЧ.Сортировать("НомерСтроки Возр");
	Для Каждого СтрокаТЧ Из СлужебнаяТЧ Цикл
		ПодобранныеТовары.Добавить(СтрокаТЧ.СтрокаТЧ);
	КонецЦикла;
	
	Возврат ПодобранныеТовары;
	
КонецФункции //- ИнфоСофт Сумин Д.В. 23.08.2023 УА #61252

//+ ИнфоСофт Сумин Д.В. 04.08.2023 УА #61481
Процедура ВыполнитьАлгоритмПроверкиТоваровНаКомплект(ЗаказКлиента, Склад) Экспорт 
	
	ЗапросНазначений = Новый Запрос;
	ЗапросНазначений.Текст = 
	"ВЫБРАТЬ
	|	ЕСТЬNULL(Назначения.Ссылка, ЗНАЧЕНИЕ(Справочник.Назначения.ПустаяСсылка)) КАК Назначение
	|ИЗ
	|	Справочник.ИС_ЯМ_Склады.НаправленияДеятельности КАК ИС_ЯМ_СкладыНаправленияДеятельности
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Назначения КАК Назначения
	|		ПО ИС_ЯМ_СкладыНаправленияДеятельности.НаправлениеДеятельности = Назначения.НаправлениеДеятельности
	|			И (Назначения.НаправлениеДеятельности <> ЗНАЧЕНИЕ(Справочник.НаправленияДеятельности.ПустаяСсылка))
	|ГДЕ
	|	ИС_ЯМ_СкладыНаправленияДеятельности.Ссылка = &Ссылка";
	
	ЗапросНазначений.УстановитьПараметр("Ссылка", Склад);
	
	РезультатЗапросаНазначений = ЗапросНазначений.Выполнить();
	
	Назначения = Новый Массив;
	
	ВыборкаНазначения = РезультатЗапросаНазначений.Выбрать();
	
	Пока ВыборкаНазначения.Следующий() Цикл 
		Если ВыборкаНазначения.Назначение <> Справочники.Назначения.ПустаяСсылка() Тогда 
			Назначения.Добавить(ВыборкаНазначения.Назначение);
		КонецЕсли;
	КонецЦикла;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ТоварыВзаказе.Номенклатура КАК Номенклатура,
	|	ТоварыВзаказе.Характеристика КАК Характеристика
	|ПОМЕСТИТЬ ВТ_ТоварыВЗаказе
	|ИЗ
	|	&ТоварыВзаказе КАК ТоварыВзаказе
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	МАКСИМУМ(ВЫБОР
	|			КОГДА ВариантыКомплектацииНоменклатурыТовары.Номенклатура ЕСТЬ NULL
	|				ТОГДА ЛОЖЬ
	|			ИНАЧЕ ИСТИНА
	|		КОНЕЦ) КАК ЭтоКомплект,
	|	ВТ_ТоварыВЗаказе.Номенклатура КАК Номенклатура
	|ПОМЕСТИТЬ ВТ_Комплектация
	|ИЗ
	|	ВТ_ТоварыВЗаказе КАК ВТ_ТоварыВЗаказе
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ВариантыКомплектацииНоменклатуры.Товары КАК ВариантыКомплектацииНоменклатурыТовары
	|		ПО (ВТ_ТоварыВЗаказе.Номенклатура = ВариантыКомплектацииНоменклатурыТовары.Ссылка.Владелец
	|				И ВариантыКомплектацииНоменклатурыТовары.Ссылка.Владелец.ТипНоменклатуры <> ЗНАЧЕНИЕ(Перечисление.ТипыНоменклатуры.Набор))
	|
	|СГРУППИРОВАТЬ ПО
	|	ВТ_ТоварыВЗаказе.Номенклатура
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	РаспределениеЗапасов.Свободно КАК КомплектСвободно,
	|	ВТ_Комплектация.Номенклатура КАК Номенклатура
	|ПОМЕСТИТЬ ВТ_КомплектОстаток
	|ИЗ
	|	ВТ_Комплектация КАК ВТ_Комплектация
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.РаспределениеЗапасов КАК РаспределениеЗапасов
	|		ПО ВТ_Комплектация.Номенклатура = РаспределениеЗапасов.Номенклатура
	|ГДЕ
	|	РаспределениеЗапасов.Склад В(&Склад)
	|	И РаспределениеЗапасов.Назначение В(&Назначение)
	|	И РаспределениеЗапасов.Состояние = ЗНАЧЕНИЕ(Перечисление.РаспределениеЗапасовСостояния.ОстатокНаСкладе)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ЕСТЬNULL(ВТ_КомплектОстаток.КомплектСвободно, 0) КАК КомплектСвободно,
	|	ВТ_Комплектация.ЭтоКомплект КАК ЭтоКомплект,
	|	ВТ_Комплектация.Номенклатура КАК Номенклатура
	|ИЗ
	|	ВТ_Комплектация КАК ВТ_Комплектация
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_КомплектОстаток КАК ВТ_КомплектОстаток
	|		ПО ВТ_Комплектация.Номенклатура = ВТ_КомплектОстаток.Номенклатура";  
	
	Запрос.УстановитьПараметр("ТоварыВЗаказе", ЗаказКлиента.Товары);
	Запрос.УстановитьПараметр("Склад", ЗаказКлиента.Склад);
	Запрос.УстановитьПараметр("Назначение", Назначения);
	
	РезультатЗапроса = Запрос.Выполнить();	
	
	ДанныеКомплектов = РезультатЗапроса.Выгрузить();
	
	Если Не ДанныеКомплектов[0].ЭтоКомплект Или ДанныеКомплектов[0].КомплектСвободно > 0 Тогда
		Возврат;	
	КонецЕсли;
	
	СоздатьЗаказНаСборкуКомплектов(ЗаказКлиента, Склад);	
	
КонецПроцедуры //- ИнфоСофт Сумин Д.В. 04.08.2023 УА #61481

//+ ИнфоСофт Сумин Д.В. 04.08.2023 УА #61481
Процедура СоздатьЗаказНаСборкуКомплектов(ЗаказКлиента, Склад)
	
	ЗаказНаСборку = Документы.ЗаказНаСборку.СоздатьДокумент(); 
	ЗаказНаСборку.Комментарий = ЗаказКлиента.Комментарий; 
	ЗаказНаСборку.Дата = ЗаказКлиента.Дата;
	ЗаказНаСборку.Подразделение = ЗаказКлиента.Подразделение;  
	
	СтруктураДанных = Новый Структура;
	СтруктураДанных.Вставить("АдресТовары", ПоместитьВоВременноеХранилище(ЗаказКлиента.Товары.Выгрузить(), Новый УникальныйИдентификатор)); 
	СтруктураДанных.Вставить("Основание", ЗаказКлиента.Ссылка);
	СтруктураДанных.Вставить("Склад", ЗаказКлиента.Склад);
	
	ЗаказНаСборку.Заполнить(СтруктураДанных);
	
	ЗаказНаСборку.Организация = ЗаказКлиента.Организация;
	
	ЗаказНаСборку.Статус = Перечисления.СтатусыВнутреннихЗаказов.КВыполнению;  
	
	ЗаказНаСборку.ДокументОснование = ЗаказКлиента.Ссылка;
	
	ЗаказНаСборку.Подразделение = ЗаказКлиента.Подразделение;
	
	ЗаказНаСборку.НачалоСборкиРазборки = ЗаказКлиента.Дата;
	ЗаказНаСборку.ОкончаниеСборкиРазборки = ЗаказКлиента.Дата; 
	
	ОбеспечиватьОбособленно = ЗаказКлиента.Соглашение.ОбеспечиватьЗаказыОбособленно;
	НаправленияДеятельностиИспользуются = Склад.НаправленияДеятельности.Количество() > 0;
	
	Если ОбеспечиватьОбособленно И НаправленияДеятельностиИспользуются Тогда
		ЗаказНаСборку.НаправлениеДеятельности = ЗаказКлиента.Договор.НаправлениеДеятельности;	
		ЗаказНаСборку.Назначение = Справочники.Назначения.НайтиПоРеквизиту("НаправлениеДеятельности", ЗаказКлиента.Договор.НаправлениеДеятельности);

	КонецЕсли;	
	
	Для Каждого Элемент Из ЗаказНаСборку.Товары Цикл
		Элемент.ВариантОбеспечения = Перечисления.ВариантыОбеспечения.Отгрузить;
		Если ОбеспечиватьОбособленно И НаправленияДеятельностиИспользуются Тогда
			Элемент.Обособленно = Истина;		
		КонецЕсли;
	КонецЦикла;
	//Если используется обособление, то сначала выполняется попытка проведения с обособлением товара. При неудаче выполняется поптыка проведения без обособления. 
	Попытка
		ЗаказНаСборку.Записать(РежимЗаписиДокумента.Проведение);	
	Исключение 
		
		Если ОбеспечиватьОбособленно И НаправленияДеятельностиИспользуются Тогда	
			Попытка
				Для Каждого Элемент Из ЗаказНаСборку.Товары Цикл
					Элемент.Обособленно = Ложь;		
				КонецЦикла;	
				ЗаказНаСборку.Записать(РежимЗаписиДокумента.Проведение);
			Исключение
				ЗаказНаСборку.Статус = Перечисления.СтатусыВнутреннихЗаказов.КОбеспечению;
				Для Каждого Элемент Из ЗаказНаСборку.Товары Цикл
					Элемент.ВариантОбеспечения = Перечисления.ВариантыОбеспечения.КОбеспечению;
					Элемент.Обособленно = Ложь;	
					
				КонецЦикла;  
				ЗаписьЖурналаРегистрации("ИС.WB.РазборЗаказов", УровеньЖурналаРегистрации.Ошибка, , , ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
				ЗаказНаСборку.Записать();	
			КонецПопытки;
		Иначе
			ЗаказНаСборку.Статус = Перечисления.СтатусыВнутреннихЗаказов.КОбеспечению;
			Для Каждого Элемент Из ЗаказНаСборку.Товары Цикл
				Элемент.ВариантОбеспечения = Перечисления.ВариантыОбеспечения.КОбеспечению;
				Элемент.Обособленно = Ложь;	
				
			КонецЦикла;  
			ЗаписьЖурналаРегистрации("ИС.WB.РазборЗаказов", УровеньЖурналаРегистрации.Ошибка, , , ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
			ЗаказНаСборку.Записать();
		КонецЕсли;
	КонецПопытки;
	
КонецПроцедуры //- ИнфоСофт Сумин Д.В. 04.08.2023 УА #61481      

//+ ИнфоСофт Сумин Д.В. 20.02.2024 УА #66043
Процедура УстановитьПризнакКГТ(ЯМНоменклатура)
	
	КГТ = Ложь;
	
	Если ЯМНоменклатура.length > 200 Или ЯМНоменклатура.width > 200 Или ЯМНоменклатура.height > 200 Тогда
		КГТ = Истина;	
	КонецЕсли;
	
	Если ЯМНоменклатура.weight > 30 Тогда
		КГТ = Истина;	
	КонецЕсли;
	
	Если ЯМНоменклатура.volume > 0.5 Тогда
		КГТ = Истина;	
	КонецЕсли;
	
	ЯМНоменклатура.КГТ = КГТ;
	
КонецПроцедуры //- ИнфоСофт Сумин Д.В. 20.02.2024 УА #66043

