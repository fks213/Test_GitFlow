			РезультатПроверки = ИС_WB_СерверУТ11_5.ПроверитьСвободныеОстатки(ТоварыЗаказаТЗ, СкладСОстатком, Назначения);
			//- ИнфоСофт Стояк Ю.К. 18.11.2024 УА #74083			
