//+ ИнфоСофт Ивонин К.А. 28.09.23 УА #64020
Функция ПолучитьСписокМагазинов(Профиль) Экспорт
		
	НастройкиСоединения = ПолучитьНастройкиСоединенияПрофиля(Профиль);	
	ПараметрыЗапроса = ИС_MP_РаботаСHTTPЗапросамиСервер.ПолучитьСтруктуруHTTPЗапроса();
    
    Если Не ЗначениеЗаполнено(НастройкиСоединения["ЯМАдресСервисаAPI"]) Тогда
   		ОбщегоНазначения.СообщитьПользователю(
   			"Для данного профиля не заполнен ""Адрес Сервиса Яндекс Маркета"", проверьте настройки авторизации");
   		Возврат Неопределено;
   	КонецЕсли;
   	
   	Если Не ЗначениеЗаполнено(НастройкиСоединения["ЯМТокен"]) Тогда
   		ОбщегоНазначения.СообщитьПользователю(
   			"Для данного профиля не заполнен ""Токен Яндекс Маркета"", проверьте настройки авторизации");
   		Возврат Неопределено;
   	КонецЕсли;
   	    
	ПараметрыЗапроса.Сервер = НастройкиСоединения["ЯМАдресСервисаAPI"];
	ПараметрыЗапроса.Порт = 443;
	ПараметрыЗапроса.ЗащищенноеСоединение = Истина;
	ПараметрыЗапроса.Заголовки.Вставить("Authorization", "Bearer " + НастройкиСоединения["ЯМТокен"]);
	ПараметрыЗапроса.Заголовки.Вставить("Api-Key", НастройкиСоединения["ЯМТокен"]);
				
	Возврат ИС_ЯМ_API.ПолучитьСписокМагазинов(Профиль, ПараметрыЗапроса);
	
КонецФункции //- ИнфоСофт Ивонин К.А. 28.09.23 УА #64020

