//+ ИнфоСофт Стояк Ю.К. 13.05.2024 УА #62574
Процедура ЗаполнитьЗначениеКолонки(Выборка, СтрокаТаблицы, РазделительФотографий, ИмяЗаполняемойКолонки) Экспорт

	Если ЗначениеЗаполнено(Выборка.ИС_ЯМ_ХарактеристикаКод) Тогда
		ИмяКолонки = "Атрибут_" + СтрЗаменить(Строка(Выборка.ИС_ЯМ_ХарактеристикаКод), Символы.НПП, "");
	Иначе
		ИмяКолонки = Выборка.ХарактеристикаЯМ;
	КонецЕсли;

	Если Не СтрокаТаблицы.Свойство(ИмяКолонки) Или (ЗначениеЗаполнено(ИмяЗаполняемойКолонки) И ИмяКолонки
		<> ИмяЗаполняемойКолонки) Тогда
		Возврат;
	КонецЕсли;
	
	Если Выборка.ВидРеквизита1С = ПредопределенноеЗначение(
		"Перечисление.ИС_Ozon_ВидРеквизитаСопоставления.ШтрихкодНоменклатуры") Тогда
		ЗначениеХарактеристикиЯМ = СтрокаТаблицы.Штрихкод;
	ИначеЕсли ЗначениеЗаполнено(Выборка.ТекстоваяСтрока) И Не Выборка.ТребуетсяСопоставление Тогда
		ЗначениеХарактеристикиЯМ = Выборка.ТекстоваяСтрока;
	Иначе
		//+ ИнфоСофт Заварин К.В. 18.05.24 УА #71157
		//ЗначениеХарактеристикиЯМ = Выборка.ЗначениеХарактеристикиЯМ;
		Если Выборка.Множитель <> 0 Тогда
			ЗначениеХарактеристикиЯМ = Выборка.ЗначениеХарактеристикиЯМ * Выборка.Множитель;
		Иначе
			ЗначениеХарактеристикиЯМ = Выборка.ЗначениеХарактеристикиЯМ;
		КонецЕсли;
		//- ИнфоСофт Заварин К.В. 18.05.24 УА #71157
	КонецЕсли;
	
	Если ТипЗнч(СтрокаТаблицы[ИмяКолонки]) = Тип("СписокЗначений") Тогда
		Если ТипЗнч(ЗначениеХарактеристикиЯМ) = Тип("Строка") И Выборка.ТребуетсяСопоставление Тогда
			МассивЗначений = ЗначенияХарактеристикЯМИзСтроки(
			ЗначениеХарактеристикиЯМ);
		Иначе
			МассивЗначений = Новый Массив;
			МассивЗначений.Добавить(ЗначениеХарактеристикиЯМ);
		КонецЕсли;
		//КонецЕсли;
		СтрокаТаблицы[ИмяКолонки].ЗагрузитьЗначения(МассивЗначений);
	Иначе
		
		Если ИмяКолонки = "pictures" Тогда
			ЗначениеХарактеристикиЯМ = ИС_Ozon_Сервер.ОбработатьСсылки(ЗначениеХарактеристикиЯМ);
		КонецЕсли;

		Если ТипЗнч(СтрокаТаблицы[ИмяКолонки]) <> ТипЗнч(ЗначениеХарактеристикиЯМ) Тогда

			Если Не ИС_MP_ВыгрузкаКарточек.ЭтоПримитивныйТип(ЗначениеХарактеристикиЯМ) Тогда
				ЗначениеХарактеристикиЯМ = Строка(ЗначениеХарактеристикиЯМ);
			КонецЕсли;
						
			Попытка
				Если ТипЗнч(СтрокаТаблицы[ИмяКолонки]) = Тип("Число") Тогда
					ЗначениеХарактеристикиЯМ = Число(ЗначениеХарактеристикиЯМ);
				КонецЕсли;
			Исключение
			КонецПопытки;
		КонецЕсли;

		СтрокаТаблицы[ИмяКолонки] = ЗначениеХарактеристикиЯМ;

	КонецЕсли;	

КонецПроцедуры //- ИнфоСофт Стояк Ю.К. 13.05.2024 УА #62574

//+ ИнфоСофт Стояк Ю.К. 29.05.2024 УА #65724
Процедура ВыгрузитьКарточкиТовара(Профиль, ТелоЗапроса) Экспорт
	
	НастройкиСоединения = ПолучитьНастройкиСоединенияПрофиля(Профиль);	
	ПараметрыЗапроса = ПроверитьИЗаполнитьПараметрыЗапроса(НастройкиСоединения);
	КодБизнеса = СтрЗаменить(Строка(НастройкиСоединения["ЯМКодБизнеса"]), Символы.НПП, "");
	
	РазбитыйМассив = ИС_MP_Сервер.РазбитьМассивПоNЭлементов(ТелоЗапроса, 500);
	Ошибка = Ложь;
	
	Для Каждого Элемент Из РазбитыйМассив Цикл
				
		//+ ИнфоСофт Стояк Ю.К. 11.06.2024 УА #69782
		//Результат = ИС_ЯМ_API.ВыгрузитьЦеныNEW((Профиль, ПараметрыЗапроса, КодБизнеса, Элемент);
		Результат = ИС_ЯМ_API.ВыгрузитьКарточкиТовара(Профиль, ПараметрыЗапроса, КодБизнеса, Элемент);
		//- ИнфоСофт Стояк Ю.К. 11.06.2024 УА #69782
		
		Если ЗначениеЗаполнено(Результат) Тогда	
			ОбщегоНазначения.СообщитьПользователю("Выгрузка прошла со следующим статусом:" + Результат.status);	
			
			Если Результат.status = "ERROR" Тогда
				
				//+ ИнфоСофт Стояк Ю.К. 11.02.2025 УА #93204
				Для Каждого Товар Из Результат.results Цикл  
				//Для Каждого Товар Из Результат.result Цикл  
				//- ИнфоСофт Стояк Ю.К. 11.02.2025 УА #93204
					
					Для Каждого Ошибка Из Товар.errors Цикл
						ОбщегоНазначения.СообщитьПользователю("По товару с offerId: " + Товар.offerId + "Прооизошла ошибка " + Ошибка);	
					КонецЦикла;
					
				КонецЦикла;
				
			КонецЕсли; 
			
		Иначе			
			ЗаписьЖурналаРегистрации("Не удалось выгрузить карточки товаров!", УровеньЖурналаРегистрации.Ошибка);			
		КонецЕсли;
		
		Счетчик = Счетчик + 1;
		
		Если Счетчик = 10 Тогда
			ИС_MP_Сервер.Пауза(60);
		КонецЕсли;		
		
	КонецЦикла;
	
КонецПроцедуры //- ИнфоСофт Стояк Ю.К. 29.05.2024 УА #65724

//+ ИнфоСофт Стояк Ю.К. 29.10.2024 УА #69482
Функция ПолучитьИнформациюОКарточкахПоАртикулу(Профиль, ТелоЗапроса) Экспорт
	
	НастройкиСоединения = ПолучитьНастройкиСоединенияПрофиля(Профиль);	
	ПараметрыЗапроса = ПроверитьИЗаполнитьПараметрыЗапроса(НастройкиСоединения); 
	
	КоличествоЭлементовНаЗапрос = НастройкиСоединения["КоличествоЭлементовНаЗапрос"];
	КоличествоПопытокЗапроса = НастройкиСоединения["КоличествоОшибокЗапросов"];
	
	КоличествоОшибок = 0;
	СтруктураПараметров = Новый Структура;
	СтруктураПараметров.Вставить("businessId", СтрЗаменить(Строка(НастройкиСоединения["ЯМКодБизнеса"]), Символы.НПП, ""));
		
	Пока Истина Цикл
		
		Если КоличествоОшибок > КоличествоПопытокЗапроса Тогда
			ОбщегоНазначения.СообщитьПользователю("Превышено количество ошибок запросов");
			Возврат Неопределено;
		КонецЕсли;
		
		Результат = ИС_ЯМ_API.ЗагрузитьКарточкиТоваров(Профиль, ПараметрыЗапроса, СтруктураПараметров, ТелоЗапроса); 
		
		Если Результат = Неопределено Тогда
			Возврат Неопределено;
		КонецЕсли;
		
		Возврат Результат;
	КонецЦикла; 
		
КонецФункции //- ИнфоСофт Стояк Ю.К. 29.10.2024 УА #69482

