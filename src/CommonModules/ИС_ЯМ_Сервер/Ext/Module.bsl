//+ ИнфоСофт Сумин Д.В. 22.05.23 УА #58026
Функция ПолучитьНоменклатуруЯМ(shopSku, Профиль)
		
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ИС_ЯМ_Номенклатура.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.ИС_ЯМ_Номенклатура КАК ИС_ЯМ_Номенклатура
	|ГДЕ
	|	ИС_ЯМ_Номенклатура.Профиль = &Профиль
	|	И ИС_ЯМ_Номенклатура.shopSku = &shopSku";
	
	Запрос.УстановитьПараметр("shopSku", shopSku);
	Запрос.УстановитьПараметр("Профиль", Профиль);
	
	РезультатЗапроса = Запрос.Выполнить(); 
	
	Если РезультатЗапроса.Пустой() Тогда
		Возврат Справочники.ИС_ЯМ_Номенклатура.ПустаяСсылка();	
	КонецЕсли;	
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	ВыборкаДетальныеЗаписи.Следующий();
	
	Возврат ВыборкаДетальныеЗаписи.Ссылка;
	
КонецФункции //- ИнфоСофт Сумин Д.В. 22.05.23 УА #58026	

