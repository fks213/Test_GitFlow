//+ ИнфоСофт Сумин Д.В. 21.08.2023 УА #61252
Функция СоздатьДокументВозвратТоваров(СтруктураДанных) Экспорт
	
	УстановитьПривилегированныйРежим(Истина);
	
	ФукнциональныеОпции = ПолучитьНастройкиФункциональностиСборочныхЗвданий(СтруктураДанных.Профиль);
	
	Документ = Документы.ВозвратТоваровОтКлиента.СоздатьДокумент();
	Документ.Дата = СтруктураДанных.Период.ДатаОкончания;
	
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("Партнер", ФукнциональныеОпции.ПартнерЯМ);
	ПараметрыФормы.Вставить("Контрагент", ФукнциональныеОпции.КонтрагентЯМ);
	ПараметрыФормы.Вставить("Договор", ФукнциональныеОпции.ДоговорЯМ);
	
	Документ.Заполнить(ПараметрыФормы);
	
	Документ.Соглашение = ФукнциональныеОпции.СоглашениеЯМ;
	Документ.ХозяйственнаяОперация = Перечисления.ХозяйственныеОперации.ВозвратОтКомиссионера;
	
	Документ.Валюта = Документ.Договор.ВалютаВзаиморасчетов;
	
	Документ.Организация = СтруктураДанных.Профиль.Организация;    
	
	Склад = ПолучитьСкладПоУмолчанию(СтруктураДанных.Профиль).Склад;
	
	Документ.Склад = Склад; 
	
	Документ.ЦенаВключаетНДС = Истина;
	
	//+ ИнфоСофт Тимофеева А.А. 09.04.2025 УА #97337
	//ПродажаОблагаетсяНДС = ИС_WB_СерверУТ11_5.ПолучитьРезультатПроверкиУчетаНДС(СтруктураДанных.Профиль.Организация);
	//
	//Если ПродажаОблагаетсяНДС Тогда
	//	Документ.НалогообложениеНДС = Перечисления.ТипыНалогообложенияНДС.ПродажаОблагаетсяНДС;			
	//Иначе
	//	Документ.НалогообложениеНДС = Перечисления.ТипыНалогообложенияНДС.ПродажаНеОблагаетсяНДС;			
	//КонецЕсли;
	НастройкиУчета = УчетНДСУП.ПараметрыУчетаПоОрганизации(СтруктураДанных.Профиль.Организация, ТекущаяДатаСеанса());
	Документ.НалогообложениеНДС = НастройкиУчета.ОсновноеНалогообложениеНДСПродажи;
	//- ИнфоСофт Тимофеева А.А. 09.04.2025 УА #97337
	
	ЗаполнитьТЧРеализации(Документ, СтруктураДанных.ТаблицаПродаж);
	
	СтруктураДействий = Новый Структура;
	СтруктураДействий.Вставить("ПересчитатьКоличествоЕдиниц");
	СтруктураДействий.Вставить("ЗаполнитьСтавкуНДС", Новый Структура("Организация, НалогообложениеНДС, Дата",
	Документ.Организация, Документ.НалогообложениеНДС, Документ.Дата));
	СтруктураДействий.Вставить("ПересчитатьСуммуНДС",
	ОбработкаТабличнойЧастиКлиентСервер.ПараметрыПересчетаСуммыНДСВСтрокеТЧ(Документ));
	СтруктураДействий.Вставить("ПересчитатьСумму");
	СтруктураДействий.Вставить("ПересчитатьСуммуСНДС", Новый Структура("ЦенаВключаетНДС",
	Документ.ЦенаВключаетНДС));	
	ОбработкаТабличнойЧастиСервер.ОбработатьТЧ(Документ.Товары, СтруктураДействий, Неопределено);	
	
	Попытка
		Документ.Записать(РежимЗаписиДокумента.Проведение); 
	Исключение
		Документ.Записать();
	КонецПопытки; 
	
	УстановитьПривилегированныйРежим(Ложь);
	
	Возврат Документ;
	
КонецФункции //- ИнфоСофт Сумин Д.В. 21.08.2023 УА #61252

//+ ИнфоСофт Сумин Д.В. 23.08.2023 УА #61252
Функция СоздатьДокументВзаимозачетЗадолженности(ОбъектРасчетов, Документ, ОтчетКомиссионера) Экспорт  
	
	ДокументВзаимозачет = Документы.ВзаимозачетЗадолженности.СоздатьДокумент();
	
	ДокументВзаимозачет.Дата = Документ.Дата;
	ДокументВзаимозачет.Организация = Документ.Организация; 
	
	ДокументВзаимозачет.КонтрагентДебитор = Документ.Контрагент;
	ДокументВзаимозачет.КонтрагентКредитор = ОтчетКомиссионера.Контрагент; 
	
	ДокументВзаимозачет.СуммаДокумента = Документ.СуммаДокумента;
	ДокументВзаимозачет.Валюта = Документ.Валюта;
	ДокументВзаимозачет.ВидОперации = Перечисления.ВидыОперацийВзаимозачетаЗадолженности.ПереносДолгаКлиентаМеждуКонтрагентами;
	ДокументВзаимозачет.ТипДебитора = Перечисления.ТипыУчастниковВзаимозачета.Клиент;
	ДокументВзаимозачет.ТипКредитора = Перечисления.ТипыУчастниковВзаимозачета.Клиент;
	ДокументВзаимозачет.СуммаРегл = ИС_WB_СерверУТ11_5.ПересчитатьВСуммуРегл(Документ.СуммаДокумента, Документ.Валюта, Документ.Дата); 
	ДокументВзаимозачет.СуммаУпр = ИС_WB_СерверУТ11_5.ПересчитатьВСуммуУпр(Документ.СуммаДокумента, Документ.Валюта, Документ.Дата); 
	
	ДебиторскаяЗадолженностьТЧ = ДокументВзаимозачет.ДебиторскаяЗадолженность.Добавить();
	ДебиторскаяЗадолженностьТЧ.ТипРасчетов = Перечисления.ТипыРасчетовСПартнерами.РасчетыСКлиентом;
	ДебиторскаяЗадолженностьТЧ.Партнер = Документ.Партнер; 	
	ДебиторскаяЗадолженностьТЧ.ОбъектРасчетов = Справочники.ОбъектыРасчетов.НайтиПоРеквизиту("Объект", ОбъектРасчетов);	
	ДебиторскаяЗадолженностьТЧ.СуммаВзаиморасчетов = Документ.СуммаДокумента;
	ДебиторскаяЗадолженностьТЧ.ВалютаВзаиморасчетов = Документ.Валюта;
	ДебиторскаяЗадолженностьТЧ.Организация = Документ.Организация; 
	ДебиторскаяЗадолженностьТЧ.СуммаРегл = ДокументВзаимозачет.СуммаРегл; 
	ДебиторскаяЗадолженностьТЧ.СуммаУпр = ДокументВзаимозачет.СуммаУпр;
	
	КредиторскаяЗадолженностьТЧ = ДокументВзаимозачет.КредиторскаяЗадолженность.Добавить();
	КредиторскаяЗадолженностьТЧ.ТипРасчетов = Перечисления.ТипыРасчетовСПартнерами.РасчетыСПоставщиком;
	КредиторскаяЗадолженностьТЧ.Партнер = ОтчетКомиссионера.Партнер;
	КредиторскаяЗадолженностьТЧ.ОбъектРасчетов = Справочники.ОбъектыРасчетов.НайтиПоРеквизиту("Объект", ОтчетКомиссионера.Ссылка);
	КредиторскаяЗадолженностьТЧ.СуммаВзаиморасчетов = Документ.СуммаДокумента;
	КредиторскаяЗадолженностьТЧ.ВалютаВзаиморасчетов = Документ.Валюта;
	КредиторскаяЗадолженностьТЧ.Организация = Документ.Организация;
	КредиторскаяЗадолженностьТЧ.СуммаРегл = ДокументВзаимозачет.СуммаРегл; 
	КредиторскаяЗадолженностьТЧ.СуммаУпр = ДокументВзаимозачет.СуммаУпр;
	
	Попытка
		ДокументВзаимозачет.Записать(РежимЗаписиДокумента.Проведение); 
	Исключение
		ДокументВзаимозачет.Записать();
	КонецПопытки; 	 
	
	Возврат ДокументВзаимозачет.Ссылка;
	
КонецФункции //- ИнфоСофт Сумин Д.В. 23.08.2023 УА #61252 

