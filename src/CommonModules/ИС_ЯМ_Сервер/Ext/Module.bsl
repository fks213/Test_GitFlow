//+ ИнфоСофт Мурсалимов Д.Р. 21.11.23 УА #56220
Функция УказатьКоличествоГрузовыхМест(Профиль, МассивЗаданий, Количество) Экспорт
	
	НастройкиСоединения = ПолучитьНастройкиСоединенияПрофиля(Профиль);	
	ПараметрыЗапроса = ПроверитьИЗаполнитьПараметрыЗапроса(НастройкиСоединения);
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ИС_ЯМ_Заказ.Номер КАК Номер
	|ИЗ
	|	Документ.ИС_ЯМ_Заказ КАК ИС_ЯМ_Заказ
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ИС_ЯМ_СтатусыСборочныхЗаданий КАК ИС_ЯМ_СтатусыСборочныхЗаданий
	|		ПО (ИС_ЯМ_СтатусыСборочныхЗаданий.Заказ = ИС_ЯМ_Заказ.Ссылка)
	|			И (ИС_ЯМ_Заказ.Профиль = &Профиль)
	|ГДЕ
	|	ИС_ЯМ_Заказ.Ссылка В(&МассивСсылок)
	|	И ИС_ЯМ_СтатусыСборочныхЗаданий.status = ЗНАЧЕНИЕ(Перечисление.ИС_ЯМ_СтатусыЗаказов.PROCESSING)
	|	И ИС_ЯМ_СтатусыСборочныхЗаданий.substatus = ЗНАЧЕНИЕ(Перечисление.ИС_ЯМ_ДетальныеСтатусы.STARTED)";
	
	Запрос.УстановитьПараметр("МассивСсылок", МассивЗаданий);
	Запрос.УстановитьПараметр("Профиль", Профиль);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Выборка = РезультатЗапроса.Выбрать();
	
	МассивКСозданию = Новый Массив();
	Пока Выборка.Следующий() Цикл
		МассивКСозданию.Добавить(СтрЗаменить(Выборка.Номер, Символы.НПП, ""));	
	КонецЦикла;
	
	Если МассивКСозданию.Количество() = 0 Тогда
		ОбщегоНазначения.СообщитьПользователю("Проверьте статусы заказов. Указание количества грузовых мест невозможно!");
		Возврат Неопределено;
	КонецЕсли;	
	
	КампанияID = Формат(НастройкиСоединения["ЯМКампанияID"], "ЧГ=0");
	
	Для Каждого Элемент Из МассивКСозданию Цикл
		
		ИС_ЯМ_API.УказатьКоличествоГрузовыхМест(Профиль, ПараметрыЗапроса, КампанияID, Элемент, Количество);
			
	КонецЦикла;
		
КонецФункции //- ИнфоСофт Мурсалимов Д.Р. 21.11.23 УА #56220

//+ ИнфоСофт Стояк Ю.К. 18.12.2023 УА #638058
Функция ИзменитьСтатусыЗаказов(Профиль, МассивЗаданий, Статус, Подстатус) Экспорт
	
	Событие = "ИзменитьСтатусыЗаказов";
	
	Если Не ЗначениеЗаполнено(Профиль) Тогда
		ОбщегоНазначения.СообщитьПользователю("Не заполнен Профиль. Загрузка товаров невозможна");
		Возврат Неопределено;
	КонецЕсли;
		
	НастройкиСоединения = ПолучитьНастройкиСоединенияПрофиля(Профиль);	
	ПараметрыЗапроса = ПроверитьИЗаполнитьПараметрыЗапроса(НастройкиСоединения); 
	
	КампанияID = Формат(НастройкиСоединения["ЯМКампанияID"], "ЧГ=0"); 
	
	КодыОтправлений = Новый Массив;
	Для Каждого Задание Из МассивЗаданий Цикл
		КодыОтправлений.Добавить(СтрЗаменить(Задание.Номер, Символы.НПП, ""));		
	КонецЦикла;
	
	РазбитыйМассив = ИС_MP_Сервер.РазбитьМассивПоNЭлементов(КодыОтправлений, 30);		
	
	ИндексСтатуса = Перечисления.ИС_ЯМ_СтатусыЗаказов.Индекс(Статус); 
	ЗначениеСтатуса = Статус.Метаданные().ЗначенияПеречисления[ИндексСтатуса].Имя;
	
	ИндексДетальногоСтатуса = Перечисления.ИС_ЯМ_ДетальныеСтатусы.Индекс(Подстатус); 
	ЗначениеДетальногоСтатуса = Подстатус.Метаданные().ЗначенияПеречисления[ИндексДетальногоСтатуса].Имя;
	
	Для Каждого Элемент Из РазбитыйМассив Цикл 
		
		Тело = Новый Массив; 
		
		Для Каждого Код Из Элемент Цикл 
			
			Элемент = Новый Структура;
			Элемент.Вставить("id", Число(Код));
			Элемент.Вставить("status", ЗначениеСтатуса);
			Элемент.Вставить("substatus", ЗначениеДетальногоСтатуса);
			Тело.Добавить(Элемент);
			
		КонецЦикла; 
		
		Результат = ИС_ЯМ_API.ИзменитьСтатусЗаказов(Профиль, ПараметрыЗапроса, КампанияID, Тело);		
		
		Если ЗначениеЗаполнено(Результат) Тогда
			
			Если Результат.status = "OK" Тогда
				
				//+ ИнфоСофт Стояк Ю.К. 24.09.2024 УА #82955				
				//ОбщегоНазначения.СообщитьПользователю("Изменение статусов прошло со следующим результатом:" + Результат);
				ОбщегоНазначения.СообщитьПользователю("Отправка запроса на изменение статусов прошло со статусом: OK");
				//- ИнфоСофт Стояк Ю.К. 24.09.2024 УА #82955
				
				Для Каждого Задание Из Результат.result.orders Цикл  
					
					//+ ИнфоСофт Стояк Ю.К. 24.09.2024 УА #82955				
					Если Задание.updateStatus = "ERROR" Тогда
						ОбщегоНазначения.СообщитьПользователю("По заказу: " + Задание.id + " произошла ошибка изменения статуса: " + Задание.errorDetails);
					КонецЕсли;                                                  
					//- ИнфоСофт Стояк Ю.К. 24.09.2024 УА #82955				
					
					Заказ = ПолучитьЗаказПоНомеру(Задание.id);
					
					Если Заказ.Пустая() Тогда
						Продолжить;
					КонецЕсли;		 
					
					МенеджерЗаписи = РегистрыСведений.ИС_ЯМ_СтатусыСборочныхЗаданий.СоздатьМенеджерЗаписи();
					МенеджерЗаписи.Профиль = Профиль;
					МенеджерЗаписи.Заказ = Заказ;
					
					МенеджерЗаписи.Прочитать();
					
					МенеджерЗаписи.Профиль = Профиль;
					МенеджерЗаписи.Заказ = Заказ;  				
					
					МенеджерЗаписи.status = Статус;
					МенеджерЗаписи.substatus = Подстатус; 
					
					Попытка
						МенеджерЗаписи.Записать(Истина);	
					Исключение
						Текст = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
						ИС_MP_Сервер.ЗаписатьВЖРИСообщитьПользователю(Событие, Текст);
					КонецПопытки;
					
				КонецЦикла;                   
				
			КонецЕсли;
			
		Иначе
