		|	ВТ_ОсновныеДанные.Заказ,
		|	ВТ_ОсновныеДанные.Номенклатура,
		|	ВТ_ОсновныеДанные.Характеристика,
		|	ВТ_ОсновныеДанные.count,
		|	ВТ_ОсновныеДанные.price,
		|	ВТ_ОсновныеДанные.ЭтоНабор,
		|	ВариантыКомплектацииНоменклатурыТовары.Номенклатура,
		|	ВариантыКомплектацииНоменклатурыТовары.Характеристика,
		|	ВариантыКомплектацииНоменклатурыТовары.Количество,
		//+ ИнфоСофт Тимофеева А.А. 31.03.25 УА #77929
		|	ВТ_РасходныйОрдер.РасходныйОрдер КАК РасходныйОрдер,
		|   ВТ_РасходныйОрдер.РазличныхРаспоряжений КАК РазличныхРаспоряжений
		//- ИнфоСофт Тимофеева А.А. 31.03.25 УА #77929
		|ИЗ
		|	ВТ_ОсновныеДанные КАК ВТ_ОсновныеДанные
		|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_РТУ_Группировка КАК ВТ_РТУ_Группировка
		|		ПО ВТ_ОсновныеДанные.Ссылка = ВТ_РТУ_Группировка.Заказ,
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ВариантыКомплектацииНоменклатуры.Товары КАК ВариантыКомплектацииНоменклатурыТовары
		|		ПО (ВТ_ОсновныеДанные.Номенклатура = ВариантыКомплектацииНоменклатурыТовары.Ссылка.Владелец
		|				И ВТ_ОсновныеДанные.Характеристика = ВариантыКомплектацииНоменклатурыТовары.Ссылка.Характеристика)
		//+ ИнфоСофт Тимофеева А.А. 31.03.25 УА #77929
		|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_РасходныйОрдер КАК ВТ_РасходныйОрдер		
		|       ПО ВТ_ОсновныеДанные.Ссылка = ВТ_РасходныйОрдер.Ссылка
		//- ИнфоСофт Тимофеева А.А. 31.03.25 УА #77929
		|ГДЕ
		|	ВТ_ОсновныеДанные.ЭтоНабор";
		//- ИнфоСофт Стояк Ю.К. 02.07.2024 УА #67813
	
	Запрос.УстановитьПараметр("Ссылка", Заказ);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		
		//+ ИнфоСофт Стояк Ю.К. 11.10.2024 УА #84967		
