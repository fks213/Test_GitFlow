		НастройкиУчета = УчетНДСУП.ПараметрыУчетаПоОрганизации(СтруктураДанных.Профиль.Организация, ТекущаяДатаСеанса());
		ДокументОбъект.НалогообложениеНДС = НастройкиУчета.ОсновноеНалогообложениеНДСПродажи;
		//- ИнфоСофт Тимофеева А.А. 09.04.2025 УА #97337
		
		//+ ИнфоСофт Власова И.С. 06.08.24 УА #67453
		//Если Не ЗначениеЗаполнено(ФукнциональныеОпции.КонтрагентЯМ) Тогда	
		//	ТекстСообщения = СтрШаблон(
		//	"Не заполнен контрагент в настройках ЯМ для аккаунта: %1. Документ отчет комиссионера не создан.",
		//	СтруктураДанных.Профиль);
		//	ИС_MP_Сервер.ЗаписатьВЖРИСообщитьПользователю(Событие, ТекстСообщения);
		//	ОбщегоНазначения.СообщитьПользователю(ТекстСообщения);
		//	Возврат Неопределено;
		//	
		//КонецЕсли;
