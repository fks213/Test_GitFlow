#Область РегламентныеЗадания

//+ ИнфоСофт Ивонин К.А. 11.11.23 УА #55166
Процедура ВыполнитьКомандуРеглЗадания(Профиль, ИдентификаторКомандыОбработки) Экспорт

	Событие = ПолучитьИмяСобытия("ВыполнитьКомандуРеглЗадания");
	
	//+ ИнфоСофт Стояк Ю.К. 12.02.2024 УА #70009
	Если ИдентификаторКомандыОбработки = "ПолучениеКарточекТоваровЯМ" Тогда
		ПолучитьКарточкиТоваров(Профиль, Истина);
		Возврат;				
	КонецЕсли;
	//- ИнфоСофт Стояк Ю.К. 12.02.2024 УА #70009
	
	Если ИдентификаторКомандыОбработки = "ВыгрузкаЦенЯМ" Тогда
		ВыгрузитьЦены(Профиль);
		Возврат;						
	КонецЕсли;  
	
	Если ИдентификаторКомандыОбработки = "ВыгрузкаОстатковЯМ" Тогда		
	
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	ИС_ЯМ_Склады.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.ИС_ЯМ_Склады КАК ИС_ЯМ_Склады
		|ГДЕ
		|	НЕ ИС_ЯМ_Склады.ПометкаУдаления
		|	И ИС_ЯМ_Склады.ЛичныйКабинет = &Профиль 
		//+ ИнфоСофт Заварин К.В. 13.08.24 УА #81097
		|	И НЕ(ИС_ЯМ_Склады.ОбщаяГруппаСкладов = ЗНАЧЕНИЕ(Справочник.Склады.ПустаяСсылка)
		|				И ИС_ЯМ_Склады.Склад = ЗНАЧЕНИЕ(Справочник.Склады.ПустаяСсылка)
		|				И ИС_ЯМ_Склады.ВыгружатьОстаткиИзГруппыСкладов = ЛОЖЬ)";
		//- ИнфоСофт Заварин К.В. 13.08.24 УА #81097
		
		Запрос.УстановитьПараметр("Профиль", Профиль);
		
		РезультатЗапроса = Запрос.Выполнить();
		
		Выборка = РезультатЗапроса.Выбрать();
		
		Пока Выборка.Следующий() Цикл 
			ВыгрузитьОстатки(Профиль, Выборка.Ссылка);	
		КонецЦикла;
	
		Возврат;
		
	КонецЕсли;    	
	
	Если ИдентификаторКомандыОбработки = "ПолучениеСборочныхЗаданийЯМ" Тогда
		
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	ИС_ЯМ_Заказ.Дата КАК Дата
		|ИЗ
		|	Документ.ИС_ЯМ_Заказ КАК ИС_ЯМ_Заказ
		|ГДЕ
		|	ИС_ЯМ_Заказ.Профиль = &Профиль
		|
		|УПОРЯДОЧИТЬ ПО
		|	Дата УБЫВ";
		
		Запрос.УстановитьПараметр("Профиль", Профиль);
		РезультатЗапроса = Запрос.Выполнить();
		
		ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
		
		Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
			ДатаНачала = ВыборкаДетальныеЗаписи.Дата;
		КонецЦикла;
		
		Если Не ЗначениеЗаполнено(ДатаНачала) Тогда
			ДатаНачала = НачалоДня(ТекущаяДатаСеанса());	
		КонецЕсли;
		
		//+ ИнфоСофт Власова И.С. 18.12.2024 УА #89287
		//ПолучитьСписокЗаказов(Профиль, Дата("20241023"));
		ПолучитьСписокЗаказов(Профиль, ДатаНачала + 1);
		//- ИнфоСофт Власова И.С. 18.12.2024 УА #89287
		
		Возврат;				
	
	КонецЕсли;
	
	Если ИдентификаторКомандыОбработки = "ОбновлениеСтатусовСборочныхЗаданийЯМ" Тогда
		//+ ИнфоСофт Стояк Ю.К. 08.04.2024 УА #68800
		ФукнциональныеОпции = ПолучитьНастройкиФункциональностиСборочныхЗвданий(Профиль); 
		
		Если ФукнциональныеОпции.ЯндексКоличествоДнейОбновлениеСтатусов = 0 Тогда
			Период = 30 * 86400;
		Иначе
			Период = ФукнциональныеОпции.ЯндексКоличествоДнейОбновлениеСтатусов * 86400;
		КонецЕсли;
		
		ОбновитьСтатусыСборочныхЗаданий(Профиль,Период);
		//ОбновитьСтатусыСборочныхЗаданий(Профиль);
		//- ИнфоСофт Стояк Ю.К. 08.04.2024 УА #68800		
		Возврат;				
	КонецЕсли; 
	
	Если ИдентификаторКомандыОбработки = "ЗакрыватьЗаказВТечениеДняЯМ" Тогда 
        ВыполнитьЗакрытиеЗаказов(Профиль);
		Возврат;	
	КонецЕсли;
		
	Если ИдентификаторКомандыОбработки = "ВыполнениеАлгоритмаПоОсновнойСхемеFboЯМ" Тогда
		ВыполнитьАлгоритмПоОсновнойСхемеFBO(Профиль);			
		Возврат;
	КонецЕсли;
	
КонецПроцедуры //- ИнфоСофт Ивонин К.А. 11.11.23 УА #55166

