	МенеджерЗаписи.Прочитать();
	
	МенеджерЗаписи.Профиль = Профиль;
	МенеджерЗаписи.Заказ = ЗаказЯМ;   
		
	БылОтменён = Ложь;
	
	Если МенеджерЗаписи.status = Перечисления.ИС_ЯМ_СтатусыЗаказов.CANCELLED Тогда
		БылОтменён = Истина;
	КонецЕсли;
		
	Попытка
		МенеджерЗаписи.status = Перечисления.ИС_ЯМ_СтатусыЗаказов[ДанныеПоЗаказу.status];
	Исключение
	КонецПопытки;
	
	Попытка
		МенеджерЗаписи.substatus = Перечисления.ИС_ЯМ_ДетальныеСтатусы[ДанныеПоЗаказу.substatus]; 
	Исключение
	КонецПопытки;
	
	Если МенеджерЗаписи.status = Перечисления.ИС_ЯМ_СтатусыЗаказов.CANCELLED И Не БылОтменён Тогда		
		ОтменитьЗаказ(ЗаказЯМ, Профиль);	
	КонецЕсли;	
	
	Попытка
		МенеджерЗаписи.Записать(Истина);	
	Исключение
		Текст = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
		ИС_MP_Сервер.ЗаписатьВЖРИСообщитьПользователю(Событие, Текст);
	КонецПопытки;
			
КонецПроцедуры //- ИнфоСофт Стояк Ю.К. 21.04.2025 УА #97604

