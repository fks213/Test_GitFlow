 //+ ИнфоСофт Ивонин К.А. 14.04.23 УА #57127
Функция ПолучитьНастройкиСоединенияПрофиля(Профиль)
    
    НастройкиСоединения = ИС_ЯМ_СерверПовтИсп.ПолучитьНастройкиСоединения(Профиль);
    
	Если НастройкиСоединения.Количество() = 0 Тогда
		ВызватьИсключение("Не удалось получить настройки подключения, проверьте настройки авторизации");
	КонецЕсли;

	Возврат НастройкиСоединения;
	
КонецФункции //- ИнфоСофт Ивонин К.А. 14.04.23 УА #57127

//+ ИнфоСофт Ивонин К.А. 14.04.23 УА #57127
Функция ПроверитьИЗаполнитьПараметрыЗапроса(НастройкиСоединения)
	
	Если Не ЗначениеЗаполнено(НастройкиСоединения["ЯМАдресСервисаAPI"]) Тогда
		ВызватьИсключение("Для данного профиля не заполнен ""Адрес Сервиса Яндекс Маркета"", проверьте настройки авторизации");
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(НастройкиСоединения["ЯМТокен"]) Тогда
		ВызватьИсключение("Для данного профиля не заполнен ""Токен Яндекс Маркета"", проверьте настройки авторизации");
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(НастройкиСоединения["ЯМКампанияID"]) Тогда
		ВызватьИсключение("Для данного профиля не заполнен ""ID Компании Яндекс Маркета"", проверьте настройки авторизации");
	КонецЕсли; 
	
	Если Не ЗначениеЗаполнено(НастройкиСоединения["ЯМКодБизнеса"]) Тогда
		ВызватьИсключение("Для данного профиля не заполнен ""Код бизнеса Яндекс Маркета"", проверьте настройки авторизации");
	КонецЕсли;
	
	ПараметрыЗапроса = ИС_MP_РаботаСHTTPЗапросамиСервер.ПолучитьСтруктуруHTTPЗапроса();
	
	ПараметрыЗапроса.Сервер = НастройкиСоединения["ЯМАдресСервисаAPI"];
	ПараметрыЗапроса.Порт = 443;
	ПараметрыЗапроса.ЗащищенноеСоединение = Истина;
	ПараметрыЗапроса.Заголовки.Вставить("Authorization", "Bearer " + НастройкиСоединения["ЯМТокен"]);
	ПараметрыЗапроса.Заголовки.Вставить("Api-Key", НастройкиСоединения["ЯМТокен"]);
	
	Возврат ПараметрыЗапроса;	

КонецФункции //- ИнфоСофт Ивонин К.А. 14.04.23 УА #57127

//+ ИнфоСофт Стояк Ю.К. 20.01.2023 УА #52524
Функция ПолучитьMD5Хэш(СтруктураJSON)

	ЗаписьJSON = Новый ЗаписьJSON;
	ЗаписьJSON.УстановитьСтроку();
	ЗаписатьJSON(ЗаписьJSON, СтруктураJSON);
	СтрокаJSON = ЗаписьJSON.Закрыть();

	Хеш = Новый ХешированиеДанных(ХешФункция.MD5);
    Хеш.Добавить(СтрокаJSON);
    
    Возврат СтрЗаменить(Строка(Хеш.ХешСумма), " ", ""); 	
	 
КонецФункции //- ИнфоСофт Стояк Ю.К. 20.01.2023 УА #52524

//+ ИнфоСофт Стояк Ю.К. 20.03.2023 УА #54628
Процедура ПроверитьФункциональныеОпцииСборочныхЗаданий(Профиль, МассивЗаданий)

	ФукнциональныеОпции = ПолучитьНастройкиФункциональностиСборочныхЗвданий(Профиль);
	
	Если ФукнциональныеОпции.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
		
	Если ФукнциональныеОпции.АвтоматическиСоздаватьЗаказыЯМ Тогда	
		СоздатьЗаказы(Профиль, МассивЗаданий);		
	КонецЕсли;
	
	Если ФукнциональныеОпции.АвтоматическиСоздаватьРеализацииЯМ 
		И ФукнциональныеОпции.РежимСозданияЗаказовЯМ <> 2 Тогда	
		СоздатьРеализации(Профиль, МассивЗаданий);		
	КонецЕсли;
	
КонецПроцедуры //- ИнфоСофт Стояк Ю.К. 20.03.2023 УА #54628

