					Отбор.Вставить("Характеристика", ВыборкаДетальныеЗаписи.ХарактеристикаНабора);					
					//+ ИнфоСофт Стояк Ю.К. 10.04.2025 УА #98469
					Отбор.Вставить("Количество", ВыборкаДетальныеЗаписи.Количество);
					//- ИнфоСофт Стояк Ю.К. 10.04.2025 УА #98469
					
					НайденныеСтроки = Заказ1С.Товары.НайтиСтроки(Отбор);
					
