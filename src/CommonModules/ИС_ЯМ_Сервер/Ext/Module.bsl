				ДокументОбъект.Порядокрасчетов = ДокументОбъект.Соглашение.ПорядокРасчетов;	
			КонецЕсли;
			
		КонецЕсли; 
		
		//+ ИнфоСофт Власова И.С. 22.04.25 УА #99526			
		ДокументОбъект.Статус = ПредопределенноеЗначение("Перечисление.СтатусыРеализацийТоваровУслуг.Отгружено");	
