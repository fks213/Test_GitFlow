			Исключение
				ЗаписыватьДокумент = Истина;
				Текст = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
				ИС_MP_Сервер.ЗаписатьВЖРИСообщитьПользователю(Событие, Текст);
			КонецПопытки;
			
		Иначе
			ЗаписыватьДокумент = Истина;	
		КонецЕсли;
		
		Если ЗаписыватьДокумент Тогда	
			
			Попытка
				ДокументРеализация.Записать();			
			Исключение
				Текст = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
				ИС_MP_Сервер.ЗаписатьВЖРИСообщитьПользователю(Событие, Текст);				
			КонецПопытки;
			
		КонецЕсли;
		
	КонецЦикла;
		
КонецПроцедуры //- ИнфоСофт Сумин Д.В. 01.06.2023 УА #59231

//+ ИнфоСофт Стояк Ю.К. 01.11.2023 УА #62748
Процедура ВыполнитьАлгоритмПоОсновнойСхемеFbo(Профиль)
	
	Событие = ПолучитьИмяСобытия("ВыполнитьАлгоритмПоОсновнойСхемеFbo");
	
	СписокМагазинов = ПолучитьСписокМагазинов(Профиль); 		 
	
	Если СписокМагазинов = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	КампанияID = Неопределено;
	
	Для Каждого Магазин Из СписокМагазинов Цикл
		Если Магазин.placementType = "FBY" Тогда
			КампанияID = Формат(Магазин.id, "ЧГ=0");	
			Прервать;
		КонецЕсли;			
	КонецЦикла; 
	
	Если КампанияID = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	СкладыFBY = ПолучитьСкладыFBY(Профиль);
	
	Попытка
		Остатки = ПолучитьОстатки(Профиль, КампанияID);		
	Исключение
		Текст = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
		ЗаписьЖурналаРегистрации(Событие, УровеньЖурналаРегистрации.Ошибка, , , Текст);
		Возврат;
	КонецПопытки;
	
	Если Остатки.Количество() = 0 Тогда
		Текст = "Яндекс Маркет не предоставляет информацию по остаткам. Проверьте корректность токена статистики. Если токен корректный, необходимо обратиться в техническую поддержку Яндекс Маркета для уточнения сроков исправления неисправностей.";
		ЗаписьЖурналаРегистрации(Событие, УровеньЖурналаРегистрации.Ошибка, , , Текст);
		Возврат;	
	КонецЕсли; 
	
	МассивIDСкладов = Новый Массив;
	
	Для Каждого Склад Из СкладыFBY.warehouses Цикл
		МассивIDСкладов.Добавить(Склад.id);
	КонецЦикла;
		
	МассивId = Новый Массив;
	
	Для Каждого Элемент Из Остатки Цикл
		
		Индекс = МассивIDСкладов.Найти(Элемент.id);
		//+ ИнфоСофт Заварин К.В. 05.08.24 УА #81079
		//Если Элемент.stock > 0 И ЗначениеЗаполнено(Индекс) Тогда
		Если Элемент.stock > 0 И ТипЗнч(Индекс) = Тип("Число") Тогда
		//- ИнфоСофт Заварин К.В. 05.08.24 УА #81079
			МассивId.Добавить(Элемент.shopSku);	
		КонецЕсли;	
	КонецЦикла;
	
	//Добавим записи ручных остатков по тем позициям, которых нет на fbo
	ЗапросСклады = Новый Запрос;
	ЗапросСклады.Текст =
	"ВЫБРАТЬ
	|	ИС_ЯМ_Склады.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.ИС_ЯМ_Склады КАК ИС_ЯМ_Склады
	|ГДЕ
	|	ИС_ЯМ_Склады.ИспользоватьСхемуFBO
	|	И ИС_ЯМ_Склады.ЛичныйКабинет = &Профиль";	
	
	ЗапросСклады.УстановитьПараметр("Профиль", Профиль);
	РезультатЗапросаСклады = ЗапросСклады.Выполнить();  
	
	Если РезультатЗапросаСклады.Пустой() Тогда
		Текст = "В информационной базе не найден ни один склад fbs с включенной опцией.";
		ЗаписьЖурналаРегистрации("ИС.ЯМ.ВыполнениеАлгоритмаПоОсновнойСхемеFbo", УровеньЖурналаРегистрации.Ошибка, , , Текст);
		Возврат;	
	КонецЕсли;
	
	ВыборкаСклады = РезультатЗапросаСклады.Выбрать();
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ИС_ЯМ_Номенклатура.Ссылка КАК Номенклатура
	|ИЗ
	|	Справочник.ИС_ЯМ_Номенклатура КАК ИС_ЯМ_Номенклатура
	|ГДЕ
	|	ИС_ЯМ_Номенклатура.Профиль = &Профиль
	|	И ИС_ЯМ_Номенклатура.shopSku В(&shopSku)";
	
	Запрос.УстановитьПараметр("Профиль", Профиль);
	Запрос.УстановитьПараметр("shopSku", МассивId);
	
	РезультатЗапроса = Запрос.Выполнить();
		
	ТаблицаВыгрузки = РезультатЗапроса.Выгрузить();	
	
	Пока ВыборкаСклады.Следующий() Цикл
		
		//Выполним очистку всех записей регистра ручных остатков
		//+ ИнфоСофт Мурсалимов Д.Р. 27.03.24 УА #72931
		НаборЗаписей = РегистрыСведений.ИС_MP_РучныеОстатки.СоздатьНаборЗаписей();
		НаборЗаписей.Отбор.Профиль.Установить(Профиль);
		НаборЗаписей.Отбор.Маркетплейс.Установить(Перечисления.ИС_МП_Маркетплейсы.ЯМ);
		НаборЗаписей.Отбор.Склад.Установить(ВыборкаСклады.Ссылка);
		НаборЗаписей.Записать();
		//- ИнфоСофт Мурсалимов Д.Р. 27.03.24 УА #72931
	
		Для Каждого Строка Из ТаблицаВыгрузки Цикл
			
			//+ ИнфоСофт Мурсалимов Д.Р. 27.03.24 УА #72931
			ИС_МП_УправлениеОстатками.ЗаписатьРучнойОстаток(Профиль, Перечисления.ИС_МП_Маркетплейсы.ЯМ, ВыборкаСклады.Ссылка, Строка.Номенклатура, 0);
						
			//НаборЗаписейОстатоков = РегистрыСведений.ИС_ЯМ_Остатки.СоздатьНаборЗаписей();			
			//НоваяЗапись = НаборЗаписейОстатоков.Добавить();	
			//НоваяЗапись.НоменклатураЯМ = Строка.Номенклатура;
			//НоваяЗапись.СкладЯМ = ВыборкаСклады.Ссылка; 
			//НоваяЗапись.Остаток = 0;			
			//НаборЗаписейОстатоков.Записать(Ложь);          
			//- ИнфоСофт Мурсалимов Д.Р. 27.03.24 УА #72931
			
		КонецЦикла; 
		
	КонецЦикла; 
	
КонецПроцедуры //- ИнфоСофт Стояк Ю.К. 01.11.2023 УА #62748

