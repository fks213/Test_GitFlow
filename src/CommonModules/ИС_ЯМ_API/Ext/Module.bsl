//+ ИнфоСофт Стояк Ю.К. 10.02.2023 УА #54628
Функция ПолучитьСписокЦен(Профиль, ПараметрыЗапроса, КампанияID, КодСтраницы = Неопределено) Экспорт

	ПараметрыЗапроса.Заголовки.Вставить("Content-Type",   "application/json");		              
	ПараметрыЗапроса.АдресРесурса = "/v2/campaigns/" + КампанияID + "/offer-prices.json?limit=2000" + КодСтраницы;
	ПараметрыЗапроса.ФорматОтвета = "Строка";
		
	РезультатЗапроса = ИС_MP_РаботаСHTTPЗапросамиСервер.ОтправитьGETЗапрос(ПараметрыЗапроса);
	
	//+ ИнфоСофт Заварин К.В. 24.05.24 УА #76506
	ЗаписатьДанныеОтладки(Профиль, Перечисления.ИС_МП_МетодыHTTP.GET, ПараметрыЗапроса, РезультатЗапроса);
	//- ИнфоСофт Заварин К.В. 24.05.24 УА #76506
	
	Если РезультатЗапроса.ЕстьОшибки Тогда
		Текст = СтрШаблон("Произошла ошибка при отправке запроса: %1",	РезультатЗапроса.ИнформацияОбОшибке.Описание);
		ОбщегоНазначения.СообщитьПользователю(Текст); 
		Возврат Неопределено;	
	Иначе
	
		Если РезультатЗапроса.КодОтвета = 200 Тогда
		
			JSON = ИС_MP_РаботаСHTTPЗапросамиСервер.ПолучитьОбъектJSON(РезультатЗапроса.Ответ, Истина);
			
			Если ТипЗнч(JSON) = Тип("Соответствие") Тогда				
				Возврат JSON["result"];	
			Иначе
				Текст = СтрШаблон("Получен нераспознанный ответ от сервера: %1", РезультатЗапроса.Ответ);
			 	ОбщегоНазначения.СообщитьПользователю(Текст);
				Возврат Неопределено;
			КонецЕсли;
			
		ИначеЕсли РезультатЗапроса.КодОтвета = 400 Тогда
             
            Текст = СтрШаблон("Неверная форма запроса: %1", РезультатЗапроса.Ответ); 
      		ОбщегоНазначения.СообщитьПользователю(Текст);
			Возврат Неопределено;
			
		Иначе
			
			РазобратьHTTPОтветПоКоду(РезультатЗапроса);
			Возврат Неопределено;
		
		КонецЕсли;
			
	КонецЕсли;
	
КонецФункции //- ИнфоСофт Стояк Ю.К. 10.02.2023 УА #54628

//+ ИнфоСофт Стояк Ю.К. 02.07.2023 УА #59330
Функция ПолучитьОстатки(Профиль, ПараметрыЗапроса, КампанияID, Тело) Экспорт

	ПараметрыЗапроса.Заголовки.Вставить("Content-Type",   "application/json");		              
	ПараметрыЗапроса.АдресРесурса = "/campaigns/" + КампанияID + "/stats/skus";
	ПараметрыЗапроса.ФорматОтвета = "Строка";                                                       
	
	Список = Новый Структура;
	Список.Вставить("shopSkus", Тело); 
	
	ПараметрыЗапроса.ТелоСтрока = ИС_MP_РаботаСHTTPЗапросамиСервер.ПолучитьСтрокуJSON(Список);
	
	РезультатЗапроса = ИС_MP_РаботаСHTTPЗапросамиСервер.ОтправитьPOSTЗапрос(ПараметрыЗапроса);
	
	//+ ИнфоСофт Заварин К.В. 24.05.24 УА #76506
	ЗаписатьДанныеОтладки(Профиль, Перечисления.ИС_МП_МетодыHTTP.POST, ПараметрыЗапроса, РезультатЗапроса);
	//- ИнфоСофт Заварин К.В. 24.05.24 УА #76506
	
	Если РезультатЗапроса.ЕстьОшибки Тогда
		Текст = СтрШаблон("Произошла ошибка при отправке запроса: %1",	РезультатЗапроса.ИнформацияОбОшибке.Описание);
		ОбщегоНазначения.СообщитьПользователю(Текст); 
		Возврат Неопределено;	
	Иначе
	
		Если РезультатЗапроса.КодОтвета = 200 Тогда
		
			JSON = ИС_MP_РаботаСHTTPЗапросамиСервер.ПолучитьОбъектJSON(РезультатЗапроса.Ответ);
			
			Если ТипЗнч(JSON) = Тип("Структура") Тогда				
				Возврат JSON.result.shopSkus;	
			Иначе
				Текст = СтрШаблон("Получен нераспознанный ответ от сервера: %1", РезультатЗапроса.Ответ);
			 	ОбщегоНазначения.СообщитьПользователю(Текст);
				Возврат Неопределено;
			КонецЕсли;
			
		ИначеЕсли РезультатЗапроса.КодОтвета = 400 Тогда
             
            Текст = СтрШаблон("Неверная форма запроса: %1", РезультатЗапроса.Ответ); 
      		ОбщегоНазначения.СообщитьПользователю(Текст);
			Возврат Неопределено;
			
		Иначе
			
			РазобратьHTTPОтветПоКоду(РезультатЗапроса);
			Возврат Неопределено;
		
		КонецЕсли;
			
	КонецЕсли;
	
КонецФункции //- ИнфоСофт Стояк Ю.К. 02.07.2023 УА #59330

