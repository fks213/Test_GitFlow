//+ ИнфоСофт Ивонин К.А. 28.09.23 УА #64020
Процедура РазобратьHTTPОтветПоКоду(СтруктураОтвета)

	Если СтруктураОтвета.КодОтвета = 400 Тогда
		
		Текст = СтрШаблон("Неверная форма запроса: %1", СтруктураОтвета.Ответ);
		ОбщегоНазначения.СообщитьПользователю(Текст);
		
	ИначеЕсли СтруктураОтвета.КодОтвета = 401 Тогда
		
		Текст = СтрШаблон("В запросе не указаны данные для авторизации: %1", СтруктураОтвета.Ответ);
		ОбщегоНазначения.СообщитьПользователю(Текст);
		
	ИначеЕсли СтруктураОтвета.КодОтвета = 403 Тогда
		
		Текст = СтрШаблон("Данные для авторизации неверны или доступ к ресурсу запрещен
						  |Возможно используется пустой или отозванный токен. 
						  |Проверьте настройки авторизации: %1", СтруктураОтвета.Ответ);
		ОбщегоНазначения.СообщитьПользователю(Текст);
		
	ИначеЕсли СтруктураОтвета.КодОтвета = 404 Тогда
		
		Текст = СтрШаблон("Запрашиваемый ресурс не найден: %1", СтруктураОтвета.Ответ);
		ОбщегоНазначения.СообщитьПользователю(Текст);
		
	ИначеЕсли СтруктураОтвета.КодОтвета = 420 Тогда
		
		Текст = СтрШаблон("Превышено ограничение на доступ к ресурсу, повторите попытку позже: %1", СтруктураОтвета.Ответ);
		ОбщегоНазначения.СообщитьПользователю(Текст); 
								
	Иначе
		Текст = СтрШаблон("Произошла неизвестная ошибка, код ответа: %1, ошибка: %2", 
			СтруктураОтвета.КодОтвета, СтруктураОтвета.Ответ);			
		ОбщегоНазначения.СообщитьПользователю(Текст);				
	КонецЕсли;

КонецПроцедуры //- ИнфоСофт Ивонин К.А. 28.09.23 УА #64020

