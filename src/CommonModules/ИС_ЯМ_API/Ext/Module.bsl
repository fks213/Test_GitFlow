//+ ИнфоСофт Сумин Д.В. 14.04.23 УА #575378
Функция ЗагрузитьКарточкиТоваров(Профиль, ПараметрыЗапроса, СтруктураПараметров, ТелоЗапроса) Экспорт
	
	ПараметрыЗапроса.Заголовки.Вставить("Content-Type",   "application/json");		              
	
	АдресРесурса = СтрШаблон("/businesses/%1/offer-mappings", СтруктураПараметров.businessId);
	
	Если СтруктураПараметров.Свойство("limit") Тогда
		АдресРесурса = АдресРесурса + "?limit=" + Строка(СтруктураПараметров.limit);
	КонецЕсли;
	
	Если СтруктураПараметров.Свойство("page_token") Тогда
		АдресРесурса = АдресРесурса + "&page_token=" + Строка(СтруктураПараметров.page_token);
	КонецЕсли;
	
	ПараметрыЗапроса.АдресРесурса = АдресРесурса;
	ПараметрыЗапроса.ФорматОтвета = "Строка";  
 	ПараметрыЗапроса.ТелоСтрока = ИС_MP_РаботаСHTTPЗапросамиСервер.ПолучитьСтрокуJSON(ТелоЗапроса);
	
	РезультатЗапроса = ИС_MP_РаботаСHTTPЗапросамиСервер.ОтправитьPOSTЗапрос(ПараметрыЗапроса);
	
	//+ ИнфоСофт Заварин К.В. 24.05.24 УА #76506
	ЗаписатьДанныеОтладки(Профиль, Перечисления.ИС_МП_МетодыHTTP.POST, ПараметрыЗапроса, РезультатЗапроса);
	//- ИнфоСофт Заварин К.В. 24.05.24 УА #76506
	
	Если РезультатЗапроса.ЕстьОшибки Тогда
		Текст = СтрШаблон("Произошла ошибка при отправке запроса: %1",	РезультатЗапроса.ИнформацияОбОшибке.Описание);
		ОбщегоНазначения.СообщитьПользователю(Текст); 
		Возврат Неопределено;	
	Иначе
		
		Если РезультатЗапроса.КодОтвета = 200 Тогда
			
			JSON = ИС_MP_РаботаСHTTPЗапросамиСервер.ПолучитьОбъектJSON(РезультатЗапроса.Ответ);
			
			Если JSON.Свойство("result") Тогда				
				Возврат JSON.result;	
			Иначе
				Текст = СтрШаблон("Получен нераспознанный ответ от сервера: %1", РезультатЗапроса.Ответ);
				ОбщегоНазначения.СообщитьПользователю(Текст);
				Возврат Неопределено;
			КонецЕсли;
			
		ИначеЕсли РезультатЗапроса.КодОтвета = 400 Тогда
			
			Текст = СтрШаблон("Неверная форма запроса: %1", РезультатЗапроса.Ответ); 
			ОбщегоНазначения.СообщитьПользователю(Текст);
			Возврат Неопределено;
			
		Иначе
			
			РазобратьHTTPОтветПоКоду(РезультатЗапроса);
			Возврат Неопределено;
			
		КонецЕсли;
		
	КонецЕсли;
	
КонецФункции //- ИнфоСофт Сумин Д.В. 14.04.23 УА #57537

