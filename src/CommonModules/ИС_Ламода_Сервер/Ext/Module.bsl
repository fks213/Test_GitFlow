#Область Настройки

//+ ИнфоСофт Власова И.С. 23.12.24 УА #90120
Процедура ПолучитьНастройки(Форма) Экспорт
	
	Если Не Форма.Объект.ИнтеграцияЛамода Тогда
		Возврат;
	КонецЕсли;
	
	Маркетплейс = Перечисления.ИС_МП_Маркетплейсы.Ламода;
	
	МассивНастроек = МассивНастроекПодключения();
	МассивНастроек = МассивНастроекОстатков(МассивНастроек);
	МассивНастроек = МассивНастроекЦен(МассивНастроек);
	
	СтруктураНастроек = ИС_МП_Сервер.ПолучитьЗначениеНастроек(Форма.Объект.Ссылка, Маркетплейс, МассивНастроек);

	СтруктураПараметров = Новый Структура;

	Для Каждого Элемент Из СтруктураНастроек Цикл
		СтруктураПараметров.Вставить("Ламода" + Элемент.Ключ, Элемент.Значение);	
	КонецЦикла;
		
	ЗаполнитьЗначенияСвойств(Форма, СтруктураПараметров);
	
	МассивНастроек = Новый Массив;
	МассивНастроек.Добавить("AccessTokenB2B");
	МассивНастроек.Добавить("AccessTokenSeller");
	
	СтруктураНастроек = ИС_МП_Сервер.ПолучитьЗначениеНастроек(Форма.Объект.Ссылка, Маркетплейс, МассивНастроек, "Строка");
		
	Форма.ЛамодаAccessTokenB2B    = СтруктураНастроек.AccessTokenB2B;
	Форма.ЛамодаAccessTokenSeller = СтруктураНастроек.AccessTokenSeller;
		
КонецПроцедуры //- ИнфоСофт Власова И.С. 23.12.24 УА #90120

//+ ИнфоСофт Власова И.С. 23.12.24 УА #90120
Процедура ЗаписатьНастройки(Форма) Экспорт
	
	Если Не Форма.Объект.ИнтеграцияЛамода Тогда
		Возврат;
	КонецЕсли;
	
	МассивНастроек = МассивНастроекПодключения();
	МассивНастроек = МассивНастроекЗаполненияДокументов(МассивНастроек);
	МассивНастроек = МассивНастроекОстатков(МассивНастроек);
	МассивНастроек = МассивНастроекЦен(МассивНастроек);
	
	СтруктураНастроек = Новый Структура;
	
	Для Каждого Элемент Из МассивНастроек Цикл
		
		Если Элемент = "AccessTokenB2B" 
			Или Элемент = "AccessTokenSeller" Тогда
			
			Продолжить;
			
		КонецЕсли;
		
		СтруктураНастроек.Вставить("Ламода" + Элемент, Неопределено);
		
	КонецЦикла;
	
	ЗаполнитьЗначенияСвойств(СтруктураНастроек, Форма);
	
	СтруктураПараметров = Новый Структура;
	
	Для Каждого Элемент Из СтруктураНастроек Цикл
		СтруктураПараметров.Вставить(СтрЗаменить(Элемент.Ключ, "Ламода", ""), Элемент.Значение);	
	КонецЦикла;
	
	Маркетплейс = Перечисления.ИС_МП_Маркетплейсы.Ламода;
	
	ИС_МП_Сервер.ЗаписатьЗначениеНастроек(Форма.Объект.Ссылка, Маркетплейс, СтруктураПараметров);
	
	СтруктураПараметров = Новый Структура;
	СтруктураПараметров.Вставить("AccessTokenB2B",    Форма.ЛамодаAccessTokenB2B);
	СтруктураПараметров.Вставить("AccessTokenSeller", Форма.ЛамодаAccessTokenSeller);
	
	ИС_МП_Сервер.ЗаписатьЗначениеНастроек(Форма.Объект.Ссылка, Маркетплейс, СтруктураПараметров, "Строка");
	
КонецПроцедуры //- ИнфоСофт Власова И.С. 23.12.24 УА #90120

