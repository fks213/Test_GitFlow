//+ ИнфоСофт Власова И.С. 23.12.24 УА #90120
Функция ТестПодключения(Профиль, Параметры) Экспорт
	
	ТекстРезультат = "";
	
	ТекстРезультат = ТекстРезультат + ВыполнитьТестПодключенияB2B(Профиль, Параметры) + Символы.ПС;
	
	ТекстРезультат = ТекстРезультат + ВыполнитьТестПодключенияSeller(Профиль, Параметры) + Символы.ПС;
	
	Возврат ТекстРезультат;
	
КонецФункции //- ИнфоСофт Власова И.С. 23.12.24 УА #90120

//+ ИнфоСофт Власова И.С. 23.12.24 УА #90120
Функция ВыполнитьТестПодключенияB2B(Профиль, Параметры) Экспорт
	
	ПараметрыЗапроса = ИС_МП_РаботаСHTTPЗапросами.СтруктураHTTPЗапроса();
	
	ПараметрыЗапроса.Сервер               = Параметры.АдресСервисаB2B;
	ПараметрыЗапроса.Порт                 = Параметры.ПортB2B;
	ПараметрыЗапроса.ЗащищенноеСоединение = Параметры.HTTPSB2B;
	
	РезультатЗапроса = ПолучитьТокенB2B(Профиль, ПараметрыЗапроса, Параметры);
	
	Если РезультатЗапроса = Неопределено Тогда
		Возврат "Тест подключения API B2B завершился с ошибкой";
	КонецЕсли;
	
	Возврат "Тест подключения API B2B выполнен успешно";
	
КонецФункции //- ИнфоСофт Власова И.С. 23.12.24 УА #90120

//+ ИнфоСофт Власова И.С. 23.12.24 УА #90120
Функция ВыполнитьТестПодключенияSeller(Профиль, Параметры) Экспорт
	
	ПараметрыЗапроса = ИС_МП_РаботаСHTTPЗапросами.СтруктураHTTPЗапроса();
	
	ПараметрыЗапроса.Сервер               = Параметры.АдресСервисаSeller;
	ПараметрыЗапроса.Порт                 = Параметры.ПортSeller;
	ПараметрыЗапроса.ЗащищенноеСоединение = Параметры.HTTPSSeller;
	
	РезультатЗапроса = ПолучитьТокенSeller(Профиль, ПараметрыЗапроса, Параметры);
	
	Если РезультатЗапроса = Неопределено Тогда
		Возврат "Тест подключения API Lamoda Seller завершился с ошибкой";
	КонецЕсли;
	
	Возврат "Тест подключения API Lamoda Seller выполнен успешно";
	
КонецФункции //- ИнфоСофт Власова И.С. 23.12.24 УА #90120

//+ ИнфоСофт Власова И.С. 23.12.24 УА #90120
Функция ПолучитьТокенB2B(Профиль, ПараметрыЗапроса, Параметры) Экспорт
	
	СтруктураПараметров = Новый Структура;
	СтруктураПараметров.Вставить("client_id",     Параметры.ClientId);
	СтруктураПараметров.Вставить("client_secret", Параметры.ClientSecret);
	СтруктураПараметров.Вставить("grant_type",    "client_credentials");
	
	РезультатЗапроса = ИС_Ламода_АПИ.ПолучитьТокенB2B(Профиль, ПараметрыЗапроса, СтруктураПараметров);
	
	Если РезультатЗапроса = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Маркетплейс = Перечисления.ИС_МП_Маркетплейсы.Ламода;
	
	СтруктураПараметров = Новый Структура;
	СтруктураПараметров.Вставить("AccessTokenB2BИстекает", ТекущаяДатаСеанса() + Число(РезультатЗапроса.expires_in));
	
	ИС_МП_Сервер.ЗаписатьЗначениеНастроек(Профиль, Маркетплейс, СтруктураПараметров); 
	
	СтруктураПараметров = Новый Структура;	
	СтруктураПараметров.Вставить("AccessTokenB2B", РезультатЗапроса.access_token);

	ИС_МП_Сервер.ЗаписатьЗначениеНастроек(Профиль, Маркетплейс, СтруктураПараметров, "Строка");
	
	Возврат РезультатЗапроса.access_token;
	
КонецФункции //- ИнфоСофт Власова И.С. 23.12.24 УА #90120

