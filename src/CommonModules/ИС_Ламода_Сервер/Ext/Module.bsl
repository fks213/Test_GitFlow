//+ ИнфоСофт Власова И.С. 23.12.24 УА #90120
Процедура УстановитьПараметрыЗапросаЦен(Запрос, Профиль) Экспорт
	
	Маркетплейс = Перечисления.ИС_МП_Маркетплейсы.Ламода;
	
	МассивПараметров = МассивНастроекЦен();
	
	Результат = ИС_MP_Сервер.ПолучитьЗначениеНастроек(Профиль, Маркетплейс, МассивПараметров);
	
	СтруктураЦен = ПолучитьСтруктуруПараметровЦен();
	
	ЗаполнитьЗначенияСвойств(СтруктураЦен, Результат);
		
	Запрос.УстановитьПараметр("Маркетплейс"		  , Маркетплейс);
	Запрос.УстановитьПараметр("ВидЦены"			  , СтруктураЦен.ВидЦены); 
	Запрос.УстановитьПараметр("ВидЦеныСоСкидкой"  , СтруктураЦен.ВидЦеныСоСкидкой);
	Запрос.УстановитьПараметр("ВидЦеныМинимальный", Справочники.ВидыЦен.ПустаяСсылка());
	Запрос.УстановитьПараметр("ВидЦеныFBO"		  , Справочники.ВидыЦен.ПустаяСсылка());
	Запрос.УстановитьПараметр("Профиль"			  , Профиль); 
	Запрос.УстановитьПараметр("ПустаяУпаковка"	  , ИС_MP_СерверЛокализация.ПустаяСсылкаУпаковка());
		
КонецПроцедуры //- ИнфоСофт Власова И.С. 23.12.24 УА #90120

//+ ИнфоСофт Власова И.С. 23.12.24 УА #90120
Функция ПолучитьСтруктуруПараметровЦен() Экспорт
	
	Результат = Новый Структура;
	
	Результат.Вставить("ВидЦены",                   Справочники.ВидыЦен.ПустаяСсылка());
	Результат.Вставить("ВидЦеныСоСкидкой",          Справочники.ВидыЦен.ПустаяСсылка());
	Результат.Вставить("РежимОкругленияЦен",        0);
	Результат.Вставить("ИспользоватьПоследниеЦены", Ложь); 

    Возврат Результат;
	
КонецФункции //- ИнфоСофт Власова И.С. 23.12.24 УА #90120

//+ ИнфоСофт Власова И.С. 23.12.24 УА #90120
Процедура ВыгрузитьЦены(Профиль, ТаблицаВыгрузки = Неопределено) Экспорт
	
	Если Не ЗначениеЗаполнено(Профиль) Тогда
		ОбщегоНазначения.СообщитьПользователю("Не выбран Профиль. Выгрузка цен невозможна");
		Возврат;
	КонецЕсли;
	
	Маркетплейс = Перечисления.ИС_МП_Маркетплейсы.Ламода;
	
	МассивПараметров = МассивНастроекЦен();
	
	Результат = ИС_MP_Сервер.ПолучитьЗначениеНастроек(Профиль, Маркетплейс, МассивПараметров);
	
	СтруктураЦен = ПолучитьСтруктуруПараметровЦен();
	
	ЗаполнитьЗначенияСвойств(СтруктураЦен, Результат);
	
	РежимОкругленияЦен        = СтруктураЦен.РежимОкругленияЦен;
	ИспользоватьПоследниеЦены = СтруктураЦен.ИспользоватьПоследниеЦены;
	
	Если ТаблицаВыгрузки = Неопределено Тогда
		
		Запрос = Новый Запрос;
		Запрос.Текст = ПолучитьТекстЗапросаЦен(); 
		
		УстановитьПараметрыЗапросаЦен(Запрос, Профиль);                                                       
		
		РезультатЗапроса = Запрос.Выполнить();
		
		Если РезультатЗапроса.Пустой() Тогда
			Возврат;
		КонецЕсли;
		
		Выборка = РезультатЗапроса.Выбрать();
		
		ТаблицаВыгрузки = Новый ТаблицаЗначений;	
		
		ИС_МП_УправлениеЦенами.ЗаполнитьКолонкиТаблицыВыгрузкиЦен(Маркетплейс, ТаблицаВыгрузки);
		
		МассивПолей = ИС_МП_УправлениеЦенами.ПолучитьПоляДляВыгрузки(Маркетплейс);
		
		Пока Выборка.Следующий() Цикл
		
			Если Не Выборка.ЕстьСопоставление И Не Выборка.ЕстьРучнаяЦена И Не Выборка.ЕстьРучнаяЦенаСоСкидкой Тогда
				Продолжить;
			КонецЕсли;
			
			НоваяСтрока = ТаблицаВыгрузки.Добавить();
		
			Для Каждого Элемент Из МассивПолей Цикл
				НоваяСтрока[Элемент] = Выборка[Элемент];
			КонецЦикла;
			
			Если Выборка.ЕстьРучнаяЦена Тогда
				Цена = Выборка.РучнаяЦена;
			Иначе  
				Цена = Выборка.Цена;	
			КонецЕсли;
			
			Цена = Окр(Цена, 0, РежимОкругленияЦен);
			
			НоваяСтрока.Цена = Цена;
			
			Если Выборка.ЕстьРучнаяЦенаСоСкидкой Тогда
				ЦенаСоСкидкой = Выборка.РучнаяЦенаСоСкидкой;
			Иначе
				ЦенаСоСкидкой = Выборка.ЦенаСоСкидкой;	
			КонецЕсли;
				
			ЦенаСоСкидкой = Окр(ЦенаСоСкидкой, 0, РежимОкругленияЦен);
			
			НоваяСтрока.ЦенаСоСкидкой = ЦенаСоСкидкой;
			
			Если НоваяСтрока.Цена = 0 И НоваяСтрока.ЦенаСоСкидкой = 0 Тогда 
				ТаблицаВыгрузки.Удалить(НоваяСтрока);
			КонецЕсли;
			
			Если Не ИспользоватьПоследниеЦены Тогда
				Продолжить;
			КонецЕсли;
			
			Если Не Выборка.ЕстьРучнаяЦена И Не Выборка.ЕстьРучнаяЦенаСоСкидкой Тогда
			
				Если Не ИС_МП_УправлениеЦенами.ПроверитьПоследниеЦены(Маркетплейс, Выборка, НоваяСтрока) Тогда
					ТаблицаВыгрузки.Удалить(НоваяСтрока);
				КонецЕсли; 
				
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЕсли;

	Если ТаблицаВыгрузки.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	ПараметрыЗапроса = ПараметрыHTTPЗапросаSeller(Профиль);
	
	ПределОшибок     = 10;
	КоличествоОшибок = 0;
	
	СтруктураПараметров = ИС_Ламода_АПИ.СтруктураПараметровЗапросаОбновленияЦен();
	
	ВыгруженныеСтроки = Новый Массив;
	
	Пока Истина Цикл
		
		Если КоличествоОшибок >= ПределОшибок Тогда
			Возврат;
		КонецЕсли;
		
		Для Каждого Строка Из ТаблицаВыгрузки Цикл
			
			СтруктураПараметров.seller_sku = Строка.SellerSKU;
			СтруктураПараметров.price      = Формат(Строка.Цена, "ЧН=0; ЧГ=0");
			СтруктураПараметров.sale_price = Формат(Строка.ЦенаСоСкидкой, "ЧН=0; ЧГ=0");
			
			Результат = ИС_Ламода_АПИ.ОбновитьЦены(Профиль, ПараметрыЗапроса, СтруктураПараметров);
			
			Если Не Результат = Неопределено Тогда
					
				ИС_МП_УправлениеЦенами.ЗаписатьПоследнююВыгруженнуюЦену(Профиль, 
					Маркетплейс, Строка.РазмерЛамода, Строка.Цена, Перечисления.ИС_МП_ВидыЦенМаркетплейса.ВидЦены);
				
				ИС_МП_УправлениеЦенами.ЗаписатьПоследнююВыгруженнуюЦену(Профиль, 
					Маркетплейс, Строка.РазмерЛамода, Строка.ЦенаСоСкидкой, Перечисления.ИС_МП_ВидыЦенМаркетплейса.ВидЦеныСоСкидкой);
					
				ВыгруженныеСтроки.Добавить(Строка);	
					
			Иначе		
				
				КоличествоОшибок = КоличествоОшибок + 1;
				
				Для Каждого ВыгруженнаяСтрока из ВыгруженныеСтроки Цикл
					ТаблицаВыгрузки.Удалить(ВыгруженнаяСтрока);
				КонецЦикла;
				
				Прервать;
				
			КонецЕсли; 
			
		КонецЦикла;
		
		Прервать;
		
	КонецЦикла;
	
КонецПроцедуры //- ИнфоСофт Власова И.С. 23.12.24 УА #90120	

//+ ИнфоСофт Власова И.С. 23.12.24 УА #90120
Функция ПолучитьЦеныFBS(Профиль) Экспорт
	
	Если Не ЗначениеЗаполнено(Профиль) Тогда
		ОбщегоНазначения.СообщитьПользователю("Не выбран Профиль. Получение цен невозможно");
		Возврат Неопределено;
	КонецЕсли;
	
	ПараметрыЗапроса = ПараметрыHTTPЗапросаSeller(Профиль);
	
	ПределОшибок     = 10;
	КоличествоОшибок = 0;	
	
	ТаблицаЦен = ПолучитьСтруктуруТаблицыПолученияЦен();
	
	Пока Истина Цикл
		
		Если КоличествоОшибок >= ПределОшибок Тогда
			Возврат Неопределено;
		КонецЕсли;
		
		Результат = ИС_Ламода_АПИ.ПолучитьЦены(Профиль, ПараметрыЗапроса);
		
		Если Результат = Неопределено Тогда
			КоличествоОшибок = КоличествоОшибок + 1;
			Продолжить;
		КонецЕсли;
		
		МассивНоменклатуры = Результат["nomenclatures"];
		
		Если МассивНоменклатуры.Количество() = 0 Тогда
			Возврат Неопределено;
		КонецЕсли;
		
		Для Каждого Элемент Из МассивНоменклатуры Цикл
			
			НоваяСтрока = ТаблицаЦен.Добавить();
			
			НоваяСтрока.lamoda_sku = Элемент.lamodaSku;
			
			МассивЦенНоменклатуры = Элемент._embedded.sellValues; 
			
			Для Каждого ЦенаСтраны Из МассивЦенНоменклатуры Цикл
				
				Если ЦенаСтраны.country = "RU" Тогда
					
					НоваяСтрока.Цена          = ЦенаСтраны.price;
					НоваяСтрока.ЦенаСоСкидкой = ЦенаСтраны.salePrice;
					
					Прервать;
					
				КонецЕсли;
				
			КонецЦикла;
			
		КонецЦикла;	
		
		Прервать;
		
	КонецЦикла;	
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ТаблицаЦен.lamoda_sku КАК lamoda_sku,
		|	ТаблицаЦен.Цена КАК Цена,
		|	ТаблицаЦен.ЦенаСоСкидкой КАК ЦенаСоСкидкой
		|ПОМЕСТИТЬ ВТ_ТаблицаЦен
		|ИЗ
		|	&ТаблицаЦен КАК ТаблицаЦен
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ИС_Ламода_РазмерыНоменклатуры.Ссылка КАК РазмерЛамода,
		|	ВТ_ТаблицаЦен.lamoda_sku КАК lamoda_sku,
		|	ВТ_ТаблицаЦен.Цена КАК Цена,
		|	ВТ_ТаблицаЦен.ЦенаСоСкидкой КАК ЦенаСоСкидкой
		|ИЗ
		|	Справочник.ИС_Ламода_РазмерыНоменклатуры КАК ИС_Ламода_РазмерыНоменклатуры
		|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_ТаблицаЦен КАК ВТ_ТаблицаЦен
		|		ПО ИС_Ламода_РазмерыНоменклатуры.Код = ВТ_ТаблицаЦен.lamoda_sku
		|ГДЕ
		|	НЕ ИС_Ламода_РазмерыНоменклатуры.ПометкаУдаления
		|	И ИС_Ламода_РазмерыНоменклатуры.Профиль = &Профиль";
	
	Запрос.УстановитьПараметр("Профиль",    Профиль);
	Запрос.УстановитьПараметр("ТаблицаЦен", ТаблицаЦен);
	
	Возврат Запрос.Выполнить().Выгрузить();
	
КонецФункции //- ИнфоСофт Власова И.С. 23.12.24 УА #90120

