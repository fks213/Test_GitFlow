//+ ИнфоСофт Власова И.С. 23.12.24 УА #90120
Функция ПолучитьКарточкиТоваров(Профиль, Перезаполнять = Ложь, ДопПараметры = Неопределено) Экспорт

	Если Не ЗначениеЗаполнено(Профиль) Тогда
		ОбщегоНазначения.СообщитьПользователю("Не выбран Профиль. Загрузка карточек товаров невозможна");
		Возврат Неопределено;
	КонецЕсли;
	
	ПараметрыЗапроса = ПараметрыHTTPЗапросаSeller(Профиль);
	
	КоличествоТоваров = 0;
	КоличествоСтраниц = 0;
	
	КоличествоЭлементовНаЗапрос = 100;
	КоличествоПопытокЗапроса    = 10;
	КоличествоОшибок            = 0;
	Обработано                  = 0;
	ТекущаяСтраница             = 1;
	
	ПервыйЗапрос = Истина;
	
	СтруктураПараметров = ИС_Ламода_АПИ.СтруктураПараметровЗапросаСпискаНоменклатуры(КоличествоЭлементовНаЗапрос);
	
	МассивSKU = Новый Массив;
	
	СоответствиеТоваровДляЗагрузки = Новый Соответствие;
	
	ТаблицаДанных = Новый ТаблицаЗначений;
	ТаблицаДанных.Колонки.Добавить("ДатаОбновления", Новый ОписаниеТипов("Дата"));
	ТаблицаДанных.Колонки.Добавить("lamoda_sku", ОбщегоНазначения.ОписаниеТипаЧисло(15));
	
	Пока Истина Цикл	                                         
		
		Если Не ПервыйЗапрос И ТекущаяСтраница > КоличествоСтраниц Тогда
			Прервать;
		КонецЕсли;
		
		ТаблицаДанных.Очистить();    
		СоответствиеТоваровДляЗагрузки.Очистить();
		
		Если КоличествоОшибок >= КоличествоПопытокЗапроса Тогда
			ВызватьИсключение("Превышено количество ошибок при запросах к API");
		КонецЕсли;
		
		СтруктураПараметров.page = ТекущаяСтраница;
		
		Результат = ИС_Ламода_АПИ.ПолучитьНоменклатуру(Профиль, ПараметрыЗапроса, СтруктураПараметров); 
		
		Если Результат = Неопределено Или Результат.Свойство("nomenclatures") = Неопределено Тогда
			КоличествоОшибок = КоличествоОшибок + 1;
			Продолжить;
		КонецЕсли;
		
		МассивНоменклатуры = Результат["nomenclatures"];
		
		Если МассивНоменклатуры.Количество() = 0 Тогда
			Прервать;
		КонецЕсли;
		
		Для Каждого Элемент Из МассивНоменклатуры Цикл
		
			НоваяСтрока = ТаблицаДанных.Добавить();
			
			НоваяСтрока.lamoda_sku = Элемент["lamoda_sku"];
			НоваяСтрока.ДатаОбновления = ?(Перезаполнять, ТекущаяДатаСеанса(), 
				ИС_МП_РаботаСHTTPЗапросами.ПрочитатьДатуИзJSON(Элемент["updated_at"], ФорматДатыJSON.ISO));
				
			МассивSKU.Добавить(Элемент["lamoda_sku"]);	
				
			СоответствиеТоваровДляЗагрузки.Вставить(Элемент["lamoda_sku"], Элемент);
		
		КонецЦикла;
		
		Запрос = Новый Запрос;
		Запрос.Текст = 
			"ВЫБРАТЬ
			|	ТЧ.ДатаОбновления КАК ДатаОбновления,
			|	ТЧ.lamoda_sku КАК lamoda_sku
			|ПОМЕСТИТЬ ВТ_lamoda_sku
			|ИЗ
			|	&ТЧ КАК ТЧ
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ
			|	isNULL(ИС_Ламода_РазмерыНоменклатуры.updated_at, ДатаВремя(3999, 12, 31, 23, 59, 59)) КАК ДатаПоследнегоИзменения,
			|	ВТ_lamoda_sku.ДатаОбновления КАК ДатаОбновления,
			|	ВТ_lamoda_sku.lamoda_sku КАК lamoda_sku,
			|	ИС_Ламода_РазмерыНоменклатуры.Ссылка КАК РазмерЛамода,
			|	ИС_Ламода_РазмерыНоменклатуры.Владелец КАК НоменклатураЛамода
			|ПОМЕСТИТЬ ВТ_Номенклатура
			|ИЗ
			|	ВТ_lamoda_sku КАК ВТ_lamoda_sku
			|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ИС_Ламода_РазмерыНоменклатуры КАК ИС_Ламода_РазмерыНоменклатуры
			|		ПО ВТ_lamoda_sku.lamoda_sku = ИС_Ламода_РазмерыНоменклатуры.Код
			|			И (ИС_Ламода_РазмерыНоменклатуры.Профиль = &Профиль)
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ
			|	ВТ_Номенклатура.lamoda_sku КАК lamoda_sku,
			|	ЗНАЧЕНИЕ(Справочник.ИС_Ламода_РазмерыНоменклатуры.ПустаяСсылка) КАК РазмерЛамода,
			|	ЗНАЧЕНИЕ(Справочник.ИС_Ламода_Номенклатура.ПустаяСсылка) КАК НоменклатураЛамода
			|ИЗ
			|	ВТ_Номенклатура КАК ВТ_Номенклатура
			|ГДЕ
			|	ВТ_Номенклатура.РазмерЛамода ЕСТЬ NULL
			|
			|ОБЪЕДИНИТЬ
			|
			|ВЫБРАТЬ
			|	ВТ_Номенклатура.lamoda_sku,
			|	ЕСТЬNULL(ВТ_Номенклатура.РазмерЛамода, ЗНАЧЕНИЕ(Справочник.ИС_Ламода_РазмерыНоменклатуры.ПустаяСсылка)),
			|	ЕСТЬNULL(ВТ_Номенклатура.НоменклатураЛамода, ЗНАЧЕНИЕ(Справочник.ИС_Ламода_Номенклатура.ПустаяСсылка))
			|ИЗ
			|	ВТ_Номенклатура КАК ВТ_Номенклатура
			|ГДЕ
			|	ВТ_Номенклатура.ДатаОбновления > ВТ_Номенклатура.ДатаПоследнегоИзменения";
		
		Запрос.УстановитьПараметр("ТЧ",      ТаблицаДанных);
		Запрос.УстановитьПараметр("Профиль", Профиль);
		
		РезультатЗапроса = Запрос.Выполнить();
		Выборка = РезультатЗапроса.Выбрать();
		
		Пока Выборка.Следующий() Цикл
			
			ДопПараметрыНоменклатуры = Новый Структура;
			ДопПараметрыНоменклатуры.Вставить("РазмерЛамода",       Выборка.РазмерЛамода);
			ДопПараметрыНоменклатуры.Вставить("НоменклатураЛамода", Выборка.НоменклатураЛамода);
			
			СоздатьОбновитьНоменклатуру(Профиль, СоответствиеТоваровДляЗагрузки[Выборка.lamoda_sku], Перезаполнять, ДопПараметрыНоменклатуры);
				
			Обработано = Обработано + 1;	
				
		КонецЦикла;
		
		Если ПервыйЗапрос Тогда
			
			КоличествоТоваров = Результат["total"];
			КоличествоСтраниц = Результат["pages"];
			
			ПервыйЗапрос = Ложь;
			
		КонецЕсли;
		
		ДлительныеОперации.СообщитьПрогресс( , "Обработано " + Обработано + " из " + КоличествоТоваров + " карточек товаров");
		
		Если КоличествоЭлементовНаЗапрос > КоличествоТоваров Тогда
			Прервать;
		КонецЕсли;
		
		ТекущаяСтраница = ТекущаяСтраница + 1;
		
	КонецЦикла;
	
	Возврат "Загрузка завершена. Всего загружено " + Обработано + " элементов";
	
КонецФункции //- ИнфоСофт Власова И.С. 23.12.24 УА #90120

//+ ИнфоСофт Власова И.С. 23.12.24 УА #90120
Функция СоздатьОбновитьНоменклатуру(Профиль, Данные, Перезаполнять = Ложь, ДопПараметры = Неопределено) Экспорт
	
	Событие = ИмяСобытия("СоздатьОбновитьНоменклатуруLamoda");
	
	НоменклатураЛамода = Неопределено;
	РазмерЛамода       = Неопределено;
	
	Если Не ДопПараметры = Неопределено 
		И ТипЗнч(ДопПараметры) = Тип("Структура") Тогда
		
		Если ДопПараметры.Свойство("НоменклатураЛамода")
			И Не ДопПараметры.НоменклатураЛамода = Справочники.ИС_Ламода_Номенклатура.ПустаяСсылка() Тогда
		
			НоменклатураЛамода = ДопПараметры.НоменклатураЛамода.ПолучитьОбъект();
		
		КонецЕсли;
		
		Если ДопПараметры.Свойство("РазмерЛамода")
			И Не ДопПараметры.РазмерЛамода = Справочники.ИС_Ламода_РазмерыНоменклатуры.ПустаяСсылка() Тогда
		
			РазмерЛамода = ДопПараметры.РазмерЛамода.ПолучитьОбъект();
			
		КонецЕсли;
			
	КонецЕсли;
	
	Если НоменклатураЛамода = Неопределено Тогда
		НоменклатураЛамода = Справочники.ИС_Ламода_Номенклатура.СоздатьЭлемент();
	КонецЕсли;
	
	НоменклатураЛамода.Профиль      = Профиль;
	НоменклатураЛамода.Код          = Данные["lamoda_parent_sku"];
	НоменклатураЛамода.seller_sku   = Данные["seller_parent_sku"];
	НоменклатураЛамода.brand        = Данные["brand"];
	НоменклатураЛамода.Наименование = Данные["name"];
	
	Попытка
		НоменклатураЛамода.Записать();
	Исключение
		
		ТекстОшибки = ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
		ИС_МП_Сервер.ЗаписатьВЖРИСообщитьПользователю(Событие, ТекстОшибки);
		
		Возврат Неопределено;
		
	КонецПопытки;
	
	Если РазмерЛамода = Неопределено Тогда
		РазмерЛамода = Справочники.ИС_Ламода_РазмерыНоменклатуры.СоздатьЭлемент();
	КонецЕсли;
	
	РазмерЛамода.Профиль      = Профиль;
	РазмерЛамода.Владелец     = НоменклатураЛамода.Ссылка;
	РазмерЛамода.Код          = Данные["lamoda_sku"];
	РазмерЛамода.Наименование = СтрШаблон("%1 %2", Данные["name"], Данные["seller_size"]);
	РазмерЛамода.seller_sku   = Данные["seller_sku"];
	РазмерЛамода.seller_size  = Данные["seller_size"];
	РазмерЛамода.barcode      = Данные["barcode"];
	РазмерЛамода.updated_at   = ИС_МП_РаботаСHTTPЗапросами.ПрочитатьДатуИзJSON(Данные["updated_at"], ФорматДатыJSON.ISO);
	
	Попытка
		РазмерЛамода.Записать();
	Исключение
		
		ТекстОшибки = ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
		ИС_МП_Сервер.ЗаписатьВЖРИСообщитьПользователю(Событие, ТекстОшибки);
		
		Возврат Неопределено;
		
	КонецПопытки;
	
	Возврат РазмерЛамода.Ссылка;
	
КонецФункции //- ИнфоСофт Власова И.С. 23.12.24 УА #90120

