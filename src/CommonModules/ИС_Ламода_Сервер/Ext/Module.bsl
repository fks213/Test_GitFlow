//+ ИнфоСофт Власова И.С. 23.12.24 УА #90120
Функция ПараметрыHTTPЗапросаB2B(Профиль)
	
	НастройкиСоединения = ИС_Ламода_СерверПовтИсп.НастройкиСоединения(Профиль);  
	
	ТекстОшибки = "";
	
	Если Не ЗначениеЗаполнено(НастройкиСоединения.ClientId) Тогда
		ТекстОшибки = ТекстОшибки + 
			"Для данного профиля не заполнено ""client_id"", проверьте настройки авторизации" + Символы.ПС;
	КонецЕсли;

	Если Не ЗначениеЗаполнено(НастройкиСоединения.ClientSecret) Тогда
		ТекстОшибки = ТекстОшибки + 
			"Для данного профиля не заполнено ""client_secret"", проверьте настройки авторизации" + Символы.ПС;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(НастройкиСоединения.АдресСервисаB2B) Тогда
		ТекстОшибки = ТекстОшибки + 
			"Для данного профиля не заполнен ""Адрес cервиса B2B"", проверьте настройки авторизации" + Символы.ПС;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(НастройкиСоединения.ПортB2B) Тогда
		ТекстОшибки = ТекстОшибки + 
			"Для данного профиля не заполнен ""Порт B2B"", проверьте настройки авторизации" + Символы.ПС;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(НастройкиСоединения.HTTPSB2B) Тогда
		ТекстОшибки = ТекстОшибки + 
			"Для данного профиля не заполнено ""Защищенное соединение B2B"", проверьте настройки авторизации" + Символы.ПС;
	КонецЕсли;
	
	ТекстОшибки = СокрП(ТекстОшибки); 

	Если ЗначениеЗаполнено(ТекстОшибки) Тогда
		ВызватьИсключение(ТекстОшибки);
	КонецЕсли;
	
	ПараметрыЗапроса = ИС_МП_РаботаСHTTPЗапросами.СтруктураHTTPЗапроса();
	ПараметрыЗапроса.Сервер               = НастройкиСоединения.АдресСервисаB2B;
	ПараметрыЗапроса.Порт                 = НастройкиСоединения.ПортB2B;
	ПараметрыЗапроса.ЗащищенноеСоединение = НастройкиСоединения.HTTPSB2B;
	
	Если Не ЗначениеЗаполнено(НастройкиСоединения.AccessTokenB2BИстекает) 
		Или НастройкиСоединения.AccessTokenB2BИстекает <= ТекущаяДатаСеанса() Тогда
			
		Токен = ПолучитьТокенB2B(Профиль, ПараметрыЗапроса, НастройкиСоединения);
		
		Если Токен = Неопределено Тогда
			ВызватьИсключение("Не удалось обновить токены доступа к Lamoda B2B");
		КонецЕсли;
		
	Иначе
		Токен = НастройкиСоединения.AccessTokenB2B;
	КонецЕсли;
	
	ПараметрыЗапроса.Заголовки.Вставить("Authorization", "Bearer " + Токен);
	
	Возврат ПараметрыЗапроса;

КонецФункции //- ИнфоСофт Власова И.С. 23.12.24 УА #90120

