//+ ИнфоСофт Власова И.С. 23.12.24 УА #90120
Функция ТекстЗапросаСопоставления() Экспорт

	Текст =
		"ВЫБРАТЬ
		|	ИС_Ламода_РазмерыНоменклатуры.Ссылка КАК РазмерЛамода,
		|	ИС_Ламода_РазмерыНоменклатуры.Владелец КАК НоменклатураЛамода,
		|	ИС_Ламода_РазмерыНоменклатуры.Код КАК LamodaSKU,
		|	ИС_Ламода_РазмерыНоменклатуры.barcode КАК ШтрихкодЛамода,
		|	ЕСТЬNULL(ИС_Ламода_СоответствиеТоваров.Номенклатура, ЗНАЧЕНИЕ(Справочник.Номенклатура.ПустаяСсылка)) КАК Номенклатура,
		|	ЕСТЬNULL(ИС_Ламода_СоответствиеТоваров.Характеристика, ЗНАЧЕНИЕ(Справочник.ХарактеристикиНоменклатуры.ПустаяСсылка)) КАК Характеристика,
		|	ВЫБОР
		|		КОГДА ИС_Ламода_СоответствиеТоваров.Упаковка = ЗНАЧЕНИЕ(Справочник.УпаковкиЕдиницыИзмерения.ПустаяСсылка)
		|				ИЛИ ИС_Ламода_СоответствиеТоваров.Упаковка ЕСТЬ NULL
		|			ТОГДА ИС_Ламода_СоответствиеТоваров.Номенклатура.ЕдиницаИзмерения
		|		ИНАЧЕ ИС_Ламода_СоответствиеТоваров.Упаковка
		|	КОНЕЦ КАК Упаковка
		|ИЗ
		|	Справочник.ИС_Ламода_РазмерыНоменклатуры КАК ИС_Ламода_РазмерыНоменклатуры
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ИС_Ламода_СоответствиеТоваров КАК ИС_Ламода_СоответствиеТоваров
		|		ПО (ИС_Ламода_СоответствиеТоваров.Профиль = &Профиль)
		|			И ИС_Ламода_РазмерыНоменклатуры.Ссылка = ИС_Ламода_СоответствиеТоваров.РазмерЛамода
		|ГДЕ
		|	ИС_Ламода_РазмерыНоменклатуры.Профиль = &Профиль
		|	И НЕ ИС_Ламода_РазмерыНоменклатуры.ПометкаУдаления
		|
		|УПОРЯДОЧИТЬ ПО
		|	Номенклатура,
		|	НоменклатураЛамода";  
	
	Возврат Текст;
	
КонецФункции //- ИнфоСофт Власова И.С. 23.12.24 УА #90120

//+ ИнфоСофт Власова И.С. 23.12.24 УА #90120
Функция ДобавитьСоответствиеТовара(Профиль, РазмерЛамода, Номенклатура, Характеристика, Упаковка, 
		ТекНоменклатура = Неопределено, ТекХарактеристика = Неопределено) Экспорт
		
	НаборЗаписей = РегистрыСведений.ИС_Ламода_СоответствиеТоваров.СоздатьНаборЗаписей();
	
	НаборЗаписей.Отбор.Профиль.Установить(Профиль);
	НаборЗаписей.Отбор.РазмерЛамода.Установить(РазмерЛамода);
		
	НаборЗаписей.Прочитать(); 
	
	ТребуетсяНоваяЗапись = Истина;	
	
	Если НаборЗаписей.Количество() > 0 Тогда 
		
		Для Каждого Запись Из НаборЗаписей Цикл
		
			Если Запись.Номенклатура = ТекНоменклатура И Запись.Характеристика = ТекХарактеристика Тогда
			
				Запись.Номенклатура   = Номенклатура;
				Запись.Характеристика = Характеристика;
				Запись.Упаковка       = Упаковка;
        		ТребуетсяНоваяЗапись  = Ложь;
        		Прервать;
			
			КонецЕсли;
		
		КонецЦикла; 	
	
	КонецЕсли;
   
    Если ТребуетсяНоваяЗапись Тогда
	
		НоваяЗапись = НаборЗаписей.Добавить();
		
		НоваяЗапись.Профиль        = Профиль; 
		НоваяЗапись.РазмерЛамода   = РазмерЛамода;
		НоваяЗапись.Номенклатура   = Номенклатура; 
		НоваяЗапись.Характеристика = Характеристика;
		НоваяЗапись.Упаковка       = Упаковка;
		
	КонецЕсли;
				
	НаборЗаписей.Записывать = Истина; 
	
	НаборЗаписей.Записать(Истина);
	
КонецФункции //- ИнфоСофт Власова И.С. 23.12.24 УА #90120

