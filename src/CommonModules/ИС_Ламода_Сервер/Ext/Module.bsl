//+ ИнфоСофт Власова И.С. 23.12.24 УА #90120
Процедура ВыполнитьКомандуРеглЗадания(Профиль, ИдентификаторКомандыОбработки) Экспорт

	Событие = ИмяСобытия("ВыполнитьКомандуРеглЗадания");
	 
	Если ИдентификаторКомандыОбработки = "ВыгрузкаОстатковЛамода" Тогда
	
		Запрос = Новый Запрос;
		Запрос.Текст = 
			"ВЫБРАТЬ
			|	ИС_Ламода_Склады.Ссылка КАК Ссылка
			|ИЗ
			|	Справочник.ИС_Ламода_Склады КАК ИС_Ламода_Склады
			|ГДЕ
			|	НЕ ИС_Ламода_Склады.ПометкаУдаления
			|	И ИС_Ламода_Склады.Профиль = &Профиль
			|	И НЕ(ИС_Ламода_Склады.ОбщаяГруппаСкладов = ЗНАЧЕНИЕ(Справочник.Склады.ПустаяСсылка)
			|				И ИС_Ламода_Склады.Склад = ЗНАЧЕНИЕ(Справочник.Склады.ПустаяСсылка)
			|				И НЕ ИС_Ламода_Склады.ВыгружатьОстаткиИзГруппыСкладов)";
		
		Запрос.УстановитьПараметр("Профиль", Профиль);
		
		РезультатЗапроса = Запрос.Выполнить();
		
		Выборка = РезультатЗапроса.Выбрать();
		
		Пока Выборка.Следующий() Цикл
			ВыгрузитьОстатки(Профиль, Выборка.Ссылка);
		КонецЦикла;
		
		Возврат;
		
	КонецЕсли;

КонецПроцедуры //- ИнфоСофт Власова И.С. 23.12.24 УА #90120

