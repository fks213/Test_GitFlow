//+ ИнфоСофт Власова И.С. 23.12.24 УА #90120
Функция ТекстЗапросаОстатков() Экспорт
	
	Текст =
		"ВЫБРАТЬ
		|	ИС_Ламода_РазмерыНоменклатуры.Ссылка КАК ПолеСопоставления,
		|	ИС_Ламода_РазмерыНоменклатуры.Владелец КАК НоменклатураЛамода,
		|	ИС_Ламода_РазмерыНоменклатуры.Код КАК LamodaSKU,
		|	ИС_Ламода_РазмерыНоменклатуры.seller_sku КАК SellerSKU,
		|	ИС_Ламода_СоответствиеТоваров.Номенклатура КАК Номенклатура,
		|	ИС_Ламода_СоответствиеТоваров.Характеристика КАК Характеристика,
		|	ЕСТЬNULL(ИС_Ламода_СоответствиеТоваров.Упаковка, &ПустаяУпаковка) КАК Упаковка,
		|	НЕ ИС_Ламода_СоответствиеТоваров.Номенклатура ЕСТЬ NULL КАК ЕстьСопоставление,
		|	ЕСТЬNULL(ИС_Ламода_СоответствиеТоваров.Номенклатура.ТипНоменклатуры, ЗНАЧЕНИЕ(Перечисление.ТипыНоменклатуры.ПустаяСсылка)) = ЗНАЧЕНИЕ(Перечисление.ТипыНоменклатуры.Набор) КАК ЭтоНабор,
		|	ВЫБОР
		|		КОГДА ИС_Ламода_СоответствиеТоваров.Упаковка.Числитель = 0
		|			ТОГДА 1
		|		ИНАЧЕ ЕСТЬNULL(ИС_Ламода_СоответствиеТоваров.Упаковка.Числитель, 1)
		|	КОНЕЦ / ВЫБОР
		|		КОГДА ИС_Ламода_СоответствиеТоваров.Упаковка.Знаменатель = 0
		|			ТОГДА 1
		|		ИНАЧЕ ЕСТЬNULL(ИС_Ламода_СоответствиеТоваров.Упаковка.Знаменатель, 1)
		|	КОНЕЦ КАК КоэффициентУпаковки
		|ПОМЕСТИТЬ ВТ_Сопоставление
		|ИЗ
		|	Справочник.ИС_Ламода_РазмерыНоменклатуры КАК ИС_Ламода_РазмерыНоменклатуры
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ИС_Ламода_СоответствиеТоваров КАК ИС_Ламода_СоответствиеТоваров
		|		ПО (ИС_Ламода_СоответствиеТоваров.Профиль = &Профиль)
		|			И (ИС_Ламода_СоответствиеТоваров.РазмерЛамода = ИС_Ламода_РазмерыНоменклатуры.Ссылка)
		|ГДЕ
		|	ИС_Ламода_РазмерыНоменклатуры.Профиль = &Профиль
		|	И НЕ ИС_Ламода_РазмерыНоменклатуры.ПометкаУдаления";
		
	Текст = Текст + ";";
			
	Текст = Текст + ИС_МП_УправлениеОстатками.ТекстЗапросаОстатков();
		
	Текст = Текст +
		"ВЫБРАТЬ
		|	ВТ_Сопоставление.ПолеСопоставления КАК РазмерЛамода,
		|	ВТ_Сопоставление.НоменклатураЛамода КАК НоменклатураЛамода,
		|	ВТ_Сопоставление.LamodaSKU КАК LamodaSKU,
		|	ВТ_Сопоставление.SellerSKU КАК SellerSKU,
		|	ВТ_Сопоставление.Номенклатура КАК Номенклатура,
		|	ВТ_Сопоставление.Характеристика КАК Характеристика,
		|	ВТ_Остатки.Свободно КАК Свободно,
		|	ВТ_Остатки.Резерв КАК Резерв,
		|	ВЫБОР
		|		КОГДА ИС_MP_ОграничениеОстатков.Остаток ЕСТЬ NULL
		|			ТОГДА &КоличествоСкрываемогоОстатка
		|		ИНАЧЕ ИС_MP_ОграничениеОстатков.Остаток
		|	КОНЕЦ КАК СкрываемыйОстаток,
		|	НЕ ИС_MP_ОграничениеОстатков.Остаток ЕСТЬ NULL КАК ЕстьСкрываемыйОстаток,
		|	ИС_MP_РучныеОстатки.Остаток КАК РучнойОстаток,
		|	НЕ ИС_MP_РучныеОстатки.Остаток ЕСТЬ NULL КАК ЕстьРучнойОстаток,
		|	ВТ_Сопоставление.ЕстьСопоставление КАК ЕстьСопоставление,
		|	ЕСТЬNULL(ИС_MP_ПоследниеВыгруженныеОстатки.Остаток, 0) КАК ПоследнийВыгруженныйОстаток,
		|	НЕ ИС_MP_ПоследниеВыгруженныеОстатки.Остаток ЕСТЬ NULL КАК ЕстьПоследнийВыгруженныйОстаток
		|ИЗ
		|	ВТ_Сопоставление КАК ВТ_Сопоставление
		|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_Остатки КАК ВТ_Остатки
		|			ПО ВТ_Сопоставление.ПолеСопоставления = ВТ_Остатки.ПолеСопоставления
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ИС_MP_ОграничениеОстатков КАК ИС_MP_ОграничениеОстатков
		|		ПО (ИС_MP_ОграничениеОстатков.Профиль = &Профиль)
		|			И (ИС_MP_ОграничениеОстатков.Маркетплейс = &Маркетплейс)
		|			И ((ВЫРАЗИТЬ(ИС_MP_ОграничениеОстатков.КарточкаМП КАК Справочник.ИС_Ламода_РазмерыНоменклатуры)) = ВТ_Сопоставление.ПолеСопоставления)
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ИС_MP_РучныеОстатки КАК ИС_MP_РучныеОстатки
		|		ПО (ИС_MP_РучныеОстатки.Профиль = &Профиль)
		|			И (ИС_MP_РучныеОстатки.Маркетплейс = &Маркетплейс)
		|			И ((ВЫРАЗИТЬ(ИС_MP_РучныеОстатки.КарточкаМП КАК Справочник.ИС_Ламода_РазмерыНоменклатуры)) = ВТ_Сопоставление.ПолеСопоставления)
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ИС_MP_ПоследниеВыгруженныеОстатки КАК ИС_MP_ПоследниеВыгруженныеОстатки
		|		ПО (ИС_MP_ПоследниеВыгруженныеОстатки.Профиль = &Профиль)
		|			И (ИС_MP_ПоследниеВыгруженныеОстатки.Маркетплейс = &Маркетплейс)
		|			И ((ВЫРАЗИТЬ(ИС_MP_ПоследниеВыгруженныеОстатки.КарточкаМП КАК Справочник.ИС_Ламода_РазмерыНоменклатуры)) = ВТ_Сопоставление.ПолеСопоставления)
		|
		|УПОРЯДОЧИТЬ ПО
		|	ВТ_Сопоставление.ЕстьСопоставление УБЫВ";
	
	Возврат Текст;		
	
КонецФункции //- ИнфоСофт Власова И.С. 23.12.24 УА #90120

//+ ИнфоСофт Власова И.С. 23.12.24 УА #90120
Функция ИнформацияОСкладе(Склад) Экспорт

	ЗапросСклада = Новый Запрос;
	ЗапросСклада.Текст = 
		"ВЫБРАТЬ
		|	ИС_Ламода_Склады.Ссылка КАК Ссылка,
		|	ИС_Ламода_Склады.ВыгружатьОстаткиИзГруппыСкладов КАК ВыгружатьОстаткиИзГруппыСкладов,
		|	ИС_Ламода_Склады.Склад КАК Склад,
		|	ИС_Ламода_Склады.ОбщаяГруппаСкладов КАК ОбщаяГруппаСкладов,
		|	ИС_Ламода_СкладыГруппаСкладов.Склад КАК СкладГруппы
		|ИЗ
		|	Справочник.ИС_Ламода_Склады КАК ИС_Ламода_Склады
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ИС_Ламода_Склады.ГруппаСкладов КАК ИС_Ламода_СкладыГруппаСкладов
		|		ПО ИС_Ламода_Склады.Ссылка = ИС_Ламода_СкладыГруппаСкладов.Ссылка
		|ГДЕ
		|	ИС_Ламода_Склады.Ссылка = &Ссылка
		|ИТОГИ ПО
		|	Ссылка";
	
	ЗапросСклада.УстановитьПараметр("Ссылка", Склад);
	
	РезультатЗапроса = ЗапросСклада.Выполнить();
	
	ВыборкаСклад = РезультатЗапроса.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	Результат = "";
		
	Пока ВыборкаСклад.Следующий() Цикл				
				
		Если ВыборкаСклад.ВыгружатьОстаткиИзГруппыСкладов Тогда 
		    
		    Результат = Результат + "Группа складов: " + Символы.ПС;
		    
			ВыборкаГруппаСкладов = ВыборкаСклад.Выбрать();
		
			Пока ВыборкаГруппаСкладов.Следующий() Цикл
			
				Если ВыборкаГруппаСкладов.СкладГруппы <> Null Тогда
			    	Результат = Результат + Символы.Таб + " - " + ВыборкаГруппаСкладов.СкладГруппы + Символы.ПС;
			    КонецЕсли;
			    
			КонецЦикла;				
		
		ИначеЕсли ЗначениеЗаполнено(ВыборкаСклад.ОбщаяГруппаСкладов) Тогда
			Результат = Результат + "Общая группа складов: " + ВыборкаСклад.ОбщаяГруппаСкладов + Символы.ПС;
		Иначе
			Результат = Результат + "Склад: " + ВыборкаСклад.Склад + Символы.ПС;		
		КонецЕсли;
	
	КонецЦикла;
    
    Возврат Результат;

КонецФункции //- ИнфоСофт Власова И.С. 23.12.24 УА #90120

//+ ИнфоСофт Власова И.С. 23.12.24 УА #90120
Процедура УстановитьПараметрыЗапросаОстатков(Запрос, Профиль, Склад) Экспорт
	
	Событие = ИмяСобытия("УстановитьПараметрыЗапросаОстатковЛамода");
	
	Маркетплейс = Перечисления.ИС_МП_Маркетплейсы.Ламода;
	
	Настройки = ИС_Ламода_СерверПовтИсп.НастройкиОстатков(Профиль);
	
	СкрываемыйОстаток                   = 0;
	РассчитыватьНесобранныеКомплекты    = Ложь;
	ВыгружатьОстаткиВРазрезеОрганизации = Ложь;
	                    
	Если Настройки.СкрываемыйОстаток <> Неопределено Тогда
		СкрываемыйОстаток = Настройки.СкрываемыйОстаток;       
	КонецЕсли;
	
	Если Настройки.РассчитыватьНесобранныеКомплекты <> Неопределено Тогда
		РассчитыватьНесобранныеКомплекты = Настройки.РассчитыватьНесобранныеКомплекты;       
	КонецЕсли;
	
	Если Настройки.ВыгружатьОстаткиВРазрезеОрганизации <> Неопределено Тогда
		ВыгружатьОстаткиВРазрезеОрганизации = Настройки.ВыгружатьОстаткиВРазрезеОрганизации;       
	КонецЕсли;
			
	Запрос.УстановитьПараметр("Профиль", 							 Профиль);
	Запрос.УстановитьПараметр("Маркетплейс", 						 Маркетплейс);
	Запрос.УстановитьПараметр("Склад", 								 Склад); 
	Запрос.УстановитьПараметр("КоличествоСкрываемогоОстатка",        СкрываемыйОстаток);
	Запрос.УстановитьПараметр("РассчитыватьНесобранныеКомплекты",    РассчитыватьНесобранныеКомплекты);
	Запрос.УстановитьПараметр("ВыгружатьОстаткиВРазрезеОрганизации", ВыгружатьОстаткиВРазрезеОрганизации);
	Запрос.УстановитьПараметр("Организация", 						 Настройки.Организация);
	Запрос.УстановитьПараметр("ПустаяУпаковка", 					 ИС_МП_СерверЛокализация.ПустаяСсылкаУпаковка());
	
	Заменитель = "ИЕРАРХИИ";
	
	ПараметрСклад = Неопределено;
	
	ЗапросНазначений = Новый Запрос;
	ЗапросНазначений.Текст = 
	"ВЫБРАТЬ
	|	ЕСТЬNULL(Назначения.Ссылка, ЗНАЧЕНИЕ(Справочник.Назначения.ПустаяСсылка)) КАК Назначение
	|ИЗ
	|	Справочник.ИС_Ламода_Склады.НаправленияДеятельности КАК ИС_Ламода_СкладыНаправленияДеятельности
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Назначения КАК Назначения
	|		ПО ИС_Ламода_СкладыНаправленияДеятельности.НаправлениеДеятельности = Назначения.НаправлениеДеятельности
	|			И (Назначения.НаправлениеДеятельности <> ЗНАЧЕНИЕ(Справочник.НаправленияДеятельности.ПустаяСсылка))
	|ГДЕ
	|	ИС_Ламода_СкладыНаправленияДеятельности.Ссылка = &Ссылка";
	
	ЗапросНазначений.УстановитьПараметр("Ссылка", Склад);
	
	РезультатЗапросаНазначений = ЗапросНазначений.Выполнить();
	
	ВыборкаНазначения = РезультатЗапросаНазначений.Выбрать();
	
	Если ВыборкаНазначения.Количество() = 0 Тогда		
		Назначения = Справочники.Назначения.ПустаяСсылка();	
	Иначе	
		
		Назначения = Новый Массив;
		
		Пока ВыборкаНазначения.Следующий() Цикл	
			Назначения.Добавить(ВыборкаНазначения.Назначение);
		КонецЦикла;
		
	КонецЕсли;

	Запрос.УстановитьПараметр("Назначение", Назначения);	
		
	ЗапросСклада = Новый Запрос;
	ЗапросСклада.Текст = 
		"ВЫБРАТЬ
		|	ИС_Ламода_Склады.Ссылка КАК Ссылка,
		|	ИС_Ламода_Склады.ВыгружатьОстаткиИзГруппыСкладов КАК ВыгружатьОстаткиИзГруппыСкладов,
		|	ИС_Ламода_Склады.Склад КАК Склад,
		|	ИС_Ламода_Склады.ОбщаяГруппаСкладов КАК ОбщаяГруппаСкладов,
		|	ИС_Ламода_Склады.Склад КАК СкладГруппы
		|ИЗ
		|	Справочник.ИС_Ламода_Склады КАК ИС_Ламода_Склады
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ИС_Ламода_Склады.ГруппаСкладов КАК ИС_Ламода_СкладыГруппаСкладов
		|		ПО ИС_Ламода_Склады.Ссылка = ИС_Ламода_СкладыГруппаСкладов.Ссылка
		|ГДЕ
		|	ИС_Ламода_Склады.Ссылка = &Ссылка
		|ИТОГИ ПО
		|	Ссылка";

	ЗапросСклада.УстановитьПараметр("Ссылка", Склад);
	
	РезультатЗапроса = ЗапросСклада.Выполнить();
	
	ВыборкаСклад = РезультатЗапроса.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	Пока ВыборкаСклад.Следующий() Цикл
			
		Если ВыборкаСклад.ВыгружатьОстаткиИзГруппыСкладов Тогда 
		    
		    ПараметрСклад = Новый Массив;
		    
			ВыборкаГруппаСкладов = ВыборкаСклад.Выбрать();
		
			Пока ВыборкаГруппаСкладов.Следующий() Цикл
			
				Если ВыборкаГруппаСкладов.СкладГруппы <> Null Тогда
			    	ПараметрСклад.Добавить(ВыборкаГруппаСкладов.СкладГруппы);
			    КонецЕсли;
			    
			КонецЦикла;				
		
		ИначеЕсли ЗначениеЗаполнено(ВыборкаСклад.ОбщаяГруппаСкладов) Тогда
			Заменитель = "";
			ПараметрСклад = ВыборкаСклад.ОбщаяГруппаСкладов;
		Иначе
			ПараметрСклад = ВыборкаСклад.Склад;
		КонецЕсли;
	
	КонецЦикла;
	
	Если ЗначениеЗаполнено(Заменитель) Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, Заменитель, "");
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(ПараметрСклад) Тогда
		Текст = СтрШаблон("Не заполнено сопоставление склада %1 (%2)", ПараметрСклад, Профиль);
		ИС_МП_Сервер.ЗаписатьВЖРИСообщитьПользователю(Событие, Текст); 
	КонецЕсли;
	 
	Запрос.УстановитьПараметр("Склад1С", ПараметрСклад);
	
КонецПроцедуры //- ИнфоСофт Власова И.С. 23.12.24 УА #90120

//+ ИнфоСофт Власова И.С. 23.12.24 УА #90120
Функция ПолучитьОстатки(Профиль) Экспорт
	
	Если Не ЗначениеЗаполнено(Профиль) Тогда
		ОбщегоНазначения.СообщитьПользователю("Не выбран Профиль. Получение остатков невозможно");
		Возврат Новый ТаблицаЗначений;
	КонецЕсли;
	
	ПараметрыЗапроса = ПараметрыHTTPЗапросаB2B(Профиль);
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ИС_Ламода_РазмерыНоменклатуры.Ссылка КАК РазмерЛамода,
		|	ИС_Ламода_РазмерыНоменклатуры.seller_sku КАК SellerSKU,
		|	0 КАК Остаток
		|ИЗ
		|	Справочник.ИС_Ламода_РазмерыНоменклатуры КАК ИС_Ламода_РазмерыНоменклатуры
		|ГДЕ
		|	ИС_Ламода_РазмерыНоменклатуры.Профиль = &Профиль
		|	И НЕ ИС_Ламода_РазмерыНоменклатуры.ПометкаУдаления
		|	И НЕ ИС_Ламода_РазмерыНоменклатуры.Код = """"";
	
	Запрос.УстановитьПараметр("Профиль", Профиль);
		
	Результат = Запрос.Выполнить().Выгрузить();
	
	МассивSKU = Результат.ВыгрузитьКолонку("SellerSKU");
	
	КоличествоЭлементов = 25;
	
	РазбитыйМассив = ИС_MP_Сервер.РазбитьМассивПоNЭлементов(МассивSKU, КоличествоЭлементов);
	
	Для Каждого ЭлементМассива Из РазбитыйМассив Цикл
		
		СтруктураПараметров = Новый Структура;
		СтруктураПараметров.Вставить("sku", ЭлементМассива);
		
		ОстаткиТоваров = ИС_Ламода_АПИ.ПолучитьОстатки(Профиль, ПараметрыЗапроса, СтруктураПараметров);
		                                                                                       
		Если ОстаткиТоваров = Неопределено Или ОстаткиТоваров.Свойство("stockStates") = Неопределено Тогда
			Возврат Новый ТаблицаЗначений;	
		КонецЕсли;
		
		Для Каждого Товар Из ОстаткиТоваров.stockStates Цикл
			
			НайденныеСтроки = Результат.НайтиСтроки(Новый Структура("SellerSKU", Товар.sku));
			НайденныеСтроки[0].Остаток = Число(Товар.quantity);
			
		КонецЦикла;
		
	КонецЦикла;
                							
	Возврат Результат;
	
КонецФункции //- ИнфоСофт Власова И.С. 23.12.24 УА #90120

//+ ИнфоСофт Власова И.С. 23.12.24 УА #90120
Процедура ВыгрузитьОстатки(Профиль, Склад, ТаблицаВыгрузки = Неопределено) Экспорт
	
	Если Не ЗначениеЗаполнено(Профиль) Тогда
		ОбщегоНазначения.СообщитьПользователю("Не выбран Профиль. Получение остатков невозможно");
		Возврат;
	КонецЕсли;
	
	ПеречислениеМП = Перечисления.ИС_МП_Маркетплейсы.Ламода;
	
	МассивНастроек = ИС_МП_УправлениеОстатками.МассивПараметровВыгрузкиОстатков();	
	
	Настройки = ИС_МП_Сервер.ПолучитьЗначениеНастроек(Профиль, ПеречислениеМП, МассивНастроек);
		
	ИспользоватьПоследниеОстатки = Ложь;
	
	Если Настройки.ИспользоватьПоследниеОстатки <> Неопределено Тогда
		ИспользоватьПоследниеОстатки = Настройки.ИспользоватьПоследниеОстатки;
	КонецЕсли;
		
	Если ТаблицаВыгрузки = Неопределено Тогда		
		ТаблицаВыгрузки = ИС_МП_УправлениеОстатками.СформироватьТаблицуВыгрузки(Профиль, Склад, ПеречислениеМП, Настройки);		
	КонецЕсли;
	
	Если ТаблицаВыгрузки.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	МассивНоменклатуры = Новый Массив;
	
	Для Каждого Строка Из ТаблицаВыгрузки Цикл
		
		СтруктураВыгрузки = Новый Структура;
		СтруктураВыгрузки.Вставить("sku",      Строка.SellerSKU);
		СтруктураВыгрузки.Вставить("quantity", Строка.Остаток);
		
		МассивНоменклатуры.Добавить(СтруктураВыгрузки);
		
	КонецЦикла;
	
	ПараметрыЗапроса = ПараметрыHTTPЗапросаB2B(Профиль);
	
	ПределОшибок     = 10;
	КоличествоОшибок = 0;
	
	БылиОшибкиВыгрузки = Ложь;
	
	Пока Истина Цикл
		
		Если КоличествоОшибок >= ПределОшибок Тогда
			Возврат;
		КонецЕсли;
		
		СтруктураПараметров = Новый Структура;
		СтруктураПараметров.Вставить("stockStates", МассивНоменклатуры);
		
		Результат = ИС_Ламода_АПИ.ВыгрузитьОстатки(Профиль, ПараметрыЗапроса, СтруктураПараметров);
			
		Если Результат = Неопределено Тогда
			
			КоличествоОшибок = КоличествоОшибок + 1;
			БылиОшибкиВыгрузки = Истина;
			Продолжить;
			
		Иначе	
			Прервать;
		КонецЕсли;
		
	КонецЦикла;
	
	Если Не ИспользоватьПоследниеОстатки Тогда
		Возврат;
	КонецЕсли;
	
	Если Не БылиОшибкиВыгрузки Тогда 
	
		Для Каждого Строка Из ТаблицаВыгрузки Цикл
			
			ИС_МП_УправлениеОстатками.ЗаписатьПоследнийВыгруженныйОстаток(Профиль, 
				ПеречислениеМП, Склад, Строка.РазмерЛамода, Строка.Остаток);
				
		КонецЦикла;

	КонецЕсли;
	
КонецПроцедуры //- ИнфоСофт Власова И.С. 23.12.24 УА #90120

//+ ИнфоСофт Власова И.С. 23.12.24 УА #90120
Функция ПолучитьСтруктуруПараметровОстатков() Экспорт
	
	Результат = Новый Структура;
	
	Результат.Вставить("ИспользоватьПоследниеОстатки",     Ложь);
	Результат.Вставить("ИспользоватьФиксированныйОстаток", Ложь);
	Результат.Вставить("ФиксированныйОстаток",             0);
	Результат.Вставить("РежимСокрытияОстатков",            Ложь);

    Возврат Результат;
	
КонецФункции //- ИнфоСофт Власова И.С. 23.12.24 УА #90120

//+ ИнфоСофт Власова И.С. 23.12.24 УА #90120
Функция ПолучитьСкладПоУмолчанию(Профиль) Экспорт

	Результат = Справочники.ИС_Ламода_Склады.ПустаяСсылка();
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ ПЕРВЫЕ 2
	|	ИС_Ламода_Склады.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.ИС_Ламода_Склады КАК ИС_Ламода_Склады
	|ГДЕ
	|	ИС_Ламода_Склады.Профиль = &Профиль
	|	И НЕ ИС_Ламода_Склады.ПометкаУдаления";

	Запрос.УстановитьПараметр("Профиль", Профиль);
		
	РезультатЗапроса = Запрос.Выполнить();
	
	Выборка = РезультатЗапроса.Выбрать();

	Если Выборка.Количество() = 1 Тогда
		Выборка.Следующий();
		Результат = Выборка.Ссылка;
	КонецЕсли; 
	
	Возврат Результат;
	
КонецФункции //- ИнфоСофт Власова И.С. 23.12.24 УА #90120

