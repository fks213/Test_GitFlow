//+ ИнфоСофт Ивонин К.А. 12.11.23 УА #55166
// sticker/print
Функция ПолучитьЭтикетки(Профиль, ПараметрыЗапроса, Data) Экспорт

	ЗаполнитьЗаголовкиHTTP(ПараметрыЗапроса);
		
	ПараметрыЗапроса.АдресРесурса = "/api/market/v1/orderService/sticker/print";
	ПараметрыЗапроса.ФорматОтвета = "ДвоичныеДанные";
		
	ТелоЗапроса = Новый Структура;
	ТелоЗапроса.Вставить("meta", Новый Структура);	
	ТелоЗапроса.Вставить("data", Data); 
	
	ПараметрыЗапроса.ТелоСтрока = ИС_MP_РаботаСHTTPЗапросамиСервер.ПолучитьСтрокуJSON(ТелоЗапроса);
	
	РезультатЗапроса = ИС_MP_РаботаСHTTPЗапросамиСервер.ОтправитьPOSTЗапрос(ПараметрыЗапроса);
	
	ЗаписатьДанныеОтладки(Профиль, Перечисления.ИС_МП_МетодыHTTP.POST, ПараметрыЗапроса, РезультатЗапроса);
	
	Если РезультатЗапроса.ЕстьОшибки Тогда
		Текст = СтрШаблон("Произошла ошибка при отправке запроса: %1",	РезультатЗапроса.ИнформацияОбОшибке.Описание);
		ОбщегоНазначения.СообщитьПользователю(Текст);
		Возврат Неопределено;
	Иначе
	
		Если РезультатЗапроса.КодОтвета = 200 Тогда
		
			// >_< тут даже заголовкам доверять нельзя ='(
			Если Лев(РезультатЗапроса.Ответ, 2) = "7B" Тогда
				Возврат РазобратьHTTPОтвет(РезультатЗапроса.Ответ);
			Иначе
				Возврат РезультатЗапроса.Ответ;
			КонецЕсли;
								
		Иначе
			
			Текст = СтрШаблон("Произошла неизвестная ошибка, код ответа: %1, ошибка: %2", 
				РезультатЗапроса.КодОтвета, РезультатЗапроса.Ответ);			
			ОбщегоНазначения.СообщитьПользователю(Текст);
			Возврат Неопределено;
		
		КонецЕсли;
			
	КонецЕсли;	

КонецФункции //- ИнфоСофт Ивонин К.А. 12.11.23 УА #55166

