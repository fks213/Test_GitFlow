    Результат = Новый Структура;
    
    Результат.Вставить("token", "");
    Результат.Вставить("dateFrom", Дата(1, 1, 1));
    Результат.Вставить("dateTo", Дата(1, 1, 1));
    Результат.Вставить("count", 1);
    Результат.Вставить("statuses", Новый Массив);

