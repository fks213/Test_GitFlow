//+ ИнфоСофт Ивонин К.А. 13.08.23 УА #61542
Функция РазобратьHTTPОтвет(Ответ)

	JSON = ИС_MP_РаботаСHTTPЗапросамиСервер.ПолучитьОбъектJSON(Ответ);
						
	Попытка
	
		Если ТипЗнч(JSON) = Тип("Структура") Тогда
			
			Если JSON.Свойство("success") Тогда
			
				Если JSON.success = 1 Тогда
				
					Возврат JSON.data;
				
				ИначеЕсли JSON.success = 0 Тогда
					
					Текст = СтрШаблон("Произошла ошибка запроса: %1 (%2)", JSON.error.message, JSON.error.code);
					ОбщегоНазначения.СообщитьПользователю(Текст);
					Возврат Неопределено;		
				
				КонецЕсли;
			
			КонецЕсли;

		КонецЕсли;
		
	Исключение
	КонецПопытки;

	Текст = СтрШаблон("Получен нераспознанный ответ от сервера: %1", Ответ);
	ОбщегоНазначения.СообщитьПользователю(Текст);
	Возврат Неопределено;
	
КонецФункции //- ИнфоСофт Ивонин К.А. 13.08.23 УА #61542

