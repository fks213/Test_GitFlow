Функция РазборКодаМаркировки(ДанныеДляРазбора) Экспорт   
	
	ОбщийМодуль = ОпределитьОбщийМодульРазбораКодаМаркировки();    
	Возврат ОбщийМодуль.РазобратьКодМаркировки(ДанныеДляРазбора);	
	
КонецФункции //- ИнфоСофт Мурсалимов Д.Р. 05.03.24 УА #70747

//+ ИнфоСофт Мурсалимов Д.Р. 05.08.24 УА #80967
Функция ПолучитьКизНоменклатуры(Данные) Экспорт
	
	КодМаркировки = "";
	
	СтруктураКода = РазборКодаМаркировки(Данные.ЗначениеШтрихкода);
	
	Если СтруктураКода.Свойство("СоставКодаМаркировки") Тогда
	    
	    GTIN = СтруктураКода.СоставКодаМаркировки.GTIN;
	    СерийныйНомер = СтруктураКода.СоставКодаМаркировки.СерийныйНомер;
		
		КодМаркировки = "01" + GTIN + "21" + СерийныйНомер;
		
		РазделительGS1 = МенеджерОборудованияМаркировкаКлиентСервер.РазделительGS1();
    	ЭкранированныйСимволGS1 = "\u001d";
   	 	КодМаркировки = СтрЗаменить(КодМаркировки, РазделительGS1, ЭкранированныйСимволGS1);
	
	КонецЕсли;
	
	Возврат КодМаркировки;
	
КонецФункции //- ИнфоСофт Мурсалимов Д.Р. 05.08.24 УА #80967

//+ ИнфоСофт Стояк Ю.К. 13.08.2024 УА #81686
