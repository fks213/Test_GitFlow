	//+ ИнфоСофт Заварин К.В. 21.03.25 УА #96791
	ПараметрыСканирования.Вставить("ТребуетсяПроверкаСредствамиККТ", Ложь);
	//- ИнфоСофт Заварин К.В. 21.03.25 УА #96791
	
	ОбщийМодуль = ОпределитьОбщийМодульШтрихкодированияВызовСервера();    
 	Возврат ОбщийМодуль.ОбработатьШтрихкод(ВходящиеДанные, ПараметрыСканирования, КэшированныеЗначения, УникальныйИдентификатор);
	
КонецФункции //- ИнфоСофт Стояк Ю.К. 13.08.2024 УА #81686

