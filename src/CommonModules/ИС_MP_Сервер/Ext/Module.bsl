//+ ИнфоСофт Власова И.С. 05.08.24 УА #81190
Функция ПолучитьВерсиюКомиссионныхПродаж(Профиль, Маркетплейс) Экспорт
	
	ПрефиксНастроек = ПолучитьПрефиксНастроек(Маркетплейс);
	
	НастройкаСоглашение = "Соглашение" + ПрефиксНастроек;
	НастройкаДоговор    = "Договор"    + ПрефиксНастроек;
	
	//+ ИнфоСофт Власова И.С. 14.03.25 УА #83865
	Если Маркетплейс = Перечисления.ИС_МП_Маркетплейсы.ВБ Тогда	
		Настройки = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Профиль, СтрШаблон("%1, %2", НастройкаСоглашение, НастройкаДоговор));	
	Иначе
	//- ИнфоСофт Власова И.С. 14.03.25 УА #83865
	
	МассивНаименованийПараметров = Новый Массив;	
	МассивНаименованийПараметров.Добавить(НастройкаСоглашение);
	МассивНаименованийПараметров.Добавить(НастройкаДоговор);
	
	Настройки = ИС_MP_Сервер.ПолучитьНастройки(Профиль, МассивНаименованийПараметров);	
	
	//+ ИнфоСофт Власова И.С. 14.03.25 УА #83865
	КонецЕсли;
	//- ИнфоСофт Власова И.С. 14.03.25 УА #83865
	
	ИспользоватьСоглашенияСКлиентами = ПолучитьФункциональнуюОпцию("ИспользоватьСоглашенияСКлиентами"); 
	
	Если ИспользоватьСоглашенияСКлиентами И Настройки[НастройкаСоглашение] <> Неопределено И ЗначениеЗаполнено(Настройки[НастройкаСоглашение]) Тогда 
		КомиссионныеПродажи25 = Настройки[НастройкаСоглашение].КомиссионныеПродажи25;		
	ИначеЕсли Настройки[НастройкаДоговор] <> Неопределено И ЗначениеЗаполнено(Настройки[НастройкаДоговор]) Тогда
		КомиссионныеПродажи25 = Настройки[НастройкаДоговор].КомиссионныеПродажи25;
	Иначе	
		КомиссионныеПродажи25 = Неопределено;
	КонецЕсли;
	
	Если КомиссионныеПродажи25 = Неопределено Тогда
		ВызватьИсключение("Проверьте настройки заполнения профиля по схеме комиссии (Договор или соглашение).");	
	КонецЕсли;	
	
	Возврат КомиссионныеПродажи25;
	
КонецФункции //- ИнфоСофт Власова И.С. 05.08.24 УА #81190

#КонецОбласти
