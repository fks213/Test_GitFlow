			ДанныеЗаполнения.Вставить("ХозяйственнаяОперацияПоУмолчанию", Перечисления.ХозяйственныеОперации.РеализацияКлиенту);
			ДанныеЗаполнения.Вставить("ТипДоговора", 					  Перечисления.ТипыДоговоров.СПокупателем);
			
