//+ ИнфоСофт Стояк Ю.К. 24.11.2023 УА #61986 
Процедура ЗаписатьОстатокFBO(Профиль, Маркетплейс, ТаблицаОстатков) Экспорт
	
	ТаблицаОстатков = ДобавитьНоменклатуруКОстаткамFBO(Профиль, ТаблицаОстатков, Маркетплейс);
	
	Для Каждого Строка Из ТаблицаОстатков Цикл
		
		НаборЗаписейОстатоков = РегистрыСведений.ИС_MP_ОстаткиFBO.СоздатьНаборЗаписей();
		НаборЗаписейОстатоков.Отбор.Период.Установить(ТекущаяДатаСеанса());			
		НоваяЗапись = НаборЗаписейОстатоков.Добавить();	
		НоваяЗапись.Номенклатура = Строка.Номенклатура;
		НоваяЗапись.Характеристика = Строка.Характеристика;
		НоваяЗапись.Маркетплейс = Маркетплейс;
		НоваяЗапись.Профиль = Профиль;
		НоваяЗапись.Склад = Строка.Склад; 
		НоваяЗапись.Остаток = Строка.Остаток;
		НоваяЗапись.Период = ТекущаяДатаСеанса(); 
		НаборЗаписейОстатоков.Записать(Ложь);
		
	КонецЦикла; 
	
	//+ ИнфоСофт Заварин К.В. 18.07.24 УА #70305
	Если Маркетплейс = Перечисления.ИС_МП_Маркетплейсы.Озон Тогда
		НаборДляОчистки = РегистрыСведений.ИС_MP_ОстаткиFBO.СоздатьНаборЗаписей();
		НаборДляОчистки.Отбор.Склад.Установить("Нет названия");
		НаборДляОчистки.Отбор.Маркетплейс.Установить(Перечисления.ИС_МП_Маркетплейсы.Озон);
		НаборДляОчистки.Записать();
	КонецЕсли;
	//- ИнфоСофт Заварин К.В. 18.07.24 УА #70305
		
КонецПроцедуры //- ИнфоСофт Стояк Ю.К. 24.11.2023 УА #61986    

//+ ИнфоСофт Стояк Ю.К. 24.11.2023 УА #61986
Функция ДобавитьНоменклатуруКОстаткамFBO(Профиль, ТаблицаЗначений, Маркетплейс) 
	
	Запрос = Новый Запрос;
			
	Если Маркетплейс = Перечисления.ИС_МП_Маркетплейсы.ВБ Тогда 
		
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	Данные.Штрихкод КАК Barcode,
		|	Данные.ИД КАК id,
		|	Данные.НаСкладе КАК stock,
		|	Данные.Склад КАК Склад
		|ПОМЕСТИТЬ Данные
		|ИЗ
		|	&Данные КАК Данные
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	СУММА(ЕСТЬNULL(Данные.stock, 0)) КАК Остаток,
		|	Данные.Склад КАК Склад,
		|	ИС_WB_СоответствиеРазмеров.Номенклатура КАК Номенклатура,
		|	ИС_WB_СоответствиеРазмеров.Характеристика КАК Характеристика
		|ИЗ
		|	РегистрСведений.ИС_WB_ШтрихкодыРазмеров КАК ИС_WB_ШтрихкодыРазмеров
		|		ЛЕВОЕ СОЕДИНЕНИЕ Данные КАК Данные
		|		ПО ИС_WB_ШтрихкодыРазмеров.Штрихкод = Данные.Barcode
		|			И (ИС_WB_ШтрихкодыРазмеров.Профиль = &Профиль)
		|			И ИС_WB_ШтрихкодыРазмеров.Размер.Владелец.Код = Данные.id
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ИС_WB_СоответствиеРазмеров КАК ИС_WB_СоответствиеРазмеров
		|		ПО ИС_WB_ШтрихкодыРазмеров.Размер = ИС_WB_СоответствиеРазмеров.РазмерWB
		|ГДЕ
		|	ИС_WB_СоответствиеРазмеров.Профиль = &Профиль
		|	И НЕ ИС_WB_СоответствиеРазмеров.Номенклатура ЕСТЬ NULL
		|	И Данные.Склад <> """"
		|
		|СГРУППИРОВАТЬ ПО
		|	Данные.Склад,
		|	ИС_WB_СоответствиеРазмеров.Номенклатура,
		|	ИС_WB_СоответствиеРазмеров.Характеристика
		|
		|УПОРЯДОЧИТЬ ПО
		|	Номенклатура";
		
	ИначеЕсли Маркетплейс = Перечисления.ИС_МП_Маркетплейсы.Озон Тогда 
		
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	Данные.nmId КАК offer_id,
		|	Данные.НаСкладе КАК stock,
		//+ ИнфоСофт Заварин К.В. 10.07.24 УА #70305
		|	Данные.Склад КАК Склад
		//- ИнфоСофт Заварин К.В. 10.07.24 УА #70305
		|ПОМЕСТИТЬ Данные
		|ИЗ
		|	&Данные КАК Данные
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	СУММА(ЕСТЬNULL(Данные.stock, 0)) КАК Остаток,
		//+ ИнфоСофт Заварин К.В. 10.07.24 УА #70305
		//|	""Нет названия"" КАК Склад,
		|	Данные.Склад КАК Склад,
		//- ИнфоСофт Заварин К.В. 10.07.24 УА #70305
		|	ИС_Ozon_СоответствиеХарактеристик.Номенклатура КАК Номенклатура,
		|	ИС_Ozon_СоответствиеХарактеристик.Характеристика КАК Характеристика
		|ИЗ
		|	Данные КАК Данные
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ИС_Ozon_СоответствиеХарактеристик КАК ИС_Ozon_СоответствиеХарактеристик
		|		ПО ИС_Ozon_СоответствиеХарактеристик.НоменклатураOzon.offer_id = Данные.offer_id
		|ГДЕ
		|	НЕ ИС_Ozon_СоответствиеХарактеристик.Номенклатура ЕСТЬ NULL
		|	И ИС_Ozon_СоответствиеХарактеристик.НоменклатураOzon.Профиль = &Профиль
		|
		|СГРУППИРОВАТЬ ПО
		|	ИС_Ozon_СоответствиеХарактеристик.Характеристика,
		|	ИС_Ozon_СоответствиеХарактеристик.Номенклатура,
		//+ ИнфоСофт Заварин К.В. 10.07.24 УА #70305
		|	Данные.Склад                            
		//- ИнфоСофт Заварин К.В. 10.07.24 УА #70305
		|
		|УПОРЯДОЧИТЬ ПО
		|	Номенклатура";
		
	ИначеЕсли Маркетплейс = Перечисления.ИС_МП_Маркетплейсы.ЯМ Тогда  
		
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	Данные.shopSku КАК shopSku,
		|	Данные.stock КАК stock,
		|	Данные.Склад КАК Склад
		|ПОМЕСТИТЬ Данные
		|ИЗ
		|	&Данные КАК Данные
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	СУММА(ЕСТЬNULL(Данные.stock, 0)) КАК Остаток,
		|	Данные.Склад КАК Склад,
		|	ИС_ЯМ_СоответствиеХарактеристик.Номенклатура КАК Номенклатура,
		|	ИС_ЯМ_СоответствиеХарактеристик.Характеристика КАК Характеристика
		|ИЗ
		|	Данные КАК Данные
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ИС_ЯМ_СоответствиеХарактеристик КАК ИС_ЯМ_СоответствиеХарактеристик
		|		ПО ИС_ЯМ_СоответствиеХарактеристик.НоменклатураЯМ.shopSku = Данные.shopSku
		|ГДЕ
		|	НЕ ИС_ЯМ_СоответствиеХарактеристик.Номенклатура ЕСТЬ NULL
		|	И ИС_ЯМ_СоответствиеХарактеристик.НоменклатураЯМ.Профиль = &Профиль
		|
		|СГРУППИРОВАТЬ ПО
		|	Данные.Склад,
		|	ИС_ЯМ_СоответствиеХарактеристик.Характеристика,
		|	ИС_ЯМ_СоответствиеХарактеристик.Номенклатура
		|
		|УПОРЯДОЧИТЬ ПО
		|	Номенклатура";
		
	КонецЕсли; 
	
	Запрос.УстановитьПараметр("Данные", ТаблицаЗначений);
	Запрос.УстановитьПараметр("Профиль", Профиль);

	Результатзапроса = Запрос.Выполнить();
	
	Возврат Результатзапроса.Выгрузить();
	
КонецФункции //- ИнфоСофт Стояк Ю.К. 24.11.2023 УА #61986

//+ ИнфоСофт Сумин Д.В. 02.05.2024 УА #67144
Функция СоздатьКонтрагента(Организация, Настройки, Данные) Экспорт 	
	
	ИспользуютсяДоговоры 	= Константы.ИспользоватьДоговорыСКлиентами.Получить();
	ИспользуютсяСоглашения 	= Константы.ИспользоватьСоглашенияСКлиентами.Получить();
	
	//+ ИнфоСофт Стояк Ю.К. 01.04.2025 УА #97211
	Если СтрДлина(Данные.Инн) = 12 Тогда
		ЮрФизЛицо = Перечисления.КомпанияЧастноеЛицо.ЧастноеЛицо;
		ЮрФизЛицоКонтрагент = Перечисления.ЮрФизЛицо.ИндивидуальныйПредприниматель;
		ЮридическоеФизическоеЛицо = Перечисления.ЮридическоеФизическоеЛицо.ФизическоеЛицо;
	Иначе
		ЮрФизЛицо = Перечисления.КомпанияЧастноеЛицо.Компания;
		ЮрФизЛицоКонтрагент = Перечисления.ЮрФизЛицо.ЮрЛицо;
		ЮридическоеФизическоеЛицо = Перечисления.ЮридическоеФизическоеЛицо.ЮридическоеЛицо;
	КонецЕсли;
	//- ИнфоСофт Стояк Ю.К. 01.04.2025 УА #97211
	
	//Создание партнера
	Партнер 					= Справочники.Партнеры.СоздатьЭлемент();
	Партнер.Клиент 				= Истина;
	Партнер.Наименование       	= Данные.НаименованиеКлиента;
	Партнер.НаименованиеПолное 	= Данные.НаименованиеКлиента; 
	//+ ИнфоСофт Стояк Ю.К. 01.04.2025 УА #97211
	//Партнер.ЮрФизЛицо 			= Перечисления.КомпанияЧастноеЛицо.Компания;
