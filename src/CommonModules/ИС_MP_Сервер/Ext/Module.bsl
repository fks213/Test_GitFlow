			Договор = Справочники.ДоговорыКонтрагентов.СоздатьЭлемент(); 
			
			ДанныеЗаполнения = Новый Структура; 
			
			ДанныеЗаполнения.Вставить("Партнер", Партнер.Ссылка);
			ДанныеЗаполнения.Вставить("Контрагент", Контрагент.Ссылка);
			ДанныеЗаполнения.Вставить("ХозяйственнаяОперацияПоУмолчанию", Перечисления.ХозяйственныеОперации.РеализацияЧерезКомиссионера);
