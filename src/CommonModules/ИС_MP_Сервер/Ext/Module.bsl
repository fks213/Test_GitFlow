// при неудаче возвращает пустую ссылку
//
// Параметры:
//  Перечисление - ПеречислениеСсылка - Объект метаданных конфигурации перечисление 
//  Значение	 - Строка - Искомое перечисление 
// 
// Возвращаемое значение:
// СсылкаНаПеречисление - Возвращает ссылку на найденное по имени значение или пустую ссылку  
//
Функция ПолучитьПеречислениеПоЗначению(Перечисление, Значение) Экспорт

	Результат = Перечисление.ПустаяСсылка();
	
	Попытка
		Результат = Перечисление[Значение];
