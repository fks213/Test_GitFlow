//+ ИнфоСофт Заварин К.В. 20.02.25 УА #73904
Процедура ЗаписатьДанныеКИЗ(Профиль, Маркетплейс, ЗаказМП = Неопределено, МассивТоваров = Неопределено) Экспорт
	
	Если МассивТоваров = Неопределено Или МассивТоваров.Количество() = 0 Или ЗаказМП = Неопределено Тогда
		Возврат;	
	КонецЕсли;
		
	Для Каждого Строка Из МассивТоваров Цикл
				
		МенеджерЗаписи = РегистрыСведений.ИС_MP_ДанныеВыгрузкиКИЗов.СоздатьМенеджерЗаписи();
		
		МенеджерЗаписи.Профиль 	   				     = Профиль;
		МенеджерЗаписи.Маркетплейс   				 = Маркетплейс;
		МенеджерЗаписи.ЗаказМП   	  				 = ЗаказМП;
		МенеджерЗаписи.Номенклатура   				 = Строка.Номенклатура;
		МенеджерЗаписи.Характеристика    			 = Строка.Характеристика;
		МенеджерЗаписи.Прочитать();
		
		МенеджерЗаписи.Профиль 	   				 	 = Профиль;
		МенеджерЗаписи.Маркетплейс   				 = Маркетплейс;
		МенеджерЗаписи.ЗаказМП   	  				 = ЗаказМП;
		МенеджерЗаписи.Номенклатура   				 = Строка.Номенклатура;
		МенеджерЗаписи.Характеристика    			 = Строка.Характеристика;
		МенеджерЗаписи.КоличествоВыгруженныхТоваров  = МенеджерЗаписи.КоличествоВыгруженныхТоваров + 1;
		
		МенеджерЗаписи.Записать(Ложь);
		
	КонецЦикла; 
		
КонецПроцедуры //- ИнфоСофт Заварин К.В. 20.02.25 УА #73904

//+ ИнфоСофт Ивонин К.А. 21.02.23 УА #53535
Функция ОрганизацияПрименяетУСН(Организация)
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	НастройкиСистемыНалогообложенияСрезПоследних.СистемаНалогообложения КАК СистемаНалогообложения
	|ИЗ
	//+ ИнфоСофт Заварин К.В. 24.12.24 УА #90141
	//|	РегистрСведений.НастройкиСистемыНалогообложения.СрезПоследних(, Организация = &Организация) КАК НастройкиСистемыНалогообложенияСрезПоследних";
	|	РегистрСведений.НастройкиСистемыНалогообложения.СрезПоследних(&Период, Организация = &Организация) КАК НастройкиСистемыНалогообложенияСрезПоследних";
	//- ИнфоСофт Заварин К.В. 24.12.24 УА #90141
	
	Запрос.УстановитьПараметр("Организация", Организация);
	//+ ИнфоСофт Заварин К.В. 24.12.24 УА #90141
	Запрос.УстановитьПараметр("Период", ТекущаяДатаСеанса());
	//- ИнфоСофт Заварин К.В. 24.12.24 УА #90141
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Выборка = РезультатЗапроса.Выбрать();
	
	Если Выборка.Следующий() Тогда
	
		Если Выборка.СистемаНалогообложения = Перечисления.СистемыНалогообложения.Упрощенная Тогда
			Возврат Истина;
		Иначе
			Возврат Ложь;
		КонецЕсли;
		
	Иначе
		Возврат Неопределено;
	КонецЕсли;	
	
КонецФункции //- ИнфоСофт Ивонин К.А. 21.02.23 УА #53535

