//+ ИнфоСофт Мурсалимов Д.Р. 04.07.24 УА #66901
Функция ПолучитьНаименованиеМаркетплейса(Маркетплейс) Экспорт
	
	Результат = "";
	
	Если Маркетплейс = Перечисления.ИС_МП_Маркетплейсы.ВБ Тогда
		Результат = "WildBerries";
	ИначеЕсли Маркетплейс = Перечисления.ИС_МП_Маркетплейсы.Озон Тогда
		Результат = "Ozon";
	ИначеЕсли Маркетплейс = Перечисления.ИС_МП_Маркетплейсы.ЯМ Тогда
		Результат = "Яндекс";	
	ИначеЕсли Маркетплейс = Перечисления.ИС_МП_Маркетплейсы.Сбер Тогда
		Результат = "Сбер";		
	ИначеЕсли Маркетплейс = Перечисления.ИС_МП_Маркетплейсы.Али Тогда
		Результат = "Aliexpress"; 
	//+ ИнфоСофт Власова И.С. 23.12.24 УА #90120
	ИначеЕсли Маркетплейс = Перечисления.ИС_МП_Маркетплейсы.Ламода Тогда
		Результат = "Ламода";
	//- ИнфоСофт Власова И.С. 23.12.24 УА #90120
	Иначе
		Результат = "WildBerries";					
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции //- ИнфоСофт Мурсалимов Д.Р. 04.07.24 УА #66901

