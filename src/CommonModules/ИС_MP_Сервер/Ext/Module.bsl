		//Создание договора
		Если ИспользуютсяДоговоры Тогда
			Договор = Справочники.ДоговорыКонтрагентов.СоздатьЭлемент();
			
			//+ ИнфоСофт Власова И.С. 14.02.25 УА #93336
			//Договор.Заполнить(Партнер.Ссылка);
			
			ДанныеЗаполнения = Новый Структура; 
			
			ДанныеЗаполнения.Вставить("Партнер", 						  Партнер.Ссылка);
