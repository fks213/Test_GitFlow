//+ ИнфоСофт Стояк Ю.К. 04.03.2023 УА #54628
Функция ПолучитьСтруктуруИзСоответствия(Структура) Экспорт
	
	СтруктураВозврат = Новый Структура;
	
	Если ТипЗнч(Структура) = Тип("Соответствие") Тогда
		
		ФлагОшибка=Ложь;
		
		Для Каждого Элемент Из Структура Цикл
			Попытка
				СтруктураВозврат.Вставить(Элемент.Ключ, ПолучитьСтруктуруИзСоответствия(Элемент.Значение));
			Исключение
				ФлагОшибка=Истина;
				Прервать;
			КонецПопытки;
		КонецЦикла;
		
		Если ФлагОшибка Тогда  
			
			СтруктураВозврат = Новый Массив;
			
			Для Каждого Элемент Из Структура Цикл 
				
				ДопСтруктура = Новый Структура;
				ДопСтруктура.Вставить("Ключ",Элемент.Ключ);
				ДопСтруктура.Вставить("Значение", ПолучитьСтруктуруИзСоответствия(Элемент.Значение));
				СтруктураВозврат.Добавить(ДопСтруктура); 
				
			КонецЦикла;
			
		КонецЕсли;
		
		Возврат СтруктураВозврат; 
		
	ИначеЕсли ТипЗнч(Структура)=Тип("Массив") Тогда
		
		НовыйМассив = Новый Массив;
		
		Для Каждого Элемент Из Структура Цикл
			НовыйМассив.Добавить(ПолучитьСтруктуруИзСоответствия(Элемент));
		КонецЦикла; 
		
		Возврат НовыйМассив;
		
	КонецЕсли;
	
	Возврат Структура;   
	
КонецФункции //- ИнфоСофт Стояк Ю.К. 04.03.2023 УА #54628 

