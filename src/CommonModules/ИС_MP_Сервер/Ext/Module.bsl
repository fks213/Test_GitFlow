	Результат.Вставить("Договор",    Договор.Ссылка);
	Результат.Вставить("Соглашение", Соглашение.Ссылка);
	
	Возврат Результат;
	
КонецФункции //- ИнфоСофт Сумин Д.В. 02.05.2024 УА #67144

