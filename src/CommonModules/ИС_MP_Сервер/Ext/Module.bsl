//+ ИнфоСофт Ивонин К.А. 20.02.23 УА #53535
Функция ПолучитьПрименениеНДСОрганизации(Организация) Экспорт
		
	ОрганизацияПрименяетУСН = ОрганизацияПрименяетУСН(Организация);
		
	Если ОрганизацияПрименяетУСН <> Неопределено И ОрганизацияПрименяетУСН Тогда
		Возврат Ложь;	
	КонецЕсли;	
		
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	НастройкиУчетаНДССрезПоследних.ПрименяетсяОсвобождениеОтУплатыНДС КАК ПрименяетсяОсвобождениеОтУплатыНДС
	|ИЗ
	|	РегистрСведений.НастройкиУчетаНДС.СрезПоследних(, Организация = &Организация) КАК НастройкиУчетаНДССрезПоследних";
	
	Запрос.УстановитьПараметр("Организация", Организация);
	
	РезультатЗапроса = Запрос.Выполнить();
	Выборка = РезультатЗапроса.Выбрать();
	
	Если Выборка.Следующий() Тогда
		Возврат Не Выборка.ПрименяетсяОсвобождениеОтУплатыНДС;
	Иначе
		Возврат Неопределено;
	КонецЕсли;
		
КонецФункции //- ИнфоСофт Ивонин К.А. 20.02.23 УА #53535

//+ ИнфоСофт Ивонин К.А. 13.08.23 УА #61542
Процедура ЗаписатьДанныеОтладки(Профиль, Маркетплейс, Метод, ПараметрыЗапроса, РезультатЗапроса) Экспорт
		
	МенеджерЗаписи = РегистрыСведений.ИС_МП_ДанныеОтладки.СоздатьМенеджерЗаписи();
	МенеджерЗаписи.Период = ТекущаяДатаСеанса();
	МенеджерЗаписи.Профиль = Профиль;
	МенеджерЗаписи.Маркетплейс = Маркетплейс;

	ПортПоУмолчанию = ?(ПараметрыЗапроса.ЗащищенноеСоединение, ":443", ":80");
	
	Запрос = ?(ПараметрыЗапроса.ЗащищенноеСоединение, "https://", "http://") 
		+ ПараметрыЗапроса.Сервер 
		+ ?(ПараметрыЗапроса.Порт = 0, ПортПоУмолчанию, ":" + ПараметрыЗапроса.Порт)
		+ ПараметрыЗапроса.АдресРесурса;

	МенеджерЗаписи.Запрос = Запрос;
	МенеджерЗаписи.Метод = Метод;
	МенеджерЗаписи.ЗаголовкиЗапроса = ИС_MP_РаботаСHTTPЗапросамиСервер.ПолучитьСтрокуJSON(ПараметрыЗапроса.Заголовки); 

	Если ПараметрыЗапроса.ИмяФайлаТела <> Неопределено 
		И ТипЗнч(ПараметрыЗапроса.ИмяФайлаТела) = Тип("Строка")  Тогда

		ТелоЗапроса = СтрШаблон("Файл: %1", ПараметрыЗапроса.ИмяФайлаТела);	

	ИначеЕсли ПараметрыЗапроса.ТелоДвоичныеДанные <> Неопределено 
		И ТипЗнч(ПараметрыЗапроса.ТелоДвоичныеДанные) = Тип("ДвоичныеДанные") Тогда
		
		ТелоЗапроса = "ДвоичныеДанные";
		
	ИначеЕсли ПараметрыЗапроса.ТелоСтрока <> Неопределено 
		И ТипЗнч(ПараметрыЗапроса.ТелоСтрока) = Тип("Строка") Тогда
		
		ТелоЗапроса = ПараметрыЗапроса.ТелоСтрока;
	
	Иначе
		ТелоЗапроса = "Тело запроса отсутствует";
	КонецЕсли;  
		
	МенеджерЗаписи.ТелоЗапроса = ТелоЗапроса;
	МенеджерЗаписи.КодОтвета = РезультатЗапроса.КодОтвета;
		
	Если РезультатЗапроса.ЕстьОшибки Тогда	 
		МенеджерЗаписи.ТелоОтвета = ПодробноеПредставлениеОшибки(РезультатЗапроса.ИнформацияОбОшибке);
	Иначе    
	
		МенеджерЗаписи.ЗаголовкиОтвета = ИС_MP_РаботаСHTTPЗапросамиСервер.ПолучитьСтрокуJSON(РезультатЗапроса.Заголовки); 
		МенеджерЗаписи.ТелоОтвета = РезультатЗапроса.Ответ;
	
	КонецЕсли;	

	МенеджерЗаписи.Записать();	

КонецПроцедуры //- ИнфоСофт Ивонин К.А. 13.08.23 УА #61542

