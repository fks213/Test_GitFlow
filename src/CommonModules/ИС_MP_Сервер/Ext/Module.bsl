//+ ИнфоСофт Ивонин К.А. 31.03.24 УА #71892
Функция ПолучитьТаблицуЗначенийИзExcel(Адрес, Параметры = Неопределено) Экспорт 
	
	Событие = ПолучитьИмяСобытия("ПолучитьТаблицуЗначенийИзExcel");
	
	ФайлВременногоХранилища = ПолучитьИзВременногоХранилища(Адрес);
	Имя = ПолучитьИмяВременногоФайла("xlsx");
	ФайлВременногоХранилища.Записать(Имя);
	
	ТабличныйДокумент = Новый ТабличныйДокумент;
	ТабличныйДокумент.Прочитать(Имя);
	
	Попытка
		УдалитьФайлы(Имя);
	Исключение
		ЗаписатьВЖРИСообщитьПользователю(Событие, "Не удалось удалить временный файл" + Имя);
	КонецПопытки;
	
	ТабличныйДокумент.Область().Разъединить();
	
	ПерваяСтрока = 1;
	ПерваяКолонка = 1;	
	ПоследняяСтрока = ТабличныйДокумент.ВысотаТаблицы;
	ПоследняяКолонка = ТабличныйДокумент.ШиринаТаблицы;
		
	Если ПоследняяСтрока = 0 Тогда	
		ОбщегоНазначения.СообщитьПользователю("Файл excel пуст");
		Возврат Неопределено;	
	КонецЕсли;
	
	Если ТипЗнч(Параметры) = Тип("Структура") Тогда
		
		Если Параметры.Свойство("ПерваяСтрока") И Параметры.ПерваяСтрока <> 0 Тогда
			ПерваяСтрока = Параметры.ПерваяСтрока;
		КонецЕсли;
		
		Если Параметры.Свойство("ПерваяКолонка") И Параметры.ПерваяКолонка <> 0 Тогда
			ПерваяКолонка = Параметры.ПерваяКолонка;
		КонецЕсли;
		
		Если Параметры.Свойство("ПоследняяСтрока") И Параметры.ПоследняяСтрока <> 0 Тогда
			ПоследняяСтрока = Параметры.ПоследняяСтрока;
		КонецЕсли;
		
		Если Параметры.Свойство("ПоследняяКолонка") И Параметры.ПоследняяКолонка <> 0 Тогда
			ПоследняяКолонка = Параметры.ПоследняяКолонка;
		КонецЕсли;
		
	КонецЕсли;
	
	ОбластьЯчеек = ТабличныйДокумент.Область(ПерваяСтрока, ПерваяКолонка, ПоследняяСтрока, ПоследняяКолонка);
	
	ИсточникДанных = Новый ОписаниеИсточникаДанных(ОбластьЯчеек);
	
	ПостроительОтчета = Новый ПостроительОтчета;
	ПостроительОтчета.ИсточникДанных = ИсточникДанных;
	ПостроительОтчета.Выполнить();
	
	Результат = ПостроительОтчета.Результат.Выгрузить();
	
	Возврат Результат;
		
КонецФункции //- ИнфоСофт Ивонин К.А. 31.03.24 УА #71892

//+ ИнфоСофт Стояк Ю.К. 02.07.2024 УА #78828
Функция СтрокаВДату(Знач Значение) Экспорт 
	
	ПустаяДата = Дата(1, 1, 1);
	
	Если Не ЗначениеЗаполнено(Значение) Тогда 
		Возврат ПустаяДата;
	КонецЕсли;
	
	ОписаниеДаты = Новый ОписаниеТипов("Дата");
	Дата = ОписаниеДаты.ПривестиЗначение(Значение);
	
	Если ТипЗнч(Дата) = Тип("Дата")
		И ЗначениеЗаполнено(Дата) Тогда 
		
		Возврат Дата;
	КонецЕсли;
	
	#Область ПодготовкаЧастейДаты
	
	КоличествоСимволов = СтрДлина(Значение);
	
	Если КоличествоСимволов > 25 Тогда 
		Возврат ПустаяДата;
	КонецЕсли;
	
	ЧастиЗначения = Новый Массив;
	ЧастьЗначения = "";
	
	Для НомерСимвола = 1 По КоличествоСимволов Цикл 
		
		Символ = Сред(Значение, НомерСимвола, 1);
		
		Если ЭтоЧисло(Символ) Тогда 
			
			ЧастьЗначения = ЧастьЗначения + Символ;
			
		Иначе
			
			Если Не ПустаяСтрока(ЧастьЗначения) Тогда 
				ЧастиЗначения.Добавить(ЧастьЗначения);
			КонецЕсли;
			
			ЧастьЗначения = "";
			
		КонецЕсли;
		
		Если НомерСимвола = КоличествоСимволов
			И Не ПустаяСтрока(ЧастьЗначения) Тогда 
			
			ЧастиЗначения.Добавить(ЧастьЗначения);
		КонецЕсли;
		
	КонецЦикла;
	
	Если ЧастиЗначения.Количество() < 3 Тогда 
		Возврат ПустаяДата;
	КонецЕсли;
	
	Если ЧастиЗначения.Количество() < 4 Тогда 
		ЧастиЗначения.Добавить("00");
	КонецЕсли;
	
	Если ЧастиЗначения.Количество() < 5 Тогда 
		ЧастиЗначения.Добавить("00");
	КонецЕсли;
	
	Если ЧастиЗначения.Количество() < 6 Тогда 
		ЧастиЗначения.Добавить("00");
	КонецЕсли;
	
	#КонецОбласти
	
	// Если формат ггггММддЧЧммсс:
	НормализованноеЗначение = ЧастиЗначения[2] + ЧастиЗначения[1] + ЧастиЗначения[0]
		+ ЧастиЗначения[3] + ЧастиЗначения[4] + ЧастиЗначения[5];
	
	Дата = ОписаниеДаты.ПривестиЗначение(НормализованноеЗначение);
	
	Если ТипЗнч(Дата) = Тип("Дата")
		И ЗначениеЗаполнено(Дата) Тогда 
		
		Возврат Дата;
	КонецЕсли;
	
	// Если формат ггггддММЧЧммсс
	НормализованноеЗначение = ЧастиЗначения[2] + ЧастиЗначения[0] + ЧастиЗначения[1]
		+ ЧастиЗначения[3] + ЧастиЗначения[4] + ЧастиЗначения[5];
	
	Дата = ОписаниеДаты.ПривестиЗначение(НормализованноеЗначение);
	
	Если ТипЗнч(Дата) = Тип("Дата")
		И ЗначениеЗаполнено(Дата) Тогда 
		
		Возврат Дата;
	КонецЕсли;
	
	Возврат ПустаяДата;
	
КонецФункции //- ИнфоСофт Стояк Ю.К. 02.07.2024 УА #78828

//+ ИнфоСофт Стояк Ю.К. 02.07.2024 УА #78828
