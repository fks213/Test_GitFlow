Функция ПолучитьЗначенияСтатусовЗаказа() Экспорт 
	
	РасширенныеВозможностиЗаказа = Константы.ИспользоватьРасширенныеВозможностиЗаказаКлиента.Получить();
	ИспользоватьПострочнуюОтгрузку = Константы.ИспользоватьПострочнуюОтгрузкуВЗаказеКлиента.Получить(); 
	
	Статусы = Новый Структура;
	
	Если РасширенныеВозможностиЗаказа И ИспользоватьПострочнуюОтгрузку Тогда
	               
		Статусы.Вставить("СтатусЗаказа", Перечисления.СтатусыЗаказовКлиентов.КОбеспечению);	
		Статусы.Вставить("СтатусСтроки", Перечисления.ВариантыОбеспечения.Отгрузить);
		
	ИначеЕсли РасширенныеВозможностиЗаказа И Не ИспользоватьПострочнуюОтгрузку Тогда
	
		Статусы.Вставить("СтатусЗаказа", Перечисления.СтатусыЗаказовКлиентов.КОтгрузке);	
		Статусы.Вставить("СтатусСтроки", Перечисления.ВариантыОбеспечения.Отгрузить);
		
	Иначе             
	
		Статусы.Вставить("СтатусЗаказа", Перечисления.СтатусыЗаказовКлиентов.НеСогласован);	
		Статусы.Вставить("СтатусСтроки", Перечисления.ВариантыОбеспечения.НеТребуется)
		
	КонецЕсли;
	
	Возврат Статусы;
	
