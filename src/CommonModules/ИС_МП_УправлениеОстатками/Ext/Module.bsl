		Возврат;
	КонецЕсли;

	Если Маркетплейс = Перечисления.ИС_МП_Маркетплейсы.Сбер Тогда
		ИС_Сбер_Сервер.УстановитьПараметрыЗапросаОстатков(Запрос, Профиль, Склад);
		Возврат;
	КонецЕсли;

	Если Маркетплейс = Перечисления.ИС_МП_Маркетплейсы.Али Тогда
		ИС_АЛИ_Сервер.УстановитьПараметрыЗапросаОстатков(Запрос, Профиль, Склад);
		Возврат;
	КонецЕсли;
	
	ОбщийМодуль = ИС_МП_Сервер.ОбщийМодульМаркетплейса(Маркетплейс);
	ОбщийМодуль.УстановитьПараметрыЗапросаОстатков(Запрос, Профиль, Склад);
	
