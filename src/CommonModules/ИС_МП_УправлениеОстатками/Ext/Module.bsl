    Если Маркетплейс = Перечисления.ИС_МП_Маркетплейсы.Сбер Тогда
				
		ТаблицаЗначений.Колонки.Добавить("НоменклатураСбер"); 
		ТаблицаЗначений.Колонки.Добавить("offerID");
		ТаблицаЗначений.Колонки.Добавить("Остаток", ОбщегоНазначения.ОписаниеТипаЧисло(10, 0, ДопустимыйЗнак.Неотрицательный));
				
