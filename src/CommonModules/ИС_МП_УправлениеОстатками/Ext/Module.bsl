//+ ИнфоСофт Ивонин К.А. 01.04.24 УА #71892
Функция ПолучитьПоляДляВыгрузки(Маркетплейс) Экспорт
	
	Результат = Новый Массив;
	
	Если Маркетплейс = Перечисления.ИС_МП_Маркетплейсы.ВБ Тогда	
		Результат.Добавить("РазмерWB");
		Результат.Добавить("Штрихкод");	
		Возврат Результат;
	КонецЕсли;
	
	Если Маркетплейс = Перечисления.ИС_МП_Маркетплейсы.Озон Тогда
		Результат.Добавить("НоменклатураOzon");
		Результат.Добавить("OfferId");
		Результат.Добавить("ProductId");
		Возврат Результат;	
	КонецЕсли;

	Если Маркетплейс = Перечисления.ИС_МП_Маркетплейсы.ЯМ Тогда
		Результат.Добавить("НоменклатураЯМ");
		Результат.Добавить("shopSku");
		Возврат Результат;
	КонецЕсли;
    
    Если Маркетплейс = Перечисления.ИС_МП_Маркетплейсы.Сбер Тогда
		Результат.Добавить("НоменклатураСбер");
		Результат.Добавить("offerID");
		Возврат Результат;	
	КонецЕсли;

	Если Маркетплейс = Перечисления.ИС_МП_Маркетплейсы.Али Тогда
		Результат.Добавить("ВариацияAli");
		Результат.Добавить("product_id");
		Результат.Добавить("КодВариации");
		Возврат Результат;	
	КонецЕсли;
	
	Если Маркетплейс = Перечисления.ИС_МП_Маркетплейсы.МВМ Тогда
		Результат.Добавить("ТоварМВМ");
		Результат.Добавить("SapМВМ");
		Возврат Результат;	
	КонецЕсли;
	
	//+ ИнфоСофт Власова И.С. 23.12.24 УА #90120
	Если Маркетплейс = Перечисления.ИС_МП_Маркетплейсы.Ламода Тогда
		Результат.Добавить("РазмерЛамода");
		Результат.Добавить("SellerSKU");
		Возврат Результат;	
	КонецЕсли;
	//- ИнфоСофт Власова И.С. 23.12.24 УА #90120
	
	Возврат Результат;
	
КонецФункции //- ИнфоСофт Ивонин К.А. 01.04.24 УА #71892

//+ ИнфоСофт Ивонин К.А. 02.04.24 УА #71892
