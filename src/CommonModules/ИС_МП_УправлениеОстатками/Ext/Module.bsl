Функция ПолучитьСкладПоУмолчанию(Маркетплейс, Профиль) Экспорт

	Если Маркетплейс = Перечисления.ИС_МП_Маркетплейсы.ВБ Тогда
		Возврат ИС_WB_Сервер.ПолучитьСкладПоУмолчанию(Профиль);
	КонецЕсли;
	
	Если Маркетплейс = Перечисления.ИС_МП_Маркетплейсы.Озон Тогда
		Возврат ИС_Ozon_Сервер.ПолучитьСкладПоУмолчанию(Профиль);
	КонецЕсли;

	Если Маркетплейс = Перечисления.ИС_МП_Маркетплейсы.ЯМ Тогда
		Возврат ИС_ЯМ_Сервер.ПолучитьСкладПоУмолчанию(Профиль);
	КонецЕсли;

	Если Маркетплейс = Перечисления.ИС_МП_Маркетплейсы.Сбер Тогда
		Возврат ИС_Сбер_Сервер.ПолучитьСкладПоУмолчанию(Профиль);
	КонецЕсли;

	Если Маркетплейс = Перечисления.ИС_МП_Маркетплейсы.Али Тогда
		Возврат ИС_АЛИ_Сервер.ПолучитьСкладПоУмолчанию(Профиль);
	КонецЕсли;
	
	//+ ИнфоСофт Власова И.С. 23.12.24 УА #90120
	Если Маркетплейс = Перечисления.ИС_МП_Маркетплейсы.Ламода Тогда
		Возврат ИС_Ламода_Сервер.ПолучитьСкладПоУмолчанию(Профиль);
	КонецЕсли;
	//- ИнфоСофт Власова И.С. 23.12.24 УА #90120
	
	Возврат Справочники.Склады.ПустаяСсылка();

