	КонецЕсли;
    
    Если Маркетплейс = Перечисления.ИС_МП_Маркетплейсы.Сбер Тогда
		Возврат ИС_Сбер_Сервер.ПолучитьИнформациюОСкладе(Склад);
	КонецЕсли;

	Если Маркетплейс = Перечисления.ИС_МП_Маркетплейсы.Али Тогда
		Возврат ИС_АЛИ_Сервер.ПолучитьИнформациюОСкладе(Склад);
	КонецЕсли;
	
	ОбщийМодуль = ИС_МП_Сервер.ОбщийМодульМаркетплейса(Маркетплейс);
	Возврат ОбщийМодуль.ИнформацияОСкладе(Склад);

КонецФункции //- ИнфоСофт Ивонин К.А. 01.04.24 УА #71892

