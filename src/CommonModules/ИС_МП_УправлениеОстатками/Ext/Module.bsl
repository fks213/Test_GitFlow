//+ ИнфоСофт Ивонин К.А. 04.03.25 УА #92887
Функция МассивПараметровВыгрузкиОстатков() Экспорт
	
	Результат = Новый Массив;
	
	Результат.Добавить("ИспользоватьПоследниеОстатки");
	Результат.Добавить("ИспользоватьФиксированныйОстаток");
	Результат.Добавить("ФиксированныйОстаток");
	Результат.Добавить("РежимСокрытияОстатков");
	Результат.Добавить("СкрываемыйОстаток");
	
	Возврат Результат;
	
КонецФункции //- ИнфоСофт Ивонин К.А. 04.03.25 УА #92887

//+ ИнфоСофт Ивонин К.А. 04.03.25 УА #92887
Функция СформироватьТаблицуВыгрузки(Профиль, Склад, ПеречислениеМП, Настройки) Экспорт
	
	ОбщийМодуль = ИС_МП_Сервер.ОбщийМодульМаркетплейса(ПеречислениеМП);
	
	Запрос = Новый Запрос;
	Запрос.Текст = ПолучитьТекстЗапросаОстатков(ПеречислениеМП);
	ОбщийМодуль.УстановитьПараметрыЗапросаОстатков(Запрос, Профиль, Склад);                                                       
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Если РезультатЗапроса.Пустой() Тогда
		Возврат Новый ТаблицаЗначений;
	КонецЕсли;
	
	Выборка = РезультатЗапроса.Выбрать();
	
	ТаблицаВыгрузки = Новый ТаблицаЗначений;	
	
	ЗаполнитьКолонкиТаблицыВыгрузкиОстатков(ПеречислениеМП, ТаблицаВыгрузки);
	
	МассивПолей = ПолучитьПоляДляВыгрузки(ПеречислениеМП);
		    
    РежимСокрытияОстатков = Ложь;
    ИспользоватьФиксированныйОстаток = Ложь;
    ФиксированныйОстаток = 0;
	
	Если Настройки.РежимСокрытияОстатков <> Неопределено Тогда
		РежимСокрытияОстатков = Настройки.РежимСокрытияОстатков;
	КонецЕсли;

 	Если Настройки.ИспользоватьФиксированныйОстаток <> Неопределено Тогда
		ИспользоватьФиксированныйОстаток = Настройки.ИспользоватьФиксированныйОстаток;
	КонецЕсли;

	Если Настройки.ФиксированныйОстаток <> Неопределено Тогда
		ФиксированныйОстаток = Настройки.ФиксированныйОстаток;
	КонецЕсли;

	Пока Выборка.Следующий() Цикл
	
		Если Не Выборка.ЕстьСопоставление И Не Выборка.ЕстьРучнойОстаток Тогда
			Продолжить;
		КонецЕсли;
		
		НоваяСтрока = ТаблицаВыгрузки.Добавить();
		
		Прерывать = Ложь;
		
		Для Каждого Элемент Из МассивПолей Цикл
			
			Если Не ЗначениеЗаполнено(Выборка[Элемент]) Тогда
				Прерывать = Истина;
				Прервать;
			КонецЕсли;
			
			НоваяСтрока[Элемент] = Выборка[Элемент];
				
		КонецЦикла;
		
		Если Прерывать Тогда
			Продолжить;	
		КонецЕсли;
		
		Если Выборка.ЕстьРучнойОстаток Тогда
			НоваяСтрока.Остаток = Выборка.РучнойОстаток;
		Иначе
		
			СкрываемыйОстаток = 0;
				
			Если РежимСокрытияОстатков Тогда
				СкрываемыйОстаток = Выборка.Свободно * Выборка.СкрываемыйОстаток / 100;
			Иначе
				СкрываемыйОстаток = Выборка.СкрываемыйОстаток;
			КонецЕсли;
						
			Если Выборка.Свободно > СкрываемыйОстаток Тогда
				НоваяСтрока.Остаток = Выборка.Свободно - СкрываемыйОстаток;  
			Иначе
				НоваяСтрока.Остаток = 0;
			КонецЕсли;
			 										
			Если ИспользоватьФиксированныйОстаток Тогда
	
				Если НоваяСтрока.Остаток > ФиксированныйОстаток Тогда
					НоваяСтрока.Остаток = ФиксированныйОстаток;	
				КонецЕсли; 
				
			КонецЕсли;

		КонецЕсли;
		
		Если Цел(НоваяСтрока.Остаток) <> НоваяСтрока.Остаток Тогда
			НоваяСтрока.Остаток = Окр(НоваяСтрока.Остаток, 0, РежимОкругления.Окр15как10); 
		КонецЕсли;
		
		//Если Не Выборка.ЕстьРучнойОстаток И Выборка.ЕстьПоследнийВыгруженныйОстаток И НоваяСтрока.Остаток = Выборка.ПоследнийВыгруженныйОстаток Тогда
		//	ТаблицаВыгрузки.Удалить(НоваяСтрока);
		//	Продолжить;	
		//КонецЕсли;
	
	КонецЦикла;
	
	Возврат ТаблицаВыгрузки;
	
КонецФункции //- ИнфоСофт Ивонин К.А. 04.03.25 УА #92887

