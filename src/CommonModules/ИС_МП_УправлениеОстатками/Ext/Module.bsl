//+ ИнфоСофт Ивонин К.А. 14.03.24 УА #71892
Функция ПолучитьТекстЗапросаОстатков(Маркетплейс) Экспорт
	
	Если Маркетплейс = Перечисления.ИС_МП_Маркетплейсы.Озон Тогда
		Возврат ИС_Ozon_Сервер.ПолучитьТекстЗапросаОстатков();
	КонецЕсли;

	Если Маркетплейс = Перечисления.ИС_МП_Маркетплейсы.ЯМ Тогда
		Возврат ИС_ЯМ_Сервер.ПолучитьТекстЗапросаОстатков();
	КонецЕсли;

	Если Маркетплейс = Перечисления.ИС_МП_Маркетплейсы.Сбер Тогда
		Возврат ИС_Сбер_Сервер.ПолучитьТекстЗапросаОстатков();
	КонецЕсли;

	Если Маркетплейс = Перечисления.ИС_МП_Маркетплейсы.Али Тогда
		Возврат ИС_АЛИ_Сервер.ПолучитьТекстЗапросаОстатков();
	КонецЕсли;
	
	ОбщийМодуль = ИС_МП_Сервер.ОбщийМодульМаркетплейса(Маркетплейс);
	Возврат ОбщийМодуль.ТекстЗапросаОстатков();
	
КонецФункции //- ИнфоСофт Ивонин К.А. 14.03.24 УА #71892

