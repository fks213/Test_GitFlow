#Область ВнешниеИсточникиОстатков

//+ ИнфоСофт Ивонин К.А. 22.07.24 УА #77582
Процедура ЗагрузитьДанныеИзВнешнегоИсточника(Источник) Экспорт
    
    Событие = ИмяСобытия("ЗагрузитьОстаткиИзВнешнегоИсточника"); 
    	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ИС_МП_ВнешниеИсточникиОстатков.Склад КАК Склад,
	|	ИС_МП_ВнешниеИсточникиОстатков.ФорматДанных КАК ФорматДанных,
	|	ИС_МП_ВнешниеИсточникиОстатков.АдресСервиса КАК АдресСервиса,
	|	ИС_МП_ВнешниеИсточникиОстатков.ПолеСопоставления КАК ПолеСопоставления,
	|	ИС_МП_ВнешниеИсточникиОстатков.ПолеОстатка КАК ПолеОстатка,
	|	ИС_МП_ВнешниеИсточникиОстатков.ПолеЦены КАК ПолеЦены,
	|	ИС_МП_ВнешниеИсточникиОстатков.СоставЗагружаемыхДанных КАК СоставЗагружаемыхДанных,
	|	ИС_МП_ВнешниеИсточникиОстатков.ВидЦены КАК ВидЦены,
	|	ИС_МП_ВнешниеИсточникиОстатков.ПерваяСтрока КАК ПерваяСтрока,
	|	ИС_МП_ВнешниеИсточникиОстатков.ПерваяКолонка КАК ПерваяКолонка,
	|	ИС_МП_ВнешниеИсточникиОстатков.ПоследняяСтрока КАК ПоследняяСтрока,
	|	ИС_МП_ВнешниеИсточникиОстатков.ПоследняяКолонка КАК ПоследняяКолонка,
	|	ИС_МП_ВнешниеИсточникиОстатков.СопоставлятьПо КАК СопоставлятьПо
	|ИЗ
	|	Справочник.ИС_МП_ВнешниеИсточникиОстатков КАК ИС_МП_ВнешниеИсточникиОстатков
	|ГДЕ
	|	ИС_МП_ВнешниеИсточникиОстатков.Ссылка = &Ссылка";
	
	Запрос.УстановитьПараметр("Ссылка", Источник);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаИсточник = РезультатЗапроса.Выбрать();
	
	Если РезультатЗапроса.Пустой() Тогда
		ТекстОшибки = "Не найден источник информации об остатках";
		ИС_MP_Сервер.ЗаписатьВЖРИСообщитьПользователю(Событие, ТекстОшибки);
		Возврат;
	КонецЕсли;
	
	ВыборкаИсточник.Следующий();
	
	Если Не ЗначениеЗаполнено(ВыборкаИсточник.ПолеСопоставления) Тогда
		ТекстОшибки = "Не заполнено поле сопоставления";
		ИС_MP_Сервер.ЗаписатьВЖРИСообщитьПользователю(Событие, ТекстОшибки);
		Возврат;
	КонецЕсли;

	ЗагружатьОстатки = Истина;	
	ЗагружатьЦены = Истина;
	ТекстОшибки = "";
	
	Если ВыборкаИсточник.СоставЗагружаемыхДанных = 0 Или ВыборкаИсточник.СоставЗагружаемыхДанных = 2 Тогда
		
		Если Не ЗначениеЗаполнено(ВыборкаИсточник.Склад) Тогда
			ЗагружатьОстатки = Ложь;
			ТекстОшибки = "Не заполнен ""Склад""" + Символы.ПС;
		КонецЕсли;
		
		Если Не ЗначениеЗаполнено(ВыборкаИсточник.ПолеОстатка) Тогда
			ЗагружатьОстатки = Ложь;
			ТекстОшибки = ТекстОшибки + "Не заполнено ""Поле остатка""" + Символы.ПС ;
		КонецЕсли;
	
	КонецЕсли;
	
	Если ВыборкаИсточник.СоставЗагружаемыхДанных = 1 Или ВыборкаИсточник.СоставЗагружаемыхДанных = 2 Тогда
		
		Если Не ЗначениеЗаполнено(ВыборкаИсточник.ВидЦены) Тогда
			ЗагружатьЦены = Ложь;
			ТекстОшибки = ТекстОшибки + "Не заполнен ""Вид цены""" + Символы.ПС;
		КонецЕсли;
		
		Если Не ЗначениеЗаполнено(ВыборкаИсточник.ПолеЦены) Тогда
			ЗагружатьЦены = Ложь;
			ТекстОшибки = ТекстОшибки + "Не заполнено ""Поле цены""" + Символы.ПС;
		КонецЕсли;
	
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ТекстОшибки) Тогда
		ИС_MP_Сервер.ЗаписатьВЖРИСообщитьПользователю(Событие, ТекстОшибки);
	КонецЕсли;
	
	Если Не ЗагружатьОстатки И Не ЗагружатьЦены Тогда
		Возврат;
	КонецЕсли; 
    
    ПараметрыЗапроса = ИС_MP_РаботаСHTTPЗапросамиСервер.ПолучитьСтруктуруHTTPЗапроса();
    ЗаполнитьЗначенияСвойств(ПараметрыЗапроса,
    	ИС_MP_РаботаСHTTPЗапросамиСервер.РазобратьURLНаПараметрыЗапроса(ВыборкаИсточник.АдресСервиса));
    
	ПараметрыЗапроса.Вставить("ФорматОтвета", "ДвоичныеДанные");
	
	РезультатЗапроса = ИС_MP_РаботаСHTTPЗапросамиСервер.ОтправитьGETЗапрос(ПараметрыЗапроса);
		
	Если РезультатЗапроса.ЕстьОшибки Тогда
		Текст = СтрШаблон("Произошла ошибка при отправке запроса: %1",	РезультатЗапроса.ИнформацияОбОшибке.Описание);
		ОбщегоНазначения.СообщитьПользователю(Текст); 	
	Иначе
	
		Если РезультатЗапроса.КодОтвета = 200 Тогда
            
            Адрес = ПоместитьВоВременноеХранилище(РезультатЗапроса.Ответ);   
			
		ИначеЕсли РезультатЗапроса.КодОтвета = 400 Тогда
             
            Текст = СтрШаблон("Неверная форма запроса: %1", РезультатЗапроса.Ответ); 
      		ОбщегоНазначения.СообщитьПользователю(Текст);
	      					
		Иначе
			Текст = СтрШаблон("Произошла неизвестная ошибка, код ответа: %1, ошибка: %2", 
				РезультатЗапроса.КодОтвета, РезультатЗапроса.Ответ);			
			ОбщегоНазначения.СообщитьПользователю(Текст);	
				
		КонецЕсли;
			
	КонецЕсли;
	
	Если Адрес = Неопределено Тогда
		Возврат;
	КонецЕсли; 
	
	ПараметрыТаблицы = Новый Структура;
	ПараметрыТаблицы.Вставить("ПерваяСтрока", ВыборкаИсточник.ПерваяСтрока);
	ПараметрыТаблицы.Вставить("ПерваяКолонка", ВыборкаИсточник.ПерваяКолонка);
	ПараметрыТаблицы.Вставить("ПоследняяСтрока", ВыборкаИсточник.ПоследняяСтрока);
	ПараметрыТаблицы.Вставить("ПоследняяКолонка", ВыборкаИсточник.ПоследняяКолонка);
    
    Результат = ИС_MP_Сервер.ПолучитьТаблицуЗначенийИзExcel(Адрес, ПараметрыТаблицы);
    
    ТаблицаОстатков = Новый ТаблицаЗначений;
    ТаблицаОстатков.Колонки.Добавить("Идентификатор", ОбщегоНазначения.ОписаниеТипаСтрока(250));
    ТаблицаОстатков.Колонки.Добавить("Остаток", ОбщегоНазначения.ОписаниеТипаСтрока(10));
    ТаблицаОстатков.Колонки.Добавить("Цена", ОбщегоНазначения.ОписаниеТипаСтрока(250));
    
    Для Каждого Строка Из Результат Цикл
    
    	Если Не ЗначениеЗаполнено(Строка[ВыборкаИсточник.ПолеСопоставления]) Тогда
    		Продолжить;
    	КонецЕсли;
    	
    	НоваяСтрока = ТаблицаОстатков.Добавить();
    	
    	НоваяСтрока.Идентификатор = Строка[ВыборкаИсточник.ПолеСопоставления];
    	НоваяСтрока.Остаток = Строка[ВыборкаИсточник.ПолеОстатка];
    	НоваяСтрока.Цена = Строка[ВыборкаИсточник.ПолеЦены];
    
    КонецЦикла;
    
    Запрос = Новый Запрос;
    
    Если ВыборкаИсточник.СопоставлятьПо = "Баркод" Тогда
	   	
	   	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ДанныеВИ.Идентификатор КАК Идентификатор,
		|	ДанныеВИ.Остаток КАК Остаток,
		|	ДанныеВИ.Цена КАК Цена
		|ПОМЕСТИТЬ ВТ_ДанныеВИ
		|ИЗ
		|	&ДанныеВИ КАК ДанныеВИ
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ВТ_ДанныеВИ.Идентификатор КАК Идентификатор,
		|	ВТ_ДанныеВИ.Остаток КАК Остаток,
		|	ВТ_ДанныеВИ.Цена КАК Цена,
		|	ШтрихкодыНоменклатуры.Номенклатура КАК Номенклатура,
		|	ШтрихкодыНоменклатуры.Характеристика КАК Характеристика,
		|	ШтрихкодыНоменклатуры.Упаковка КАК Упаковка,
		|	ВЫБОР
		|		КОГДА ШтрихкодыНоменклатуры.Характеристика ЕСТЬ NULL
		|			ТОГДА ЗНАЧЕНИЕ(Справочник.ХарактеристикиНоменклатурыДляЦенообразования.ПустаяСсылка)
		|		ИНАЧЕ ШтрихкодыНоменклатуры.Характеристика.ХарактеристикаНоменклатурыДляЦенообразования
		|	КОНЕЦ КАК ХарактеристикаЦО
		|ИЗ
		|	ВТ_ДанныеВИ КАК ВТ_ДанныеВИ
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.ШтрихкодыНоменклатуры КАК ШтрихкодыНоменклатуры
		|		ПО ВТ_ДанныеВИ.Идентификатор = ШтрихкодыНоменклатуры.Штрихкод";
		
	ИначеЕсли ВыборкаИсточник.СопоставлятьПо = "Артикул" Тогда
		
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	ДанныеВИ.Идентификатор КАК Идентификатор,
		|	ДанныеВИ.Остаток КАК Остаток,
		|	ДанныеВИ.Цена КАК Цена
		|ПОМЕСТИТЬ ВТ_ДанныеВИ
		|ИЗ
		|	&ДанныеВИ КАК ДанныеВИ
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ВТ_ДанныеВИ.Идентификатор КАК Идентификатор,
		|	ВТ_ДанныеВИ.Остаток КАК Остаток,
		|	ВТ_ДанныеВИ.Цена КАК Цена,
		|	Номенклатура.Ссылка КАК Номенклатура,
		|	ЗНАЧЕНИЕ(Справочник.ХарактеристикиНоменклатуры.ПустаяСсылка) КАК Характеристика,
		|	ЗНАЧЕНИЕ(Справочник.ХарактеристикиНоменклатурыДляЦенообразования.ПустаяСсылка) КАК ХарактеристикаЦО,
		|	Номенклатура.ЕдиницаИзмерения КАК Упаковка
		|ИЗ
		|	ВТ_ДанныеВИ КАК ВТ_ДанныеВИ
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Номенклатура КАК Номенклатура
		|		ПО ВТ_ДанныеВИ.Идентификатор = Номенклатура.Артикул";
	
	Иначе

		Запрос.Текст = 
		"ВЫБРАТЬ
		|	ДанныеВИ.Идентификатор КАК Идентификатор,
		|	ДанныеВИ.Остаток КАК Остаток,
		|	ДанныеВИ.Цена КАК Цена
		|ПОМЕСТИТЬ ВТ_ДанныеВИ
		|ИЗ
		|	&ДанныеВИ КАК ДанныеВИ
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ВТ_ДанныеВИ.Идентификатор КАК Идентификатор,
		|	ВТ_ДанныеВИ.Остаток КАК Остаток,
		|	ВТ_ДанныеВИ.Цена КАК Цена,
		|	Номенклатура.Ссылка КАК Номенклатура,
		|	ЗНАЧЕНИЕ(Справочник.ХарактеристикиНоменклатуры.ПустаяСсылка) КАК Характеристика,
		|	ЗНАЧЕНИЕ(Справочник.ХарактеристикиНоменклатурыДляЦенообразования.ПустаяСсылка) КАК ХарактеристикаЦО,
		|	Номенклатура.ЕдиницаИзмерения КАК Упаковка
		|ИЗ
		|	ВТ_ДанныеВИ КАК ВТ_ДанныеВИ
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Номенклатура КАК Номенклатура
		|		ПО ВТ_ДанныеВИ.Идентификатор = Номенклатура.Наименование";
	
	КонецЕсли;
	
	Запрос.УстановитьПараметр("ДанныеВИ", ТаблицаОстатков);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Выборка = РезультатЗапроса.Выбрать();
	
	Если ЗагружатьОстатки Тогда
	
		Пока Выборка.Следующий() Цикл
			
			Если ЗначениеЗаполнено(Выборка.Номенклатура) Тогда
			
				НоваяЗапись = РегистрыСведений.ИС_МП_ВнешниеОстатки.СоздатьМенеджерЗаписи();
				
				НоваяЗапись.Склад = ВыборкаИсточник.Склад;
				НоваяЗапись.Номенклатура = Выборка.Номенклатура;
				НоваяЗапись.Источник = Источник;
				НоваяЗапись.Характеристика = Выборка.Характеристика;
				НоваяЗапись.Остаток = ИС_МП_КлиентСервер.ПреобразоватьКЧислу(Выборка.Остаток);
			    НоваяЗапись.Записать(Истина);
			    
			КонецЕсли;
				
		КонецЦикла;
		
	КонецЕсли;
	
	Если ЗагружатьЦены Тогда
	
		УстановкаЦен = Документы.УстановкаЦенНоменклатуры.СоздатьДокумент();
		УстановкаЦен.Дата = ТекущаяДатаСеанса();
		УстановкаЦен.Комментарий = "Создан на основании загрузки данных из внешних источников:" + Источник;
		УстановкаЦен.Согласован = Истина;
		УстановкаЦен.Статус = Перечисления.СтатусыУстановокЦенНоменклатуры.Согласован;
		
		Выборка.Сбросить();
		
		ВалютаУчета = Константы.ВалютаУправленческогоУчета.Получить();
		
		НоваяСтрока = УстановкаЦен.ВидыЦен.Добавить();
		НоваяСтрока.ВидЦены = ВыборкаИсточник.ВидЦены; 
		
		Если Константы.ИспользуетсяЦенообразование25.Получить() Тогда
		
			Пока Выборка.Следующий() Цикл
				
				Если ЗначениеЗаполнено(Выборка.Номенклатура) Тогда
				
					НоваяСтрока = УстановкаЦен.Товары2_5.Добавить();
					
					НоваяСтрока.Номенклатура = Выборка.Номенклатура;
					НоваяСтрока.ХарактеристикаЦО = Выборка.ХарактеристикаЦО;
					//НоваяСтрока.СерияЦО = Выборка.СерияЦО;
					//НоваяСтрока.УпаковкаЦО = Выборка.УпаковкаЦО;
					НоваяСтрока.Упаковка = Выборка.Упаковка;
					НоваяСтрока.ВидЦены = ВыборкаИсточник.ВидЦены;
					НоваяСтрока.Цена = ИС_МП_КлиентСервер.ПреобразоватьКЧислу(Выборка.Цена); 
					НоваяСтрока.ЦенаИзмененаВручную = Истина; 
					НоваяСтрока.Валюта = ВалютаУчета;
						    
				КонецЕсли;
					
			КонецЦикла;
		
		Иначе
		 
			Пока Выборка.Следующий() Цикл
				
				Если ЗначениеЗаполнено(Выборка.Номенклатура) Тогда
				
					НоваяСтрока = УстановкаЦен.Товары.Добавить();
					
					НоваяСтрока.Номенклатура = Выборка.Номенклатура;
					НоваяСтрока.Характеристика = Выборка.Характеристика;
					НоваяСтрока.Упаковка = Выборка.Упаковка;
					НоваяСтрока.ВидЦены = ВыборкаИсточник.ВидЦены;
					НоваяСтрока.Цена = ИС_МП_КлиентСервер.ПреобразоватьКЧислу(Выборка.Цена); 
					НоваяСтрока.ЦенаИзмененаВручную = Истина; 
					НоваяСтрока.Валюта = ВалютаУчета;
						    
				КонецЕсли;
					
			КонецЦикла;
		
		КонецЕсли;
		
		Попытка
			УстановкаЦен.Записать(РежимЗаписиДокумента.Проведение);
		Исключение
			ТекстОшибки = ИС_MP_Сервер.ПредставлениеОшибки(ИнформацияОбОшибке());
			ИС_MP_Сервер.ЗаписатьВЖРИСообщитьПользователю(Событие, ТекстОшибки);	
		КонецПопытки;
	
	КонецЕсли;
    
КонецПроцедуры //- ИнфоСофт Ивонин К.А. 22.07.24 УА #77582	

#КонецОбласти

#Область Остатки
	
//+ ИнфоСофт Мурсалимов Д.Р. 01.03.24 УА #67173
// На вход требуется временная таблица "ВТ_Сопоставление", которая сожержит 4 обязательных поля:
// 		ПолеСопоставление - поле которое будет использовано для соединения в финальном пакете
//		Номенклатура - Номенклатура для получения остатков
//		Характеристика - Характеристика для получения остатков
// 		КоэффициентУпаковки - Коэффициент вычисленный из значений числитель / знаминатель упаковки
//
// Также имеются следующие обязательные параметры дял установки:
//		КоличествоСкрываемогоОстатка - Количество скрываемого остатка из настроек профиля
//		РассчитыватьНесобранныеКомплекты - Признак необходимости рассчета несобранных комплектов из настроек профиля
//		Склад1С - Определяет склад, список складов или Группу складов. В случае использования группы складов
//		необходимо сделать замену %1 в тексте на "ИЕРАРХИИ", в остальных случаях на ""
//
// Возвращаемое значение:
//  Строка - Текст запроса остатков
//
Функция ТекстЗапросаОстатков() Экспорт
	
	Версия = ИС_МП_Сервер.ВерсияБезРедакции();
	ИмяКонфигурации = ИС_МП_Сервер.ИмяКонфигурации();
	
	Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	КлючиАналитикиУчетаНоменклатуры.Номенклатура КАК Номенклатура,
	|	КлючиАналитикиУчетаНоменклатуры.Характеристика КАК Характеристика,
	|	ТоварыОрганизацийОстатки.КоличествоОстаток КАК КоличествоОстаток,
	|	0 КАК ВРезервеОстаток,
	|	0 КАК КОтгрузкеОстаток
	|ПОМЕСТИТЬ ВТ_СвободныеОстаткиОрганизации
	|ИЗ
	|	РегистрНакопления.ТоварыОрганизаций.Остатки(, Организация = &Организация) КАК ТоварыОрганизацийОстатки
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.КлючиАналитикиУчетаНоменклатуры КАК КлючиАналитикиУчетаНоменклатуры
	|		ПО ТоварыОрганизацийОстатки.АналитикаУчетаНоменклатуры = КлючиАналитикиУчетаНоменклатуры.Ссылка
	|ГДЕ
	|	&ВыгружатьОстаткиВРазрезеОрганизации
	|	И КлючиАналитикиУчетаНоменклатуры.СкладскаяТерритория В ИЕРАРХИИ(&Склад1С)
	//+ ИнфоСофт Власова И.С. 14.03.25 УА #95727
	|	И КлючиАналитикиУчетаНоменклатуры.Назначение В(&Назначение)
	//- ИнфоСофт Власова И.С. 14.03.25 УА #95727
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ТоварыКОтгрузкеОстатки.Номенклатура,
	|	ТоварыКОтгрузкеОстатки.Характеристика,
	|	0,
	|	ТоварыКОтгрузкеОстатки.ВРезервеОстаток,
	|	ТоварыКОтгрузкеОстатки.КОтгрузкеОстаток
	|ИЗ
	|	РегистрНакопления.ТоварыКОтгрузке.Остатки(
	|			,
	|			Склад В ИЕРАРХИИ (&Склад1С)
	//+ ИнфоСофт Власова И.С. 14.03.25 УА #95727
	//|				И ДокументОтгрузки.Организация = &Организация) КАК ТоварыКОтгрузкеОстатки
	|				И ДокументОтгрузки.Организация = &Организация
	|				И Назначение В(&Назначение)) КАК ТоварыКОтгрузкеОстатки
