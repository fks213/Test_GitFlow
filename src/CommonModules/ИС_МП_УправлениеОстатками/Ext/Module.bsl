		ТаблицаЗначений.Колонки.Добавить("КодВариации", ОбщегоНазначения.ОписаниеТипаСтрока(30));
		ТаблицаЗначений.Колонки.Добавить("Остаток", ОбщегоНазначения.ОписаниеТипаЧисло(10, 0, ДопустимыйЗнак.Неотрицательный));
		
	КонецЕсли;
	
	Если Маркетплейс = Перечисления.ИС_МП_Маркетплейсы.МВМ Тогда
	
