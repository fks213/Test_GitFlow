																										| " + ?(
			СодержитСтроку, "Выразить(вт_ЗначенияРеквизитов1С." + Реквизит.Имя + " КАК Строка(1024))",
			"вт_ЗначенияРеквизитов1С." + Реквизит.Имя) + " КАК Значение,
														 |	""" + СинонимРеквизита + """ КАК ИмяРеквизита1С,"
			+ Символы.ПС + "
						   | " + ?(СодержитСтроку, "вт_ЗначенияРеквизитов1С." + Реквизит.Имя, """""") + " КАК ТекстоваяСтрока 
																										| " + ?(
			ПервыйЗапрос, "ПОМЕСТИТЬ вт_таб2" + Символы.ПС, "") + "ИЗ
																  |	вт_ЗначенияРеквизитов1С КАК вт_ЗначенияРеквизитов1С"
			+ Символы.ПС + Символы.ПС;
		ПервыйЗапрос = Ложь;
	КонецЦикла;

	Запрос.Текст = Запрос.Текст + ";
								  |////////////////////////////////////////////////////////////////////////////////
								  |
								  |ВЫБРАТЬ
								  |	ТаблицаСоответствийЗначений.ХарактеристикаOzon КАК ХарактеристикаOzon,
								  |	ТаблицаСоответствийЗначений.ХарактеристикаOzonКод КАК ХарактеристикаOzonКод,
								  |	ТаблицаСоответствийЗначений.ЗначениеХарактеристикиOzon КАК ЗначениеХарактеристикиOzon,
								  |	ТаблицаСоответствийЗначений.ВидРеквизита1С КАК ВидРеквизита1С,
								  |	ТаблицаСоответствийЗначений.Реквизит1С КАК Реквизит1С,
								   //+ ИнфоСофт Стояк Ю.К. 22.08.2024 УА #82083
								  |	0 КАК Множитель,
								  //- ИнфоСофт Стояк Ю.К. 22.08.2024 УА #82083
								  |	ТаблицаСоответствийЗначений.ЗначениеВРегистре КАК ЗначениеВРегистре,
								  |	ТаблицаСоответствийЗначений.ЗначениеХарактеристики КАК ЗначениеХарактеристики,
								  |	ТаблицаСоответствийЗначений.ТребуетсяСопоставление КАК ТребуетсяСопоставление
								  |ПОМЕСТИТЬ вт_СоответствиеЗначенийХарактеристик
								  |ИЗ
								  |	&ТаблицаСоответствийЗначений КАК ТаблицаСоответствийЗначений
								  |;
								  |
								  |////////////////////////////////////////////////////////////////////////////////
								  |
								  |ВЫБРАТЬ РАЗРЕШЕННЫЕ
								  |	вт_СоответствиеЗначенийХарактеристик.ХарактеристикаOzon,
								  |	вт_СоответствиеЗначенийХарактеристик.ХарактеристикаOzonКод,
								  |	вт_СоответствиеЗначенийХарактеристик.ЗначениеХарактеристикиOzon,
								  |	вт_СоответствиеЗначенийХарактеристик.Реквизит1С,
								   //+ ИнфоСофт Стояк Ю.К. 22.08.2024 УА #82093
								  |	вт_СоответствиеЗначенийХарактеристик.Множитель,
								  //- ИнфоСофт Стояк Ю.К. 22.08.2024 УА #82093
								  |	вт_СоответствиеЗначенийХарактеристик.ВидРеквизита1С,
								  |	вт_СоответствиеЗначенийХарактеристик.ЗначениеХарактеристики,
								  |	РеквизитыХарактеристики.ТекстоваяСтрока КАК ТекстоваяСтрока,
								  |   вт_СоответствиеЗначенийХарактеристик.ТребуетсяСопоставление
								  |ИЗ
								  |	вт_таб2 КАК РеквизитыХарактеристики
								  |		ЛЕВОЕ СОЕДИНЕНИЕ вт_СоответствиеЗначенийХарактеристик КАК вт_СоответствиеЗначенийХарактеристик
								  |		ПО (РеквизитыХарактеристики.ИмяРеквизита1С = вт_СоответствиеЗначенийХарактеристик.Реквизит1С)
								  |			И (РеквизитыХарактеристики.Значение = вт_СоответствиеЗначенийХарактеристик.ЗначениеХарактеристики)
								  |ГДЕ
								  |	вт_СоответствиеЗначенийХарактеристик.ТребуетсяСопоставление
								  |
								  |ОБЪЕДИНИТЬ ВСЕ
								  |
								  |ВЫБРАТЬ
								  |	вт_СоответствиеЗначенийХарактеристик.ХарактеристикаOzon,
								  |	вт_СоответствиеЗначенийХарактеристик.ХарактеристикаOzonКод,
								  |	РеквизитыХарактеристики.Значение,
								  |	вт_СоответствиеЗначенийХарактеристик.Реквизит1С,
								   //+ ИнфоСофт Стояк Ю.К. 22.08.2024 УА #82093
								  |	вт_СоответствиеЗначенийХарактеристик.Множитель,
								  //- ИнфоСофт Стояк Ю.К. 22.08.2024 УА #82093
								  |	вт_СоответствиеЗначенийХарактеристик.ВидРеквизита1С,
								  |	вт_СоответствиеЗначенийХарактеристик.ЗначениеХарактеристики,
								  |	РеквизитыХарактеристики.ТекстоваяСтрока,
								  |   вт_СоответствиеЗначенийХарактеристик.ТребуетсяСопоставление
								  |ИЗ
								  |	вт_таб2 КАК РеквизитыХарактеристики
								  |		ЛЕВОЕ СОЕДИНЕНИЕ вт_СоответствиеЗначенийХарактеристик КАК вт_СоответствиеЗначенийХарактеристик
								  |		ПО (вт_СоответствиеЗначенийХарактеристик.Реквизит1С = РеквизитыХарактеристики.ИмяРеквизита1С)
								  |			И (вт_СоответствиеЗначенийХарактеристик.ЗначениеХарактеристикиOzon = ЗНАЧЕНИЕ(Справочник.ИС_Ozon_ЗначенияХарактеристик.ПустаяСсылка)
								  |				ИЛИ вт_СоответствиеЗначенийХарактеристик.ЗначениеХарактеристикиOzon ЕСТЬ NULL ИЛИ вт_СоответствиеЗначенийХарактеристик.ЗначениеХарактеристикиOzon = Неопределено)
								  |ГДЕ
								  |	НЕ вт_СоответствиеЗначенийХарактеристик.ТребуетсяСопоставление";

	Запрос.УстановитьПараметр("ТаблицаСоответствийЗначений", ТаблицаСоответствийЗначений);
	Запрос.УстановитьПараметр("ХарактеристикаНоменклатуры", СтрокаТаблицы.ХарактеристикаНоменклатуры);
	РезультатЗапроса = Запрос.Выполнить();

