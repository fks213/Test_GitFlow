//+ ИнфоСофт Мурсалимов Д.Р. 06.12.23 УА #67276
Функция ПолучитьСтатусСборочногоЗадания(Статус)
    
    Событие = ПолучитьИмяСобытия("ПолучитьСтатусСборочногоЗадания");
    
	Если Статус = "acceptance_in_progress" Тогда                           
		Возврат Перечисления.ИС_Ozon_СтатусыОтправлений.acceptance_in_progress;
	КонецЕсли; 
	
	Если Статус = "arbitration" Тогда                           
		Возврат Перечисления.ИС_Ozon_СтатусыОтправлений.arbitration;
	КонецЕсли;
	
	Если Статус = "awaiting_approve" Тогда                           
		Возврат Перечисления.ИС_Ozon_СтатусыОтправлений.awaiting_approve;
	КонецЕсли;
	
	Если Статус = "awaiting_deliver" Тогда                           
		Возврат Перечисления.ИС_Ozon_СтатусыОтправлений.awaiting_deliver;
	КонецЕсли;       
	
	Если Статус = "awaiting_packaging" Тогда                           
		Возврат Перечисления.ИС_Ozon_СтатусыОтправлений.awaiting_packaging;
	КонецЕсли; 
	
	Если Статус = "awaiting_registration" Тогда                           
		Возврат Перечисления.ИС_Ozon_СтатусыОтправлений.awaiting_registration;
	КонецЕсли;
	
	Если Статус = "awaiting_verification" Тогда                           
		Возврат Перечисления.ИС_Ozon_СтатусыОтправлений.awaiting_verification;
	КонецЕсли;
	
	Если Статус = "cancelled" Тогда                           
		Возврат Перечисления.ИС_Ozon_СтатусыОтправлений.cancelled;
	КонецЕсли;  
	
	Если Статус = "cancelled_from_split_pending" Тогда                           
		Возврат Перечисления.ИС_Ozon_СтатусыОтправлений.cancelled_from_split_pending;
	КонецЕсли; 
	
	Если Статус = "client_arbitration" Тогда                           
		Возврат Перечисления.ИС_Ozon_СтатусыОтправлений.client_arbitration;
	КонецЕсли;
	
	Если Статус = "delivered" Тогда                           
		Возврат Перечисления.ИС_Ozon_СтатусыОтправлений.delivered;
	КонецЕсли;
	
	Если Статус = "delivering" Тогда                           
		Возврат Перечисления.ИС_Ozon_СтатусыОтправлений.delivering;
	КонецЕсли;
	
	Если Статус = "driver_pickup" Тогда                           
		Возврат Перечисления.ИС_Ozon_СтатусыОтправлений.driver_pickup;
	КонецЕсли;
	
	Если Статус = "not_accepted" Тогда                           
		Возврат Перечисления.ИС_Ozon_СтатусыОтправлений.not_accepted;
	КонецЕсли;
	
	Если Статус = "sent_by_seller" Тогда                           
		Возврат Перечисления.ИС_Ozon_СтатусыОтправлений.sent_by_seller;
	КонецЕсли;

	Текст = СтрШаблон("Получен неизвестный статус сборочного задания: %1", Статус);
	ИС_MP_Сервер.ЗаписатьВЖРИСообщитьПользователю(Событие, Текст);
	
	Возврат Перечисления.ИС_Ozon_СтатусыОтправлений.ПустаяСсылка();
		
КонецФункции //- ИнфоСофт Мурсалимов Д.Р. 06.12.23 УА #67276

