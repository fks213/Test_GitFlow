//+ ИнфоСофт Мурсалимов Д.Р. 04.07.24 УА #66901
Функция ПолучитьСтруктуруПараметровЦен() Экспорт

	Результат = Новый Структура;
	
	Результат.Вставить("ВидЦены"					, Справочники.ВидыЦен.ПустаяСсылка());
	Результат.Вставить("ВидЦеныСоСкидкой"			, Справочники.ВидыЦен.ПустаяСсылка()); 
	Результат.Вставить("ВидЦеныМинимальный"			, Справочники.ВидыЦен.ПустаяСсылка());
	Результат.Вставить("РежимОкругленияЦен"			, 0);
	Результат.Вставить("ИспользоватьПоследниеЦены"	, Ложь);
	//+ ИнфоСофт Стояк Ю.К. 26.11.2024 УА #87103
	Результат.Вставить("АвтоприменениеАкций"		, "UNKNOWN");
	Результат.Вставить("АвтоприменениеСтратегийЦены", "UNKNOWN");
	//- ИнфоСофт Стояк Ю.К. 26.11.2024 УА #87103

    Возврат Результат;
	
КонецФункции //- ИнфоСофт Мурсалимов Д.Р. 04.07.24 УА #66901

//+ ИнфоСофт Заварин К.В. 10.07.24 УА #70305
Функция ПолучитьИнформациюПоОтчётПоОстаткамИТоварам(Профиль) Экспорт
	
	НастройкиСоединения = ПолучитьНастройкиСоединенияПрофиля(Профиль);
	ПараметрыЗапроса = ПроверитьИЗаполнитьПараметрыЗапроса(НастройкиСоединения);
	
	СтруктураТела = Новый Структура; 
	Фильтр = Новый Структура;  	
	СтруктураТела.Вставить("limit", 1000);
	СтруктураТела.Вставить("offset", 0);
	СтруктураТела.Вставить("warehouse_type", "ALL"); 
	
	КвалификаторыЧисла  = Новый КвалификаторыЧисла(50, 2, ДопустимыйЗнак.Неотрицательный);
	КвалификаторыСтроки = Новый КвалификаторыСтроки(80);
	
	ТаблицаОстатковFBO = Новый ТаблицаЗначений;
	ТаблицаОстатковFBO.Колонки.Добавить("nmId", Новый ОписаниеТипов("Строка", КвалификаторыСтроки));  
	ТаблицаОстатковFBO.Колонки.Добавить("Склад", Новый ОписаниеТипов("Строка", КвалификаторыСтроки));
	ТаблицаОстатковFBO.Колонки.Добавить("НаСкладе", Новый ОписаниеТипов("Число", КвалификаторыЧисла));
		
	Пока Истина Цикл
		
		Результат = ИС_Ozon_API.ПолучитьОтчётПоОстаткамИТоварам(Профиль, ПараметрыЗапроса, СтруктураТела);
		
		Если Результат = Неопределено Тогда
			Возврат Неопределено;
		КонецЕсли;
		
		Если Результат.Количество() = 0 Тогда
			Прервать;
		КонецЕсли;
		
		Для Каждого Остаток Из Результат Цикл
			
			НСтр          = ТаблицаОстатковFBO.Добавить();
			НСтр.nmId     = Остаток.item_code;     													
			НСтр.Склад    = Остаток.warehouse_name;
			НСтр.НаСкладе = Остаток.free_to_sell_amount + Остаток.reserved_amount;
			
		КонецЦикла; 
		
		СтруктураТела.offset = СтруктураТела.offset + СтруктураТела.limit;
		
	КонецЦикла;
	
	Возврат ТаблицаОстатковFBO;
	
КонецФункции //- ИнфоСофт Заварин К.В. 10.07.24 УА #70305

//+ ИнфоСофт Стояк Ю.К. 07.11.2024 УА #72455
Функция ПолучитьОстаткиПоСкладамFBO(Профиль) Экспорт
	
	НастройкиСоединения = ПолучитьНастройкиСоединенияПрофиля(Профиль);
	ПараметрыЗапроса = ПроверитьИЗаполнитьПараметрыЗапроса(НастройкиСоединения);
		
	ТаблицаОстатков = Новый ТаблицаЗначений;  
	
	КвалификаторыЧисла = Новый КвалификаторыЧисла(20, 2, ДопустимыйЗнак.Неотрицательный);
	КвалификаторыСтроки = Новый КвалификаторыСтроки(80);
	
	ТаблицаОстатков.Колонки.Добавить("sku", Новый ОписаниеТипов("Число", КвалификаторыЧисла));
	ТаблицаОстатков.Колонки.Добавить("warehouse_name", Новый ОписаниеТипов("Строка", КвалификаторыСтроки));
	ТаблицаОстатков.Колонки.Добавить("free_to_sell_amount", Новый ОписаниеТипов("Число", КвалификаторыЧисла));	
	ТаблицаОстатков.Колонки.Добавить("promised_amount", Новый ОписаниеТипов("Число", КвалификаторыЧисла));	
	ТаблицаОстатков.Колонки.Добавить("reserved_amount", Новый ОписаниеТипов("Число", КвалификаторыЧисла));
	
	Лимит = 500;
	Смещение = 0;    
	
	ТелоЗапроса = Новый Структура;
	ТелоЗапроса.Вставить("limit", Лимит);
	ТелоЗапроса.Вставить("offset", Смещение);
		
	Пока Истина Цикл	
		
		Результат = ИС_Ozon_API.ПолучитьОстаткиFBO(Профиль, ПараметрыЗапроса, ТелоЗапроса);
		
		Если Результат = Неопределено Или Результат.rows.Количество() = 0 Тогда	
			Прервать;	
		КонецЕсли;
		
		Для Каждого Элемент Из Результат.rows Цикл
			
			Если Не Элемент.Свойство("warehouse_name") Тогда
				Продолжить;
			КонецЕсли;
			
			НоваяСтрока = ТаблицаОстатков.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, Элемент); 
			
		КонецЦикла;
		
		ТелоЗапроса.offset = ТелоЗапроса.offset + Лимит;
		
	КонецЦикла; 
		
	Возврат ТаблицаОстатков;
	
КонецФункции //- ИнфоСофт Стояк Ю.К. 07.11.2024 УА #72455

