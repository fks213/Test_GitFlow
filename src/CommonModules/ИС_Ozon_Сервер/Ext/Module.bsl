//+ ИнфоСофт Сумин Д.В. 18.12.2023 УА #65730
Функция СоздатьДокументПриобретения(ЗаголовокСтруктура, ДанныеДокумента) Экспорт  
	
	Документ = Документы.ПриобретениеТоваровУслуг.СоздатьДокумент();
	
	Документ.Дата = ЗаголовокСтруктура.ДатаДокумента;
	Документ.Автор = ПользователиКлиентСервер.ТекущийПользователь();
	Документ.ХозяйственнаяОперация = Перечисления.ХозяйственныеОперации.ЗакупкаУПоставщика;
	Документ.Организация = ЗаголовокСтруктура.Организация;
	Документ.Партнер = ЗаголовокСтруктура.Партнер;	
	Документ.Контрагент = ЗаголовокСтруктура.Контрагент;  
	
	Документ.ЗакупкаПодДеятельность = Перечисления.ТипыНалогообложенияНДС.ПродажаОблагаетсяНДС;  
	Документ.ВариантПриемкиТоваров = Перечисления.ВариантыПриемкиТоваров.РазделенаПоЗаказамИНакладным; 
	
	Если ЗначениеЗаполнено(ЗаголовокСтруктура.ДоговорЗакупки) Тогда
		Валюта = ЗаголовокСтруктура.ДоговорЗакупки.ВалютаВзаиморасчетов;
	Иначе
		Валюта = ЗаголовокСтруктура.ДоговорЗакупки.ВалютаВзаиморасчетов;
	КонецЕсли;	
	
	Документ.Валюта = Валюта;
	Документ.ВалютаВзаиморасчетов = Валюта;
	Документ.СпособДоставки = Перечисления.СпособыДоставки.СиламиПоставщикаДоНашегоСклада;  
	Документ.Договор = ЗаголовокСтруктура.ДоговорЗакупки;
	Документ.Соглашение = ЗаголовокСтруктура.СоглашениеЗакупки;
	
	Документ.НалогообложениеНДС = Перечисления.ТипыНалогообложенияНДС.ПродажаОблагаетсяНДС; 		
	
	СуммаДокумента = 0;
	
	Комментарий = "";
	
	Для Каждого Элемент Из ДанныеДокумента Цикл 	
		
		ЭлементТЧ = Документ.Товары.Добавить();
		ЭлементТЧ.Номенклатура = Элемент.Номенклатура;
		ЭлементТЧ.Количество = 1;
		ЭлементТЧ.КоличествоУпаковок = 1;
		ЭлементТЧ.Цена = Элемент.Сумма;
		ЭлементТЧ.СписатьНаРасходы = Истина;
		ЭлементТЧ.СтатьяРасходов = Элемент.СтатьяРасходов;
		
		ЭлементТЧ.СуммаНДС = Элемент.НДС; 
		ЭлементТЧ.СуммаСНДС = Элемент.НДС + Элемент.Сумма; 	
		ЭлементТЧ.СтавкаНДС = Элемент.СтавкаНДС; 
		СуммаДокумента = СуммаДокумента + Элемент.НДС + Элемент.Сумма; 
		ЭлементТЧ.Сумма = Элемент.Сумма;  
		
		ЭлементТЧ.Подразделение = ЗаголовокСтруктура.Подразделение;	
		Комментарий = Комментарий + "/" + Элемент.Номенклатура.Наименование 
	КонецЦикла;	
	
	Документ.Комментарий = Комментарий;
	
	Документ.СуммаДокумента = СуммаДокумента;
	
	Если Документ.Товары.Количество() = 0 Тогда
		Возврат Неопределено;		
	КонецЕсли;
	
	Попытка
		Документ.Записать(РежимЗаписиДокумента.Проведение); 
	Исключение
		Документ.Записать();
	КонецПопытки; 
	
	Возврат Документ.Ссылка;
	
КонецФункции //- ИнфоСофт Сумин Д.В. 18.12.2023 УА #65730

//+ ИнфоСофт Сумин Д.В. 18.12.2023 УА #65730
Функция СоздатьДокументВзаимозачетЗадолженности(ДокументПриобретения, ОтчетКомиссионера) Экспорт  
	
	ДокументВзаимозачет = Документы.ВзаимозачетЗадолженности.СоздатьДокумент();
	
	//+ ИнфоСофт Заварин К.В. 21.11.24 УА #86791
	ДокументРасчетов = ДокументПриобретения;
	Если ЗначениеЗаполнено(ОтчетКомиссионера.Соглашение) И ЗначениеЗаполнено(ОтчетКомиссионера.Соглашение.ПорядокРасчетов) Тогда
		ПорядокРасчетов = ОтчетКомиссионера.Соглашение.ПорядокРасчетов;
	Иначе
		ПорядокРасчетов = ОтчетКомиссионера.Договор.ПорядокРасчетов;  
	КонецЕсли;
	
	Если ПорядокРасчетов = Перечисления.ПорядокРасчетов.ПоНакладным Тогда
		ОбъектРасчетов = Справочники.ОбъектыРасчетов.НайтиПоРеквизиту("Объект", ОтчетКомиссионера.Ссылка);
	Иначе
		ОбъектРасчетов = Справочники.ОбъектыРасчетов.НайтиПоРеквизиту("Объект", ОтчетКомиссионера.Договор);
	КонецЕсли; 
	
	Если ЗначениеЗаполнено(ДокументПриобретения.Соглашение) И ЗначениеЗаполнено(ДокументПриобретения.Соглашение.ПорядокРасчетов) Тогда
		ПорядокРасчетов = ДокументПриобретения.Соглашение.ПорядокРасчетов;
	Иначе
		ПорядокРасчетов = ДокументПриобретения.Договор.ПорядокРасчетов;  
	КонецЕсли;
	
	Если ПорядокРасчетов = Перечисления.ПорядокРасчетов.ПоНакладным Тогда
		ДокументРасчетов  = Справочники.ОбъектыРасчетов.НайтиПоРеквизиту("Объект", ДокументПриобретения.Ссылка); 
	Иначе
		ДокументРасчетов  = Справочники.ОбъектыРасчетов.НайтиПоРеквизиту("Объект", ДокументПриобретения.Договор); 
	КонецЕсли;		  
	//- ИнфоСофт Заварин К.В. 21.11.24 УА #86791
	
	ДокументВзаимозачет.Дата = ОтчетКомиссионера.Дата;
	ДокументВзаимозачет.Организация = ДокументПриобретения.Организация; 
	
	ДокументВзаимозачет.КонтрагентДебитор = ДокументПриобретения.Контрагент;
	ДокументВзаимозачет.КонтрагентКредитор = ДокументПриобретения.Контрагент; 
	
	ДокументВзаимозачет.СуммаДокумента = ДокументПриобретения.СуммаДокумента;
	ДокументВзаимозачет.Валюта = ДокументПриобретения.Валюта;
	ДокументВзаимозачет.ВидОперации = Перечисления.ВидыОперацийВзаимозачетаЗадолженности.Произвольный;
	ДокументВзаимозачет.ТипДебитора = Перечисления.ТипыУчастниковВзаимозачета.Клиент;
	ДокументВзаимозачет.ТипКредитора = Перечисления.ТипыУчастниковВзаимозачета.Поставщик;
	ДокументВзаимозачет.СуммаРегл = ИС_WB_СерверУТ11_5.ПересчитатьВСуммуРегл(ДокументПриобретения.СуммаДокумента, ДокументПриобретения.Валюта, ДокументПриобретения.Дата); 
	ДокументВзаимозачет.СуммаУпр = ИС_WB_СерверУТ11_5.ПересчитатьВСуммуУпр(ДокументПриобретения.СуммаДокумента, ДокументПриобретения.Валюта, ДокументПриобретения.Дата); 
	
	ДебиторскаяЗадолженностьТЧ = ДокументВзаимозачет.ДебиторскаяЗадолженность.Добавить();
	ДебиторскаяЗадолженностьТЧ.ТипРасчетов = Перечисления.ТипыРасчетовСПартнерами.РасчетыСКлиентом;
	ДебиторскаяЗадолженностьТЧ.Партнер = ДокументПриобретения.Партнер;
	
	//+ ИнфоСофт Заварин К.В. 21.11.24 УА #86791
	//ДебиторскаяЗадолженностьТЧ.ОбъектРасчетов = Справочники.ОбъектыРасчетов.НайтиПоРеквизиту("Объект", ОтчетКомиссионера);	
	ДебиторскаяЗадолженностьТЧ.ОбъектРасчетов = ОбъектРасчетов;
	//- ИнфоСофт Заварин К.В. 21.11.24 УА #86791 
	
	ДебиторскаяЗадолженностьТЧ.СуммаВзаиморасчетов = ДокументПриобретения.СуммаДокумента;
	ДебиторскаяЗадолженностьТЧ.ВалютаВзаиморасчетов = ДокументПриобретения.ВалютаВзаиморасчетов;
	ДебиторскаяЗадолженностьТЧ.Организация = ДокументПриобретения.Организация; 
	ДебиторскаяЗадолженностьТЧ.СуммаРегл = ДокументВзаимозачет.СуммаРегл; 
	ДебиторскаяЗадолженностьТЧ.СуммаУпр = ДокументВзаимозачет.СуммаУпр;
	
	КредиторскаяЗадолженностьТЧ = ДокументВзаимозачет.КредиторскаяЗадолженность.Добавить();
	КредиторскаяЗадолженностьТЧ.ТипРасчетов = Перечисления.ТипыРасчетовСПартнерами.РасчетыСПоставщиком;
	КредиторскаяЗадолженностьТЧ.Партнер = ДокументПриобретения.Партнер;
	
	//+ ИнфоСофт Заварин К.В. 21.11.24 УА #86791
	//КредиторскаяЗадолженностьТЧ.ОбъектРасчетов = Справочники.ОбъектыРасчетов.НайтиПоРеквизиту("Объект", ДокументПриобретения.Ссылка);	
	КредиторскаяЗадолженностьТЧ.ОбъектРасчетов = ДокументРасчетов;
	//- ИнфоСофт Заварин К.В. 21.11.24 УА #86791
	
	КредиторскаяЗадолженностьТЧ.СуммаВзаиморасчетов = ДокументПриобретения.СуммаДокумента;
	КредиторскаяЗадолженностьТЧ.ВалютаВзаиморасчетов = ДокументПриобретения.ВалютаВзаиморасчетов;
	КредиторскаяЗадолженностьТЧ.Организация = ДокументПриобретения.Организация;
	КредиторскаяЗадолженностьТЧ.СуммаРегл = ДокументВзаимозачет.СуммаРегл; 
	КредиторскаяЗадолженностьТЧ.СуммаУпр = ДокументВзаимозачет.СуммаУпр;
	
	Попытка
		ДокументВзаимозачет.Записать(РежимЗаписиДокумента.Проведение); 
	Исключение
		ДокументВзаимозачет.Записать();
	КонецПопытки;  
	
	Возврат ДокументВзаимозачет.Ссылка;
	
КонецФункции //- ИнфоСофт Сумин Д.В. 18.12.2023 УА #65730

//+ ИнфоСофт Стояк Ю.К. 21.01.2024 УА #61983
Функция ПолучитьНастройкиСопоставления() Экспорт
	
	Событие = "ПолучитьНастройкиСопоставления";
	Параметры = Новый Структура;
	
	МассивНаименованийПараметров = Новый Массив;  	
	МассивНаименованийПараметров.Добавить("РазделительФотографий");
	МассивНаименованийПараметров.Добавить("ЗначениеАртикулаПоУмолчанию");
	МассивНаименованийПараметров.Добавить("РасширенияДляВыгрузкиКартинок");
	МассивНаименованийПараметров.Добавить("ВесовойТовар_МинимальныйВес");
	МассивНаименованийПараметров.Добавить("ВесовойТовар_МаксимальныйВес");
	МассивНаименованийПараметров.Добавить("ВесовойТовар_ПризнакВесовогоТовара");
	МассивНаименованийПараметров.Добавить("ВесовойТовар_Квант");
	МассивНаименованийПараметров.Добавить("ВесовойТовар_МинимальноеКоличество");
		
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ИС_MP_Настройки.Наименование КАК Наименование,
	|	ИС_MP_Настройки.Значение КАК Значение
	|ИЗ
	|	Справочник.ИС_MP_Настройки КАК ИС_MP_Настройки
	|ГДЕ
	|	ИС_MP_Настройки.Наименование В(&МассивПараметров)";
	
	Запрос.УстановитьПараметр("МассивПараметров", МассивНаименованийПараметров);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Выборка = РезультатЗапроса.Выбрать();
	
	Настройки = Новый Соответствие;
	
	Пока Выборка.Следующий() Цикл
		Настройки.Вставить(Выборка.Наименование, Выборка.Значение);		
