#Область Настройки

//+ ИнфоСофт Ивонин К.А. 21.10.24 УА #68001
Процедура ПолучитьНастройки(Форма) Экспорт
	
	Если Не Форма.Объект.ИнтеграцияОзон Тогда
		Возврат;
	КонецЕсли;
	
	Маркетплейс = Перечисления.ИС_МП_Маркетплейсы.Озон; 
	
	//МассивНастроек = МассивНастроекПодключения();	
	МассивНастроек = Новый Массив;
	МассивНастроек = МассивНастроекОстатков(МассивНастроек);
	//+ ИнфоСофт Стояк Ю.К. 11.03.2025 УА #93469	
	//МассивНастроек.Добавить("ЗагружатьЗаказыПоСхемеФБО");
	МассивНастроек = МассивНастроекЗаказов(МассивНастроек);
	//- ИнфоСофт Стояк Ю.К. 11.03.2025 УА #93469
	//МассивНастроек = МассивНастроекЦен(МассивНастроек);
	
	СтруктураНастроек = ИС_МП_Сервер.ПолучитьЗначениеНастроек(Форма.Объект.Ссылка, Маркетплейс, МассивНастроек);

	СтруктураПараметров = Новый Структура;

	Для Каждого Элемент Из СтруктураНастроек Цикл
		СтруктураПараметров.Вставить("Озон" + Элемент.Ключ, Элемент.Значение);	
	КонецЦикла;
		
	ЗаполнитьЗначенияСвойств(Форма, СтруктураПараметров);
			
КонецПроцедуры //- ИнфоСофт Ивонин К.А. 21.10.24 УА #68001

//+ ИнфоСофт Ивонин К.А. 21.10.24 УА #68001
Процедура ЗаписатьНастройки(Форма) Экспорт
	
	Если Не Форма.Объект.ИнтеграцияОзон Тогда
		Возврат;
	КонецЕсли;
	
	//МассивНастроек = МассивНастроекПодключения();
	МассивНастроек = Новый Массив;
	МассивНастроек = МассивНастроекОстатков(МассивНастроек);
	МассивНастроек.Добавить("ЗагружатьЗаказыПоСхемеФБО");
	//МассивНастроек = МассивНастроекЦен(МассивНастроек);
	
	СтруктураНастроек = Новый Структура;
	
	Для Каждого Элемент Из МассивНастроек Цикл
		СтруктураНастроек.Вставить("Озон" + Элемент, Неопределено);
	КонецЦикла;
	
	ЗаполнитьЗначенияСвойств(СтруктураНастроек, Форма);
	
	СтруктураПараметров = Новый Структура;
	
	Для Каждого Элемент Из СтруктураНастроек Цикл
		СтруктураПараметров.Вставить(СтрЗаменить(Элемент.Ключ, "Озон", ""), Элемент.Значение);	
	КонецЦикла;
	
	Маркетплейс = Перечисления.ИС_МП_Маркетплейсы.Озон;
	
	ИС_МП_Сервер.ЗаписатьЗначениеНастроек(Форма.Объект.Ссылка, Маркетплейс, СтруктураПараметров);
	
КонецПроцедуры //- ИнфоСофт Ивонин К.А. 21.10.24 УА #68001

//+ ИнфоСофт Ивонин К.А. 28.10.24 УА #68001
Функция МассивНастроекОстатков(МассивНастроек = Неопределено) Экспорт
	
	Если МассивНастроек = Неопределено Тогда
		МассивНастроек = Новый Массив;
	КонецЕсли;
	
	МассивНастроек.Добавить("РассчитыватьНесобранныеКомплекты");
	МассивНастроек.Добавить("ВыгружатьОстаткиВРазрезеОрганизации");
	МассивНастроек.Добавить("ИспользоватьПоследниеОстатки");	
	МассивНастроек.Добавить("ИспользоватьФиксированныйОстаток");
	МассивНастроек.Добавить("ФиксированныйОстаток");
	МассивНастроек.Добавить("РежимСокрытияОстатков");
	МассивНастроек.Добавить("СкрываемыйОстаток");
	
	Возврат МассивНастроек;
	
КонецФункции //- ИнфоСофт Ивонин К.А. 28.10.24 УА #68001

//+ ИнфоСофт Стояк Ю.К. 11.03.2025 УА #93469
Функция МассивНастроекЗаказов(МассивНастроек = Неопределено) Экспорт
	
	Если МассивНастроек = Неопределено Тогда
		МассивНастроек = Новый Массив;
	КонецЕсли;
	
	МассивНастроек.Добавить("ЗагружатьЗаказыПоСхемеФБО");
	
	Возврат МассивНастроек;
	
КонецФункции //- ИнфоСофт Стояк Ю.К. 11.03.2025 УА #93469

#КонецОбласти

#Область РегламентныеЗадания

//+ ИнфоСофт Ивонин К.А. 11.11.23 УА #55166
Процедура ВыполнитьКомандуРеглЗадания(Профиль, ИдентификаторКомандыОбработки) Экспорт
    
	Событие = ПолучитьИмяСобытия("ВыполнитьКомандуРеглЗадания");
	
	Если ИдентификаторКомандыОбработки = "ВыгрузкаЦенOzon" Тогда
		ВыгрузитьЦены(Профиль);
		Возврат;				
	КонецЕсли;
	
	Если ИдентификаторКомандыОбработки = "ВыгрузкаОстатковOzon" Тогда		
		
		Запрос = Новый Запрос;
		Запрос.Текст = 

		"ВЫБРАТЬ
		|	ИС_Ozon_Склады.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.ИС_Ozon_Склады КАК ИС_Ozon_Склады
		|ГДЕ
		|	ИС_Ozon_Склады.Профиль = &Профиль
		|	И НЕ ИС_Ozon_Склады.ПометкаУдаления
		//+ ИнфоСофт Стояк Ю.К. 03.03.2025 УА #93469
		|	И НЕ ИС_Ozon_Склады.СкладДляЗаказовФБО
		//- ИнфоСофт Стояк Ю.К. 03.03.2025 УА #93469
		//+ ИнфоСофт Заварин К.В. 13.08.24 УА #81097
		|	И НЕ(ИС_Ozon_Склады.ОбщаяГруппаСкладов = ЗНАЧЕНИЕ(Справочник.Склады.ПустаяСсылка)
		|				И ИС_Ozon_Склады.Склад = ЗНАЧЕНИЕ(Справочник.Склады.ПустаяСсылка)
		|				И ИС_Ozon_Склады.ВыгружатьОстаткиИзГруппыСкладов = ЛОЖЬ)";
		//- ИнфоСофт Заварин К.В. 13.08.24 УА #81097
		
		Запрос.УстановитьПараметр("Профиль", Профиль);
		
		РезультатЗапроса = Запрос.Выполнить();
		
		Выборка = РезультатЗапроса.Выбрать();
		
		Пока Выборка.Следующий() Цикл 
			ВыгрузитьОстатки(Профиль, Выборка.Ссылка);	
		КонецЦикла;
	
		Возврат;
		
	КонецЕсли;
	
	Если ИдентификаторКомандыОбработки = "ПолучениеСборочныхЗаданийOzon" Тогда
		
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	ИС_Ozon_Заказ.Дата КАК Дата
		|ИЗ
		|	Документ.ИС_Ozon_Заказ КАК ИС_Ozon_Заказ
		|ГДЕ
		|	ИС_Ozon_Заказ.Профиль = &Профиль
		|
		|УПОРЯДОЧИТЬ ПО
		|	Дата УБЫВ";
		
		Запрос.УстановитьПараметр("Профиль", Профиль);
		РезультатЗапроса = Запрос.Выполнить();
		
		ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
		
		Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
			ДатаНачала = ВыборкаДетальныеЗаписи.Дата;
		КонецЦикла;
		
		Если Не ЗначениеЗаполнено(ДатаНачала) Тогда
			ДатаНачала = НачалоДня(ТекущаяДатаСеанса());	
		КонецЕсли;
		
		ПолучитьЗаказы(Профиль, ДатаНачала + 1);
		
		//+ ИнфоСофт Стояк Ю.К. 03.03.2025 УА #93469
		МассивНаименованийПараметров = Новый Массив;  		
		МассивНаименованийПараметров.Добавить("ЗагружатьЗаказыПоСхемеФБО");
		
		Настройки = ИС_МП_Сервер.ПолучитьЗначениеНастроек(Профиль, Перечисления.ИС_МП_Маркетплейсы.Озон, МассивНаименованийПараметров);
		
		Если Настройки.ЗагружатьЗаказыПоСхемеФБО <> Неопределено Тогда
			ЗагружатьЗаказыПоСхемеФБО = Настройки.ЗагружатьЗаказыПоСхемеФБО;
		Иначе
			ЗагружатьЗаказыПоСхемеФБО = Ложь;
		КонецЕсли;			
		
		Если ЗагружатьЗаказыПоСхемеФБО Тогда
			
			Запрос = Новый Запрос;
			Запрос.Текст = 
			"ВЫБРАТЬ ПЕРВЫЕ 1
			|	ИС_Ozon_Заказ.Дата КАК Дата
			|ИЗ
			|	Документ.ИС_Ozon_Заказ КАК ИС_Ozon_Заказ
			|ГДЕ
			|	ИС_Ozon_Заказ.Профиль = &Профиль
			|	И ИС_Ozon_Заказ.ЗаказФБО
			|
			|УПОРЯДОЧИТЬ ПО
			|	Дата УБЫВ";
			
			Запрос.УстановитьПараметр("Профиль", Профиль);
			РезультатЗапроса = Запрос.Выполнить();
			
			ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
			
			Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
				ДатаНачала = ВыборкаДетальныеЗаписи.Дата;
			КонецЦикла;
			
			Если Не ЗначениеЗаполнено(ДатаНачала) Тогда
				ДатаНачала = НачалоДня(ТекущаяДатаСеанса());	
			КонецЕсли;
		
			ПолучитьЗаказыФБО(Профиль, ДатаНачала);	
		КонецЕсли;
		//- ИнфоСофт Стояк Ю.К. 03.03.2025 УА #93469
		
		Возврат;				
	
	КонецЕсли;
	
	Если ИдентификаторКомандыОбработки = "ОбновлениеСтатусовСборочныхЗаданийOzon" Тогда
		//+ ИнфоСофт Стояк Ю.К. 08.04.2024 УА #68800	
		ФункциональныеОпции = ПолучитьНастройкиФункциональностиСборочныхЗвданий(Профиль);
		
		//+ ИнфоСофт Стояк Ю.К. 03.12.2024 УА #88503		
		//Если ЗначениеЗаполнено(ФункциональныеОпции) Тогда
		Если ФункциональныеОпции.OzonКоличествоДнейОбновлениеСтатусов <> 0 Тогда
		//- ИнфоСофт Стояк Ю.К. 03.12.2024 УА #88503
			Период = ФункциональныеОпции.OzonКоличествоДнейОбновлениеСтатусов * 86400;
		Иначе
			Период = 604800;
		КонецЕсли;	
		
		ОбновитьСтатусыСборочныхЗаданий(Профиль, Период);
		//ОбновитьСтатусыСборочныхЗаданий(Профиль);
		//- ИнфоСофт Стояк Ю.К. 08.04.2024 УА #68800
		
		//+ ИнфоСофт Стояк Ю.К. 03.03.2025 УА #93469	
		МассивНаименованийПараметров = Новый Массив;  		
		МассивНаименованийПараметров.Добавить("ЗагружатьЗаказыПоСхемеФБО");
		
		Настройки = ИС_МП_Сервер.ПолучитьЗначениеНастроек(Профиль, Перечисления.ИС_МП_Маркетплейсы.Озон, МассивНаименованийПараметров);
		
		Если Настройки.ЗагружатьЗаказыПоСхемеФБО <> Неопределено Тогда
			ЗагружатьЗаказыПоСхемеФБО = Настройки.ЗагружатьЗаказыПоСхемеФБО;
		Иначе
			ЗагружатьЗаказыПоСхемеФБО = Ложь;
		КонецЕсли;
		
		Если ЗагружатьЗаказыПоСхемеФБО Тогда
			ОбновитьСтатусыСборочныхЗаданийФБО(Профиль, Период);	
		КонецЕсли;                                  
		//- ИнфоСофт Стояк Ю.К. 03.03.2025 УА #93469
		
		Возврат;				
	КонецЕсли; 
	
	Если ИдентификаторКомандыОбработки = "ЗакрыватьЗаказВТечениеДняOzon" Тогда 
        ВыполнитьЗакрытиеЗаказов(Профиль);
		Возврат;					
	КонецЕсли;
	
	Если ИдентификаторКомандыОбработки = "ВыполнениеАлгоритмаПоОсновнойСхемеFboOzon" Тогда
		ВыполнитьАлгоритмПоОсновнойСхемеFBO(Профиль);			
		Возврат;
	КонецЕсли;
	
	Если ИдентификаторКомандыОбработки = "ЗагружатьДанныеУслугOzon" Тогда
			
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	ИС_Ozon_ДанныеУслугСрезПоследних.Период КАК Период
		|ИЗ
		|	РегистрСведений.ИС_Ozon_ДанныеУслуг.СрезПоследних КАК ИС_Ozon_ДанныеУслугСрезПоследних
		|ГДЕ
		|	ИС_Ozon_ДанныеУслугСрезПоследних.Профиль = &Профиль
		|
		|УПОРЯДОЧИТЬ ПО
		|	ИС_Ozon_ДанныеУслугСрезПоследних.Период УБЫВ";
		
		Запрос.УстановитьПараметр("Профиль", Профиль);
		
		РезультатЗапроса = Запрос.Выполнить();
		
		Выборка = РезультатЗапроса.Выбрать();
		
		Если Выборка.Следующий() Тогда
			ДатаНачала = Выборка.Период;
			ДвеНедели = 2 * 604800; 
			ДатаОкончания = Выборка.Период + ДвеНедели;
		Иначе
			ДатаНачала = НачалоНедели(ТекущаяДатаСеанса() - 604800);
			ДатаОкончания = КонецНедели(ТекущаяДатаСеанса());
		КонецЕсли;
		
		ДатаТело = Новый Структура;
		ДатаТело.Вставить("from", ИС_MP_РаботаСHTTPЗапросамиСервер.ЗаписатьДатуВJSON(ДатаНачала, ФорматДатыJSON.ISO, ВариантЗаписиДатыJSON.УниверсальнаяДата));
		ДатаТело.Вставить("to", ИС_MP_РаботаСHTTPЗапросамиСервер.ЗаписатьДатуВJSON(ДатаОкончания, ФорматДатыJSON.ISO, ВариантЗаписиДатыJSON.УниверсальнаяДата));
		
		ЗагрузитьДанныеУслуг(Профиль, ДатаТело);			
		Возврат;
	
	КонецЕсли;
	
	Если ИдентификаторКомандыОбработки = "ЗагружатьДанныеУслугOzon" Тогда
			
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	ИС_Ozon_ДанныеУслугСрезПоследних.Период КАК Период
		|ИЗ
		|	РегистрСведений.ИС_Ozon_ДанныеУслуг.СрезПоследних КАК ИС_Ozon_ДанныеУслугСрезПоследних
		|ГДЕ
		|	ИС_Ozon_ДанныеУслугСрезПоследних.Профиль = &Профиль
		|
		|УПОРЯДОЧИТЬ ПО
		|	ИС_Ozon_ДанныеУслугСрезПоследних.Период УБЫВ";
		
		Запрос.УстановитьПараметр("Профиль", Профиль);
		
		РезультатЗапроса = Запрос.Выполнить();
		
		Выборка = РезультатЗапроса.Выбрать();
		
		Если Выборка.Следующий() Тогда
			ДатаНачала = Выборка.Период;
			ДвеНедели = 2 * 604800; 
			ДатаОкончания = Выборка.Период + ДвеНедели;
		Иначе
			ДатаНачала = НачалоНедели(ТекущаяДатаСеанса() - 604800);
			ДатаОкончания = КонецНедели(ТекущаяДатаСеанса());
		КонецЕсли;
		
		ДатаТело = Новый Структура;
		ДатаТело.Вставить("from", ИС_MP_РаботаСHTTPЗапросамиСервер.ЗаписатьДатуВJSON(ДатаНачала, ФорматДатыJSON.ISO, ВариантЗаписиДатыJSON.УниверсальнаяДата));
		ДатаТело.Вставить("to", ИС_MP_РаботаСHTTPЗапросамиСервер.ЗаписатьДатуВJSON(ДатаОкончания, ФорматДатыJSON.ISO, ВариантЗаписиДатыJSON.УниверсальнаяДата));
		
		ЗагрузитьДанныеУслуг(Профиль, ДатаТело);			
		Возврат;
	
	КонецЕсли;
			
КонецПроцедуры //- ИнфоСофт Ивонин К.А. 11.11.23 УА #55166

//+ ИнфоСофт Сумин Д.В. 30.05.2023 УА #59231
Процедура ВыполнитьЗакрытиеЗаказов(Профиль) 
	
	Событие = ПолучитьИмяСобытия("ВыполнитьЗакрытиеЗаказовОзон");
		
	//+ ИнфоСофт Стояк Ю.К. 27.10.2023 УА #65146
	ФукнциональныеОпции = ПолучитьНастройкиФункциональностиСборочныхЗвданий(Профиль);
	
	//+ ИнфоСофт Макарова Н.Е. 01.04.2025 УА #77424
	Если ФукнциональныеОпции.ФормироватьЕдиныйЗаказБезРазбиенияOzon 
		И НЕ ФукнциональныеОпции.ИспользоватьРазбиениеПоСкладамOzon Тогда // без разбиения, создается только 1 заказ
	//- ИнфоСофт Макарова Н.Е. 01.04.2025 УА #77424
		
		Если Не ЗначениеЗаполнено(ФукнциональныеОпции.АктивныйЗаказКлиентаOzon) Тогда
			Возврат;
		КонецЕсли;
		
		МассивЗаданий = Новый Массив;
		//+ ИнфоСофт Стояк Ю.К. 22.10.2024 УА #86120		
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	ИС_Ozon_Заказ.Ссылка КАК Ссылка
		|ИЗ
		|	Документ.ИС_Ozon_Заказ КАК ИС_Ozon_Заказ
		|ГДЕ
		|	ИС_Ozon_Заказ.Заказ = &Заказ";
		
		Запрос.УстановитьПараметр("Заказ", ФукнциональныеОпции.АктивныйЗаказКлиентаOzon);
		
		РезультатЗапроса = Запрос.Выполнить();
		
		ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
		
		Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
			МассивЗаданий.Добавить(ВыборкаДетальныеЗаписи.Ссылка);
		КонецЦикла;
		//МассивЗаданий.Добавить(ФукнциональныеОпции.АктивныйЗаказКлиентаOzon);
		//- ИнфоСофт Стояк Ю.К. 22.10.2024 УА #86120
		
