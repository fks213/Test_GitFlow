//+ ИнфоСофт Ивонин К.А. 14.03.24 УА #71892
Функция ПолучитьСкладПоУмолчанию(Профиль) Экспорт

	Результат = Справочники.ИС_Ozon_Склады.ПустаяСсылка();
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ ПЕРВЫЕ 2
	|	ИС_Ozon_Склады.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.ИС_Ozon_Склады КАК ИС_Ozon_Склады
	|ГДЕ
	|	ИС_Ozon_Склады.Профиль = &Профиль
	|	И НЕ ИС_Ozon_Склады.ПометкаУдаления";

	Запрос.УстановитьПараметр("Профиль", Профиль);
		
	РезультатЗапроса = Запрос.Выполнить();
	
	Выборка = РезультатЗапроса.Выбрать();

	Если Выборка.Количество() = 1 Тогда
		Выборка.Следующий();
		Результат = Выборка.Ссылка;
	КонецЕсли; 
	
	Возврат Результат;
	
КонецФункции //- ИнфоСофт Ивонин К.А. 14.03.24 УА #71892

//+ ИнфоСофт Ивонин К.А. 15.03.24 УА #71892
Функция ПолучитьОстаткиFBS(Профиль, Склад) Экспорт
	
	НастройкиСоединения = ПолучитьНастройкиСоединенияПрофиля(Профиль);	
	ПараметрыЗапроса = ПроверитьИЗаполнитьПараметрыЗапроса(НастройкиСоединения);
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ИС_Ozon_Склады.id КАК id,
	|	ИС_Ozon_Склады.is_kgt КАК СГТ
	|ИЗ
	|	Справочник.ИС_Ozon_Склады КАК ИС_Ozon_Склады
	|ГДЕ
	|	ИС_Ozon_Склады.Ссылка = &Ссылка";
	
	Запрос.УстановитьПараметр("Ссылка", Склад);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаСклад = РезультатЗапроса.Выбрать();
	
	ВыборкаСклад.Следующий();
	
	Id = ВыборкаСклад.id;
	СГТ = ВыборкаСклад.СГТ;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ИС_Ozon_Номенклатура.Ссылка КАК Ссылка,
	|	ИС_Ozon_Номенклатура.sku КАК sku
	|ИЗ
	|	Справочник.ИС_Ozon_Номенклатура КАК ИС_Ozon_Номенклатура
	|ГДЕ
	|	ИС_Ozon_Номенклатура.Профиль = &Профиль
	|	И ИС_Ozon_Номенклатура.is_kgt = &СГТ
	|	И НЕ ИС_Ozon_Номенклатура.sku = 0";
	
	Запрос.УстановитьПараметр("Профиль", Профиль);
	Запрос.УстановитьПараметр("СГТ", СГТ);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаSKU = РезультатЗапроса.Выбрать();
	
	МассивSKU = Новый Массив;
	
	Результат = Новый ТаблицаЗначений;
	Результат.Колонки.Добавить("НоменклатураOzon");
	Результат.Колонки.Добавить("sku");
	Результат.Колонки.Добавить("Остаток");
	
	Пока ВыборкаSKU.Следующий() Цикл
	
		НоваяСтрока = Результат.Добавить();
		НоваяСтрока.НоменклатураOzon = ВыборкаSKU.Ссылка;
		НоваяСтрока.sku = Формат(ВыборкаSKU.sku, "ЧГ=0");
		
		МассивSKU.Добавить(Формат(ВыборкаSKU.sku, "ЧГ=0"));
	
	КонецЦикла;
	
	РазбитыйМассив = ИС_MP_Сервер.РазбитьМассивПоNЭлементов(МассивSKU, 500);
	
	Для Каждого Элемент Из РазбитыйМассив Цикл
					
		ОстаткиТоваров = ИС_Ozon_API.ПолучитьОстаткиFBS(Профиль, ПараметрыЗапроса, Элемент);
		
		Если ОстаткиТоваров = Неопределено Тогда
			Продолжить;
		КонецЕсли;
				
		Для Каждого Элемент Из ОстаткиТоваров Цикл
		    
		    Если Элемент.warehouse_id <> Id Тогда
		    	Продолжить;
		    КонецЕсли;
		    
			НайденныеСтроки = Результат.НайтиСтроки(Новый Структура("sku", Формат(Элемент.sku, "ЧГ=0")));
			
			Если НайденныеСтроки.Количество() > 0 Тогда
				НайденныеСтроки[0].Остаток = Элемент.present;	
			КонецЕсли;
		
		КонецЦикла;
	
	КонецЦикла;	
							
	Возврат Результат;
	
КонецФункции //- ИнфоСофт Ивонин К.А. 15.03.24 УА #71892

//+ ИнфоСофт Ивонин К.А. 01.04.24 УА #71892
Функция ПолучитьИнформациюОСкладе(Склад) Экспорт

	ЗапросСклада = Новый Запрос;
	ЗапросСклада.Текст = 
	"ВЫБРАТЬ
	|	ИС_Ozon_Склады.Ссылка КАК Ссылка,
	|	ИС_Ozon_Склады.is_rfbs КАК rFBS,
	|	ИС_Ozon_Склады.is_kgt КАК КГТ,
	|	ИС_Ozon_Склады.ВыгружатьОстаткиИзГруппыСкладов КАК ВыгружатьОстаткиИзГруппыСкладов,
	|	ИС_Ozon_Склады.Склад КАК Склад,
	|	ИС_Ozon_Склады.ОбщаяГруппаСкладов КАК ОбщаяГруппаСкладов,
	|	ИС_Ozon_СкладыГруппаСкладов.Склад КАК СкладГруппы
	|ИЗ
	|	Справочник.ИС_Ozon_Склады КАК ИС_Ozon_Склады
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ИС_Ozon_Склады.ГруппаСкладов КАК ИС_Ozon_СкладыГруппаСкладов
	|		ПО ИС_Ozon_Склады.Ссылка = ИС_Ozon_СкладыГруппаСкладов.Ссылка
	|ГДЕ
	|	ИС_Ozon_Склады.Ссылка = &Ссылка
	|ИТОГИ ПО
	|	Ссылка";
	
	ЗапросСклада.УстановитьПараметр("Ссылка", Склад);
	
	РезультатЗапроса = ЗапросСклада.Выполнить();
	
	ВыборкаСклад = РезультатЗапроса.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	Результат = "";
		
	Пока ВыборкаСклад.Следующий() Цикл
		
		Результат = Результат + "rFBS: " + ВыборкаСклад.rFBS + Символы.ПС;
		Результат = Результат + "КГТ: " + ВыборкаСклад.КГТ + Символы.ПС;				
				
		Если ВыборкаСклад.ВыгружатьОстаткиИзГруппыСкладов Тогда 
		    
		    Результат = Результат + "Группа складов: " + Символы.ПС;
		    
			ВыборкаГруппаСкладов = ВыборкаСклад.Выбрать();
		
			Пока ВыборкаГруппаСкладов.Следующий() Цикл
			
				Если ВыборкаГруппаСкладов.СкладГруппы <> Null Тогда
			    	Результат = Результат + Символы.Таб + " - " + ВыборкаГруппаСкладов.СкладГруппы + Символы.ПС;
			    КонецЕсли;
			    
			КонецЦикла;				
		
		ИначеЕсли ЗначениеЗаполнено(ВыборкаСклад.ОбщаяГруппаСкладов) Тогда
			Результат = Результат + "Общая группа складов: " + ВыборкаСклад.ОбщаяГруппаСкладов + Символы.ПС;
		Иначе
			Результат = Результат + "Склад: " + ВыборкаСклад.Склад + Символы.ПС;		
		КонецЕсли;
	
	КонецЦикла;
    
    Возврат Результат;

КонецФункции //- ИнфоСофт Ивонин К.А. 01.04.24 УА #71892

//+ ИнфоСофт Мурсалимов Д.Р. 04.03.24 УА #67173
Процедура УстановитьПараметрыЗапросаОстатков(Запрос, Профиль, Склад) Экспорт
	
	Событие = ПолучитьИмяСобытия("УстановитьПараметрыЗапросаОстатков");
	
	Организация = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Профиль, "Организация");
	
	ПеречислениеМП = Перечисления.ИС_МП_Маркетплейсы.Озон; 
	
	МассивПараметров = ИС_МП_УправлениеОстатками.МассивНастроекОстатков(ПеречислениеМП);
	
	Настройки = ИС_МП_Сервер.ПолучитьЗначениеНастроек(Профиль, ПеречислениеМП, МассивПараметров); 
	
	РассчитыватьНесобранныеКомплекты = Ложь;
	ВыгружатьОстаткиВРазрезеОрганизации = Ложь;
	СкрываемыйОстаток = 0;

	Если Настройки.РассчитыватьНесобранныеКомплекты <> Неопределено Тогда
		РассчитыватьНесобранныеКомплекты = Настройки.РассчитыватьНесобранныеКомплекты;	
	КонецЕсли;
	
	Если Настройки.ВыгружатьОстаткиВРазрезеОрганизации <> Неопределено Тогда
		ВыгружатьОстаткиВРазрезеОрганизации = Настройки.ВыгружатьОстаткиВРазрезеОрганизации;	
	КонецЕсли;

	Если Настройки.СкрываемыйОстаток <> Неопределено Тогда
		СкрываемыйОстаток = Настройки.СкрываемыйОстаток;	
	КонецЕсли;
		
	Запрос.УстановитьПараметр("Профиль", Профиль);
	Запрос.УстановитьПараметр("Маркетплейс", ПеречислениеМП);
	Запрос.УстановитьПараметр("Склад", Склад); 
	Запрос.УстановитьПараметр("КоличествоСкрываемогоОстатка", СкрываемыйОстаток);
	Запрос.УстановитьПараметр("РассчитыватьНесобранныеКомплекты", РассчитыватьНесобранныеКомплекты);
	Запрос.УстановитьПараметр("ВыгружатьОстаткиВРазрезеОрганизации", ВыгружатьОстаткиВРазрезеОрганизации);
	Запрос.УстановитьПараметр("Организация", Организация);
	Запрос.УстановитьПараметр("ПустаяУпаковка", ИС_МП_СерверЛокализация.ПустаяСсылкаУпаковка());
	
	СГТ = Ложь;
	Заменитель = "ИЕРАРХИИ";
	ПараметрСклад = Неопределено;
	
	ЗапросНазначений = Новый Запрос;
	ЗапросНазначений.Текст = 
	"ВЫБРАТЬ
	|	ЕСТЬNULL(Назначения.Ссылка, ЗНАЧЕНИЕ(Справочник.Назначения.ПустаяСсылка)) КАК Назначение
	|ИЗ
	|	Справочник.ИС_Ozon_Склады.НаправленияДеятельности КАК ИС_Ozon_СкладыНаправленияДеятельности
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Назначения КАК Назначения
	|		ПО ИС_Ozon_СкладыНаправленияДеятельности.НаправлениеДеятельности = Назначения.НаправлениеДеятельности И (Назначения.НаправлениеДеятельности <> ЗНАЧЕНИЕ(Справочник.НаправленияДеятельности.ПустаяСсылка))
	|ГДЕ
	|	ИС_Ozon_СкладыНаправленияДеятельности.Ссылка = &Ссылка";
	
	ЗапросНазначений.УстановитьПараметр("Ссылка", Склад);
	
	РезультатЗапросаНазначений = ЗапросНазначений.Выполнить();
	
	Назначения = Новый Массив;
	
	ВыборкаНазначения = РезультатЗапросаНазначений.Выбрать();
	
	Пока ВыборкаНазначения.Следующий() Цикл	
		Назначения.Добавить(ВыборкаНазначения.Назначение);	
	КонецЦикла;
	
	Если Назначения.Количество() = 0 Тогда		
		Назначения = Справочники.Назначения.ПустаяСсылка();		
	КонецЕсли;	

	Запрос.УстановитьПараметр("Назначение", Назначения);	
	
	ЗапросСклада = Новый Запрос;
	ЗапросСклада.Текст = 
	"ВЫБРАТЬ
	|	ИС_Ozon_Склады.Ссылка КАК Ссылка,
	|	ИС_Ozon_Склады.is_kgt КАК СГТ,
	|	ИС_Ozon_Склады.ВыгружатьОстаткиИзГруппыСкладов КАК ВыгружатьОстаткиИзГруппыСкладов,
	|	ИС_Ozon_Склады.Склад КАК Склад,
	|	ИС_Ozon_Склады.ОбщаяГруппаСкладов КАК ОбщаяГруппаСкладов,
	|	ИС_Ozon_СкладыГруппаСкладов.Склад КАК СкладГруппы
	|ИЗ
	|	Справочник.ИС_Ozon_Склады КАК ИС_Ozon_Склады
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ИС_Ozon_Склады.ГруппаСкладов КАК ИС_Ozon_СкладыГруппаСкладов
	|		ПО (ИС_Ozon_Склады.Ссылка = ИС_Ozon_СкладыГруппаСкладов.Ссылка)
	|ГДЕ
	|	ИС_Ozon_Склады.Ссылка = &Ссылка
	|ИТОГИ ПО
	|	Ссылка";
	
	ЗапросСклада.УстановитьПараметр("Ссылка", Склад);
	
	РезультатЗапроса = ЗапросСклада.Выполнить();
	
	ВыборкаСклад = РезультатЗапроса.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	Пока ВыборкаСклад.Следующий() Цикл
		
		СГТ = ВыборкаСклад.СГТ;      
		
		Если ВыборкаСклад.ВыгружатьОстаткиИзГруппыСкладов Тогда 
			
			ПараметрСклад = Новый Массив;
			
			ВыборкаГруппаСкладов = ВыборкаСклад.Выбрать();
			
			Пока ВыборкаГруппаСкладов.Следующий() Цикл
				
				Если ВыборкаГруппаСкладов.СкладГруппы <> Null Тогда		
					ПараметрСклад.Добавить(ВыборкаГруппаСкладов.СкладГруппы); 
				КонецЕсли;
				
			КонецЦикла;        
			
		ИначеЕсли ЗначениеЗаполнено(ВыборкаСклад.ОбщаяГруппаСкладов) Тогда
			
			Заменитель = "";
			ПараметрСклад = ВыборкаСклад.ОбщаяГруппаСкладов;
			
		Иначе			
			ПараметрСклад = ВыборкаСклад.Склад;
		КонецЕсли;  
		
	КонецЦикла;
	
	Запрос.УстановитьПараметр("СГТ", СГТ); 
	
	Если ЗначениеЗаполнено(Заменитель) Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, Заменитель, "");
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(ПараметрСклад) Тогда	
		Текст = СтрШаблон("Не заполнено сопоставление склада %1 (%2)", Склад, Профиль);
		ИС_MP_Сервер.ЗаписатьВЖРИСообщитьПользователю(Событие, Текст); 
	КонецЕсли;
	
	Запрос.УстановитьПараметр("Склад1С", ПараметрСклад);
		
КонецПроцедуры //- ИнфоСофт Мурсалимов Д.Р. 04.03.24 УА #67173

//+ ИнфоСофт Мурсалимов Д.Р. 12.05.24 УА #66901
Процедура ВыгрузитьЦены(Профиль, ТаблицаВыгрузки = Неопределено) Экспорт
	
	Событие = ПолучитьИмяСобытия("ВыгрузитьЦены");
	
	НастройкиСоединения = ПолучитьНастройкиСоединенияПрофиля(Профиль);
	ПараметрыЗапроса = ПроверитьИЗаполнитьПараметрыЗапроса(НастройкиСоединения);
	
	ПеречислениеМП = Перечисления.ИС_МП_Маркетплейсы.Озон;
	
	МассивПараметров = ПолучитьСписокПараметровЦен();
	
	Результат = ИС_MP_Сервер.ПолучитьЗначениеНастроек(Профиль, Перечисления.ИС_МП_Маркетплейсы.Озон, МассивПараметров);
	
	СтруктураЦен = ПолучитьСтруктуруПараметровЦен();
	
	ЗаполнитьЗначенияСвойств(СтруктураЦен, Результат);
	
	РежимОкругленияЦен = СтруктураЦен.РежимОкругленияЦен;
	ИспользоватьПоследниеЦены = СтруктураЦен.ИспользоватьПоследниеЦены;
	//+ ИнфоСофт Стояк Ю.К. 26.11.2024 УА #87103
	АвтоприменениеАкций = ?(ЗначениеЗаполнено(СтруктураЦен.АвтоприменениеАкций), СтруктураЦен.АвтоприменениеАкций, "UNKNOWN");
	АвтоприменениеСтратегийЦены = ?(ЗначениеЗаполнено(СтруктураЦен.АвтоприменениеСтратегийЦены), СтруктураЦен.АвтоприменениеСтратегийЦены, "UNKNOWN");
	//- ИнфоСофт Стояк Ю.К. 26.11.2024 УА #87103
	
	Если ТаблицаВыгрузки = Неопределено Тогда
				
		Запрос = Новый Запрос;
		Запрос.Текст = ПолучитьТекстЗапросаЦен(); 
		
		УстановитьПараметрыЗапросаЦен(Запрос, Профиль);                                                       
		
		РезультатЗапроса = Запрос.Выполнить();
		
		Если РезультатЗапроса.Пустой() Тогда
			Возврат;
		КонецЕсли;
		
		Выборка = РезультатЗапроса.Выбрать();
		
		ТаблицаВыгрузки = Новый ТаблицаЗначений;	
		
		ИС_МП_УправлениеЦенами.ЗаполнитьКолонкиТаблицыВыгрузкиЦен(ПеречислениеМП, ТаблицаВыгрузки);
		
		МассивПолей = ИС_МП_УправлениеЦенами.ПолучитьПоляДляВыгрузки(ПеречислениеМП);
		
		Пока Выборка.Следующий() Цикл
		
			Если Не Выборка.ЕстьСопоставление 
				И Не Выборка.ЕстьРучнаяЦена 
				И Не Выборка.ЕстьРучнаяЦенаСоСкидкой 
				И Не Выборка.ЕстьРучнаяЦенаМинимальная Тогда
					Продолжить;
			КонецЕсли;
			
			НоваяСтрока = ТаблицаВыгрузки.Добавить();
		
			Для Каждого Элемент Из МассивПолей Цикл
				НоваяСтрока[Элемент] = Выборка[Элемент];
			КонецЦикла;
			
			ЭтоНабор = Выборка.ЭтоНабор;
			
			Если Выборка.ЕстьРучнаяЦена Тогда
				Цена = Выборка.РучнаяЦена;
			Иначе  
				Цена = Выборка.Цена;	
			КонецЕсли;
			
			Цена = Окр(Цена, 0, РежимОкругленияЦен);
			
			НоваяСтрока.Цена = Цена;
			
			Если Выборка.ЕстьРучнаяЦенаСоСкидкой Тогда
				ЦенаСоСкидкой = Выборка.РучнаяЦенаСоСкидкой;
			Иначе
				ЦенаСоСкидкой = Выборка.ЦенаСоСкидкой;
			КонецЕсли;
			
			ЦенаСоСкидкой = Окр(ЦенаСоСкидкой, 0, РежимОкругленияЦен);
			
			НоваяСтрока.ЦенаСоСкидкой = ЦенаСоСкидкой;
			
			Если Выборка.ЕстьРучнаяЦенаМинимальная Тогда
				ЦенаМинимальная = Выборка.РучнаяЦенаМинимальная;
			Иначе  
				ЦенаМинимальная = Выборка.ЦенаМинимальная;
			КонецЕсли;
				
			ЦенаМинимальная = Окр(ЦенаМинимальная, 0, РежимОкругленияЦен);
			
			НоваяСтрока.ЦенаМинимальная = ЦенаМинимальная;
			
			Если НоваяСтрока.Цена = 0 И НоваяСтрока.ЦенаСоСкидкой = 0 И НоваяСтрока.ЦенаМинимальная = 0 Тогда 
				ТаблицаВыгрузки.Удалить(НоваяСтрока);
			КонецЕсли;
			
			Если Не ИспользоватьПоследниеЦены Тогда
				Продолжить;
			КонецЕсли;
			
			Если Не Выборка.ЕстьРучнаяЦена И Не Выборка.ЕстьРучнаяЦенаСоСкидкой И Не Выборка.ЕстьРучнаяЦенаМинимальная Тогда
			
				Если Не ИС_МП_УправлениеЦенами.ПроверитьПоследниеЦены(ПеречислениеМП, Выборка, НоваяСтрока) Тогда				
					ТаблицаВыгрузки.Удалить(НоваяСтрока);
				КонецЕсли; 
				
			КонецЕсли;
			
		КонецЦикла;
				
	КонецЕсли;
	
	Если ТаблицаВыгрузки.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	data = Новый Массив;
	
	//+ ИнфоСофт Заварин К.В. 25.12.24 УА #90044 
	НевыгруженныйМассив = Новый Массив;
	//- ИнфоСофт Заварин К.В. 25.12.24 УА #90044
	
	Для Каждого Строка Из ТаблицаВыгрузки Цикл
		
		//+ ИнфоСофт Заварин К.В. 25.12.24 УА #90044
		Если Строка.ЦенаМинимальная > Строка.ЦенаСоСкидкой Тогда 
			НевыгруженныйМассив.Добавить(Строка.OfferId);
			Продолжить;                              
		КонецЕсли;
		//- ИнфоСофт Заварин К.В. 25.12.24 УА #90044
		
		dataStructure = Новый Структура;
		dataStructure.Вставить("product_id", 			Строка.ProductId);
		dataStructure.Вставить("offer_id", 				Строка.OfferId);
		dataStructure.Вставить("old_price", 			Формат(Строка.Цена, "ЧРД=.; ЧН=0; ЧГ=0"));	
		dataStructure.Вставить("price", 				Формат(Строка.ЦенаСоСкидкой, "ЧРД=.; ЧН=0; ЧГ=0"));
		
		Если ЗначениеЗаполнено(Строка.ЦенаМинимальная) Тогда
			dataStructure.Вставить("min_price", 		Формат(Строка.ЦенаМинимальная, "ЧРД=.; ЧН=0; ЧГ=0"));
		КонецЕсли;
		
		//+ ИнфоСофт Стояк Ю.К. 26.11.2024 УА #87103		
		//dataStructure.Вставить("auto_action_enabled", 	"UNKNOWN");
		dataStructure.Вставить("auto_action_enabled", 		АвтоприменениеАкций);
		dataStructure.Вставить("price_strategy_enabled", 	АвтоприменениеСтратегийЦены);
		//- ИнфоСофт Стояк Ю.К. 26.11.2024 УА #87103
		
		data.Добавить(dataStructure);		

	КонецЦикла;
	
	//+ ИнфоСофт Заварин К.В. 25.12.24 УА #90044
	Если Не НевыгруженныйМассив.Количество() = 0 Тогда
		ВыходнаяСтрокаОшибки = СтрСоединить(НевыгруженныйМассив, "; ");
		Текст = "Минимальная цена должна быть меньше или равна чем цена со скидкой по артикулам: " + ВыходнаяСтрокаОшибки;			
		ИС_MP_Сервер.ЗаписатьВЖРИСообщитьПользователю(Событие, Текст);	
	КонецЕсли;
	//- ИнфоСофт Заварин К.В. 25.12.24 УА #90044
	
	//	МассивЦенСОшибками = Новый Массив
	
	РазбитыйМассив = ИС_MP_Сервер.РазбитьМассивПоNЭлементов(data, 1000);
	
	БылиОшибкиВыгрузки = Ложь;
	
	Для Каждого Элемент Из РазбитыйМассив Цикл
	
		Результат = ИС_Ozon_API.ВыгрузитьЦеныOzon(Профиль, ПараметрыЗапроса, Элемент);	 
	
		Если ЗначениеЗаполнено(Результат) Тогда
			
			//Для Каждого ОтветЦенаТовара Из Результат Цикл
			//	
			//	Если Не ОтветЦенаТовара.updated Тогда
			//		
			//		Если ОтветЦенаТовара.errors.Количество() > 0 Тогда
			//			
			//			ОтветОбОшибке = Новый Структура();
			//			
			//			ОтветОбОшибке.Вставить("product_id"		, ОтветЦенаТовара.product_id);
			//			ОтветОбОшибке.Вставить("offer_id"		, ОтветЦенаТовара.offer_id);
			//			ОтветОбОшибке.Вставить("error_code"		, ОтветЦенаТовара.errors[0].code);
			//			ОтветОбОшибке.Вставить("error_message"	, ОтветЦенаТовара.errors[0].message);
			//			
			//			МассивЦенСОшибками.Добавить(ОтветОбОшибке);
			//			
			//		КонецЕсли;
			//		
			//	КонецЕсли;			
			//	
			//КонецЦикла; 
			//
			//Возврат МассивЦенСОшибками;
			
		Иначе
			БылиОшибкиВыгрузки = Истина;	
			Текст = "Не удалось обновить цены товаров";			
			ИС_MP_Сервер.ЗаписатьВЖРИСообщитьПользователю(Событие, Текст);
		КонецЕсли;
	
	КонецЦикла;
	
	Если Не БылиОшибкиВыгрузки И ИспользоватьПоследниеЦены Тогда 
		
		Для Каждого Строка Из ТаблицаВыгрузки Цикл	
			
			ИС_МП_УправлениеЦенами.ЗаписатьПоследнююВыгруженнуюЦену(Профиль, 
			Перечисления.ИС_МП_Маркетплейсы.Озон, Строка.НоменклатураOzon, Строка.Цена, Перечисления.ИС_МП_ВидыЦенМаркетплейса.ВидЦены);
			
			ИС_МП_УправлениеЦенами.ЗаписатьПоследнююВыгруженнуюЦену(Профиль, 
			Перечисления.ИС_МП_Маркетплейсы.Озон, Строка.НоменклатураOzon, Строка.ЦенаСоСкидкой, Перечисления.ИС_МП_ВидыЦенМаркетплейса.ВидЦеныСоСкидкой);                
			
			ИС_МП_УправлениеЦенами.ЗаписатьПоследнююВыгруженнуюЦену(Профиль, 
