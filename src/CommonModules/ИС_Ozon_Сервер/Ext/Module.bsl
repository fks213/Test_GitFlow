			//				
			//				ОтветОбОшибке = Новый Структура();
			//				
			//				ОтветОбОшибке.Вставить("product_id", ОтветОстатокПоТовару.product_id);
			//				ОтветОбОшибке.Вставить("offer_id", ОтветОстатокПоТовару.offer_id);
			//				ОтветОбОшибке.Вставить("error_code", ОтветОстатокПоТовару.errors[0].code);
			//				ОтветОбОшибке.Вставить("error_message", ОтветОстатокПоТовару.errors[0].message);
			//				
			//				МассивОстатковСОшибками.Добавить(ОтветОбОшибке);
			//				
			//			КонецЕсли;
			//			
			//		КонецЕсли;
			//		
			//	КонецЕсли;				
			//	
			//КонецЦикла;
			
		Иначе   
			БылиОшибкиВыгрузки = Истина;
			Текст = "Не удалось обновить остатки товаров";			
			ИС_MP_Сервер.ЗаписатьВЖРИСообщитьПользователю(Событие, Текст);			
		КонецЕсли; 		
		
	КонецЦикла;
	
	Если Не ИспользоватьПоследниеОстатки Тогда
