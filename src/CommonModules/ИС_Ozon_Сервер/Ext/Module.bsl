#Область Склады 

//+ ИнфоСофт Ивонин К.А. 29.03.24 УА #71892
Процедура ПолучитьСкладыOzon(Профиль) Экспорт  
	
	Событие = ПолучитьИмяСобытия("ПолучитьСкладыOzon");
	
	НастройкиСоединения = ПолучитьНастройкиСоединенияПрофиля(Профиль);
	ПараметрыЗапроса = ПроверитьИЗаполнитьПараметрыЗапроса(НастройкиСоединения);
					
	Склады = ИС_Ozon_API.ЗагрузитьСкладыOzon(Профиль, ПараметрыЗапроса);
	
	Если Склады = Неопределено Тогда
		Возврат;
	КонецЕсли;		
		
	Для Каждого Склад Из Склады Цикл
		
		НайденныйСклад = Справочники.ИС_Ozon_Склады.НайтиПоРеквизиту("id", Склад.warehouse_id);
		
		Если НайденныйСклад.Пустая() Тогда		
			ОбъектСклад = Справочники.ИС_Ozon_Склады.СоздатьЭлемент();
		Иначе
			ОбъектСклад = НайденныйСклад.ПолучитьОбъект();
		КонецЕсли;
	    
	    ЗаполнитьЗначенияСвойств(ОбъектСклад, Склад);
	    
		ОбъектСклад.Профиль = Профиль;	
		ОбъектСклад.Наименование = Склад.name;
		ОбъектСклад.id 			 = Склад.warehouse_id;
		ОбъектСклад.ЗагруженИзЛК = Истина;
		ОбъектСклад.status = ИС_MP_Сервер.ПолучитьПеречислениеПоЗначению(Перечисления.ИС_Ozon_СтатусыСкладов, Склад.status);
		
		Если ОбъектСклад.status = Перечисления.ИС_Ozon_СтатусыСкладов.disabled Тогда
			ОбъектСклад.ПометкаУдаления = Истина;
		КонецЕсли;
		
		//+ ИнфоСофт Заварин К.В. 28.01.25 УА #82060
		ОбъектСклад.is_kgt 	 = Склад.is_kgt;
		//- ИнфоСофт Заварин К.В. 28.01.25 УА #82060
		
		Попытка	
			ОбъектСклад.Записать();	
		Исключение
			ИС_MP_Сервер.ЗаписатьВЖРИСообщитьПользователю(Событие, ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		КонецПопытки;
		
	КонецЦикла;   
			
КонецПроцедуры //- ИнфоСофт Ивонин К.А. 29.03.24 УА #71892

