	Если ТаблицаСоответствийЗначений.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
				   |	" + СтруктураПараметров.СписокРеквизитов + Символы.ПС + "
