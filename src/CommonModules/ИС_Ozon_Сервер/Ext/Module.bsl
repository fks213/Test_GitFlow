		СоответствиеРеквизитов.Вставить(СокрЛП(реквизит.Синоним), реквизит);
		МассивСинонимов.Добавить(СокрЛП(реквизит.Синоним));
		СписокРеквизитов = СписокРеквизитов + реквизит.Имя + ", ";
		МассивТипов.Добавить(реквизит.тип.типы()[0]);
	КонецЦикла;

	СтандартныеРеквизитыНоменклатуры = Метаданные.Справочники["Номенклатура"].СтандартныеРеквизиты;
	Для Каждого реквизит Из СтандартныеРеквизитыНоменклатуры Цикл
		СоответствиеРеквизитов.Вставить(реквизит.Имя, реквизит);
		МассивСинонимов.Добавить(реквизит.Имя);
		СписокРеквизитов = СписокРеквизитов + реквизит.Имя + ", ";
