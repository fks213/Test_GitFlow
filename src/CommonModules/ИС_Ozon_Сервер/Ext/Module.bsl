#Область ЦеныИОстатки 

//+ ИнфоСофт Мурсалимов Д.Р. 04.02.25 УА #92578
Функция ПолучитьИнформациюОЦенах(Профиль) Экспорт
	
	НастройкиСоединения = ПолучитьНастройкиСоединенияПрофиля(Профиль);
	ПараметрыЗапроса 	= ПроверитьИЗаполнитьПараметрыЗапроса(НастройкиСоединения);
		
	СтруктураТела = Новый Структура; 
	
	Фильтр = Новый Структура;
	Фильтр.Вставить("visibility", "ALL");
	
	СтруктураТела.Вставить("filter", 	Фильтр);   	
	СтруктураТела.Вставить("cursor", 	"");
	СтруктураТела.Вставить("limit", 	1);   		

	Результат = ИС_Ozon_API.ПолучитьИнформациюОЦенах(Профиль, ПараметрыЗапроса, СтруктураТела);
	
	Если Результат = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
					
	КоличествоТоваров 				= Результат.total; 			
	ПовторятьПостраничныйЗапросЦен 	= КоличествоТоваров > 0;
	ТекущаяСтраница 				= 1; 
	Лимит 							= 1000;
	
	ТаблицаЦен = Новый ТаблицаЗначений;  
	
	КвалификаторыЧисла 	= Новый КвалификаторыЧисла(50, 2, ДопустимыйЗнак.Неотрицательный);
	КвалификаторыСтроки = Новый КвалификаторыСтроки(80);
	
	ТаблицаЦен.Колонки.Добавить("nmId", 		Новый ОписаниеТипов("Строка", КвалификаторыСтроки));
	ТаблицаЦен.Колонки.Добавить("product_id", 	Новый ОписаниеТипов("Строка", КвалификаторыСтроки));
	ТаблицаЦен.Колонки.Добавить("old_price", 	Новый ОписаниеТипов("Число", КвалификаторыЧисла));
	ТаблицаЦен.Колонки.Добавить("min_price", 	Новый ОписаниеТипов("Число", КвалификаторыЧисла));
	ТаблицаЦен.Колонки.Добавить("Цена", 		Новый ОписаниеТипов("Число", КвалификаторыЧисла));
	
	СтруктураТела.limit = Лимит; 
	
	Пока ПовторятьПостраничныйЗапросЦен Цикл
		
		Результат = ИС_Ozon_API.ПолучитьИнформациюОЦенах(Профиль, ПараметрыЗапроса, СтруктураТела);
	
		Если Результат = Неопределено Тогда
			Возврат Неопределено;
		КонецЕсли;   						               

		Предметы = Результат.items;
		
		Для Каждого Предмет из Предметы Цикл      
			
			НоваяСтрока = ТаблицаЦен.Добавить();
			
			НоваяСтрока.nmId 		= Предмет.offer_id;
			//+ ИнфоСофт Стояк Ю.К. 10.03.2025 УА #95750			
			//НоваяСтрока.product_id 	= Предмет.product_id;	
			НоваяСтрока.product_id 	= Формат(Предмет.product_id, "ЧГ=0");	
			//- ИнфоСофт Стояк Ю.К. 10.03.2025 УА #95750
			
			Цены 					= Предмет.price;
			
			НоваяСтрока.Цена 		= Цены.price;
			НоваяСтрока.old_price 	= Цены.old_price;
			НоваяСтрока.min_price 	= Цены.min_price;										     
			
		КонецЦикла;   
				
		ПовторятьПостраничныйЗапросЦен 	= Лимит * ТекущаяСтраница <= КоличествоТоваров;
		ТекущаяСтраница 				= ТекущаяСтраница + 1;
		
	КонецЦикла;
	
	Возврат ТаблицаЦен;
	
КонецФункции //- ИнфоСофт Мурсалимов Д.Р. 04.02.25 УА #92578

//+ ИнфоСофт Стояк Ю.К. 20.01.2023 УА #52524
Функция ПолучитьИнформациюОбОстатках(Профиль) Экспорт
	
	НастройкиСоединения = ПолучитьНастройкиСоединенияПрофиля(Профиль);
	ПараметрыЗапроса = ПроверитьИЗаполнитьПараметрыЗапроса(НастройкиСоединения);
	
	СтруктураТела = Новый Структура; 
	Фильтр = Новый Структура;
	Фильтр.Вставить("visibility", "ALL");
	СтруктураТела.Вставить("filter", Фильтр);
	//+ ИнфоСофт Стояк Ю.К. 26.01.2025 УА #91698	
	//СтруктураТела.Вставить("last_id", "");   	
	СтруктураТела.Вставить("cursor", "");   	
	//- ИнфоСофт Стояк Ю.К. 26.01.2025 УА #91698
	СтруктураТела.Вставить("limit", 1);
	
	Результат = ИС_Ozon_API.ПолучитьИнформациюОбОстатках(Профиль, ПараметрыЗапроса, СтруктураТела);
	
	Если Результат = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
			
	КоличествоТоваров = Результат.total; 			
	
	ПовторятьПостраничныйЗапросОстатков = КоличествоТоваров > 0;
	//+ ИнфоСофт Стояк Ю.К. 26.01.2025 УА #91698	
	//last_id = "";                               
	cursor = "";                               
	//- ИнфоСофт Стояк Ю.К. 26.01.2025 УА #91698
	ТекущаяСтраница = 1; 
	Лимит = 1000; 
	
	КвалификаторыЧисла = Новый КвалификаторыЧисла(50, 2, ДопустимыйЗнак.Неотрицательный);
	//+ ИнфоСофт Стояк Ю.К. 15.03.2024 УА #72261	
	//КвалификаторыСтроки = Новый КвалификаторыСтроки(20);
	КвалификаторыСтроки = Новый КвалификаторыСтроки(80);
	//- ИнфоСофт Стояк Ю.К. 15.03.2024 УА #72261
	
	ТаблицаОстатковFBS = Новый ТаблицаЗначений;
	ТаблицаОстатковFBS.Колонки.Добавить("nmId", Новый ОписаниеТипов("Строка", КвалификаторыСтроки));
	ТаблицаОстатковFBS.Колонки.Добавить("НаСкладе", Новый ОписаниеТипов("Число", КвалификаторыЧисла));
	ТаблицаОстатковFBS.Колонки.Добавить("ВРезерве", Новый ОписаниеТипов("Число", КвалификаторыЧисла));
	ТаблицаОстатковFBS.Колонки.Добавить("ТипСклада", Новый ОписаниеТипов("Строка", КвалификаторыСтроки));
	
	ТаблицаОстатковFBO = Новый ТаблицаЗначений;
	ТаблицаОстатковFBO.Колонки.Добавить("nmId", Новый ОписаниеТипов("Строка", КвалификаторыСтроки));
	ТаблицаОстатковFBO.Колонки.Добавить("НаСкладе", Новый ОписаниеТипов("Число", КвалификаторыЧисла));
	ТаблицаОстатковFBO.Колонки.Добавить("ВРезерве", Новый ОписаниеТипов("Число", КвалификаторыЧисла));
	ТаблицаОстатковFBO.Колонки.Добавить("ТипСклада", Новый ОписаниеТипов("Строка", КвалификаторыСтроки));
		
	СтруктураТела.limit = Лимит;                
	
	Пока ПовторятьПостраничныйЗапросОстатков Цикл 
		
		//+ ИнфоСофт Стояк Ю.К. 26.01.2025 УА #91698		
		//СтруктураТела.last_id = last_id;            
		СтруктураТела.cursor = cursor;            
		//- ИнфоСофт Стояк Ю.К. 26.01.2025 УА #91698
		
		Результат = ИС_Ozon_API.ПолучитьИнформациюОбОстатках(Профиль, ПараметрыЗапроса, СтруктураТела);
	
		Если Результат = Неопределено Тогда
			Возврат Неопределено;
		КонецЕсли;
			
		//+ ИнфоСофт Стояк Ю.К. 26.01.2025 УА #91698		
		//last_id = Результат.last_id;	            
		cursor = Результат.cursor;	            
		//- ИнфоСофт Стояк Ю.К. 26.01.2025 УА #91698
		Предметы = Результат.items;
		
		Для Каждого Предмет Из Предметы Цикл      
			
			Для Каждого Остаток Из Предмет.stocks Цикл
				
				Если Остаток.type = "fbo" Тогда
					
					НСтр = ТаблицаОстатковFBO.Добавить();
					НСтр.nmId = Предмет.offer_id;     													
					НСтр.ТипСклада = Остаток.type;
					НСтр.НаСкладе = Остаток.present;
					НСтр.ВРезерве = Остаток.reserved;															        
					
				ИначеЕсли Остаток.type = "fbs" Тогда
					
					НСтр = ТаблицаОстатковFBS.Добавить();
					НСтр.nmId = Предмет.offer_id;     													
					НСтр.ТипСклада = Остаток.type;
					НСтр.НаСкладе = Остаток.present;
					НСтр.ВРезерве = Остаток.reserved;         
					
				КонецЕсли;
				
			КонецЦикла;                                                   													      
			
		КонецЦикла; 
					
		ПовторятьПостраничныйЗапросОстатков = Лимит * ТекущаяСтраница <= КоличествоТоваров;
		ТекущаяСтраница = ТекущаяСтраница + 1;
		
	КонецЦикла;
	
	Возврат Новый Структура("FBS,FBO", ТаблицаОстатковFBS, ТаблицаОстатковFBO);
	
КонецФункции //- ИнфоСофт Стояк Ю.К. 20.01.2023 УА #52524

//+ ИнфоСофт Стояк Ю.К. 13.10.2023 УА #62194
Функция ПолучитьОстаткиПоСкладам(Профиль) Экспорт
	
	НастройкиСоединения = ПолучитьНастройкиСоединенияПрофиля(Профиль);
	ПараметрыЗапроса = ПроверитьИЗаполнитьПараметрыЗапроса(НастройкиСоединения);
	
	МассивSKU = Новый Массив;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ИС_Ozon_Номенклатура.sku КАК sku
	|ИЗ
	|	Справочник.ИС_Ozon_Номенклатура КАК ИС_Ozon_Номенклатура
	|ГДЕ
	|	ИС_Ozon_Номенклатура.Профиль = &Профиль
	|	И НЕ ИС_Ozon_Номенклатура.sku = 0";
	
	Запрос.УстановитьПараметр("Профиль", Профиль);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		МассивSKU.Добавить(СтрЗаменить(Строка(ВыборкаДетальныеЗаписи.sku), Символы.НПП, ""));
	КонецЦикла;
	
	ТаблицаОстатков = Новый ТаблицаЗначений;  
	
	КвалификаторыЧисла = Новый КвалификаторыЧисла(20, 2, ДопустимыйЗнак.Неотрицательный);
	КвалификаторыСтроки = Новый КвалификаторыСтроки(80);
	
	ТаблицаОстатков.Колонки.Добавить("product_id", Новый ОписаниеТипов("Строка", КвалификаторыСтроки));
	ТаблицаОстатков.Колонки.Добавить("Склад", Новый ОписаниеТипов("Строка", КвалификаторыСтроки));
	ТаблицаОстатков.Колонки.Добавить("stock", Новый ОписаниеТипов("Число", КвалификаторыЧисла));	
	
	РазбитыйМассив = ИС_MP_Сервер.РазбитьМассивПоNЭлементов(МассивSKU, 500);
	
	Для Каждого Элемент Из РазбитыйМассив Цикл	
		
		Результат = ИС_Ozon_API.ПолучитьОстаткиFBS(Профиль, ПараметрыЗапроса, Элемент);
		
		Если Результат = Неопределено Тогда	
			Продолжить;	
		КонецЕсли;
		
		Для Каждого Элемент Из Результат Цикл
			
			Если Не Элемент.Свойство("warehouse_name") Тогда
				Продолжить;
			КонецЕсли;
			
			НоваяСтрока = ТаблицаОстатков.Добавить();							
			НоваяСтрока.product_id = Элемент.product_id;	
			НоваяСтрока.stock = Элемент.present;
			НоваяСтрока.Склад = Элемент.warehouse_name;	 
			
		КонецЦикла; 		
		
	КонецЦикла; 
		
	Возврат ТаблицаОстатков;
	
КонецФункции //- ИнфоСофт Стояк Ю.К. 13.10.2023 УА #62194

