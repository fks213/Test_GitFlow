Процедура ВыполнитьАлгоритмПоОсновнойСхемеFBO(Профиль) 
	
	Событие = ПолучитьИмяСобытия("ВыполнитьАлгоритмПоОсновнойСхемеFBO");
	
	Настройки = ПолучитьНастройкиФункциональностиСборочныхЗвданий(Профиль);
		
	Попытка
		Остатки = ПолучитьИнформациюОбОстатках(Профиль);
		ОстаткиFBO = Остатки.FBO;
	Исключение
		Текст = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
		ЗаписьЖурналаРегистрации(Событие, УровеньЖурналаРегистрации.Ошибка, , , Текст);
		Возврат;
	КонецПопытки;
	
	Если ОстаткиFBO.Количество() = 0 Тогда
		Текст = "Ozon не предоставляет информацию по остаткам. Проверьте корректность токена статистики. Если токен корректный, необходимо обратиться в техническую поддержку Wildberries для уточнения сроков исправления неисправностей.";
		ЗаписьЖурналаРегистрации(Событие, УровеньЖурналаРегистрации.Ошибка, , , Текст);
		Возврат;	
	КонецЕсли;
	
	МассивId = Новый Массив;
	
	Для Каждого Элемент Из ОстаткиFBO Цикл
		Если Элемент.НаСкладе > 0 Тогда
			МассивId.Добавить(Элемент.nmId);	
		КонецЕсли;	
	КонецЦикла;
	
	//Добавим записи ручных остатков по тем позициям, которых нет на fbo
	ЗапросСклады = Новый Запрос;
	ЗапросСклады.Текст =
	"ВЫБРАТЬ
	|	ИС_Ozon_Склады.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.ИС_Ozon_Склады КАК ИС_Ozon_Склады
	|ГДЕ
	|	ИС_Ozon_Склады.Профиль = &Профиль
	|	И ИС_Ozon_Склады.ЗагруженИзЛК
	|	И ИС_Ozon_Склады.ИспользоватьСхемуFBO";	
	
	ЗапросСклады.УстановитьПараметр("Профиль", Профиль);
	РезультатЗапросаСклады = ЗапросСклады.Выполнить();  
	
	Если РезультатЗапросаСклады.Пустой() Тогда
		Текст = "В информационной базе не найден ни один склад fbs с включенной опцией.";
		ЗаписьЖурналаРегистрации("ИС.Ozon.ВыполнениеАлгоритмаПоОсновнойСхемеFbo", УровеньЖурналаРегистрации.Ошибка, , , Текст);
		Возврат;	
	КонецЕсли;
	
	ВыборкаСклады = РезультатЗапросаСклады.Выбрать();
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ИС_Ozon_Номенклатура.Ссылка КАК Номенклатура
	|ИЗ
	|	Справочник.ИС_Ozon_Номенклатура КАК ИС_Ozon_Номенклатура
	|ГДЕ
	|	ИС_Ozon_Номенклатура.Профиль = &Профиль
	|	И ИС_Ozon_Номенклатура.offer_id В(&offer_id)";
	
	Запрос.УстановитьПараметр("Профиль", Профиль);
	Запрос.УстановитьПараметр("offer_id", МассивId);
	
	РезультатЗапроса = Запрос.Выполнить();
		
	ТаблицаВыгрузки = РезультатЗапроса.Выгрузить();	
	
	Пока ВыборкаСклады.Следующий() Цикл
		
		//Выполним очистку всех записей регистра ручных остатков
		
		//+ ИнфоСофт Заварин К.В. 01.08.24 УА #80754
		//НаборЗаписей = РегистрыСведений.ИС_Ozon_Остатки.СоздатьНаборЗаписей();
		//НаборЗаписей.Отбор.СкладOzon.Установить(ВыборкаСклады.Ссылка);
		//НаборЗаписей.Записать();
		
		НаборЗаписей = РегистрыСведений.ИС_MP_РучныеОстатки.СоздатьНаборЗаписей();
		НаборЗаписей.Отбор.Профиль.Установить(Профиль);
		НаборЗаписей.Отбор.Маркетплейс.Установить(Перечисления.ИС_МП_Маркетплейсы.Озон);
		НаборЗаписей.Отбор.Склад.Установить(ВыборкаСклады.Ссылка);
		НаборЗаписей.Записать();
	    //- ИнфоСофт Заварин К.В. 01.08.24 УА #80754
		
		Для Каждого Строка Из ТаблицаВыгрузки Цикл
			
			//+ ИнфоСофт Заварин К.В. 01.08.24 УА #80754
			ИС_МП_УправлениеОстатками.ЗаписатьРучнойОстаток(Профиль, Перечисления.ИС_МП_Маркетплейсы.Озон, ВыборкаСклады.Ссылка, Строка.Номенклатура, 0);
			
			//НаборЗаписейОстатоков = РегистрыСведений.ИС_Ozon_Остатки.СоздатьНаборЗаписей();
			//НаборЗаписейОстатоков.Отбор.Период.Установить(ТекущаяДатаСеанса());			
			//НоваяЗапись = НаборЗаписейОстатоков.Добавить();	
			//НоваяЗапись.НоменклатураOzon = Строка.Номенклатура;
			//НоваяЗапись.СкладOzon = ВыборкаСклады.Ссылка; 
			//НоваяЗапись.Остаток = 0;
			//НоваяЗапись.Период = ТекущаяДатаСеанса(); 
			//НаборЗаписейОстатоков.Записать(Ложь);
			//- ИнфоСофт Заварин К.В. 01.08.24 УА #80754 
			
		КонецЦикла;
		
	КонецЦикла;
	
КонецПроцедуры //- ИнфоСофт Сумин Д.В. 23.05.2023 УА #58355

