//+ ИнфоСофт Стояк Ю.К. 12.05.2023 УА #54628
Функция СоздатьНоменклатуру(ТаблицаТоваров, СтруктураСвойств) Экспорт

	УстановитьПривилегированныйРежим(Истина);

	Для Каждого товар Из ТаблицаТоваров Цикл
		
		ЗаписатьСопоставление = Истина;
		КодНоменклатуры = Формат(товар.product_id, "ЧГ=0");

		СозданнаяНоменклатура = Справочники["Номенклатура"].НайтиПоКоду(КодНоменклатуры);
		Если ЗначениеЗаполнено(СозданнаяНоменклатура) Тогда
			Номенклатура = СозданнаяНоменклатура.ПолучитьОбъект();
			ЗаписатьСопоставление = Ложь;
		Иначе
			Номенклатура = Справочники["Номенклатура"].СоздатьЭлемент();
		КонецЕсли;

		Номенклатура.ПометкаУдаления	= Ложь;
		Номенклатура.Родитель			= СтруктураСвойств.ГруппаНоменклатуры;
		Номенклатура.Наименование 		= товар.Наименование;
		Номенклатура.НаименованиеПолное = товар.Наименование;
		Номенклатура.Артикул 			= товар.Артикул;
		Номенклатура.Код 		 		= КодНоменклатуры;
		Номенклатура.Качество 			= ПредопределенноеЗначение("Перечисление.ГрадацииКачества.Новый");
		Номенклатура.ВидНоменклатуры 	= СтруктураСвойств.ВидНоменклатуры;  		

		Справочники["Номенклатура"].ЗаполнитьРеквизитыПоВидуНоменклатуры(Номенклатура);
		Номенклатура.СтавкаНДС = СтруктураСвойств.СтавкаНДС;
		
		СоздатьШтрихкод = Ложь;
		
		
		Попытка

			Номенклатура.Записать();
			Упаковка = УпаковкаНоменклатурыПоУмолчанию(Номенклатура.Ссылка);
			Если ЗначениеЗаполнено(товар.Штрихкод) Тогда
				СоздатьШтрихкод = Истина;
			КонецЕсли;			
			товар.Номенклатура = Номенклатура.Ссылка;
			
		Исключение
			
			ЗаписатьСопоставление = Ложь;
			ИнформацияОбОшибке = ИнформацияОбОшибке();
			КомментарийКраткий = СтрШаблон(
				"Не удалось записать номенклатуру для товара: %1 артикул: %2 по причине: %3", товар.Наименование,
				товар.Артикул, КраткоеПредставлениеОшибки(ИнформацияОбОшибке));
			КомментарийПодробный = СтрШаблон(
				"Не удалось записать номенклатуру для товара: %1 артикул: %2 по причине: %3", товар.Наименование,
				товар.Артикул, ПодробноеПредставлениеОшибки(ИнформацияОбОшибке));
			ИС_MP_Сервер.ЗаписатьВЖРИСообщитьПользователю("СозданиеНоменклатурыOzon", КомментарийПодробный);
			ОбщегоНазначения.СообщитьПользователю(КомментарийКраткий);

		КонецПопытки;
		
		Если СоздатьШтрихкод Тогда
			МенеджерЗаписи = РегистрыСведений["ШтрихкодыНоменклатуры"].СоздатьМенеджерЗаписи();
			МенеджерЗаписи.Штрихкод 		= товар.Штрихкод; 
			МенеджерЗаписи.Номенклатура 	= Номенклатура.Ссылка;			
			МенеджерЗаписи.Упаковка 		= Упаковка;
			МенеджерЗаписи.Записать();
		КонецЕсли;
		
		Если ЗаписатьСопоставление Тогда
			МенеджерЗаписи = РегистрыСведений.ИС_Ozon_СоответствиеХарактеристик.СоздатьМенеджерЗаписи();
			МенеджерЗаписи.НоменклатураOzon = товар.НоменклатураOzon; 
			МенеджерЗаписи.Номенклатура 	= Номенклатура.Ссылка;						
			МенеджерЗаписи.Записать();	
		КонецЕсли;
		
	КонецЦикла;

	Возврат ТаблицаТоваров;

КонецФункции //- ИнфоСофт Стояк Ю.К. 12.05.2023 УА #54628

//+ ИнфоСофт Ивонин К.А. 20.03.24 УА #71892
Функция ЗагрузитьЛимитыСозданияИОбновленияТоваров(Профиль) Экспорт
	
	НастройкиСоединения = ПолучитьНастройкиСоединенияПрофиля(Профиль);
	ПараметрыЗапроса = ПроверитьИЗаполнитьПараметрыЗапроса(НастройкиСоединения);
	
