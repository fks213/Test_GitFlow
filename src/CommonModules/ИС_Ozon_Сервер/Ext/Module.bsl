//+ ИнфоСофт Стояк Ю.К. 20.03.2023 УА #54628
Процедура ПолучитьЗаказы(Профиль, ДатаПоследнегоОтправления, ОбработатьТолькоСтатусы = Ложь) Экспорт
	
	НастройкиСоединения = ПолучитьНастройкиСоединенияПрофиля(Профиль);
	ПараметрыЗапроса = ПроверитьИЗаполнитьПараметрыЗапроса(НастройкиСоединения);
	
	МассивЗагруженныхЗаданий = Новый Массив;     
	
	//+ ИнфоСофт Мурсалимов Д.Р. 07.12.23 УА #67276
	offset = 0;
	//- ИнфоСофт Мурсалимов Д.Р. 07.12.23 УА #67276
	
	Пока Истина Цикл
		
		Тело = Новый Структура;
		Тело.Вставить("dir", "asc");
		
		Фильтр = Новый Структура; 
		Фильтр.Вставить("since", ИС_MP_РаботаСHTTPЗапросамиСервер.ЗаписатьДатуВJSON(ДатаПоследнегоОтправления, ФорматДатыJSON.ISO
		, ВариантЗаписиДатыJSON.УниверсальнаяДата));
		Фильтр.Вставить("to", ИС_MP_РаботаСHTTPЗапросамиСервер.ЗаписатьДатуВJSON(ТекущаяДатаСеанса(), ФорматДатыJSON.ISO
		, ВариантЗаписиДатыJSON.УниверсальнаяДата));  
		
		Тело.Вставить("filter", Фильтр);
		Тело.Вставить("limit", 1000);
		//+ ИнфоСофт Мурсалимов Д.Р. 07.12.23 УА #67276
		Тело.Вставить("offset", offset); 
		//- ИнфоСофт Мурсалимов Д.Р. 07.12.23 УА #67276
		
		Дополнительно = Новый Структура;
		Дополнительно.Вставить("analytics_data", Истина);
		Дополнительно.Вставить("barcodes", Истина);
		Дополнительно.Вставить("financial_data", Истина);  
		
		Тело.Вставить("with", Дополнительно);
		
		ПараметрыЗапроса.ТелоСтрока = ИС_MP_РаботаСHTTPЗапросамиСервер.ПолучитьСтрокуJSON(Тело);
		
		Результат = ИС_Ozon_API.ПолучитьСписокОтправлений(Профиль, ПараметрыЗапроса);
		
		Если ЗначениеЗаполнено(Результат) Тогда
			
			Для Каждого Элемент Из Результат.postings Цикл 		
				//+ ИнфоСофт Стояк Ю.К. 28.04.2023 УА #58008				
				//+ ИнфоСофт Мурсалимов Д.Р. 07.12.23 УА #67276
				//Если Не ОбработатьТолькоСтатусы Тогда
				
				СсылкаЗадания = СоздатьИлиОбновитьОтправление(Профиль, Элемент, ДатаПоследнегоОтправления);				 
				
				Если Не СсылкаЗадания.Пустая() Тогда
					
					МассивЗагруженныхЗаданий.Добавить(СсылкаЗадания); 
					
					//Статусы = Новый Структура;
					//Статусы.Вставить("posting_number", Элемент.posting_number);
					//Статусы.Вставить("status", Перечисления.ИС_Ozon_СтатусыОтправлений[Элемент.status]);
					Статус = ПолучитьСтатусСборочногоЗадания(Элемент.status);
					
					//+ ИнфоСофт Стояк Ю.К. 18.04.2025 УА #98648
					ДетальныйСтатус = ПолучитьДетальныйСтатусСборочногоЗадания(Элемент.status, Элемент.substatus);
					//- ИнфоСофт Стояк Ю.К. 18.04.2025 УА #98648
					
					//+ ИнфоСофт Стояк Ю.К. 19.03.2024 УА #64801					
					ДатаОтгрузки = ИС_MP_РаботаСHTTPЗапросамиСервер.ПрочитатьДатуИзJSON(Элемент.shipment_date, ФорматДатыJSON.ISO);
					
					//+ ИнфоСофт Власова И.С. 13.02.25 УА #83194
					//ОбновитьСтатусыЗаказов(Профиль, СсылкаЗадания, Статус, ДатаОтгрузки);
					ДатаОтгрузкиРекомендуемая = ДатаОтгрузки;
					
					Если Не Элемент.Свойство("tariffication") = Неопределено Тогда 
						
						ТарификацияЗаказа = Элемент["tariffication"];
						
						Если Не ТарификацияЗаказа.Свойство("next_tariff_starts_at") = Неопределено
							И Не ТарификацияЗаказа["next_tariff_starts_at"] = Неопределено Тогда
							
							ДатаСледующегоТарифа = ИС_MP_РаботаСHTTPЗапросамиСервер.ПрочитатьДатуИзJSON(ТарификацияЗаказа["next_tariff_starts_at"], ФорматДатыJSON.ISO) - 1;
							
							ТекущаяДата = ТекущаяДатаСеанса();
							
							Если ДатаОтгрузки < ТекущаяДата 
								И ДатаОтгрузки <> ДатаСледующегоТарифа Тогда
								
								ДатаОтгрузки = ДатаСледующегоТарифа;
								
							КонецЕсли;
							
						КонецЕсли;
						
					КонецЕсли;
					
					//+ ИнфоСофт Стояк Ю.К. 18.04.2025 УА #98648
					//ОбновитьСтатусыЗаказов(Профиль, СсылкаЗадания, Статус, ДатаОтгрузки, ДатаОтгрузкиРекомендуемая);
					ОбновитьСтатусыЗаказов(Профиль, СсылкаЗадания, Статус, ДатаОтгрузки, ДатаОтгрузкиРекомендуемая, ДетальныйСтатус, Элемент.cancellation.cancelled_after_ship);
					//- ИнфоСофт Стояк Ю.К. 18.04.2025 УА #98648
					//- ИнфоСофт Власова И.С. 13.02.25 УА #83194
					
					//- ИнфоСофт Стояк Ю.К. 19.03.2024 УА #64801
					
				КонецЕсли; 
					
				//Иначе
				//	
				//	Статусы = Новый Структура;
				//	Статусы.Вставить("posting_number", Элемент.posting_number);
				//	Статусы.Вставить("status", Перечисления.ИС_Ozon_СтатусыОтправлений[Элемент.status]);
				//	ОбновитьСтатусыЗаказов(Профиль, Элемент.posting_number, Статусы); 
				//	
				//КонецЕсли;
				//- ИнфоСофт Мурсалимов Д.Р. 07.12.23 УА #67276
				//- ИнфоСофт Стояк Ю.К. 28.04.2023 УА #58008
			КонецЦикла;
			
		Иначе
			Прервать;			
		КонецЕсли;
		
		Если Результат.has_next = Ложь Тогда
			Прервать;
		КонецЕсли;
		
		//+ ИнфоСофт Мурсалимов Д.Р. 07.12.23 УА #67276
		offset = Результат.postings.Количество();
		//- ИнфоСофт Мурсалимов Д.Р. 07.12.23 УА #67276
		
	КонецЦикла;
	
	Если МассивЗагруженныхЗаданий.Количество() > 0 Тогда
		ПроверитьФункциональныеОпцииСборочныхЗаданий(Профиль, МассивЗагруженныхЗаданий);	
	КонецЕсли;
		
КонецПроцедуры //- ИнфоСофт Стояк Ю.К. 20.03.2023 УА #54628

//+ ИнфоСофт Стояк Ю.К. 20.03.2023 УА #54628
Функция СоздатьИлиОбновитьОтправление(Профиль, Данные, ДатаПоследнегоОтправления)

    Событие = "СоздатьИлиОбновитьОтправление";
	
	Заказ = Документы.ИС_Ozon_Заказ.НайтиПоНомеру(Данные.posting_number);
	
	Если Заказ.Пустая() Тогда
		Заказ = Документы.ИС_Ozon_Заказ.СоздатьДокумент();
	Иначе
		Заказ = Заказ.ПолучитьОбъект();
	КонецЕсли;		
	
	Заказ.Профиль = Профиль;
	
	ЗаполнитьЗначенияСвойств(Заказ, Данные);
	
	//+ ИнфоСофт Стояк Ю.К. 26.07.2023 УА #60348	
	Заказ.Номер = Данные.posting_number;
	Заказ.order_id = Данные.order_id;           
	//- ИнфоСофт Стояк Ю.К. 26.07.2023 УА #60348
		
	Заказ.Дата = ИС_MP_РаботаСHTTPЗапросамиСервер.ПрочитатьДатуИзJSON(Данные.in_process_at, ФорматДатыJSON.ISO);			
	
	Заказ.Склад = Справочники.ИС_Ozon_Склады.НайтиПоРеквизиту("id", Данные.delivery_method.warehouse_id);	
	Заказ.tpl_provider = Данные.delivery_method.tpl_provider;
	Заказ.delivering_date = Данные.delivering_date;
	Заказ.shipment_date = ИС_MP_РаботаСHTTPЗапросамиСервер.ПрочитатьДатуИзJSON(Данные.shipment_date, ФорматДатыJSON.ISO);
	Заказ.delivery_method_id = Данные.delivery_method.id;
	
	//+ ИнфоСофт Заварин К.В. 18.10.24 УА #74582
	Заказ.is_express = Данные.is_express;
	//- ИнфоСофт Заварин К.В. 18.10.24 УА #74582
	
	Если Данные.barcodes <> Неопределено Тогда
		Заказ.lower_barcode = Данные.barcodes.lower_barcode;
		Заказ.upper_barcode = Данные.barcodes.upper_barcode;
	КонецЕсли;
	
	Заказ.is_multibox = Данные.is_multibox; 
	Заказ.multi_box_qty = Данные.multi_box_qty; 
	Заказ.order_number = Данные.order_number; 
	
	Если Данные.customer <> Неопределено Тогда 
		
		//+ ИнфоСофт Власова И.С. 04.02.25 УА #92800
		//Если Данные.customer.Свойство("address") Тогда
			//address = Данные.customer.address.address_tail;
			//Заказ.address_tail = Данные.customer.address.address_tail;
		//КонецЕсли;
		
		Если Данные.customer.Свойство("address") И Данные.customer.address <> Неопределено Тогда
		
			customer_address = Данные.customer.address;
			
			Если customer_address.Свойство("address_tail") Тогда
				
				address = customer_address.address_tail;
				Заказ.address_tail = address;
				
			КонецЕсли;	
				
		КонецЕсли;
		//- ИнфоСофт Власова И.С. 04.02.25 УА #92800
		
		Если Данные.customer.Свойство("customer_email") Тогда
			Заказ.customer_email = Данные.customer.customer_email; 
		КонецЕсли;                                         
		
		Если Данные.customer.Свойство("name") Тогда
			name = Данные.customer.name;	
			Заказ.name = Данные.customer.name; 
		КонецЕсли;
	    
	    Если ЗначениеЗаполнено(address) Или ЗначениеЗаполнено(name) Тогда
	        
			НастройкиСоединения = ПолучитьНастройкиСоединенияПрофиля(Профиль);
			ПараметрыЗапроса = ПроверитьИЗаполнитьПараметрыЗапроса(НастройкиСоединения);
	        
	        ДанныеОбОтпралвении = ИС_Ozon_API.ПолучитьИнформциюПоОтправлению(Профиль, ПараметрыЗапроса, Данные.posting_number);
	        
	        Если ДанныеОбОтпралвении <> Неопределено Тогда
                
                ДанныеОПокупателе = ДанныеОбОтпралвении["result"]["customer"];
                
                Если ДанныеОПокупателе <> Неопределено Тогда
					Заказ.phone = ДанныеОПокупателе["phone"]; 
				КонецЕсли;
			
			КонецЕсли;
			
		КонецЕсли; 
		                                         
	КонецЕсли;
	
	Заказ.products.Очистить();
	Требования = Данные.requirements;
	
	Если Данные.financial_data <> Неопределено Тогда
		
		Для Каждого Элемент Из Данные.products Цикл	
			
			НоваяСтрока = Заказ.products.Добавить();
			
			//+ ИнфоСофт Мурсалимов Д.Р. 20.03.24 УА #72613
			Запрос = Новый Запрос;
			
			Запрос.Текст = 
			"ВЫБРАТЬ
			|	ИС_Ozon_Номенклатура.Ссылка КАК НоменклатураOzon,
			|	МАКСИМУМ(ИС_Ozon_Штрихкоды.Ссылка) КАК ХарактеристикаOzon
			|ИЗ
			|	Справочник.ИС_Ozon_Номенклатура КАК ИС_Ozon_Номенклатура
			|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ИС_Ozon_Штрихкоды КАК ИС_Ozon_Штрихкоды
			|		ПО ИС_Ozon_Номенклатура.Профиль = ИС_Ozon_Штрихкоды.ЛичныйКабинет
			|			И ИС_Ozon_Номенклатура.Ссылка = ИС_Ozon_Штрихкоды.Карточка
			|ГДЕ
			|	ИС_Ozon_Номенклатура.offer_id = &offer_id
			|	И ИС_Ozon_Номенклатура.Профиль = &Профиль
			|
			|СГРУППИРОВАТЬ ПО
			|	ИС_Ozon_Номенклатура.Ссылка";
			
			Запрос.УстановитьПараметр("offer_id", Элемент.offer_id);
			Запрос.УстановитьПараметр("Профиль", Профиль);
			
			РезультатЗапроса = Запрос.Выполнить();
			ВыборкаНоменклатуры = РезультатЗапроса.Выбрать();
			
			Пока ВыборкаНоменклатуры.Следующий() Цикл
				
				НоваяСтрока.НоменклатураOzon = ВыборкаНоменклатуры.НоменклатураOzon;	
				НоваяСтрока.ХарактеристикаOzon = ВыборкаНоменклатуры.ХарактеристикаOzon; 
			
			КонецЦикла;
			
			Если Не ЗначениеЗаполнено(НоваяСтрока.НоменклатураOzon) Тогда
				
				НоваяСтрока.НоменклатураOzon = Справочники.ИС_Ozon_Номенклатура.НайтиПоРеквизиту("offer_id", Элемент.offer_id);	
