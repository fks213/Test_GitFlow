//+ ИнфоСофт Стояк Ю.К. 22.01.2024 УА #61983
Функция СтруктураПараметровЗначенийРеквизитовХарактеристикиНоменклатуры(Категория,
	ЕстьНастройкиОсновныхРеквизитовДляКатегории) Экспорт

	Если ЕстьНастройкиОсновныхРеквизитовДляКатегории Тогда
		КатегорияДляОсновныхРеквизитов = Категория;
	Иначе
		КатегорияДляОсновныхРеквизитов = ПредопределенноеЗначение("Справочник.ИС_Ozon_КатегорииТоваров.ПустаяСсылка");
	КонецЕсли;

	СоответствиеРеквизитов = Новый Соответствие;
	СписокРеквизитов = "";
	МассивТипов = Новый Массив;

	РеквизитыНоменклатуры = Метаданные.Справочники["ХарактеристикиНоменклатуры"].Реквизиты;
	Для Каждого реквизит Из РеквизитыНоменклатуры Цикл
		СоответствиеРеквизитов.Вставить(реквизит.Синоним, реквизит);
		СписокРеквизитов = СписокРеквизитов + реквизит.Имя + ", ";
		МассивТипов.Добавить(реквизит.тип.типы()[0]);
	КонецЦикла;

	СтандартныеРеквизиты = Метаданные.Справочники["ХарактеристикиНоменклатуры"].СтандартныеРеквизиты;
	Для Каждого реквизит Из СтандартныеРеквизиты Цикл
		СоответствиеРеквизитов.Вставить(реквизит.Имя, реквизит);
		СписокРеквизитов = СписокРеквизитов + реквизит.Имя + ", ";
		МассивТипов.Добавить(реквизит.тип.типы()[0]);
	КонецЦикла;

	СписокРеквизитов = Лев(СписокРеквизитов, СтрДлина(СписокРеквизитов) - 2);

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Категория", Категория);
	Запрос.УстановитьПараметр("КатегорияДляОсновныхРеквизитов", КатегорияДляОсновныхРеквизитов);
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ИС_Ozon_СоответствиеЗначенийХарактеристик.ХарактеристикаOzon КАК ХарактеристикаOzon,
	|	ИС_Ozon_СоответствиеЗначенийХарактеристик.ЗначениеХарактеристикиOzon КАК ЗначениеХарактеристикиOzon,
	|	ИС_Ozon_СоответствиеЗначенийХарактеристик.ВидРеквизита1С КАК ВидРеквизита1С,
	|	ИС_Ozon_СоответствиеЗначенийХарактеристик.Реквизит1С КАК Реквизит1С,
	|	ИС_Ozon_СоответствиеЗначенийХарактеристик.ЗначениеХарактеристики КАК ЗначениеХарактеристики,
	|	ИС_Ozon_Характеристики.Код КАК ХарактеристикаOzonКод,
	|	ИС_Ozon_Характеристики.ИДСправочникаЗначенийХарактеристики > 0 КАК ТребуетсяСопоставление
	|ИЗ
	|	РегистрСведений.ИС_Ozon_СоответствиеЗначенийХарактеристик КАК ИС_Ozon_СоответствиеЗначенийХарактеристик
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ИС_Ozon_Характеристики КАК ИС_Ozon_Характеристики
	|		ПО ИС_Ozon_СоответствиеЗначенийХарактеристик.ХарактеристикаOzon = ИС_Ozon_Характеристики.Ссылка
	|ГДЕ
	|	ИС_Ozon_СоответствиеЗначенийХарактеристик.Категория = &Категория
	|	И ИС_Ozon_СоответствиеЗначенийХарактеристик.ВидРеквизита1С = ЗНАЧЕНИЕ(Перечисление.ИС_Ozon_ВидРеквизитаСопоставления.РеквизитХарактеристикиНоменклатуры)
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ИС_Ozon_СоответствиеОсновныхРеквизитовТовара.РеквизитТовара,
	|	NULL,
	|	ИС_Ozon_СоответствиеОсновныхРеквизитовТовара.ВидРеквизита1С,
	|	ИС_Ozon_СоответствиеОсновныхРеквизитовТовара.Реквизит1С,
	|	NULL,
	|	NULL,
	|	ЛОЖЬ
	|ИЗ
	|	РегистрСведений.ИС_Ozon_СоответствиеОсновныхРеквизитовТовара КАК ИС_Ozon_СоответствиеОсновныхРеквизитовТовара
	|ГДЕ
	|	ИС_Ozon_СоответствиеОсновныхРеквизитовТовара.Категория = &КатегорияДляОсновныхРеквизитов
	|	И ИС_Ozon_СоответствиеОсновныхРеквизитовТовара.ВидРеквизита1С = ЗНАЧЕНИЕ(Перечисление.ИС_Ozon_ВидРеквизитаСопоставления.РеквизитХарактеристикиНоменклатуры)";

	ТаблицаСоответствийЗначений = Запрос.Выполнить().Выгрузить();
	ТаблицаСоответствийЗначений.Колонки.ЗначениеХарактеристики.Имя = "ЗначениеВРегистре";

	МассивТипов 	= ОбщегоНазначенияКлиентСервер.СвернутьМассив(МассивТипов);
	ОписаниеТипов 	= Новый ОписаниеТипов(МассивТипов, , Новый КвалификаторыСтроки(1024, ДопустимаяДлина.Переменная));
	ТаблицаСоответствийЗначений.Колонки.Добавить("ЗначениеХарактеристики", ОписаниеТипов);

	Для Каждого стр Из ТаблицаСоответствийЗначений Цикл
		Если ЗначениеЗаполнено(стр.ЗначениеВРегистре) Тогда

			ТипЗначенияРеквизита = СоответствиеРеквизитов.Получить(стр.Реквизит1С).тип;
			Если ЭтоПримитивныйТип(ТипЗначенияРеквизита) Тогда

				стр.ЗначениеХарактеристики = стр.ЗначениеВРегистре;

			Иначе

				ОбъектМетаданных = Метаданные.НайтиПоТипу(ТипЗначенияРеквизита.Типы()[0]);
				ПолноеИмяОбъекта = ОбъектМетаданных.ПолноеИмя();
				ЭтоСправочник	= СтрНайти(ПолноеИмяОбъекта, "Справочник.") = 1;
				ЭтоПеречисление	= СтрНайти(ПолноеИмяОбъекта, "Перечисление.") = 1;

				Если ЭтоСправочник Тогда
					стр.ЗначениеХарактеристики = Справочники[ОбъектМетаданных.Имя].ПолучитьСсылку(
						Новый УникальныйИдентификатор(стр.ЗначениеВРегистре));
				ИначеЕсли ЭтоПеречисление Тогда
					стр.ЗначениеХарактеристики = Перечисления[ОбъектМетаданных.Имя].Получить(стр.ЗначениеВРегистре - 1);
				КонецЕсли;

			КонецЕсли;
		КонецЕсли;
	КонецЦикла;

	Результат = Новый Структура;
	Результат.Вставить("ТаблицаСоответствийЗначений", ТаблицаСоответствийЗначений);
	Результат.Вставить("СписокРеквизитов", СписокРеквизитов);
	Результат.Вставить("СоответствиеРеквизитов", СоответствиеРеквизитов);

	Возврат Результат;

КонецФункции //- ИнфоСофт Стояк Ю.К. 22.01.2024 УА #61983

//+ ИнфоСофт Стояк Ю.К. 22.01.2024 УА #61983
Функция ЕстьНастройкиОсновныхРеквизитовДляКатегории(Категория) Экспорт

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ИС_Ozon_СоответствиеОсновныхРеквизитовТовара.Категория КАК Категория
	|ИЗ
	|	РегистрСведений.ИС_Ozon_СоответствиеОсновныхРеквизитовТовара КАК ИС_Ozon_СоответствиеОсновныхРеквизитовТовара
	|ГДЕ
