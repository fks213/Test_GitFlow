			//- ИнфоСофт Заварин К.В. 12.02.25 УА #93503
				
				НоваяСтрока.НоменклатураНабора = Элемент.Набор;
				
				//+ ИнфоСофт Мурсалимов Д.Р. 28.05.24 УА #76561
				НоваяСтрока.ХарактеристикаНабора = Элемент.ХарактеристикаНабора;
				//- ИнфоСофт Мурсалимов Д.Р. 28.05.24 УА #76561
				
				Если Элемент.ВариантРасчетаЦеныНабора = Перечисления.ВариантыРасчетаЦенНаборов.ЦенаЗадаетсяЗаНаборРаспределяетсяПоДолям Тогда
					Элемент.Сумма = СуммаПродажиПриДолях[0];
					СуммаПродажиПриДолях.Удалить(0);	
				Иначе					
					
					Если МассивКоэфф = Неопределено Тогда
						ОбщегоНазначения.СообщитьПользователю("Проверьте наличие цены на набор/его комплектующие " + Элемент.Набор);
						Элемент.Сумма = Элемент.Сумма / Элемент.КоличествоОбщее;
