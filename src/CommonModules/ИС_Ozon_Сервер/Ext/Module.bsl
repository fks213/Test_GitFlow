//+ ИнфоСофт Стояк Ю.К. 22.01.2024 УА #61983
Функция ЭтоПримитивныйТип(ТипРеквизита) Экспорт

	Результат = Ложь;

	Если ТипЗнч(ТипРеквизита) = Тип("ОписаниеТипов") Тогда

		Если ТипРеквизита.СодержитТип(Тип("Строка")) Или ТипРеквизита.СодержитТип(Тип("Число"))
			Или ТипРеквизита.СодержитТип(Тип("Булево")) Или ТипРеквизита.СодержитТип(Тип("Дата")) Тогда

			Результат = Истина;

		КонецЕсли;
	ИначеЕсли ТипЗнч(ТипРеквизита) = Тип("Тип") Тогда

		Если ТипРеквизита = Тип("Строка") Или ТипРеквизита = Тип("Число") Или ТипРеквизита = Тип("Булево")
			Или ТипРеквизита = Тип("Дата") Тогда

			Результат = Истина;

		КонецЕсли;

	КонецЕсли;

	Возврат Результат;

КонецФункции //- ИнфоСофт Стояк Ю.К. 22.01.2024 УА #61983

//+ ИнфоСофт Стояк Ю.К. 22.01.2024 УА #61983
Функция ЭтоТипЗначенияСвойствОбъектов(ТипРеквизита) Экспорт

	Результат = Ложь;

	Если ТипРеквизита.СодержитТип(Тип("СправочникСсылка.ЗначенияСвойствОбъектов")) Или ТипРеквизита.СодержитТип(Тип(
		"СправочникСсылка.ЗначенияСвойствОбъектовИерархия")) Тогда

		Результат = Истина;

	КонецЕсли;

	Возврат Результат;

КонецФункции //- ИнфоСофт Стояк Ю.К. 22.01.2024 УА #61983

//+ ИнфоСофт Стояк Ю.К. 22.01.2024 УА #61983
Функция ТаблицаСоответствийДопРеквизитов(Категория, ЕстьНастройкиОсновныхРеквизитовДляКатегории) Экспорт

	Если ЕстьНастройкиОсновныхРеквизитовДляКатегории Тогда
		КатегорияДляОсновныхРеквизитов = Категория;
	Иначе
		КатегорияДляОсновныхРеквизитов = ПредопределенноеЗначение("Справочник.ИС_Ozon_КатегорииТоваров.ПустаяСсылка");
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Категория", Категория);
	Запрос.УстановитьПараметр("КатегорияДляОсновныхРеквизитов", КатегорияДляОсновныхРеквизитов);
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ИС_Ozon_СоответствиеЗначенийХарактеристик.ХарактеристикаOzon КАК ХарактеристикаOzon,
	|	ИС_Ozon_СоответствиеЗначенийХарактеристик.ЗначениеХарактеристикиOzon КАК ЗначениеХарактеристикиOzon,
	|	ИС_Ozon_СоответствиеЗначенийХарактеристик.ВидРеквизита1С КАК ВидРеквизита1С,
	|	ИС_Ozon_СоответствиеЗначенийХарактеристик.Реквизит1С КАК Реквизит1С,
	|	ИС_Ozon_СоответствиеЗначенийХарактеристик.ЗначениеХарактеристики КАК ЗначениеХарактеристики,
	|	ИС_Ozon_СоответствиеЗначенийХарактеристик.Реквизит1С.ТипЗначения КАК ТипЗначенияРеквизита,
	|	ИС_Ozon_Характеристики.Код КАК ХарактеристикаOzonКод,
	//+ ИнфоСофт Заварин К.В. 18.05.24 УА #71523
	|	0 КАК Множитель,
	//- ИнфоСофт Заварин К.В. 18.05.24 УА #71523
