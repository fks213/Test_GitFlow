//+ ИнфоСофт Стояк Ю.К. 22.01.2024 УА #61983
Функция СтруктураДобавленияТовара()

	Результат = Новый Структура;
	Результат.Вставить("name", ""); // Строка - Название товара. До 500 символов.
	Результат.Вставить("barcode", ""); // Строка - Штрихкод товара.
	Результат.Вставить("offer_id", ""); // Строка - Идентификатор товара в системе продавца - артикул.
	//+ ИнфоСофт Стояк Ю.К. 22.03.2024 УА #72805	
	//Результат.Вставить("category_id", 0);  // Число  - Идентификатор категории.
	Результат.Вставить("description_category_id", 0);  // Число  - Идентификатор категории.
	//- ИнфоСофт Стояк Ю.К. 22.03.2024 УА #72805
	Результат.Вставить("color_image", ""); // Строка - Маркетинговый цвет.
	Результат.Вставить("old_price", ""); // Строка - Цена до скидок (будет зачеркнута на карточке товара). Указывается в рублях. Разделитель дробной части - точка, до двух знаков после точки.
	Результат.Вставить("price", ""); // Строка - Цена товара с учетом скидок, отображается на карточке товара. Если на товар нет скидок - укажите значение old_price.
	Результат.Вставить("min_price", ""); // Строка - Минимальная цена товара после применения акций.
	Результат.Вставить("vat", ""); // Строка - Ставка НДС для товара. 0 - не облагается НДС, 0.1 - 10%, 0.2 - 20%.
	Результат.Вставить("depth", 0);  // Число  - Глубина упаковки.
	Результат.Вставить("width", 0);  // Число  - Ширина упаковки.
	Результат.Вставить("height", 0);  // Число  - Высота упаковки.
	Результат.Вставить("dimension_unit", ""); // Строка - Единица измерения габаритов. mm - миллиметры, cm - сантиметры, in - дюймы.
	Результат.Вставить("weight", 0);  // Число  - Вес товара в упаковке. Предельное значение - 1000 килограмм или конвертированная величина в других единицах измерения.
	Результат.Вставить("weight_unit", ""); // Строка - Единицы измерения веса: g - граммы, kg - килограммы, lb - фунты.
	
	//+ ИнфоСофт Мурсалимов Д.Р. 21.04.25 УА #96982
	//Результат.Вставить("image_group_id", ""); // Строка - Идентификатор для последующей пакетной загрузки изображений.
	//- ИнфоСофт Мурсалимов Д.Р. 21.04.25 УА #96982
	
	Результат.Вставить("primary_image", ""); // Строка - Ссылка на главное изображение товара.
	Результат.Вставить("images", Новый Массив); // Массив из Строка - Массив с изображениями, не больше 10.
	Результат.Вставить("pdf_list", Новый Массив); // Массив из Структура - Список pdf-файлов.
	Результат.Вставить("complex_attributes", Новый Массив); // Массив из Структура - Массив характеристик, у которых есть вложенные аттрибуты.
	Результат.Вставить("attributes", Новый Массив); // Массив из Структура - Массив с характеристиками товара.

	Возврат Результат;

КонецФункции //- ИнфоСофт Стояк Ю.К. 22.01.2024 УА #61983

//+ ИнфоСофт Стояк Ю.К. 22.01.2024 УА #61983
Функция МассивЗначенийХарактеристикДобавлениеТовара(Источник, ПоляАтрибутов)

	Результат = Новый Массив;

	Для Каждого Поле Из ПоляАтрибутов Цикл

		ЗначениеХарактеристики = Источник[Поле.Имя];
		Если Не ЗначениеЗаполнено(ЗначениеХарактеристики) Тогда
			Продолжить;	
		КонецЕсли;
		
		ИдХарактеристики = Число(СтрРазделить(Поле.Имя, "_")[1]);
		СтруктураХарактеристики = СтруктуруХарактеристикиДобавлениеТовара(ИДХарактеристики);

		Если ТипЗнч(ЗначениеХарактеристики) = Тип("СписокЗначений") Тогда
			МассивВыбранныхЗначений = ЗначениеХарактеристики.ВыгрузитьЗначения();
			Для Каждого Значение Из МассивВыбранныхЗначений Цикл
				Если ЗначениеЗаполнено(Значение) Тогда
					СтруктураЗначения = СтруктураЗначенияХарактеристикиДобавлениеТовара(Значение);
					СтруктураХарактеристики.values.Добавить(СтруктураЗначения);
				КонецЕсли;
			КонецЦикла;
		Иначе
			Если ТипЗнч(ЗначениеХарактеристики) = Тип("Строка") И Поле.МногострочныйРежим <> Неопределено
				И Поле.МногострочныйРежим И Не ТекстСодержитJSON(ЗначениеХарактеристики) Тогда
				ТекстВHTML = ПреобразоватьМногострочныйТекстВHTML(
					ЗначениеХарактеристики);
				СтруктураЗначения = СтруктураЗначенияХарактеристикиДобавлениеТовара(ТекстВHTML);
			Иначе
				СтруктураЗначения = СтруктураЗначенияХарактеристикиДобавлениеТовара(ЗначениеХарактеристики);
			КонецЕсли;
			СтруктураХарактеристики.values.Добавить(СтруктураЗначения);
		КонецЕсли;

		Результат.Добавить(СтруктураХарактеристики);

	КонецЦикла;

	Возврат Результат;

КонецФункции //- ИнфоСофт Стояк Ю.К. 22.01.2024 УА #61983

//+ ИнфоСофт Стояк Ю.К. 22.01.2024 УА #61983
Функция СтруктуруХарактеристикиДобавлениеТовара(ИДХарактеристики)

	Результат = Новый Структура;
	Результат.Вставить("complex_id", 0);
	Результат.Вставить("id", 0);
	Результат.Вставить("values", Новый Массив);  // {"dictionary_value_id": 0, "value": "string" }

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	Ozon_Характеристики.Код КАК Код,
	|	Ozon_Характеристики.ИдентификаторГруппы КАК ИдентификаторГруппы
	|ИЗ
	|	Справочник.ИС_Ozon_Характеристики КАК Ozon_Характеристики
	|ГДЕ
	|	Ozon_Характеристики.Код = &Код";

	Запрос.УстановитьПараметр("Код", ИДХарактеристики);

	РезультатЗапроса = Запрос.Выполнить();

	Выборка = РезультатЗапроса.Выбрать();

	Если Выборка.Следующий() Тогда
		Результат.id 			= Выборка.Код;
		Результат.complex_id 	= Выборка.ИдентификаторГруппы;
	КонецЕсли;

	Возврат Результат;

КонецФункции //- ИнфоСофт Стояк Ю.К. 22.01.2024 УА #61983

//+ ИнфоСофт Стояк Ю.К. 22.01.2024 УА #61983
Функция СтруктураЗначенияХарактеристикиДобавлениеТовара(Значение)

	Результат = Новый Структура;
	Результат.Вставить("dictionary_value_id", 0);
	Результат.Вставить("value", "");

	Если ТипЗнч(Значение) = Тип("СправочникСсылка.ИС_Ozon_ЗначенияХарактеристик") Тогда
		Результат.dictionary_value_id 	= ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Значение, "Код");
	ИначеЕсли ТипЗнч(Значение) = Тип("Число") Тогда
		Результат.value = Формат(Значение, "ЧГ=0");
	Иначе
		Результат.value = Строка(Значение);
	КонецЕсли;

	Возврат Результат;

КонецФункции //- ИнфоСофт Стояк Ю.К. 22.01.2024 УА #61983

