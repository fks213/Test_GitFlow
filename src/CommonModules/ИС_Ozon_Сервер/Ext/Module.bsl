				ДополнительныеПараметры.Вставить("СуммаПродажиКРаспределению", 	Цена);
				ДополнительныеПараметры.Вставить("Комиссия", 					0);
				
				Комплектующие = ИС_МП_УправлениеЗаказами.Комплектующие(ПараметрыКомплектующих, ДополнительныеПараметры);
				
				Для Каждого стрКомплекта Из Комплектующие Цикл			
					НоваяСтрока = Документ.Товары.Добавить();
					
					ЗаполнитьЗначенияСвойств(НоваяСтрока, стрКомплекта);
					
					НоваяСтрока.Количество 					= НоваяСтрока.КоличествоУпаковок;
					НоваяСтрока.Сумма 						= НоваяСтрока.Цена * НоваяСтрока.КоличествоУпаковок
					+ стрКомплекта.Погрешность;
					
					СуммаДокумента							= СуммаДокумента + НоваяСтрока.Сумма;
					
					//+ ИнфоСофт Тимофеева А.А. 09.04.2025 УА #97337
					//Если ОблагаетсяНДС Тогда
					//	НДС = стрКомплекта.Номенклатура.СтавкаНДС.Ставка;
					//	НоваяСтрока.СтавкаНДС = стрКомплекта.Номенклатура.СтавкаНДС; 
					//	Если НДС = Неопределено Или НДС = 0 Тогда 
					//		НоваяСтрока.СуммаНДС = 0;		
					//	Иначе
					//		//+ ИнфоСофт Стояк Ю.К. 27.02.2025 УА #94698							
					//		//НоваяСтрока.СуммаНДС = ИС_WB_СерверУТ11_5.РассчитатьСуммуНДС(НоваяСтрока.Цена, НДС, Истина);
					//		НоваяСтрока.СуммаНДС = ИС_WB_СерверУТ11_5.РассчитатьСуммуНДС(НоваяСтрока.Сумма, НДС, Истина);
					//		//- ИнфоСофт Стояк Ю.К. 27.02.2025 УА #94698
					//	КонецЕсли;	
					//Иначе
					//	НоваяСтрока.СтавкаНДС = Справочники.СтавкиНДС.НайтиПоНаименованию("Без НДС");
					//КонецЕсли;
					//- ИнфоСофт Тимофеева А.А. 09.04.2025 УА #97337
					
					НоваяСтрока.СуммаСНДС = НоваяСтрока.Сумма;
					
					//+ ИнфоСофт Тимофеева А.А. 09.04.2025 УА #97337
					Если ПродажаОблагаетсяНДС Тогда
						СтавкаНДС = ИС_МП_УправлениеОтчетами.РассчитатьСтавкуНДС( Документ.Организация
																				, ТекущаяДатаСеанса()
																				, Документ.НалогообложениеНДС
																				, стрКомплекта.Номенклатура);
						НДС 						= СтавкаНДС.Ставка;
						НоваяСтрока.СтавкаНДС 		= СтавкаНДС; 
						
						Если Не ЗначениеЗаполнено(НДС) Или НДС = 0 Тогда 
							НоваяСтрока.СуммаНДС = 0;						
						Иначе
							НоваяСтрока.СуммаНДС = ИС_WB_СерверУТ11_5.РассчитатьСуммуНДС(НоваяСтрока.СуммаСНДС, НДС, Истина);						
						КонецЕсли;	
						
					Иначе
						НоваяСтрока.СтавкаНДС = Справочники.СтавкиНДС.НайтиПоНаименованию("Без НДС");
					КонецЕсли;
					//- ИнфоСофт Тимофеева А.А. 09.04.2025 УА #97337
					
				КонецЦикла;
				
			КонецЕсли;
			
		Иначе		
			
			Если Элемент.Количество > 0 Тогда
				
				НоваяСтрока = Документ.Товары.Добавить();
				
				НоваяСтрока.Номенклатура 					= Элемент.Номенклатура;
				НоваяСтрока.Характеристика 					= Элемент.ХарактеристикаНоменклатуры;				
				НоваяСтрока.Количество 						= Элемент.Количество;
				НоваяСтрока.КоличествоУпаковок 				= Элемент.Количество;
				НоваяСтрока.Сумма 							= Цена;
				НоваяСтрока.Цена 							= НоваяСтрока.Сумма / НоваяСтрока.КоличествоУпаковок;
				
				//+ ИнфоСофт Тимофеева А.А. 09.04.2025 УА #97337
				//Если ОблагаетсяНДС Тогда
				//	НДС = Элемент.Номенклатура.СтавкаНДС.Ставка;
				//	НоваяСтрока.СтавкаНДС = Элемент.Номенклатура.СтавкаНДС; 
				//	Если НДС = Неопределено Или НДС = 0 Тогда 
				//		НоваяСтрока.СуммаНДС = 0;		
				//	Иначе						
				//		//+ ИнфоСофт Стояк Ю.К. 27.02.2025 УА #94698							
				//		//НоваяСтрока.СуммаНДС = ИС_WB_СерверУТ11_5.РассчитатьСуммуНДС(НоваяСтрока.Цена, НДС, Истина);
				//		НоваяСтрока.СуммаНДС = ИС_WB_СерверУТ11_5.РассчитатьСуммуНДС(НоваяСтрока.Сумма, НДС, Истина);
				//		//- ИнфоСофт Стояк Ю.К. 27.02.2025 УА #94698
				//	КонецЕсли;	
				//Иначе
				//	НоваяСтрока.СтавкаНДС = Справочники.СтавкиНДС.НайтиПоНаименованию("Без НДС");
				//КонецЕсли;
				//- ИнфоСофт Тимофеева А.А. 09.04.2025 УА #97337
				
				НоваяСтрока.СуммаСНДС = НоваяСтрока.Сумма;
				
				//+ ИнфоСофт Тимофеева А.А. 09.04.2025 УА #97337
				Если ПродажаОблагаетсяНДС Тогда
					СтавкаНДС = ИС_МП_УправлениеОтчетами.РассчитатьСтавкуНДС( Документ.Организация
																			, ТекущаяДатаСеанса()
																			, Документ.НалогообложениеНДС
																			, Элемент.Номенклатура);
					НДС 						= СтавкаНДС.Ставка;
					НоваяСтрока.СтавкаНДС 		= СтавкаНДС; 
						
					Если Не ЗначениеЗаполнено(НДС) Или НДС = 0 Тогда 					
						НоваяСтрока.СуммаНДС = 0;						
					Иначе
						НоваяСтрока.СуммаНДС = ИС_WB_СерверУТ11_5.РассчитатьСуммуНДС(НоваяСтрока.СуммаСНДС, НДС, Истина); 	
					КонецЕсли;
				
				Иначе
					НоваяСтрока.СтавкаНДС = Справочники.СтавкиНДС.НайтиПоНаименованию("Без НДС");
				КонецЕсли;
				//- ИнфоСофт Тимофеева А.А. 09.04.2025 УА #97337
				
				СуммаДокумента 								= СуммаДокумента + НоваяСтрока.Сумма;  
				
			КонецЕсли;	
			
		КонецЕсли;
		
	КонецЦикла;
	
	Документ.СуммаДокумента = СуммаДокумента;	
	
	Попытка
		Документ.Записать(РежимЗаписиДокумента.Проведение); 
	Исключение
		Документ.Записать();
	КонецПопытки; 
	
	Возврат Документ;
	
КонецФункции //- ИнфоСофт Заварин К.В. 29.11.24 УА #74680

//+ ИнфоСофт Мурсалимов Д.Р. 25.03.25 УА #96800
Функция СоздатьРеализациюУслугПоЮрЛицам(СтруктураДанных) Экспорт
	
	Номенклатура 	= СтруктураДанных.Номенклатура;
	Соглашение 		= СтруктураДанных.Соглашение;
	Договор 		= СтруктураДанных.Договор;	
	ЗаказКлиента 	= СтруктураДанных.ЗаказКлиента; 
	
	УстановитьПривилегированныйРежим(Истина);
	
	Событие 			= "Создание реализации"; 
	
	ФукнциональныеОпции = ПолучитьНастройкиФункциональностиСборочныхЗвданий(СтруктураДанных.Профиль);
	
	ДокументОбъект 		= Документы.РеализацияТоваровУслуг.СоздатьДокумент(); 
	
	Если ЗаказКлиента = Неопределено Тогда
		
		ДанныеЗаполнения 	= Новый Структура;
		
		ДанныеЗаполнения.Вставить("Организация", 			ФукнциональныеОпции.Организация);
		ДанныеЗаполнения.Вставить("Соглашение", 			Соглашение);
		ДанныеЗаполнения.Вставить("Договор", 				Договор);
		ДанныеЗаполнения.Вставить("ЗаполнятьПоСоглашению", 	Истина);
		
		ДокументОбъект.Заполнить(ДанныеЗаполнения);
		
	Иначе	
		ДокументОбъект.Заполнить(ЗаказКлиента.Ссылка);	
	КонецЕсли;
		
	ДокументОбъект.ЦенаВключаетНДС = Истина;
	
	ПродажаОблагаетсяНДС = ИС_МП_УправлениеЗаказами.ПолучитьПрименениеНДСОрганизации(СтруктураДанных.Профиль.Организация);
	
	Если ПродажаОблагаетсяНДС Тогда 		
		ДокументОбъект.НалогообложениеНДС	= Перечисления.ТипыНалогообложенияНДС.ПродажаОблагаетсяНДС; 
	Иначе
		ДокументОбъект.НалогообложениеНДС 	= Перечисления.ТипыНалогообложенияНДС.ПродажаНеОблагаетсяНДС;			
	КонецЕсли;
	
	ХозОперация 							= ПредопределенноеЗначение("Перечисление.ХозяйственныеОперации.РеализацияКлиенту");	
	ИспользоватьДоговорыСКлиентами 			= ПолучитьФункциональнуюОпцию("ИспользоватьДоговорыСКлиентами");
	
	ДокументОбъект.Дата 					= СтруктураДанных.ТаблицаПродаж[0].ДатаСчетФактуры;
	ДокументОбъект.ХозяйственнаяОперация 	= ХозОперация;   
	ДокументОбъект.Организация				= ФукнциональныеОпции.Организация;	
	
	ДокументОбъект.СкидкиРассчитаны         = Истина;
	ДокументОбъект.Склад           			= ФукнциональныеОпции.OzonСкладРеализации; 	
	ДокументОбъект.Соглашение				= Соглашение;
	ДокументОбъект.Договор					= Договор;
	ДокументОбъект.Контрагент				= ФукнциональныеОпции.КонтрагентOzon;
	ДокументОбъект.Партнер					= ФукнциональныеОпции.ПартнерOzon;	
	
	Если Не ЗначениеЗаполнено(ДокументОбъект.Соглашение) Или Не ЗначениеЗаполнено(ДокументОбъект.Соглашение.ПорядокРасчетов) Тогда
		ДокументОбъект.ПорядокРасчетов 		= ДокументОбъект.Договор.ПорядокРасчетов;
	Иначе
		ДокументОбъект.ПорядокРасчетов 		= ДокументОбъект.Соглашение.ПорядокРасчетов;	
	КонецЕсли;
	
	Склад 									= ДокументОбъект.Склад;
	
	ДокументОбъект.Товары.Очистить();
	
	Для Каждого Транзакция Из СтруктураДанных.ТаблицаПродаж Цикл
		
		СуммаЛояльностиРеализации 	= Окр(Транзакция.СуммаЛояльностиРеализации / Транзакция.Количество, 2);
		
		Цена 						= СуммаЛояльностиРеализации;
		
		Если Транзакция.Количество = 0 Тогда
			Продолжить;
		КонецЕсли;
		
		НоваяСтрока = ДокументОбъект.Товары.Добавить();
		
		НоваяСтрока.Номенклатура 					= Номенклатура;
		НоваяСтрока.Количество 						= Транзакция.Количество;
		НоваяСтрока.КоличествоУпаковок 				= Транзакция.Количество;
		НоваяСтрока.Цена 							= Цена;
		НоваяСтрока.Сумма 							= НоваяСтрока.Цена * НоваяСтрока.КоличествоУпаковок;
		
		Если Склад <> Неопределено Тогда
			НоваяСтрока.Склад 						= Склад;	
		КонецЕсли; 
		
		Если ЗаказКлиента <> Неопределено Тогда
			НоваяСтрока.ЗаказКлиента 				= ЗаказКлиента.Ссылка;
		КонецЕсли;	
		
	КонецЦикла; 
	
	СтруктураДействий = Новый Структура;
	СтруктураДействий.Вставить("ПересчитатьКоличествоЕдиниц");
	СтруктураДействий.Вставить("ЗаполнитьСтавкуНДС", Новый Структура("Организация, НалогообложениеНДС, Дата",
		ДокументОбъект.Организация, ДокументОбъект.НалогообложениеНДС, ДокументОбъект.Дата));
	СтруктураДействий.Вставить("ПересчитатьСуммуНДС",
		ОбработкаТабличнойЧастиКлиентСервер.ПараметрыПересчетаСуммыНДСВСтрокеТЧ(ДокументОбъект));
	СтруктураДействий.Вставить("ПересчитатьСумму");
	СтруктураДействий.Вставить("ПересчитатьСуммуСНДС", Новый Структура("ЦенаВключаетНДС", ДокументОбъект.ЦенаВключаетНДС));	
	
	ОбработкаТабличнойЧастиСервер.ОбработатьТЧ(ДокументОбъект.Товары, СтруктураДействий, Неопределено);
	
	Попытка
		ДокументОбъект.Записать(РежимЗаписиДокумента.Проведение);
	Исключение
		
		Попытка
			
			ДокументОбъект.Записать(РежимЗаписиДокумента.Запись);
			
			ТекстСообщения = СтрШаблон("Не удалось провести документ реализации товаров: %1%2%3", ДокументОбъект.Ссылка, Символы.ПС, 
				ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
			ОбщегоНазначения.СообщитьПользователю(ТекстСообщения, ДокументОбъект.Ссылка);
			
		Исключение
			
			ТекстСообщения = СтрШаблон("Не удалось записать документ реализации товаров по контрагенту: %1%2%3", ДокументОбъект.Контрагент, Символы.ПС,
				ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
			ОбщегоНазначения.СообщитьПользователю(ТекстСообщения);
			
			Возврат Неопределено;
			
		КонецПопытки;
		
	КонецПопытки;        
	
	УстановитьПривилегированныйРежим(Ложь);
	
	Возврат ДокументОбъект.Ссылка;
	
КонецФункции //- ИнфоСофт Мурсалимов Д.Р. 25.03.25 УА #96800

