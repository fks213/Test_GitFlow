//+ ИнфоСофт Ивонин К.А. 19.01.23 УА #53535
Функция ПроверитьИЗаполнитьПараметрыЗапроса(НастройкиСоединения) Экспорт
    
    Если Не ЗначениеЗаполнено(НастройкиСоединения["OzonАдресСервисаAPI"]) Тогда
		ВызватьИсключение("Для данного профиля не заполнен ""Адрес Сервиса Ozon"", проверьте настройки авторизации");
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(НастройкиСоединения["OzonApiKey"]) Тогда
		ВызватьИсключение("Для данного профиля не заполнен ""Ozon Api Key"", проверьте настройки авторизации");
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(НастройкиСоединения["OzonClientID"]) Тогда
		ВызватьИсключение("Для данного профиля не заполнен ""Ozon Client ID"", проверьте настройки авторизации");
	КонецЕсли;
	
	ПараметрыЗапроса = ИС_MP_РаботаСHTTPЗапросамиСервер.ПолучитьСтруктуруHTTPЗапроса();
	
	ПараметрыЗапроса.Сервер = НастройкиСоединения["OzonАдресСервисаAPI"];
	ПараметрыЗапроса.Порт = 443;
	ПараметрыЗапроса.ЗащищенноеСоединение = Истина;
	ПараметрыЗапроса.Заголовки.Вставить("Client-Id", НастройкиСоединения["OzonClientID"]);
	ПараметрыЗапроса.Заголовки.Вставить("Api-Key", НастройкиСоединения["OzonApiKey"]);
	
	Возврат ПараметрыЗапроса;
   	    
КонецФункции //- ИнфоСофт Ивонин К.А. 19.01.23 УА #53535

