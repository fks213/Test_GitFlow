//+ ИнфоСофт Стояк Ю.К. 03.03.2025 УА #93469
Функция ПолучитьЗаказыФБО(Профиль, ДатаПоследнегоОтправления) Экспорт
	
	НастройкиСоединения = ПолучитьНастройкиСоединенияПрофиля(Профиль);
	ПараметрыЗапроса = ПроверитьИЗаполнитьПараметрыЗапроса(НастройкиСоединения);
	
	МассивЗагруженныхЗаданий = Новый Массив;     
		
	//offset = 0;	
	
	Пока Истина Цикл
		
		Тело = Новый Структура;
		Тело.Вставить("dir", "asc");
		
		Фильтр = Новый Структура; 
		Фильтр.Вставить("since", ИС_MP_РаботаСHTTPЗапросамиСервер.ЗаписатьДатуВJSON(ДатаПоследнегоОтправления, ФорматДатыJSON.ISO
		, ВариантЗаписиДатыJSON.УниверсальнаяДата));
		Фильтр.Вставить("to", ИС_MP_РаботаСHTTPЗапросамиСервер.ЗаписатьДатуВJSON(ТекущаяДатаСеанса(), ФорматДатыJSON.ISO
		, ВариантЗаписиДатыJSON.УниверсальнаяДата));  
		
		Тело.Вставить("filter", Фильтр);
		Тело.Вставить("limit", 1000);		
		//Тело.Вставить("offset", offset); 		
		
		Дополнительно = Новый Структура;
		Дополнительно.Вставить("analytics_data", Истина);		
		Дополнительно.Вставить("financial_data", Истина);  
		
		Тело.Вставить("with", Дополнительно);
		
		ПараметрыЗапроса.ТелоСтрока = ИС_MP_РаботаСHTTPЗапросамиСервер.ПолучитьСтрокуJSON(Тело);
		
		Результат = ИС_Ozon_API.ПолучитьСписокОтправленийФБО(Профиль, ПараметрыЗапроса);
		
		Если ЗначениеЗаполнено(Результат) Тогда
			
			Для Каждого Элемент Из Результат Цикл 		
				
				СсылкаЗадания = СоздатьИлиОбновитьОтправлениеФБО(Профиль, Элемент, ДатаПоследнегоОтправления);				 
				
				Если Не СсылкаЗадания.Пустая() Тогда
					
					МассивЗагруженныхЗаданий.Добавить(СсылкаЗадания); 
										
					Статус = ПолучитьСтатусСборочногоЗадания(Элемент.status);
					
					ДатаОтгрузки = ИС_MP_РаботаСHTTPЗапросамиСервер.ПрочитатьДатуИзJSON(Элемент.in_process_at, ФорматДатыJSON.ISO);
										
					ДатаОтгрузкиРекомендуемая = ДатаОтгрузки;
										
					ОбновитьСтатусыЗаказов(Профиль, СсылкаЗадания, Статус, ДатаОтгрузки, ДатаОтгрузкиРекомендуемая);
					
				КонецЕсли;    
				
			КонецЦикла;
			
		Иначе
			Прервать;			
		КонецЕсли;
		
		//offset = offset + Результат.postings.Количество();		
		//
		//Если offset % 1000 <> 0 Тогда
		//	Прервать;
		//КонецЕсли;
		
		Если Результат.Количество() % 1000 <> 0 Тогда
			Прервать;
		КонецЕсли;
								
	КонецЦикла;
	
	Если МассивЗагруженныхЗаданий.Количество() > 0 Тогда
		ПроверитьФункциональныеОпцииСборочныхЗаданий(Профиль, МассивЗагруженныхЗаданий);	
	КонецЕсли;
	
КонецФункции //- ИнфоСофт Стояк Ю.К. 03.03.2025 УА #93469

//+ ИнфоСофт Стояк Ю.К. 03.03.2025 УА #93469
Функция СоздатьИлиОбновитьОтправлениеФБО(Профиль, Данные, ДатаПоследнегоОтправления)

    Событие = "СоздатьИлиОбновитьОтправлениеФБО";
	
	Заказ = Документы.ИС_Ozon_Заказ.НайтиПоНомеру(Данные.posting_number);
	
	Если Заказ.Пустая() Тогда
		Заказ = Документы.ИС_Ozon_Заказ.СоздатьДокумент();
	Иначе
		Заказ = Заказ.ПолучитьОбъект();
	КонецЕсли;		
	
	Заказ.Профиль = Профиль;
	
	ЗаполнитьЗначенияСвойств(Заказ, Данные);
	
	Заказ.Номер = Данные.posting_number;
	Заказ.order_id = Данные.order_id;           	
	Заказ.order_number = Данные.order_number; 
		
	Заказ.Дата = ИС_MP_РаботаСHTTPЗапросамиСервер.ПрочитатьДатуИзJSON(Данные.in_process_at, ФорматДатыJSON.ISO);			
		
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	ИС_Ozon_Склады.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.ИС_Ozon_Склады КАК ИС_Ozon_Склады
		|ГДЕ
		|	ИС_Ozon_Склады.СкладДляЗаказовФБО
		|	И ИС_Ozon_Склады.Профиль = &Профиль";
	
	Запрос.УстановитьПараметр("Профиль", Профиль);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		Заказ.Склад = ВыборкаДетальныеЗаписи.Ссылка;
	КонецЦикла;
	
	Заказ.ЗаказФБО = Истина;
			
	Заказ.products.Очистить();
	
	Для Каждого Элемент Из Данные.products Цикл	
		
		НоваяСтрока = Заказ.products.Добавить();
		
		Запрос = Новый Запрос;
		
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	ИС_Ozon_Номенклатура.Ссылка КАК НоменклатураOzon,
		|	МАКСИМУМ(ИС_Ozon_Штрихкоды.Ссылка) КАК ХарактеристикаOzon
		|ИЗ
		|	Справочник.ИС_Ozon_Номенклатура КАК ИС_Ozon_Номенклатура
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ИС_Ozon_Штрихкоды КАК ИС_Ozon_Штрихкоды
		|		ПО ИС_Ozon_Номенклатура.Профиль = ИС_Ozon_Штрихкоды.ЛичныйКабинет
		|			И ИС_Ozon_Номенклатура.Ссылка = ИС_Ozon_Штрихкоды.Карточка
		|ГДЕ
		|	ИС_Ozon_Номенклатура.offer_id = &offer_id
		|	И ИС_Ozon_Номенклатура.Профиль = &Профиль
		|
		|СГРУППИРОВАТЬ ПО
		|	ИС_Ozon_Номенклатура.Ссылка";
		
		Запрос.УстановитьПараметр("offer_id", Элемент.offer_id);
		Запрос.УстановитьПараметр("Профиль", Профиль);
		
		РезультатЗапроса = Запрос.Выполнить();
		ВыборкаНоменклатуры = РезультатЗапроса.Выбрать();
		
		Пока ВыборкаНоменклатуры.Следующий() Цикл
			
			НоваяСтрока.НоменклатураOzon = ВыборкаНоменклатуры.НоменклатураOzon;	
			НоваяСтрока.ХарактеристикаOzon = ВыборкаНоменклатуры.ХарактеристикаOzon; 
			
		КонецЦикла;
		
		Если Не ЗначениеЗаполнено(НоваяСтрока.НоменклатураOzon) Тогда
			
			НоваяСтрока.НоменклатураOzon = Справочники.ИС_Ozon_Номенклатура.НайтиПоРеквизиту("offer_id", Элемент.offer_id);	
			НоваяСтрока.ХарактеристикаOzon = Справочники.ИС_Ozon_Штрихкоды.НайтиПоНаименованию(НоваяСтрока.НоменклатураOzon.Штрихкод, Истина);
			
		КонецЕсли;
		
		НоваяСтрока.price = Число(Элемент.price);	
		НоваяСтрока.Сумма = Число(Элемент.price) * Элемент.quantity;	
		НоваяСтрока.quantity = Элемент.quantity;
		
	КонецЦикла;
	
	Попытка	      
		
		Заказ.Записать(РежимЗаписиДокумента.Запись);
		ДатаПоследнегоОтправления = Заказ.Дата;
		
		Возврат Заказ.Ссылка;		
	
	Исключение
		ИнформацияОбОшибке = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
		Текст = СтрШаблон("Произошла ошибка при записи элемента Заказ Ozon: %1",	ИнформацияОбОшибке);
		ИС_MP_Сервер.ЗаписатьВЖРИСообщитьПользователю(Событие, Текст);
	КонецПопытки;
	
	Возврат Документы.ИС_Ozon_Заказ.ПустаяСсылка();

КонецФункции //- ИнфоСофт Стояк Ю.К. 03.03.2025 УА #93469

//+ ИнфоСофт Стояк Ю.К. 03.03.2025 УА #93469
Процедура ОбновитьСтатусыСборочныхЗаданийФБО(Профиль, _7Дней = 604800) Экспорт
	
	Событие = "ОбновитьСтатусыСборочныхЗаданийOzon";
		
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ИС_Ozon_Заказ.Ссылка КАК Ссылка,
	|	ИС_Ozon_Заказ.Номер КАК Номер,
	|	ИС_Ozon_Заказ.Заказ КАК Заказ,
	|	ИС_Ozon_СтатусыСборочныхЗаданий.status КАК status,	
	|	ИС_Ozon_СтатусыСборочныхЗаданий.recommended_shipment_date КАК ДатаОтгрузкиРекомендуемая,	
	|	ИС_Ozon_СтатусыСборочныхЗаданий.shipment_date КАК ДатаОтгрузки	
	|ПОМЕСТИТЬ ВТ_Данные                                              	
	|ИЗ
	|	Документ.ИС_Ozon_Заказ КАК ИС_Ozon_Заказ
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ИС_Ozon_СтатусыСборочныхЗаданий КАК ИС_Ozon_СтатусыСборочныхЗаданий
	|		ПО (ИС_Ozon_Заказ.Ссылка = ИС_Ozon_СтатусыСборочныхЗаданий.Заказ)
	|			И (ИС_Ozon_Заказ.Профиль = &Профиль)
	|ГДЕ
	|	НЕ ИС_Ozon_СтатусыСборочныхЗаданий.status ЕСТЬ NULL
	|	И ИС_Ozon_СтатусыСборочныхЗаданий.status В(&Статусы)
	|	И ИС_Ozon_Заказ.Дата >= &Дата	
	|	И ИС_Ozon_Заказ.ЗаказФБО	
	|;
	|		
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_Данные.Ссылка КАК Заказ,
	|	ПередачаТоваровХранителю.Ссылка КАК Реализация
	|ПОМЕСТИТЬ ВТ_РеализацииВсе
	|ИЗ
	|	ВТ_Данные КАК ВТ_Данные
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ПередачаТоваровХранителю КАК ПередачаТоваровХранителю
	|		ПО ВТ_Данные.Заказ = ПередачаТоваровХранителю.ЗаказКлиента
	|			И (НЕ ВТ_Данные.Заказ = ЗНАЧЕНИЕ(Документ.ЗаказКлиента.ПустаяСсылка))
	|ГДЕ
	|	НЕ ПередачаТоваровХранителю.Ссылка ЕСТЬ NULL
	|
	|ОБЪЕДИНИТЬ
	|
	|ВЫБРАТЬ
	|	ВТ_Данные.Ссылка,
	|	ПередачаТоваровХранителюТовары.Ссылка
	|ИЗ
	|	ВТ_Данные КАК ВТ_Данные
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ПередачаТоваровХранителю.Товары КАК ПередачаТоваровХранителюТовары
	|		ПО ВТ_Данные.Заказ = ПередачаТоваровХранителюТовары.ЗаказКлиента
	|			И (НЕ ВТ_Данные.Заказ = ЗНАЧЕНИЕ(Документ.ЗаказКлиента.ПустаяСсылка))
	|ГДЕ
	|	НЕ ПередачаТоваровХранителюТовары.Ссылка ЕСТЬ NULL
	|
	|ОБЪЕДИНИТЬ
	|
	|ВЫБРАТЬ
	|	ВТ_Данные.Ссылка,
	|	РеализацияТоваровУслуг.Ссылка
	|ИЗ
	|	ВТ_Данные КАК ВТ_Данные
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.РеализацияТоваровУслуг КАК РеализацияТоваровУслуг
	|		ПО ВТ_Данные.Заказ = РеализацияТоваровУслуг.ЗаказКлиента
	|			И (НЕ ВТ_Данные.Заказ = ЗНАЧЕНИЕ(Документ.ЗаказКлиента.ПустаяСсылка))
	|ГДЕ
	|	НЕ РеализацияТоваровУслуг.Ссылка ЕСТЬ NULL
	|
	|ОБЪЕДИНИТЬ
	|
	|ВЫБРАТЬ
	|	ВТ_Данные.Ссылка,
	|	РеализацияТоваровУслугТовары.Ссылка
	|ИЗ
	|	ВТ_Данные КАК ВТ_Данные
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.РеализацияТоваровУслуг.Товары КАК РеализацияТоваровУслугТовары
	|		ПО ВТ_Данные.Заказ = РеализацияТоваровУслугТовары.ЗаказКлиента
	|			И (НЕ ВТ_Данные.Заказ = ЗНАЧЕНИЕ(Документ.ЗаказКлиента.ПустаяСсылка))
	|ГДЕ
	|	НЕ РеализацияТоваровУслугТовары.Ссылка ЕСТЬ NULL
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_Реализации.Заказ КАК Заказ,
	|	МАКСИМУМ(ВТ_Реализации.Реализация) КАК Реализация,
	|	СУММА(1) КАК Количество
	|ПОМЕСТИТЬ ВТ_Реализации
	|ИЗ
	|	ВТ_РеализацииВсе КАК ВТ_Реализации
	|
	|СГРУППИРОВАТЬ ПО
	|	ВТ_Реализации.Заказ
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_Данные.Ссылка КАК Ссылка,
	|	ВТ_Данные.Номер КАК Номер,
	|	ВТ_Данные.Заказ КАК Заказ,
	|	ВТ_Данные.status КАК status,
	|	ВТ_Данные.ДатаОтгрузкиРекомендуемая КАК ДатаОтгрузкиРекомендуемая,	
	|	ВТ_Данные.ДатаОтгрузки КАК ДатаОтгрузки,
	|	ЕСТЬNULL(ВТ_Реализации.Количество, 0) КАК КоличествоРТУ
	|ИЗ
	|	ВТ_Данные КАК ВТ_Данные
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_Реализации КАК ВТ_Реализации
	|		ПО ВТ_Данные.Ссылка = ВТ_Реализации.Заказ";	

	Статусы = Новый Массив;
	Статусы.Добавить(Перечисления.ИС_Ozon_СтатусыОтправлений.awaiting_deliver);
	Статусы.Добавить(Перечисления.ИС_Ozon_СтатусыОтправлений.awaiting_packaging);
	Статусы.Добавить(Перечисления.ИС_Ozon_СтатусыОтправлений.delivering);
	
	Запрос.УстановитьПараметр("Статусы", Статусы);
	Запрос.УстановитьПараметр("Профиль", Профиль);
	Запрос.УстановитьПараметр("Дата", ТекущаяДатаСеанса() - _7Дней);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Выборка = РезультатЗапроса.Выбрать();
	
	НастройкиСоединения = ПолучитьНастройкиСоединенияПрофиля(Профиль);
	ПараметрыЗапроса = ПроверитьИЗаполнитьПараметрыЗапроса(НастройкиСоединения);  
		
	НастройкиСборочныхЗаданий = ПолучитьНастройкиФункциональностиСборочныхЗвданий(Профиль);	
	
	Пока Выборка.Следующий() Цикл
		
		Результат = ИС_Ozon_API.ПолучитьИнформциюПоОтправлениюФБО(Профиль, ПараметрыЗапроса, Выборка.Номер);	 
		
		Если Результат = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		Статус = ПолучитьСтатусСборочногоЗадания(Результат.status);
							
		Если Статус = Выборка.status Тогда
			Продолжить;	
		КонецЕсли;
		
		ОбновитьСтатусыЗаказов(Профиль, Выборка.Ссылка, Статус, Выборка.ДатаОтгрузки, Выборка.ДатаОтгрузкиРекомендуемая);
					
	КонецЦикла;	
	
КонецПроцедуры //- ИнфоСофт Стояк Ю.К. 03.03.2025 УА #93469

