Функция ПолучитьНомерЗадания(Профиль, Склад, Создавать = Ложь
	//+ ИнфоСофт Заварин К.В. 11.04.25 УА #77376
	, Грузоместа = 0)
	//- ИнфоСофт Заварин К.В. 11.04.25 УА #77376
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ИС_Ozon_СтатусыСборочныхЗаданий.Заказ.delivery_method_id КАК delivery_method_id,
		|	ИС_Ozon_СтатусыСборочныхЗаданий.Заказ.Склад КАК Склад,
		|	ИС_Ozon_СтатусыСборочныхЗаданий.Заказ КАК Заказ,
		|	ИС_Ozon_СтатусыСборочныхЗаданий.status КАК status,
		|	ИС_Ozon_СтатусыСборочныхЗаданий.shipment_date КАК shipment_date,
		|	ИС_Ozon_СтатусыСборочныхЗаданий.id КАК id
		|ИЗ
		|	РегистрСведений.ИС_Ozon_СтатусыСборочныхЗаданий КАК ИС_Ozon_СтатусыСборочныхЗаданий
		|ГДЕ
		//+ ИнфоСофт Стояк Ю.К. 19.03.2025 УА #88294		
		//|	ИС_Ozon_СтатусыСборочныхЗаданий.Заказ.shipment_date МЕЖДУ &НачалоДня И &КонецДня
		|	(ИС_Ozon_СтатусыСборочныхЗаданий.shipment_date МЕЖДУ &НачалоДня И &КонецДня
		|			ИЛИ ИС_Ozon_СтатусыСборочныхЗаданий.recommended_shipment_date МЕЖДУ &НачалоДня И &КонецДня)
		//- ИнфоСофт Стояк Ю.К. 19.03.2025 УА #88294
		|	И ИС_Ozon_СтатусыСборочныхЗаданий.Профиль = &Профиль
		|	И ИС_Ozon_СтатусыСборочныхЗаданий.Заказ.Склад = &Склад
		//+ ИнфоСофт Стояк Ю.К. 03.03.2025 УА #93469
		|	И НЕ ИС_Ozon_СтатусыСборочныхЗаданий.Заказ.ЗаказФБО
		//- ИнфоСофт Стояк Ю.К. 03.03.2025 УА #93469
		//+ ИнфоСофт Стояк Ю.К. 19.03.2025 УА #88924		
		|
		|УПОРЯДОЧИТЬ ПО
		|	shipment_date";                         
		//- ИнфоСофт Стояк Ю.К. 19.03.2025 УА #88924		
	
	Запрос.УстановитьПараметр("КонецДня", КонецДня(ТекущаяДатаСеанса()));
	Запрос.УстановитьПараметр("НачалоДня", НачалоДня(ТекущаяДатаСеанса()));
	Запрос.УстановитьПараметр("Профиль", Профиль);
	Запрос.УстановитьПараметр("Склад", Склад);
	
	РезультатЗапроса = Запрос.Выполнить();
	СписокЗаданий = РезультатЗапроса.Выгрузить();  
	
	//+ ИнфоСофт Стояк Ю.К. 19.03.2025 УА #8829	
	//ПроверкаЗаполненогоИД = СписокЗаданий.Скопировать(, "shipment_date, id"); 
	//ПроверкаЗаполненогоИД.Свернуть("shipment_date, id");  
	ПроверкаЗаполненогоИД = СписокЗаданий.Скопировать(, "id"); 
	ПроверкаЗаполненогоИД.Свернуть("id");  
	//- ИнфоСофт Стояк Ю.К. 19.03.2025 УА #88294
	
	Если ПроверкаЗаполненогоИД.Количество() = 1 И ПроверкаЗаполненогоИД[0].id <> 0 И Не Создавать Тогда
		Возврат ПроверкаЗаполненогоИД[0].id;
	КонецЕсли;
	
	Если СписокЗаданий.Количество() = 0 Тогда
		ОбщегоНазначения.СообщитьПользователю("Нет заказов по складу " + Склад + " готовых к формированию документов.");
		Возврат Неопределено;
	КонецЕсли;
	
	Непринятые = СписокЗаданий.Скопировать(Новый Структура("status", Перечисления.ИС_Ozon_СтатусыОтправлений.not_accepted));
	ОжидаютУпаковки = СписокЗаданий.Скопировать(Новый Структура("status", Перечисления.ИС_Ozon_СтатусыОтправлений.awaiting_packaging));	
	
	Если Непринятые.Количество() > 0 Или ОжидаютУпаковки.Количество() > 0 Тогда 
		
		ТекстВопроса  = СтрШаблон("Проверьте, что вы собрали все отправления. Изменить состав отгрузки потом будет нельзя.
		|Отправлений: %1
		|Ожидающих сборки: %2
		|Не принятых на сортировочном центре: %3
		|По складу %4", СписокЗаданий.Количество(),
		ОжидаютУпаковки.Количество(), Непринятые.Количество(), Склад);
		
		ОбщегоНазначения.СообщитьПользователю(ТекстВопроса);
		
		Возврат Неопределено;
		
	КонецЕсли;    
		
	ИДметода = СписокЗаданий[0].delivery_method_id;
	Дата = СписокЗаданий[0].shipment_date;
	
	НастройкиСоединения = ПолучитьНастройкиСоединенияПрофиля(Профиль);
	ПараметрыЗапроса = ПроверитьИЗаполнитьПараметрыЗапроса(НастройкиСоединения);
	
	Тело = Новый Структура; 
	
	//+ ИнфоСофт Заварин К.В. 11.04.25 УА #77376
	Если Не Грузоместа = 0 Тогда
		Тело.Вставить("containers_count", Грузоместа);
	КонецЕсли;
	//- ИнфоСофт Заварин К.В. 11.04.25 УА #77376
	
	Тело.Вставить("delivery_method_id", ИДметода);
	Тело.Вставить("departure_date", ИС_MP_РаботаСHTTPЗапросамиСервер.ЗаписатьДатуВJSON(Дата, ФорматДатыJSON.ISO
	, ВариантЗаписиДатыJSON.УниверсальнаяДата));
	
	ПараметрыЗапроса.ТелоСтрока = ИС_MP_РаботаСHTTPЗапросамиСервер.ПолучитьСтрокуJSON(Тело);
	
	Результат = ИС_Ozon_API.СформироватьАктИНакладную(Профиль, ПараметрыЗапроса);

	Если ЗначениеЗаполнено(Результат) Тогда
		
		Для Каждого Задание Из СписокЗаданий Цикл 
			
			МенеджерЗаписи = РегистрыСведений.ИС_Ozon_СтатусыСборочныхЗаданий.СоздатьМенеджерЗаписи();
			МенеджерЗаписи.Профиль = Профиль;
			МенеджерЗаписи.Заказ = Задание.Заказ;
			
			МенеджерЗаписи.Прочитать();
			
			МенеджерЗаписи.Профиль = Профиль;
			МенеджерЗаписи.Заказ = Задание.Заказ;
			МенеджерЗаписи.status = МенеджерЗаписи.status;
			МенеджерЗаписи.posting_number = МенеджерЗаписи.posting_number;
			
			МенеджерЗаписи.id = Результат;
			
			Попытка
				МенеджерЗаписи.Записать(Истина);	
			Исключение
				Текст = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
				ИС_MP_Сервер.ЗаписатьВЖРИСообщитьПользователю("Запись id задания в статусы заказов Ozon", Текст);
			КонецПопытки;  
			
		КонецЦикла; 
		
	КонецЕсли;
	
	ОбщегоНазначения.СообщитьПользователю("Создано задание на формирование документов. Нажмите на кнопку повторно, чтобы узнать статус формирования / получить документы.");
	
	Возврат Результат;
	
КонецФункции //- ИнфоСофт Стояк Ю.К. 20.02.2024 УА #62585

//+ ИнфоСофт Стояк Ю.К. 19.02.2024 УА #62585
Функция СтатусФормированияАктовИНакладных(Профиль, Номер)
	
	НастройкиСоединения = ПолучитьНастройкиСоединенияПрофиля(Профиль);
	ПараметрыЗапроса = ПроверитьИЗаполнитьПараметрыЗапроса(НастройкиСоединения);
	
	Тело = Новый Структура;
	Тело.Вставить("id", Номер);
	
	ПараметрыЗапроса.ТелоСтрока = ИС_MP_РаботаСHTTPЗапросамиСервер.ПолучитьСтрокуJSON(Тело);
	
	Результат = ИС_Ozon_API.СтатусФормированияАктовИНакладных(Профиль, ПараметрыЗапроса);
	
	Если Результат.result.Свойство("act_type") И Результат.result.act_type = "ozon_digital" Тогда
		Результат = ИС_Ozon_API.СтатусФормированияАктовИНакладных(Профиль, ПараметрыЗапроса, Истина);
	Иначе
		Возврат Результат.result.status;
	КонецЕсли;                          
	
	Возврат Результат.status
	
КонецФункции //- ИнфоСофт Стояк Ю.К. 19.02.2024 УА #62585

//+ ИнфоСофт Стояк Ю.К. 19.02.2024 УА #62585
Функция ПолучитьАктыИНакладныеСOzon(ЭлектроннаяВерсия = Ложь, Номер, Профиль);      
	
	НастройкиСоединения = ПолучитьНастройкиСоединенияПрофиля(Профиль);
	ПараметрыЗапроса = ПроверитьИЗаполнитьПараметрыЗапроса(НастройкиСоединения);
	
	Тело = Новый Структура;
	Тело.Вставить("id", Номер);
	
	Если ЭлектроннаяВерсия Тогда
		Тело.Вставить("doc_type", "act_of_acceptance");
	КонецЕсли;
	
	ПараметрыЗапроса.ТелоСтрока = ИС_MP_РаботаСHTTPЗапросамиСервер.ПолучитьСтрокуJSON(Тело);
	
	Возврат ИС_Ozon_API.ПолучитьАктыИНакладныеСOzon(Профиль, ПараметрыЗапроса, ЭлектроннаяВерсия);
	
КонецФункции //- ИнфоСофт Стояк Ю.К. 19.02.2024 УА #62585

//+ ИнфоСофт Заварин К.В. 28.11.24 УА #74680
Функция СоздатьДокументРТУ(Профиль, ДанныеДокумента, ЗаголовокСтруктура, КомиссионнаяОперация) Экспорт
	
	Документ = Документы.РеализацияТоваровУслуг.СоздатьДокумент();
	
	ФункциональныеОпции = ПолучитьНастройкиФункциональностиСборочныхЗвданий(Профиль);
	
	ДатаДокумента = ЗаголовокСтруктура.ПериодOzon.ДатаОкончания;
	Склад = ФункциональныеОпции.OzonСкладРеализации;
	
	Документ.Дата = ДатаДокумента;
			
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("Партнер", ФункциональныеОпции.ПартнерOzon);
	ПараметрыФормы.Вставить("Контрагент", ФункциональныеОпции.КонтрагентOzon);
	
	Если КомиссионнаяОперация Тогда
		ПараметрыФормы.Вставить("Договор", ФункциональныеОпции.ДоговорOzon);
		Документ.Заполнить(ПараметрыФормы);
		Документ.Договор = ФункциональныеОпции.ДоговорOzon; 
		Документ.Соглашение = ФункциональныеОпции.СоглашениеOzon;
		Документ.ХозяйственнаяОперация = Перечисления.ХозяйственныеОперации.ПередачаНаКомиссию;
	Иначе
		ПараметрыФормы.Вставить("Договор", ФункциональныеОпции.OzonДоговорРеализации);
		Документ.Заполнить(ПараметрыФормы);
		Документ.Договор = ФункциональныеОпции.OzonДоговорРеализации; 
		Документ.Соглашение = ФункциональныеОпции.OzonСоглашениеРеализации;
		Документ.ХозяйственнаяОперация = Перечисления.ХозяйственныеОперации.РеализацияКлиенту;
	КонецЕсли;
	
	ИспользоватьСоглашенияСКлиентами = ПолучитьФункциональнуюОпцию("ИспользоватьСоглашенияСКлиентами");
	ИспользоватьДоговорыСКлиентами = ПолучитьФункциональнуюОпцию("ИспользоватьДоговорыСКлиентами");
	
	ЗаполнитьВалюту = Истина;
	
	Если ИспользоватьСоглашенияСКлиентами Тогда 
		Валюта = Документ.Соглашение.Валюта;
		ЗаполнитьВалюту = Ложь;
	КонецЕсли;
	
	Если ЗаполнитьВалюту И ИспользоватьДоговорыСКлиентами Тогда 
		Валюта = Документ.Договор.ВалютаВзаиморасчетов;
	КонецЕсли;
	
	Документ.Валюта = Валюта;

	
	Документ.Контрагент = ФункциональныеОпции.КонтрагентOzon;
	
	Документ.Комментарий = ЗаголовокСтруктура.Комментарий;
	
	Документ.Организация = Профиль.Организация;    
	
	Документ.Склад = Склад; 
		
	Документ.Подразделение = ФункциональныеОпции.ПодразделениеOzon;
	
	Документ.ЦенаВключаетНДС = Истина; 
	
	Документ.ВариантОформленияПродажи = Перечисления.ВариантыОформленияПродажи.РеализацияТоваровУслуг;
	
	Документ.Статус = Перечисления.СтатусыРеализацийТоваровУслуг.Отгружено;  
	
	Документ.СкидкиРассчитаны = Истина; 

	//+ ИнфоСофт Тимофеева А.А. 09.04.2025 УА #97337
	//ОблагаетсяНДС = ИС_WB_СерверУТ11_5.ПолучитьРезультатПроверкиУчетаНДС(Профиль.Организация);
	//
	//Если ОблагаетсяНДС Тогда
	//	Документ.НалогообложениеНДС = Перечисления.ТипыНалогообложенияНДС.ПродажаОблагаетсяНДС;			
	//Иначе
	//	Документ.НалогообложениеНДС = Перечисления.ТипыНалогообложенияНДС.ПродажаНеОблагаетсяНДС;			
	//КонецЕсли;
	НастройкиУчета = УчетНДСУП.ПараметрыУчетаПоОрганизации(Профиль.Организация, ТекущаяДатаСеанса());	
	Документ.НалогообложениеНДС = НастройкиУчета.ОсновноеНалогообложениеНДСПродажи;
	
	Если Документ.НалогообложениеНДС = Перечисления.ТипыНалогообложенияНДС.ПродажаОблагаетсяНДС
		Или Документ.НалогообложениеНДС = Перечисления.ТипыНалогообложенияНДС.ЛьготноеНалогообложениеНДСНаУСН Тогда  	
		ПродажаОблагаетсяНДС = Истина;
	Иначе
		ПродажаОблагаетсяНДС = Ложь;
	КонецЕсли;
	//- ИнфоСофт Тимофеева А.А. 09.04.2025 УА #97337
	
	СуммаДокумента = 0;
	
	Для Каждого Элемент Из ДанныеДокумента Цикл
		
		Цена = Элемент.ЦенаРеализация;
		
		Если Элемент.ЭтоНабор Тогда
			РеквизитыНоменклатуры = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Элемент.Номенклатура,
			"ТипНоменклатуры, ВидНоменклатуры");
			
			Если Элемент.Количество > 0 Тогда
				
				ПараметрыКомплектующих = ПодборТоваровКлиентСервер.ПараметрыТовара();
				
				ПараметрыКомплектующих.Номенклатура   		= Элемент.Номенклатура;
				ПараметрыКомплектующих.НоменклатураНабора   = Элемент.Номенклатура;
				ПараметрыКомплектующих.ХарактеристикаНабора = Элемент.ХарактеристикаНоменклатуры;				
				ПараметрыКомплектующих.КоличествоУпаковок	= Элемент.Количество;
				ПараметрыКомплектующих.ТипНоменклатуры 		= РеквизитыНоменклатуры.ТипНоменклатуры;
				ПараметрыКомплектующих.ВидНоменклатуры 		= РеквизитыНоменклатуры.ВидНоменклатуры;
				ПараметрыКомплектующих.ЭтоТовар 			= Истина;
				ПараметрыКомплектующих.Вставить("ВариантКомплектацииНоменклатуры", Неопределено);
				
				Склады = Новый Массив;
				
				ДополнительныеПараметры = Новый Структура;
				
				ДополнительныеПараметры.Вставить("Дата", 						Документ.Дата);
				ДополнительныеПараметры.Вставить("Валюта", 						Документ.Валюта);
				ДополнительныеПараметры.Вставить("Склады", 						Склады);
				ДополнительныеПараметры.Вставить("Соглашение", 					Документ.Соглашение);
				ДополнительныеПараметры.Вставить("Цена", 						Цена);				
				ДополнительныеПараметры.Вставить("СтоимостьДопУслуг", 			0);	
				ДополнительныеПараметры.Вставить("ВидЦены", 					ПредопределенноеЗначение("Справочник.ВидыЦен.ПустаяСсылка"));
				ДополнительныеПараметры.Вставить("СуммаПродажиКРаспределению", 	Цена);
				ДополнительныеПараметры.Вставить("Комиссия", 					0);
				
				Комплектующие = ИС_МП_УправлениеЗаказами.Комплектующие(ПараметрыКомплектующих, ДополнительныеПараметры);
				
				Для Каждого стрКомплекта Из Комплектующие Цикл			
					НоваяСтрока = Документ.Товары.Добавить();
					
					ЗаполнитьЗначенияСвойств(НоваяСтрока, стрКомплекта);
					
					НоваяСтрока.Количество 					= НоваяСтрока.КоличествоУпаковок;
					НоваяСтрока.Сумма 						= НоваяСтрока.Цена * НоваяСтрока.КоличествоУпаковок
					+ стрКомплекта.Погрешность;
					
					СуммаДокумента							= СуммаДокумента + НоваяСтрока.Сумма;
					
					//+ ИнфоСофт Тимофеева А.А. 09.04.2025 УА #97337
					//Если ОблагаетсяНДС Тогда
					//	НДС = стрКомплекта.Номенклатура.СтавкаНДС.Ставка;
					//	НоваяСтрока.СтавкаНДС = стрКомплекта.Номенклатура.СтавкаНДС; 
					//	Если НДС = Неопределено Или НДС = 0 Тогда 
					//		НоваяСтрока.СуммаНДС = 0;		
					//	Иначе							
					//		//+ ИнфоСофт Стояк Ю.К. 27.02.2025 УА #94698							
					//		//НоваяСтрока.СуммаНДС = ИС_WB_СерверУТ11_5.РассчитатьСуммуНДС(НоваяСтрока.Цена, НДС, Истина);
					//		НоваяСтрока.СуммаНДС = ИС_WB_СерверУТ11_5.РассчитатьСуммуНДС(НоваяСтрока.Сумма, НДС, Истина);
					//		//- ИнфоСофт Стояк Ю.К. 27.02.2025 УА #94698
					//	КонецЕсли;	
					//Иначе
					//	НоваяСтрока.СтавкаНДС = Справочники.СтавкиНДС.НайтиПоНаименованию("Без НДС");
					//КонецЕсли;
					//- ИнфоСофт Тимофеева А.А. 09.04.2025 УА #97337
					
					НоваяСтрока.СуммаСНДС = НоваяСтрока.Сумма;  
					
					//+ ИнфоСофт Тимофеева А.А. 09.04.2025 УА #97337
					Если ПродажаОблагаетсяНДС Тогда
						СтавкаНДС = ИС_МП_УправлениеОтчетами.РассчитатьСтавкуНДС( Документ.Организация
																				, ТекущаяДатаСеанса()
																				, Документ.НалогообложениеНДС
																				, стрКомплекта.Номенклатура);
						НДС 						= СтавкаНДС.Ставка;
						НоваяСтрока.СтавкаНДС 		= СтавкаНДС; 	
						
						Если Не ЗначениеЗаполнено(НДС) Или НДС = 0 Тогда 
							НоваяСтрока.СуммаНДС = 0;						
						Иначе
							НоваяСтрока.СуммаНДС = ИС_WB_СерверУТ11_5.РассчитатьСуммуНДС(НоваяСтрока.СуммаСНДС, НДС, Истина);						
						КонецЕсли;
						
					Иначе
						НоваяСтрока.СтавкаНДС = Справочники.СтавкиНДС.НайтиПоНаименованию("Без НДС");
					КонецЕсли;
					//- ИнфоСофт Тимофеева А.А. 09.04.2025 УА #97337
					
					//+ ИнфоСофт Мурсалимов Д.Р. 12.03.25 УА #95966
					НоваяСтрока.Склад = Склад;
					//- ИнфоСофт Мурсалимов Д.Р. 12.03.25 УА #95966
					
				КонецЦикла;
				
			КонецЕсли;
			
		Иначе		
			
			Если Элемент.Количество > 0 Тогда
				
				НоваяСтрока = Документ.Товары.Добавить();
				
				НоваяСтрока.Номенклатура 					= Элемент.Номенклатура;
				НоваяСтрока.Характеристика 					= Элемент.ХарактеристикаНоменклатуры;				
				НоваяСтрока.Количество 						= Элемент.Количество;
				НоваяСтрока.КоличествоУпаковок 				= Элемент.Количество;	
				НоваяСтрока.Цена 							= Цена;
				НоваяСтрока.Сумма 							= НоваяСтрока.Цена * НоваяСтрока.КоличествоУпаковок;
				
				//+ ИнфоСофт Тимофеева А.А. 09.04.2025 УА #97337
				//Если ОблагаетсяНДС Тогда
				//	НДС = Элемент.Номенклатура.СтавкаНДС.Ставка;
				//	НоваяСтрока.СтавкаНДС = Элемент.Номенклатура.СтавкаНДС; 
				//	Если НДС = Неопределено Или НДС = 0 Тогда 
				//		НоваяСтрока.СуммаНДС = 0;		
				//	Иначе
				//		//+ ИнфоСофт Стояк Ю.К. 27.02.2025 УА #94698							
				//		//НоваяСтрока.СуммаНДС = ИС_WB_СерверУТ11_5.РассчитатьСуммуНДС(НоваяСтрока.Цена, НДС, Истина);
				//		НоваяСтрока.СуммаНДС = ИС_WB_СерверУТ11_5.РассчитатьСуммуНДС(НоваяСтрока.Сумма, НДС, Истина);
				//		//- ИнфоСофт Стояк Ю.К. 27.02.2025 УА #94698
				//	КонецЕсли;	
				//Иначе
				//	НоваяСтрока.СтавкаНДС = Справочники.СтавкиНДС.НайтиПоНаименованию("Без НДС");
				//КонецЕсли;
				//- ИнфоСофт Тимофеева А.А. 09.04.2025 УА #97337
				
				НоваяСтрока.СуммаСНДС = НоваяСтрока.Сумма;
				
				//+ ИнфоСофт Тимофеева А.А. 09.04.2025 УА #97337
				Если ПродажаОблагаетсяНДС Тогда
					СтавкаНДС = ИС_МП_УправлениеОтчетами.РассчитатьСтавкуНДС( Документ.Организация
																		, ТекущаяДатаСеанса()
																		, Документ.НалогообложениеНДС
																		, Элемент.Номенклатура); 
					НДС 						= СтавкаНДС.Ставка;
					НоваяСтрока.СтавкаНДС 		= СтавкаНДС; 
					
					Если Не ЗначениеЗаполнено(НДС) Или НДС = 0 Тогда 					
						НоваяСтрока.СуммаНДС = 0;						
					Иначе
						НоваяСтрока.СуммаНДС = ИС_WB_СерверУТ11_5.РассчитатьСуммуНДС(НоваяСтрока.СуммаСНДС, НДС, Истина); 	
					КонецЕсли;
				
				Иначе
					НоваяСтрока.СтавкаНДС = Справочники.СтавкиНДС.НайтиПоНаименованию("Без НДС");
				КонецЕсли;
				//- ИнфоСофт Тимофеева А.А. 09.04.2025 УА #97337
				
				СуммаДокумента 								= СуммаДокумента + НоваяСтрока.Сумма; 
				
				//+ ИнфоСофт Мурсалимов Д.Р. 12.03.25 УА #95966
				НоваяСтрока.Склад = Склад;
				//- ИнфоСофт Мурсалимов Д.Р. 12.03.25 УА #95966
				
			КонецЕсли;	
			
		КонецЕсли;
		
	КонецЦикла;
	
	Документ.СуммаДокумента = СуммаДокумента;	
	
	Попытка
		Документ.Записать(РежимЗаписиДокумента.Проведение); 
	Исключение
		Документ.Записать();
	КонецПопытки; 
	
	Возврат Документ;
	
КонецФункции //- ИнфоСофт Заварин К.В. 28.11.24 УА #74680

//+ ИнфоСофт Заварин К.В. 29.11.24 УА #74680
Функция СоздатьДокументВозвратТоваровВыкупленныхТоваров(Профиль, ДанныеДокумента, ЗаголовокСтруктура, КомиссионнаяОперация = Ложь) Экспорт
			
	Документ = Документы.ВозвратТоваровОтКлиента.СоздатьДокумент();
	
	ФункциональныеОпции = ПолучитьНастройкиФункциональностиСборочныхЗвданий(Профиль);
	
	ДатаДокумента = ЗаголовокСтруктура.ПериодOzon.ДатаОкончания - 1;
	Склад = ФункциональныеОпции.OzonСкладРеализации;
	
	Документ.Дата = ДатаДокумента;
		
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("Партнер", ФункциональныеОпции.ПартнерOzon);
	ПараметрыФормы.Вставить("Контрагент", ФункциональныеОпции.КонтрагентOzon);
	
	Если КомиссионнаяОперация Тогда
		ПараметрыФормы.Вставить("Договор", ФункциональныеОпции.ДоговорOzon);
		Документ.Соглашение = ФункциональныеОпции.СоглашениеOzon;
		Документ.ХозяйственнаяОперация = Перечисления.ХозяйственныеОперации.ВозвратОтКомиссионера;
	Иначе
		ПараметрыФормы.Вставить("Договор", ФункциональныеОпции.OzonДоговорРеализации);
		Документ.Соглашение = ФункциональныеОпции.OzonСоглашениеРеализации;
		Документ.ХозяйственнаяОперация = Перечисления.ХозяйственныеОперации.ВозвратТоваровОтКлиента;
	КонецЕсли;
	
	Документ.Заполнить(ПараметрыФормы);
	
	//+ ИнфоСофт Заварин К.В. 19.03.25 УА #96620
	Если КомиссионнаяОперация Тогда
		Документ.Договор = ФункциональныеОпции.ДоговорOzon;
		Документ.Соглашение = ФункциональныеОпции.СоглашениеOzon;
		Документ.ХозяйственнаяОперация = Перечисления.ХозяйственныеОперации.ВозвратОтКомиссионера;
	Иначе
		Документ.Договор = ФункциональныеОпции.OzonДоговорРеализации;
		Документ.Соглашение = ФункциональныеОпции.OzonСоглашениеРеализации;
		Документ.ХозяйственнаяОперация = Перечисления.ХозяйственныеОперации.ВозвратТоваровОтКлиента;
