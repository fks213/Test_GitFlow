	ПараметрыЗапроса.ЗащищенноеСоединение = Ложь;
	ПараметрыЗапроса.Сервер = "picabox.ru";
	ПараметрыЗапроса.АдресРесурса = "/image/upload";
	
	ИспользоватьЯндексДиск = Ложь;
	Если ИспользоватьЯндексДиск Тогда
		//СтруктураРезультата = Ozon_ИнтернетЗапросыВызовСервера.СтруктураРезультатаЗапроса("ЯндексДиск.ЗагрузкаФайла");
		//СтруктураРезультата.Вставить("ВладелецФайла", ПрисоединенныйФайл.ВладелецФайла);
		//ЗагрузитьФайлНаЯндексДиск(СтруктураРезультата, ДвоичныеДанныеКартинки, Расширение);
	Иначе				
		//+ ИнфоСофт Стояк Ю.К. 20.02.2025 УА #93500		
		//СсылкаНаКартинку = ЗагрузитьФайлНаPicabox(ПараметрыЗапроса, ДвоичныеДанныеКартинки, Расширение);
		СсылкаНаКартинку = ЗагрузитьФайлНаPicabox(ПараметрыЗапроса, ДвоичныеДанныеКартинки, ПрисоединенныйФайл);
		//- ИнфоСофт Стояк Ю.К. 20.02.2025 УА #93500
	КонецЕсли;

	Возврат СсылкаНаКартинку;   
	
КонецФункции //- ИнфоСофт Стояк Ю.К. 22.01.2024 УА #61983 

//+ ИнфоСофт Стояк Ю.К. 20.02.2025 УА #93500
//+ ИнфоСофт Стояк Ю.К. 22.01.2024 УА #61983
//Функция ЗагрузитьФайлНаPicabox(СтруктураРезультата, ДвоичныеДанныеКартинки, Расширение)
Функция ЗагрузитьФайлНаPicabox(СтруктураРезультата, ДвоичныеДанныеКартинки, ПрисоединенныйФайл)
//- ИнфоСофт Стояк Ю.К. 20.02.2025 УА #93500

	//+ ИнфоСофт Стояк Ю.К. 20.02.2025 УА #93500	
	Тип = ПрисоединенныйФайл.Расширение;
	
	Если Тип = "jpg" Тогда
		Тип = "jpeg";	
	КонецЕсли;
	
	ПоляФормы = Новый Массив;
	
	ПолеФормы = Новый Структура;	
	
	ПолеФормы.Вставить("ИмяПоля",  "ImagesForm[imageFiles][0]");
	ПолеФормы.Вставить("ИмяФайла", ПрисоединенныйФайл.Наименование + "." + Тип);
	ПолеФормы.Вставить("Тип",      "image/" + Тип);
	ПолеФормы.Вставить("Тело",     ДвоичныеДанныеКартинки);
	
	ПоляФормы.Добавить(ПолеФормы);
	
	ПолеФормы = Новый Структура;
	
	ПолеФормы.Вставить("ИмяПоля",  "ImagesForm[text]");
	ПолеФормы.Вставить("ИмяФайла", "");
	ПолеФормы.Вставить("Тип",      "");
	ПолеФормы.Вставить("Тело",     "");
	
	ПоляФормы.Добавить(ПолеФормы);
	
	ДанныеПреобразования = ИС_МП_РаботаСHTTPЗапросами.ДвоичныеДанныеPOSTЗапросаКакФорма(ПоляФормы);
	СтруктураРезультата.ТелоДвоичныеДанные = ДанныеПреобразования.ДвоичныеДанные;
	Размер      = ДанныеПреобразования.Размер;    
	
	СтруктураРезультата.Заголовки.Вставить("Content-Type",   "multipart/form-data; boundary=" + ДанныеПреобразования.Разделитель);
	СтруктураРезультата.Заголовки.Вставить("Content-Lenght", Формат(Размер, "ЧН=0; ЧГ=0;"));

	Результат = ИС_Ozon_API.ОтправитьФайлКартинкиНаPicabox(СтруктураРезультата);
	//- ИнфоСофт Стояк Ю.К. 20.02.2025 УА #93500
	
	Возврат Результат;
		
КонецФункции //- ИнфоСофт Стояк Ю.К. 22.01.2024 УА #61983

//+ ИнфоСофт Стояк Ю.К. 22.01.2024 УА #61983
Процедура ПодготовитьФайлДанных(Знач Boundary, Знач ИмяФайлаДляЗагрузки, Знач ИмяФайлаОтправки)
	
	//Определяем массив для процедуры ОбъединитьФайлы 
	МассивФайловДляОбъединения = Новый Массив; 
	
	//Формируем начальный фрагмент файла POST-запроса 
	//@skip-check missing-temporary-file-deletion
	ИмяФайлаОтправкиНачало = ПолучитьИмяВременногоФайла("txt");
	ФайлОтправкиНачало = Новый ЗаписьТекста(ИмяФайлаОтправкиНачало, КодировкаТекста.ANSI, Символы.ПС, Ложь);
	ФайлОтправкиНачало.ЗаписатьСтроку("--" + Boundary); 
	//Указываем имя файла для передачи 
	ФайлОтправкиНачало.ЗаписатьСтроку("Content-Disposition: form-data; name=""ImagesForm[imageFiles][0]""; filename="""
		+ ИмяФайлаДляЗагрузки + """"); 
	//Указываем тип передаваемых данных. 
	ФайлОтправкиНачало.ЗаписатьСтроку("Content-Type: application/x-octet-stream");
	ФайлОтправкиНачало.ЗаписатьСтроку("");
	ФайлОтправкиНачало.Закрыть();

	МассивФайловДляОбъединения.Добавить(ИмяФайлаОтправкиНачало); 
	
	//Добавляем файл в массив для объединения
	МассивФайловДляОбъединения.Добавить(ИмяФайлаДляЗагрузки); 
	
	
	//Формируем конечный фрагмент файла POST-запроса 
	//@skip-check missing-temporary-file-deletion
	ИмяФайлаОтправкиКонец = ПолучитьИмяВременногоФайла("txt");
	ФайлОтправкиКонец = Новый ЗаписьТекста(ИмяФайлаОтправкиКонец, КодировкаТекста.ANSI, Символы.ПС, Ложь);
	ФайлОтправкиКонец.ЗаписатьСтроку("--" + Boundary); 
	
	//Определяем раздел для каких либо других POST-данных, например содержимого полей виртуальной HTML-формы. 
	ФайлОтправкиКонец.ЗаписатьСтроку("--" + Boundary);
	ФайлОтправкиКонец.ЗаписатьСтроку("Content-disposition: form-data; name=""ImagesForm[text]""" + Символы.ПС);
	ФайлОтправкиКонец.ЗаписатьСтроку(Null); 
	
	//Завершение сообщения для сервера 
	ФайлОтправкиКонец.ЗаписатьСтроку("--" + Boundary + "--");
	ФайлОтправкиКонец.Закрыть();

	МассивФайловДляОбъединения.Добавить(ИмяФайлаОтправкиКонец); 
	
	//Теперь сформированные фрагменты сообщения для сервера объединяем в один файл POST-запроса 
	ОбъединитьФайлы(МассивФайловДляОбъединения, ИмяФайлаОтправки);

	//Удаляем файлы фрагментов сообщения. Больше они не нужны 
	Попытка
		Для Каждого ЭлементМассива Из МассивФайловДляОбъединения Цикл
			УдалитьФайлы(ЭлементМассива);
		КонецЦикла;
	Исключение
		Комментарий = СтрШаблон("Не удалось удалось временный файл после использования: %1%2", Символы.ПС,
			ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));		
	КонецПопытки;
КонецПроцедуры //- ИнфоСофт Стояк Ю.К. 22.01.2024 УА #61983

//+ ИнфоСофт Стояк Ю.К. 22.01.2024 УА #61983
Процедура УстановитьЗаголовокЭлементаФормы(Форма, ИмяЭлемента) Экспорт

	КраткоеНаименованиеОсновнойПодсистемы = КраткоеНаименованиеОсновнойПодсистемы();
	Если КраткоеНаименованиеОсновнойПодсистемы = "УНФ" Тогда

		Если Форма.ИмяФормы = "Обработка.ИС_Ozon_ВыгрузкаКарточек.Форма.ФормаСозданияНоменклатуры" Тогда

			ЭлементФормы = Форма.Элементы.Найти(ИмяЭлемента);
			Если ЭлементФормы <> Неопределено Тогда
				ЭлементФормы.Заголовок = "Категория номенклатуры";
				ЭлементФормы.РасширеннаяПодсказка.Заголовок = "Категория – группа товаров с общими свойствами. Категория описывает общие характеристики входящих в нее товаров – например, категория шампуни, общие свойства – тип волос, назначение – против перхоти или для окрашенных волос и т.п..";
			КонецЕсли
			;

		КонецЕсли;

	КонецЕсли;

КонецПроцедуры //- ИнфоСофт Стояк Ю.К. 22.01.2024 УА #61983

//+ ИнфоСофт Стояк Ю.К. 22.01.2024 УА #61983
Процедура УстановитьСвязиПараметровВыбораХарактеристикиИУпаковки(Форма, ИмяТЧ = "Товары") Экспорт

	ЭлементХарактеристика = Форма.Элементы.Найти("ХарактеристикаНоменклатуры");
	ЭлементУпаковка = Форма.Элементы.Найти("Упаковка");

	КраткоеНаименованиеОсновнойПодсистемы = КраткоеНаименованиеОсновнойПодсистемы();

	СвязиПараметровВыбора = Новый Массив;
	ПараметрыВыбораУпаковки = Новый Массив;

	Если КраткоеНаименованиеОсновнойПодсистемы = "УНФ" Тогда
		СвязиПараметровВыбора.Добавить(Новый СвязьПараметраВыбора("Отбор.Владелец", СтрШаблон(
			"Элементы.%1.ТекущиеДанные.Номенклатура", ИмяТЧ), РежимИзмененияСвязанногоЗначения.Очищать));
		ПараметрыВыбораУпаковки.Добавить(Новый ПараметрВыбора("НеИспользоватьКлассификатор", Истина));
	Иначе
		СвязиПараметровВыбора.Добавить(Новый СвязьПараметраВыбора("Номенклатура", СтрШаблон(
			"Элементы.%1.ТекущиеДанные.Номенклатура", ИмяТЧ), РежимИзмененияСвязанногоЗначения.Очищать));
	КонецЕсли;

	Если Не ЭлементХарактеристика = Неопределено Тогда
		ЭлементХарактеристика.СвязиПараметровВыбора = Новый ФиксированныйМассив(СвязиПараметровВыбора);
	КонецЕсли;

	Если Не ЭлементУпаковка = Неопределено Тогда
		ЭлементУпаковка.СвязиПараметровВыбора = Новый ФиксированныйМассив(СвязиПараметровВыбора);
		ЭлементУпаковка.ПараметрыВыбора = Новый ФиксированныйМассив(ПараметрыВыбораУпаковки);
	КонецЕсли;
КонецПроцедуры //- ИнфоСофт Стояк Ю.К. 22.01.2024 УА #61983

