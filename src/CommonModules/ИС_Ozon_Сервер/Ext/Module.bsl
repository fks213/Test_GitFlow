//+ ИнфоСофт Стояк Ю.К. 19.02.2024 УА #62585
Функция АктИНакладная(Профиль, Склад
	//+ ИнфоСофт Заварин К.В. 11.04.25 УА #77376
	, Грузоместа) Экспорт  
    //- ИнфоСофт Заварин К.В. 11.04.25 УА #77376
	
	//+ ИнфоСофт Стояк Ю.К. 15.03.2024 УА #72125
	//Изменил некоторые названия на капс, без этого не работало
	
	//+ ИнфоСофт Заварин К.В. 11.04.25 УА #77376
	//Номер = ПолучитьНомерЗадания(Профиль, Склад);
	Номер = ПолучитьНомерЗадания(Профиль, Склад,, Грузоместа);
	//- ИнфоСофт Заварин К.В. 11.04.25 УА #77376
	
	Если ЗначениеЗаполнено(Номер) Тогда
		
		СтатусФормированияАктовИНакладных = СтатусФормированияАктовИНакладных(Профиль, Номер);   
		
		Если СтатусФормированияАктовИНакладных = "in_process" Или СтатусФормированияАктовИНакладных = "FORMING" Тогда
			
			ОбщегоНазначения.СообщитьПользователю("Документы формируются, нужно подождать");
			
		ИначеЕсли СтатусФормированияАктовИНакладных = "The next postings aren't ready" Тогда
			
			ОбщегоНазначения.СообщитьПользователю(
			"Произошла ошибка, отправления не включены в отгрузку. Подождите некоторое время и проверьте результат запроса. Если ошибка повторяется, обратитесь в службу поддержки");
		ИначеЕсли СтатусФормированияАктовИНакладных = "cancelled" Тогда
			
			ОбщегоНазначения.СообщитьПользователю(
			"Cоздание документов отменено, выполняется повторный запрос на формирования документов."); 
			
			ПолучитьНомерЗадания(Профиль, Склад, Истина);
			
		ИначеЕсли СтатусФормированияАктовИНакладных = "error" Или СтатусФормированияАктовИНакладных = "UNKNOWN_ERROR" Тогда
			
			ОбщегоНазначения.СообщитьПользователю(
			"Произошла ошибка при формировании документов, выполняется повторный запрос на формирование документов");
			ПолучитьНомерЗадания(Профиль, Склад, Истина);
			
			
		ИначеЕсли СтатусФормированияАктовИНакладных = "not_found" Тогда
			
			ОбщегоНазначения.СообщитьПользователю(
			"Документы не найдены, выполняется повторный запрос на формирование документов");
			ПолучитьНомерЗадания(Профиль, Склад, Истина);
			
		ИначеЕсли СтатусФормированияАктовИНакладных = "ready" Тогда
			
			Возврат ПолучитьАктыИНакладныеСOzon(, Номер, Профиль);
			
		ИначеЕсли СтатусФормированияАктовИНакладных = "FORMED" Или СтатусФормированияАктовИНакладных = "CONFIRMED"
			Или СтатусФормированияАктовИНакладных = "CONFIRMED_WITH_MISMATCH" Тогда
			
			Возврат ПолучитьАктыИНакладныеСOzon(Истина, Номер, Профиль);
			
		КонецЕсли;
		
