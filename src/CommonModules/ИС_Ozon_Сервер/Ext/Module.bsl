Функция ОчиститьПустыеЗначенияМассива(МассивЗначений)

	Результат = Новый Массив;
	Для Каждого значение Из МассивЗначений Цикл

		Если ЗначениеЗаполнено(значение) Тогда
			Результат.Добавить(значение);
		КонецЕсли;

	КонецЦикла;

	Возврат Результат;

КонецФункции //- ИнфоСофт Стояк Ю.К. 04.05.2023 УА #58008 
                                        
//+ ИнфоСофт Стояк Ю.К. 04.05.2023 УА #58008
Функция ОсновныеТоварыПоУцененным(Профиль, МассивSKU)

	СоответствиеОсноныхТоваровУцененным = Новый Соответствие;

	Результат = Новый Массив;

	Если МассивSKU.Количество() = 0 Тогда
		Возврат СоответствиеОсноныхТоваровУцененным;
	КонецЕсли; 
	
	Если Не ЗначениеЗаполнено(Профиль) Тогда
		ОбщегоНазначения.СообщитьПользователю("Не заполнен Профиль. Загрузка товаров невозможна");
		Возврат СоответствиеОсноныхТоваровУцененным;
	КонецЕсли;
	
	НастройкиСоединения = ПолучитьНастройкиСоединенияПрофиля(Профиль);
	ПараметрыЗапроса = ПроверитьИЗаполнитьПараметрыЗапроса(НастройкиСоединения);
	
	items = Неопределено;
	НомерЗапроса = 1;
	
	Пока Истина Цикл
		
		СрезЗначенийОтбора = СрезМассива(МассивSKU, НомерЗапроса);
		Если Не ЗначениеЗаполнено(СрезЗначенийОтбора) Тогда
			Прервать;
		КонецЕсли;
		
		items = ИС_Ozon_API.ИнформацияОбУценкеИОсновномТовареПоSKU(Профиль, ПараметрыЗапроса, СрезЗначенийОтбора);
		Если ЗначениеЗаполнено(items) Тогда
			ОбщегоНазначенияКлиентСервер.ДополнитьМассив(Результат, items);
		КонецЕсли;
		
		НомерЗапроса = НомерЗапроса + 1;
		
	КонецЦикла; 
	
	Для Каждого Товар Из Результат Цикл
		СоответствиеОсноныхТоваровУцененным.Вставить(Товар.discounted_sku, Товар.sku);
	КонецЦикла;
	
	Возврат СоответствиеОсноныхТоваровУцененным;
	
КонецФункции //- ИнфоСофт Стояк Ю.К. 04.05.2023 УА #58008

//+ ИнфоСофт Стояк Ю.К. 04.05.2023 УА #58008
Функция СрезМассива(МассивЭлементов, НомерЗапроса, МаксимальноеКоличествоЭлементов = 500) Экспорт

	Результат = Новый Массив;

	Если ЗначениеЗаполнено(МассивЭлементов) Тогда
		МаксимальныйИндекс = МассивЭлементов.ВГраница();

		НачальныйИндекс = МаксимальноеКоличествоЭлементов * (НомерЗапроса - 1);
		КонечныйИндекс  = Мин(МаксимальноеКоличествоЭлементов * НомерЗапроса - 1, МаксимальныйИндекс);

		Если НачальныйИндекс <= МаксимальныйИндекс Тогда
			Индекс = НачальныйИндекс;
			Пока Индекс <= КонечныйИндекс Цикл
				Результат.Добавить(МассивЭлементов[Индекс]);
				Индекс = Индекс + 1;
			КонецЦикла;
		КонецЕсли;

	КонецЕсли;

	Возврат Результат;

КонецФункции //- ИнфоСофт Стояк Ю.К. 04.05.2023 УА #58008

