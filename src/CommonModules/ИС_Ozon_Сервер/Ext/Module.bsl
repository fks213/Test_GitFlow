Функция СоздатьОбновитьНоменклатуру(Профиль, СтруктураНоменклатуры, Перезаполнять = Ложь) Экспорт

	OzonНоменклатура = Справочники.ИС_Ozon_Номенклатура.НайтиПоКоду(СтруктураНоменклатуры["id"]);
    
    Если OzonНоменклатура.Пустая() Тогда
    	OzonНоменклатура = Справочники.ИС_Ozon_Номенклатура.СоздатьЭлемент();
    Иначе
    		
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	ИС_Ozon_Номенклатура.updated_at КАК updated_at
		|ИЗ
		|	Справочник.ИС_Ozon_Номенклатура КАК ИС_Ozon_Номенклатура
		|ГДЕ
		|	ИС_Ozon_Номенклатура.Ссылка = &Ссылка
		|	И ИС_Ozon_Номенклатура.Профиль = &Профиль";
		
		Запрос.УстановитьПараметр("Ссылка", OzonНоменклатура); 
