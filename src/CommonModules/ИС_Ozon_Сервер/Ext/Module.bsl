//+ ИнфоСофт Стояк Ю.К. 22.01.2024 УА #61983
Процедура ЗагрузитьКатегорииТоваров(Профиль) Экспорт 
	
	НастройкиСоединения = ПолучитьНастройкиСоединенияПрофиля(Профиль);
	ПараметрыЗапроса = ПроверитьИЗаполнитьПараметрыЗапроса(НастройкиСоединения);

	МассивКатегорииТоваров = ИС_Ozon_API.ПолучитьДеревоКатегорий(ПараметрыЗапроса);

	Если МассивКатегорииТоваров = Неопределено Тогда
		Возврат;
	КонецЕсли;

	КатегорииСОбязательнымиСертификатами = КатегорииСОбязательнымиСертификатами(ПараметрыЗапроса);
	МассивАктуальныхКатегорий = Новый Массив;
	ОбработатьКатегорииТоваров(МассивКатегорииТоваров, МассивАктуальныхКатегорий, КатегорииСОбязательнымиСертификатами);
	УдалитьУстаревшиеКатегорииТоваров(МассивАктуальныхКатегорий);

КонецПроцедуры //- ИнфоСофт Стояк Ю.К. 22.01.2024 УА #61983

//+ ИнфоСофт Стояк Ю.К. 22.01.2024 УА #61983
Процедура ЗагрузитьХарактеристикиКатегорий(Профиль, Категория = Неопределено) Экспорт 
	
	НастройкиСоединения = ПолучитьНастройкиСоединенияПрофиля(Профиль);
	ПараметрыЗапроса = ПроверитьИЗаполнитьПараметрыЗапроса(НастройкиСоединения);

	МассивКатегорииТоваров = КатегорииТоваров(Категория);

	СписокХарактеристикКатегорий = ИС_Ozon_API.ПолучитьАтрибутыДляКатегорииТоваров(ПараметрыЗапроса,
		МассивКатегорииТоваров);

	Для Каждого ХарактеристикиКатегории Из СписокХарактеристикКатегорий Цикл

		category_id = ХарактеристикиКатегории.type_id;
		МассивХарактеристик = ХарактеристикиКатегории.attributes;
		ОбработатьХарактеристикиКатегории(МассивХарактеристик, category_id);

	КонецЦикла;

КонецПроцедуры //- ИнфоСофт Стояк Ю.К. 22.01.2024 УА #61983

//+ ИнфоСофт Стояк Ю.К. 22.01.2024 УА #61983
Процедура ЗагрузитьЗначенияХарактеристик(Профиль, Характеристики = Неопределено, Категории = Неопределено, ЗагружатьЗначения = Ложь) Экспорт
	
	НастройкиСоединения = ПолучитьНастройкиСоединенияПрофиля(Профиль);
	ПараметрыЗапроса = ПроверитьИЗаполнитьПараметрыЗапроса(НастройкиСоединения);

	ДеревоХарактеристик = ХарактеристикиКатегорий(Характеристики, Категории, ЗагружатьЗначения);

	Для Каждого Характеристика Из ДеревоХарактеристик.Строки Цикл

		КатегорииИспользующиеХарактеристику = Характеристика.Строки;
		Если Характеристика.ЗначенияЗависятОтКатегории Тогда
			УдалитьЗаписиВРегистрахЗначенияХарактеристикПоКатегориям(Характеристика.Характеристика);
			//УдалитьЗаписиВРегистрахАктуальностьЗначенийХарактеристик(Характеристика.Характеристика);
		КонецЕсли;

		Для Каждого стр Из КатегорииИспользующиеХарактеристику Цикл

			ЗначенияХарактеристики = ИС_Ozon_API.ПолучитьЗначенияАтрибутаКатегории(ПараметрыЗапроса,
				стр.КодКатегории, стр.КодХарактеристики, стр.КодВладельцаКатегории);

			Если стр.ЗначенияЗависятОтКатегории Тогда
				ОбработатьЗначенияХарактеристики(стр.Характеристика, ЗначенияХарактеристики, стр.Категория);
			Иначе

				МассивКатегорий = КатегорииИспользующиеХарактеристику.ВыгрузитьКолонку("Категория");
				НаборЗаписей = РегистрыСведений.ИС_Ozon_ЗначенияХарактеристикПоКатегориям.СоздатьНаборЗаписей();
				//НаборДатаАктуальности = РегистрыСведений.Ozon_АктуальностьЗначенийХарактеристик.СоздатьНаборЗаписей();
				Для Каждого Категория Из МассивКатегорий Цикл

					НаборЗаписей.Отбор.Категория.Установить(Категория);
					НаборЗаписей.Отбор.Характеристика.Установить(стр.Характеристика);
					НаборЗаписей.Записать(Истина);

					//НаборДатаАктуальности.Отбор.Категория.Установить(Категория);
					//НаборДатаАктуальности.Отбор.Характеристика.Установить(стр.Характеристика);
					//НаборДатаАктуальности.Записать(Истина);

				КонецЦикла;

				ОбработатьЗначенияХарактеристики(стр.Характеристика, ЗначенияХарактеристики, ПредопределенноеЗначение(
					"Справочник.ИС_Ozon_КатегорииТоваров.ПустаяСсылка"));

				Прервать;

			КонецЕсли;

			ОбщегоНазначенияБТС.Пауза(1);

		КонецЦикла;

	КонецЦикла;

КонецПроцедуры //- ИнфоСофт Стояк Ю.К. 22.01.2024 УА #61983

//+ ИнфоСофт Стояк Ю.К. 22.01.2024 УА #61983
