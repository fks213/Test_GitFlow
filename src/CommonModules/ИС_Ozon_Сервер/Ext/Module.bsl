			ДобавитьЗапись = Ложь;
			
			//+ ИнфоСофт Макарова Н.Е. 01.04.2025 УА #77424
			АктивныйЗаказ = ПолучитьАктивныйЗаказКлиентаОзон(СборочноеЗадание,
				НЕ ФукнциональныеОпции.ФормироватьЕдиныйЗаказБезРазбиенияOzon, ФукнциональныеОпции.ИспользоватьРазбиениеПоСкладамOzon);
			//- ИнфоСофт Макарова Н.Е. 01.04.2025 УА #77424
			
