						Элемент.Сумма = СуммыПродажи[0];
						СуммыПродажи.Удалить(0);
					КонецЕсли;
					
				КонецЕсли;
				
				Элемент.Цена = Элемент.Сумма / Элемент.Количество;
				
			КонецЕсли;
			
			НоваяСтрока.Номенклатура = Элемент.Номенклатура;
