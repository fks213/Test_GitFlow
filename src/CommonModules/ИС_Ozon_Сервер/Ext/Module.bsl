Функция ЗаполнитьСтруктуруДобавленияТовара(Источник, ПоляАтрибутов, Категория) Экспорт

	СтруктураТовара = СтруктураДобавленияТовара();
	СоответствиеСтавокНДС = СоответствиеСтавокНДС();

	СтруктураТовара.name 			= Источник.Название;
	СтруктураТовара.barcode 		= Источник.Штрихкод;
	СтруктураТовара.offer_id 		= Источник.Артикул;
	//@skip-check wrong-string-literal-content
	//+ ИнфоСофт Стояк Ю.К. 05.03.2024 УА #71269	
	//СтруктураТовара.category_id 	= ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Категория, "Код");
	СтруктураТовара.description_category_id 	= ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Категория, "Код");
	//- ИнфоСофт Стояк Ю.К. 05.03.2024 УА #71269
	СтруктураТовара.price 			= Формат(Источник.Цена, "ЧРД=.; ЧН=0; ЧГ=0");
	СтруктураТовара.old_price 		= Формат(Источник.ЦенаДоСкидки, "ЧРД=.; ЧН=0; ЧГ=0");
	СтруктураТовара.min_price 		= Формат(Источник.ЦенаМинимальная, "ЧРД=.; ЧН=0; ЧГ=0");
	СтруктураТовара.vat 			= СоответствиеСтавокНДС.Получить(Источник.СтавкаНДС);
	СтруктураТовара.depth 			= Источник.ДлинаУпаковки;
	СтруктураТовара.width 			= Источник.ШиринаУпаковки;
	СтруктураТовара.height 			= Источник.ВысотаУпаковки;
	СтруктураТовара.dimension_unit 	= "mm";
	СтруктураТовара.weight 			= Источник.ВесУпаковки;
	СтруктураТовара.weight_unit 	= "g";
	СтруктураТовара.attributes		= МассивЗначенийХарактеристикДобавлениеТовара(Источник, ПоляАтрибутов);
	СтруктураТовара.primary_image	= Источник.СсылкаНаГлавноеФото;
	СтруктураТовара.color_image		= Источник.МаркетинговыйЦвет;
	ОбщегоНазначенияКлиентСервер.ДополнитьМассив(СтруктураТовара.images, Источник.Изображения.ВыгрузитьЗначения(),
		Истина);

