//+ ИнфоСофт Мурсалимов Д.Р. 03.05.24 УА #66901
Процедура УстановитьПараметрыЗапросаЦен(Запрос, Профиль) Экспорт
	
	Событие = ПолучитьИмяСобытия("УстановитьПараметрыЗапросаЦен");
		
	МассивПараметров = ПолучитьСписокПараметровЦен();
	
	Результат = ИС_MP_Сервер.ПолучитьЗначениеНастроек(Профиль, Перечисления.ИС_МП_Маркетплейсы.Озон, МассивПараметров);
	
	СтруктураЦен = ПолучитьСтруктуруПараметровЦен();
	
	ЗаполнитьЗначенияСвойств(СтруктураЦен, Результат);
		
	Запрос.УстановитьПараметр("Маркетплейс"			, Перечисления.ИС_МП_Маркетплейсы.Озон);
	Запрос.УстановитьПараметр("ВидЦены"				, СтруктураЦен.ВидЦены); 
	Запрос.УстановитьПараметр("ВидЦеныСоСкидкой"	, СтруктураЦен.ВидЦеныСоСкидкой);
	Запрос.УстановитьПараметр("ВидЦеныМинимальный"	, СтруктураЦен.ВидЦеныМинимальный);
	//+ ИнфоСофт Заварин К.В. 03.09.24 УА #72696
	Запрос.УстановитьПараметр("ВидЦеныFBO"			, Справочники.ВидыЦен.ПустаяСсылка());
	//- ИнфоСофт Заварин К.В. 03.09.24 УА #72696
	Запрос.УстановитьПараметр("Профиль"				, Профиль); 
	Запрос.УстановитьПараметр("ПустаяУпаковка"		, ИС_MP_СерверЛокализация.ПустаяСсылкаУпаковка());
		
КонецПроцедуры //- ИнфоСофт Мурсалимов Д.Р. 03.05.24 УА #66901

//+ ИнфоСофт Мурсалимов Д.Р. 11.05.24 УА #66901
Функция ПолучитьЦеныFBS(Профиль) Экспорт
	
	НастройкиСоединения = ПолучитьНастройкиСоединенияПрофиля(Профиль);	
	ПараметрыЗапроса = ПроверитьИЗаполнитьПараметрыЗапроса(НастройкиСоединения);
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ИС_Ozon_Номенклатура.Ссылка КАК Ссылка,
	|	ИС_Ozon_Номенклатура.offer_id КАК offer_id
	|ИЗ
	|	Справочник.ИС_Ozon_Номенклатура КАК ИС_Ozon_Номенклатура
	|ГДЕ
	|	ИС_Ozon_Номенклатура.Профиль = &Профиль
	|	И НЕ ИС_Ozon_Номенклатура.offer_id = """"
	|	И НЕ ИС_Ozon_Номенклатура.ПометкаУдаления";
	
	Запрос.УстановитьПараметр("Профиль", Профиль);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаOfferId = РезультатЗапроса.Выбрать();
	
	МассивOfferId = Новый Массив;
	
	Результат = Новый ТаблицаЗначений;
	Результат.Колонки.Добавить("НоменклатураOzon");
	Результат.Колонки.Добавить("OfferId");
	Результат.Колонки.Добавить("Цена");
	Результат.Колонки.Добавить("ЦенаСоСкидкой"); 
	Результат.Колонки.Добавить("ЦенаМинимальная"); 
	
	//+ ИнфоСофт Заварин К.В. 07.04.25 УА #89329
	Результат.Колонки.Добавить("ТоварУчаствуетВАкции");
	Результат.Колонки.Добавить("ЦенаДляПокупателя"); 
	Результат.Колонки.Добавить("ЦенаВаша");
	
	МассивЛожныхАкций = Новый Массив;
    МассивЛожныхАкций.Добавить(6);
    МассивЛожныхАкций.Добавить(330);
   	//- ИнфоСофт Заварин К.В. 07.04.25 УА #89329
	
	Пока ВыборкаOfferId.Следующий() Цикл
	
		НоваяСтрока = Результат.Добавить();
		НоваяСтрока.НоменклатураOzon = ВыборкаOfferId.Ссылка;
		НоваяСтрока.OfferId = ВыборкаOfferId.offer_id;
		
		МассивOfferId.Добавить(ВыборкаOfferId.offer_id);
	
	КонецЦикла;
	
	//+ ИнфоСофт Стояк Ю.К. 26.01.2025 УА #91698	
	//last_id = "";                               
	cursor = "";                               
	//- ИнфоСофт Стояк Ю.К. 26.01.2025 УА #91698
	
	//+ ИнфоСофт Заварин К.В. 07.04.25 УА #89329
	//РазбитыйМассив = ИС_MP_Сервер.РазбитьМассивПоNЭлементов(МассивOfferId, 500);
	РазбитыйМассив = ИС_MP_Сервер.РазбитьМассивПоNЭлементов(МассивOfferId, 1000);
	//- ИнфоСофт Заварин К.В. 07.04.25 УА #89329
	
	Для Каждого Элемент Из РазбитыйМассив Цикл
		
		Фильтр = Новый Структура;
		Фильтр.Вставить("visibility", "ALL");
		Фильтр.Вставить("offer_id", Элемент);
		
		СтруктураТела = Новый Структура; 
		
		СтруктураТела.Вставить("filter", Фильтр);
		//+ ИнфоСофт Стояк Ю.К. 26.01.2025 УА #91698		
		//СтруктураТела.Вставить("last_id", last_id); 
		СтруктураТела.Вставить("cursor", cursor); 
		//- ИнфоСофт Стояк Ю.К. 26.01.2025 УА #91698
		
		СтруктураТела.Вставить("limit", 1000);
		
		ЦеныТоваров = ИС_Ozon_API.ПолучитьИнформациюОЦенах(Профиль, ПараметрыЗапроса, СтруктураТела);
		
		Если ЦеныТоваров = Неопределено Тогда
			Прервать;
		КонецЕсли;
		
		//+ ИнфоСофт Стояк Ю.К. 26.01.2025 УА #91698		
		//last_id = ЦеныТоваров.last_id;             
		cursor = ЦеныТоваров.cursor;             
		//- ИнфоСофт Стояк Ю.К. 26.01.2025 УА #91698
		
		Для Каждого Элемент Из ЦеныТоваров.items Цикл
			
			НайденныеСтроки = Результат.НайтиСтроки(Новый Структура("OfferId", Элемент.offer_id));
			
			Если НайденныеСтроки.Количество() > 0 Тогда
				
				Цены = Элемент.price;
				
				НайденныеСтроки[0].Цена 			= Цены.old_price;
				НайденныеСтроки[0].ЦенаСоСкидкой 	= Цены.price; 
				НайденныеСтроки[0].ЦенаМинимальная 	= Цены.min_price;
				
				//+ ИнфоСофт Заварин К.В. 07.04.25 УА #89329
				НайденныеСтроки[0].ЦенаДляПокупателя 	= Цены.marketing_price; 
				НайденныеСтроки[0].ЦенаВаша 			= Цены.marketing_seller_price;
				
				Для Каждого Акция Из Элемент.marketing_actions.actions Цикл
					
					Если МассивЛожныхАкций.Найти(Акция.value) = Неопределено Тогда
						НайденныеСтроки[0].ТоварУчаствуетВАкции = Истина;		
					КонецЕсли;
					
				КонецЦикла;
				//- ИнфоСофт Заварин К.В. 07.04.25 УА #89329
				
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции //- ИнфоСофт Мурсалимов Д.Р. 11.05.24 УА #66901

