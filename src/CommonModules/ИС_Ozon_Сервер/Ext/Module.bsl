КонецФункции //- ИнфоСофт Стояк Ю.К. 04.05.2023 УА #58008

//+ ИнфоСофт Стояк Ю.К. 04.05.2023 УА #58008
Процедура ЗаполнитьТЧОтчетаКомиссионера(ОтчетКомиссионера, ТаблицаТранзакций, СуммаКомиссия = Неопределено, СтруктураПараметров = Неопределено)
	
	//+ ИнфоСофт Стояк Ю.К. 30.05.2024 УА #74897
	Если ЗначениеЗаполнено(СтруктураПараметров) И СтруктураПараметров.Свойство("СпособРасчетаЦеныВозврата") Тогда
		
		ЦеныВозвратаПоВидуЦен = ?(СтруктураПараметров.СпособРасчетаЦеныВозврата.СпособРасчета = 1, Истина, Ложь);
	
		ВидЦены = СтруктураПараметров.СпособРасчетаЦеныВозврата.ВидЦены; 
		
	Иначе
		
		ЦеныВозвратаПоВидуЦен = Ложь;		
		
	КонецЕсли; 
	//- ИнфоСофт Стояк Ю.К. 30.05.2024 УА #74897
	
	ОтчетКомиссионера.Товары.Очистить();
	ОтчетКомиссионера.ВидыЗапасов.Очистить();
	
	//+ ИнфоСофт Ивонин К.А. 13.03.25 УА #95585
	Комиссия = 0;      
	ОстатокКРаспределению = 0;
	
	Если СуммаКомиссия <> Неопределено Тогда
		
		ОсталосьРаспределить = СуммаКомиссия;
		
		КоличетсвоВозвратовБезПродажи = 0;
		
		Для Каждого Строка Из ТаблицаТранзакций Цикл
			
			Если Строка.ВозвратКоличество > 0 И Строка.Количество = 0 Тогда
				КоличетсвоВозвратовБезПродажи = КоличетсвоВозвратовБезПродажи + 1;		
			КонецЕсли;
			
		КонецЦикла;
		
		КоличествоПродаж = ТаблицаТранзакций.Количество() - КоличетсвоВозвратовБезПродажи;
		
		Если КоличествоПродаж > 0 Тогда
			Комиссия = Окр(СуммаКомиссия / КоличествоПродаж, 2);	
		КонецЕсли;
		
		//+ ИнфоСофт Заварин К.В. 09.04.25 УА #98697
		//ОстатокКРаспределению = СуммаКомиссия - (КоличествоПродаж * Комиссия);			 
		
		Пока КоличествоПродаж * Комиссия >= СуммаКомиссия  Цикл
			Комиссия = Комиссия - 0.01;
		КонецЦикла;

		ОстатокКРаспределению = СуммаКомиссия - (КоличествоПродаж * Комиссия);
		//- ИнфоСофт Заварин К.В. 09.04.25 УА #98697

	КонецЕсли;
	
	КомиссияВСтроке = Комиссия;
	//- ИнфоСофт Ивонин К.А. 13.03.25 УА #95585
	   
	//+ ИнфоСофт Стояк Ю.К. 12.02.2025 УА #89133
	МассивПараметров = ПолучитьСписокПараметровЦен();	
	Результат = ИС_MP_Сервер.ПолучитьЗначениеНастроек(СтруктураПараметров.Профиль, Перечисления.ИС_МП_Маркетплейсы.Озон, МассивПараметров);	
	СтруктураЦен = ПолучитьСтруктуруПараметровЦен();	
	ЗаполнитьЗначенияСвойств(СтруктураЦен, Результат);
	//- ИнфоСофт Стояк Ю.К. 12.02.2025 УА #89133
	Для Каждого Транзакция Из ТаблицаТранзакций Цикл
		
		//+ ИнфоСофт Заварин К.В. 19.09.24 УА #83149
		Если СтруктураПараметров.ЗаполнитьКолонкуПокупательОзон И Не Транзакция = Неопределено Тогда
			
			//+ ИнфоСофт Власова И.С. 10.12.24 УА #87450
			//Покупатель = ?(ЗначениеЗаполнено(ОтчетКомиссионера.Контрагент), ОтчетКомиссионера.Контрагент, Справочники.Контрагенты.ПустаяСсылка());
			Покупатель = СтруктураПараметров.РозничныйПокупательОзон;
			//- ИнфоСофт Власова И.С. 10.12.24 УА #87450
			
			Если ЗначениеЗаполнено(Транзакция.ИннПокупателя) Тогда
				Покупатель = Справочники.Контрагенты.НайтиПоРеквизиту("ИНН", Транзакция.ИннПокупателя);
			КонецЕсли;
				
		КонецЕсли;                     
		//- ИнфоСофт Заварин К.В. 19.09.24 УА #83149
		
		Если Транзакция.ЭтоНабор Тогда
			РеквизитыНоменклатуры = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Транзакция.Номенклатура,
				"ТипНоменклатуры, ВидНоменклатуры");

			Если Транзакция.Количество > 0 Тогда
				
				ПараметрыКомплектующих = ПодборТоваровКлиентСервер.ПараметрыТовара();
				ПараметрыКомплектующих.Номенклатура   		= Транзакция.Номенклатура;
				ПараметрыКомплектующих.НоменклатураНабора   = Транзакция.Номенклатура;
				ПараметрыКомплектующих.ХарактеристикаНабора = Транзакция.ХарактеристикаНоменклатуры;				
				ПараметрыКомплектующих.КоличествоУпаковок	= Транзакция.Количество;
				ПараметрыКомплектующих.ТипНоменклатуры 		= РеквизитыНоменклатуры.ТипНоменклатуры;
				ПараметрыКомплектующих.ВидНоменклатуры 		= РеквизитыНоменклатуры.ВидНоменклатуры;
				ПараметрыКомплектующих.ЭтоТовар 			= Истина;
				ПараметрыКомплектующих.Вставить("ВариантКомплектацииНоменклатуры", Неопределено);
	
				Склады = Новый Массив;
	
				ДополнительныеПараметры = Новый Структура;
				ДополнительныеПараметры.Вставить("Дата", 		ОтчетКомиссионера.Дата);
				ДополнительныеПараметры.Вставить("Валюта", 		ОтчетКомиссионера.Валюта);
				ДополнительныеПараметры.Вставить("Склады", 		Склады);
				ДополнительныеПараметры.Вставить("Соглашение", 	ОтчетКомиссионера.Соглашение);
				ДополнительныеПараметры.Вставить("Цена", 		Транзакция.ЦенаПродовцаСУчетомСкидки);
				ДополнительныеПараметры.Вставить("ЦенаПродажи", Транзакция.ЦенаРеализация);
				//+ ИнфоСофт Сумин Д.В. 16.01.2024 УА #68744
				ДополнительныеПараметры.Вставить("СуммаПродажиКРаспределению", Транзакция.РеализованоНаСумму);
				//ДополнительныеПараметры.Вставить("СуммаПродажиКРаспределению", Транзакция.РеализованоНаСумму + Транзакция.ДоплатаЗаСчетOzon); 
				//- ИнфоСофт Сумин Д.В. 16.01.2024 УА #68744
				//+ ИнфоСофт Сумин Д.В. 12.02.2024 УА #70399
				ДополнительныеПараметры.Вставить("Комиссия", КомиссияВСтроке);
				//ДополнительныеПараметры.Вставить("Комиссия", 	?(Транзакция.ИтогиКомиссияСУчетомСкидокИНаценок < 0, -Транзакция.ИтогиКомиссияСУчетомСкидокИНаценок,
				//Транзакция.ИтогиКомиссияСУчетомСкидокИНаценок));
				//- ИнфоСофт Сумин Д.В. 12.02.2024 УА #70399
				ДополнительныеПараметры.Вставить("СтоимостьДопУслуг", 0);
	            //+ ИнфоСофт Стояк Ю.К. 12.02.2025 УА #89133
				ДополнительныеПараметры.Вставить("ВидЦены", СтруктураЦен.ВидЦеныСоСкидкой);
				//ДополнительныеПараметры.Вставить("ВидЦены", ПредопределенноеЗначение("Справочник.ВидыЦен.ПустаяСсылка"));
				//- ИнфоСофт Стояк Ю.К. 12.02.2025 УА #89133
				//+ ИнфоСофт Мурсалимов Д.Р. 20.08.24 УА #81483
				Комплектующие = ИС_МП_УправлениеЗаказами.Комплектующие(ПараметрыКомплектующих, ДополнительныеПараметры);
				//- ИнфоСофт Мурсалимов Д.Р. 20.08.24 УА #81483
				
				//+ ИнфоСофт Заварин К.В. 18.12.24 УА #89626
				СуммаСравнения 	  = 0;
				КомиссияСравнения = 0;
				//- ИнфоСофт Заварин К.В. 18.12.24 УА #89626
				
				Для Каждого стрКомплекта Из Комплектующие Цикл
	
					НоваяСтрока = ОтчетКомиссионера.Товары.Добавить();
					ЗаполнитьЗначенияСвойств(НоваяСтрока, стрКомплекта);
					
					НоваяСтрока.Сумма 					= НоваяСтрока.Цена * НоваяСтрока.КоличествоУпаковок
														+ стрКомплекта.Погрешность;
														
					//+ ИнфоСофт Мурсалимов Д.Р. 09.09.24 УА #83291									
					НоваяСтрока.СуммаПродажи            = НоваяСтрока.ЦенаПродажи * НоваяСтрока.КоличествоУпаковок
														+ стрКомплекта.ПогрешностьСуммаПродажи;
					НоваяСтрока.СуммаВознаграждения 	= стрКомплекта.Комиссия * НоваяСтрока.КоличествоУпаковок
														+ стрКомплекта.ПогрешностьКомиссия;
					//- ИнфоСофт Мурсалимов Д.Р. 09.09.24 УА #83291
					
					//+ ИнфоСофт Сумин Д.В. 26.04.2024 УА #74634
					НоваяСтрока.НомерСчетаФактурыКомиссионера = Транзакция.НомерСчетФактуры;
					НоваяСтрока.ДатаСчетаФактурыКомиссионера  = Транзакция.ДатаСчетФактуры;
					//- ИнфоСофт Сумин Д.В. 26.04.2024 УА #74634 
					
					//+ ИнфоСофт Заварин К.В. 19.09.24 УА #83149
					НоваяСтрока.Покупатель 					  = Покупатель; 
					//- ИнфоСофт Заварин К.В. 19.09.24 УА #83149
					
					//+ ИнфоСофт Заварин К.В. 18.12.24 УА #89626 
					СуммаСравнения 	  = СуммаСравнения 	  + НоваяСтрока.СуммаПродажи;
					КомиссияСравнения = КомиссияСравнения + НоваяСтрока.СуммаВознаграждения;
					
					Если стрКомплекта = Комплектующие[Комплектующие.Количество()-1] Тогда
						
						Если СуммаСравнения - Транзакция.РеализованоНаСумму > 0 Тогда
							
							НоваяСтрока.СуммаПродажи = НоваяСтрока.СуммаПродажи - (СуммаСравнения - Транзакция.РеализованоНаСумму);
							
						ИначеЕсли СуммаСравнения - Транзакция.РеализованоНаСумму < 0 Тогда
							
							НоваяСтрока.СуммаПродажи = НоваяСтрока.СуммаПродажи + (Транзакция.РеализованоНаСумму - СуммаСравнения);	
							
						КонецЕсли;
						
						Если КомиссияСравнения - КомиссияВСтроке > 0 Тогда
							
							НоваяСтрока.СуммаВознаграждения = НоваяСтрока.СуммаВознаграждения - (КомиссияСравнения - КомиссияВСтроке);
							
						ИначеЕсли КомиссияСравнения - КомиссияВСтроке < 0 Тогда
							
							НоваяСтрока.СуммаВознаграждения = НоваяСтрока.СуммаВознаграждения + (КомиссияВСтроке - КомиссияСравнения);	
							
						КонецЕсли
						
					КонецЕсли;
					//- ИнфоСофт Заварин К.В. 18.12.24 УА #89626
					
				КонецЦикла;
				
			КонецЕсли;
			
			Если Транзакция.ВозвратКоличество > 0 Тогда
				
				ПараметрыКомплектующих = ПодборТоваровКлиентСервер.ПараметрыТовара();
