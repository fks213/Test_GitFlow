Процедура УстановитьПараметровВыбораНоменклатураУслуга(Форма, ИмяЭлемента) Экспорт

	Элемент = Форма.Элементы.Найти(ИмяЭлемента);
	Если Элемент = Неопределено Тогда
		Возврат;
	КонецЕсли;

	КраткоеНаименованиеОсновнойПодсистемы = КраткоеНаименованиеОсновнойПодсистемы();

	ПараметрыВыбора = Новый Массив;

	Если КраткоеНаименованиеОсновнойПодсистемы = "УНФ" Тогда

		ПараметрыВыбора.Добавить(Новый ПараметрВыбора("Отбор.ТипНоменклатуры", ПредопределенноеЗначение(
			"Перечисление.ТипыНоменклатуры.Услуга")));

	Иначе
		ПараметрыВыбора.Добавить(Новый ПараметрВыбора("Отбор.ТипНоменклатуры", ПредопределенноеЗначение(
			"Перечисление.ТипыНоменклатуры.Услуга")));
		ПараметрыВыбора.Добавить(Новый ПараметрВыбора("Отбор.ИспользованиеХарактеристик", ПредопределенноеЗначение(
			"Перечисление.ВариантыИспользованияХарактеристикНоменклатуры.НеИспользовать")));
	КонецЕсли;

	Элемент.ПараметрыВыбора 		= Новый ФиксированныйМассив(ПараметрыВыбора);

КонецПроцедуры //- ИнфоСофт Стояк Ю.К. 22.01.2024 УА #61983

//+ ИнфоСофт Стояк Ю.К. 22.01.2024 УА #61983
Функция КраткоеНаименованиеОсновнойПодсистемы() Экспорт

	Результат = "";

	ПоддерживаемыеПодсистемы = Новый Соответствие;
	ПоддерживаемыеПодсистемы.Вставить("УправлениеТорговлей", "УТ");
	ПоддерживаемыеПодсистемы.Вставить("УправлениеНебольшойФирмой", "УНФ");	

	Модуль_СтандартныеПодсистемыСервер = ОбщегоНазначения.ОбщийМодуль("СтандартныеПодсистемыСервер");
	Модуль_СтандартныеПодсистемыПовтИсп = ОбщегоНазначения.ОбщийМодуль("СтандартныеПодсистемыПовтИсп");

	ОписаниеПодсистемКонфигурации = Модуль_СтандартныеПодсистемыПовтИсп.ОписанияПодсистем().ПоИменам;

	Для Каждого КлючИЗначение Из ПоддерживаемыеПодсистемы Цикл
		ОписаниеПодсистемы = ОписаниеПодсистемКонфигурации.Получить(КлючИЗначение.Ключ + ?(
			Модуль_СтандартныеПодсистемыСервер.ЭтоБазоваяВерсияКонфигурации(), "Базовая", ""));
		Если ОписаниеПодсистемы <> Неопределено Тогда
			Результат = КлючИЗначение.Значение;
			Прервать;
		КонецЕсли;
	КонецЦикла;

	Возврат Результат;

КонецФункции //- ИнфоСофт Стояк Ю.К. 22.01.2024 УА #61983
 
//+ ИнфоСофт Стояк Ю.К. 21.01.2024 УА #61983
Процедура ЗаписатьНастройкиСопоставления(Параметры) Экспорт
	
	 Событие = ПолучитьИмяСобытия("ЗаписатьНастройкиСопоставления");
    
	МассивНаименований = Новый Массив;
	
	Для Каждого Элемент Из Параметры Цикл
		МассивНаименований.Добавить(Элемент.Ключ);
	КонецЦикла;

	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ИС_MP_Настройки.Ссылка КАК Ссылка,
		|	ИС_MP_Настройки.Наименование КАК Наименование
		|ИЗ
		|	Справочник.ИС_MP_Настройки КАК ИС_MP_Настройки
		|ГДЕ
		|	ИС_MP_Настройки.Наименование В(&Наименование)";
		
	Запрос.УстановитьПараметр("Наименование", МассивНаименований);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Выборка = РезультатЗапроса.Выбрать();	
	
	Пока Выборка.Следующий() Цикл
	
		ОбъектЗаписи = Выборка.Ссылка.ПолучитьОбъект();
		ОбъектЗаписи.Значение = Параметры[Выборка.Наименование];
		Параметры.Удалить(Выборка.Наименование);
		
		Попытка
			ОбъектЗаписи.Записать();
		Исключение    
		    ИС_MP_Сервер.ЗаписатьВЖРИСообщитьПользователю(Событие, ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));		    
		КонецПопытки;
		
	КонецЦикла;
	
	Для Каждого Элемент Из Параметры Цикл
	
		ОбъектЗаписи = Справочники.ИС_MP_Настройки.СоздатьЭлемент();				
		ОбъектЗаписи.Наименование = Элемент.Ключ;
		ОбъектЗаписи.Значение = Элемент.Значение;
	
		Попытка
			ОбъектЗаписи.Записать();
		Исключение
			ИС_MP_Сервер.ЗаписатьВЖРИСообщитьПользователю(Событие, ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		КонецПопытки;
	
	КонецЦикла;

КонецПроцедуры //- ИнфоСофт Стояк Ю.К. 21.01.2024 УА #61983

//+ ИнфоСофт Мурсалимов Д.Р. 26.01.24 УА #62628
Процедура ДобавитьСоответствиеНоменклатуры(Профиль, НоменклатураOzon, Номенклатура, 
	Характеристика, Упаковка, ТекНоменклатура = Неопределено, ТекХарактеристика = Неопределено) Экспорт

	НаборЗаписей = РегистрыСведений.ИС_Ozon_СоответствиеХарактеристик.СоздатьНаборЗаписей();
		
	НаборЗаписей.Отбор.НоменклатураOzon.Установить(НоменклатураOzon);
		
	НаборЗаписей.Прочитать(); 
	
	ТребуетсяНоваяЗапись = Истина;	
	Если НаборЗаписей.Количество() > 0 Тогда 
		
		Для Каждого Запись Из НаборЗаписей Цикл
		
			Если Запись.Номенклатура = ТекНоменклатура И Запись.Характеристика = ТекХарактеристика Тогда
			
				Запись.Номенклатура 	= Номенклатура;
				Запись.Характеристика 	= Характеристика;
				Запись.Упаковка 		= Упаковка;
        		ТребуетсяНоваяЗапись 	= Ложь;
        		Прервать;
			
			КонецЕсли;
		
		КонецЦикла; 	
	
	КонецЕсли;
   
    Если ТребуетсяНоваяЗапись Тогда
	
		НоваяЗапись = НаборЗаписей.Добавить();
		
		НоваяЗапись.НоменклатураOzon 	= НоменклатураOzon;
		НоваяЗапись.Номенклатура 		= Номенклатура; 
		НоваяЗапись.Характеристика 		= Характеристика;
		НоваяЗапись.Упаковка 			= Упаковка;
		
	КонецЕсли;
				
	НаборЗаписей.Записывать = Истина; 
	
	НаборЗаписей.Записать(Истина);
	
КонецПроцедуры //- ИнфоСофт Мурсалимов Д.Р. 26.01.24 УА #62628

