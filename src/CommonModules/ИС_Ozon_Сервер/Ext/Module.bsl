//+ ИнфоСофт Сумин Д.В. 15.12.2023 УА #65730
Функция ПолучитьСписокТранзакций(Профиль, Период) Экспорт
	
	НастройкиСоединения = ПолучитьНастройкиСоединенияПрофиля(Профиль);
		
	Если НастройкиСоединения = Неопределено Тогда
		ВызватьИсключение("Не удалось получить настройки подключения, проверьте настройки авторизации");
	КонецЕсли;  
		
	НастройкиСоединения = ПолучитьНастройкиСоединенияПрофиля(Профиль);
	ПараметрыЗапроса = ПроверитьИЗаполнитьПараметрыЗапроса(НастройкиСоединения);
		
	СтруктураТела = Новый Структура;
	
	СтруктураДат = Новый Структура;
	СтруктураДат.Вставить("from", ИС_MP_РаботаСHTTPЗапросамиСервер.ЗаписатьДатуВJSON(Период.ДатаНачала, ФорматДатыJSON.ISO
		, ВариантЗаписиДатыJSON.УниверсальнаяДата));
	СтруктураДат.Вставить("to", ИС_MP_РаботаСHTTPЗапросамиСервер.ЗаписатьДатуВJSON(Период.ДатаНачала, ФорматДатыJSON.ISO
		, ВариантЗаписиДатыJSON.УниверсальнаяДата));

	
	Фильтр = Новый Структура;
	Фильтр.Вставить("date", СтруктураДат);
	Фильтр.Вставить("operation_type", Новый Массив);
	Фильтр.Вставить("posting_number", "");
	Фильтр.Вставить("transaction_type", "all");
	
	СтруктураТела.Вставить("filter", Фильтр);
	СтруктураТела.Вставить("page", 1);   	
	СтруктураТела.Вставить("page_size", 1000);
	
	Результат = ИС_Ozon_API.ПолучитьСписокТранзакций(Профиль, ПараметрыЗапроса, СтруктураТела);
	
	ТаблицаУслуг = ОбработатьРезультат(Результат.operations);
	
КонецФункции //- ИнфоСофт Сумин Д.В. 15.12.2023 УА #65730

