Функция ДобавитьСопоставление(ТаблицаТранзакций, Профиль) Экспорт
	
	МассивSKU 					= ТаблицаТранзакций.ВыгрузитьКолонку("SKU");
	МассивSKU 					= ОбщегоНазначенияКлиентСервер.СвернутьМассив(МассивSKU);
	SKUТоваров					= ОчиститьПустыеЗначенияМассива(МассивSKU);
	ОсновныеТоварыПоУцененным 	= ОсновныеТоварыПоУцененным(Профиль, SKUТоваров);
	
	Для Каждого транзакция Из ТаблицаТранзакций Цикл
		
		Если Не ОсновныеТоварыПоУцененным.Получить(транзакция.sku) = Неопределено Тогда
			транзакция.sku = ОсновныеТоварыПоУцененным.Получить(транзакция.sku);
		КонецЕсли;
		
	КонецЦикла;
	
