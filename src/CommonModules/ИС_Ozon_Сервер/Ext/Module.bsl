//+ ИнфоСофт Стояк Ю.К. 22.03.2024 УА #62623
Процедура ЗагрузитьДанныеУслуг(Профиль, ДатаТело) Экспорт
	
	Событие = ПолучитьИмяСобытия("ЗагрузитьДанныеУслуг");
	
 	НастройкиСоединения = ПолучитьНастройкиСоединенияПрофиля(Профиль);
		
	Если НастройкиСоединения = Неопределено Тогда
		ВызватьИсключение("Не удалось получить настройки подключения, проверьте настройки авторизации");
	КонецЕсли;  
			
	ПараметрыЗапроса = ПроверитьИЗаполнитьПараметрыЗапроса(НастройкиСоединения);
	
	МассивТипов = Новый Массив;
	МассивТипов.Добавить("services");
	МассивТипов.Добавить("compensation");
	МассивТипов.Добавить("transferDelivery");
	МассивТипов.Добавить("other");
	//+ ИнфоСофт Стояк Ю.К. 25.03.2025 УА #67821
	МассивТипов.Добавить("orders");
	МассивТипов.Добавить("returns ");
	//- ИнфоСофт Стояк Ю.К. 25.03.2025 УА #67821
	
	РазмерСтраницы = 1000;
	
	ТелоЗапроса = Новый Структура;
	ТелоЗапроса.Вставить("page_size", РазмерСтраницы);
	
	Для Каждого Тип Из МассивТипов Цикл  
		
		Фильтр = Новый Структура;
		
		Фильтр.Вставить("transaction_type", Тип);
		Фильтр.Вставить("date", ДатаТело);     
		
		ТелоЗапроса.Вставить("filter", Фильтр);
		
		НомерСтраницы = 1; 
		
		Пока Истина Цикл 
			
			ТелоЗапроса.Вставить("page", НомерСтраницы);
			
			Результат = ИС_Ozon_API.ПолучитьДанныеПоУслугам(Профиль, ПараметрыЗапроса, ТелоЗапроса);
			
			Если Результат = Неопределено Тогда
				Продолжить;
			КонецЕсли;
			
			//+ ИнфоСофт Стояк Ю.К. 02.10.2024 УА #84454
			Если Результат.page_count = 0 Тогда
				ОбщегоНазначения.СообщитьПользователю("Данных по улсугам не найдено за выбранный период.");
				Прервать;
			КонецЕсли;
			//- ИнфоСофт Стояк Ю.К. 02.10.2024 УА #84454
			
			Если Результат.operations.Количество() = 0 Тогда
				Продолжить;
			КонецЕсли;
			
			Для Каждого Элемент Из Результат.operations Цикл 
				
				СтроковаяДата = Элемент.operation_date;             
				СтроковаяДата = СтрЗаменить(СтроковаяДата, "-", "");
				СтроковаяДата = СтрЗаменить(СтроковаяДата, " ", "");
				СтроковаяДата = СтрЗаменить(СтроковаяДата, ":", ""); 
				
				operation_date = Дата(СтроковаяДата);    
				
				Если Элемент.posting.order_date <> "" Тогда
					СтроковаяДата = Элемент.posting.order_date;
					СтроковаяДата = СтрЗаменить(СтроковаяДата, "-", "");
					СтроковаяДата = СтрЗаменить(СтроковаяДата, " ", "");
					СтроковаяДата = СтрЗаменить(СтроковаяДата, ":", "");	
					
					order_date = Дата(СтроковаяДата);          
				Иначе                                      
					order_date = operation_date;
				КонецЕсли;
					
				НаборЗаписей = РегистрыСведений.ИС_Ozon_ДанныеУслуг.СоздатьНаборЗаписей();
				
				НаборЗаписей.Отбор.Период.Установить(operation_date);
				НаборЗаписей.Отбор.Профиль.Установить(Профиль);
				НаборЗаписей.Отбор.operation_id.Установить(Элемент.operation_id);
				НаборЗаписей.Отбор.operation_type.Установить(Элемент.operation_type);
				НаборЗаписей.Отбор.posting_number.Установить(Элемент.posting.posting_number);
				
				ТребуетсяНоваяЗапись = Истина;	
				
				Если НаборЗаписей.Количество() > 0 Тогда 
					
					Для Каждого Запись Из НаборЗаписей Цикл
						
						Если Запись.amount = Элемент.amount И Запись.delivery_charge = Элемент.delivery_charge
							И Запись.return_delivery_charge = Элемент.return_delivery_charge И Запись.accruals_for_sale = Элемент.accruals_for_sale
							И Запись.sale_commission = Элемент.sale_commission Тогда
							ТребуетсяНоваяЗапись 	= Ложь;
							Прервать;
							
						КонецЕсли;
						
					КонецЦикла; 	
					
				КонецЕсли;
				
				Если ТребуетсяНоваяЗапись Тогда
					
					НоваяЗапись = НаборЗаписей.Добавить(); 
					
					НоваяЗапись.Период = operation_date;
					НоваяЗапись.operation_id = Элемент.operation_id;
					НоваяЗапись.operation_type = Элемент.operation_type;
					НоваяЗапись.posting_number = Элемент.posting.posting_number; 
					
					НоваяЗапись.delivery_charge = Элемент.delivery_charge;
					НоваяЗапись.return_delivery_charge = Элемент.return_delivery_charge;
					НоваяЗапись.accruals_for_sale = Элемент.accruals_for_sale;
					НоваяЗапись.sale_commission = Элемент.sale_commission;
					НоваяЗапись.amount = Элемент.amount;     
					
					НоваяЗапись.operation_type_name = Элемент.operation_type_name;
					НоваяЗапись.warehouse_id = Элемент.posting.warehouse_id;
					НоваяЗапись.delivery_schema = Элемент.posting.delivery_schema;
					НоваяЗапись.type = Перечисления.ИС_Ozon_ТипыОперацийВТранзакциях[Элемент.type];
					НоваяЗапись.order_date = order_date;
					
					НоваяЗапись.Профиль = Профиль;
					
					НаборЗаписей.Записать(Истина);
					
				КонецЕсли;
				
			КонецЦикла; 
			
			Если НомерСтраницы = Результат.page_count Тогда
				Прервать; 
			КонецЕсли;
			
			НомерСтраницы = НомерСтраницы + 1;
			
		КонецЦикла; 
		
	КонецЦикла;
	
	
КонецПроцедуры //- ИнфоСофт Стояк Ю.К. 22.03.2024 УА #62623

