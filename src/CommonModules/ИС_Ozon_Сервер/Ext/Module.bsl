		РезультатЗапроса = Запрос.Выполнить();
		
		ВыборкаДаты = РезультатЗапроса.Выбрать();
		
		Если ВыборкаДаты.Следующий() Тогда
			ПоследнееИзменение = ВыборкаДаты.updated_at;
