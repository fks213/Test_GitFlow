//+ ИнфоСофт Стояк Ю.К. 22.01.2024 УА #61983
Функция ПреобразоватьМногострочныйТекстВHTML(МногострочныйТекст) Экспорт

	Если Не ЗначениеЗаполнено(МногострочныйТекст) Тогда
		Возврат "";
	КонецЕсли;

	HTMLДокумент = "";
	Вложения = Новый Структура;
	Док = Новый ФорматированныйДокумент;
	Док.Добавить(МногострочныйТекст, ТипЭлементаФорматированногоДокумента.Текст);

	Док.ПолучитьHTML(HTMLДокумент, Вложения);

	НачПоз =  СтрНайти(HTMLДокумент, "<p>") + СтрДлина("<p>");
	КонПоз = СтрНайти(HTMLДокумент, "</p>");

	ТекстВHTML = Сред(HTMLДокумент, НачПоз, КонПоз - НачПоз);

	Возврат ТекстВHTML;

КонецФункции //- ИнфоСофт Стояк Ю.К. 22.01.2024 УА #61983

