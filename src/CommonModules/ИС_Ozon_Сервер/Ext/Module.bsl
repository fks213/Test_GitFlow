//+ ИнфоСофт Стояк Ю.К. 22.01.2024 УА #61983
Функция ПолучитьКартинкиПоВладельцу(ВладелецФайлов, РасширенияДляВыгрузкиКартинок) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ПрисоединенныеФайлы.Ссылка КАК Ссылка,
	|	ПрисоединенныеФайлы.Расширение КАК Расширение,
	|	ПрисоединенныеФайлы.Размер КАК Размер
	|ИЗ
	|	ИсточникДанных КАК ПрисоединенныеФайлы
	|ГДЕ
	|	ПрисоединенныеФайлы.ВладелецФайла = &ВладелецФайлов";

	ИмяТаблицы = "Справочник." + ВладелецФайлов.Метаданные().Имя + "ПрисоединенныеФайлы";
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "ИсточникДанных", ИмяТаблицы);

	Запрос.УстановитьПараметр("ВладелецФайлов", ВладелецФайлов);

	МассивСсылок = Новый Массив;

	РезультатЗапроса = Запрос.Выполнить();

	Если РезультатЗапроса.Пустой() Тогда
		Возврат МассивСсылок;

	КонецЕсли;

	СтрокаРасширений = ВРег(РасширенияДляВыгрузкиКартинок);
	Выборка = РезультатЗапроса.Выбрать();
	ОграничениеПоРазмеруФото = 10 * 1000 * 1000;
	Пока Выборка.Следующий() Цикл
		Если СтрНайти(СтрокаРасширений, ВРег(Выборка.Расширение)) > 0 И Выборка.Размер < ОграничениеПоРазмеруФото
			И Выборка.Ссылка <> ВладелецФайлов.ФайлКартинки Тогда
			МассивСсылок.Добавить(Выборка.Ссылка);
		КонецЕсли;
	КонецЦикла;

	Возврат МассивСсылок;
КонецФункции //- ИнфоСофт Стояк Ю.К. 22.01.2024 УА #61983 

//+ ИнфоСофт Стояк Ю.К. 22.01.2024 УА #61983
Функция ОбработатьСсылки(ЗначениеХарактеристикиOzon) Экспорт

	Если ТипЗнч(ЗначениеХарактеристикиOzon) = Тип("Массив") Тогда
		Счетчик = 0;
		МассивРезультата = Новый Массив;
		Для Каждого СтрокаМассива Из ЗначениеХарактеристикиOzon Цикл

			МассивРезультата.Добавить(ОбработатьСсылку(СтрокаМассива));
			Счетчик = Счетчик + 1;

			Если Счетчик = 14 Тогда
				Прервать;
			КонецЕсли;

		КонецЦикла;

		Возврат МассивРезультата;
	Иначе
		Возврат ОбработатьСсылку(ЗначениеХарактеристикиOzon);
	КонецЕсли;

КонецФункции //- ИнфоСофт Стояк Ю.К. 22.01.2024 УА #61983

//+ ИнфоСофт Стояк Ю.К. 22.01.2024 УА #61983
Функция ОбработатьСсылку(ЗначениеХарактеристикиOzon)

	Если ТипЗнч(ЗначениеХарактеристикиOzon) = Тип("Строка") Тогда

		Возврат ПолучитьАдресИзСсылкиИзHTMLТэга(ЗначениеХарактеристикиOzon);

	ИначеЕсли ТипЗнч(ЗначениеХарактеристикиOzon) = Тип("СправочникСсылка.НоменклатураПрисоединенныеФайлы")
		Или (КраткоеНаименованиеОсновнойПодсистемы() = "УНФ" 
		И ТипЗнч(ЗначениеХарактеристикиOzon) = Тип("СправочникСсылка.ХарактеристикиНоменклатурыПрисоединенныеФайлы")) Тогда

		Возврат ПолучитьВнешнююСсылкуНаКартинку(ЗначениеХарактеристикиOzon);

	КонецЕсли;

КонецФункции //- ИнфоСофт Стояк Ю.К. 22.01.2024 УА #61983

//+ ИнфоСофт Стояк Ю.К. 22.01.2024 УА #61983
Функция ПолучитьАдресИзСсылкиИзHTMLТэга(Знач СтрокаСоСсылкой) Экспорт

	Адрес = "";
	ПозицияНачалаСсылки = Найти(НРег(СтрокаСоСсылкой), "<a");
	Если ПозицияНачалаСсылки > 0 Тогда
		СтрокаСоСсылкой = Сред(СтрокаСоСсылкой, ПозицияНачалаСсылки);
		МассивИзСтрок = СтрРазделить(СтрокаСоСсылкой, """");
		Если МассивИзСтрок.Количество() > 1 Тогда
			Адрес = МассивИзСтрок[1];
		КонецЕсли;
	Иначе
		Адрес = СтрокаСоСсылкой;
	КонецЕсли;

	Возврат Адрес;  
	
КонецФункции //- ИнфоСофт Стояк Ю.К. 22.01.2024 УА #61983

