//+ ИнфоСофт Стояк Ю.К. 20.03.2023 УА #54628
Процедура СоздатьЗаказы(Профиль, МассивЗаданий) Экспорт  
	
	Событие = "СоздатьЗаказыOzon";
    
	Запрос = Новый Запрос;
	Запрос.Текст =
	//+ ИнфоСофт Мурсалимов Д.Р. 11.12.23 УА #67325
	"ВЫБРАТЬ
	|	ИС_Ozon_Заказ.Ссылка КАК Ссылка
	|ИЗ
	|	Документ.ИС_Ozon_Заказ КАК ИС_Ozon_Заказ
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ИС_Ozon_СтатусыСборочныхЗаданий КАК ИС_Ozon_СтатусыСборочныхЗаданий
	|		ПО (ИС_Ozon_СтатусыСборочныхЗаданий.Заказ = ИС_Ozon_Заказ.Ссылка
	|			И ИС_Ozon_СтатусыСборочныхЗаданий.Профиль = &Профиль)
	|ГДЕ
	|	ИС_Ozon_Заказ.Ссылка В(&МассивСсылок)
	|	И ИС_Ozon_Заказ.Заказ = ЗНАЧЕНИЕ(Документ.ЗаказКлиента.ПустаяСсылка)
	|	И ИС_Ozon_СтатусыСборочныхЗаданий.status <> ЗНАЧЕНИЕ(Перечисление.ИС_Ozon_СтатусыОтправлений.cancelled)
	|	И ИС_Ozon_СтатусыСборочныхЗаданий.status <> ЗНАЧЕНИЕ(Перечисление.ИС_Ozon_СтатусыОтправлений.cancelled_from_split_pending)";	
	
	Запрос.УстановитьПараметр("Профиль", Профиль);
	//- ИнфоСофт Мурсалимов Д.Р. 06.12.23 УА #67325
	
	Запрос.УстановитьПараметр("МассивСсылок", МассивЗаданий);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Выборка = РезультатЗапроса.Выбрать();
	
	МассивКСозданию = Новый Массив();
	Пока Выборка.Следующий() Цикл
		МассивКСозданию.Добавить(Выборка.Ссылка);	
	КонецЦикла;
	
	ФукнциональныеОпции = ПолучитьНастройкиФункциональностиСборочныхЗвданий(Профиль);
	
	Если ФукнциональныеОпции.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	Если МассивКСозданию.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
    	
	Если ФукнциональныеОпции.РежимСозданияЗаказовOzon = 0 Тогда // Один к одному
	
		Для Каждого СборочноеЗадание Из МассивКСозданию Цикл
			
			Заказ = СоздатьИлиДополнитьЗаказУТ11_5(СборочноеЗадание, ФукнциональныеОпции);
			
			Если Не Заказ.Пустая() Тогда
			
				ДокОбъект = СборочноеЗадание.ПолучитьОбъект();
				ДокОбъект.Заказ = Заказ;
				
				Попытка
					ДокОбъект.Записать();
				Исключение
					Текст = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
					ИС_MP_Сервер.ЗаписатьВЖРИСообщитьПользователю(Событие, Текст);
				КонецПопытки;
			
			КонецЕсли; 	
			
		КонецЦикла;
		
	ИначеЕсли ФукнциональныеОпции.РежимСозданияЗаказовOzon = 1 Тогда // Пакетный режим
		
		//+ ИнфоСофт Заварин К.В. 02.08.24 УА #80812 
		
		МассивСтатусов = Новый Массив;
		МассивСтатусов.Добавить(Перечисления.ИС_Ozon_СтатусыОтправлений.cancelled);
		МассивСтатусов.Добавить(Перечисления.ИС_Ozon_СтатусыОтправлений.cancelled_from_split_pending);
		
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	ИС_Ozon_Заказ.Ссылка КАК Ссылка,
		|	ИС_Ozon_Заказ.Склад КАК Склад
		|ИЗ
		|	Документ.ИС_Ozon_Заказ КАК ИС_Ozon_Заказ
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ИС_Ozon_СтатусыСборочныхЗаданий КАК ИС_Ozon_СтатусыСборочныхЗаданий
		|		ПО (ИС_Ozon_СтатусыСборочныхЗаданий.Заказ = ИС_Ozon_Заказ.Ссылка
		|			И ИС_Ozon_СтатусыСборочныхЗаданий.Профиль = &Профиль)
		|ГДЕ
		|	ИС_Ozon_Заказ.Ссылка В(&МассивСсылок)
		|	И ИС_Ozon_Заказ.Заказ = ЗНАЧЕНИЕ(Документ.ЗаказКлиента.ПустаяСсылка)
		|	И НЕ ИС_Ozon_СтатусыСборочныхЗаданий.status В(&МассивСтатусов) 
		|ИТОГИ ПО
		|	Склад";
		Запрос.УстановитьПараметр("МассивСсылок", МассивКСозданию);
		Запрос.УстановитьПараметр("МассивСтатусов", МассивСтатусов);

		Запрос.УстановитьПараметр("Профиль", Профиль);
		
		РезультатЗапроса = Запрос.Выполнить();
				
		Выборка = РезультатЗапроса.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
		
		Пока Выборка.Следующий() Цикл
			ВыборкаДетальныеЗаписи = Выборка.Выбрать();
			Заказ = Неопределено;
			Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
				Заказ = СоздатьИлиДополнитьЗаказУТ11_5(ВыборкаДетальныеЗаписи.Ссылка, ФукнциональныеОпции, Заказ);
				
				Если Не Заказ.Пустая() И Заказ <> Неопределено Тогда	
					ДокОбъект = ВыборкаДетальныеЗаписи.Ссылка.ПолучитьОбъект();
					ДокОбъект.Заказ = Заказ;
					
					Попытка	
						ДокОбъект.Записать();
						
					Исключение
						Текст = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
						ИС_MP_Сервер.ЗаписатьВЖРИСообщитьПользователю(Событие, Текст);
					КонецПопытки; 
				КонецЕсли;	
			КонецЦикла;	
		КонецЦикла;
		
		//Заказ = СоздатьИлиДополнитьЗаказУТ11_5(МассивКСозданию[0], ФукнциональныеОпции);
		//	
		//Если Не Заказ.Пустая() Тогда
		//
		//	ДокОбъект = МассивКСозданию[0].ПолучитьОбъект();
		//	ДокОбъект.Заказ = Заказ;
		//	
		//	Попытка
		//		ДокОбъект.Записать();
		//	Исключение
		//		Текст = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
		//		ИС_MP_Сервер.ЗаписатьВЖРИСообщитьПользователю(Событие, Текст);
		//	КонецПопытки;
		//
		//КонецЕсли;
		//		
		//МассивКСозданию.Удалить(0);
		//
		//Для Каждого СборочноеЗадание Из МассивКСозданию Цикл
		//	
		//	Заказ = СоздатьИлиДополнитьЗаказУТ11_5(СборочноеЗадание, ФукнциональныеОпции, Заказ);
		//	
		//	Если Не Заказ.Пустая() Тогда
		//	
		//		ДокОбъект = СборочноеЗадание.ПолучитьОбъект();
		//		ДокОбъект.Заказ = Заказ;
		//		
		//		Попытка
		//			ДокОбъект.Записать();
		//		Исключение
		//			Текст = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
		//			ИС_MP_Сервер.ЗаписатьВЖРИСообщитьПользователю(Событие, Текст);
		//		КонецПопытки;
		//	
		//	КонецЕсли; 	
		//	
		//КонецЦикла; 
		
		//- ИнфоСофт Заварин К.В. 02.08.24 УА #80812 
		
	ИначеЕсли ФукнциональныеОпции.РежимСозданияЗаказовOzon = 2 Тогда // Формирование в течение дня 
		
		//+ ИнфоСофт Макарова Н.Е. 01.04.2025 УА #77424
		//+ ИнфоСофт Стояк Ю.К. 27.10.2023 УА #65146                  
		Если ФукнциональныеОпции.ФормироватьЕдиныйЗаказБезРазбиенияOzon
			И НЕ ФукнциональныеОпции.ИспользоватьРазбиениеПоСкладамOzon Тогда // без разбиения, создается только 1 заказ 
			
			Если ФукнциональныеОпции.АктивныйЗаказКлиентаOzon.Пустая() Тогда
				
				Заказ = СоздатьИлиДополнитьЗаказУТ11_5(МассивКСозданию[0], ФукнциональныеОпции);
				
				Если Не Заказ.Пустая() Тогда
					
					ДокОбъект = МассивКСозданию[0].ПолучитьОбъект();
					ДокОбъект.Заказ = Заказ;
					
					Попытка
						ДокОбъект.Записать();
					Исключение
						Текст = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
						ИС_MP_Сервер.ЗаписатьВЖРИСообщитьПользователю(Событие, Текст);
					КонецПопытки;
					
				КонецЕсли;
				
				СоответствиеПараметровЗаписи = Новый Соответствие;
				СоответствиеПараметровЗаписи.Вставить("АктивныйЗаказКлиентаOzon", Заказ.Ссылка);
				ИС_MP_Сервер.ЗаписатьНастройкиСправочника(Профиль.Ссылка, СоответствиеПараметровЗаписи);
				
				МассивКСозданию.Удалить(0);
				
			Иначе
				Заказ = ФукнциональныеОпции.АктивныйЗаказКлиентаOzon;
			КонецЕсли;
			
			Для Каждого СборочноеЗадание Из МассивКСозданию Цикл
				
				СоздатьИлиДополнитьЗаказУТ11_5(СборочноеЗадание, ФукнциональныеОпции, Заказ);
				
				ДокОбъект = СборочноеЗадание.ПолучитьОбъект();
				ДокОбъект.Заказ = Заказ;
				
				Попытка
					ДокОбъект.Записать();
				Исключение
					Текст = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
					ИС_MP_Сервер.ЗаписатьВЖРИСообщитьПользователю(Событие, Текст);
				КонецПопытки;	
			КонецЦикла;
			
			Возврат;
			
		КонецЕсли;
		//- ИнфоСофт Стояк Ю.К. 27.10.2023 УА #65146
		//- ИнфоСофт Макарова Н.Е. 01.04.2025 УА #77424
