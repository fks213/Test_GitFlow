//+ ИнфоСофт Стояк Ю.К. 22.01.2024 УА #61983
Функция ХарактеристикиКатегорииНеЗагружены(Категория) Экспорт

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Категория", Категория);
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Ozon_КатегорииТоваровХарактеристики.Характеристика КАК Характеристика
	|ИЗ
	|	Справочник.ИС_Ozon_КатегорииТоваров.Характеристики КАК Ozon_КатегорииТоваровХарактеристики
	|ГДЕ
	|	Ozon_КатегорииТоваровХарактеристики.Ссылка = &Категория";

	Возврат Запрос.Выполнить().Пустой();

КонецФункции //- ИнфоСофт Стояк Ю.К. 22.01.2024 УА #61983

//+ ИнфоСофт Стояк Ю.К. 22.01.2024 УА #61983
Функция ЗначенияХарактеристикиOzonИзСтроки(ЗначенияСтрокой) Экспорт

	Результат = Новый Массив;

	МассивСтрок = СтрРазделить(ЗначенияСтрокой, ";", Ложь);
	Для Каждого стр Из МассивСтрок Цикл
		Если СтрДлина(стр) = 36 Тогда
			ЗначениеХарактеристики = Справочники.ИС_Ozon_ЗначенияХарактеристик.ПолучитьСсылку(
				Новый УникальныйИдентификатор(стр));
			Если ЗначениеЗаполнено(ЗначениеХарактеристики) Тогда
				Результат.Добавить(ЗначениеХарактеристики);
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;

	Возврат Результат;

КонецФункции //- ИнфоСофт Стояк Ю.К. 22.01.2024 УА #61983

//+ ИнфоСофт Стояк Ю.К. 22.01.2024 УА #61983
Процедура УдалитьЗаписиВрегистрахПоКатегории(Категория) Экспорт

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Ozon_КатегорииТоваров.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.ИС_Ozon_КатегорииТоваров КАК Ozon_КатегорииТоваров
	|ГДЕ
	|	НЕ Ozon_КатегорииТоваров.ЭтоГруппа
	|	И Ozon_КатегорииТоваров.Ссылка В ИЕРАРХИИ(&Категория)";

	Запрос.УстановитьПараметр("Категория", Категория);

	РезультатЗапроса = Запрос.Выполнить();

	Если Не РезультатЗапроса.Пустой() Тогда

		НаборыЗаписей = Новый Массив;
		НаборыЗаписей.Добавить(РегистрыСведений.ИС_Ozon_ЗначенияХарактеристикПоКатегориям.СоздатьНаборЗаписей());
		НаборыЗаписей.Добавить(РегистрыСведений.ИС_Ozon_СоответствиеЗначенийХарактеристик.СоздатьНаборЗаписей());
		НаборыЗаписей.Добавить(РегистрыСведений.ИС_Ozon_СоответствиеОсновныхРеквизитовТовара.СоздатьНаборЗаписей());		

		Выборка = РезультатЗапроса.Выбрать();
		Пока Выборка.Следующий() Цикл

			Для Каждого НаборЗаписей Из НаборыЗаписей Цикл

				НаборЗаписей.Отбор.Категория.Установить(Выборка.Ссылка);
				НаборЗаписей.Прочитать();
				НаборЗаписей.Очистить();
				НаборЗаписей.Записать();

			КонецЦикла;

		КонецЦикла;

	КонецЕсли;

КонецПроцедуры //- ИнфоСофт Стояк Ю.К. 22.01.2024 УА #61983

//+ ИнфоСофт Стояк Ю.К. 22.01.2024 УА #61983
Процедура УдалитьЗаписиВРегистрахЗначенияХарактеристикПоКатегориям(Характеристика, Знач Категория = Неопределено) Экспорт

	Если Не ЗначениеЗаполнено(Категория) Тогда
		Категория = ПредопределенноеЗначение("Справочник.ИС_Ozon_КатегорииТоваров.ПустаяСсылка");
	КонецЕсли;

	НаборЗаписей = РегистрыСведений.ИС_Ozon_ЗначенияХарактеристикПоКатегориям.СоздатьНаборЗаписей();
	НаборЗаписей.Отбор.Категория.Установить(Категория);
	НаборЗаписей.Отбор.Характеристика.Установить(Характеристика);
	НаборЗаписей.Записать(Истина);

КонецПроцедуры //- ИнфоСофт Стояк Ю.К. 22.01.2024 УА #61983

//+ ИнфоСофт Стояк Ю.К. 22.01.2024 УА #61983
Процедура ОбработатьКатегорииТоваров(МассивКатегорииТоваров, МассивАктуальныхКатегорий,
	КатегорииСОбязательнымиСертификатами, Родитель = Неопределено)

	Для Каждого ДанныеКатегории Из МассивКатегорииТоваров Цикл
		
		//+ ИнфоСофт Стояк Ю.К. 05.03.2024 УА #71269
		Если ДанныеКатегории.Свойство("type_id") Тогда
			Категория = Справочники.ИС_Ozon_КатегорииТоваров.НайтиПоКоду(ДанныеКатегории.type_id); //.category_id
		Иначе
			Категория = Справочники.ИС_Ozon_КатегорииТоваров.НайтиПоКоду(ДанныеКатегории.description_category_id); //.category_id
		КонецЕсли;
		//- ИнфоСофт Стояк Ю.К. 05.03.2024 УА #71269
		Если ЗначениеЗаполнено(Категория) Тогда
			Если ТребуетсяОбновитьДанные(Категория, ДанныеКатегории, КатегорииСОбязательнымиСертификатами, Родитель) Тогда
				Категория = СоздатьОбновитьКатегориюТоваров(ДанныеКатегории, КатегорииСОбязательнымиСертификатами,
					Родитель, Категория);
			КонецЕсли;
		Иначе
			Категория = СоздатьОбновитьКатегориюТоваров(ДанныеКатегории, КатегорииСОбязательнымиСертификатами, Родитель);
		КонецЕсли;

		МассивАктуальныхКатегорий.Добавить(Категория);

		Если ДанныеКатегории.children.Количество() Тогда
			ОбработатьКатегорииТоваров(ДанныеКатегории.children, МассивАктуальныхКатегорий,
				КатегорииСОбязательнымиСертификатами, Категория);
		КонецЕсли;

	КонецЦикла;
	
КонецПроцедуры //- ИнфоСофт Стояк Ю.К. 22.01.2024 УА #61983

//+ ИнфоСофт Стояк Ю.К. 22.01.2024 УА #61983
Функция СоздатьОбновитьКатегориюТоваров(ДанныеКатегории, КатегорииСОбязательнымиСертификатами, Родитель = Неопределено,
	КатегорияСсылка = Неопределено)

	Если КатегорияСсылка = Неопределено Тогда
		Если ДанныеКатегории.children.Количество() Тогда
			КатегорияОбъект = Справочники.ИС_Ozon_КатегорииТоваров.СоздатьГруппу();
		Иначе
			КатегорияОбъект = Справочники.ИС_Ozon_КатегорииТоваров.СоздатьЭлемент();
		КонецЕсли;
	Иначе
		КатегорияОбъект = КатегорияСсылка.ПолучитьОбъект();
	КонецЕсли;   
	
	//+ ИнфоСофт Стояк Ю.К. 05.03.2024 УА #71269	
	Если ДанныеКатегории.Свойство("type_id") Тогда                                           
		КатегорияОбъект.Код 			= ДанныеКатегории.type_id; 
		КатегорияОбъект.type_id 		= Истина;                   
		КатегорияОбъект.Наименование 	= ДанныеКатегории.type_name; 
	Иначе
		КатегорияОбъект.Код 			= ДанныеКатегории.description_category_id; //.category_id		
		КатегорияОбъект.Наименование 	= ДанныеКатегории.category_name; //.title
	КонецЕсли;
	//- ИнфоСофт Стояк Ю.К. 05.03.2024 УА #71269   
	
	Если Не КатегорияОбъект.ЭтоГруппа Тогда
		КатегорияОбъект.Сертифицируется = КатегорииСОбязательнымиСертификатами.Получить(КатегорияОбъект.Наименование);
	КонецЕсли;

	Если Родитель <> Неопределено Тогда
		КатегорияОбъект.Родитель 	= Родитель;
	КонецЕсли;

	Попытка
		КатегорияОбъект.Записать();
	Исключение
		ИмяСобытия = "ЗагрузкаКатегорийТоваров";
		Комментарий = "Не удалось записать категорию товаров: " + КатегорияОбъект.НаименованиеПолное + Символы.ПС
			+ ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());		
	КонецПопытки;

	Возврат КатегорияОбъект.Ссылка;

КонецФункции //- ИнфоСофт Стояк Ю.К. 22.01.2024 УА #61983

//+ ИнфоСофт Стояк Ю.К. 22.01.2024 УА #61983
Функция ТребуетсяОбновитьДанные(Категория, ДанныеКатегории, КатегорииСОбязательнымиСертификатами,
	Родитель = Неопределено)

	Результат = Ложь;

	Если Родитель = Неопределено Тогда
		Родитель = ПредопределенноеЗначение("Справочник.ИС_Ozon_КатегорииТоваров.ПустаяСсылка");
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	КатегорииТоваров.Наименование КАК Наименование,
	|	КатегорииТоваров.Код КАК Код,
	|	КатегорииТоваров.Родитель КАК Родитель,
	|	КатегорииТоваров.Сертифицируется КАК Сертифицируется
	|ИЗ
	|	Справочник.ИС_Ozon_КатегорииТоваров КАК КатегорииТоваров
	|ГДЕ
	|	КатегорииТоваров.Ссылка = &Ссылка";

	Запрос.УстановитьПараметр("Ссылка", Категория);

	РезультатЗапроса = Запрос.Выполнить();

	Выборка = РезультатЗапроса.Выбрать();

	Если Выборка.Следующий() Тогда
		
		//+ ИнфоСофт Стояк Ю.К. 05.03.2024 УА #71269		
		Если ДанныеКатегории.Свойство("type_id") Тогда 
			
			Результат = Выборка.Наименование <> ДанныеКатегории.type_name Или Выборка.Код 
			<> ДанныеКатегории.type_id Или Выборка.Родитель <> Родитель 
			Или (КатегорииСОбязательнымиСертификатами.Получить(Выборка.Наименование) <> Неопределено
			И КатегорииСОбязательнымиСертификатами.Получить(Выборка.Наименование) <> Выборка.Сертифицируется);
			
		Иначе
			
			Результат = Выборка.Наименование <> ДанныеКатегории.category_name Или Выборка.Код //.title
			<> ДанныеКатегории.description_category_id Или Выборка.Родитель <> Родитель //.category_id
			Или (КатегорииСОбязательнымиСертификатами.Получить(Выборка.Наименование) <> Неопределено
			И КатегорииСОбязательнымиСертификатами.Получить(Выборка.Наименование) <> Выборка.Сертифицируется);
			
		КонецЕсли;
		//- ИнфоСофт Стояк Ю.К. 05.03.2024 УА #71269

	КонецЕсли;

	Возврат Результат;

КонецФункции //- ИнфоСофт Стояк Ю.К. 22.01.2024 УА #61983

//+ ИнфоСофт Стояк Ю.К. 22.01.2024 УА #61983
Функция КатегорииТоваров(Категория)

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ОтборПоКатегории", ЗначениеЗаполнено(Категория));
	Запрос.УстановитьПараметр("Категория", Категория);

	Запрос.Текст =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	Ozon_КатегорииТоваров.Код КАК type_id,
	|	Ozon_КатегорииТоваров.Родитель.Код КАК Код
	|ИЗ
	|	Справочник.ИС_Ozon_КатегорииТоваров КАК Ozon_КатегорииТоваров
	|ГДЕ
	|	НЕ Ozon_КатегорииТоваров.ПометкаУдаления
	|	И НЕ Ozon_КатегорииТоваров.ЭтоГруппа
	|	И Ozon_КатегорииТоваров.Используется
	|	И ВЫБОР
	|			КОГДА &ОтборПоКатегории
	|				ТОГДА Ozon_КатегорииТоваров.Ссылка В ИЕРАРХИИ (&Категория)
	|			ИНАЧЕ ИСТИНА
	|		КОНЕЦ";

	РезультатЗапроса = Запрос.Выполнить().Выгрузить();

	Возврат РезультатЗапроса;

КонецФункции //- ИнфоСофт Стояк Ю.К. 22.01.2024 УА #61983

//+ ИнфоСофт Стояк Ю.К. 22.01.2024 УА #61983
Процедура ОбработатьХарактеристикиКатегории(МассивХарактеристик, category_id)

	Категория = Справочники.ИС_Ozon_КатегорииТоваров.НайтиПоКоду(category_id).ПолучитьОбъект();

	ТаблицаХарактеристик = Категория.Характеристики.Выгрузить();

	Категория.Характеристики.Очистить();

	Для Каждого ДанныеХарактеристики Из МассивХарактеристик Цикл

		стрХарактеристики = Категория.Характеристики.Добавить();

		Характеристика = Справочники.ИС_Ozon_Характеристики.НайтиПоКоду(ДанныеХарактеристики.id);
		Характеристика = СоздатьОбновитьХарактеристику(ДанныеХарактеристики, Характеристика);

		стрХарактеристики.Характеристика = Характеристика;
		стрХарактеристики.Обязательная	 = ДанныеХарактеристики.is_required;
		стрХарактеристики.Аспектная		 = ДанныеХарактеристики.is_aspect;
		Если стрХарактеристики.Обязательная Тогда
			стрХарактеристики.НеИспользовать = Ложь;
		Иначе
			староеЗначение = ТаблицаХарактеристик.Найти(Характеристика, "Характеристика");
			Если Не староеЗначение = Неопределено Тогда
				стрХарактеристики.НеИспользовать = староеЗначение.НеИспользовать;
			КонецЕсли;
		КонецЕсли;

	КонецЦикла;

	СравнитьМодельХарактеристик(Категория.Ссылка, Категория.Характеристики.Выгрузить());

	Попытка

		Если МассивХарактеристик.Количество() Тогда
			Категория.Записать();			
		КонецЕсли;
	Исключение
		ИмяСобытия = "ЗагрузитьХарактеристикиКатегорий";
		Комментарий = "Не удалось записать категорию товаров: " + Категория.Наименование + Символы.ПС
			+ ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
	КонецПопытки;

КонецПроцедуры //- ИнфоСофт Стояк Ю.К. 22.01.2024 УА #61983

//+ ИнфоСофт Стояк Ю.К. 22.01.2024 УА #61983
Функция СоздатьОбновитьХарактеристику(ДанныеХарактеристики, Характеристика = Неопределено)

	Если ЗначениеЗаполнено(Характеристика) Тогда
		ХарактеристикаОбъект = Характеристика.ПолучитьОбъект();
	Иначе
		ХарактеристикаОбъект = Справочники.ИС_Ozon_Характеристики.СоздатьЭлемент();
	КонецЕсли;

	ХарактеристикаОбъект.Код 								= ДанныеХарактеристики.id;
	ХарактеристикаОбъект.Наименование 						= ДанныеХарактеристики.name;
	ХарактеристикаОбъект.Описание       					= ДанныеХарактеристики.description;
	ХарактеристикаОбъект.ИДСправочникаЗначенийХарактеристики = ДанныеХарактеристики.dictionary_id;
	ХарактеристикаОбъект.ИдентификаторГруппы  				= ДанныеХарактеристики.group_id;
	ХарактеристикаОбъект.НаименованиеГруппы 				= ДанныеХарактеристики.group_name;
	ХарактеристикаОбъект.НаборЗначений  					= ДанныеХарактеристики.is_collection;
	ХарактеристикаОбъект.ТипХарактеристики 					= ДанныеХарактеристики.type;
	ХарактеристикаОбъект.ЗначенияЗависятОтКатегории			= ДанныеХарактеристики.category_dependent;
	//+ ИнфоСофт Стояк Ю.К. 05.03.2024 УА #71269
	ХарактеристикаОбъект.attribute_complex_id 				= ДанныеХарактеристики.attribute_complex_id;
	ХарактеристикаОбъект.max_value_count					= ДанныеХарактеристики.max_value_count;
	//- ИнфоСофт Стояк Ю.К. 05.03.2024 УА #71269

	Попытка
		ХарактеристикаОбъект.Записать();
	Исключение
		ИмяСобытия = "ЗагрузитьХарактеристикиКатегорий";
		Комментарий = "Не удалось записать характеристику категории: " + ХарактеристикаОбъект.НаименованиеПолное
			+ Символы.ПС + ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());		
	КонецПопытки;

	Возврат ХарактеристикаОбъект.Ссылка;

КонецФункции //- ИнфоСофт Стояк Ю.К. 22.01.2024 УА #61983

//+ ИнфоСофт Стояк Ю.К. 22.01.2024 УА #61983
Функция ХарактеристикиКатегорий(Характеристики, Категории, ЗагружатьЗначения = Ложь)

	Запрос = Новый Запрос;
	//+ ИнфоСофт Стояк Ю.К. 22.03.2024 УА #72805	
	//Запрос.УстановитьПараметр("ЗагружатьЗначения", Ложь);
	Запрос.УстановитьПараметр("ЗагружатьЗначения", ЗагружатьЗначения);
	//- ИнфоСофт Стояк Ю.К. 22.03.2024 УА #72805
	Запрос.УстановитьПараметр("ОтборПоХарактеристикам", ЗначениеЗаполнено(Характеристики));
	Запрос.УстановитьПараметр("Характеристики", Характеристики);
	Запрос.УстановитьПараметр("ОтборПоКатегориям", ЗначениеЗаполнено(Категории));
	Запрос.УстановитьПараметр("Категории", Категории);

	Запрос.Текст =
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	Ozon_КатегорииТоваров.Ссылка КАК Категория,
	|	Ozon_КатегорииТоваров.Код КАК КодКатегории,
	|	Ozon_КатегорииТоваровХарактеристики.Характеристика КАК Характеристика,
	|	Ozon_Характеристики.Код КАК КодХарактеристики,
	|	Ozon_Характеристики.ЗначенияЗависятОтКатегории КАК ЗначенияЗависятОтКатегории,
	|	Ozon_КатегорииТоваров.Родитель.Код КАК КодВладельцаКатегории
	|ПОМЕСТИТЬ ВТ_КатегорииХарактеристики
	|ИЗ
	|	Справочник.ИС_Ozon_КатегорииТоваров КАК Ozon_КатегорииТоваров
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ИС_Ozon_КатегорииТоваров.Характеристики КАК Ozon_КатегорииТоваровХарактеристики
	|			ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ИС_Ozon_Характеристики КАК Ozon_Характеристики
	|			ПО Ozon_КатегорииТоваровХарактеристики.Характеристика = Ozon_Характеристики.Ссылка
	|		ПО Ozon_КатегорииТоваров.Ссылка = Ozon_КатегорииТоваровХарактеристики.Ссылка
	|ГДЕ
	|	Ozon_КатегорииТоваров.Используется
	|	И НЕ Ozon_КатегорииТоваров.ЭтоГруппа
	|	И НЕ Ozon_КатегорииТоваров.ПометкаУдаления
	|	И Ozon_Характеристики.ИДСправочникаЗначенийХарактеристики > 0
	|	И (Ozon_КатегорииТоваровХарактеристики.Обязательная
	|			ИЛИ Ozon_Характеристики.ЗагружатьЗначенияХарактеристики
	|			ИЛИ &ЗагружатьЗначения)
	|	И ВЫБОР
	|			КОГДА &ОтборПоХарактеристикам
	|				ТОГДА Ozon_Характеристики.Ссылка В (&Характеристики)
	|			ИНАЧЕ ИСТИНА
	|		КОНЕЦ
	|	И НЕ Ozon_КатегорииТоваровХарактеристики.НеИспользовать
	|	И ВЫБОР
	|			КОГДА &ОтборПоКатегориям
	|				ТОГДА Ozon_КатегорииТоваров.Ссылка В ИЕРАРХИИ (&Категории)
	|			ИНАЧЕ ИСТИНА
	|		КОНЕЦ
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_КатегорииХарактеристики.Категория КАК Категория,
	|	ВТ_КатегорииХарактеристики.КодКатегории КАК КодКатегории,
	|	ВТ_КатегорииХарактеристики.Характеристика КАК Характеристика,
	|	ВТ_КатегорииХарактеристики.КодХарактеристики КАК КодХарактеристики,
	|	ДАТАВРЕМЯ(1, 1, 1) КАК ДатаАктуальности,
	|	ВТ_КатегорииХарактеристики.ЗначенияЗависятОтКатегории КАК ЗначенияЗависятОтКатегории,
	|	ВТ_КатегорииХарактеристики.КодВладельцаКатегории КАК КодВладельцаКатегории
	|ИЗ
	|	ВТ_КатегорииХарактеристики КАК ВТ_КатегорииХарактеристики
	|
	|УПОРЯДОЧИТЬ ПО
	|	ДатаАктуальности
	|ИТОГИ
	|	МАКСИМУМ(ЗначенияЗависятОтКатегории)
	|ПО
	|	Характеристика";
	РезультатЗапроса = Запрос.Выполнить().Выгрузить(ОбходРезультатаЗапроса.ПоГруппировкамСИерархией);

	Возврат РезультатЗапроса;

КонецФункции //- ИнфоСофт Стояк Ю.К. 22.01.2024 УА #61983

//+ ИнфоСофт Стояк Ю.К. 22.01.2024 УА #61983
Процедура ОбработатьЗначенияХарактеристики(Характеристика, МассивЗначений, Категория)

	Если Не ЗначениеЗаполнено(МассивЗначений) Тогда
		// Значения характеристик, по какой то прчиине, не были загружены
		// Выходим отсюда, дальше тут делать нечего
		Возврат;
	КонецЕсли;

	ТабЗнач = Новый ТаблицаЗначений;
	ТабЗнач.Колонки.Добавить("id", Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(9, 0,
		ДопустимыйЗнак.Неотрицательный)));
	ТабЗнач.Колонки.Добавить("value", Новый ОписаниеТипов("Строка", , Новый КвалификаторыСтроки(150,
		ДопустимаяДлина.Переменная)));
	ТабЗнач.Колонки.Добавить("Владелец", Новый ОписаниеТипов("СправочникСсылка.ИС_Ozon_Характеристики"));
	ТабЗнач.Колонки.Добавить("Категория", Новый ОписаниеТипов("СправочникСсылка.ИС_Ozon_КатегорииТоваров"));
	ТабЗнач.Колонки.Добавить("picture", Новый ОписаниеТипов("Строка", , Новый КвалификаторыСтроки(250, ДопустимаяДлина.Переменная)));
	
	Для Каждого Значение Из МассивЗначений Цикл
		НоваяСтрока = ТабЗнач.Добавить();
		НоваяСтрока.Категория 	= Категория;
		НоваяСтрока.Владелец 	= Характеристика;
		НоваяСтрока.id 			= Значение.id;
		НоваяСтрока.value 		= Значение.value;
		НоваяСтрока.picture		= ?(Значение.picture = Неопределено, "", Значение.picture);
	КонецЦикла;

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ТабЗнач.id КАК id,
	|	ТабЗнач.value КАК value,
	|	ТабЗнач.picture КАК picture,
	|	ТабЗнач.Категория КАК Категория,
	|	ТабЗнач.Владелец КАК Владелец
	|ПОМЕСТИТЬ вт_ЗагруженныеЗначения
	|ИЗ
	|	&ТабЗнач КАК ТабЗнач
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	вт_ЗагруженныеЗначения.id КАК id,
	|	вт_ЗагруженныеЗначения.value КАК value,
	|	вт_ЗагруженныеЗначения.picture КАК picture,
	|	вт_ЗагруженныеЗначения.Категория КАК Категория,
	|	вт_ЗагруженныеЗначения.Владелец КАК Характеристика,
	|	ЕСТЬNULL(Ozon_ЗначенияХарактеристик.Ссылка, ЗНАЧЕНИЕ(Справочник.ИС_Ozon_ЗначенияХарактеристик.ПустаяСсылка)) КАК
	|		ЗначениеХарактеристики,
	|	Ozon_ЗначенияХарактеристик.Наименование КАК Наименование,
	|	Ozon_ЗначенияХарактеристик.АдресКартинки
	|ИЗ
	|	вт_ЗагруженныеЗначения КАК вт_ЗагруженныеЗначения
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ИС_Ozon_ЗначенияХарактеристик КАК Ozon_ЗначенияХарактеристик
	|		ПО вт_ЗагруженныеЗначения.Владелец = Ozon_ЗначенияХарактеристик.Владелец
	|		И вт_ЗагруженныеЗначения.id = Ozon_ЗначенияХарактеристик.Код";

	Запрос.УстановитьПараметр("Ссылка", ПредопределенноеЗначение("Справочник.ИС_Ozon_ЗначенияХарактеристик.ПустаяСсылка"));
	Запрос.УстановитьПараметр("ТабЗнач", ТабЗнач);

	РезультатЗапроса = Запрос.Выполнить();
	Выборка = РезультатЗапроса.Выбрать();

	НаборЗаписей = РегистрыСведений.ИС_Ozon_ЗначенияХарактеристикПоКатегориям.СоздатьНаборЗаписей();
	НаборЗаписей.Отбор.Категория.Установить(Категория);
	НаборЗаписей.Отбор.Характеристика.Установить(Характеристика);
	НаборЗаписей.Прочитать();
	НаборЗаписей.Очистить();

	Пока Выборка.Следующий() Цикл

		ЗаписьНабора = НаборЗаписей.Добавить();
		ЗаполнитьЗначенияСвойств(ЗаписьНабора, Выборка);

		СсылкаЗаполнена = ЗначениеЗаполнено(Выборка.ЗначениеХарактеристики);
		Если Не СсылкаЗаполнена Или Выборка.value <> Выборка.Наименование
			Или Выборка.picture <> Выборка.АдресКартинки Тогда

			Если СсылкаЗаполнена Тогда
				ЗначениеХарактеристики = Выборка.ЗначениеХарактеристики.ПолучитьОбъект();
			Иначе
				ЗначениеХарактеристики = Справочники.ИС_Ozon_ЗначенияХарактеристик.СоздатьЭлемент();
			КонецЕсли;

			ЗначениеХарактеристики.Владелец 		= Выборка.Характеристика;
			ЗначениеХарактеристики.Код 				= Выборка.id;
			ЗначениеХарактеристики.Наименование 	= Выборка.value;
			ЗначениеХарактеристики.АдресКартинки 	= Выборка.picture;
			
			ЗначениеХарактеристики.Записать();

			ЗаписьНабора.ЗначениеХарактеристики = ЗначениеХарактеристики.Ссылка;

		КонецЕсли;

	КонецЦикла;

	НаборЗаписей.Записать(Истина);

КонецПроцедуры //- ИнфоСофт Стояк Ю.К. 22.01.2024 УА #61983

//+ ИнфоСофт Стояк Ю.К. 22.01.2024 УА #61983
Процедура СравнитьМодельХарактеристик(Категория, ОбновленнаяМодель)

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ОбновленнаяМодель.Характеристика КАК Характеристика,
	|	ОбновленнаяМодель.Обязательная КАК Обязательная
	|ПОМЕСТИТЬ вт_ОбновленнаяМодель
	|ИЗ
	|	&ОбновленнаяМодель КАК ОбновленнаяМодель
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	Ozon_КатегорииТоваровХарактеристики.Характеристика КАК Характеристика,
	|	Ozon_КатегорииТоваровХарактеристики.Обязательная КАК Обязательная,
	|	Ozon_КатегорииТоваровХарактеристики.НеИспользовать КАК НеИспользовать
	|ПОМЕСТИТЬ вт_СтараяМодель
	|ИЗ
	|	Справочник.ИС_Ozon_КатегорииТоваров.Характеристики КАК Ozon_КатегорииТоваровХарактеристики
	|ГДЕ
	|	Ozon_КатегорииТоваровХарактеристики.Ссылка = &Категория
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	вт_ОбновленнаяМодель.Характеристика КАК ОбновленнаяМодельХарактеристика,
	|	вт_ОбновленнаяМодель.Обязательная КАК ОбновленнаяМодельОбязательная,
	|	вт_СтараяМодель.Характеристика КАК СтараяМодельХарактеристика,
	|	вт_СтараяМодель.Обязательная КАК СтараяМодельОбязательная,
	|	вт_СтараяМодель.НеИспользовать КАК НеИспользовать
	|ПОМЕСТИТЬ вт_Объединение
	|ИЗ
	|	вт_ОбновленнаяМодель КАК вт_ОбновленнаяМодель
	|		ПОЛНОЕ СОЕДИНЕНИЕ вт_СтараяМодель КАК вт_СтараяМодель
	|		ПО вт_ОбновленнаяМодель.Характеристика = вт_СтараяМодель.Характеристика
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	вт_Объединение.ОбновленнаяМодельХарактеристика КАК ОбновленнаяМодельХарактеристика,
	|	вт_Объединение.ОбновленнаяМодельОбязательная КАК ОбновленнаяМодельОбязательная,
	|	вт_Объединение.СтараяМодельХарактеристика КАК СтараяМодельХарактеристика,
	|	вт_Объединение.СтараяМодельОбязательная КАК СтараяМодельОбязательная,
	|	вт_Объединение.НеИспользовать КАК НеИспользовать
	|ИЗ
	|	вт_Объединение КАК вт_Объединение
	|ГДЕ
	|	(вт_Объединение.ОбновленнаяМодельХарактеристика ЕСТЬ NULL
	|			ИЛИ вт_Объединение.СтараяМодельХарактеристика ЕСТЬ NULL
	|			ИЛИ вт_Объединение.СтараяМодельОбязательная <> вт_Объединение.ОбновленнаяМодельОбязательная)";

	Запрос.УстановитьПараметр("Категория", Категория);
	Запрос.УстановитьПараметр("ОбновленнаяМодель", ОбновленнаяМодель);

	РезультатЗапроса = Запрос.Выполнить();

	Выборка = РезультатЗапроса.Выбрать();

	Пока Выборка.Следующий() Цикл

		Если Не ЗначениеЗаполнено(Выборка.ОбновленнаяМодельХарактеристика) Тогда
			ТекстСообщения = СтрШаблон("У категории товаров ""%1"" удалена характеристика ""%2""", Категория,
				Выборка.СтараяМодельХарактеристика);
		ИначеЕсли Не ЗначениеЗаполнено(Выборка.СтараяМодельХарактеристика) Тогда
			ТекстСообщения = СтрШаблон("У категории товаров ""%1"" добавлена характеристика ""%2""", Категория,
				Выборка.ОбновленнаяМодельХарактеристика);
		ИначеЕсли Не Выборка.ОбновленнаяМодельОбязательная Тогда
			ТекстСообщения = СтрШаблон(
				"У категории товаров ""%1"" характеристика ""%2"" стала не обязательна для заполнения", Категория,
				Выборка.СтараяМодельХарактеристика);
		ИначеЕсли Выборка.ОбновленнаяМодельОбязательная Тогда
			ТекстСообщения = СтрШаблон(
				"У категории товаров ""%1"" характеристика ""%2"" стала обязательна для заполнения", Категория,
				Выборка.ОбновленнаяМодельХарактеристика);
		КонецЕсли;

		ОбщегоНазначения.СообщитьПользователю(ТекстСообщения);

	КонецЦикла;

