//+ ИнфоСофт Ивонин К.А. 10.04.23 УА #57127
Функция ОбновитьСписокТоваров(Профиль, Перезаполнять = Ложь, ДопПараметры = Неопределено) Экспорт

	НастройкиСоединения = ПолучитьНастройкиСоединенияПрофиля(Профиль);
	ПараметрыЗапроса = ПроверитьИЗаполнитьПараметрыЗапроса(НастройкиСоединения);

	СтруктураЗапроса = ИС_Ozon_API.ПолучитьСтруктуруПараметровЗапросаСпискаТоваров(1);
	
	РезультатЗапроса = ИС_Ozon_API.ПолучитьСписокТоваров(Профиль, ПараметрыЗапроса, СтруктураЗапроса);
	
	Если РезультатЗапроса = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	КоличествоТоваров = РезультатЗапроса["total"];
	
	КоличествоЭлементовНаЗапрос = НастройкиСоединения["КоличествоЭлементовНаЗапрос"];
	КоличествоПопытокЗапроса = НастройкиСоединения["КоличествоОшибокЗапросов"];

	last_id = "";
	ТекущаяСтраница = 1;
	КоличествоОшибок = 0;

	МассивДляПолучения = Новый Массив;
	
	Пока Истина Цикл
	    
	    Если КоличествоОшибок > КоличествоПопытокЗапроса Тогда
	    	ОбщегоНазначения.СообщитьПользователю("Превышено количество ошибок запросов");
	    	Возврат Неопределено;
	    КонецЕсли;
	    
	    СтруктураЗапроса = ИС_Ozon_API.ПолучитьСтруктуруПараметровЗапросаСпискаТоваров(
	    	КоличествоЭлементовНаЗапрос, last_id);
	    	
	    РезультатЗапроса = ИС_Ozon_API.ПолучитьСписокТоваров(Профиль, ПараметрыЗапроса, СтруктураЗапроса);
	
		Если РезультатЗапроса = Неопределено Тогда
			КоличествоОшибок = КоличествоОшибок + 1;
			Продолжить;
		КонецЕсли;
	    
	    last_id = РезультатЗапроса["last_id"];
	    
	    Для Каждого Элемент Из РезультатЗапроса["items"] Цикл
	    	МассивДляПолучения.Добавить(Элемент["offer_id"]);	
	    КонецЦикла;
	    
		Если last_id = "" Тогда
			Прервать;
		КонецЕсли;
	
	КонецЦикла;
	
	РазбитыйМассив = ИС_MP_Сервер.РазбитьМассивПоNЭлементов(МассивДляПолучения, 1000);
	
	Для Каждого МассивOfferId Из РазбитыйМассив Цикл
	
		РезультатЗапроса = ИС_Ozon_API.ПолучитьСписокТоваровПоИдентификаторам(Профиль, ПараметрыЗапроса, МассивOfferId);
		Если РезультатЗапроса = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		Для Каждого ЭлементТовар Из РезультатЗапроса["items"] Цикл
			СоздатьИлиОбновитьНоменклатуру(Профиль, ЭлементТовар, Перезаполнять);
		КонецЦикла;
	
	КонецЦикла;
	
	Возврат "Загрузка завершена";
	
КонецФункции //- ИнфоСофт Ивонин К.А. 10.04.23 УА #57127

