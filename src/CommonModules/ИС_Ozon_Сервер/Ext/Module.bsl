		//- ИнфоСофт Заварин К.В. 25.09.24 УА #73468
		Если ЗначениеЗаполнено(ВыборкаДетальныеЗаписи.РТУ) И ФукнциональныеОпции.РежимСозданияЗаказовOzon = 0 Тогда
		//- ИнфоСофт Стояк Ю.К. 11.10.2024 УА #84967 
			
			РТУ = ВыборкаДетальныеЗаписи.РТУ.ПолучитьОбъект();	
			
			Попытка	
				РТУ.Записать(РежимЗаписиДокумента.ОтменаПроведения);
			Исключение 
				
				Текст = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
				ИС_MP_Сервер.ЗаписатьВЖРИСообщитьПользователю("Отмена заказа", Текст);
				Возврат;
				
			КонецПопытки;
			
			РТУ.ПометкаУдаления = Истина; 			
			
			Попытка	
				РТУ.Записать();
			Исключение 
							
				Текст = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
				ИС_MP_Сервер.ЗаписатьВЖРИСообщитьПользователю("Отмена заказа", Текст);
				Возврат;
				
			КонецПопытки; 
			
		КонецЕсли;
		
		//+ ИнфоСофт Тимофеева А.А. 31.03.25 УА #77929
		Если ЗначениеЗаполнено(ВыборкаДетальныеЗаписи.РасходныйОрдер)
			И ФукнциональныеОпции.РежимСозданияЗаказовOzon = 0 Тогда   
			
			РО = ВыборкаДетальныеЗаписи.РасходныйОрдер.ПолучитьОбъект();
			
			Если ВыборкаДетальныеЗаписи.РазличныхРаспоряжений = 1 Тогда
				
				Попытка	
					РО.Записать(РежимЗаписиДокумента.ОтменаПроведения);
				Исключение 
					Текст = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
					ИС_MP_Сервер.ЗаписатьВЖРИСообщитьПользователю("Отмена заказа", Текст);
					Возврат;	
				КонецПопытки;
				
				РО.ПометкаУдаления = Истина;
				
				Попытка	
					РО.Записать();
				Исключение
					Текст = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
					ИС_MP_Сервер.ЗаписатьВЖРИСообщитьПользователю("Отмена заказа", Текст);
					Возврат;
				КонецПопытки; 	
				
			Иначе
				
				Отбор = Новый Структура(); 
				Отбор.Вставить("Номенклатура", ВыборкаДетальныеЗаписи.Номенклатура);
				Отбор.Вставить("Характеристика", ВыборкаДетальныеЗаписи.Характеристика);
				
				НайденныеСтрокиОтгружаемые = РО.ОтгружаемыеТовары.НайтиСтроки(Отбор);
				
				Отбор.Вставить("Распоряжение", ВыборкаДетальныеЗаписи.Заказ1С);
				
				НайденныеСтрокиПоРаспоряжениям = РО.ТоварыПоРаспоряжениям.НайтиСтроки(Отбор);
				
				Если НайденныеСтрокиПоРаспоряжениям.Количество() > 0 Тогда
					
					РО.ТоварыПоРаспоряжениям.Удалить(НайденныеСтрокиПоРаспоряжениям[0]);
					
					НайденныеСтрокиОтгружаемые[0].Действие = 
					Перечисления.ДействияСоСтрокамиОрдеровНаОтгрузку.НеОтгружать;
					
					Попытка			
						РО.Записать(РежимЗаписиДокумента.Проведение);	
					Исключение 
						РО.Записать();			
						Текст = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
						ИС_MP_Сервер.ЗаписатьВЖРИСообщитьПользователю("Отмена заказа", Текст);	
					КонецПопытки;
					
				КонецЕсли;
				
			КонецЕсли;
			
		КонецЕсли;
		//- ИнфоСофт Тимофеева А.А. 31.03.25 УА #77929
		
		Если ЗначениеЗаполнено(ВыборкаДетальныеЗаписи.Заказ1С) Тогда 
			
			Заказ1С = ВыборкаДетальныеЗаписи.Заказ1С.ПолучитьОбъект();	
			
			//+ ИнфоСофт Мурсалимов Д.Р. 20.05.24 УА #76182
			Попытка
				Заказ1С.Заблокировать();    
			Исключение   
				
				ИС_MP_Сервер.ЗаписатьВЖРИСообщитьПользователю("Отмена заказа", "Заказ " + Заказ1С.Ссылка + " заблокирован для изменения данных");     
				Продолжить;
				
			КонецПопытки;                               
			
			//+ ИнфоСофт Стояк Ю.К. 23.09.2024 УА #82955
			Если ФукнциональныеОпции.РежимСозданияЗаказовOzon <> 0 Тогда
				
				Если ВыборкаДетальныеЗаписи.ЭтоНабор Тогда
					Отбор = Новый Структура();							
					Отбор.Вставить("НоменклатураНабора", ВыборкаДетальныеЗаписи.Номенклатура);
					Отбор.Вставить("ХарактеристикаНабора", ВыборкаДетальныеЗаписи.Характеристика); 
					Отбор.Вставить("Номенклатура", ВыборкаДетальныеЗаписи.НоменклатураВНаборе);
					Отбор.Вставить("Характеристика", ВыборкаДетальныеЗаписи.ХарактеристикаНабора);					
					//+ ИнфоСофт Стояк Ю.К. 10.04.2025 УА #98469
					Отбор.Вставить("Количество", ВыборкаДетальныеЗаписи.Количество);
					//- ИнфоСофт Стояк Ю.К. 10.04.2025 УА #98469
					
					НайденныеСтроки = Заказ1С.Товары.НайтиСтроки(Отбор);
					
					Если НайденныеСтроки.Количество() > 0 Тогда	
											
						НайденныеСтроки[0].Отменено = Истина;
						Если ИспользоватьПричины Тогда		
							НайденныеСтроки[0].ПричинаОтмены = ФукнциональныеОпции.ПричинаОтменыOzon;	
						КонецЕсли;  
						
					КонецЕсли; 
					
				Иначе
					Отбор = Новый Структура();							
					Отбор.Вставить("Номенклатура", ВыборкаДетальныеЗаписи.Номенклатура);
					Отбор.Вставить("Характеристика", ВыборкаДетальныеЗаписи.Характеристика);					
					//+ ИнфоСофт Стояк Ю.К. 10.04.2025 УА #98469
					Отбор.Вставить("Количество", ВыборкаДетальныеЗаписи.count);
					//- ИнфоСофт Стояк Ю.К. 10.04.2025 УА #98469
					
					НайденныеСтроки = Заказ1С.Товары.НайтиСтроки(Отбор);
					
					Если НайденныеСтроки.Количество() > 0 Тогда 
						
						НайденныеСтроки[0].Отменено = Истина;
						Если ИспользоватьПричины Тогда		
							НайденныеСтроки[0].ПричинаОтмены = ФукнциональныеОпции.ПричинаОтменыOzon;	
						КонецЕсли; 
						
					КонецЕсли; 
					
				КонецЕсли;                                                       
				
			Иначе 
				
				Для Каждого Товар Из Заказ1С.Товары Цикл
					Товар.Отменено = Истина;
					Если ИспользоватьПричины Тогда		
						Товар.ПричинаОтмены = ФукнциональныеОпции.ПричинаОтменыOzon;	
					КонецЕсли;	
				КонецЦикла;
				
			КонецЕсли;                                  
			//Для Каждого Товар Из Заказ1С.Товары Цикл
			//	Товар.Отменено = Истина;
			//	Если ИспользоватьПричины Тогда		
			//		Товар.ПричинаОтмены = ФукнциональныеОпции.ПричинаОтменыЯМ;	
			//	КонецЕсли;	
			//КонецЦикла;
			//- ИнфоСофт Стояк Ю.К. 23.09.2024 УА #82955
			
			Попытка	
				Заказ1С.Записать(РежимЗаписиДокумента.Проведение);
			Исключение 
				
				Заказ1С.Записать();			
				Текст = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
				ИС_MP_Сервер.ЗаписатьВЖРИСообщитьПользователю("Отмена заказа", Текст);
				
			КонецПопытки;
			//- ИнфоСофт Мурсалимов Д.Р. 20.05.24 УА #76182
			
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат;
	
КонецПроцедуры //- ИнфоСофт Стояк Ю.К. 16.08.2023 УА #61318

