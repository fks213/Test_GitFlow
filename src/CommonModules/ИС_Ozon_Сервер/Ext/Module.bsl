Функция СоздатьИзменитьНоменклатуруПоИдентификаторам(Профиль, МассивИдентификаторов, Перезаполнять = Ложь) Экспорт

	НастройкиСоединения = ПолучитьНастройкиСоединенияПрофиля(Профиль);
	ПараметрыЗапроса    = ПроверитьИЗаполнитьПараметрыЗапроса(НастройкиСоединения);
	
	РазбитыйМассив = ИС_MP_Сервер.РазбитьМассивПоNЭлементов(МассивИдентификаторов, 1000);
	
	МассивНоменклатуры = Новый Массив;
	
	Для Каждого МассивOfferId Из РазбитыйМассив Цикл
	
		РезультатЗапроса = ИС_Ozon_API.ПолучитьСписокТоваровПоИдентификаторам(Профиль, ПараметрыЗапроса, МассивOfferId);
		Если РезультатЗапроса = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		СтруктураНоменклатура = Новый Структура("НоменклатураОзон, offer_id");
		
		Для Каждого ЭлементТовар Из РезультатЗапроса["items"] Цикл
			
			НоменклатураОзон = СоздатьОбновитьНоменклатуру(Профиль, ЭлементТовар, Перезаполнять);
			
			Если Не НоменклатураОзон.Пустая() Тогда	
				
				СтруктураНоменклатура.НоменклатураОзон = НоменклатураОзон;
				СтруктураНоменклатура.offer_id         = ЭлементТовар.id;
				
				МассивНоменклатуры.Добавить(СтруктураНоменклатура);
				
			КонецЕсли;
			
		КонецЦикла;
	
	КонецЦикла;
	
	Возврат МассивНоменклатуры;
	
КонецФункции //- ИнфоСофт Власова И.С. 02.12.24 УА #62619

