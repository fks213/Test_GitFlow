//+ ИнфоСофт Мурсалимов Д.Р. 23.04.25 УА #99629 
Функция ПолучитьАктивныйЗаказКлиентаОзон(СборочноеЗадание, РазбиениеПоДатам, РазбиениеПоСкладам)
	
	//+ ИнфоСофт Стояк Ю.К. 19.03.2024 УА #64801	
	Запрос = Новый Запрос;
	
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ИС_Ozon_СтатусыСборочныхЗаданий.shipment_date КАК shipment_date
	|ИЗ
	|	РегистрСведений.ИС_Ozon_СтатусыСборочныхЗаданий КАК ИС_Ozon_СтатусыСборочныхЗаданий
	|ГДЕ
	|	ИС_Ozon_СтатусыСборочныхЗаданий.Заказ = &Заказ";
	
	Запрос.УстановитьПараметр("Заказ", СборочноеЗадание);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		ДатаОтгрузки = ВыборкаДетальныеЗаписи.shipment_date;	
	КонецЦикла;
	//- ИнфоСофт Стояк Ю.К. 19.03.2024 УА #64801
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ                                                                
	|	ИС_Ozon_ЗаказыВТеченииДня.ЗаказКлиента КАК ЗаказКлиента
	|ИЗ
	|	РегистрСведений.ИС_Ozon_ЗаказыВТеченииДня КАК ИС_Ozon_ЗаказыВТеченииДня
	|ГДЕ
	|	ИС_Ozon_ЗаказыВТеченииДня.ЗаказОткрыт
	|	И ИС_Ozon_ЗаказыВТеченииДня.Профиль = &Профиль";
	
	Если РазбиениеПоДатам Тогда
		
		Запрос.Текст = Запрос.Текст + "
		|	И ИС_Ozon_ЗаказыВТеченииДня.ДатаОтгрузки = &ДатаОтгрузки";
		
		//+ ИнфоСофт Стояк Ю.К. 19.03.2024 УА #64801	
		//Запрос.УстановитьПараметр("ДатаОтгрузки", СборочноеЗадание.shipment_date);
		Запрос.УстановитьПараметр("ДатаОтгрузки", ДатаОтгрузки);
		//- ИнфоСофт Стояк Ю.К. 19.03.2024 УА #64801
		
	КонецЕсли;
	
	Если РазбиениеПоСкладам Тогда
		
		Запрос.Текст = Запрос.Текст + "
		|	И ИС_Ozon_ЗаказыВТеченииДня.СкладМП = &Склад";
		
		Запрос.УстановитьПараметр("Склад", СборочноеЗадание.Склад);
		
	КонецЕсли;
	
	Запрос.УстановитьПараметр("Профиль", СборочноеЗадание.Профиль);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Если РезультатЗапроса.Пустой() Тогда
		Возврат Неопределено;	
	КонецЕсли; 	
	
	ВыборкаДетальныеЗаписи.Следующий();	
	
	Возврат ВыборкаДетальныеЗаписи.ЗаказКлиента;
	
КонецФункции //- ИнфоСофт Мурсалимов Д.Р. 23.04.25 УА #99629

