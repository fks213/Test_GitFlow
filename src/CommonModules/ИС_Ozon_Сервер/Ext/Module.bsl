//+ ИнфоСофт Стояк Ю.К. 22.01.2024 УА #61983
Процедура ЗаполнитьЗначениеКолонки(Выборка, СтрокаТаблицы, РазделительФотографий, ИмяЗаполняемойКолонки) Экспорт

	Если ЗначениеЗаполнено(Выборка.ХарактеристикаOzonКод) Тогда
		ИмяКолонки = "Атрибут_" + СтрЗаменить(Строка(Выборка.ХарактеристикаOzonКод), Символы.НПП, "");
	Иначе
		ИмяКолонки = Выборка.ХарактеристикаOzon;
	КонецЕсли;

	Если Не СтрокаТаблицы.Свойство(ИмяКолонки) Или (ЗначениеЗаполнено(ИмяЗаполняемойКолонки) И ИмяКолонки
		<> ИмяЗаполняемойКолонки) Тогда
		Возврат;
	КонецЕсли;

	Если Выборка.ВидРеквизита1С = ПредопределенноеЗначение(
		"Перечисление.ИС_Ozon_ВидРеквизитаСопоставления.ШтрихкодНоменклатуры") Тогда
		ЗначениеХарактеристикиOzon = СтрокаТаблицы.Штрихкод;
	ИначеЕсли ЗначениеЗаполнено(Выборка.ТекстоваяСтрока) И Не Выборка.ТребуетсяСопоставление Тогда
		ЗначениеХарактеристикиOzon = Выборка.ТекстоваяСтрока;
	Иначе
		//+ ИнфоСофт Заварин К.В. 18.05.24 УА #71523
		//ЗначениеХарактеристикиOzon = Выборка.ЗначениеХарактеристикиOzon;
		Если Выборка.Множитель <> 0 Тогда
			ЗначениеХарактеристикиOzon = Выборка.ЗначениеХарактеристикиOzon * Выборка.Множитель;
		Иначе
			ЗначениеХарактеристикиOzon = Выборка.ЗначениеХарактеристикиOzon;
		КонецЕсли;
		//- ИнфоСофт Заварин К.В. 18.05.24 УА #71523
	КонецЕсли;

	Если ТипЗнч(СтрокаТаблицы[ИмяКолонки]) = Тип("СписокЗначений") Тогда
		Если ИмяКолонки = "Изображения" Тогда
			Если ТипЗнч(ЗначениеХарактеристикиOzon) = Тип("Строка") И РазделительФотографий <> "" Тогда
				МассивЗначений = СтрРазделить(ЗначениеХарактеристикиOzon, РазделительФотографий, Ложь);
			Иначе
				Ozon_Константы = ПолучитьНастройкиСопоставления();
				РазделительФотографий = Ozon_Константы.РазделительФотографий;
				//Ozon_Константы = Ozon_КонстантыВызовСервера.ПрочитатьКонстанты();
				РасширенияДляВыгрузкиКартинок = Ozon_Константы.РасширенияДляВыгрузкиКартинок;
				Если ЗначениеЗаполнено(РасширенияДляВыгрузкиКартинок) Тогда

					//@skip-check wrong-string-literal-content
					Если (КраткоеНаименованиеОсновнойПодсистемы() = "УНФ"
						И ТипЗнч(ЗначениеХарактеристикиOzon) = Тип("СправочникСсылка.ХарактеристикиНоменклатурыПрисоединенныеФайлы")) Тогда
						ВладелецФайлов = СтрокаТаблицы.ХарактеристикаНоменклатуры;
					Иначе
						ВладелецФайлов = СтрокаТаблицы.Номенклатура;
					КонецЕсли;

					МассивЗначений = ПолучитьКартинкиПоВладельцу(ВладелецФайлов,
						РасширенияДляВыгрузкиКартинок);
				Иначе
					МассивЗначений = Новый Массив;
				КонецЕсли;

			КонецЕсли;
			МассивЗначений = ОбработатьСсылки(МассивЗначений);
		Иначе
			Если ТипЗнч(ЗначениеХарактеристикиOzon) = Тип("Строка") И Выборка.ТребуетсяСопоставление Тогда
				МассивЗначений = ЗначенияХарактеристикиOzonИзСтроки(
					ЗначениеХарактеристикиOzon);
			Иначе
				МассивЗначений = Новый Массив;
				МассивЗначений.Добавить(ЗначениеХарактеристикиOzon);
			КонецЕсли;
		КонецЕсли;
		СтрокаТаблицы[ИмяКолонки].ЗагрузитьЗначения(МассивЗначений);
	Иначе

		Если ИмяКолонки = "СсылкаНаГлавноеФото" Тогда
			ЗначениеХарактеристикиOzon = ОбработатьСсылки(ЗначениеХарактеристикиOzon);
		КонецЕсли;

		Если ТипЗнч(СтрокаТаблицы[ИмяКолонки]) <> ТипЗнч(ЗначениеХарактеристикиOzon) Тогда

			Если Не ЭтоПримитивныйТип(ЗначениеХарактеристикиOzon) Тогда
				ЗначениеХарактеристикиOzon = Строка(ЗначениеХарактеристикиOzon);
			КонецЕсли;
			
			//@skip-check empty-except-statement
			Попытка
				Если ТипЗнч(СтрокаТаблицы[ИмяКолонки]) = Тип("Число") Тогда
					ЗначениеХарактеристикиOzon = Число(ЗначениеХарактеристикиOzon);
				КонецЕсли;
			Исключение
			КонецПопытки;
		КонецЕсли;

		СтрокаТаблицы[ИмяКолонки] = ЗначениеХарактеристикиOzon;

	КонецЕсли;
	СтрокаТаблицы.ИзменилсяТовар = Истина;

КонецПроцедуры //- ИнфоСофт Стояк Ю.К. 22.01.2024 УА #61983

//+ ИнфоСофт Стояк Ю.К. 22.01.2024 УА #61983
Функция ЗаполнитьТаблицуОсновныхРеквизитов(ТаблицаРеквизитов, Категория) Экспорт

	НоваяСтрока = ТаблицаРеквизитов.Добавить();
