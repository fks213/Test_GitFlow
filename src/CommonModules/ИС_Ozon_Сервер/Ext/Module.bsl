//+ ИнфоСофт Стояк Ю.К. 15.02.2024 УА #62621
Процедура ЗагрузитьДанныеОК(Профиль, Дата) Экспорт
	
	Событие = ПолучитьИмяСобытия("ЗагрузитьДанныеОК");
	
	НастройкиСоединения = ПолучитьНастройкиСоединенияПрофиля(Профиль);
	ПараметрыЗапроса = ПроверитьИЗаполнитьПараметрыЗапроса(НастройкиСоединения);
	
	Кэш = Новый Структура;
	Исключения = Новый Структура;
	
	ЗаполчитьКэшПараметров(Кэш, Исключения);
	
	Результат = ИС_Ozon_API.ПолучитьОтчетОПродажахПоРеализации(Профиль, ПараметрыЗапроса, Дата);
	
	Если Результат = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если Результат.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	Если Результат.header.Свойство("num") Тогда
		num = Результат.header.num;
	Иначе
		ЗаписьЖурналаРегистрации(Событие, УровеньЖурналаРегистрации.Ошибка, , , "Не найдено поле num");		
		Возврат;
	КонецЕсли;
	
	Если Результат.header.Свойство("stop_date") Тогда
		stop_date = Результат.header.stop_date;
	Иначе
		ЗаписьЖурналаРегистрации(Событие, УровеньЖурналаРегистрации.Ошибка, , , "Не найдено поле stop_date");
		Возврат;
	КонецЕсли;
	
	Если Результат.header.Свойство("start_date") Тогда
		start_date = Результат.header.start_date;
	Иначе
		ЗаписьЖурналаРегистрации(Событие, УровеньЖурналаРегистрации.Ошибка, , , "Не найдено поле start_date");
		Возврат;
	КонецЕсли; 
	
	Если Результат.header.Свойство("doc_date") Тогда
		doc_date = Результат.header.doc_date;
	Иначе
		ЗаписьЖурналаРегистрации(Событие, УровеньЖурналаРегистрации.Ошибка, , , "Не найдено поле doc_date");
		Возврат;
	КонецЕсли;
	
	stop_date = ИС_MP_РаботаСHTTPЗапросамиСервер.ПрочитатьДатуИзJSON(stop_date, ФорматДатыJSON.ISO);
	doc_date = ИС_MP_РаботаСHTTPЗапросамиСервер.ПрочитатьДатуИзJSON(doc_date, ФорматДатыJSON.ISO);		
	start_date = ИС_MP_РаботаСHTTPЗапросамиСервер.ПрочитатьДатуИзJSON(start_date, ФорматДатыJSON.ISO);
	
	НаборЗаписей = РегистрыСведений.ИС_Ozon_ДанныеОтчетовРеализации.СоздатьНаборЗаписей();
	
	НаборЗаписей.Отбор.Период.Установить(start_date);
	НаборЗаписей.Отбор.Профиль.Установить(Профиль);
	НаборЗаписей.Отбор.rrd_id.Установить(num); 
	
	Для Каждого Элемент Из Результат.rows Цикл   
		
		Если Элемент.Свойство("row_number") Тогда
			row_number = Элемент.row_number;
		Иначе
			ЗаписьЖурналаРегистрации(Событие, УровеньЖурналаРегистрации.Ошибка, , , "Не найдено поле doc_date");
			Продолжить;
		КонецЕсли; 
		
		Для Каждого Параметр Из Элемент Цикл
			
			Если Исключения.Свойство(Параметр.Ключ) Тогда
				Продолжить;	
			КонецЕсли;
			
			Если Кэш.Свойство(Параметр.Ключ) Тогда
				Свойство = Кэш[Параметр.Ключ];
			Иначе
				
				НовыйЭлемент = Справочники.ИС_Ozon_ПараметрыОтчетовРеализации.СоздатьЭлемент();
				НовыйЭлемент.Наименование = Параметр.Ключ;
				
				Попытка
					НовыйЭлемент.Записать();
				Исключение
					ЗаписьЖурналаРегистрации(Событие, УровеньЖурналаРегистрации.Ошибка, , , ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
					Продолжить;
				КонецПопытки;
				
				Кэш.Вставить(Параметр.Ключ, НовыйЭлемент.Ссылка);
				Свойство = НовыйЭлемент.Ссылка;
				
			КонецЕсли;
			
			НоваяЗапись = НаборЗаписей.Добавить();
			НоваяЗапись.Период = start_date;
			НоваяЗапись.row_number = row_number;						
			НоваяЗапись.num = num;
			НоваяЗапись.stop_date = stop_date;
			НоваяЗапись.doc_date = doc_date;
			НоваяЗапись.Параметр = Свойство;				
			НоваяЗапись.Профиль = Профиль;
			НоваяЗапись.Значение = Параметр.Значение;
			
		КонецЦикла;
		
