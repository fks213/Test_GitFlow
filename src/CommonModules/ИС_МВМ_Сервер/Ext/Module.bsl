//+ ИнфоСофт Ивонин К.А. 27.10.24 УА #68001
Процедура СоздатьИлиОбновитьТовар(Профиль, Ссылка, SapМВидео, СтрокаТовара)
	
	Событие = ИмяСобытия("СоздатьИлиОбновитьТовар");
	
	Если Ссылка.Пустая() Тогда
		Товар = Справочники.ИС_МВМ_Товары.СоздатьЭлемент();	
	Иначе
		Товар = Ссылка.ПолучитьОбъект();
	КонецЕсли;
	
	Товар.Профиль = Профиль;
	Товар.Наименование = СтрокаТовара.НаименованиеТовараВСистемеПоставщика_;
	Если Не ЗначениеЗаполнено(Товар.Наименование) Тогда
		Товар.Наименование = СтрокаТовара.УчетноеНаименование;	
	КонецЕсли;
	Товар.SapМВидео = СтрокаТовара.Sap_кодМвидео;
	Товар.SapЭльдорадо = СтрокаТовара.Sap_кодЭльдорадо;
	Товар.Штрихкод = СтрокаТовара.Штрих_кодТоварнойУпаковки_;
	Товар.УчетноеНаименование = СтрокаТовара.УчетноеНаименование;
	Товар.КодПоставщика = СтрокаТовара.КодВСистемеПоставщика;
	Товар.Артикул = СтрокаТовара.АртикулПроизводителя;
	Товар.Бренд = СтрокаТовара.БрендТовара;
	Товар.КодГруппы = СтрокаТовара.КодТоварнойГруппыМВидео;
	Товар.Группа = СтрокаТовара.НазваниеГруппыТовара;
	Товар.Статус = СтрокаТовара.СтатусТовара;
	Товар.Архивный = СтрокаТовара.ЗаархивированВЛКП;
	Товар.ДатаПубликации = СтрокаТовара.ДатаПубликацииВЛКП;
	
	Попытка
		Товар.Записать();
	Исключение
		ТестОшибки = ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
		ИС_МП_Сервер.ЗаписатьВЖРИСообщитьПользователю(Событие, ТестОшибки);
	КонецПопытки;
	
КонецПроцедуры //- ИнфоСофт Ивонин К.А. 27.10.24 УА #68001

//+ ИнфоСофт Ивонин К.А. 28.10.24 УА #68001
Функция ПараметрыHTTPЗапроса(Профиль)
	
	НастройкиСоединения = ИС_МВМ_СерверПовтИсп.НастройкиСоединения(Профиль);  
	
	ТекстОшибки = "";
	
	Если Не ЗначениеЗаполнено(НастройкиСоединения.АдресСервисаAPI) Тогда
		ТекстОшибки = ТекстОшибки + 
			"Для данного профиля не заполнен ""Адрес Сервиса API"", проверьте настройки авторизации";
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(НастройкиСоединения.Порт) Тогда
		ТекстОшибки = ТекстОшибки + 
			"Для данного профиля не заполнен ""Порт"", проверьте настройки авторизации";
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(НастройкиСоединения.ЗащищенноеСоединение) Тогда
		ТекстОшибки = ТекстОшибки + 
			"Для данного профиля не заполнено ""Защищенное соединение"", проверьте настройки авторизации";
	КонецЕсли; 
	
	Если Не ЗначениеЗаполнено(НастройкиСоединения.ClientId) Тогда
		ТекстОшибки = ТекстОшибки + 
			"Для данного профиля не заполнено ""Client Id"", проверьте настройки авторизации";
	КонецЕсли;

	Если Не ЗначениеЗаполнено(НастройкиСоединения.ApiKey) Тогда
		ТекстОшибки = ТекстОшибки + 
			"Для данного профиля не заполнено ""Api Key"", проверьте настройки авторизации";
	КонецЕсли;

	Если ЗначениеЗаполнено(ТекстОшибки) Тогда
		ВызватьИсключение(ТекстОшибки);
	КонецЕсли;
	
	ПараметрыЗапроса = ИС_МП_РаботаСHTTPЗапросами.СтруктураHTTPЗапроса();
	ПараметрыЗапроса.Сервер = НастройкиСоединения.АдресСервисаAPI;
	ПараметрыЗапроса.Порт = НастройкиСоединения.Порт;
	ПараметрыЗапроса.ЗащищенноеСоединение = НастройкиСоединения.ЗащищенноеСоединение;
	ПараметрыЗапроса.РежимОтладки = НастройкиСоединения.РежимОтладки;
	
	Если Не ЗначениеЗаполнено(НастройкиСоединения.AccessTokenИстекает) 
			Или НастройкиСоединения.AccessTokenИстекает <= ТекущаяДатаСеанса() Тогда
			
		Токены = ПолучитьТокен(Профиль, ПараметрыЗапроса, НастройкиСоединения);
		
		Если Токены = Неопределено Тогда
			ВызватьИсключение("Не удалось обновить токены доступа");
		КонецЕсли;
		
		Токен = Токены.accessToken;
		
	Иначе
		Токен = НастройкиСоединения.AccessToken;
	КонецЕсли;
	
	ПараметрыЗапроса.Заголовки.Вставить("Authorization", "Bearer " + Токен);
	
	Возврат ПараметрыЗапроса;

КонецФункции //- ИнфоСофт Ивонин К.А. 28.10.24 УА #68001

