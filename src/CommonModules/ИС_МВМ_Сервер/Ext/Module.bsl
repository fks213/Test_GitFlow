#КонецОбласти

//+ ИнфоСофт Ивонин К.А. 22.10.24 УА #68001
Функция ТестПодключения(Профиль, Параметры) Экспорт

	ПараметрыЗапроса = ИС_МП_РаботаСHTTPЗапросами.СтруктураHTTPЗапроса();
	
	ПараметрыЗапроса.Сервер = Параметры.АдресСервисаAPI;
	ПараметрыЗапроса.Порт = Параметры.Порт;
	ПараметрыЗапроса.ЗащищенноеСоединение = Параметры.ЗащищенноеСоединение;
	
	РезультатЗапроса = ПолучитьТокен(Профиль, ПараметрыЗапроса, Параметры);
	
	Если РезультатЗапроса = Неопределено Тогда
		Возврат "Тест подключения API завершился с ошибкой";
	КонецЕсли;
	
	Возврат "Тест подключения выполнен успешно";
	
КонецФункции //- ИнфоСофт Ивонин К.А. 22.10.24 УА #68001

//+ ИнфоСофт Ивонин К.А. 22.10.24 УА #68001
Функция ПолучитьТокен(Профиль, ПараметрыЗапроса, Параметры) Экспорт
	
	ТелоСтруктура = Новый Структура;
	ТелоСтруктура.Вставить("clientName", Параметры.ClientId);
	ТелоСтруктура.Вставить("clientSecret", Параметры.ApiKey);

	РезультатЗапроса = ИС_МВМ_АПИ.ПолучитьТокен(Профиль, ПараметрыЗапроса, ТелоСтруктура);
	
	Если РезультатЗапроса = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Маркетплейс = Перечисления.ИС_МП_Маркетплейсы.МВМ;
	
	СтруктураПараметров = Новый Структура;
	
	СтруктураПараметров.Вставить("AccessTokenИстекает", ИС_МП_Сервер.ДатаИзUnixTimeStamp(РезультатЗапроса.expiresAt));
	СтруктураПараметров.Вставить("RefreshTokenИстекает", ИС_МП_Сервер.ДатаИзUnixTimeStamp(РезультатЗапроса.refreshExpiresAt));
	
	ИС_МП_Сервер.ЗаписатьЗначениеНастроек(Профиль, Маркетплейс, СтруктураПараметров); 
	
	СтруктураПараметров = Новый Структура;
	
	СтруктураПараметров.Вставить("AccessToken", РезультатЗапроса.accessToken);
	СтруктураПараметров.Вставить("RefreshToken", РезультатЗапроса.refreshToken);

	ИС_МП_Сервер.ЗаписатьЗначениеНастроек(Профиль, Маркетплейс, СтруктураПараметров, "Строка");
	
	Возврат РезультатЗапроса;
	
КонецФункции //- ИнфоСофт Ивонин К.А. 22.10.24 УА #68001

//+ ИнфоСофт Ивонин К.А. 07.11.24 УА #68001
Процедура ВыполнитьКомандуРеглЗадания(Профиль, ИдентификаторКомандыОбработки) Экспорт

	Событие = ИмяСобытия("ВыполнитьКомандуРеглЗадания");
	 
	Если ИдентификаторКомандыОбработки = "ВыгрузкаОстатковМВМ" Тогда
	
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	ИС_МВМ_Склады.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.ИС_МВМ_Склады КАК ИС_МВМ_Склады
		|ГДЕ
		|	НЕ ИС_МВМ_Склады.ПометкаУдаления
		|	И ИС_МВМ_Склады.Профиль = &Профиль
		|	И НЕ(ИС_МВМ_Склады.ОбщаяГруппаСкладов = ЗНАЧЕНИЕ(Справочник.Склады.ПустаяСсылка)
		|				И ИС_МВМ_Склады.Склад = ЗНАЧЕНИЕ(Справочник.Склады.ПустаяСсылка)
		|				И НЕ ИС_МВМ_Склады.ВыгружатьОстаткиИзГруппыСкладов)";
		
		Запрос.УстановитьПараметр("Профиль", Профиль);
		
		РезультатЗапроса = Запрос.Выполнить();
		
		Выборка = РезультатЗапроса.Выбрать();
		
		Пока Выборка.Следующий() Цикл
			ВыгрузитьОстатки(Профиль, Выборка.Ссылка);
		КонецЦикла;
		
		Возврат;
		
	КонецЕсли;

КонецПроцедуры //- ИнфоСофт Ивонин К.А. 07.11.24 УА #68001

#Область РаботаСТоварами

//+ ИнфоСофт Ивонин К.А. 03.03.25 УА #92887
Функция КоличествоТоваров(Профиль) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	КОЛИЧЕСТВО(1) КАК Количество
	|ИЗ
	|	Справочник.ИС_МВМ_Товары КАК ИС_МВМ_Товары
	|ГДЕ
	|	ИС_МВМ_Товары.Профиль = &Профиль";
	
	Запрос.УстановитьПараметр("Профиль", Профиль);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаКоличества = РезультатЗапроса.Выбрать();
	
	Если ВыборкаКоличества.Следующий() Тогда
		Возврат ВыборкаКоличества.Количество;
	КонецЕсли;
	
	Возврат 0;
	
КонецФункции //- ИнфоСофт Ивонин К.А. 03.03.25 УА #92887

//+ ИнфоСофт Ивонин К.А. 25.10.24 УА #68001
Функция ОбработатьДопПараметрыЗагрузкиТоваров(ДопПараметры) Экспорт	
	
	ПараметрыТаблицы = Новый Структура;
	ПараметрыТаблицы.Вставить("СпособЧтенияЗначений", СпособЧтенияЗначенийТабличногоДокумента.Значение);
	ПараметрыТаблицы.Вставить("ПерваяСтрока", 2);
	ТаблицаТоваров = ИС_МП_Сервер.ТаблицаЗначенийИзExcel(ДопПараметры.Адрес, ПараметрыТаблицы);
	
	Если ТаблицаТоваров = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	МассивУдаляемыхСтрок = Новый Массив;
	
	Для Каждого Строка Из ТаблицаТоваров Цикл
		
		Если Строка.СхемаПродажи <> "Маркетплейс" Тогда
			МассивУдаляемыхСтрок.Добавить(Строка);
		КонецЕсли;
		
	КонецЦикла;
	
	Для Каждого Элемент Из МассивУдаляемыхСтрок Цикл
		ТаблицаТоваров.Удалить(Элемент);	
	КонецЦикла;
	
	ДопПараметры = Новый Структура("Таблица", ТаблицаТоваров);
	Возврат ДопПараметры;
	
КонецФункции //- ИнфоСофт Ивонин К.А. 25.10.24 УА #68001

//+ ИнфоСофт Ивонин К.А. 25.10.24 УА #68001
Функция ЗагрузитьТовары(Профиль, Перезаполнять, ДопПараметры) Экспорт
		
	ТЗ = Новый ТаблицаЗначений;
	ТЗ.Колонки.Добавить("SapМВидео", ОбщегоНазначения.ОписаниеТипаСтрока(50));
	ТЗ.Колонки.Добавить("ДатаПубликации", ОбщегоНазначения.ОписаниеТипаДата(ЧастиДаты.ДатаВремя));
	
	Для Каждого Строка Из ДопПараметры.Таблица Цикл
		
		НоваяСтрока = ТЗ.Добавить();
		НоваяСтрока.SapМВидео = Строка.Sap_кодМвидео;
		НоваяСтрока.ДатаПубликации = ?(Перезаполнять, ТекущаяДатаСеанса(), Строка.ДатаПубликацииВЛКП);	
		
	КонецЦикла;
		
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ТЗ.SapМВидео КАК SapМВидео,
	|	ТЗ.ДатаПубликации КАК ДатаПубликации
	|ПОМЕСТИТЬ ВТ_Товары
	|ИЗ
	|	&ТЗ КАК ТЗ
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_Товары.SapМВидео КАК SapМВидео,
	|	ЕСТЬNULL(ИС_МВМ_Товары.Ссылка, ЗНАЧЕНИЕ(Справочник.ИС_МВМ_Товары.ПустаяСсылка)) КАК Ссылка
	|ИЗ
	|	ВТ_Товары КАК ВТ_Товары
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ИС_МВМ_Товары КАК ИС_МВМ_Товары
	|		ПО ВТ_Товары.SapМВидео = ИС_МВМ_Товары.SapМВидео
	|			И (ИС_МВМ_Товары.Профиль = &Профиль)
	|ГДЕ
	|	(ИС_МВМ_Товары.Ссылка ЕСТЬ NULL
	|			ИЛИ ВТ_Товары.ДатаПубликации > ИС_МВМ_Товары.ДатаПубликации)";
		
	Запрос.УстановитьПараметр("ТЗ", ТЗ);
	Запрос.УстановитьПараметр("Профиль", Профиль);
		
	РезультатЗапроса = Запрос.Выполнить();
	Выборка = РезультатЗапроса.Выбрать();
	
	ВсегоТоваров = Выборка.Количество();
	
	Счетчик = 0;
	
	Пока Выборка.Следующий() Цикл
		
		НайденныеСтроки = ДопПараметры.Таблица.НайтиСтроки(Новый Структура("Sap_кодМвидео", Выборка.SapМВидео));
		
		Если НайденныеСтроки.Количество() = 0 Тогда
			Продолжить;
		КонецЕсли;
		
		СоздатьИлиОбновитьТовар(Профиль, Выборка.Ссылка, Выборка.SapМВидео, НайденныеСтроки[0]);

		Если Счетчик % 50 = 0 Тогда
			ДлительныеОперации.СообщитьПрогресс( , "Уже обработано " + Счетчик + " из " + ВсегоТоваров + " товаров");
		КонецЕсли;
		
		Счетчик = Счетчик + 1;
		
	КонецЦикла;
		
	Возврат "Загрузка завершена. Всего обработкано " + Счетчик + " элементов";	

КонецФункции //- ИнфоСофт Ивонин К.А. 25.10.24 УА #68001

//+ ИнфоСофт Ивонин К.А. 28.10.24 УА #68001
Функция ТекстЗапросаСопоставления() Экспорт

	Текст =
	"ВЫБРАТЬ
	|	ИС_МВМ_Товары.Ссылка КАК ТоварМВМ,
	|	ИС_МВМ_Товары.Артикул КАК АртикулМВМ,
	|	ИС_МВМ_Товары.Штрихкод КАК ШтрихкодМВМ,
	|	ЕСТЬNULL(ИС_МВМ_СоответствиеТоваров.Номенклатура, ЗНАЧЕНИЕ(Справочник.Номенклатура.ПустаяСсылка)) КАК Номенклатура,
	|	ЕСТЬNULL(ИС_МВМ_СоответствиеТоваров.Характеристика, ЗНАЧЕНИЕ(Справочник.ХарактеристикиНоменклатуры.ПустаяСсылка)) КАК Характеристика,
	|	ВЫБОР
	|		КОГДА ИС_МВМ_СоответствиеТоваров.Упаковка = &ПустаяУпаковка
	|				ИЛИ ИС_МВМ_СоответствиеТоваров.Упаковка ЕСТЬ NULL
	|			ТОГДА ИС_МВМ_СоответствиеТоваров.Номенклатура.ЕдиницаИзмерения
	|		ИНАЧЕ ИС_МВМ_СоответствиеТоваров.Упаковка
	|	КОНЕЦ КАК Упаковка
	|ИЗ
	|	Справочник.ИС_МВМ_Товары КАК ИС_МВМ_Товары
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ИС_МВМ_СоответствиеТоваров КАК ИС_МВМ_СоответствиеТоваров
	|		ПО (ИС_МВМ_СоответствиеТоваров.Профиль = &Профиль
	|				И ИС_МВМ_Товары.Ссылка = ИС_МВМ_СоответствиеТоваров.ТоварМВМ)
	|ГДЕ
	|	ИС_МВМ_Товары.Профиль = &Профиль
	|	И НЕ ИС_МВМ_Товары.ПометкаУдаления
	|
	|УПОРЯДОЧИТЬ ПО
	|	Номенклатура,
	|	ТоварМВМ";  
	
	Возврат Текст;
	
КонецФункции //- ИнфоСофт Ивонин К.А. 28.10.24 УА #68001

//+ ИнфоСофт Ивонин К.А. 28.10.24 УА #68001
Функция ДобавитьСоответствиеТовара(Профиль, ТоварМВМ, Номенклатура, Характеристика, Упаковка, 
		ТекНоменклатура, ТекХарактеристика) Экспорт
		
	НаборЗаписей = РегистрыСведений.ИС_МВМ_СоответствиеТоваров.СоздатьНаборЗаписей();
	
	НаборЗаписей.Отбор.Профиль.Установить(Профиль);
	НаборЗаписей.Отбор.ТоварМВМ.Установить(ТоварМВМ);
		
	НаборЗаписей.Прочитать(); 
	
	ТребуетсяНоваяЗапись = Истина;	
	Если НаборЗаписей.Количество() > 0 Тогда 
		
		Для Каждого Запись Из НаборЗаписей Цикл
		
			Если Запись.Номенклатура = ТекНоменклатура И Запись.Характеристика = ТекХарактеристика Тогда
			
				Запись.Номенклатура = Номенклатура;
				Запись.Характеристика = Характеристика;
				Запись.Упаковка = Упаковка;
        		ТребуетсяНоваяЗапись = Ложь;
        		Прервать;
			
			КонецЕсли;
		
		КонецЦикла; 	
	
	КонецЕсли;
   
    Если ТребуетсяНоваяЗапись Тогда
	
		НоваяЗапись = НаборЗаписей.Добавить();
		
		НоваяЗапись.Профиль = Профиль; 
		НоваяЗапись.ТоварМВМ = ТоварМВМ;
		НоваяЗапись.Номенклатура = Номенклатура; 
		НоваяЗапись.Характеристика = Характеристика;
		НоваяЗапись.Упаковка = Упаковка;
		
	КонецЕсли;
				
	НаборЗаписей.Записывать = Истина; 
	
	НаборЗаписей.Записать(Истина);
	
КонецФункции //- ИнфоСофт Ивонин К.А. 28.10.24 УА #68001

