//+ ИнфоСофт Ивонин К.А. 28.10.24 УА #68001
Процедура ВыгрузитьОстатки(Профиль, Склад, ТаблицаВыгрузки = Неопределено) Экспорт
	
	Событие = ИмяСобытия("ВыгрузитьОстатки");
	
	ПеречислениеМП = Перечисления.ИС_МП_Маркетплейсы.МВМ;
	
	ПараметрыЗапроса = ПараметрыHTTPЗапроса(Профиль);
		
	МассивНастроек = ИС_МП_УправлениеОстатками.МассивПараметровВыгрузкиОстатков();	
	
	Настройки = ИС_МП_Сервер.ПолучитьЗначениеНастроек(Профиль, ПеречислениеМП, МассивНастроек);
		
	ИспользоватьПоследниеОстатки = Ложь;
	
	Если Настройки.ИспользоватьПоследниеОстатки <> Неопределено Тогда
		ИспользоватьПоследниеОстатки = Настройки.ИспользоватьПоследниеОстатки;
	КонецЕсли;
		
	Если ТаблицаВыгрузки = Неопределено Тогда		
		ТаблицаВыгрузки = ИС_МП_УправлениеОстатками.СформироватьТаблицуВыгрузки(Профиль, Склад, ПеречислениеМП, Настройки);		
	КонецЕсли;
	
	Если ТаблицаВыгрузки.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	warehouseCode = "";
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ИС_МВМ_Склады.warehouseCode КАК warehouseCode
	|ИЗ
	|	Справочник.ИС_МВМ_Склады КАК ИС_МВМ_Склады
	|ГДЕ
	|	ИС_МВМ_Склады.Ссылка = &Ссылка";
	
	Запрос.УстановитьПараметр("Ссылка", Склад);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаСклада = РезультатЗапроса.Выбрать();
	
	Если ВыборкаСклада.Следующий() Тогда
		warehouseCode = ВыборкаСклада.warehouseCode;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(warehouseCode) Тогда
		ТекстОшибки = "Не заполнен ""R-объект"" у склада " + Склад;
		ИС_МП_Сервер.ЗаписатьВЖРИСообщитьПользователю(Событие, ТекстОшибки);
		Возврат;
	КонецЕсли;
	
	МассивОстатков = Новый Массив;
		
	Для Каждого Строка Из ТаблицаВыгрузки Цикл
		
		Остаток = Новый Структура;
		Остаток.Вставить("warehouseCode", warehouseCode);
		Остаток.Вставить("materialCode", Строка.SapМВМ);
		Остаток.Вставить("quantity", Строка.Остаток);
		Остаток.Вставить("unit", "PIECES");
		
		МассивОстатков.Добавить(Остаток);
		
	КонецЦикла;
		
	Результат = ИС_МВМ_АПИ.ВыгрузитьОстатки(Профиль, ПараметрыЗапроса, МассивОстатков);
	
	БылиОшибкиВыгрузки = Ложь;
	
	Если Результат = Неопределено Тогда
		БылиОшибкиВыгрузки = Истина;
	Иначе
		ОбщегоНазначения.СообщитьПользователю("Остатки успешно выгружены " + Результат);
	КонецЕсли;
	
	Если Не ИспользоватьПоследниеОстатки Тогда
		Возврат;
	КонецЕсли;
	
	Если Не БылиОшибкиВыгрузки Тогда
		
		Для Каждого Строка Из ТаблицаВыгрузки Цикл
			ИС_МП_УправлениеОстатками.ЗаписатьПоследнийВыгруженныйОстаток(Профиль, ПеречислениеМП, Склад, 
				Строка.ТоварМВМ, Строка.Остаток);
		КонецЦикла;
	
	КонецЕсли;	
	
КонецПроцедуры //- ИнфоСофт Ивонин К.А. 28.10.24 УА #68001

