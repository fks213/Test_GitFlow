#Область Настройки

//+ ИнфоСофт Ивонин К.А. 21.10.24 УА #68001
Процедура ПолучитьНастройки(Форма) Экспорт
	
	Если Не Форма.Объект.ИнтеграцияМВМ Тогда
		Возврат;
	КонецЕсли;
	
	МассивНастроек = МассивНастроекПодключения();
	МассивНастроек = МассивНастроекОстатков(МассивНастроек);
	МассивНастроек = МассивНастроекЦен(МассивНастроек);
	
	СтруктураНастроек = ИС_МП_Сервер.ПолучитьЗначениеНастроек(Форма.Объект.Ссылка, Перечисления.ИС_МП_Маркетплейсы.МВМ, МассивНастроек);

	СтруктураПараметров = Новый Структура;

	Для Каждого Элемент Из СтруктураНастроек Цикл
		СтруктураПараметров.Вставить("МВМ" + Элемент.Ключ, Элемент.Значение);	
	КонецЦикла;
		
	ЗаполнитьЗначенияСвойств(Форма, СтруктураПараметров);
	
	МассивНастроек = Новый Массив;
	МассивНастроек.Добавить("AccessToken");
	МассивНастроек.Добавить("RefreshToken");
	
	СтруктураНастроек = ИС_МП_Сервер.ПолучитьЗначениеНастроек(Форма.Объект.Ссылка, 
		Перечисления.ИС_МП_Маркетплейсы.МВМ, МассивНастроек, "Строка");
		
	Форма.МВМAccessToken = СтруктураНастроек.AccessToken;
	Форма.МВМRefreshToken = СтруктураНастроек.RefreshToken;
		
КонецПроцедуры //- ИнфоСофт Ивонин К.А. 21.10.24 УА #68001

//+ ИнфоСофт Ивонин К.А. 21.10.24 УА #68001
Процедура ЗаписатьНастройки(Форма) Экспорт
	
	Если Не Форма.Объект.ИнтеграцияМВМ Тогда
		Возврат;
	КонецЕсли;
	
	МассивНастроек = МассивНастроекПодключения();
	МассивНастроек = МассивНастроекОстатков(МассивНастроек);
	МассивНастроек = МассивНастроекЦен(МассивНастроек);
	
	СтруктураНастроек = Новый Структура;
	
	Для Каждого Элемент Из МассивНастроек Цикл
		
		Если Элемент = "AccessToken" Или Элемент = "RefreshToken" Тогда
			Продолжить;
		КонецЕсли;
		
		СтруктураНастроек.Вставить("МВМ" + Элемент, Неопределено);
		
	КонецЦикла;
	
	ЗаполнитьЗначенияСвойств(СтруктураНастроек, Форма);
	
	СтруктураПараметров = Новый Структура;
	
	Для Каждого Элемент Из СтруктураНастроек Цикл
		СтруктураПараметров.Вставить(СтрЗаменить(Элемент.Ключ, "МВМ", ""), Элемент.Значение);	
	КонецЦикла;
	
	Маркетплейс = Перечисления.ИС_МП_Маркетплейсы.МВМ;
	
	ИС_МП_Сервер.ЗаписатьЗначениеНастроек(Форма.Объект.Ссылка, Маркетплейс, СтруктураПараметров);
	
	СтруктураПараметров = Новый Структура;
	СтруктураПараметров.Вставить("AccessToken", Форма.МВМAccessToken);
	СтруктураПараметров.Вставить("RefreshToken", Форма.МВМRefreshToken);
	
	ИС_МП_Сервер.ЗаписатьЗначениеНастроек(Форма.Объект.Ссылка, Маркетплейс, СтруктураПараметров, "Строка");
	
КонецПроцедуры //- ИнфоСофт Ивонин К.А. 21.10.24 УА #68001

//+ ИнфоСофт Ивонин К.А. 21.10.24 УА #68001
Функция МассивНастроекПодключения(МассивНастроек = Неопределено) Экспорт
	
	Если МассивНастроек = Неопределено Тогда
		МассивНастроек = Новый Массив;
	КонецЕсли;
	
	МассивНастроек.Добавить("АдресСервисаAPI");
	МассивНастроек.Добавить("Порт");
	МассивНастроек.Добавить("ЗащищенноеСоединение");
	МассивНастроек.Добавить("ClientId");
	МассивНастроек.Добавить("ApiKey");
	МассивНастроек.Добавить("AccessToken");
	МассивНастроек.Добавить("AccessTokenИстекает");
	МассивНастроек.Добавить("RefreshToken");
	МассивНастроек.Добавить("RefreshTokenИстекает");
	МассивНастроек.Добавить("РежимОтладки");
		
	Возврат МассивНастроек;
	
КонецФункции //- ИнфоСофт Ивонин К.А. 21.10.24 УА #68001 

