	|	И ИС_ВБ_ПоставкиFBS.Профиль = &Профиль
	|	И НЕ ИС_ВБ_ПоставкиFBS.ПометкаУдаления";

	_10Дней = 864000; // Могу существовать закрытые поставки, которые не будут отправлены	
