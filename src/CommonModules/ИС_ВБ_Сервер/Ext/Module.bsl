//+ ИнфоСофт Ивонин К.А. 21.02.25 УА #92887
Функция ТекстЗапросаСопоставления() Экспорт

	Текст = 
	"ВЫБРАТЬ
	|	ИС_WB_РазмерыНоменклатур.Владелец КАК НоменклатураWB,
	|	ИС_WB_РазмерыНоменклатур.Ссылка КАК РазмерWB,
	|	ЕСТЬNULL(ИС_WB_СоответствиеРазмеров.Номенклатура, ЗНАЧЕНИЕ(Справочник.Номенклатура.ПустаяСсылка)) КАК Номенклатура,
	|	ЕСТЬNULL(ИС_WB_СоответствиеРазмеров.Характеристика, ЗНАЧЕНИЕ(Справочник.ХарактеристикиНоменклатуры.ПустаяСсылка)) КАК Характеристика,
	|	ВЫБОР
	|		КОГДА ИС_WB_СоответствиеРазмеров.Упаковка = &ПустаяУпаковка
	|				ИЛИ ИС_WB_СоответствиеРазмеров.Упаковка ЕСТЬ NULL
	|			ТОГДА ИС_WB_СоответствиеРазмеров.Номенклатура.ЕдиницаИзмерения
	|		ИНАЧЕ ИС_WB_СоответствиеРазмеров.Упаковка
	|	КОНЕЦ КАК Упаковка
	|ИЗ
	|	Справочник.ИС_WB_РазмерыНоменклатур КАК ИС_WB_РазмерыНоменклатур
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ИС_WB_СоответствиеРазмеров КАК ИС_WB_СоответствиеРазмеров
	|		ПО ИС_WB_РазмерыНоменклатур.Ссылка = ИС_WB_СоответствиеРазмеров.РазмерWB
	|			И (ИС_WB_СоответствиеРазмеров.Профиль = &Профиль)
	|ГДЕ
	|	ИС_WB_РазмерыНоменклатур.Профиль = &Профиль
	|	И НЕ ИС_WB_РазмерыНоменклатур.ПометкаУдаления
	|
	|УПОРЯДОЧИТЬ ПО
	|	Номенклатура,
	|	НоменклатураWB";
	
	Возврат Текст;
	
КонецФункции //- ИнфоСофт Ивонин К.А. 21.02.25 УА #92887

#Область КатегорииПредметыХарактеристики
	
//+ ИнфоСофт Ивонин К.А. 10.02.25 УА #92406
Функция НайтиИлиСоздатьКатегорию(Профиль, Имя, IDПредмета = Неопределено, 
	 	КешКатегорий = Неопределено, КешХарактеристикКатегорий = Неопределено, Перезаполнять = Ложь) Экспорт
	
	Событие = ИмяСобытия("НайтиИлиСоздатьКатегорию");
	
	Категория = Справочники.ИС_WB_Категории.НайтиПоНаименованию(Имя, Истина);
	
	Если Не Категория.Пустая() И Не Перезаполнять Тогда
		Возврат Категория;
	КонецЕсли;
	
	Если КешКатегорий <> Неопределено Тогда
		 
		ИскомыйКэш = КешКатегорий.Найти(Имя);	
		
		Если ИскомыйКэш <> Неопределено Тогда
			Возврат Категория; 	
		КонецЕсли;
		
	КонецЕсли;
	
	ПараметрыЗапроса = ПараметрыHTTPЗапроса(Профиль, "Контент");
	
	СтруктураЗапроса = ИС_ВБ_АПИ.СтруктураПараметровЗапросаСпискаПредметов();
	СтруктураЗапроса.name = Имя;
		
	СписокПредметов = ИС_ВБ_АПИ.СписокПредметов(Профиль, ПараметрыЗапроса, СтруктураЗапроса);
		
	Если СписокПредметов = Неопределено Или СписокПредметов.Количество() = 0 Тогда
		
		Если IDПредмета = Неопределено Тогда
			Возврат Справочники.ИС_WB_Категории.ПустаяСсылка();
		КонецЕсли;
		
		ОбщегоНазначения.СообщитьПользователю("Не найдена категория: " + Имя + ", категория будет создана автоматически");
		
		JSON = Новый Структура;
		JSON.Вставить("subjectName", Имя);
		JSON.Вставить("subjectID",   IDПредмета);
		JSON.Вставить("parentName",  "");	
		
	Иначе
		JSON = СписокПредметов[0];
	КонецЕсли;
	
	Если Категория.Пустая() Тогда
		Категория = Справочники.ИС_WB_Категории.СоздатьЭлемент();
	Иначе
		Категория = Категория.ПолучитьОбъект();
	КонецЕсли;
	
	Категория.Наименование = JSON.subjectName;
	Категория.subjectID = JSON.subjectID;
	Категория.РодительскаяКатегория = JSON.parentName; 
	
	СписокХарактеристик = ИС_ВБ_АПИ.ХарактеристикиПредмета(Профиль, ПараметрыЗапроса, JSON.subjectID);
	
	Если СписокХарактеристик <> Неопределено Тогда
		Категория.Характеристики.Очистить();
		ЗаполнитьХарактеристикиКатегории(СписокХарактеристик, Категория.Характеристики, 
			КешХарактеристикКатегорий, Перезаполнять);
		Категория.Характеристики.Сортировать("Поле");
	КонецЕсли;
									
	Попытка	
		
		Категория.Записать();
		
		Если КешКатегорий <> Неопределено Тогда
			КешКатегорий.Добавить(Имя);
		КонецЕсли;
								
		Возврат Категория.Ссылка;	
	
	Исключение	
		Текст = ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
		ИС_МП_Сервер.ЗаписатьВЖРИСообщитьПользователю(Событие, Текст);			
	КонецПопытки;
	
	Возврат Справочники.ИС_WB_Категории.ПустаяСсылка();
						
КонецФункции //- ИнфоСофт Власова И.С. 04.02.25 УА #92612

