//+ ИнфоСофт Ивонин К.А. 08.02.25 УА #92406
Функция ЗагрузитьТовары(Профиль, Перезаполнять = Ложь, ДопПараметры = Неопределено) Экспорт
	
	Событие = ИмяСобытия("ЗагрузитьТовары");
	
	ПараметрыЗапроса = ПараметрыHTTPЗапроса(Профиль, "Контент");
	
	КоличествоЭлементовНаЗапрос = 
		?(ПараметрыЗапроса.КоличествоЭлементовНаЗапрос > 100, 100, ПараметрыЗапроса.КоличествоЭлементовНаЗапрос);
	КоличествоПопытокЗапроса = ПараметрыЗапроса.КоличествоПопытокЗапроса;
	
	СтруктураПараметров = ИС_ВБ_АПИ.СтруктураПараметровЗапросаСпискаТоваров();
	
	СтруктураПараметров.settings.cursor.limit = КоличествоЭлементовНаЗапрос;
	
	МассивNmID = Новый Массив;
	
	Обработано = 0;
	КоличествоОшибок = 0;
	ПервыйЗапрос = Истина;    
		
	ТаблицаЗначений = Новый ТаблицаЗначений;
	ТаблицаЗначений.Колонки.Добавить("ДатаОбновления", Новый ОписаниеТипов("Дата"));
	ТаблицаЗначений.Колонки.Добавить("nmID", ОбщегоНазначения.ОписаниеТипаЧисло(15));
	
	КешКатегорий = Новый Массив;
	КешХарактеристикКатегорий = Новый Массив;
	
	СоответствиеТоваровДляЗагрузки = Новый Соответствие;
	
	МассивТоваров = Новый Массив;
	
	Пока Истина Цикл 
		
		ТаблицаЗначений.Очистить();    
		СоответствиеТоваровДляЗагрузки.Очистить();
		
		Если КоличествоОшибок >= КоличествоПопытокЗапроса Тогда
			ВызватьИсключение("Превышено количество ошибок при запросах к API");
		КонецЕсли;
		
		СписокТоваров = ИС_ВБ_АПИ.СписокКарточекТоваров(Профиль, ПараметрыЗапроса, СтруктураПараметров);
		
		Если СписокТоваров = Неопределено Тогда
			КоличествоОшибок = КоличествоОшибок + 1;
			Продолжить;
		КонецЕсли;
						
		Для Каждого Элемент Из СписокТоваров["cards"] Цикл
		
			НоваяСтрока = ТаблицаЗначений.Добавить();
			НоваяСтрока.nmID = Элемент["nmID"];
			МассивNmID.Добавить(Элемент["nmID"]);
			НоваяСтрока.ДатаОбновления = ?(Перезаполнять, ТекущаяДатаСеанса(), 
				ИС_МП_РаботаСHTTPЗапросами.ПрочитатьДатуИзJSON(Элемент["updatedAt"], ФорматДатыJSON.ISO));	
			СоответствиеТоваровДляЗагрузки.Вставить(Элемент["nmID"], Элемент);
		
		КонецЦикла;
		
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	ТЧ.ДатаОбновления КАК ДатаОбновления,
		|	ТЧ.nmID КАК nmID
		|ПОМЕСТИТЬ ВТ_nmID
		|ИЗ
		|	&ТЧ КАК ТЧ
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	isNULL(ИС_WB_Номенклатура.updateAt, ДатаВремя(3999, 12, 31, 23, 59, 59)) КАК ДатаПоследнегоИзменения,
		|	ВТ_nmID.ДатаОбновления КАК ДатаОбновления,
		|	ВТ_nmID.nmID КАК nmID,
		|	ИС_WB_Номенклатура.Ссылка КАК ИС_WB_Номенклатура
		|ПОМЕСТИТЬ ВТ_Номенклатура
		|ИЗ
		|	ВТ_nmID КАК ВТ_nmID
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ИС_WB_Номенклатура КАК ИС_WB_Номенклатура
		|		ПО ВТ_nmID.nmID = ИС_WB_Номенклатура.Код
		|			И (ИС_WB_Номенклатура.Профиль = &Профиль)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ВТ_Номенклатура.nmID КАК nmID
		|ИЗ
		|	ВТ_Номенклатура КАК ВТ_Номенклатура
		|ГДЕ
		|	ВТ_Номенклатура.ИС_WB_Номенклатура ЕСТЬ NULL
		|
		|ОБЪЕДИНИТЬ
		|
		|ВЫБРАТЬ
		|	ВТ_Номенклатура.nmID
		|ИЗ
		|	ВТ_Номенклатура КАК ВТ_Номенклатура
		|ГДЕ
		|	ВТ_Номенклатура.ДатаОбновления > ВТ_Номенклатура.ДатаПоследнегоИзменения";
		
		Запрос.УстановитьПараметр("ТЧ", ТаблицаЗначений);
		Запрос.УстановитьПараметр("Профиль", Профиль);
		
		РезультатЗапроса = Запрос.Выполнить();
		Выборка = РезультатЗапроса.Выбрать();
		
		Пока Выборка.Следующий() Цикл
			
			Товар = СоздатьИлиОбновитьНоменклатуру(Профиль, СоответствиеТоваровДляЗагрузки[Выборка.nmID], 
				КешКатегорий, КешХарактеристикКатегорий, Перезаполнять);
				
			Если Товар <> Неопределено Тогда
				МассивТоваров.Добавить(Товар);	
			КонецЕсли;
				
		КонецЦикла;
		
		Обработано = Обработано + СписокТоваров["cursor"]["total"];
		ДлительныеОперации.СообщитьПрогресс( , "Уже обработано " + Обработано + " карточек товаров");
		
		Если КоличествоЭлементовНаЗапрос > СписокТоваров["cursor"]["total"] Тогда
			Прервать;
		КонецЕсли;
		
		Если ПервыйЗапрос Тогда
			СтруктураПараметров.settings.cursor.Вставить("updatedAt", СписокТоваров["cursor"]["updatedAt"]);
			СтруктураПараметров.settings.cursor.Вставить("nmID", СписокТоваров["cursor"]["nmID"]);
			ПервыйЗапрос = Ложь;
		Иначе
			СтруктураПараметров.settings.cursor.updatedAt = СписокТоваров["cursor"]["updatedAt"];
			СтруктураПараметров.settings.cursor.nmID = СписокТоваров["cursor"]["nmID"];
		КонецЕсли;
		
	КонецЦикла;
	
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ИС_WB_Номенклатура.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.ИС_WB_Номенклатура КАК ИС_WB_Номенклатура
	|ГДЕ
	|	ИС_WB_Номенклатура.Профиль = &Профиль
	|	И НЕ ИС_WB_Номенклатура.Код В (&Код)
	|	И НЕ ИС_WB_Номенклатура.ПометкаУдаления";
	
	Запрос.УстановитьПараметр("Код", МассивNmID);
	Запрос.УстановитьПараметр("Профиль", Профиль);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Выборка = РезультатЗапроса.Выбрать();
	
	Пока Выборка.Следующий() Цикл
		СправочникОбъект = Выборка.Ссылка.ПолучитьОбъект();
		СправочникОбъект.УстановитьПометкуУдаления(Истина);
	КонецЦикла;
	
	МассивНастроек = МассивНастроекТоваров();
	
	СтруктураНастроек = ИС_МП_Сервер.ПолучитьЗначениеНастроек(Профиль, Перечисления.ИС_МП_Маркетплейсы.ВБ, МассивНастроек);
	
	Если СтруктураНастроек.АвтоматическиСопоставлять = Истина 
			И ЗначениеЗаполнено(СтруктураНастроек.СопоставлятьПо) Тогда
			
		  СопоставитьТовары(Профиль, МассивТоваров, СтруктураНастроек.СопоставлятьПо);
			
	КонецЕсли;
	
	Если Профиль.ПомечатьНаУдалениеПеремещенныеВКорзинуТовары Тогда
			
		СтруктураПараметров = ИС_ВБ_АПИ.СтруктураПараметровЗапросаСпискаТоваров();
	
		СтруктураПараметров.settings.cursor.limit = КоличествоЭлементовНаЗапрос;
	
		КоличествоОшибок = 0;
		ПервыйЗапрос = Истина;    
		
		МассивNmIDВКорзине = Новый Массив;
				
		Пока Истина Цикл 
			   			
			Если КоличествоОшибок >= КоличествоПопытокЗапроса Тогда
				ВызватьИсключение("Превышено количество ошибок при запросах к API");
			КонецЕсли;
			
			СписокТоваровВКорзине = ИС_ВБ_АПИ.СписокКарточекТоваровВКорзине(Профиль, ПараметрыЗапроса, СтруктураПараметров);
			
			Если СписокТоваровВКорзине = Неопределено Тогда
				КоличествоОшибок = КоличествоОшибок + 1;
				Продолжить;
			КонецЕсли;
							
			Для Каждого Элемент Из СписокТоваровВКорзине["cards"] Цикл
			    МассивNmIDВКорзине.Добавить(Элемент["nmID"]);			
			КонецЦикла;
									
			Если КоличествоЭлементовНаЗапрос > СписокТоваровВКорзине["cursor"]["total"] Тогда
				Прервать;
			КонецЕсли;
			
			Если ПервыйЗапрос Тогда
				СтруктураПараметров.settings.cursor.Вставить("trashedAt", СписокТоваровВКорзине["cursor"]["trashedAt"]);
				СтруктураПараметров.settings.cursor.Вставить("nmID", СписокТоваровВКорзине["cursor"]["nmID"]);
				ПервыйЗапрос = Ложь;
			Иначе
				СтруктураПараметров.settings.cursor.trashedAt = СписокТоваровВКорзине["cursor"]["trashedAt"];
				СтруктураПараметров.settings.cursor.nmID = СписокТоваровВКорзине["cursor"]["nmID"];
			КонецЕсли;
			
		КонецЦикла;
		
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	ИС_WB_Номенклатура.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.ИС_WB_Номенклатура КАК ИС_WB_Номенклатура
		|ГДЕ
		|	ИС_WB_Номенклатура.Профиль = &Профиль
		|	И ИС_WB_Номенклатура.Код В (&Код)
		|	И НЕ ИС_WB_Номенклатура.ПометкаУдаления";
		
		Запрос.УстановитьПараметр("Код", МассивNmIDВКорзине);
		Запрос.УстановитьПараметр("Профиль", Профиль);
		
		РезультатЗапроса = Запрос.Выполнить();
		
		Выборка = РезультатЗапроса.Выбрать();
		
		Пока Выборка.Следующий() Цикл
			СправочникОбъект = Выборка.Ссылка.ПолучитьОбъект();
			СправочникОбъект.УстановитьПометкуУдаления(Истина);
		КонецЦикла;	
	
	КонецЕсли;	
	
	Возврат "Загрузка завершена. Всего загружено " + Обработано + " элементов"; 
	
КонецФункции //- ИнфоСофт Ивонин К.А. 28.09.22 УА #49591

//+ ИнфоСофт Ивонин К.А. 10.02.25 УА #92406
Функция ОпределитьТипТовара(Номенклатура) Экспорт
    
	ТипТовара = Перечисления.ИС_ВБ_ТипыТоваров.МГТ;
	
    СуммаДлинСторон = 0;
        
	Если Номенклатура.weightBrutto >= 25 Тогда	
		Возврат Перечисления.ИС_ВБ_ТипыТоваров.СГТ;
	КонецЕсли;	
			
	Если Номенклатура.length >= 120 Тогда	
		ТипТовара = Перечисления.ИС_ВБ_ТипыТоваров.КГТ;	
	КонецЕсли;
	
	СуммаДлинСторон = СуммаДлинСторон + Номенклатура.length;

   	Если Номенклатура.width >= 120 Тогда	
		ТипТовара = Перечисления.ИС_ВБ_ТипыТоваров.КГТ;
	КонецЕсли;
	
	СуммаДлинСторон = СуммаДлинСторон + Номенклатура.width;
	
	Если Номенклатура.height >= 120 Тогда	
		ТипТовара = Перечисления.ИС_ВБ_ТипыТоваров.КГТ;
	КонецЕсли;
	
	СуммаДлинСторон = СуммаДлинСторон + Номенклатура.height;
		    
	Если СуммаДлинСторон >= 200 Тогда	
		ТипТовара = Перечисления.ИС_ВБ_ТипыТоваров.СГТ;	
	КонецЕсли;
	
	Возврат ТипТовара;	

КонецФункции //- ИнфоСофт Ивонин К.А. 10.02.25 УА #92406

//+ ИнфоСофт Ивонин К.А. 28.09.22 УА #49591
Функция СоздатьИлиОбновитьНоменклатуру(Профиль, Данные, КешКатегорий, 
		КешХарактеристикКатегорий, Перезаполнять = Ложь) Экспорт
	
	Событие = ИмяСобытия("СоздатьИлиОбновитьНоменклатуру");

	Номенклатура = Справочники.ИС_WB_Номенклатура.НайтиПоКоду(Данные["nmID"]);	
	
	Если Номенклатура.Пустая() Тогда
		Номенклатура = Справочники.ИС_WB_Номенклатура.СоздатьЭлемент();	
	Иначе            
		Номенклатура = Номенклатура.ПолучитьОбъект();
	КонецЕсли;
	
	Номенклатура.ПометкаУдаления = Ложь;
	Номенклатура.Профиль = Профиль;
	Номенклатура.Код = Данные["nmID"];
	Номенклатура.Наименование = Данные["title"];	
	
	Номенклатура.imtID = Данные["imtID"];
	Номенклатура.nmUUID = Данные["nmUUID"];
	Номенклатура.vendorCode = Данные["vendorCode"];
	
	Номенклатура.length = Данные["dimensions"]["length"];
	Номенклатура.width =  Данные["dimensions"]["width"];
	Номенклатура.height = Данные["dimensions"]["height"];
	Номенклатура.weightBrutto = Данные["dimensions"]["weightBrutto"];
	Номенклатура.КорректностьГабаритов = Данные["dimensions"]["isValid"];
	
	Категория = НайтиИлиСоздатьКатегорию(Профиль, Данные["subjectName"], 
		Данные["subjectID"], КешКатегорий, КешХарактеристикКатегорий, Перезаполнять);          
	           
	Номенклатура.object = Категория; // subject
	Номенклатура.Бренд = Данные["brand"];
	Номенклатура.Описание = Данные["description"];
	Номенклатура.needKiz = Данные["needKiz"];
		
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ХарактеристикиКатегорий.Поле КАК Поле,
	|	ХарактеристикиКатегорий.Поле.Наименование КАК Имя,
	|	ХарактеристикиКатегорий.Обязательное КАК Обязательное
	|ИЗ
	|	Справочник.ИС_WB_Категории.Характеристики КАК ХарактеристикиКатегорий
	|ГДЕ
	|	ХарактеристикиКатегорий.Ссылка = &Категория";
	
	Запрос.УстановитьПараметр("Категория", Категория);	
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ТаблицаДоступныхПолей = РезультатЗапроса.Выгрузить();
	
	Номенклатура.Характеристики.Очистить();
	
	Если Данные["characteristics"] <> Неопределено Тогда
	
		Для Каждого Поле Из Данные["characteristics"] Цикл
			
			НайденноеПоле = ТаблицаДоступныхПолей.НайтиСтроки(Новый Структура("Имя", Поле["name"]));
				
			Если НайденноеПоле.Количество() = 0 Тогда
				Продолжить;	
			КонецЕсли;
				
			Если ТипЗнч(Поле["value"]) = Тип("Массив") Тогда			    
				
				Для Каждого Параметр Из Поле["value"] Цикл
					
					НоваяСтрока = Номенклатура.Характеристики.Добавить();
					НоваяСтрока.Поле = НайденноеПоле[0].Поле;
					НоваяСтрока.Обязательное = НайденноеПоле[0].Обязательное;
					
					НоваяСтрока.Значение = Параметр;				
					НоваяСтрока.ЗначениеСтроковое = Строка(Параметр);
					
				КонецЦикла;
				
			Иначе
				
				НоваяСтрока = Номенклатура.Характеристики.Добавить();
				НоваяСтрока.Поле = НайденноеПоле[0].Поле;
				НоваяСтрока.Обязательное = НайденноеПоле[0].Обязательное;
				
				НоваяСтрока.Значение = Поле["value"];				
				НоваяСтрока.ЗначениеСтроковое = Строка(Поле["value"]);
				
			КонецЕсли;
								
		КонецЦикла;
				
		Номенклатура.Характеристики.Сортировать("Поле");
	
	КонецЕсли;
	
	Номенклатура.ТипТовара = ОпределитьТипТовара(Номенклатура);
	
	Номенклатура.МедиаФайлы.Очистить();
	
	Если Данные["photos"] <> Неопределено Тогда 
	
		Для Каждого СоответствиеФото Из Данные["photos"] Цикл		
			НоваяСтрока = Номенклатура.МедиаФайлы.Добавить();
			НоваяСтрока.Адрес = СоответствиеФото["big"];		
		КонецЦикла;
			
	КонецЕсли;
	
	Если Данные["video"] <> Неопределено Тогда
		НоваяСтрока = Номенклатура.МедиаФайлы.Добавить();
		НоваяСтрока.Адрес = Данные["video"];
	КонецЕсли;
		
	Номенклатура.МедиаФайлы.Сортировать("Адрес");
		
	Номенклатура.updateAt = ИС_МП_РаботаСHTTPЗапросами.ПрочитатьДатуИзJSON(Данные["updatedAt"], ФорматДатыJSON.ISO);
	Номенклатура.createdAt = ИС_МП_РаботаСHTTPЗапросами.ПрочитатьДатуИзJSON(Данные["createdAt"], ФорматДатыJSON.ISO);
	
	// TODO
	//	tags
	//		id
	//		name
	//		color
	
	Попытка
		Номенклатура.Записать();
	Исключение
		Текст = ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
		ИС_МП_Сервер.ЗаписатьВЖРИСообщитьПользователю(Событие, Текст);
		Возврат Неопределено;
	КонецПопытки;
	
	Для Каждого Размер Из Данные["sizes"] Цикл
		НайтиИлиСоздатьХарактеристику(Профиль, Размер, Номенклатура.Ссылка);			
	КонецЦикла;
	
	Возврат Номенклатура.Ссылка;
	
КонецФункции //- ИнфоСофт Ивонин К.А. 28.09.22 УА #49591

