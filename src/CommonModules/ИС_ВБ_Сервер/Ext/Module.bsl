//+ ИнфоСофт Ивонин К.А. 27.03.25 УА #63915
Функция ПодобратьТовары(Профиль, МассивРазмеров, Параметры) Экспорт
	
	Запрос = Новый Запрос;
	
	Если Параметры.СопоставлятьПо = "Штрихкод" Тогда
		
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	ИС_WB_ШтрихкодыРазмеров.Размер КАК ПолеСопоставления,
		|	ШтрихкодыНоменклатуры.Номенклатура КАК Номенклатура,
		|	ШтрихкодыНоменклатуры.Характеристика КАК Характеристика,
		|	ШтрихкодыНоменклатуры.#Упаковка КАК Упаковка
		|ИЗ
		|	РегистрСведений.ИС_WB_ШтрихкодыРазмеров КАК ИС_WB_ШтрихкодыРазмеров
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ШтрихкодыНоменклатуры КАК ШтрихкодыНоменклатуры
		|		ПО (ИС_WB_ШтрихкодыРазмеров.Профиль = &Профиль)
		|			И (ИС_WB_ШтрихкодыРазмеров.Штрихкод = ШтрихкодыНоменклатуры.Штрихкод)
		|ГДЕ
		|	ИС_WB_ШтрихкодыРазмеров.Размер В(&Размеры)
		|	И НЕ ШтрихкодыНоменклатуры.Номенклатура ЕСТЬ NULL
		|
		|СГРУППИРОВАТЬ ПО
		|	ИС_WB_ШтрихкодыРазмеров.Размер,
		|	ШтрихкодыНоменклатуры.Номенклатура,
		|	ШтрихкодыНоменклатуры.Характеристика,
		|	ШтрихкодыНоменклатуры.#Упаковка";
		
	ИначеЕсли Параметры.СопоставлятьПо = "Артикул" Тогда
		
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	ИС_WB_РазмерыНоменклатур.Ссылка КАК ПолеСопоставления,
		|	Номенклатура.Ссылка КАК Номенклатура,
		|	ЗНАЧЕНИЕ(Справочник.ХарактеристикиНоменклатуры.ПустаяСсылка) КАК Характеристика,
		|	Номенклатура.ЕдиницаИзмерения КАК ЕдиницаИзмерения
		|ИЗ
		|	Справочник.ИС_WB_РазмерыНоменклатур КАК ИС_WB_РазмерыНоменклатур
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Номенклатура КАК Номенклатура
		|		ПО ИС_WB_РазмерыНоменклатур.Владелец.vendorCode = Номенклатура.Артикул
		|ГДЕ
		|	ИС_WB_РазмерыНоменклатур.Ссылка В(&Размеры)
		|	И НЕ Номенклатура.Ссылка ЕСТЬ NULL";
		
	Иначе
		
		МассивПараметров = Новый Массив();
		МассивПараметров.Добавить("ТекстЗапросаСопоставления");
	
		Настройки = ИС_МП_Сервер.ПолучитьЗначениеНастроек(Профиль, 
			Перечисления.ИС_МП_Маркетплейсы.ВБ, МассивПараметров, "Строка");
				
