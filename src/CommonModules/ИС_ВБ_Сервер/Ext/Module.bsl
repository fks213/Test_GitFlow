//+ ИнфоСофт Ивонин К.А. 17.02.25 УА #92887
Функция НайтиИлиСоздатьПоставку(Профиль, supplyId, ИнформацияОПоставке = Неопределено, Перезаполнять = Ложь) Экспорт 

	Событие = ИмяСобытия("НайтиИлиСоздатьПоставку");
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	ИС_ВБ_ПоставкиFBS.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.ИС_ВБ_ПоставкиFBS КАК ИС_ВБ_ПоставкиFBS
	|ГДЕ
	|	ИС_ВБ_ПоставкиFBS.Профиль = &Профиль
	|	И ИС_ВБ_ПоставкиFBS.Код = &Код";
	
	Запрос.УстановитьПараметр("Профиль", Профиль);
	Запрос.УстановитьПараметр("Код", supplyId);	
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаПоставки = РезультатЗапроса.Выбрать();
	
	Поставка = Справочники.ИС_ВБ_ПоставкиFBS.ПустаяСсылка();
	
	Если ВыборкаПоставки.Следующий() Тогда
		Поставка = ВыборкаПоставки.Ссылка;
	КонецЕсли;
	
	Если Не Поставка.Пустая() И Не Перезаполнять Тогда
		Возврат Поставка;
	КонецЕсли;
		
	Если ИнформацияОПоставке = Неопределено Тогда
		ПараметрыЗапроса = ПараметрыHTTPЗапроса(Профиль, "Маркетплейс");
		ИнформацияОПоставке = ИС_ВБ_АПИ.ИнформацияОПоставке(Профиль, ПараметрыЗапроса, supplyId);
	КонецЕсли;		
	
	Если ИнформацияОПоставке = Неопределено Тогда
		Возврат Поставка;
	КонецЕсли;
	
	Если ИнформацияОПоставке = 404 Тогда
		
		Если Не Поставка.Пустая() Тогда
			Поставка.ПолучитьОбъект().УстановитьПометкуУдаления(Истина);
		КонецЕсли;
		
		Возврат Справочники.ИС_ВБ_ПоставкиFBS.ПустаяСсылка();
			
	КонецЕсли;
	
	Если Не Поставка.Пустая() Тогда
    	Поставка = Поставка.ПолучитьОбъект();
    Иначе
		Поставка = Справочники.ИС_ВБ_ПоставкиFBS.СоздатьЭлемент();
	КонецЕсли;
	
	Поставка.Код = ИнформацияОПоставке.id;
	Поставка.Профиль = Профиль;
	
	Если ЗначениеЗаполнено(ИнформацияОПоставке.name) Тогда
		Поставка.Наименование = ИнформацияОПоставке.name;
	Иначе
		Поставка.Наименование = ИнформацияОПоставке.id;
	КонецЕсли;
	
	Поставка.done = ИнформацияОПоставке.done;
	
	Поставка.createdAt = 
		ИС_МП_РаботаСHTTPЗапросами.ПрочитатьДатуИзJSON(ИнформацияОПоставке.createdAt, ФорматДатыJSON.ISO);
		
	Если ЗначениеЗаполнено(ИнформацияОПоставке.closedAt) Тогда
		Поставка.closedAt = 
			ИС_МП_РаботаСHTTPЗапросами.ПрочитатьДатуИзJSON(ИнформацияОПоставке.closedAt, ФорматДатыJSON.ISO);
	КонецЕсли; 
	
	Если ЗначениеЗаполнено(ИнформацияОПоставке.scanDt) Тогда
		Поставка.scanDt = 
			ИС_МП_РаботаСHTTPЗапросами.ПрочитатьДатуИзJSON(ИнформацияОПоставке.scanDt, ФорматДатыJSON.ISO);
	КонецЕсли;
		
	Если ЗначениеЗаполнено(ИнформацияОПоставке.rejectDt) Тогда
		Поставка.rejectDt = 
			ИС_МП_РаботаСHTTPЗапросами.ПрочитатьДатуИзJSON(ИнформацияОПоставке.rejectDt, ФорматДатыJSON.ISO);
	КонецЕсли;

    Поставка.ТипТовара = ЗначениеПеречисленияТипаТовара(ИнформацияОПоставке.cargoType);
		
	Если Поставка.done Тогда
	
		QR = ПолучитьQRПоставки(Профиль, Поставка.Код);
		
		Если QR <> Неопределено Тогда 
			Поставка.QR = Новый ХранилищеЗначения(QR, Новый СжатиеДанных(9)); 
		КонецЕсли;
	
	КонецЕсли;
	
	Если ИнформацияОПоставке.Свойство("next") Тогда
		Поставка.next = ИнформацияОПоставке.next;
	КонецЕсли;
	
	Попытка	
		Поставка.Записать();						
	Исключение
		
		ТекстОшибки = ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
		ИС_МП_Сервер.ЗаписатьВЖРИСообщитьПользователю(Событие, ТекстОшибки);
		
		Возврат Справочники.ИС_ВБ_ПоставкиFBS.ПустаяСсылка();
		
	КонецПопытки;
	
	СписокСборочныхЗаданий = СписокСборочныхЗаданийВПоставке(Профиль, supplyId);		
	
	МассивИдСборочныхЗаданий = Новый Массив;
	
	Если СписокСборочныхЗаданий <> Неопределено Тогда
		
		Для Каждого Элемент Из СписокСборочныхЗаданий Цикл
			МассивИдСборочныхЗаданий.Добавить(Элемент);	
		КонецЦикла;
		
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ИС_WB_СборочноеЗадание.Ссылка КАК Ссылка
	|ПОМЕСТИТЬ ВТ_СборочныеЗадания
	|ИЗ
	|	Документ.ИС_WB_СборочноеЗадание КАК ИС_WB_СборочноеЗадание
	|ГДЕ
	|	ИС_WB_СборочноеЗадание.Профиль = &Профиль
	|	И ИС_WB_СборочноеЗадание.Номер В(&СписокНомеров)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_СборочныеЗадания.Ссылка КАК Ссылка,
	|	ИС_WB_СтатусыИЭтикеткиСборочныхЗаданий.Поставка КАК Поставка
	|ИЗ
	|	ВТ_СборочныеЗадания КАК ВТ_СборочныеЗадания
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ИС_WB_СтатусыИЭтикеткиСборочныхЗаданий КАК ИС_WB_СтатусыИЭтикеткиСборочныхЗаданий
	|		ПО (ИС_WB_СтатусыИЭтикеткиСборочныхЗаданий.Профиль = &Профиль)
	|			И (ИС_WB_СтатусыИЭтикеткиСборочныхЗаданий.СборочноеЗадание = ВТ_СборочныеЗадания.Ссылка)
	|ГДЕ
	|	НЕ ИС_WB_СтатусыИЭтикеткиСборочныхЗаданий.Поставка = &Поставка";
	
	Запрос.УстановитьПараметр("СписокНомеров", МассивИдСборочныхЗаданий);
	Запрос.УстановитьПараметр("Профиль", Профиль);
	Запрос.УстановитьПараметр("Поставка", Поставка.Ссылка);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаСборочныхЗаданий = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаСборочныхЗаданий.Следующий() Цикл	
		ЗаписатьПоставкуСборочногоЗадания(Профиль, ВыборкаСборочныхЗаданий.Ссылка, Поставка.Ссылка); 			
	КонецЦикла;

	Возврат Поставка.Ссылка;
	
КонецФункции //- ИнфоСофт Ивонин К.А. 17.02.25 УА #92887

//+ ИнфоСофт Ивонин К.А. 18.02.25 УА #92887
Процедура ЗаписатьПоставкуСборочногоЗадания(Профиль, СборочноеЗадание, Поставка) Экспорт
   
    Событие = ИмяСобытия("ЗаписатьПоставкуСборочногоЗадания");
    
	МенеджерЗаписи = РегистрыСведений.ИС_WB_СтатусыИЭтикеткиСборочныхЗаданий.СоздатьМенеджерЗаписи();
	МенеджерЗаписи.Профиль = Профиль;
	МенеджерЗаписи.СборочноеЗадание = СборочноеЗадание;
	
	МенеджерЗаписи.Прочитать();
	
	МенеджерЗаписи.Профиль = Профиль;
	МенеджерЗаписи.СборочноеЗадание = СборочноеЗадание;
	МенеджерЗаписи.Поставка = Поставка;
	
	Попытка
		МенеджерЗаписи.Записать(Истина);	
	Исключение
		ТекстОшибки = ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
		ИС_МП_Сервер.ЗаписатьВЖРИСообщитьПользователю(Событие, ТекстОшибки);
	КонецПопытки;
	
