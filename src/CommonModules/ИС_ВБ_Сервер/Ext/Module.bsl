Функция ЗначениеПеречисленияСтатусаЗаказа(Статус)
    
    Событие = ИмяСобытия("ЗначениеПеречисленияСтатусаЗаказа");
    
    Результат = ИС_МП_Сервер.ЗначениеПеречисленияПоЗначению(Перечисления.ИС_WB_СтатусыСборочныхЗаданий, Статус);
    
    Если Результат.Пустая() Тогда
    	Текст = "Получен неизвестный статус заказа: " + Статус;
		ИС_МП_Сервер.ЗаписатьВЖРИСообщитьПользователю(Событие, Текст);
    КонецЕсли;	
	
	Возврат Результат;
		
КонецФункции //- ИнфоСофт Ивонин К.А. 04.04.25 УА #96894

//+ ИнфоСофт Ивонин К.А. 04.04.25 УА #96894
Функция ЗначениеПеречисленияСтатусВСистемеWildBerries(Статус)
    
    Событие = ИмяСобытия("ЗначениеПеречисленияСтатусВСистемеWildBerries");
    
    Результат = ИС_МП_Сервер.ЗначениеПеречисленияПоЗначению(
		Перечисления.ИС_WB_СтатусыСборочныхЗаданийВСистемеWildBerries, Статус);
    
    Если Результат.Пустая() Тогда
    	Текст = "Получен неизвестный статус WB сборочного задания: " + Статус;
		ИС_МП_Сервер.ЗаписатьВЖРИСообщитьПользователю(Событие, Текст);
    КонецЕсли;	
	
	Возврат Результат;
	
КонецФункции //- ИнфоСофт Ивонин К.А. 04.04.25 УА #96894

//+ ИнфоСофт Ивонин К.А. 04.04.25 УА #96894
Процедура ЗаписатьСтатусыИДатыЗаказа(Профиль, Заказ, Статус, СтатусWB, ДатаС = '00010101', ДатаПо = '00010101')
    
    Событие = ИмяСобытия("ЗаписатьСтатусыЗаказа");
    
	МенеджерЗаписи = РегистрыСведений.ИС_WB_СтатусыИЭтикеткиСборочныхЗаданий.СоздатьМенеджерЗаписи();
	МенеджерЗаписи.Профиль = Профиль;
	МенеджерЗаписи.СборочноеЗадание = Заказ;
	
	МенеджерЗаписи.Прочитать();
	
	Замещать = МенеджерЗаписи.Выбран();
	
	МенеджерЗаписи.Профиль = Профиль;
	МенеджерЗаписи.СборочноеЗадание = Заказ;
	МенеджерЗаписи.Статус = Статус;
	МенеджерЗаписи.СтатусWB = СтатусWB;
	МенеджерЗаписи.ДатаДоставкиС = ДатаС;
	МенеджерЗаписи.ДатаДоставкиПо = ДатаПо;
	
	Попытка
		МенеджерЗаписи.Записать(Замещать);	
	Исключение
		Текст = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
		ИС_МП_Сервер.ЗаписатьВЖРИСообщитьПользователю(Событие, Текст);
	КонецПопытки;

КонецПроцедуры //- ИнфоСофт Ивонин К.А. 04.04.25 УА #96894

//+ ИнфоСофт Ивонин К.А. 04.04.25 УА #96894
Процедура ПроверитьФункциональныеОпцииЗаказов(Профиль, МассивЗаданий)

	ОбновитьСтатусыЗаказов(Профиль, МассивЗаданий);
	
	ФукнциональныеОпции = ИС_WB_СерверПовтИсп.ПолучитьНастройкиФункциональностиСборочныхЗвданий(Профиль);
	
	Если ФукнциональныеОпции.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	Если ФукнциональныеОпции.АвтоматическиСоздаватьЗаказы Тогда	
		ИС_WB_Сервер.СоздатьЗаказы(Профиль, МассивЗаданий);		
	КонецЕсли;
	
	Если ФукнциональныеОпции.АвтоматическиСоздаватьРеализации 
			И ФукнциональныеОпции.РежимСозданияЗаказов <> 2 Тогда	
		ИС_WB_Сервер.СоздатьРеализации(Профиль, МассивЗаданий);		
	КонецЕсли;
	
КонецПроцедуры //- ИнфоСофт Ивонин К.А. 04.04.25 УА #96894

//+ ИнфоСофт Ивонин К.А. 07.04.25 УА #96894
Функция ПреобразоватьВДатуИзЧастей(Дата, Время)
	
	ЭлементыДаты = СтрРазделить(Дата, "-", Ложь);

	Если ЭлементыДаты.Количество() <> 3 Тогда
		Возврат Неопределено;	
	КонецЕсли;

	ЧастиВремени = СтрРазделить(Время, ":", Ложь);

	Если ЧастиВремени.Количество() <> 2 Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Возврат Дата(ЭлементыДаты[0], ЭлементыДаты[1], ЭлементыДаты[2], ЧастиВремени[0], ЧастиВремени[1], 0);
	
КонецФункции //- ИнфоСофт Ивонин К.А. 07.04.25 УА #96894

//+ ИнфоСофт Ивонин К.А. 27.03.25 УА #63915
Функция НайтиТоварПоШтрихкоду(Профиль, Штрихкод)

	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ЕСТЬNULL(ИС_WB_СоответствиеРазмеров.Номенклатура, ЗНАЧЕНИЕ(Справочник.Номенклатура.ПустаяСсылка)) КАК Номенклатура,
	|	ЕСТЬNULL(ИС_WB_СоответствиеРазмеров.Характеристика, ЗНАЧЕНИЕ(Справочник.ХарактеристикиНоменклатуры.ПустаяСсылка)) КАК Характеристика,
	|	ИС_WB_СоответствиеРазмеров.Упаковка КАК Упаковка,
	|	ИС_WB_СоответствиеРазмеров.Номенклатура//#ЭтоНабор КАК ЭтоНабор
	|ИЗ
	|	РегистрСведений.ИС_WB_ШтрихкодыРазмеров КАК ИС_WB_ШтрихкодыРазмеров
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ИС_WB_СоответствиеРазмеров КАК ИС_WB_СоответствиеРазмеров
	|		ПО (ИС_WB_СоответствиеРазмеров.Профиль = &Профиль)
	|			И ИС_WB_ШтрихкодыРазмеров.Размер = ИС_WB_СоответствиеРазмеров.РазмерWB
	|ГДЕ
	|	ИС_WB_ШтрихкодыРазмеров.Профиль = &Профиль
	|	И ИС_WB_ШтрихкодыРазмеров.Штрихкод = &Штрихкод";
	
	Запрос.УстановитьПараметр("Профиль", Профиль);
	Запрос.УстановитьПараметр("Штрихкод", Штрихкод);
	
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "//#ЭтоНабор", ИС_МП_СерверЛокализация.ПризнакНабораВЗапросе());
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Если РезультатЗапроса.Пустой() Тогда
		Возврат Неопределено;
	КонецЕсли;

	Возврат РезультатЗапроса.Выгрузить();

КонецФункции //- ИнфоСофт Ивонин К.А. 27.03.25 УА #63915

//+ ИнфоСофт Ивонин К.А. 31.03.25 УА #63915
Процедура СопоставитьТовары(Профиль, МассивТоваров, СопоставлятьПо)

	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ИС_WB_РазмерыНоменклатур.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.ИС_WB_РазмерыНоменклатур КАК ИС_WB_РазмерыНоменклатур
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ИС_WB_СоответствиеРазмеров КАК ИС_WB_СоответствиеРазмеров
	|		ПО (ИС_WB_СоответствиеРазмеров.Профиль = &Профиль)
	|			И ИС_WB_РазмерыНоменклатур.Ссылка = ИС_WB_СоответствиеРазмеров.РазмерWB
	|ГДЕ
	|	ИС_WB_РазмерыНоменклатур.Владелец В(&Владелец)
	|	И ИС_WB_СоответствиеРазмеров.Номенклатура ЕСТЬ NULL";
	
	Запрос.УстановитьПараметр("Владелец", МассивТоваров);
	Запрос.УстановитьПараметр("Профиль", Профиль);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Если РезультатЗапроса.Пустой() Тогда 
		Возврат;	
	КонецЕсли;
	
	ВыборкаРазмеров = РезультатЗапроса.Выбрать();
	
	МассивРазмеров = Новый Массив;
	
	Пока ВыборкаРазмеров.Следующий() Цикл
		МассивРазмеров.Добавить(ВыборкаРазмеров.Ссылка);
	КонецЦикла;
	
	Параметры = Новый Структура("СопоставлятьПо", СопоставлятьПо);
	
	РезультатПодбора = ПодобратьТовары(Профиль, МассивРазмеров, Параметры);
	
	Если РезультатПодбора = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если РезультатПодбора.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	Для Каждого Строка Из РезультатПодбора Цикл
		ДобавитьСопоставлениеТоваров(Профиль, Строка.ПолеСопоставления, Строка.Номенклатура,
			Строка.Характеристика, Строка.Упаковка);	
	КонецЦикла;
		
КонецПроцедуры //- ИнфоСофт Ивонин К.А. 31.03.25 УА #63915

