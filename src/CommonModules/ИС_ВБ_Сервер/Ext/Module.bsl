Функция ЗначениеПеречисленияТипаТовара(Значение) Экспорт
	
	Пустая = 0;
	МГТ = 1;
	СГТ = 2;
	КГТ = 3;
	
	Если Значение = Пустая Тогда
		Возврат Перечисления.ИС_ВБ_ТипыТоваров.ПустаяСсылка();
	КонецЕсли;
	
	Если Значение = МГТ Тогда
		Возврат Перечисления.ИС_ВБ_ТипыТоваров.МГТ;
	КонецЕсли;
	
	Если Значение = СГТ Тогда
		Возврат Перечисления.ИС_ВБ_ТипыТоваров.СГТ;
	КонецЕсли;
	
	Если Значение = КГТ Тогда
		Возврат Перечисления.ИС_ВБ_ТипыТоваров.КГТ;
	КонецЕсли;
	
	Возврат Перечисления.ИС_ВБ_ТипыТоваров.ПустаяСсылка();
	
