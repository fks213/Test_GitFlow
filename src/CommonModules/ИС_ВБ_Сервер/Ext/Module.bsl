//+ ИнфоСофт Ивонин К.А. 05.02.25 УА #92406
Функция ЗначениеПеречисленияТипаДоставки(Значение)
	
	FBS = 1;
	DBS = 2;
	DBW = 3;
	// Не факт что так	
	CnC = 5;
	EDBS = 6;
	
	Если Значение = FBS Тогда
		Возврат Перечисления.ИС_ВБ_ТипыДоставки.FBS;
	КонецЕсли;
	
	Если Значение = DBS Тогда
		Возврат Перечисления.ИС_ВБ_ТипыДоставки.DBS;
	КонецЕсли;
	
	Если Значение = DBW Тогда
		Возврат Перечисления.ИС_ВБ_ТипыДоставки.DBW;
	КонецЕсли;
	
	Если Значение = EDBS Тогда
		Возврат Перечисления.ИС_ВБ_ТипыДоставки.EDBS;
	КонецЕсли;
	
	Если Значение = CnC Тогда
		Возврат Перечисления.ИС_ВБ_ТипыДоставки.CnC;
	КонецЕсли;
	
	Возврат Перечисления.ИС_ВБ_ТипыДоставки.ПустаяСсылка();
	
КонецФункции //- ИнфоСофт Ивонин К.А. 05.02.25 УА #92406

//+ ИнфоСофт Ивонин К.А. 10.02.25 УА #92406
Процедура ЗаполнитьХарактеристикиКатегории(Поля, ТЧ, КешХарактеристикКатегорий, Перезаполнять)
		
	Для Каждого Элемент Из Поля Цикл
		
		Если Элемент.Свойство("name") Тогда
			ХарактеристикаКатегории = Справочники.ИС_WB_ХарактеристикиКатегорий.НайтиПоНаименованию(Элемент.name, Истина);
		Иначе
			Продолжить;
		КонецЕсли;
		
		НоваяХарактеристика = ТЧ.Добавить();
		
		Если ХарактеристикаКатегории.Пустая() Тогда		
			ХарактеристикаКатегории = Справочники.ИС_WB_ХарактеристикиКатегорий.СоздатьЭлемент();
			ХарактеристикаКатегории = ЗаполнитьСвойстваХарактеристики(ХарактеристикаКатегории, Элемент);						
		ИначеЕсли Перезаполнять Тогда
			
			Если КешХарактеристикКатегорий.Найти(ХарактеристикаКатегории) = Неопределено Тогда
				ХарактеристикаКатегории = ХарактеристикаКатегории.ПолучитьОбъект();
				ХарактеристикаКатегории = ЗаполнитьСвойстваХарактеристики(ХарактеристикаКатегории, Элемент);
				КешХарактеристикКатегорий.Добавить(НоваяХарактеристика);
			КонецЕсли;
				
		КонецЕсли;
		
		НоваяХарактеристика.Поле = ХарактеристикаКатегории;
		НоваяХарактеристика.Обязательное = ХарактеристикаКатегории.required;		
		
	КонецЦикла;
	
КонецПроцедуры //- ИнфоСофт Ивонин К.А. 10.02.25 УА #92406

//+ ИнфоСофт Ивонин К.А. 10.02.25 УА #92406
Функция ЗаполнитьСвойстваХарактеристики(Характеристика, ДанныеЗаполнения)
	
	Событие = ИмяСобытия("ЗаполнитьСвойстваХарактеристики");
		
	Характеристика.Наименование = ДанныеЗаполнения.name;
	ЗаполнитьЗначенияСвойств(Характеристика, ДанныеЗаполнения);
	
	Если ДанныеЗаполнения.name = "Цвет" Тогда
		Характеристика.dictionary = "colors";
	ИначеЕсли ДанныеЗаполнения.name = "Пол" Тогда
		Характеристика.dictionary = "kinds";	 
	ИначеЕсли ДанныеЗаполнения.name = "Страна производства" Тогда
		Характеристика.dictionary = "countries";	
	ИначеЕсли ДанныеЗаполнения.name = "Сезон" Тогда
		Характеристика.dictionary = "seasons";	
	ИначеЕсли ДанныеЗаполнения.name = "ТНВЭД" Тогда
		Характеристика.dictionary = "tnved";
	ИначеЕсли ДанныеЗаполнения.name = "Ставка НДС" Тогда
		Характеристика.dictionary = "vat";
	КонецЕсли;  
	
	Попытка		
		Характеристика.Записать();	
		Возврат Характеристика.Ссылка;		
	Исключение		
		Текст = ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
		ИС_МП_Сервер.ЗаписатьВЖРИСообщитьПользователю(Событие, Текст);				
	КонецПопытки;
	
	Возврат Справочники.ИС_WB_ХарактеристикиКатегорий.ПустаяСсылка();
	
КонецФункции //- ИнфоСофт Ивонин К.А. 10.02.25 УА #92406

//+ ИнфоСофт Ивонин К.А. 10.02.25 УА #92406
Процедура НайтиИлиСоздатьХарактеристику(Профиль, ДанныеРазмера, Владелец)
	
	Событие = ИмяСобытия("НайтиИлиСоздатьХарактеристику");
	
	Размер = Справочники.ИС_WB_РазмерыНоменклатур.НайтиПоКоду(ДанныеРазмера["chrtID"]);
	
	Если Размер.Пустая() Тогда
		Размер = Справочники.ИС_WB_РазмерыНоменклатур.СоздатьЭлемент();		
	Иначе
		Размер = Размер.ПолучитьОбъект();					
	КонецЕсли;
	
	Размер.ПометкаУдаления = Ложь;
	Размер.Профиль = Профиль;
	Размер.Код = ДанныеРазмера["chrtID"];	
	Размер.Наименование = ДанныеРазмера["techSize"];
	
	Размер.techSize = ДанныеРазмера["techSize"];
	Размер.wbSize   = ДанныеРазмера["wbSize"];
	
	Размер.Владелец = Владелец;
			
	Если ДанныеРазмера["skus"].Количество() > 0 Тогда   
		Размер.Наименование = ДанныеРазмера["skus"][0];
	КонецЕсли;
			
	Попытка
		
		Размер.Записать();
		
		Если ДанныеРазмера["skus"].Количество() > 0 Тогда
			
			НаборЗаписей = РегистрыСведений.ИС_WB_ШтрихкодыРазмеров.СоздатьНаборЗаписей(); 
			НаборЗаписей.Отбор.Профиль.Установить(Профиль);
			НаборЗаписей.Отбор.Размер.Установить(Размер.Ссылка);
			
			НаборЗаписей.Очистить(); 
			
			Для Каждого Элемент Из ДанныеРазмера["skus"] Цикл
				НоваяЗапись = НаборЗаписей.Добавить();
				НоваяЗапись.Профиль = Профиль;
				НоваяЗапись.Размер = Размер.Ссылка; 
				НоваяЗапись.Штрихкод = Элемент; 
			КонецЦикла;
			
			НаборЗаписей.Записать(Истина);
			
		КонецЕсли;
		
	Исключение		
		Текст = ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
		ИС_МП_Сервер.ЗаписатьВЖРИСообщитьПользователю(Событие, Текст);		
	КонецПопытки;
	
КонецПроцедуры //- ИнфоСофт Ивонин К.А. 10.02.25 УА #92406

