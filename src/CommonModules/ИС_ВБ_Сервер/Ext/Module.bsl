		РезультатДобавления = ИС_ВБ_АПИ.ДобавитьСборочноеЗаданиеКПоставке(Профиль, ПараметрыЗапроса, КодПоставки, Выборка.Номер);
	    
	    Если РезультатДобавления <> Неопределено Тогда
	    	ЗаписатьПоставкуСборочногоЗадания(Профиль, Выборка.Ссылка, Поставка);
	    КонецЕсли;
	    
	КонецЦикла;
		
