//+ ИнфоСофт Ивонин К.А. 17.02.25 УА #92887
Функция СписокПоставок(Профиль, Перезаполнять = Ложь) Экспорт 
	
	ПараметрыЗапроса = ПараметрыHTTPЗапроса(Профиль, "Маркетплейс");
	
	КоличествоЭлементовНаЗапрос = ПараметрыЗапроса.КоличествоЭлементовНаЗапрос;
	КоличествоПопытокЗапроса = ПараметрыЗапроса.КоличествоПопытокЗапроса;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	ИС_ВБ_ПоставкиFBS.next КАК next
	|ИЗ
	|	Справочник.ИС_ВБ_ПоставкиFBS КАК ИС_ВБ_ПоставкиFBS
	|ГДЕ
	|	ИС_ВБ_ПоставкиFBS.Профиль = &Профиль
	|	И НЕ ИС_ВБ_ПоставкиFBS.ПометкаУдаления
	|	И НЕ ИС_ВБ_ПоставкиFBS.done
	|
	|УПОРЯДОЧИТЬ ПО
	|	ИС_ВБ_ПоставкиFBS.createdAt";
	
	Запрос.УстановитьПараметр("Профиль", Профиль);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаПагинации = РезультатЗапроса.Выбрать();
	
	Если ВыборкаПагинации.Следующий() Тогда
		next = ВыборкаПагинации.next;	
	Иначе
		next = 0;	
	КонецЕсли;
	
	Если Перезаполнять Тогда
		next = 0;
	КонецЕсли;
	
	limit = КоличествоЭлементовНаЗапрос;
	
	КоличествоОшибок = 0;
	
	МассивПоставок = Новый Массив;
	
	_7Дней = 604800;
	ДатаОтбора = ТекущаяДатаСеанса() - _7Дней; 
	
	Пока Истина Цикл
	    
		Если КоличествоОшибок = КоличествоПопытокЗапроса Тогда
			ОбщегоНазначения.СообщитьПользователю("Превышено количество ошибок запросов к API");
			Возврат Неопределено;
		КонецЕсли;
			    
		СписокПоставок = ИС_ВБ_АПИ.СписокПоставок(Профиль, ПараметрыЗапроса, limit, next);
		
		Если СписокПоставок = Неопределено Тогда
			КоличествоОшибок = КоличествоОшибок + 1;
			Продолжить;
		КонецЕсли; 
		
		Для Каждого Элемент Из СписокПоставок.supplies Цикл
		
			Если ИС_МП_РаботаСHTTPЗапросами.ПрочитатьДатуИзJSON(Элемент.createdAt, ФорматДатыJSON.ISO) > ДатаОтбора Тогда
				Элемент.Вставить("next", next);
				МассивПоставок.Добавить(Элемент);	
			КонецЕсли;
		
		КонецЦикла;
		
		next = СписокПоставок.next;
		
		Если СписокПоставок.next = 0 Тогда
			Прервать;
		КонецЕсли; 
	
	КонецЦикла; 
	
	Для Каждого Элемент Из МассивПоставок Цикл
		НайтиИлиСоздатьПоставку(Профиль, Элемент.id, Элемент, Истина);		
	КонецЦикла;
	
	Возврат "Загрузка завершена";

КонецФункции //- ИнфоСофт Ивонин К.А. 17.02.25 УА #92887

//+ ИнфоСофт Ивонин К.А. 25.01.23 УА #53535
Процедура ДобавитьСборочныеЗаданияВПоставку(Профиль, Поставка, МассивЗаказов) Экспорт
	
	ПараметрыЗапроса = ПараметрыHTTPЗапроса(Профиль, "Маркетплейс");
		
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ИС_WB_СборочноеЗадание.Ссылка КАК Ссылка,
	|	ИС_WB_СборочноеЗадание.Номер КАК Номер
	|ИЗ
