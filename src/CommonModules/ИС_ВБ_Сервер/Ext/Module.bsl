//+ ИнфоСофт Ивонин К.А. 03.04.25 УА #96894
Процедура ВыполнитьЗагрузкуЗаказов(Профиль, ДатаНачала, ДатаОкончания = Неопределено) Экспорт
	
	Маркетплейс = Перечисления.ИС_МП_Маркетплейсы.ВБ;
	
	МассивНастроек = МассивНастроекСхемРаботы();
	
	СтруктураНастроек = ИС_МП_Сервер.ПолучитьЗначениеНастроек(Профиль, Маркетплейс, МассивНастроек);
	
	ОригДатаНачала = ДатаНачала;
	
	Если СтруктураНастроек.ЗаказыFBS <> Неопределено И СтруктураНастроек.ЗаказыFBS Тогда
		ИС_WB_Сервер.ПолучитьСписокСборочныхЗаданий(Профиль, ДатаНачала, ДатаОкончания);	
	КонецЕсли;
	
	ДатаНачала = ОригДатаНачала;
	
	Если СтруктураНастроек.ЗаказыDBS <> Неопределено И СтруктураНастроек.ЗаказыDBS Тогда
		ЗагрузитьЗаказыDBS(Профиль, ДатаНачала, ДатаОкончания);
	КонецЕсли;
	
	ДатаНачала = ОригДатаНачала;
	
	Если СтруктураНастроек.ЗаказыCnC <> Неопределено И СтруктураНастроек.ЗаказыCnC Тогда
		ЗагрузитьЗаказыCnC(Профиль, ДатаНачала, ДатаОкончания);	
	КонецЕсли;

	_30Минут = 1800;
	ДатаНачала = ОригДатаНачала - _30Минут;
	
	Если СтруктураНастроек.ЗаказыFBO <> Неопределено И СтруктураНастроек.ЗаказыFBO Тогда
		ЗагрузитьЗаказыFBO(Профиль, ДатаНачала);	
	КонецЕсли;

КонецПроцедуры //- ИнфоСофт Ивонин К.А. 03.04.25 УА #96894

