//+ ИнфоСофт Стояк Ю.К. 04.03.2025 УА #93469
Процедура ЗагрузитьЗаказыFBO(Профиль, ДатаНачала, ТолькоЗаПереданнуюДату = Ложь) Экспорт

	Событие = ИмяСобытия("ЗагрузитьЗаказыFBO");
	    
	ПараметрыЗапроса = ИС_ВБ_Сервер.ПараметрыHTTPЗапроса(Профиль, "Статистика");
	
	КоличествоЭлементовНаЗапрос = ПараметрыЗапроса.КоличествоЭлементовНаЗапрос;
	КоличествоПопытокЗапроса = ПараметрыЗапроса.КоличествоПопытокЗапроса;	
		
	СтруктураПараметров = Новый Структура; 		
	СтруктураПараметров.Вставить("dateFrom", ИС_МП_РаботаСHTTPЗапросами.ЗаписатьДатуВJSON(ДатаНачала, 
		ФорматДатыJSON.ISO, ВариантЗаписиДатыJSON.ЛокальнаяДата));	
	СтруктураПараметров.Вставить("flag", ?(ТолькоЗаПереданнуюДату, 1, 0));		
	
	Всего = 0;
	КоличествоОшибок = 0;
		
	МассивЗагруженныхЗаданий = Новый Массив;
	
	Пока Истина Цикл 
		
        Если КоличествоОшибок >= КоличествоПопытокЗапроса Тогда		
			Текст = "Превышено количество ошибок запросов к API";
			ИС_МП_Сервер.ЗаписатьВЖРИСообщитьПользователю(Событие, Текст);
			Возврат;
		КонецЕсли;
				
		РезультатЗапроса = ИС_ВБ_АПИ.ПолучитьОтчетПоЗаказам(Профиль, ПараметрыЗапроса, СтруктураПараметров);
		
		Если РезультатЗапроса = Неопределено Тогда
			КоличествоОшибок = КоличествоОшибок + 1;
			Продолжить;
		КонецЕсли;
	
		Если РезультатЗапроса.Количество() = 0 Тогда
			Прервать;
		КонецЕсли;				
	
		Всего = Всего + РезультатЗапроса.Количество();
		
		Для Каждого Заказ Из РезультатЗапроса Цикл	
			
			СтруктураПараметров.dateFrom = Заказ.lastChangeDate;
			
			Если Заказ.warehouseType <> "Склад WB" Тогда
				Продолжить;
			КонецЕсли;
			
			Если ИС_МП_РаботаСHTTPЗапросами.ПрочитатьДатуИзJSON(Заказ.date) < ДатаНачала Тогда
		    	Продолжить;
		    КонецЕсли;
		    
			СсылкаЗадания = СоздатьИлиОбновитьЗаказFBO(Профиль, Заказ);		
		
			Если СсылкаЗадания.Пустая() Тогда
				Продолжить;
			КонецЕсли;
			
			МассивЗагруженныхЗаданий.Добавить(СсылкаЗадания);
			
		КонецЦикла;
			
	КонецЦикла;
	
	Если МассивЗагруженныхЗаданий.Количество() > 0 Тогда
		ПроверитьФункциональныеОпцииЗаказов(Профиль, МассивЗагруженныхЗаданий);	
	КонецЕсли;
    
    Если Всего = 0 Тогда
		Текст = СтрШаблон("С %1 нет сборочных заданий для загрузки", ДатаНачала);
	Иначе
		Текст = СтрШаблон("Сборочные задания в количестве %1 успешно загружены", Всего);		
	КонецЕсли;	
	
	ОбщегоНазначения.СообщитьПользователю(Текст); 
			
КонецПроцедуры //- ИнфоСофт Стояк Ю.К. 04.03.2025 УА #93469

//+ ИнфоСофт Стояк Ю.К. 04.03.2025 УА #93469
Функция СоздатьИлиОбновитьЗаказFBO(Профиль, Данные)
	
	Событие = ИмяСобытия("СоздатьИлиОбновитьЗаказFBO");	
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	ИС_WB_СборочноеЗадание.Ссылка КАК Ссылка
	|ИЗ
	|	Документ.ИС_WB_СборочноеЗадание КАК ИС_WB_СборочноеЗадание
	|ГДЕ
	|	ИС_WB_СборочноеЗадание.Профиль = &Профиль
	|	И ИС_WB_СборочноеЗадание.Номер = &Номер
	|	И ИС_WB_СборочноеЗадание.ТипДоставки = ЗНАЧЕНИЕ(Перечисление.ИС_ВБ_ТипыДоставки.FBO)";
	
	Запрос.УстановитьПараметр("Номер", Число(Данные.gNumber));
	Запрос.УстановитьПараметр("Профиль", Профиль);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаЗаказ = РезультатЗапроса.Выбрать();
	
	Если ВыборкаЗаказ.Следующий() Тогда
		Заказ = ВыборкаЗаказ.Ссылка.ПолучитьОбъект();
	Иначе
		Заказ = Документы.ИС_WB_СборочноеЗадание.СоздатьДокумент();
		Заказ.ДатаЗагрузки = ТекущаяДатаСеанса();	
	КонецЕсли; 

	ЗаполнитьЗначенияСвойств(Заказ, Данные);
	
	Заказ.Профиль = Профиль;
	Заказ.Номер = Число(Данные.gNumber); 
	Заказ.Дата = ИС_МП_РаботаСHTTPЗапросами.ПрочитатьДатуИзJSON(Данные.date);
	Заказ.ТипДоставки = Перечисления.ИС_ВБ_ТипыДоставки.FBO;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	ИС_ВБ_Склады.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.ИС_ВБ_Склады КАК ИС_ВБ_Склады
	|ГДЕ
	|	ИС_ВБ_Склады.Профиль = &Профиль
	|	И ИС_ВБ_Склады.ТипДоставки = ЗНАЧЕНИЕ(Перечисление.ИС_ВБ_ТипыДоставки.FBO)";
	
	Запрос.УстановитьПараметр("Профиль", Профиль);
	
	РезультатЗапроса = Запрос.Выполнить();
	                             
	ВыборкаСкладВБ = РезультатЗапроса.Выбрать();
	
	Если ВыборкаСкладВБ.Следующий() Тогда
		Заказ.Склад = ВыборкаСкладВБ.Ссылка;
	КонецЕсли;                                 
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	ИС_WB_ШтрихкодыРазмеров.Размер КАК РазмерWB,
	|	ИС_WB_ШтрихкодыРазмеров.Размер.Владелец КАК НоменклатураWB,
	|	ИС_WB_ШтрихкодыРазмеров.Размер.Владелец.ТипТовара КАК ТипТовара
	|ИЗ
	|	РегистрСведений.ИС_WB_ШтрихкодыРазмеров КАК ИС_WB_ШтрихкодыРазмеров
	|ГДЕ
	|	ИС_WB_ШтрихкодыРазмеров.Профиль = &Профиль
	|	И ИС_WB_ШтрихкодыРазмеров.Штрихкод = &Штрихкод";
	
	Запрос.УстановитьПараметр("Профиль", Профиль);
	Запрос.УстановитьПараметр("Штрихкод", Данные.barcode);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаТовара = РезультатЗапроса.Выбрать();
	
	Если ВыборкаТовара.Следующий() Тогда
		ЗаполнитьЗначенияСвойств(Заказ, ВыборкаТовара);		
	КонецЕсли;
	
	Заказ.rid = Данные.srid; 
			
	ВалютаУчета = ИС_МП_СерверЛокализация.ВалютаУправленческогоУчета(); 
	
	Заказ.price = Данные.finishedPrice;
	Заказ.convertedPrice = Данные.finishedPrice;
			
	Заказ.Валюта = Справочники.Валюты.НайтиПоКоду("643");	
	Заказ.ВалютаПродажи = Заказ.Валюта;	
	
	Если ЗначениеЗаполнено(Заказ.Валюта) И ВалютаУчета <> Заказ.Валюта Тогда
		Заказ.ЦенаВВалютеУчета = РаботаСКурсамиВалют.ПересчитатьВВалюту(Заказ.price, Заказ.ВалютаПродажи, ВалютаУчета, Заказ.Дата);	
		Текст = "Валюта управленческого учета отличается от валюты продавца. Сборочное задание: " + Заказ.Номер;
		ИС_МП_Сервер.ЗаписатьВЖРИСообщитьПользователю(Событие, Текст);	
	Иначе
		Заказ.ЦенаВВалютеУчета = Данные.finishedPrice;	
	КонецЕсли;	
	
	Заказ.skus.Очистить();		
	
	НоваяСтрока = Заказ.skus.Добавить();
	НоваяСтрока.Штрихкод = Данные.barcode;	
	
	Результат = Документы.ИС_WB_СборочноеЗадание.ПустаяСсылка(); 
	
	Попытка	
		Заказ.Записать(РежимЗаписиДокумента.Запись);								
		Результат = Заказ.Ссылка;	
	Исключение
		ТекстОшибки = ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
		ИС_МП_Сервер.ЗаписатьВЖРИСообщитьПользователю(Событие, ТекстОшибки);
	КонецПопытки;                                                       
	
	Статус = Перечисления.ИС_WB_СтатусыСборочныхЗаданий.receive;
	Если Данные.isCancel Тогда
		Статус = Перечисления.ИС_WB_СтатусыСборочныхЗаданий.cancel;
	КонецЕсли;
	
	ЗаписатьСтатусыИДатыЗаказа(Профиль, Заказ.Ссылка, Статус,
		Перечисления.ИС_WB_СтатусыСборочныхЗаданийВСистемеWildBerries.ПустаяСсылка());
	
	Возврат Результат;

КонецФункции //- ИнфоСофт Стояк Ю.К. 04.03.2025 УА #93469

//+ ИнфоСофт Стояк Ю.К. 04.03.2025 УА #93469
Процедура ОбновитьСтатусыЗаказовFBO(Профиль, МассивЗаказов = Неопределено, 
		_15Дней = 1296000, ТолькоЗаПереданнуюДату = Ложь) Экспорт

	Событие = ИмяСобытия("ОбновитьСтатусыЗаказовFBO");       
	    
	ПараметрыЗапроса = ИС_ВБ_Сервер.ПараметрыHTTPЗапроса(Профиль, "Статистика");
	
	КоличествоЭлементовНаЗапрос = ПараметрыЗапроса.КоличествоЭлементовНаЗапрос;
	КоличествоПопытокЗапроса = ПараметрыЗапроса.КоличествоПопытокЗапроса;
	
	ДатаНачала = ТекущаяДатаСеанса() - _15Дней;
	
	Если ЗначениеЗаполнено(МассивЗаказов) Тогда
	
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	ИС_WB_СборочноеЗадание.Дата КАК Дата
		|ИЗ
		|	Документ.ИС_WB_СборочноеЗадание КАК ИС_WB_СборочноеЗадание
		|ГДЕ
		|	ИС_WB_СборочноеЗадание.ТипДоставки = ЗНАЧЕНИЕ(Перечисление.ИС_ВБ_ТипыДоставки.FBO)
		|	И ИС_WB_СборочноеЗадание.Ссылка В(&МассивСсылок)
		|
		|УПОРЯДОЧИТЬ ПО
		|	Дата УБЫВ";
		
		Запрос.УстановитьПараметр("МассивСсылок", МассивЗаказов);
		
		РезультатЗапроса = Запрос.Выполнить();
		
		ВыборкаДат = РезультатЗапроса.Выбрать();
		
		Если ВыборкаДат.Следующий() Тогда
			ДатаНачала = ВыборкаДат.Дата;
		КонецЕсли;
		
	КонецЕсли;
	
	СтруктураПараметров = Новый Структура;	
	СтруктураПараметров.Вставить("dateFrom", ИС_МП_РаботаСHTTPЗапросами.ЗаписатьДатуВJSON(ДатаНачала, 
		ФорматДатыJSON.ISO, ВариантЗаписиДатыJSON.ЛокальнаяДата));	
	СтруктураПараметров.Вставить("flag", ?(ТолькоЗаПереданнуюДату, 1, 0));		
	
	МассивНомеровЗаказов = Новый Массив;
	
	КоличествоОшибок = 0;
		
	Пока Истина Цикл 
		
        Если КоличествоОшибок = КоличествоПопытокЗапроса Тогда		
			Текст = "Превышено количество ошибок запросов к API";
			ИС_MP_Сервер.ЗаписатьВЖРИСообщитьПользователю(Событие, Текст);
			Возврат;
		КонецЕсли;
				
		РезультатЗапроса = ИС_ВБ_АПИ.ПолучитьОтчетПоЗаказам(Профиль, ПараметрыЗапроса, СтруктураПараметров);
		
		Если РезультатЗапроса = Неопределено Тогда
			КоличествоОшибок = КоличествоОшибок + 1;
			Продолжить;
		КонецЕсли;
	
		Если РезультатЗапроса.Количество() = 0 Тогда
			Прервать;
		КонецЕсли;				
		
		Для Каждого Элемент Из РезультатЗапроса Цикл	
			
			СтруктураПараметров.dateFrom = Элемент.lastChangeDate;
			
			Если Элемент.warehouseType <> "Склад WB" Тогда
				Продолжить;
			КонецЕсли;  

			Если ИС_МП_РаботаСHTTPЗапросами.ПрочитатьДатуИзJSON(Элемент.lastChangeDate) < ДатаНачала Тогда
		    	Продолжить;
		    КонецЕсли;
						
			Заказ = Документы.ИС_WB_СборочноеЗадание.НайтиПоНомеру(Число(Элемент.gNumber));	
				
			Если Заказ.Пустая() Тогда 
				Продолжить;
			КонецЕсли;
			
			Если Элемент.isCancel Тогда
				МассивНомеровЗаказов.Добавить(Число(Элемент.gNumber));
			КонецЕсли;
			
		КонецЦикла;
			
	КонецЦикла;
	
	Если МассивНомеровЗаказов.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
		
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ИС_WB_СборочноеЗадание.Ссылка КАК Ссылка,
	|	ИС_WB_СтатусыИЭтикеткиСборочныхЗаданий.Статус КАК Статус
	|ИЗ
	|	Документ.ИС_WB_СборочноеЗадание КАК ИС_WB_СборочноеЗадание
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ИС_WB_СтатусыИЭтикеткиСборочныхЗаданий КАК ИС_WB_СтатусыИЭтикеткиСборочныхЗаданий
	|		ПО (ИС_WB_СтатусыИЭтикеткиСборочныхЗаданий.Профиль = &Профиль
	|				И ИС_WB_СборочноеЗадание.Ссылка = ИС_WB_СтатусыИЭтикеткиСборочныхЗаданий.СборочноеЗадание)
	|ГДЕ
	|	ИС_WB_СборочноеЗадание.Номер В(&МассивНомеров)
	|	И ИС_WB_СтатусыИЭтикеткиСборочныхЗаданий.Статус = ЗНАЧЕНИЕ(Перечисление.ИС_WB_СтатусыСборочныхЗаданий.receive)
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ИС_WB_СборочноеЗадание.Ссылка,
	|	ИС_WB_СтатусыИЭтикеткиСборочныхЗаданий.Статус
	|ИЗ
	|	Документ.ИС_WB_СборочноеЗадание КАК ИС_WB_СборочноеЗадание
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ИС_WB_СтатусыИЭтикеткиСборочныхЗаданий КАК ИС_WB_СтатусыИЭтикеткиСборочныхЗаданий
	|		ПО (ИС_WB_СтатусыИЭтикеткиСборочныхЗаданий.Профиль = &Профиль
	|				И ИС_WB_СборочноеЗадание.Ссылка = ИС_WB_СтатусыИЭтикеткиСборочныхЗаданий.СборочноеЗадание)
	|ГДЕ
	|	ИС_WB_СборочноеЗадание.Номер В(&МассивНомеров)
	|	И ИС_WB_СтатусыИЭтикеткиСборочныхЗаданий.Статус ЕСТЬ NULL";
	
	Запрос.УстановитьПараметр("МассивНомеров", МассивНомеровЗаказов);
	Запрос.УстановитьПараметр("Профиль", Профиль);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаЗаказов = РезультатЗапроса.Выбрать();
	
	Статус = Перечисления.ИС_WB_СтатусыСборочныхЗаданий.cancel;
	
	Пока ВыборкаЗаказов.Следующий() Цикл
		ЗаписатьСтатусыИДатыЗаказа(Профиль, ВыборкаЗаказов.Ссылка, Статус,
			Перечисления.ИС_WB_СтатусыСборочныхЗаданийВСистемеWildBerries.ПустаяСсылка());
	КонецЦикла;
			
КонецПроцедуры //- ИнфоСофт Стояк Ю.К. 04.03.2025 УА #93469

