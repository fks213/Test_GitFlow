	|ГДЕ
	|	ИС_WB_СборочноеЗадание.Ссылка В(&Массив)";
	
	Запрос.УстановитьПараметр("Массив", МассивЗаказов);
	
	РезультатЗапроса = Запрос.Выполнить();
	
