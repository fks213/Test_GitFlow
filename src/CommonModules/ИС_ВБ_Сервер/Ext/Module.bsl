#Область ЗаказыDBS

//+ ИнфоСофт Ивонин К.А. 03.04.25 УА #96894
Процедура ЗагрузитьЗаказыDBS(Профиль, ДатаНачала, ДатаОкончания = Неопределено) Экспорт

	Событие = ИмяСобытия("ЗагрузитьЗаказыDBS");
    	
	ПараметрыЗапроса = ПараметрыHTTPЗапроса(Профиль, "Маркетплейс");
	
	КоличествоЭлементовНаЗапрос = ПараметрыЗапроса.КоличествоЭлементовНаЗапрос;
	КоличествоПопытокЗапроса = ПараметрыЗапроса.КоличествоПопытокЗапроса;
		
	СтруктураПараметров = ИС_ВБ_АПИ.СтруктураПараметровЗапросаСборочныхЗаданий();
	
	СтруктураПараметров.limit = КоличествоЭлементовНаЗапрос;
	
	_30Суток  = 2592000;
	
	Если ДатаОкончания = Неопределено Тогда
		ДатаОкончания = ТекущаяДатаСеанса();
	КонецЕсли;
	
	Всего = 0;
	КоличествоОшибок = 0;
		
	МассивЗагруженныхЗаказов = Новый Массив;
	
	МассивТиповДоставки = Новый Массив;
	МассивТиповДоставки.Добавить(Перечисления.ИС_ВБ_ТипыДоставки.DBS);
	МассивТиповДоставки.Добавить(Перечисления.ИС_ВБ_ТипыДоставки.EDBS);
	МассивТиповДоставки.Добавить(Перечисления.ИС_ВБ_ТипыДоставки.DBW);
	
	ТекРазница = ДатаОкончания - ДатаНачала;
	
	Пока ТекРазница >= 0 Цикл
		
		КоэффПрироста = ?(ТекРазница > _30Суток, _30Суток, ТекРазница);
		
		СтруктураПараметров.dateFrom = ДатаНачала;
		СтруктураПараметров.dateTo = ДатаНачала + КоэффПрироста;
		
		Пока Истина Цикл 
			
	        Если КоличествоОшибок >= КоличествоПопытокЗапроса Тогда
				Текст = "Превышено количество ошибок запросов к API";
				ИС_МП_Сервер.ЗаписатьВЖРИСообщитьПользователю(Событие, Текст);
				Возврат;
			КонецЕсли;
					
			РезультатЗапроса = ИС_ВБ_АПИ.СписокЗавершенныхЗаказовDBS(Профиль, ПараметрыЗапроса, СтруктураПараметров);
			
			Если РезультатЗапроса = Неопределено Тогда
				КоличествоОшибок = КоличествоОшибок + 1;
				Продолжить;
			КонецЕсли;
		
			Если Не РезультатЗапроса.Свойство("next") Тогда
				Прервать;
			КонецЕсли;
			
			Если РезультатЗапроса.orders.Количество() = 0 Тогда
				Прервать;
			КонецЕсли;
			
			СтруктураПараметров.next = РезультатЗапроса.next;
		
			Всего = Всего + РезультатЗапроса.orders.Количество();
			
			Для Каждого СборочноеЗадание Из РезультатЗапроса.orders Цикл	
				
				ДатаЗаказа = ИС_МП_РаботаСHTTPЗапросами.ПрочитатьДатуИзJSON(СборочноеЗадание.createdAt);
				
			    Если ДатаЗаказа < ДатаНачала Тогда
			    	Продолжить;
				КонецЕсли;
			    
				СсылкаЗадания = СоздатьИлиОбновитьСборочноеЗадание(Профиль, СборочноеЗадание, МассивТиповДоставки);		
			
				Если Не СсылкаЗадания.Пустая() Тогда
					МассивЗагруженныхЗаказов.Добавить(СсылкаЗадания);
				КонецЕсли;
			
			КонецЦикла;
				
		КонецЦикла;
		
		ДатаНачала = ДатаНачала + КоэффПрироста;
		
		ТекРазница = ТекРазница - _30Суток;
		
	КонецЦикла;
		
	РезультатЗапроса = ИС_ВБ_АПИ.СписокНовыхЗаказовDBS(Профиль, ПараметрыЗапроса);
		
	Если РезультатЗапроса <> Неопределено И РезультатЗапроса.orders.Количество() > 0 Тогда
		
		Всего = Всего + РезультатЗапроса.orders.Количество();
	
		Для Каждого СборочноеЗадание Из РезультатЗапроса.orders Цикл	
		    
		    Если ИС_МП_РаботаСHTTPЗапросами.ПрочитатьДатуИзJSON(СборочноеЗадание.createdAt) < ДатаНачала Тогда
		    	Продолжить;
		    КонецЕсли;
		    
			СсылкаЗадания = СоздатьИлиОбновитьСборочноеЗадание(Профиль, СборочноеЗадание, МассивТиповДоставки);		
		
			Если Не СсылкаЗадания.Пустая() Тогда
				МассивЗагруженныхЗаказов.Добавить(СсылкаЗадания);
			КонецЕсли;
		
		КонецЦикла;
	
	КонецЕсли;
			
	Если МассивЗагруженныхЗаказов.Количество() > 0 Тогда
		ПроверитьФункциональныеОпцииЗаказов(Профиль, МассивЗагруженныхЗаказов);	
	КонецЕсли;
    
    Если Всего = 0 Тогда
		Текст = СтрШаблон("С %1 нет сборочных заданий для загрузки", ДатаНачала);
	Иначе
		Текст = СтрШаблон("Сборочные задания в количестве %1 успешно загружены", Всего);
	КонецЕсли;	
	
	Если ДатаОкончания = Неопределено Тогда
		ОбщегоНазначения.СообщитьПользователю(Текст); 
	КонецЕсли;
			
КонецПроцедуры //- ИнфоСофт Ивонин К.А. 03.04.25 УА #96894

//+ ИнфоСофт Ивонин К.А. 04.04.25 УА #96894
Процедура ОбновитьСтатусыЗаказовDBS(Профиль, МассивЗаказов = Неопределено)

	Событие = ИмяСобытия("ОбновитьСтатусыЗаказовDBS");
	
	СтатусыЗаказов = Новый Массив;
	
	СтатусыЗаказов.Добавить(Перечисления.ИС_WB_СтатусыСборочныхЗаданийВСистемеWildBerries.ПустаяСсылка());
	СтатусыЗаказов.Добавить(Перечисления.ИС_WB_СтатусыСборочныхЗаданийВСистемеWildBerries.waiting);
	СтатусыЗаказов.Добавить(Перечисления.ИС_WB_СтатусыСборочныхЗаданийВСистемеWildBerries.sorted);
	СтатусыЗаказов.Добавить(Перечисления.ИС_WB_СтатусыСборочныхЗаданийВСистемеWildBerries.ready_for_pickup);
	
	ТипыДоставки = Новый Массив;
	
	ТипыДоставки.Добавить(Перечисления.ИС_ВБ_ТипыДоставки.DBS);
	ТипыДоставки.Добавить(Перечисления.ИС_ВБ_ТипыДоставки.EDBS);
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ИС_WB_СборочноеЗадание.Ссылка КАК Ссылка,
	|	ИС_WB_СборочноеЗадание.Номер КАК Номер,
	|	ИС_WB_СтатусыИЭтикеткиСборочныхЗаданий.Статус КАК Статус,
	|	ИС_WB_СтатусыИЭтикеткиСборочныхЗаданий.СтатусWB КАК СтатусWB,
	|	ИС_WB_СтатусыИЭтикеткиСборочныхЗаданий.ДатаДоставкиС КАК ДатаДоставкиС,
	|	ИС_WB_СтатусыИЭтикеткиСборочныхЗаданий.ДатаДоставкиПо КАК ДатаДоставкиПо,
	|	ИС_WB_СборочноеЗадание.phone КАК phone
	|ИЗ
	|	Документ.ИС_WB_СборочноеЗадание КАК ИС_WB_СборочноеЗадание
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ИС_WB_СтатусыИЭтикеткиСборочныхЗаданий КАК ИС_WB_СтатусыИЭтикеткиСборочныхЗаданий
	|		ПО (ИС_WB_СтатусыИЭтикеткиСборочныхЗаданий.Профиль = &Профиль)
	|			И ИС_WB_СборочноеЗадание.Ссылка = ИС_WB_СтатусыИЭтикеткиСборочныхЗаданий.СборочноеЗадание
	|			И (ИС_WB_СтатусыИЭтикеткиСборочныхЗаданий.СтатусWB В (&МассивСтатусов))
	|ГДЕ
	|	ИС_WB_СборочноеЗадание.Профиль = &Профиль
	|	И ИС_WB_СборочноеЗадание.ТипДоставки В(&ТипДоставки)
	|	И &Условие";
	
	Запрос.УстановитьПараметр("Профиль", Профиль);
	Запрос.УстановитьПараметр("МассивСтатусов", СтатусыЗаказов);
	Запрос.УстановитьПараметр("ТипДоставки", ТипыДоставки);
		
	Если МассивЗаказов = Неопределено Тогда
		_7Суток = 604800;                          
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&Условие", "ИС_WB_СборочноеЗадание.Дата >= &Дата");
		Запрос.УстановитьПараметр("Дата", ТекущаяДатаСеанса() - _7Суток);
	Иначе
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&Условие", "ИС_WB_СборочноеЗадание.Ссылка В (&МассивСсылок)");
		Запрос.УстановитьПараметр("МассивСсылок", МассивЗаказов);
	КонецЕсли;
    	
	РезультатЗапроса = Запрос.Выполнить();
	
	Если РезультатЗапроса.Пустой() Тогда
		Возврат;
	КонецЕсли;
	
	ТаблицаЗаказов = РезультатЗапроса.Выгрузить();
	
	МассивДляЗапроса = ТаблицаЗаказов.ВыгрузитьКолонку("Номер");
	
	СоответствиеЗаказов = Новый Соответствие;
	
	ТаблицаЗаказов.Колонки.Добавить("ТребуетсяОбновление", Новый ОписаниеТипов("Булево"));
	
	РазбитыйМассив = ИС_МП_Сервер.РазбитьМассивПоNЭлементов(МассивДляЗапроса, 1000);
	
	Для Каждого ЭлементМассив Из РазбитыйМассив Цикл 
		
		ИнформацияОСтатусах = ПолучитьСтатусыЗаказовDBS(Профиль, ЭлементМассив);
		
		Если ИнформацияОСтатусах <> Неопределено Тогда
			
			Для Каждого Элемент Из ИнформацияОСтатусах Цикл
				
				НайденныеСтроки = ТаблицаЗаказов.НайтиСтроки(Новый Структура("Номер", Элемент.id));
				 
				Если НайденныеСтроки.Количество() = 0 Тогда
					Продолжить;
				КонецЕсли;
				
				Статус = ЗначениеПеречисленияСтатусаЗаказа(Элемент.supplierStatus);
				СтатусWB = ЗначениеПеречисленияСтатусВСистемеWildBerries(Элемент.wbStatus);
				
				Если Не ЗначениеЗаполнено(НайденныеСтроки[0].phone) 
						И Статус = Перечисления.ИС_WB_СтатусыСборочныхЗаданий.confirm Тогда
					СоответствиеЗаказов.Вставить(НайденныеСтроки[0].Номер, НайденныеСтроки[0].Ссылка);	
				КонецЕсли;
				
				Если НайденныеСтроки[0].Статус = Статус И НайденныеСтроки[0].СтатусWB = СтатусWB Тогда
					Продолжить;
				КонецЕсли;
				
				НайденныеСтроки[0].ТребуетсяОбновление = Истина;
				НайденныеСтроки[0].Статус = Статус;
				НайденныеСтроки[0].СтатусWB = СтатусWB;
				
			КонецЦикла;
			
		КонецЕсли;
		
		ИнформацияОДатах = ПолучитьДатуИВремяДоставкиDBS(Профиль, ЭлементМассив);
		
		Если ИнформацияОДатах = Неопределено Тогда
			Продолжить;	
		КонецЕсли;
			
		Для Каждого Элемент Из ИнформацияОДатах Цикл
			
			НайденныеСтроки = ТаблицаЗаказов.НайтиСтроки(Новый Структура("Номер", Элемент.id));
			 
			Если НайденныеСтроки.Количество() = 0 Тогда
				Продолжить;
			КонецЕсли;
			
			Если Элемент.dTimeFrom = Неопределено Тогда
				Элемент.dTimeFrom = "00:00";
			КонецЕсли;
			
			Если Элемент.dTimeTo = Неопределено Тогда
				Элемент.dTimeTo = "00:00";
			КонецЕсли;
			
			ДатаС = ПреобразоватьВДатуИзЧастей(Элемент.dDate, Элемент.dTimeFrom);
			ДатаПо = ПреобразоватьВДатуИзЧастей(Элемент.dDate, Элемент.dTimeTo);
			
			Если НайденныеСтроки[0].ДатаДоставкиС = ДатаС И НайденныеСтроки[0].ДатаДоставкиПо = ДатаПо Тогда
				Продолжить;
			КонецЕсли;
			
			НайденныеСтроки[0].ТребуетсяОбновление = Истина;
			НайденныеСтроки[0].ДатаДоставкиС = ДатаС;
			НайденныеСтроки[0].ДатаДоставкиПо = ДатаПо;
			
		КонецЦикла;

	КонецЦикла;
	
	Для Каждого Строка Из ТаблицаЗаказов Цикл
		
		Если Строка.ТребуетсяОбновление Тогда
			ЗаписатьСтатусыИДатыЗаказа(Профиль, Строка.Ссылка, Строка.Статус, 
				Строка.СтатусWB, Строка.ДатаДоставкиС, Строка.ДатаДоставкиПо); 	
		КонецЕсли;
		
	КонецЦикла;
	
	Если СоответствиеЗаказов.Количество() > 0 Тогда
		ЗаполнитьИнформациюОПокупателеDBS(Профиль, СоответствиеЗаказов);		
	КонецЕсли;

