#Область Подключение

//+ ИнфоСофт Ивонин К.А. 31.01.25 УА #89159
Функция ДанныеТокена(Токен) Экспорт
	
	ЧастиJWT = СтрРазделить(Токен, ".", Ложь);
	
	Если ЧастиJWT.Количество() <> 3 Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Тело = ЧастиJWT[1];
	
	Пока СтрДлина(Тело) % 4 > 0 Цикл
		Тело = Тело + "=";
	КонецЦикла;
	
	ДвоичныеДанныеТокена = Base64Значение(Тело);
	JSON = ПолучитьСтрокуИзДвоичныхДанных(ДвоичныеДанныеТокена);
		
	ДанныеТокена = ИС_МП_РаботаСHTTPЗапросами.ПолучитьОбъектJSON(JSON);
	
	Если Не ДанныеТокена.Свойство("s") Тогда 
		Возврат Неопределено;	
	КонецЕсли;
	
	Если Не ДанныеТокена.Свойство("t") Тогда 
		Возврат Неопределено;	
	КонецЕсли;
	
	Если Не ДанныеТокена.Свойство("exp") Тогда 
		Возврат Неопределено;	
	КонецЕсли;
	
	Маска = ДанныеТокена.s;
	
	Результат = Новый Структура;
	
	Результат.Вставить("Контент",      ПроверитьБит(Маска, 1));
	Результат.Вставить("Аналитика",    ПроверитьБит(Маска, 2));
	Результат.Вставить("Цены", 		   ПроверитьБит(Маска, 3));
	Результат.Вставить("Маркетплейс",  ПроверитьБит(Маска, 4));
	Результат.Вставить("Статистика",   ПроверитьБит(Маска, 5));
	Результат.Вставить("Продвижение",  ПроверитьБит(Маска, 6));
	Результат.Вставить("Вопросы", 	   ПроверитьБит(Маска, 7));
	Результат.Вставить("Чат", 		   ПроверитьБит(Маска, 9));
	Результат.Вставить("Поставки",     ПроверитьБит(Маска, 10));
	Результат.Вставить("Возвраты",     ПроверитьБит(Маска, 11));
	Результат.Вставить("Документы",    ПроверитьБит(Маска, 12));
	Результат.Вставить("Тарифы", 	   Не ДанныеТокена.t);
	Результат.Вставить("ТолькоЧтение", ПроверитьБит(Маска, 30));
	Результат.Вставить("ТестовыйКонтур", ДанныеТокена.t);
	Результат.Вставить("ДатаОкончания", ИС_МП_Сервер.ДатаИзUnixTimeStamp(ДанныеТокена.exp));
	
	Возврат Результат;

КонецФункции //- ИнфоСофт Ивонин К.А. 31.01.25 УА #89159

//+ ИнфоСофт Ивонин К.А. 22.10.24 УА #68001
Функция ТестПодключения(Профиль, Параметры) Экспорт

	ПараметрыЗапроса = ИС_МП_РаботаСHTTPЗапросами.СтруктураHTTPЗапроса();
		
	Результат = "";
	
	МассивСервисов = Новый Массив;
	МассивСервисов.Добавить("Контент");
	МассивСервисов.Добавить("Аналитика");
	МассивСервисов.Добавить("Цены");
	МассивСервисов.Добавить("Маркетплейс");
	МассивСервисов.Добавить("Статистика");
	МассивСервисов.Добавить("Продвижение");
	МассивСервисов.Добавить("Вопросы");
	МассивСервисов.Добавить("Чат");
	МассивСервисов.Добавить("Поставки");
	МассивСервисов.Добавить("Возвраты");
	МассивСервисов.Добавить("Документы");
	МассивСервисов.Добавить("Тарифы");
	
	Для Каждого Сервис Из МассивСервисов Цикл
	
		Если ЗначениеЗаполнено(Параметры["Адрес" + Сервис]) Тогда
		
			ПараметрыЗапроса.Сервер = Параметры["Адрес" + Сервис];
			ПараметрыЗапроса.Порт = Параметры["Порт" + Сервис];
			ПараметрыЗапроса.ЗащищенноеСоединение = Параметры["HTTPS" + Сервис];
			ПараметрыЗапроса.РежимОтладки = Параметры.РежимОтладки;
			ПараметрыЗапроса.КоличествоЭлементовНаЗапрос = Параметры.КоличествоЭлементовНаЗапрос;
			ПараметрыЗапроса.КоличествоПопытокЗапроса = Параметры.КоличествоПопытокЗапроса; 
						
			Токен = ИС_ВБ_СерверПовтИсп.ТокенДляСервиса(Профиль, Сервис);
			
			Если Токен = Неопределено Тогда
				Результат = Результат + "Не найден токен для теста подключения API " + Сервис + Символы.ПС;	
			Иначе	
				
				ПараметрыЗапроса.Заголовки.Вставить("Authorization", Токен);
				
				РезультатЗапроса = ИС_ВБ_АПИ.ТестПодключения(Профиль, ПараметрыЗапроса);
				
				Если РезультатЗапроса Тогда
					Результат = Результат + "Тест подключения API " + Сервис + " выполнен успешно " + Символы.ПС;
				Иначе
					Результат = Результат + "Тест подключения API " + Сервис + " завершен с ошибкой" + Символы.ПС;
				КонецЕсли;
			
			КонецЕсли;
			
		КонецЕсли;
	
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции //- ИнфоСофт Ивонин К.А. 22.10.24 УА #68001

// + ИнфоСофт Ивонин К.А. 20.01.25 УА #89159
//
// Параметры:
//  Профиль	 - СправочникСсылка.ИС_WB_Профили - Профиль маркетплейса 
//  Сервис	 - Строка - Поддерживает следующие типы сервисов:
//							* Контент
//							* Аналитика
//							* Цены
//							* Маркетплейс
//							* Статистика
//							* Продвижение
//							* Вопросы
//							* Чат
//							* Поставки
//							* Возвраты
//							* Документы
//							* Тарифы
// 
// Возвращаемое значение:
//  Структура - Сформированная структура для отправки запроса на маркетплейс
//
Функция ПараметрыHTTPЗапроса(Профиль, Сервис) Экспорт
	
	МассивСервисов = Новый Массив;   
	
	МассивСервисов.Добавить("Аналитика");
	МассивСервисов.Добавить("Цены");
	МассивСервисов.Добавить("Маркетплейс");
	МассивСервисов.Добавить("Статистика");
	МассивСервисов.Добавить("Продвижение");
	МассивСервисов.Добавить("Вопросы");
	МассивСервисов.Добавить("Чат");
	МассивСервисов.Добавить("Поставки");
	МассивСервисов.Добавить("Возвраты");
	МассивСервисов.Добавить("Документы");
	МассивСервисов.Добавить("Тарифы");
	МассивСервисов.Добавить("Контент");
	
	ИскомыйСервис = МассивСервисов.Найти(Сервис);
	
	Если ИскомыйСервис = Неопределено Тогда
		ВызватьИсключение "Вызван неизвестный сервис WildBerries: " + Сервис;
	КонецЕсли;
	
	Токен = ИС_ВБ_СерверПовтИсп.ТокенДляСервиса(Профиль, Сервис);
	
	Если Токен = Неопределено Тогда
		ВызватьИсключение "Не найден токен WildBerries для подключения к API " + Сервис;	
	КонецЕсли;
		
	НастройкиСоединения = ИС_ВБ_СерверПовтИсп.НастройкиСоединения(Профиль);  
	
	ТекстОшибки = "";
	
	Если Не ЗначениеЗаполнено(НастройкиСоединения["Адрес" + Сервис]) Тогда
		ТекстОшибки = ТекстОшибки 
			+ "Для данного профиля не заполнен адрес API " + Сервис + " , проверьте настройки подключения";
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(НастройкиСоединения["Порт" + Сервис]) Тогда
		ТекстОшибки = ТекстОшибки 
			+ "Для данного профиля не заполнен порт API " + Сервис + " , проверьте настройки подключения";
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(НастройкиСоединения["HTTPS" + Сервис]) Тогда
		ТекстОшибки = ТекстОшибки
			+ "Для данного профиля не заполнен HTTPS API " + Сервис + " , проверьте настройки подключения";
	КонецЕсли; 
	
	Если ЗначениеЗаполнено(ТекстОшибки) Тогда
		ВызватьИсключение ТекстОшибки;
	КонецЕсли;
	
	Если НастройкиСоединения.РежимОтладки = Неопределено Тогда
		НастройкиСоединения.РежимОтладки = Ложь;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(НастройкиСоединения.КоличествоЭлементовНаЗапрос) Тогда
		НастройкиСоединения.КоличествоЭлементовНаЗапрос = 100;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(НастройкиСоединения.КоличествоПопытокЗапроса) Тогда
		НастройкиСоединения.КоличествоПопытокЗапроса = 10;
	КонецЕсли;
	
	ПараметрыЗапроса = ИС_МП_РаботаСHTTPЗапросами.СтруктураHTTPЗапроса();
	ПараметрыЗапроса.Сервер = НастройкиСоединения["Адрес" + Сервис];
	ПараметрыЗапроса.Порт = НастройкиСоединения["Порт" + Сервис];
	ПараметрыЗапроса.ЗащищенноеСоединение = НастройкиСоединения["HTTPS" + Сервис];
	ПараметрыЗапроса.Вставить("РежимОтладки", НастройкиСоединения.РежимОтладки);
	ПараметрыЗапроса.Вставить("КоличествоЭлементовНаЗапрос", НастройкиСоединения.КоличествоЭлементовНаЗапрос);
	ПараметрыЗапроса.Вставить("КоличествоПопытокЗапроса", НастройкиСоединения.КоличествоПопытокЗапроса);
		
	ПараметрыЗапроса.Заголовки.Вставить("Authorization", Токен);
	
	Возврат ПараметрыЗапроса;
	
КонецФункции //- ИнфоСофт Ивонин К.А. 20.01.25 УА #89159

