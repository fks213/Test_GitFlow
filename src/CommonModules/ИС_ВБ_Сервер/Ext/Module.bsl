			ВыборкаИдентификаторов = ВыборкаТипДоставки.Выбрать();
		
			Пока ВыборкаИдентификаторов.Следующий() Цикл
				ПеревестиЗаказНаСборкуDBS(Профиль, ВыборкаИдентификаторов.Номер);	
			КонецЦикла;
			
			Продолжить;
			
		КонецЕсли;
		
		Если ВыборкаТипДоставки.ТипДоставки = Перечисления.ИС_ВБ_ТипыДоставки.CnC Тогда
		
			ВыборкаИдентификаторов = ВыборкаТипДоставки.Выбрать();
		
			Пока ВыборкаИдентификаторов.Следующий() Цикл
				ПеревестиЗаказНаСборкуCnC(Профиль, ВыборкаИдентификаторов.Номер)	
			КонецЦикла;
			
			Продолжить;
			
		КонецЕсли;
		
	КонецЦикла;
	
	ОбновитьСтатусыЗаказов(Профиль, ВыделенныеСтроки);
	
