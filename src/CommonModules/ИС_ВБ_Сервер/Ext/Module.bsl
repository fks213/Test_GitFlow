				ОтменитьЗаказFBS(Профиль, ВыборкаИдентификаторов.Номер);			
			КонецЦикла;
			
			Продолжить;
			
		КонецЕсли;
		
		Если ВыборкаТипДоставки.ТипДоставки = Перечисления.ИС_ВБ_ТипыДоставки.DBS 
				Или ВыборкаТипДоставки.ТипДоставки = Перечисления.ИС_ВБ_ТипыДоставки.EDBS Тогда
		
			ВыборкаИдентификаторов = ВыборкаТипДоставки.Выбрать();
		
			Пока ВыборкаИдентификаторов.Следующий() Цикл
				ОтменитьЗаказDBS(Профиль, ВыборкаИдентификаторов.Номер);	
			КонецЦикла;
			
			Продолжить;
			
		КонецЕсли;
		
		Если ВыборкаТипДоставки.ТипДоставки = Перечисления.ИС_ВБ_ТипыДоставки.CnC Тогда
		
			ВыборкаИдентификаторов = ВыборкаТипДоставки.Выбрать();
		
			Пока ВыборкаИдентификаторов.Следующий() Цикл
				ОтменитьЗаказCnC(Профиль, ВыборкаИдентификаторов.Номер)	
			КонецЦикла;
			
			Продолжить;
			
		КонецЕсли;
		
	КонецЦикла;
	
	ОбновитьСтатусыЗаказов(Профиль, ВыделенныеСтроки);
	
КонецПроцедуры //- ИнфоСофт Ивонин К.А. 09.04.25 УА #96894

