#Область СкладыПродавца

//+ ИнфоСофт Ивонин К.А. 03.02.25 УА #92406
Процедура ЗагрузитьСклады(Профиль) Экспорт
	
	Событие = ИмяСобытия("ЗагрузитьСклады");
	
	ПараметрыЗапроса = ПараметрыHTTPЗапроса(Профиль, "Маркетплейс");
	
	СписокСкладов = ИС_ВБ_АПИ.СписокСкладовПродавца(Профиль, ПараметрыЗапроса);
		
	Если СписокСкладов = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Если СписокСкладов.Количество() = 0 Тогда
		ОбщегоНазначения.СообщитьПользователю("В данном профиле отсутствуют склады");
		Возврат;	
	КонецЕсли;
	
	УстанавливатьПометкиУдаления = Истина;
	
	СкладыВБ = ИС_ВБ_АПИ.СписокСкладовВБ(Профиль, ПараметрыЗапроса);
	
	Если СкладыВБ = Неопределено Тогда
		СкладыВБ = Новый Массив;	
	КонецЕсли;
	
	МассивЗагруженных = Новый Массив;
					
	Для Каждого Элемент Из СписокСкладов Цикл 
		
		Склад = СоздатьИлиОбновитьСклад(Профиль, Элемент, СкладыВБ);
		
		Если Склад = Неопределено Тогда
			УстанавливатьПометкиУдаления = Ложь;
			Продолжить;	
		КонецЕсли;
		
		МассивЗагруженных.Добавить(Склад);
		
	КонецЦикла;
	
	Если Не УстанавливатьПометкиУдаления Тогда
		Возврат;	
	КонецЕсли;
	
	// Помечаем на удаление склады, которых не было в ответе 
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ИС_ВБ_Склады.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.ИС_ВБ_Склады КАК ИС_ВБ_Склады
	|ГДЕ
	|	НЕ ИС_ВБ_Склады.Ссылка В (&Массив)
	|	И ИС_ВБ_Склады.Профиль = &Профиль";
	
	Запрос.УстановитьПараметр("Массив", МассивЗагруженных);
	Запрос.УстановитьПараметр("Профиль", Профиль);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаСкладов = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаСкладов.Следующий() Цикл
		
		СправочникОбъект = ВыборкаСкладов.Ссылка.ПолучитьОбъект();
		
		Попытка
			СправочникОбъект.УстановитьПометкуУдаления(Истина);
		Исключение
			ТекстОшибки = ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
			ИС_МП_Сервер.ЗаписатьВЖРИСообщитьПользователю(Событие, ТекстОшибки);
		КонецПопытки;
			
	КонецЦикла;
				
КонецПроцедуры //- ИнфоСофт Ивонин К.А. 05.02.25 УА #92406

//+ ИнфоСофт Ивонин К.А. 05.02.25 УА #92406
Функция СоздатьИлиОбновитьСклад(Профиль, ДанныеСклада, СкладыВБ) Экспорт
	
	Событие = ИмяСобытия("СоздатьИлиОбновитьСклад");
	
	Если Не ДанныеСклада.Свойство("id") Тогда
		ОбщегоНазначения.СообщитьПользователю("В полученных данных отсутствует ID склада");
		Возврат Неопределено;
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ИС_ВБ_Склады.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.ИС_ВБ_Склады КАК ИС_ВБ_Склады
	|ГДЕ
	|	ИС_ВБ_Склады.Профиль = &Профиль
	|	И ИС_ВБ_Склады.Код = &Код";
	
	Запрос.УстановитьПараметр("Профиль", Профиль);
	Запрос.УстановитьПараметр("Код", ДанныеСклада.id);
				
	РезультатЗапроса = Запрос.Выполнить();		
	
	Если РезультатЗапроса.Пустой() Тогда		
		Склад = Справочники.ИС_ВБ_Склады.СоздатьЭлемент();		
	Иначе
		ВыборкаСклада = РезультатЗапроса.Выбрать();
		ВыборкаСклада.Следующий();
		Склад = ВыборкаСклада.Ссылка.ПолучитьОбъект();                
	КонецЕсли; 
	
	Склад.Профиль = Профиль;
	Склад.Код = ДанныеСклада.id;
	Склад.ПометкаУдаления = Ложь;
	
	Если ДанныеСклада.Свойство("name") Тогда
		Склад.Наименование = ДанныеСклада.name;
	КонецЕсли;
	
	Если ДанныеСклада.Свойство("cargoType") Тогда
		Склад.ТипТовара = ЗначениеПеречисленияТипаТовара(ДанныеСклада.cargoType);
	КонецЕсли;

	Если ДанныеСклада.Свойство("deliveryType") Тогда
		Склад.ТипДоставки = ЗначениеПеречисленияТипаДоставки(ДанныеСклада.deliveryType);
	КонецЕсли;
	
	Если ДанныеСклада.Свойство("officeId") Тогда
		
		Для Каждого СкладВБ Из СкладыВБ Цикл
			
			Если Не СкладВБ.Свойство("id") Тогда
				Продолжить;
			КонецЕсли;
			
			Если СкладВБ.id = ДанныеСклада.officeId Тогда
				
				Если СкладВБ.Свойство("name") Тогда
					Склад.СкладWB = СкладВБ.name;	
				КонецЕсли; 
				
				Если СкладВБ.Свойство("address") Тогда
					Склад.АдресСкладаWB = СкладВБ.address;	
				КонецЕсли;
				
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЕсли;
	
	Склад.ЗагруженИзЛК = Истина;
	
	Попытка
		
		Склад.Записать();
		Возврат Склад.Ссылка;
		
	Исключение
	
		Текст = ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
		ИС_МП_Сервер.ЗаписатьВЖРИСообщитьПользователю(Событие, Текст);
	
	КонецПопытки;
	
	Возврат Неопределено;
	
КонецФункции //- ИнфоСофт Ивонин К.А. 05.02.25 УА #34786

