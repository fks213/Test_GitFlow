//+ ИнфоСофт Ивонин К.А. 08.04.25 УА #96894
Процедура ЗаполнитьИнформациюОПокупателеDBS(Профиль, СоответствиеЗаказов) Экспорт
	
	Событие = ИмяСобытия("ЗаполнитьИнформациюОПокупателеDBS");
	
	ПараметрыЗапроса = ПараметрыHTTPЗапроса(Профиль, "Маркетплейс");	
	
	МассивИдентификаторов = Новый Массив;
	
	Для Каждого Элемент Из СоответствиеЗаказов Цикл
		МассивИдентификаторов.Добавить(Элемент.Ключ);
	КонецЦикла;
	
	ИнформацияОПокупателе = ИС_ВБ_АПИ.ИнформацияОПокупателеDBS(Профиль, ПараметрыЗапроса, МассивИдентификаторов);	
	
	Если ИнформацияОПокупателе = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Для Каждого Элемент Из ИнформацияОПокупателе Цикл
		
		ЗаказОбъект = СоответствиеЗаказов[Элемент.orderID].ПолучитьОбъект();

		Если Элемент.Свойство("fullName") Тогда
			ЗаказОбъект.fio = Элемент.fullName;
		КонецЕсли;
		
		Если Элемент.Свойство("phone") Тогда
			ЗаказОбъект.phone = Элемент.phone;
		КонецЕсли;
		
		Если Элемент.Свойство("phoneCode") Тогда
			ЗаказОбъект.ДобавочныеКоды = Формат(Элемент.phoneCode, "ЧГ=") + "; ";
		КонецЕсли;
		
		Если Элемент.Свойство("additionalPhoneCodes") И ТипЗнч(Элемент.additionalPhoneCodes) = Тип("Массив") Тогда
			
			Для Каждого ДобКод Из Элемент.additionalPhoneCodes Цикл
				ЗаказОбъект.ДобавочныеКоды = ЗаказОбъект.ДобавочныеКоды + Формат(ДобКод, "ЧГ=") + "; ";	
			КонецЦикла; 
			
		КонецЕсли;
		
		Попытка
			ЗаказОбъект.Записать();
		Исключение
			ТекстОшибки = ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
			ИС_МП_Сервер.ЗаписатьВЖРИСообщитьПользователю(Событие, ТекстОшибки);
		КонецПопытки;
		
	КонецЦикла;
	
КонецПроцедуры //- ИнфоСофт Ивонин К.А. 08.04.25 УА #96894

