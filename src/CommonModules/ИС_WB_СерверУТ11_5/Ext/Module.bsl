//Функция ПроверитьСвободныеОстатки(ТаблицаТоваров, Склад) Экспорт
Функция ПроверитьСвободныеОстатки(ТаблицаТоваров, Склад, Назначения = Неопределено) Экспорт
	//- ИнфоСофт Стояк Ю.К. 18.11.2024 УА #74083
	
	//+ ИнфоСофт Стояк Ю.К. 18.11.2024 УА #74083	
	Если Не ЗначениеЗаполнено(Назначения) Тогда
		Назначения = Новый Массив;
		Назначения.Добавить(Справочники.Назначения.ПустаяСсылка());
	КонецЕсли;                                  
	//- ИнфоСофт Стояк Ю.К. 18.11.2024 УА #74083
	
	ЗапросОстатков = Новый Запрос;	
	ЗапросОстатков.Текст =
	//+ ИнфоСофт Сумин Д.В. 15.08.2023 УА #62101
	"ВЫБРАТЬ
	|	ТЗ.Номенклатура КАК Номенклатура,
	|	ТЗ.Характеристика КАК Характеристика
	|ПОМЕСТИТЬ ВТ_ТаблицаЗначений
	|ИЗ
	|	&ТЗ КАК ТЗ
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_ТаблицаЗначений.Номенклатура КАК Номенклатура,
	|	ВТ_ТаблицаЗначений.Характеристика КАК Характеристика,
	|	РаспределениеЗапасов.Склад КАК Склад,
	//+ ИнфоСофт Заварин К.В. 11.02.25 УА #93503
	|	РаспределениеЗапасов.Свободно как Свободно,
	//- ИнфоСофт Заварин К.В. 11.02.25 УА #93503
	|	ВЫБОР
	|		КОГДА РаспределениеЗапасов.Свободно ЕСТЬ NULL
	|			ТОГДА ЛОЖЬ
	|		ИНАЧЕ РаспределениеЗапасов.Свободно > 0
	|	КОНЕЦ КАК ОстатокВНаличии
	|ИЗ
	|	ВТ_ТаблицаЗначений КАК ВТ_ТаблицаЗначений
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.РаспределениеЗапасов КАК РаспределениеЗапасов
	|		ПО (ВТ_ТаблицаЗначений.Номенклатура = РаспределениеЗапасов.Номенклатура)
	|			И (ВТ_ТаблицаЗначений.Характеристика = РаспределениеЗапасов.Характеристика)
	|			И (РаспределениеЗапасов.Склад В ИЕРАРХИИ (&Склад))
	//+ ИнфоСофт Мурсалимов Д.Р. 11.10.23 УА #64600
	|			И (РаспределениеЗапасов.Состояние = ЗНАЧЕНИЕ(Перечисление.РаспределениеЗапасовСостояния.ОстатокНаСкладе))
	//- ИнфоСофт Мурсалимов Д.Р. 11.10.23 УА #64600
	//+ ИнфоСофт Стояк Ю.К. 18.11.2024 УА #74083
	|			И (РаспределениеЗапасов.Назначение В (&Назначения))
	//- ИнфоСофт Стояк Ю.К. 18.11.2024 УА #74083
	|
	|УПОРЯДОЧИТЬ ПО
	|	ОстатокВНаличии УБЫВ";
	//- ИнфоСофт Сумин Д.В. 15.08.2023 УА #62101
	
	ЗапросОстатков.УстановитьПараметр("ТЗ", ТаблицаТоваров);
	ЗапросОстатков.УстановитьПараметр("Склад", Склад);
	//+ ИнфоСофт Стояк Ю.К. 19.11.2024 УА #74083
	ЗапросОстатков.УстановитьПараметр("Назначения", Назначения);
	//- ИнфоСофт Стояк Ю.К. 19.11.2024 УА #74083
	
	РезультатЗапросаОстатков = ЗапросОстатков.Выполнить();
	
	ВыгрузкаОстатков = РезультатЗапросаОстатков.Выгрузить();
	
	Возврат ВыгрузкаОстатков;
	
КонецФункции //- ИнфоСофт Ивонин К.А. 05.04.23 УА #57127

