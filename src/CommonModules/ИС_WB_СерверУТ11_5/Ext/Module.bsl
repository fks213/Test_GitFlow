//+ ИнфоСофт Власова И.С. 14.03.25 УА #83865
Функция СоздатьИзменитьОтчетОСписанииТоваровУХранителя(Профиль, ДанныеДокумента, ДопПараметры = Неопределено) Экспорт
	
	Если ТипЗнч(ДопПараметры) = Тип("Структура") И ДопПараметры.Свойство("ДокументСсылка") Тогда
		ДокументОбъект = ДопПараметры.ДокументСсылка.ПолучитьОбъект();
	Иначе	
		ДокументОбъект = Документы.ОтчетОСписанииТоваровУХранителя.СоздатьДокумент();
	КонецЕсли;
	
	ДокументОбъект.Дата                  = ДанныеДокумента.Дата;
	ДокументОбъект.Партнер               = ДанныеДокумента.Партнер;
	ДокументОбъект.Контрагент            = ДанныеДокумента.Контрагент;
	ДокументОбъект.Соглашение            = ДанныеДокумента.Соглашение;
	ДокументОбъект.ХозяйственнаяОперация = ДанныеДокумента.ХозяйственнаяОперация;
	ДокументОбъект.Организация           = ДанныеДокумента.Организация;
	ДокументОбъект.Договор               = ДанныеДокумента.Договор;
	ДокументОбъект.СтатьяРасходов        = ДанныеДокумента.СтатьяРасходов;
	ДокументОбъект.Комментарий           = ДанныеДокумента.Комментарий;
	ДокументОбъект.Подразделение         = ДанныеДокумента.Подразделение;
	ДокументОбъект.Ответственный         = Пользователи.АвторизованныйПользователь();
	ДокументОбъект.Автор                 = ДокументОбъект.Ответственный;
	ДокументОбъект.Валюта                = ?(ЗначениеЗаполнено(ДанныеДокумента.Соглашение), 
											ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ДанныеДокумента.Соглашение, "Валюта"), 
											ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ДанныеДокумента.Договор, "Валюта"));
											
	РеквизитыСтатьи = ДоходыИРасходыВызовСервераПовтИсп.ЗначенияРеквизитовСтатьи(ДанныеДокумента.СтатьяРасходов);										
	ДокументОбъект.АналитикаРасходов     = ДоходыИРасходыКлиентСервер.ПолучитьАналитикуПоУмолчанию(РеквизитыСтатьи, ДокументОбъект.Ссылка);
	
	ДокументОбъект.Товары.Очистить();
	
	Для Каждого Строка Из ДанныеДокумента.Товары Цикл
		
		НоваяСтрока = ДокументОбъект.Товары.Добавить();
		
		НоваяСтрока.Номенклатура   = Строка.Номенклатура;
		НоваяСтрока.Характеристика = Строка.Характеристика;
		НоваяСтрока.Цена           = Строка.Сумма;
		НоваяСтрока.Количество     = 1;
		НоваяСтрока.Сумма          = НоваяСтрока.Цена * НоваяСтрока.Количество;
		
	КонецЦикла;
	
	Попытка	
		ДокументОбъект.Записать(РежимЗаписиДокумента.Проведение);	
	Исключение
		
		ТекстСообщения = "Не удалось провести отчет о списании товаров у комиссионера.";
		ТекстОшибки    = ОписаниеОшибки();
		ОбщегоНазначения.СообщитьПользователю(СтрШаблон("%1|%2", ТекстСообщения, ТекстОшибки));
		
		Попытка	
			ДокументОбъект.Записать(РежимЗаписиДокумента.Запись);	
		Исключение
			
			ТекстСообщения = "Не удалось записать отчет о списании товаров у комиссионера.";
			ТекстОшибки    = ОписаниеОшибки();
			ОбщегоНазначения.СообщитьПользователю(СтрШаблон("%1|%2", ТекстСообщения, ТекстОшибки));
			
			Возврат Неопределено;
			
		КонецПопытки;
		
	КонецПопытки;
	
	Возврат ДокументОбъект.Ссылка;
	
КонецФункции //- ИнфоСофт Власова И.С. 14.03.25 УА #83865

//+ ИнфоСофт Власова И.С. 14.03.25 УА #83865
Функция ПолучитьСтруктуруОтчетаОСписанииТоваровУХранителя() Экспорт

	СтруктураДокумента = Новый Структура;
	
	СтруктураДокумента.Вставить("Дата");
	СтруктураДокумента.Вставить("Партнер");
	СтруктураДокумента.Вставить("Контрагент");
	СтруктураДокумента.Вставить("Соглашение");
	СтруктураДокумента.Вставить("ХозяйственнаяОперация");
	СтруктураДокумента.Вставить("Организация");
	СтруктураДокумента.Вставить("Договор");
	СтруктураДокумента.Вставить("СтатьяРасходов");
	СтруктураДокумента.Вставить("Договор");
	СтруктураДокумента.Вставить("Комментарий");
	СтруктураДокумента.Вставить("Подразделение");
	
	ТоварыТЧ = Новый ТаблицаЗначений;
	ТоварыТЧ.Колонки.Добавить("Номенклатура");
	ТоварыТЧ.Колонки.Добавить("Характеристика");
	ТоварыТЧ.Колонки.Добавить("Количество");
	
	СтруктураДокумента.Вставить("Товары", ТоварыТЧ);
	
	Возврат СтруктураДокумента;
	
