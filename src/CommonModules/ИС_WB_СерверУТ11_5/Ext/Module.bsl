Функция СоздатьДокументОтчетКомиссионера(ДанныеОбработки) Экспорт
	
	УстановитьПривилегированныйРежим(Истина);
	//Подготовка данных для документа
	СписокТранзакций = ДанныеОбработки.СтруктураДанных.СписокТранзакций; 
	
	ТаблицаПродаж = Новый ТаблицаЗначений;
	ТаблицаПродаж.Колонки.Добавить("Номенклатура", Новый ОписаниеТипов("СправочникСсылка.Номенклатура"));
	ТаблицаПродаж.Колонки.Добавить("Характеристика", Новый ОписаниеТипов("СправочникСсылка.ХарактеристикиНоменклатуры"));
	ТаблицаПродаж.Колонки.Добавить("Баркод", Новый ОписаниеТипов("Строка",,,, Новый КвалификаторыСтроки(50)));
	ТаблицаПродаж.Колонки.Добавить("Количество", Новый ОписаниеТипов("Число",,, Новый КвалификаторыЧисла(10,2)));
	//+ ИнфоСофт Мурсалимов Д.Р. 05.09.24 УА #82005
	//ТаблицаПродаж.Колонки.Добавить("КоличествоВУпаковке", Новый ОписаниеТипов("Число",,, Новый КвалификаторыЧисла(10,2)));
	ТаблицаПродаж.Колонки.Добавить("КоэффициентУпаковки", Новый ОписаниеТипов("Число",,, Новый КвалификаторыЧисла(10,2)));
	//- ИнфоСофт Мурсалимов Д.Р. 05.09.24 УА #82005
	ТаблицаПродаж.Колонки.Добавить("Цена", Новый ОписаниеТипов("Число",,, Новый КвалификаторыЧисла(10,2)));
	ТаблицаПродаж.Колонки.Добавить("Упаковка", Новый ОписаниеТипов("СправочникСсылка.УпаковкиЕдиницыИзмерения"));
	ТаблицаПродаж.Колонки.Добавить("ЭтоНабор", Новый ОписаниеТипов("Булево"));
	ТаблицаПродаж.Колонки.Добавить("СуммаПродажи", Новый ОписаниеТипов("Число",,, Новый КвалификаторыЧисла(10,2)));
	ТаблицаПродаж.Колонки.Добавить("ЦенаРозничная", Новый ОписаниеТипов("Число",,, Новый КвалификаторыЧисла(10,2)));	
	
	СуммаБрака = 0;
	
	ТаблицаПотерь = Новый ТаблицаЗначений;
	ТаблицаПотерь.Колонки.Добавить("Номенклатура", Новый ОписаниеТипов("СправочникСсылка.Номенклатура"));
	ТаблицаПотерь.Колонки.Добавить("Характеристика", Новый ОписаниеТипов("СправочникСсылка.ХарактеристикиНоменклатуры"));
	ТаблицаПотерь.Колонки.Добавить("Сумма", Новый ОписаниеТипов("Число",,, Новый КвалификаторыЧисла(10,2)));
	ТаблицаПотерь.Колонки.Добавить("Упаковка", Новый ОписаниеТипов("СправочникСсылка.УпаковкиЕдиницыИзмерения"));
	ТаблицаПотерь.Колонки.Добавить("ЭтоНабор", Новый ОписаниеТипов("Булево"));
	
	//+ ИнфоСофт Власова И.С. 14.03.25 УА #83865
	ТаблицаОприходований = Новый ТаблицаЗначений;
	ТаблицаОприходований.Колонки.Добавить("Номенклатура",   Новый ОписаниеТипов("СправочникСсылка.Номенклатура"));
	ТаблицаОприходований.Колонки.Добавить("Характеристика", Новый ОписаниеТипов("СправочникСсылка.ХарактеристикиНоменклатуры"));
	ТаблицаОприходований.Колонки.Добавить("Сумма",          Новый ОписаниеТипов("Число",,, Новый КвалификаторыЧисла(10,2)));
	ТаблицаОприходований.Колонки.Добавить("Упаковка",       Новый ОписаниеТипов("СправочникСсылка.УпаковкиЕдиницыИзмерения"));
	ТаблицаОприходований.Колонки.Добавить("ЭтоНабор",       Новый ОписаниеТипов("Булево"));
	ТаблицаОприходований.Колонки.Добавить("КПеречислениюПродавцуЗаРеализованныйТовар", 
															Новый ОписаниеТипов("Число",,, Новый КвалификаторыЧисла(10,2)));
	ТаблицаОприходований.Колонки.Добавить("УпаковкаКоличество", 
															Новый ОписаниеТипов("Число",,, Новый КвалификаторыЧисла(10,2)));
	ТаблицаОприходований.Колонки.Добавить("Количество",     Новый ОписаниеТипов("Число",,, Новый КвалификаторыЧисла(10,2)));														
	//- ИнфоСофт Власова И.С. 14.03.25 УА #83865
	
	//+ ИнфоСофт Сумин Д.В. 15.03.2024 УА #71773
	Если ДанныеОбработки.СтруктураДанных.СуммаУслугВБ = 0 Тогда
		РассчитатьКомиссионноеВознаграждение = Ложь;	
	Иначе		
		РассчитатьКомиссионноеВознаграждение = ДанныеОбработки.СтруктураДанных.РассчитатьКомиссионноеВознаграждение;
