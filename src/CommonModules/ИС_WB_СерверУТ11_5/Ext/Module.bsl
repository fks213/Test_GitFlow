//+ ИнфоСофт Сумин Д.В. 05.05.23 УА #58023
Процедура СоздатьРеализациюПоЗакрытиюЗаказа(Профиль, ЗаказКлиента) Экспорт
	
	Событие = ПолучитьИмяСобытия("СоздатьРеализации");
	
	Комиссия25 = Профиль.Договор.КомиссионныеПродажи25;
	
	Если Комиссия25 Тогда
		ДокументРеализация = Документы.ПередачаТоваровХранителю.СоздатьДокумент();	
	Иначе
		ДокументРеализация = Документы.РеализацияТоваровУслуг.СоздатьДокумент();
	КонецЕсли;	
	
	Попытка
		ДокументРеализация.Заполнить(ЗаказКлиента); 
	Исключение
		Текст = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
		ИС_MP_Сервер.ЗаписатьВЖРИСообщитьПользователю(Событие, Текст);
		Возврат;
	КонецПопытки;
	
	ДокументРеализация.Дата = ЗаказКлиента.Дата + Профиль.КоличествоДнейКРеализации * 86400;
	ДокументРеализация.Комментарий = ЗаказКлиента.Комментарий;
	ДокументРеализация.Подразделение = ЗаказКлиента.Подразделение;
	
	Если Профиль.ПроводитьРеализации Тогда	
		Попытка
			ДокументРеализация.Записать(РежимЗаписиДокумента.Проведение);
		Исключение
			Текст = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
			ИС_MP_Сервер.ЗаписатьВЖРИСообщитьПользователю(Событие, Текст);
		КонецПопытки;	
	Иначе
		ДокументРеализация.Записать();		
	КонецЕсли;		
	
КонецПроцедуры //- ИнфоСофт Сумин Д.В. 05.05.23 УА #58023	

