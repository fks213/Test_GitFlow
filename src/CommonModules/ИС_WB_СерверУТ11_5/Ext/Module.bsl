//+ ИнфоСофт Сумин Д.В. 06.07.2023 УА #60267
Функция СоздатьОтчетКомиссионера(Данные, Профиль, СтруктураНастроек) Экспорт
	
	ДокОтчет = Документы.ОтчетКомиссионера.СоздатьДокумент();
		
	ПараметрыФормы = Новый Структура;
	
	ПараметрыФормы.Вставить("Партнер", Профиль.Партнер); 
	ПараметрыФормы.Вставить("Контрагент", Профиль.Контрагент);
	ПараметрыФормы.Вставить("Организация", Профиль.Организация);	
	ПараметрыФормы.Вставить("КонецПериода", ДокОтчет.КонецПериода);
	
	ДокОтчет.Заполнить(ПараметрыФормы);  
	
	//+ ИнфоСофт Мурсалимов Д.Р. 16.06.24 УА #77666
	ДокОтчет.Партнер = Профиль.Партнер; 
	ДокОтчет.Контрагент = Профиль.Контрагент;
	ДокОтчет.Организация = Профиль.Организация;	
	//- ИнфоСофт Мурсалимов Д.Р. 16.06.24 УА #77666
	
	ДокОтчет.Дата = НачалоДня(СтруктураНастроек.ДатаДокумента);
	ДокОтчет.НачалоПериода = НачалоДня(СтруктураНастроек.НачалоПериода);
	ДокОтчет.КонецПериода = НачалоДня(СтруктураНастроек.КонецПериода);
	
	ПродажаОблагаетсяНДС = ПолучитьРезультатПроверкиУчетаНДС(Профиль.Организация); 
	
	Если ПродажаОблагаетсяНДС Тогда 
		ДокОтчет.НалогообложениеНДС = Перечисления.ТипыНалогообложенияНДС.ПродажаОблагаетсяНДС;  		
	Иначе
		ДокОтчет.НалогообложениеНДС = Перечисления.ТипыНалогообложенияНДС.ПродажаНеОблагаетсяНДС;	
	КонецЕсли;
	
	ДокОтчет.ДатаПлатежа = СтруктураНастроек.ДатаДокумента;
		
	ДокОтчет.Соглашение = Профиль.Соглашение; 
	ДокОтчет.Договор = Профиль.Договор;	  
	
	//+ ИнфоСофт Стояк Ю.К. 01.07.2024 УА #78655
	ИспользоватьПодразделения = ПолучитьФункциональнуюОпцию("ИспользоватьПодразделения");
	
	Если ИспользоватьПодразделения Тогда
		ДокОтчет.Подразделение = Профиль.Подразделение;
	КонецЕсли;
	//- ИнфоСофт Стояк Ю.К. 01.07.2024 УА #78655
	
	//+ ИнфоСофт Сумин Д.В. 12.02.2024 УА #70615
	ИспользоватьСоглашенияСКлиентами = ПолучитьФункциональнуюОпцию("ИспользоватьСоглашенияСКлиентами");
	ИспользоватьДоговорыСКлиентами = ПолучитьФункциональнуюОпцию("ИспользоватьДоговорыСКлиентами");
	
	ЗаполнитьХозОперацию = Истина;
	
	Если ИспользоватьСоглашенияСКлиентами И ДокОтчет.Соглашение.КомиссионныеПродажи25 Тогда 
		ДокОтчет.ХозяйственнаяОперация = Перечисления.ХозяйственныеОперации.РеализацияЧерезКомиссионера;
		ЗаполнитьХозОперацию = Ложь;
	КонецЕсли;
	
	Если ЗаполнитьХозОперацию И ИспользоватьДоговорыСКлиентами И ДокОтчет.Договор.КомиссионныеПродажи25 Тогда 
		ДокОтчет.ХозяйственнаяОперация = Перечисления.ХозяйственныеОперации.РеализацияЧерезКомиссионера;
		ЗаполнитьХозОперацию = Ложь;
	КонецЕсли;
	
	Если ЗаполнитьХозОперацию Тогда
		ДокОтчет.ХозяйственнаяОперация = Перечисления.ХозяйственныеОперации.ПередачаНаКомиссию;
	КонецЕсли;

	//Если ДокОтчет.Соглашение.КомиссионныеПродажи25 Тогда 
	//	ДокОтчет.ХозяйственнаяОперация = Перечисления.ХозяйственныеОперации.РеализацияЧерезКомиссионера;
	//Иначе
	//	ДокОтчет.ХозяйственнаяОперация = Перечисления.ХозяйственныеОперации.ПередачаНаКомиссию;
	//КонецЕсли;
    //- ИнфоСофт Сумин Д.В. 12.02.2024 УА #70615
	
	ДокОтчет.СпособРасчетаВознаграждения = Перечисления.СпособыРасчетаКомиссионногоВознаграждения.НеРассчитывается; 
	
	РассчитыватьВВ = СтруктураНастроек.ДанныеВВ.РассчитыватьВВ;
	
	//+ ИнфоСофт Мурсалимов Д.Р. 15.03.24 УА #71529
	Если СтруктураНастроек.ДанныеВВ.Свойство("СпособРасчетаЦеныВозврата") Тогда
		
		ЦеныВозвратаПоВидуЦен = ?(СтруктураНастроек.ДанныеВВ.СпособРасчетаЦеныВозврата.СпособРасчета = 1, Истина, Ложь);
	
		ВидЦены = СтруктураНастроек.ДанныеВВ.СпособРасчетаЦеныВозврата.ВидЦены; 
		
	Иначе
		
		ЦеныВозвратаПоВидуЦен = Ложь;		
		
	КонецЕсли;
	
	////+ ИнфоСофт Мурсалимов Д.Р. 09.02.24 УА #69965
	//ЦеныВозвратаПоВидуЦен = ?(СтруктураНастроек.ДанныеВВ.СпособРасчетаЦеныВозврата.СпособРасчета = 1, Истина, Ложь);
	//
	//ВидЦены = СтруктураНастроек.ДанныеВВ.СпособРасчетаЦеныВозврата.ВидЦены;
	////- ИнфоСофт Мурсалимов Д.Р. 09.02.24 УА #69965
	//- ИнфоСофт Мурсалимов Д.Р. 15.03.24 УА #71529
	
	Если РассчитыватьВВ Тогда 
		ДокОтчет.УдержатьВознаграждение = Истина; 
		ДокОтчет.СпособРасчетаВознаграждения = Перечисления.СпособыРасчетаКомиссионногоВознаграждения.ПроцентОтСуммыПродажи;
		СуммаУслугВБ = СтруктураНастроек.ДанныеВВ.СуммаУслугВБ;
		
		//Убирем строки с возвратами
		МассивПродаж = Новый Массив;
		Для Каждого Строка Из Данные Цикл
			Если Строка.Количество > 0 Тогда
				МассивПродаж.Добавить(Строка.Количество);	
			КонецЕсли;
		КонецЦикла;	
		СредняяСтоимостьУслуги = Окр(СуммаУслугВБ / МассивПродаж.Количество(), 2);
		//Для избежания потерь по копейкам, рассчитаем разницу между исходной суммой и суммой вознаграждения в документе
		ПотеряннаяСумма = СуммаУслугВБ - СредняяСтоимостьУслуги * МассивПродаж.Количество();  
		ПотереннаяСуммаДобавлена = Ложь;
		МассивНастроек = Новый Массив;
		
		Для Каждого Строка Из Данные Цикл
			Если Строка.Количество < 0 Тогда
				МассивНастроек.Добавить(0);	
			Иначе
				Если Не ПотереннаяСуммаДобавлена Тогда
					//+ ИнфоСофт Сумин Д.В. 23.11.2023 УА #64595
					МассивНастроек.Добавить(Строка.СуммаПродажи + ПотеряннаяСумма);
					//МассивНастроек.Добавить(СредняяСтоимостьУслуги + ПотеряннаяСумма);
					//- ИнфоСофт Сумин Д.В. 23.11.2023 УА #64595 
					ПотереннаяСуммаДобавлена = Истина;
				Иначе
					//+ ИнфоСофт Сумин Д.В. 23.11.2023 УА #64595
					МассивНастроек.Добавить(Строка.СуммаПродажи);
					//МассивНастроек.Добавить(СредняяСтоимостьУслуги);
					//- ИнфоСофт Сумин Д.В. 23.11.2023 УА #64595 	
				КонецЕсли;
			КонецЕсли;	
		КонецЦикла;
		//+ ИнфоСофт Сумин Д.В. 23.11.2023 УА #64595
		МассивНастроек = ОбщегоНазначения.РаспределитьСуммуПропорциональноКоэффициентам(СуммаУслугВБ, МассивНастроек);
		//- ИнфоСофт Сумин Д.В. 23.11.2023 УА #64595
	Иначе	
		ДокОтчет.УдержатьВознаграждение = Ложь; 
	КонецЕсли;
	
	ДокОтчет.Комментарий = СтруктураНастроек.Комментарий;
	
	СуммаДокумента = 0;
	Итератор = 0;
	
	Для Каждого Элемент Из Данные Цикл
		Если Элемент.ЭтоНабор Тогда
			
			//+ ИнфоСофт Мурсалимов Д.Р. 11.11.24 УА #85693
			//ТоварыНабора = ПолучитьТаблицуТоваровНабораNew(Элемент.Номенклатура, Элемент.Характеристика, Профиль);
			ТоварыНабора = ПолучитьТаблицуТоваровНабораNew(Профиль, Элемент.Номенклатура, Элемент.Характеристика);	
			//- ИнфоСофт Мурсалимов Д.Р. 11.11.24 УА #85693  
			
			Если ТоварыНабора[0].ВариантРасчетаЦены = Перечисления.ВариантыРасчетаЦенНаборов.РассчитываетсяИзЦенКомплектующих Или
				ТоварыНабора[0].ВариантРасчетаЦены = Перечисления.ВариантыРасчетаЦенНаборов.ЦенаЗадаетсяЗаНаборРаспределяетсяПоЦенам Тогда
				
				МассивКоэффициентов = РассчитатьКоэффициентыИзЦен(ТоварыНабора.ВыгрузитьКолонку("КомплектующиеЦена"), Элемент.Номенклатура);
			Иначе
				МассивКоэффициентов = ТоварыНабора.ВыгрузитьКолонку("ДоляСтоимости");
			КонецЕсли;
			
			//+ ИнфоСофт Сумин Д.В. 01.12.2023 УА #63730
			СуммыПродажи = ОбщегоНазначения.РаспределитьСуммуПропорциональноКоэффициентам(Элемент.СуммаПродажи, МассивКоэффициентов);
			//СуммыПродажи = ОбщегоНазначения.РаспределитьСуммуПропорциональноКоэффициентам(Элемент.ЦенаПродажи, МассивКоэффициентов);
			//- ИнфоСофт Сумин Д.В. 01.12.2023 УА #63730
			
			//Учитываем оплтау потерянного товара
			Если Элемент.ЦенаРозничная = 0 Тогда
				ЦенаРозничная = Элемент.ЦенаПродажи;                       
			Иначе
				ЦенаРозничная = Элемент.ЦенаРозничная;
			КонецЕсли;
			
			Если РассчитыватьВВ Тогда 
				Вознаграждение = МассивНастроек[Итератор]; 
				СуммыВознаграждения = ОбщегоНазначения.РаспределитьСуммуПропорциональноКоэффициентам(Вознаграждение, МассивКоэффициентов);
			КонецЕсли;
			
			СуммыПередачи = ОбщегоНазначения.РаспределитьСуммуПропорциональноКоэффициентам(ЦенаРозничная, МассивКоэффициентов);
			
			Для Каждого ЭлементНабора Из ТоварыНабора Цикл 
				
				НоваяСтрока = ДокОтчет.Товары.Добавить();
				
				НоваяСтрока.Номенклатура = ЭлементНабора.Номенклатура;
				НоваяСтрока.Характеристика = ЭлементНабора.Характеристика;
				НоваяСтрока.Количество = ЭлементНабора.КоличествоУпаковок * Элемент.Количество;
				НоваяСтрока.КоличествоУпаковок = ЭлементНабора.КоличествоУпаковок * Элемент.Количество;
				
				//+ ИнфоСофт Мурсалимов Д.Р. 06.02.2024 УА #69965
				Если НоваяСтрока.Количество < 0 Тогда	
		
					Если Не ЦеныВозвратаПоВидуЦен Тогда
						
						НоваяСтрока.Цена = -(СуммыПередачи[0] / ЭлементНабора.КоличествоУпаковок / Элемент.Количество);
						НоваяСтрока.СуммаСНДС = -(СуммыПередачи[0]);
						НоваяСтрока.Сумма = -(СуммыПередачи[0]);
						
					Иначе
						
						ЦенаРозничная = ЗаполнитьСуммыПоВидуЦен(ВидЦены, ДокОтчет.Дата, ДокОтчет.Валюта, ЭлементНабора.Номенклатура, ЭлементНабора.Характеристика, ЭлементНабора.Номенклатура.ЕдиницаИзмерения);
						
						НоваяСтрока.Цена = -(ЦенаРозничная / НоваяСтрока.Количество);
						НоваяСтрока.Сумма = -(ЦенаРозничная); 
						НоваяСтрока.СуммаСНДС = -(ЦенаРозничная);
						
					КонецЕсли;		
					
				Иначе 
					
					НоваяСтрока.Цена = СуммыПередачи[0] / ЭлементНабора.КоличествоУпаковок / Элемент.Количество;
					НоваяСтрока.СуммаСНДС = СуммыПередачи[0];
					НоваяСтрока.Сумма = СуммыПередачи[0];
					
				КонецЕсли; 
				
				НоваяСтрока.ЦенаПродажи = СуммыПродажи[0] / ЭлементНабора.КоличествоУпаковок / Элемент.Количество;
				НоваяСтрока.СуммаПродажи = СуммыПродажи[0];	
				//- ИнфоСофт Мурсалимов Д.Р. 06.02.2024 УА #69965 
				
				Если РассчитыватьВВ И СуммыВознаграждения <> Неопределено Тогда 
					//+ ИнфоСофт Сумин Д.В. 23.11.2023 УА #64595
					НоваяСтрока.СуммаВознаграждения = СуммыВознаграждения[0];
					//НоваяСтрока.СуммаВознаграждения = СуммыВознаграждения[0] * Элемент.Количество;
					//- ИнфоСофт Сумин Д.В. 23.11.2023 УА #64595
				КонецЕсли;
				СуммаДокумента = СуммаДокумента + НоваяСтрока.СуммаПродажи; 
				
				НоваяСтрока.Упаковка = ЭлементНабора.Упаковка;
				
				Если ПродажаОблагаетсяНДС Тогда
					НДС = ЭлементНабора.Номенклатура.СтавкаНДС.Ставка;
					НоваяСтрока.СтавкаНДС = ЭлементНабора.Номенклатура.СтавкаНДС; 
					Если Не ЗначениеЗаполнено(НДС) Или НДС = 0 Тогда 
						НоваяСтрока.СуммаПродажиНДС = 0;
						НоваяСтрока.СуммаНДС = 0;
						Если РассчитыватьВВ Тогда
							НоваяСтрока.СуммаНДСВознаграждения = 0;
						КонецЕсли;
					Иначе
						НоваяСтрока.СуммаПродажиНДС = РассчитатьСуммуНДС(НоваяСтрока.ЦенаПродажи, НДС, Истина); 
						НоваяСтрока.СуммаНДС = РассчитатьСуммуНДС(НоваяСтрока.Цена, НДС, Истина);
						//+ ИнфоСофт Мурсалимов Д.Р. 06.02.2024 УА #69965
						Если НоваяСтрока.Количество < 0 Тогда 
							НоваяСтрока.СуммаПродажиНДС = -(НоваяСтрока.СуммаПродажиНДС);
					        НоваяСтрока.СуммаНДС = -(НоваяСтрока.СуммаНДС); 
						КонецЕсли;
						//- ИнфоСофт Мурсалимов Д.Р. 06.02.2024 УА #69965
						
						Если РассчитыватьВВ И СуммыВознаграждения <> Неопределено Тогда
							//+ ИнфоСофт Сумин Д.В. 23.11.2023 УА #64595
							НоваяСтрока.СуммаНДСВознаграждения = РассчитатьСуммуНДС(НоваяСтрока.СуммаВознаграждения, НДС, Истина);
							//НоваяСтрока.СуммаНДСВознаграждения = РассчитатьСуммуНДС(НоваяСтрока.СуммаВознаграждения, НДС, Истина) * Элемент.Количество;
							//- ИнфоСофт Сумин Д.В. 23.11.2023 УА #64595
						КонецЕсли;
					КонецЕсли;	
				Иначе
					НоваяСтрока.СтавкаНДС = Справочники.СтавкиНДС.НайтиПоНаименованию("Без НДС");
				КонецЕсли;
								
				СуммыПродажи.Удалить(0);
				СуммыПередачи.Удалить(0);
				Если РассчитыватьВВ И СуммыВознаграждения <> Неопределено Тогда 
					СуммыВознаграждения.Удалить(0);	
				КонецЕсли;	
			КонецЦикла;	
			
		Иначе
			НоваяСтрока = ДокОтчет.Товары.Добавить();
			
			Если РассчитыватьВВ Тогда 
				//+ ИнфоСофт Сумин Д.В. 23.11.2023 УА #64595
				НоваяСтрока.СуммаВознаграждения = МассивНастроек[Итератор];
				//НоваяСтрока.СуммаВознаграждения = МассивНастроек[Итератор] * Элемент.Количество;
				//- ИнфоСофт Сумин Д.В. 23.11.2023 УА #64595
			КонецЕсли;
			
			НоваяСтрока.Номенклатура = Элемент.Номенклатура;
			НоваяСтрока.Характеристика = Элемент.Характеристика;
			НоваяСтрока.КоличествоУпаковок = Элемент.Количество;
			
			//+ ИнфоСофт Мурсалимов Д.Р. 05.09.24 УА #82005
			//НоваяСтрока.Количество = Элемент.КоличествоВУпаковке * Элемент.Количество; 
			НоваяСтрока.Количество = Элемент.КоэффициентУпаковки * Элемент.Количество;
			//- ИнфоСофт Мурсалимов Д.Р. 05.09.24 УА #82005
			
			//+ ИнфоСофт Мурсалимов Д.Р. 06.02.2024 УА #69965 
			Если НоваяСтрока.Количество < 0 Тогда
				
				Если Не ЦеныВозвратаПоВидуЦен Тогда
					
					НоваяСтрока.Цена = -(Элемент.ЦенаРозничная / НоваяСтрока.Количество);
					НоваяСтрока.Сумма = -(Элемент.ЦенаРозничная); 
					НоваяСтрока.СуммаСНДС = -(Элемент.ЦенаРозничная);
					
				Иначе
					
					ЦенаРозничная = ЗаполнитьСуммыПоВидуЦен(ВидЦены, ДокОтчет.Дата, ДокОтчет.Валюта, Элемент.Номенклатура, Элемент.Характеристика, Элемент.Номенклатура.ЕдиницаИзмерения);
				
				    НоваяСтрока.Цена = -(ЦенаРозничная / НоваяСтрока.Количество);
					НоваяСтрока.Сумма = -(ЦенаРозничная); 
					НоваяСтрока.СуммаСНДС = -(ЦенаРозничная);
					
				КонецЕсли;
				
			Иначе
				
				НоваяСтрока.Цена = Элемент.ЦенаРозничная / НоваяСтрока.Количество;
				НоваяСтрока.Сумма = Элемент.ЦенаРозничная; 
				НоваяСтрока.СуммаСНДС = Элемент.ЦенаРозничная;	
				
			КонецЕсли;  
						
			НоваяСтрока.ЦенаПродажи = Элемент.СуммаПродажи / НоваяСтрока.Количество;
			НоваяСтрока.СуммаПродажи = Элемент.СуммаПродажи;	

			//НоваяСтрока.Цена = Элемент.ЦенаРозничная;
			//НоваяСтрока.Сумма = Элемент.ЦенаРозничная * Элемент.Количество; 
			//НоваяСтрока.СуммаСНДС = Элемент.ЦенаРозничная * Элемент.Количество;
			
			//НоваяСтрока.ЦенаПродажи = Элемент.ЦенаПродажи; 
			//НоваяСтрока.СуммаПродажи = НоваяСтрока.ЦенаПродажи * Элемент.Количество;
			//- ИнфоСофт Мурсалимов Д.Р. 06.02.2024 УА #69965
			
			СуммаДокумента = СуммаДокумента + НоваяСтрока.СуммаПродажи; 	
			НоваяСтрока.Упаковка = Элемент.Упаковка;
			
			Если ПродажаОблагаетсяНДС Тогда
				НДС = Элемент.Номенклатура.СтавкаНДС.Ставка;
				НоваяСтрока.СтавкаНДС = Элемент.Номенклатура.СтавкаНДС; 
				Если Не ЗначениеЗаполнено(НДС) Или НДС = 0 Тогда 
					НоваяСтрока.СуммаПродажиНДС = 0;
					НоваяСтрока.СуммаНДС = 0;
					Если РассчитыватьВВ Тогда
						НоваяСтрока.СуммаНДСВознаграждения = 0;
					КонецЕсли;
				Иначе
					НоваяСтрока.СуммаПродажиНДС = РассчитатьСуммуНДС(НоваяСтрока.ЦенаПродажи, НДС, Истина);
					НоваяСтрока.СуммаНДС = РассчитатьСуммуНДС(НоваяСтрока.Цена, НДС, Истина);
 
					//+ ИнфоСофт Мурсалимов Д.Р. 06.02.2024 УА #69965
					Если НоваяСтрока.Количество < 0 Тогда 
						НоваяСтрока.СуммаПродажиНДС = -(НоваяСтрока.СуммаПродажиНДС);
						НоваяСтрока.СуммаНДС = -(НоваяСтрока.СуммаНДС); 
					КонецЕсли;
					//- ИнфоСофт Мурсалимов Д.Р. 06.02.2024 УА #69965
					
					Если РассчитыватьВВ Тогда
						//+ ИнфоСофт Сумин Д.В. 23.11.2023 УА #64595
						НоваяСтрока.СуммаНДСВознаграждения = РассчитатьСуммуНДС(НоваяСтрока.СуммаВознаграждения, НДС, Истина);
						//НоваяСтрока.СуммаНДСВознаграждения = РассчитатьСуммуНДС(НоваяСтрока.СуммаВознаграждения, НДС, Истина) * Элемент.Количество;
						//- ИнфоСофт Сумин Д.В. 23.11.2023 УА #64595
					КонецЕсли;
				КонецЕсли;	
			Иначе
				НоваяСтрока.СтавкаНДС = Справочники.СтавкиНДС.НайтиПоНаименованию("Без НДС");
			КонецЕсли;
				
		КонецЕсли;
		
		Если РассчитыватьВВ Тогда 
			Итератор = Итератор + 1;
		КонецЕсли;
		
	КонецЦикла;
	
	ДокОтчет.СуммаДокумента = СуммаДокумента;
	Если СтруктураНастроек.ДанныеВВ.РассчитыватьВВ Тогда 
		ДокОтчет.СуммаВознаграждения = СтруктураНастроек.ДанныеВВ.СуммаУслугВБ;
		ДокОтчет.ПроцентВознаграждения = ДокОтчет.СуммаВознаграждения * 100 / ДокОтчет.СуммаДокумента;
		ДокОтчет.Услуга = СтруктураНастроек.ДанныеВВ.НастройкиЗаполненияВВ.Номенклатура;
		Если ПродажаОблагаетсяНДС Тогда
			Если ЗначениеЗаполнено(СтруктураНастроек.ДанныеВВ.НастройкиЗаполненияВВ.СтавкаНДС) Тогда 
				ДокОтчет.СтавкаНДСВознаграждения = СтруктураНастроек.ДанныеВВ.НастройкиЗаполненияВВ.СтавкаНДС;
				ДокОтчет.СуммаНДСВознаграждения = РассчитатьСуммуНДС(ДокОтчет.СуммаВознаграждения, СтруктураНастроек.ДанныеВВ.НастройкиЗаполненияВВ.СтавкаНДС.Ставка, Истина);	
			КонецЕсли;
		Иначе
			ДокОтчет.СтавкаНДСВознаграждения = Справочники.СтавкиНДС.НайтиПоНаименованию("Без НДС");
			ДокОтчет.СуммаНДСВознаграждения = 0;
		КонецЕсли;	
	КонецЕсли;	
	Попытка
		ДокОтчет.Записать(РежимЗаписиДокумента.Проведение); 
	Исключение
		ДокОтчет.Записать();
	КонецПопытки;  
	
	Возврат ДокОтчет;
	
КонецФункции //- ИнфоСофт Сумин Д.В. 06.07.2023 УА #60267 

//+ ИнфоСофт Сумин Д.В. 06.03.23 УА #55086
Функция ПолучитьРезультатПроверкиУчетаНДС(Организация) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|  НастройкиУчетаНДС.ПлательщикНДС КАК ПлательщикНДС
	|ИЗ
	|  РегистрСведений.НастройкиУчетаНДС.СрезПоследних(, ) КАК НастройкиУчетаНДС
	|ГДЕ
	|  НастройкиУчетаНДС.Организация = &Организация";
	
	Запрос.УстановитьПараметр("Организация", Организация);
	
	РезультатЗапроса = Запрос.Выполнить();  
	
	Если РезультатЗапроса.Пустой() Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Выборка = РезультатЗапроса.Выбрать();
	
	Выборка.Следующий();
	
	Возврат Выборка.ПлательщикНДС;
		
КонецФункции //- ИнфоСофт Сумин Д.В. 06.03.23 УА #55086 

//+ ИнфоСофт Мурсалимов Д.Р. 05.11.24 УА #85693
Функция ПолучитьТаблицуТоваровНабораNew(Профиль, Номенклатура, Характеристика) Экспорт
	
	ИспользуетсяЦенообразование25 = Константы.ИспользуетсяЦенообразование25.Получить();
		
	МассивПараметров = ИС_WB_Сервер.ПолучитьСписокПараметровЦен();
	
	Результат = ИС_MP_Сервер.ПолучитьЗначениеНастроек(Профиль, Перечисления.ИС_МП_Маркетплейсы.ВБ, МассивПараметров);
	
	СтруктураЦен = ИС_WB_Сервер.ПолучитьСтруктуруПараметровЦен();
	
	ЗаполнитьЗначенияСвойств(СтруктураЦен, Результат);
	
	ВидЦены = СтруктураЦен.ВидЦены;
	
	Запрос = Новый Запрос;	
	
	Если ИспользуетсяЦенообразование25 Тогда
		
		Текст =
		"ВЫБРАТЬ
		|	ВариантыКомплектацииНоменклатуры.Владелец КАК Набор,
		//+ ИнфоСофт Стояк Ю.К. 17.02.2025 УА #87941            
		|	ВариантыКомплектацииНоменклатуры.Характеристика КАК ХарактеристикаНабора,
		//- ИнфоСофт Стояк Ю.К. 17.02.2025 УА #87941
		|	ВариантыКомплектацииНоменклатурыТовары.Номенклатура КАК Номенклатура,
		|	ВЫБОР
		|		КОГДА ВидыНоменклатуры.НастройкиКлючаЦенПоХарактеристике = ЗНАЧЕНИЕ(Перечисление.ВариантОтбораДляКлючаЦен.НеИспользовать)
		//+ ИнфоСофт Стояк Ю.К. 15.01.2025 УА #91082				
		|			ТОГДА ЗНАЧЕНИЕ(Справочник.ХарактеристикиНоменклатурыДляЦенообразования.ПустаяСсылка)
		//|			ТОГДА ВариантыКомплектацииНоменклатурыТовары.Характеристика		
		//- ИнфоСофт Стояк Ю.К. 15.01.2025 УА #91082
