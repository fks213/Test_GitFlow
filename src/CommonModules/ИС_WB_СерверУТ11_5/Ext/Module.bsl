			МенеджерЗаписи.СкладМП = Выборка.СкладМП;
			//- ИнфоСофт Мурсалимов Д.Р. 23.04.25 УА #99629
			
			МенеджерЗаписи.Профиль = Выборка.Профиль;
			МенеджерЗаписи.ЗаказКлиента = Выборка.ЗаказКлиента;
			МенеджерЗаписи.ЗаказОткрыт = Ложь;
			
			МенеджерЗаписи.Записать();
			
			Если Не АвтоматическиСоздаватьРеализации Тогда
				Продолжить;	
			КонецЕсли;
			
			Если ПорядокОформленияНакладныхРасходныхОрдеров 
				= Перечисления.ПорядокОформленияНакладныхРасходныхОрдеров.СначалаНакладные Тогда
				
				СоздатьРеализациюПоЗакрытиюЗаказа(Профиль, Выборка.ЗаказКлиента);
				
				Если Выборка.АвтоматическиСоздаватьОрдерНаОтгрузку И Выборка.ЗаказКлиента.Склад.ИспользоватьОрдернуюСхемуПриОтгрузке Тогда		
					ИС_MP_РаботаСЗаказами.СоздатьРасходныйОрдер(Выборка.ЗаказКлиента
					, Выборка.СтатусРасходногоОрдера
					, Выборка.СтатусСтрокиРасходногоОрдера);	
				КонецЕсли;			
				
			Иначе
				
				Если Выборка.АвтоматическиСоздаватьОрдерНаОтгрузку И Выборка.ЗаказКлиента.Склад.ИспользоватьОрдернуюСхемуПриОтгрузке Тогда		
					ИС_MP_РаботаСЗаказами.СоздатьРасходныйОрдер(Выборка.ЗаказКлиента
