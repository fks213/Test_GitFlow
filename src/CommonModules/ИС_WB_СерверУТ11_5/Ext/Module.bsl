//+ ИнфоСофт Власова И.С. 14.03.25 УА #83865
Функция СоздатьИзменитьПретензиюКомиссионеру(Профиль, ДанныеЭлемента, ДопПараметры = Неопределено) Экспорт
	
	Если ТипЗнч(ДопПараметры) = Тип("Структура") И ДопПараметры.Свойство("СправочникСсылка") Тогда
		СправочникОбъект = ДопПараметры.СправочникСсылка.ПолучитьОбъект();
	Иначе	
		СправочникОбъект = Справочники.Претензии.СоздатьЭлемент();
	КонецЕсли;
	
	СправочникОбъект.ДатаРегистрации         = ДанныеЭлемента.ДатаРегистрации;
	СправочникОбъект.ДатаОкончания           = ДанныеЭлемента.ДатаРегистрации;
	СправочникОбъект.Комментарий             = ДанныеЭлемента.Комментарий;
	СправочникОбъект.Партнер                 = ДанныеЭлемента.Партнер;
	СправочникОбъект.Организация             = ДанныеЭлемента.Организация;
	СправочникОбъект.Контрагент              = ДанныеЭлемента.Контрагент;
	СправочникОбъект.Договор                 = ДанныеЭлемента.Договор;
	СправочникОбъект.Сумма                   = ДанныеЭлемента.Сумма;
	СправочникОбъект.ОписаниеПретензии       = ДанныеЭлемента.ОписаниеПретензии;
	СправочникОбъект.Наименование            = ?(ЗначениеЗаполнено(ДанныеЭлемента.Наименование),
												ДанныеЭлемента.Наименование,
												ДанныеЭлемента.ОписаниеПретензии);
	СправочникОбъект.ЭтоПретензияПоставщику  = ДанныеЭлемента.ЭтоПретензияПоставщику;
	СправочникОбъект.ВестиРасчетыПоПретензии = ДанныеЭлемента.ВестиРасчетыПоПретензии;
	СправочникОбъект.Ответственный           = Пользователи.АвторизованныйПользователь();
	СправочникОбъект.Статус                  = Перечисления.СтатусыПретензийКлиентов.Удовлетворена;
	
	СправочникОбъект.Валюта = ПолучитьВалютыЗаполненияДокумента(ДанныеЭлемента.Организация, ДанныеЭлемента.Договор, 
																Справочники.СоглашенияСКлиентами.ПустаяСсылка()).Валюта;
	
	Попытка		
		СправочникОбъект.Записать();		
	Исключение
		
		ТекстСообщения = "Не удалось записать претензию комиссионеру.";
		ТекстОшибки    = ОписаниеОшибки();
		ОбщегоНазначения.СообщитьПользователю(СтрШаблон("%1|%2", ТекстСообщения, ТекстОшибки));
		
		Возврат Неопределено;
		
	КонецПопытки;
	
	Возврат СправочникОбъект.Ссылка;
	
КонецФункции //- ИнфоСофт Власова И.С. 14.03.25 УА #83865

