	|	ВТ_Сопоставление.ЭтоНабор КАК ЭтоНабор,
	|	ВТ_Сопоставление.Упаковка КАК Упаковка,
	|	ВТ_Сопоставление.КоэффициентУпаковки КАК КоэффициентУпаковки,
	|	ВТ_ДанныеПродаж.ЦенаРеализация КАК ЦенаРеализация,
	|	ВТ_ДанныеПродаж.Кол_во КАК Кол_во,
	|	ВТ_ДанныеПродаж.ЦенаРозничная КАК ЦенаРозничная,
	|	ВТ_ДанныеПродаж.ВайлдберризРеализовалТовар_Пр_ КАК ВайлдберризРеализовалТовар_Пр_,
	|	ВТ_ДанныеПродаж.ТипДокумента КАК ТипДокумента,
	|	ВТ_ДанныеПродаж.ОбоснованиеДляОплаты КАК ОбоснованиеДляОплаты,
	|	ВТ_ДанныеПродаж.КПеречислениюПродавцуЗаРеализованныйТовар КАК КПеречислениюПродавцуЗаРеализованныйТовар,
	|	ВТ_ДанныеПродаж.УслугиПоДоставкеТовараПокупателю КАК УслугиПоДоставкеТовараПокупателю,
	|	ВТ_ДанныеПродаж.ВидыЛогистики_ШтрафовИДоплат КАК ВидыЛогистики_ШтрафовИДоплат,
	|	ВТ_ДанныеПродаж.Название КАК Название,
	|	ВТ_ДанныеПродаж.Баркод КАК Баркод,
	|	ВТ_ДанныеПродаж._ КАК _,
	|	ВТ_ДанныеПродаж.КодНоменклатуры КАК КодНоменклатуры,
	|	ВТ_ДанныеПродаж.АртикулПоставщика КАК АртикулПоставщика,
	|	ВТ_ДанныеПродаж.Размер КАК Размер,
	|	ВТ_ДанныеПродаж.Srid КАК Srid,
	|	ВТ_ДанныеПродаж.ВидОтчета КАК ВидОтчета
	|ИЗ
	|	ВТ_ДанныеПродаж КАК ВТ_ДанныеПродаж
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_Размеры КАК ВТ_Размеры
	|		ПО ВТ_ДанныеПродаж.Баркод = ВТ_Размеры.Баркод
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_Сопоставление КАК ВТ_Сопоставление
	|		ПО ВТ_ДанныеПродаж.Баркод = ВТ_Сопоставление.Баркод
	//+ ИнфоСофт Власова И.С. 19.02.25 УА #76703
	|ГДЕ
	|	%1
	//- ИнфоСофт Власова И.С. 19.02.25 УА #76703
	|
	|УПОРЯДОЧИТЬ ПО
	|	Номенклатура";
	//- ИнфоСофт Мурсалимов Д.Р. 08.10.24 УА #84956
	
	//+ ИнфоСофт Власова И.С. 19.02.25 УА #76703
	ТекстУсловия = "ИСТИНА";
	
	Если ВидОтчета = Перечисления.ИС_WB_ВидыОтчетов.Российский Тогда
		
		ТекстУсловия =
		    "НЕ ВЫРАЗИТЬ(ВТ_ДанныеПродаж.ТипДокумента КАК СТРОКА(100)) = """"
			|	И НЕ ВЫРАЗИТЬ(ВТ_ДанныеПродаж.АртикулПоставщика КАК СТРОКА(100)) = """" 
			|";	
	
	КонецЕсли;
	
	Запрос.Текст = СтрШаблон(Запрос.Текст, ТекстУсловия);
	//- ИнфоСофт Власова И.С. 19.02.25 УА #76703
	
	Запрос.УстановитьПараметр("Профиль", 		Профиль);
	Запрос.УстановитьПараметр("ДанныеПродаж", 	ДанныеПродаж);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Если РезультатЗапроса.Пустой() Тогда
		Возврат Неопределено;	
	КонецЕсли;	
	
	ДанныеПродаж.Очистить();
	
	Выборка = РезультатЗапроса.Выбрать();
	
	Пока Выборка.Следующий() Цикл
		НоваяСтрока = ДанныеПродаж.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, Выборка);	
	КонецЦикла;	
	
	Результат = Новый Структура;
	Результат.Вставить("НомерСтраницы", 2);
	Результат.Вставить("СписокТранзакций", ДанныеПродаж);
	
	Возврат Результат;
	
КонецФункции //+ ИнфоСофт Сумин Д.В. 28.02.2024 УА #71107

//+ ИнфоСофт Сумин Д.В. 06.03.2024 УА #71107
Функция ОбработатьИностранныеПродажи(ДанныеОбработки) Экспорт
	
	Профиль = ДанныеОбработки.СтруктураДанных.Профиль;
	
	ТаблицаРезультирующаяПродажи = ДанныеОбработки.СтруктураДанных.СписокТранзакций.Скопировать();
	ТаблицаРезультирующаяПродажи.Очистить();
	ТаблицаРезультирующаяПродажи.Колонки.Добавить("УпаковкаКоличество", Новый ОписаниеТипов("Число",,,Новый КвалификаторыЧисла(10, 2)));
	ТаблицаРезультирующаяПродажи.Колонки.Добавить("Количество", Новый ОписаниеТипов("Число",,,Новый КвалификаторыЧисла(10, 2)));
	
	ТаблицаРезультирующаяВозвраты = ДанныеОбработки.СтруктураДанных.СписокТранзакций.Скопировать();
	ТаблицаРезультирующаяВозвраты.Очистить();
	ТаблицаРезультирующаяВозвраты.Колонки.Добавить("УпаковкаКоличество", Новый ОписаниеТипов("Число",,,Новый КвалификаторыЧисла(10, 2)));
	ТаблицаРезультирующаяВозвраты.Колонки.Добавить("Количество", Новый ОписаниеТипов("Число",,,Новый КвалификаторыЧисла(10, 2)));
	ТаблицаРезультирующаяВозвраты.Колонки.Добавить("Основание", Новый ОписаниеТипов("ДокументСсылка.РеализацияТоваровУслуг"));
	
	ТаблицаРезультирующаяЛогистика = ДанныеОбработки.СтруктураДанных.СписокТранзакций.Скопировать();
	ТаблицаРезультирующаяЛогистика.Очистить();
	
	Для каждого Строка Из ДанныеОбработки.СтруктураДанных.СписокТранзакций Цикл
		
		Если Нрег(Строка.ОбоснованиеДляОплаты) = "логистика" Тогда

			НоваяСтрока = ТаблицаРезультирующаяЛогистика.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, Строка);													
				
		КонецЕсли;
		
		//+ ИнфоСофт Мурсалимов Д.Р. 09.10.24 УА #84814
		Если Нрег(Строка.ОбоснованиеДляОплаты) = "коррекция логистики" Тогда

			НоваяСтрока = ТаблицаРезультирующаяЛогистика.Добавить();
			
			Если Строка.УслугиПоДоставкеТовараПокупателю < 0 Тогда
				Строка.УслугиПоДоставкеТовараПокупателю = -Строка.УслугиПоДоставкеТовараПокупателю;
			КонецЕсли;
			
			ЗаполнитьЗначенияСвойств(НоваяСтрока, Строка);													
				
		КонецЕсли;                                
		//- ИнфоСофт Мурсалимов Д.Р. 09.10.24 УА #84814
		
		//+ ИнфоСофт Заварин К.В. 20.12.24 УА #90076
		Если Нрег(Строка.ОбоснованиеДляОплаты) = "корректировка эквайринга" Тогда

			НоваяСтрока = ТаблицаРезультирующаяЛогистика.Добавить();
			                                                                                        
			Строка.УслугиПоДоставкеТовараПокупателю = -Строка.КПеречислениюПродавцуЗаРеализованныйТовар;
									
			ЗаполнитьЗначенияСвойств(НоваяСтрока, Строка);													
				
		КонецЕсли;
		//- ИнфоСофт Заварин К.В. 20.12.24 УА #90076
		
		//+ ИнфоСофт Мурсалимов Д.Р. 31.10.24 УА #81932
		Если Нрег(Строка.ОбоснованиеДляОплаты) = "коррекция продаж" Тогда

			НоваяСтрока = ТаблицаРезультирующаяПродажи.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, Строка);	
			
			НоваяСтрока.УпаковкаКоличество = Строка.Кол_во * Строка.КоэффициентУпаковки;
			НоваяСтрока.Количество = Строка.Кол_во;
				
		КонецЕсли;
		//- ИнфоСофт Мурсалимов Д.Р. 31.10.24 УА #81932
		
		Если Нрег(Строка.ТипДокумента) = "продажа" И Нрег(Строка.ОбоснованиеДляОплаты) = "продажа" Тогда	
			
			НоваяСтрока = ТаблицаРезультирующаяПродажи.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, Строка);
 
			НоваяСтрока.УпаковкаКоличество = Строка.Кол_во * Строка.КоэффициентУпаковки;
			НоваяСтрока.Количество = Строка.Кол_во;

		ИначеЕсли Нрег(Строка.ТипДокумента) = "возврат" И Нрег(Строка.ОбоснованиеДляОплаты) = "возврат" Тогда

			НоваяСтрока = ТаблицаРезультирующаяВозвраты.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, Строка);
 
			НоваяСтрока.УпаковкаКоличество = Строка.Кол_во * Строка.КоэффициентУпаковки;
			НоваяСтрока.Количество = Строка.Кол_во;
			
		КонецЕсли;	
		
	КонецЦикла;	

	//+ ИнфоСофт Мурсалимов Д.Р. 19.09.24 УА #82106
	ВариантФормированияЦеныПродажи = ДанныеОбработки.СтруктураДанных.ВариантФормированияЦеныПродажи;
	
	ТаблицаРезультирующаяПродажи = ПолучитьСгруппированнуюТаблицуПродаж(ВариантФормированияЦеныПродажи, ТаблицаРезультирующаяПродажи);
	//- ИнфоСофт Мурсалимов Д.Р. 19.09.24 УА #82106
	
	//+ ИнфоСофт Мурсалимов Д.Р. 15.11.24 УА #86817
	ТаблицаРезультирующаяЛогистика.Свернуть("Srid, Номенклатура, Характеристика, АртикулПоставщика, Упаковка","УслугиПоДоставкеТовараПокупателю");
	//- ИнфоСофт Мурсалимов Д.Р. 15.11.24 УА #86817
		
	//Найдем документ продажи - основание по Srid для возврата
	ДокументыОснование = ПолучитьДокументыОснованияДляВозвратов(ТаблицаРезультирующаяВозвраты);
	
	//+ ИнфоСофт Заварин К.В. 01.11.24 УА #86746
	ДокументыОснованиеПродаж = ПолучитьДокументыОснованияДляВозвратов(ТаблицаРезультирующаяПродажи); 
	//- ИнфоСофт Заварин К.В. 01.11.24 УА #86746
	
	//+ ИнфоСофт Заварин К.В. 10.12.24 УА #88297
	//+ ИнфоСофт Мурсалимов Д.Р. 07.10.24 УА #84956
	//Рассчитаем итоговую сумму по продаже
	//Для Каждого Строка Из ТаблицаРезультирующаяПродажи Цикл
	//	
	//	СтруктураПоиска = Новый Структура;
	//	СтруктураПоиска.Вставить("Номенклатура", 	Строка.Номенклатура);
	//	СтруктураПоиска.Вставить("Характеристика", 	Строка.Характеристика);
	//	
	//	НайденныеСтроки = ТаблицаРезультирующаяЛогистика.НайтиСтроки(СтруктураПоиска);
	//	
	//	Для Каждого Элемент Из НайденныеСтроки Цикл
	//		
	//		//+ ИнфоСофт Мурсалимов Д.Р. 15.11.24 УА #86817
	//		Если Строка.КПеречислениюПродавцуЗаРеализованныйТовар - Элемент.УслугиПоДоставкеТовараПокупателю < 0 Тогда
	//			Продолжить;
	//		КонецЕсли;                                     
	//		//- ИнфоСофт Мурсалимов Д.Р. 15.11.24 УА #86817
	//		
	//		Строка.КПеречислениюПродавцуЗаРеализованныйТовар = Строка.КПеречислениюПродавцуЗаРеализованныйТовар - Элемент.УслугиПоДоставкеТовараПокупателю; 
	//		
	//		ТаблицаРезультирующаяЛогистика.Удалить(Элемент); 
	//	
	//	КонецЦикла;
	//	
	//КонецЦикла;
	//- ИнфоСофт Заварин К.В. 10.12.24 УА #88297
	
	Для Каждого Строка Из ТаблицаРезультирующаяПродажи Цикл
		
		СтруктураПоиска = Новый Структура;
		СтруктураПоиска.Вставить("АртикулПоставщика", 	Строка.АртикулПоставщика);
			
		НайденныеСтроки = ТаблицаРезультирующаяЛогистика.НайтиСтроки(СтруктураПоиска);
		
		Для Каждого Элемент Из НайденныеСтроки Цикл
			
			//+ ИнфоСофт Мурсалимов Д.Р. 15.11.24 УА #86817
			Если Строка.КПеречислениюПродавцуЗаРеализованныйТовар - Элемент.УслугиПоДоставкеТовараПокупателю < 0 Тогда
				Продолжить;
			КонецЕсли;                                     
			//- ИнфоСофт Мурсалимов Д.Р. 15.11.24 УА #86817
			
			Строка.КПеречислениюПродавцуЗаРеализованныйТовар = Строка.КПеречислениюПродавцуЗаРеализованныйТовар - Элемент.УслугиПоДоставкеТовараПокупателю; 
			
			ТаблицаРезультирующаяЛогистика.Удалить(Элемент);
		
		КонецЦикла;
		
	КонецЦикла;
	
	//+ ИнфоСофт Заварин К.В. 09.12.24 УА #88297
	Если ТаблицаРезультирующаяЛогистика.Количество() > 0 Тогда
		
		Для Каждого Строка Из ТаблицаРезультирующаяПродажи Цикл
			
			СтруктураПоиска = Новый Структура;
			СтруктураПоиска.Вставить("АртикулПоставщика", 	Строка.АртикулПоставщика);
			
			НайденныеСтроки = ТаблицаРезультирующаяЛогистика.НайтиСтроки(СтруктураПоиска);
			Если НайденныеСтроки.Количество() > 0 Тогда
				
				
				СуммаЛогистики = 0;
				
				Для Индекс = 0 По НайденныеСтроки.ВГраница() Цикл
					СуммаЛогистики = СуммаЛогистики + НайденныеСтроки[Индекс].УслугиПоДоставкеТовараПокупателю;
				КонецЦикла; 
				
				МассивКоэффициентов = Новый Массив;
				
				Для Каждого СтрокаМассив Из ТаблицаРезультирующаяПродажи Цикл
					
					Если НайденныеСтроки[0].АртикулПоставщика = СтрокаМассив.АртикулПоставщика Тогда
						МассивКоэффициентов.Добавить(1);	
					КонецЕсли;
					
				КонецЦикла;
				
				МассивНастроек = ОбщегоНазначения.РаспределитьСуммуПропорциональноКоэффициентам(СуммаЛогистики, МассивКоэффициентов);
				
				НераспределеннаяСумма = СуммаЛогистики; 
				
				ТаблицаРезультирующаяПродажиПоАртикулу =  ТаблицаРезультирующаяПродажи.НайтиСтроки(СтруктураПоиска);
				
				//+ ИнфоСофт Заварин К.В. 16.12.24 УА #89659
				ПовторнаяСумма = 0; 
				КоличествоПовторов = 0;
				//- ИнфоСофт Заварин К.В. 16.12.24 УА #89659
				
				Пока НераспределеннаяСумма > 0 Цикл
					
					//+ ИнфоСофт Заварин К.В. 16.12.24 УА #89659
					Если ПовторнаяСумма = НераспределеннаяСумма Тогда
						КоличествоПовторов = КоличествоПовторов + 1;
					Иначе
						КоличествоПовторов = 0;	
					КонецЕсли; 
					
					Если КоличествоПовторов > 3 Тогда
						Прервать;	
					КонецЕсли;
					
					ПовторнаяСумма = НераспределеннаяСумма;
					//- ИнфоСофт Заварин К.В. 16.12.24 УА #89659
					
					Итератор = 0;
					
					Для Каждого СтрокаПродаж Из ТаблицаРезультирующаяПродажиПоАртикулу Цикл
						
						Если НайденныеСтроки[0].АртикулПоставщика = СтрокаПродаж.АртикулПоставщика Тогда  
							
							СуммаУслугиСтроки = МассивНастроек[Итератор];
							
							Если СтрокаПродаж.КПеречислениюПродавцуЗаРеализованныйТовар - СуммаУслугиСтроки >= 0 Тогда 		
								
								СтрокаПродаж.КПеречислениюПродавцуЗаРеализованныйТовар = СтрокаПродаж.КПеречислениюПродавцуЗаРеализованныйТовар - СуммаУслугиСтроки;		
								
								НераспределеннаяСумма = НераспределеннаяСумма - СуммаУслугиСтроки;
								
							КонецЕсли;     
							
							Итератор = Итератор + 1;
							
						КонецЕсли;
						
					КонецЦикла;
					
					МассивНастроек = ОбщегоНазначения.РаспределитьСуммуПропорциональноКоэффициентам(НераспределеннаяСумма, МассивКоэффициентов);
					
				КонецЦикла;
				
				Для Индекс = 0 По НайденныеСтроки.ВГраница() Цикл
					ТаблицаРезультирующаяЛогистика.Удалить(НайденныеСтроки[Индекс]);
				КонецЦикла;
			КонецЕсли;
		КонецЦикла;
		
	КонецЕсли;
	//- ИнфоСофт Заварин К.В. 09.12.24 УА #88297
	
	ПолностьюРаспределятьЛогистику = ДанныеОбработки.СтруктураДанных.ПолностьюРаспределятьЛогистику;
	
	Если ПолностьюРаспределятьЛогистику И ТаблицаРезультирующаяЛогистика.Количество() > 0 Тогда
		
