	|ГДЕ
	|	ИС_MP_ЗаказыОтчетаКомиссионера.ИдентификаторМП = &Srid
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ПередачаТоваровХранителю.Ссылка КАК РТУ
	|ПОМЕСТИТЬ ВТ_РТУ
	|ИЗ
	|	ВТ_Заказ КАК ВТ_Заказ
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ПередачаТоваровХранителю КАК ПередачаТоваровХранителю
	|		ПО ВТ_Заказ.Заказ1С = ПередачаТоваровХранителю.ЗаказКлиента
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	РеализацияТоваровУслуг.Ссылка
	|ИЗ
	|	ВТ_Заказ КАК ВТ_Заказ
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.РеализацияТоваровУслуг КАК РеализацияТоваровУслуг
	|		ПО ВТ_Заказ.Заказ1С = РеализацияТоваровУслуг.ЗаказКлиента
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ ПЕРВЫЕ 1
	|	ВТ_РТУ.РТУ КАК РТУ
	|ИЗ
	|	ВТ_РТУ КАК ВТ_РТУ
	|ГДЕ
	|	НЕ ВТ_РТУ.РТУ ЕСТЬ NULL";

	Запрос.УстановитьПараметр("Srid", Srid);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		
		РТУ = Выборка.РТУ;
		
	КонецЦикла;
	
	Возврат РТУ;
	
