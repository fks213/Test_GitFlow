	//- ИнфоСофт Мурсалимов Д.Р. 31.10.24 УА #86238
	
	Документ.ЦенаВключаетНДС = Истина;
	Документ.Партнер = Профиль.Партнер;
	Документ.Контрагент = Профиль.Контрагент;
	Документ.Соглашение = Профиль.Соглашение;
	Документ.ХозяйственнаяОперация = Перечисления.ХозяйственныеОперации.ВозвратОтКомиссионера; 
	Документ.Организация = Профиль.Организация;
	Документ.Договор = Профиль.Договор;
	Документ.Комментарий = ЗаголовокСтруктура.Комментарий;
	Документ.Склад = Профиль.Склад; 
	Документ.ВариантПриемкиТоваров = Перечисления.ВариантыПриемкиТоваров.РазделенаПоЗаказамИНакладным;
	//+ ИнфоСофт Сумин Д.В. 22.03.2024 УА #70680	
