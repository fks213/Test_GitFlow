Функция ПолучитьВалютыЗаполненияДокумента(Организация, Договор, Соглашение) Экспорт
	
	Валюты = Новый Структура;
	
	Валюта               = Константы.ВалютаРегламентированногоУчета.Получить();
	ВалютаВзаиморасчетов = Валюта;
	
	Если ЗначениеЗаполнено(Соглашение) Тогда 
		
		РеквизитыСоглашения = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Соглашение, 
			"ИспользуютсяДоговорыКонтрагентов, Валюта, ВалютаВзаиморасчетов");
		
		Валюта = РеквизитыСоглашения.Валюта;
		
		Если РеквизитыСоглашения.ИспользуютсяДоговорыКонтрагентов Тогда	
			ВалютаВзаиморасчетов = Валюта;	
		Иначе		
			ВалютаВзаиморасчетов = РеквизитыСоглашения.ВалютаВзаиморасчетов;	
		КонецЕсли;
		
	ИначеЕсли ЗначениеЗаполнено(Договор) Тогда		
		ВалютаВзаиморасчетов = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Договор, "ВалютаВзаиморасчетов");	
	КонецЕсли;
	
	Валюты.Вставить("Валюта",               Валюта);
	Валюты.Вставить("ВалютаВзаиморасчетов", ВалютаВзаиморасчетов);
	
	Возврат Валюты;
	
КонецФункции //- ИнфоСофт Власова И.С. 14.03.25 УА #68471

