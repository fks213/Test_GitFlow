Функция ПолучитьСтруктуруКорректировкиЗадолженности() Экспорт

	СтруктураДокумента = Новый Структура;
	
	СтруктураДокумента.Вставить("Дата");
	СтруктураДокумента.Вставить("Комментарий");
	СтруктураДокумента.Вставить("Организация");
	СтруктураДокумента.Вставить("Контрагент");
	СтруктураДокумента.Вставить("Договор");
	СтруктураДокумента.Вставить("Соглашение");
	СтруктураДокумента.Вставить("ХозяйственнаяОперация");
	СтруктураДокумента.Вставить("КорреспонденцияСДоходами");
	
	ЗадолженностьТЧ = Новый ТаблицаЗначений;
	ЗадолженностьТЧ.Колонки.Добавить("ТипРасчетов");
	ЗадолженностьТЧ.Колонки.Добавить("Партнер");
	ЗадолженностьТЧ.Колонки.Добавить("ВалютаВзаиморасчетов");
	ЗадолженностьТЧ.Колонки.Добавить("Сумма");
	
	СтруктураДокумента.Вставить("Задолженность", ЗадолженностьТЧ);
	
	ДоходыРасходыАктивыПассивыТЧ = Новый ТаблицаЗначений;
	ДоходыРасходыАктивыПассивыТЧ.Колонки.Добавить("Статья");
	ДоходыРасходыАктивыПассивыТЧ.Колонки.Добавить("Подразделение");
	ДоходыРасходыАктивыПассивыТЧ.Колонки.Добавить("Валюта");
	ДоходыРасходыАктивыПассивыТЧ.Колонки.Добавить("Сумма");
	
	СтруктураДокумента.Вставить("ДоходыРасходыАктивыПассивы", ДоходыРасходыАктивыПассивыТЧ);
	
	Возврат СтруктураДокумента;
	
КонецФункции //- ИнфоСофт Власова И.С. 14.03.25 УА #68471

