	НастройкиУчета = УчетНДСУП.ПараметрыУчетаПоОрганизации(Профиль.Организация, ТекущаяДатаСеанса());
	Документ.НалогообложениеНДС = НастройкиУчета.ОсновноеНалогообложениеНДСПродажи;
	
	Если Документ.НалогообложениеНДС = Перечисления.ТипыНалогообложенияНДС.ПродажаОблагаетсяНДС 	
		Или Документ.НалогообложениеНДС = Перечисления.ТипыНалогообложенияНДС.ЛьготноеНалогообложениеНДСНаУСН Тогда
		ПродажаОблагаетсяНДС = Истина;
	Иначе
		ПродажаОблагаетсяНДС = Ложь;
