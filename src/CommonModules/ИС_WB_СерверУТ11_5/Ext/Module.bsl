				НоваяСтрока.ХарактеристикаНабора = ЭлементНабора.ХарактеристикаНабора;
				//- ИнфоСофт Стояк Ю.К. 17.02.2025 УА #87941				
				НоваяСтрока.Склад = Документ.Склад;
				НоваяСтрока.Номенклатура = ЭлементНабора.Номенклатура;
				НоваяСтрока.Характеристика = ЭлементНабора.Характеристика;
				НоваяСтрока.Количество = ЭлементНабора.КоличествоУпаковок;
				НоваяСтрока.КоличествоУпаковок = ЭлементНабора.КоличествоУпаковок; 
				НоваяСтрока.Цена = СуммыПродажи[0] / НоваяСтрока.Количество; 
				НоваяСтрока.Сумма = СуммыПродажи[0]; 
				//+ ИнфоСофт Сумин Д.В. 29.05.23 УА #59046  
				НоваяСтрока.Упаковка = ЭлементНабора.Номенклатура.ЕдиницаИзмерения;
				//+ ИнфоСофт Сумин Д.В. 29.05.23 УА #59046
				
