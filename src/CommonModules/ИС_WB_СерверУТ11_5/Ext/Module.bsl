//+ ИнфоСофт Сумин Д.В. 02.03.23 УА #55086
Функция РассчитатьКоэффициентыИзЦен(МассивЦен, Номенклатура) Экспорт 
	
	СуммаВсехЭлементов = 0;
	Для Каждого Элемент из МассивЦен Цикл
		СуммаВсехЭлементов = СуммаВсехЭлементов + Элемент;	
	КонецЦикла;
	
	Если СуммаВсехЭлементов = 0 Тогда
		ВызватьИсключение("Для комплектующих набора: " + Номенклатура + " не установлены цены.");	
	КонецЕсли;
	
	МассивКоэццициентов = Новый Массив;
	
	Для Каждого Элемент из МассивЦен Цикл
		Коэффициент = Элемент * 100 / СуммаВсехЭлементов;
		МассивКоэццициентов.Добавить(Коэффициент);
	КонецЦикла;
	
	Возврат МассивКоэццициентов; 
	
КонецФункции //- ИнфоСофт Сумин Д.В. 02.03.23 УА #55086	

//+ ИнфоСофт Сумин Д.В. 03.03.23 УА #55086
Функция СоздатьДокументРеализацияУслуг(Профиль, Брак, ЗаголовокСтруктура) Экспорт
	
	ПродажаОблагаетсяНДС = ПолучитьРезультатПроверкиУчетаНДС(Профиль.Организация); 
	
	ДокУслуги = Документы.РеализацияУслугПрочихАктивов.СоздатьДокумент();
	ДокУслуги.ХозяйственнаяОперация = Перечисления.ХозяйственныеОперации.РеализацияКлиенту;
	ДокУслуги.Организация = Профиль.Организация; 	
	ДокУслуги.Партнер = Профиль.Партнер; 
	ДокУслуги.Контрагент = Профиль.ДоговорРеализации.Контрагент;		  
	ДокУслуги.Валюта = Справочники.Валюты.НайтиПоКоду("643");
	ДокУслуги.ВалютаВзаиморасчетов = Справочники.Валюты.НайтиПоКоду("643");	
	ДокУслуги.Менеджер = ПользователиКлиентСервер.ТекущийПользователь();
	ДокУслуги.Подразделение = Профиль.Подразделение;
	ДокУслуги.ДатаПлатежа = ЗаголовокСтруктура.ДатаДокумента;
	
	Если ИС_WB_Сервер.ЗначениеРеквизитаОбъектаТипаБулево(Профиль.СоглашениеРеализации, "ИспользуютсяДоговорыКонтрагентов") Тогда
		ДокУслуги.Договор = Профиль.ДоговорРеализации;
		ДокУслуги.ПорядокРасчетов = Профиль.ДоговорРеализации.ПорядокРасчетов; 
		ДокУслуги.Соглашение = Профиль.СоглашениеРеализации; 
	Иначе
		ДокУслуги.Соглашение = Профиль.СоглашениеРеализации;
		ДокУслуги.ПорядокРасчетов = Профиль.СоглашениеРеализации.ПорядокРасчетов;
	КонецЕсли;
	
	ДокУслуги.ЦенаВключаетНДС = Истина; 
	
	Если ПродажаОблагаетсяНДС Тогда 		
		ДокУслуги.НалогообложениеНДС = Перечисления.ТипыНалогообложенияНДС.ПродажаОблагаетсяНДС; 
	Иначе
		ДокУслуги.НалогообложениеНДС = Перечисления.ТипыНалогообложенияНДС.ПродажаНеОблагаетсяНДС;			
	КонецЕсли; 
		
	ДокУслуги.Дата = ЗаголовокСтруктура.ДатаДокумента;				  
	ДокУслуги.Комментарий = ЗаголовокСтруктура.Комментарий + " Оплата брака/Частичная компенсация брака";
	
	Если Брак.СуммаБрака > 0 Тогда   
		
		НоваяСтрока = ДокУслуги.Доходы.Добавить();
		НоваяСтрока.Содержание = "Оплата брака";
		НоваяСтрока.Количество = 1; 
		
		Если ПродажаОблагаетсяНДС Тогда 
			НоваяСтрока.СтавкаНДС = Справочники.СтавкиНДС.НайтиПоНаименованию("20%", Истина);	
			НДС = ИС_MP_РаботаСЗаказами.ПолучитьПроцентНДС(НоваяСтрока.СтавкаНДС);
			
			Если НДС = Неопределено Или НДС = 0 Тогда 
				НоваяСтрока.СуммаНДС = 0;		
			Иначе
				НоваяСтрока.СуммаНДС = РассчитатьСуммуНДС(Брак.СуммаБрака, НДС, Истина);
			КонецЕсли;	
		Иначе
			НоваяСтрока.СтавкаНДС = Справочники.СтавкиНДС.БезНДС;
		КонецЕсли;
		
		НоваяСтрока.Цена = Брак.СуммаБрака;  		
		НоваяСтрока.Сумма = НоваяСтрока.Цена;
		НоваяСтрока.СтатьяДоходов = Профиль.СтатьяДоходовОплатаБрака; 
		НоваяСтрока.СуммаСНДС = НоваяСтрока.Сумма;
		
	ИначеЕсли Брак.ЧастичнаяКомпенсацияСумма > 0 Тогда
		
		НоваяСтрока = ДокУслуги.Доходы.Добавить();
		НоваяСтрока.Содержание = "Частичная компенсация брака";
		НоваяСтрока.Количество = 1; 
		
		Если ПродажаОблагаетсяНДС Тогда 
			НоваяСтрока.СтавкаНДС = Справочники.СтавкиНДС.НайтиПоНаименованию("20%", Истина);	
			НДС = ИС_MP_РаботаСЗаказами.ПолучитьПроцентНДС(НоваяСтрока.СтавкаНДС);
			
			Если НДС = Неопределено Или НДС = 0 Тогда 
				НоваяСтрока.СуммаНДС = 0;		
			Иначе
				НоваяСтрока.СуммаНДС = РассчитатьСуммуНДС(Брак.ЧастичнаяКомпенсацияСумма, НДС, Истина);
			КонецЕсли;	
		Иначе
			НоваяСтрока.СтавкаНДС = Справочники.СтавкиНДС.БезНДС;
		КонецЕсли;
		
		НоваяСтрока.Цена = Брак.ЧастичнаяКомпенсацияСумма;  		
		НоваяСтрока.Сумма = НоваяСтрока.Цена;
		НоваяСтрока.СтатьяДоходов = Профиль.СтатьяДоходовОплатаБрака; 
		НоваяСтрока.СуммаСНДС = НоваяСтрока.Сумма;
		
	КонецЕсли;
	
	Попытка
		ДокУслуги.Записать(РежимЗаписиДокумента.Проведение); 
	Исключение
		ДокУслуги.Записать();
	КонецПопытки; 
	//ДокУслуги.Записать(РежимЗаписиДокумента.Проведение); 
	//- ИнфоСофт Сумин Д.В. 27.03.23 УА #56728
	
	Возврат ДокУслуги;
	
КонецФункции //- ИнфоСофт Сумин Д.В. 03.03.23 УА #55086	

//+ ИнфоСофт Стояк Ю.К. 05.05.2023 УА #58008
Функция СоздатьДокументПриобретенияУслуг(Профиль, Брак, ЗаголовокСтруктура) Экспорт
	
	ПродажаОблагаетсяНДС = ПолучитьРезультатПроверкиУчетаНДС(Профиль.Организация); 
	
	ДокУслуги = Документы.ПриобретениеУслугПрочихАктивов.СоздатьДокумент();
	ДокУслуги.Дата = ЗаголовокСтруктура.ДатаДокумента;	
	ДокУслуги.ХозяйственнаяОперация = Перечисления.ХозяйственныеОперации.ЗакупкаУПоставщика;
	ДокУслуги.Организация = Профиль.Организация;
	ДокУслуги.Партнер = Профиль.Партнер;	
	ДокУслуги.Контрагент = Профиль.ДоговорЗакупки.Контрагент;
	Комментарий = "Отчет номер " + ЗаголовокСтруктура.Комментарий; 	
	ДокУслуги.Валюта = Справочники.Валюты.НайтиПоКоду("643");	
	ДокУслуги.ВалютаВзаиморасчетов = Справочники.Валюты.НайтиПоКоду("643");	
	ДокУслуги.ЦенаВключаетНДС = Истина;

	
	Если ИС_WB_Сервер.ЗначениеРеквизитаОбъектаТипаБулево(Профиль.СоглашениеЗакупки, "ИспользуютсяДоговорыКонтрагентов") Тогда
		ДокУслуги.Договор = Профиль.ДоговорЗакупки;		
		ДокУслуги.Соглашение = Профиль.СоглашениеЗакупки; 	
	Иначе
		ДокУслуги.Соглашение = Профиль.СоглашениеЗакупки;
	КонецЕсли;
	
	ДокУслуги.ЦенаВключаетНДС = Истина; 	 
	
	Если ПродажаОблагаетсяНДС Тогда 		
		ДокУслуги.НалогообложениеНДС = Перечисления.ТипыНалогообложенияНДС.ПродажаОблагаетсяНДС;     
		ДокУслуги.ЗакупкаПодДеятельность = Перечисления.ТипыНалогообложенияНДС.ПродажаОблагаетсяНДС; 
	Иначе
		ДокУслуги.НалогообложениеНДС = Перечисления.ТипыНалогообложенияНДС.ПродажаНеОблагаетсяНДС;			
		ДокУслуги.ЗакупкаПодДеятельность = Перечисления.ТипыНалогообложенияНДС.ПродажаНеОблагаетсяНДС; 
	КонецЕсли; 
	
	ДокУслуги.Комментарий = ЗаголовокСтруктура.Комментарий + " Частичная компенсация брака";
	
	НоваяСтрока = ДокУслуги.Расходы.Добавить();
	НоваяСтрока.Содержание = "Частичная компенсация брака";
	НоваяСтрока.Количество = 1; 
	
	Если ПродажаОблагаетсяНДС Тогда 
		НоваяСтрока.СтавкаНДС = Справочники.СтавкиНДС.НайтиПоНаименованию("20%");	
		НДС = ИС_MP_РаботаСЗаказами.ПолучитьПроцентНДС(НоваяСтрока.СтавкаНДС);
		
		Если НДС = Неопределено Или НДС = 0 Тогда 
			НоваяСтрока.СуммаНДС = 0;		
		Иначе
			НоваяСтрока.СуммаНДС = РассчитатьСуммуНДС(-Брак.ЧастичнаяКомпенсацияСумма, НДС, Истина);
		КонецЕсли;	
	Иначе
		НоваяСтрока.СтавкаНДС = Справочники.СтавкиНДС.БезНДС;
	КонецЕсли;
	
	НоваяСтрока.Цена = -Брак.ЧастичнаяКомпенсацияСумма;  		
	НоваяСтрока.Сумма = НоваяСтрока.Цена;                           
	НоваяСтрока.Подразделение = Профиль.Подразделение; 
	НоваяСтрока.СтатьяРасходов = Профиль.СтатьяРасходовОплатаБрака; 
	НоваяСтрока.СуммаСНДС = НоваяСтрока.Сумма;
	
	
	ДокУслуги.Записать();
	
	Возврат ДокУслуги;
	
КонецФункции //- ИнфоСофт Стояк Ю.К. 05.05.2023 УА #58008

//+ ИнфоСофт Сумин Д.В. 04.03.23 УА #55086
Функция СоздатьДокументПриобретения(Профиль, ДанныеДокумента, ЗаголовокСтруктура) Экспорт  
	
	Документ = Документы.ПриобретениеТоваровУслуг.СоздатьДокумент();
	
	Документ.Дата = ЗаголовокСтруктура.ДатаДокумента;
	Документ.Автор = ПользователиКлиентСервер.ТекущийПользователь();
	Документ.ХозяйственнаяОперация = Перечисления.ХозяйственныеОперации.ЗакупкаУПоставщика;
	Документ.Организация = Профиль.Организация;
	Документ.Партнер = Профиль.Партнер;	
	Документ.Контрагент = Профиль.Контрагент;
	Комментарий = "Отчет номер " + ЗаголовокСтруктура.Комментарий;
	Документ.ЗакупкаПодДеятельность = Перечисления.ТипыНалогообложенияНДС.ПродажаОблагаетсяНДС;  
	Документ.ВариантПриемкиТоваров = Перечисления.ВариантыПриемкиТоваров.РазделенаПоЗаказамИНакладным; 
	
	//+ ИнфоСофт Сумин Д.В. 21.11.2023 УА #61641
	Если ЗначениеЗаполнено(Профиль.ДоговорЗакупки) Тогда
		Валюта = Профиль.ДоговорЗакупки.ВалютаВзаиморасчетов;
	Иначе
		Валюта = Профиль.Договор.ВалютаВзаиморасчетов;
	КонецЕсли;	
	//Валюта = Профиль.ДоговорЗакупки.ВалютаВзаиморасчетов;
	//- ИнфоСофт Сумин Д.В. 21.11.2023 УА #61641
	
	Документ.Валюта = Валюта;
	Документ.ВалютаВзаиморасчетов = Валюта;
	Документ.СпособДоставки = Перечисления.СпособыДоставки.СиламиПоставщикаДоНашегоСклада;  
	Документ.Договор = Профиль.ДоговорЗакупки;
	Документ.Соглашение = Профиль.СоглашениеЗакупки;
	
	Документ.НалогообложениеНДС = Перечисления.ТипыНалогообложенияНДС.ПродажаОблагаетсяНДС; 		
	
	СуммаДокумента = 0;
	
	//+ ИнфоСофт Власова И.С. 22.08.24 УА #61503
	РаспределятьРасходыПоАртикулам = Профиль.РаспределятьРасходыПоАртикулам;
	//- ИнфоСофт Власова И.С. 22.08.24 УА #61503
	
	//+ ИнфоСофт Мурсалимов Д.Р. 28.02.25 УА #93329
	////+ ИнфоСофт Заварин К.В. 01.10.24 УА #61499
	//ПрименениеНДС = ИС_MP_Сервер.ПолучитьПрименениеНДСОрганизации(Профиль.Организация);
	////- ИнфоСофт Заварин К.В. 01.10.24 УА #61499
	ПрименениеНДС = ИС_МП_УправлениеЗаказами.ПолучитьПрименениеНДСОрганизации(Профиль.Организация);
	//- ИнфоСофт Мурсалимов Д.Р. 28.02.25 УА #93329
	
	Для Каждого Элемент Из ДанныеДокумента Цикл 
		
		Если Элемент.Сумма = 0 Тогда
			Продолжить;
		КонецЕсли;
		
		Если Элемент.УслугаWildberries = Справочники.Номенклатура.ПустаяСсылка() Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(
			СтрШаблон("Отсутствует сопоставление для услуги %1, строка не будет добавлена", Элемент.Услуга)); 
			Продолжить;	
		КонецЕсли;	
		
		ЭлементТЧ = Документ.Товары.Добавить();
		//+ ИнфоСофт Власова И.С. 22.08.24 УА #61503
		//ЭлементТЧ.Номенклатура = Элемент.УслугаWildberries.Номенклатура;
		ЭлементТЧ.Номенклатура = Элемент.Номенклатура;
		//- ИнфоСофт Власова И.С. 22.08.24 УА #61503
		ЭлементТЧ.Количество = 1;
		ЭлементТЧ.КоличествоУпаковок = 1;
		ЭлементТЧ.Цена = Элемент.Сумма;
		ЭлементТЧ.СписатьНаРасходы = Истина;
		//+ ИнфоСофт Власова И.С. 22.08.24 УА #61503
		//ЭлементТЧ.СтатьяРасходов = Элемент.УслугаWildberries.СтатьяРасходов;
		ЭлементТЧ.СтатьяРасходов = Элемент.СтатьяРасходов;
		//- ИнфоСофт Власова И.С. 22.08.24 УА #61503
		
		//+ ИнфоСофт Заварин К.В. 01.10.24 УА #61499
		//ЭлементТЧ.СуммаНДС = Элемент.НДС; 
		//ЭлементТЧ.СуммаСНДС = Элемент.НДС + Элемент.Сумма; 	
		//ЭлементТЧ.СтавкаНДС = Элемент.СтавкаНДС; 
		//СуммаДокумента = СуммаДокумента + Элемент.НДС + Элемент.Сумма; 
		//ЭлементТЧ.Сумма = Элемент.Сумма;
		Если ПрименениеНДС Тогда
			ЭлементТЧ.СуммаНДС = Элемент.НДС; 
			ЭлементТЧ.СуммаСНДС = Элемент.НДС + Элемент.Сумма; 	
			ЭлементТЧ.СтавкаНДС = Элемент.СтавкаНДС; 
			СуммаДокумента = СуммаДокумента + Элемент.НДС + Элемент.Сумма; 
			ЭлементТЧ.Сумма = Элемент.Сумма;
		Иначе   
			ЭлементТЧ.Цена = Элемент.Сумма + Элемент.НДС;
			ЭлементТЧ.СуммаНДС = 0; 
			ЭлементТЧ.СуммаСНДС = Элемент.НДС + Элемент.Сумма; 	
			ЭлементТЧ.СтавкаНДС = Элемент.СтавкаНДС; 
			СуммаДокумента = СуммаДокумента + Элемент.НДС + Элемент.Сумма; 
			ЭлементТЧ.Сумма = Элемент.НДС + Элемент.Сумма;
		КонецЕсли;
		//- ИнфоСофт Заварин К.В. 01.10.24 УА #61499
		
		ЭлементТЧ.Подразделение = Профиль.Подразделение;	
		
		//+ ИнфоСофт Власова И.С. 22.08.24 УА #61503
		//Комментарий = Комментарий + "/" + Элемент.УслугаWildberries.Наименование
		Если Не РаспределятьРасходыПоАртикулам Тогда
			Комментарий = Комментарий + "/" + Элемент.УслугаWildberries.Наименование;
		КонецЕсли;
		
		ЭлементТЧ.АналитикаРасходов = Элемент.АналитикаРасходов;
		//- ИнфоСофт Власова И.С. 22.08.24 УА #61503
		
	КонецЦикла;	
	
	Документ.Комментарий = Комментарий;
	
	Документ.СуммаДокумента = СуммаДокумента;
	
	Если Документ.Товары.Количество() = 0 Тогда
		Возврат Неопределено;		
	КонецЕсли;
	
	//+ ИнфоСофт Сумин Д.В. 27.03.23 УА #56728
	Попытка
		Документ.Записать(РежимЗаписиДокумента.Проведение); 
	Исключение
		Документ.Записать();
	КонецПопытки; 
	//Документ.Записать(РежимЗаписиДокумента.Проведение); 
	//- ИнфоСофт Сумин Д.В. 27.03.23 УА #56728
	
	Возврат Документ.Ссылка;
	
КонецФункции //- ИнфоСофт Сумин Д.В. 04.03.23 УА #55086 

//+ ИнфоСофт Сумин Д.В. 04.03.23 УА #55086
Функция СоздатьДокументВзаимозачетЗадолженности(Профиль, ДокументПриобретения, ОтчетКомиссионера) Экспорт  
	
	ДокументВзаимозачет = Документы.ВзаимозачетЗадолженности.СоздатьДокумент();
	
	ДокументВзаимозачет.Дата = ОтчетКомиссионера.Дата;
	ДокументВзаимозачет.Организация = Профиль.Организация; 
	//+ ИнфоСофт Сумин Д.В. 07.04.23 УА #56896
	ДокументВзаимозачет.КонтрагентДебитор = Профиль.Контрагент;
	ДокументВзаимозачет.КонтрагентКредитор = Профиль.Контрагент; 
	//Если ПолучитьФункциональнуюОпцию("ИспользоватьПартнеровИКонтрагентов") Тогда
	//	ДокументВзаимозачет.КонтрагентДебитор = Профиль.Контрагент;
	//	ДокументВзаимозачет.КонтрагентКредитор = Профиль.Контрагент;
	//Иначе 
	//	ДокументВзаимозачет.КонтрагентДебитор = Профиль.Партнер; 
	//	ДокументВзаимозачет.КонтрагентКредитор = Профиль.Партнер; 
