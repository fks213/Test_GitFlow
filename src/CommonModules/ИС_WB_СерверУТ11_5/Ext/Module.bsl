Функция СоздатьПередачуТоваровНаХранение(Профиль, Данные, ЗаголовокСтруктура) Экспорт 
	
	Документ = Документы.ПередачаТоваровХранителю.СоздатьДокумент();
			
	ОблагаетсяНДС = ПолучитьРезультатПроверкиУчетаНДС(Профиль.Организация);
	
	Документ.Организация = Профиль.Организация;
	Документ.Партнер = Профиль.Партнер;
	Документ.Контрагент = Профиль.Контрагент;
	Документ.Соглашение = Профиль.Соглашение;
	Документ.Договор = Профиль.Договор;
	Документ.Валюта = Документ.Договор.ВалютаВзаиморасчетов;
	Документ.Склад = Профиль.Склад;
	Документ.Комментарий = ЗаголовокСтруктура.Комментарий;
	Документ.ХозяйственнаяОперация = Перечисления.ХозяйственныеОперации.ПередачаНаКомиссию;
	
	//+ ИнфоСофт Конышев А.Е. 26.11.24 УА #88616
	Документ.Дата = ЗаголовокСтруктура.НачалоПериода + 1;
	//+ ИнфоСофт Мурсалимов Д.Р. 31.10.24 УА #86238                                                               
	//Документ.Дата = ЗаголовокСтруктура.НачалоПериода;
	//Документ.Дата = ЗаголовокСтруктура.ДатаДокумента;
	//- ИнфоСофт Мурсалимов Д.Р. 31.10.24 УА #86238
	//- ИнфоСофт Конышев А.Е. 26.11.24 УА #88616 
	
	Для Каждого Элемент Из Данные Цикл
		Если Элемент.ЭтоНабор Тогда
			
			//+ ИнфоСофт Мурсалимов Д.Р. 11.11.24 УА #85693
			//ТоварыНабора = ПолучитьТаблицуТоваровНабораNew(Элемент.Номенклатура, Элемент.Характеристика, Профиль);
			ТоварыНабора = ПолучитьТаблицуТоваровНабораNew(Профиль, Элемент.Номенклатура, Элемент.Характеристика);	
			//- ИнфоСофт Мурсалимов Д.Р. 11.11.24 УА #85693  
			
			Если ТоварыНабора[0].ВариантРасчетаЦены = Перечисления.ВариантыРасчетаЦенНаборов.РассчитываетсяИзЦенКомплектующих Или
				ТоварыНабора[0].ВариантРасчетаЦены = Перечисления.ВариантыРасчетаЦенНаборов.ЦенаЗадаетсяЗаНаборРаспределяетсяПоЦенам Тогда
				
				МассивКоэффициентов = РассчитатьКоэффициентыИзЦен(ТоварыНабора.ВыгрузитьКолонку("КомплектующиеЦена"), Элемент.Номенклатура);
			Иначе
				МассивКоэффициентов = ТоварыНабора.ВыгрузитьКолонку("ДоляСтоимости");
			КонецЕсли;
			
			СуммыПродажи = ОбщегоНазначения.РаспределитьСуммуПропорциональноКоэффициентам(Элемент.КПеречислениюПродавцуЗаРеализованныйТовар, МассивКоэффициентов);
			
			Для Каждого ЭлементНабора Из ТоварыНабора Цикл 
				
				НоваяСтрока = Документ.Товары.Добавить();
				НоваяСтрока.Номенклатура = ЭлементНабора.Номенклатура;
				НоваяСтрока.Характеристика = ЭлементНабора.Характеристика;
				НоваяСтрока.КоличествоУпаковок = ЭлементНабора.КоличествоУпаковок;
				
				//+ ИнфоСофт Заварин К.В. 06.02.25 УА #88299
				//НоваяСтрока.Цена = СуммыПродажи[0] / НоваяСтрока.Количество; 
				НоваяСтрока.Цена = СуммыПродажи[0] / НоваяСтрока.КоличествоУпаковок;
				//- ИнфоСофт Заварин К.В. 06.02.25 УА #88299
				
				НоваяСтрока.Сумма = СуммыПродажи[0]; 
				//+ ИнфоСофт Сумин Д.В. 29.05.23 УА #59046  
				НоваяСтрока.Упаковка = ЭлементНабора.Номенклатура.ЕдиницаИзмерения;
				//+ ИнфоСофт Сумин Д.В. 29.05.23 УА #59046				
				СуммыПродажи.Удалить(0);
				
			КонецЦикла;	
			
		Иначе
			НоваяСтрока = Документ.Товары.Добавить();
			НоваяСтрока.Номенклатура = Элемент.Номенклатура;
			НоваяСтрока.Характеристика = Элемент.Характеристика; 
			//+ ИнфоСофт Сумин Д.В. 29.05.23 УА #59046 
			НоваяСтрока.Количество = Элемент.УпаковкаКоличество;
			НоваяСтрока.Склад = Профиль.Склад;
			//НоваяСтрока.Количество = Элемент.Количество;
			//- ИнфоСофт Сумин Д.В. 29.05.23 УА #59046
			НоваяСтрока.КоличествоУпаковок = Элемент.Количество;
			НоваяСтрока.Цена = Элемент.КПеречислениюПродавцуЗаРеализованныйТовар;  
			НоваяСтрока.Сумма =  НоваяСтрока.Цена * Элемент.Количество; 					
		КонецЕсли;	
		//+ ИнфоСофт Сумин Д.В. 29.05.23 УА #59046  
		Если Не Элемент.ЭтоНабор Тогда
			НоваяСтрока.Упаковка = Элемент.Упаковка; 
		КонецЕсли;
		//НоваяСтрока.Упаковка = Элемент.Номенклатура.ЕдиницаИзмерения; 
		//- ИнфоСофт Сумин Д.В. 29.05.23 УА #59046 
	КонецЦикла;  
	
	//+ ИнфоСофт Сумин Д.В. 27.03.23 УА #56728
	Попытка
		Документ.Записать(РежимЗаписиДокумента.Проведение); 
	Исключение
		Документ.Записать();
	КонецПопытки; 
	//Документ.Записать(РежимЗаписиДокумента.Проведение); 
	//- ИнфоСофт Сумин Д.В. 27.03.23 УА #56728 
	
	Возврат Документ;    
	
КонецФункции //- ИнфоСофт Сумин Д.В. 06.03.23 УА #55086	

//+ ИнфоСофт Сумин Д.В. 13.03.23 УА #54516
Процедура ВыполнитьАлгоритмПроверкиТоваровНаКомплект(ЗаказКлиента, СкладВБ) Экспорт 
	
	//+ ИнфоСофт Сумин Д.В. 28.06.2023 УА #60128
	ЗапросНазначений = Новый Запрос;
	ЗапросНазначений.Текст = 
	"ВЫБРАТЬ
	|	ЕСТЬNULL(Назначения.Ссылка, ЗНАЧЕНИЕ(Справочник.Назначения.ПустаяСсылка)) КАК Назначение
	|ИЗ
	|	Справочник.ИС_ВБ_Склады.НаправленияДеятельности КАК ИС_ВБ_СкладыНаправленияДеятельности
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Назначения КАК Назначения
	|		ПО ИС_ВБ_СкладыНаправленияДеятельности.НаправлениеДеятельности = Назначения.НаправлениеДеятельности И (Назначения.НаправлениеДеятельности <> ЗНАЧЕНИЕ(Справочник.НаправленияДеятельности.ПустаяСсылка))
	|ГДЕ
	|	ИС_ВБ_СкладыНаправленияДеятельности.Ссылка = &Ссылка";
	
	ЗапросНазначений.УстановитьПараметр("Ссылка", СкладВБ);
	
	РезультатЗапросаНазначений = ЗапросНазначений.Выполнить();
	
	Назначения = Новый Массив;
	
	ВыборкаНазначения = РезультатЗапросаНазначений.Выбрать();
	
	Пока ВыборкаНазначения.Следующий() Цикл 
		Если ВыборкаНазначения.Назначение <> Справочники.Назначения.ПустаяСсылка() Тогда 
			Назначения.Добавить(ВыборкаНазначения.Назначение);
		КонецЕсли;
	КонецЦикла;
	//- ИнфоСофт Сумин Д.В. 28.06.2023 УА #60128
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	//+ ИнфоСофт Сумин Д.В. 05.07.2023 УА #60128
	"ВЫБРАТЬ
	|	ТоварыВзаказе.Номенклатура КАК Номенклатура,
	|	ТоварыВзаказе.Характеристика КАК Характеристика
	|ПОМЕСТИТЬ ВТ_ТоварыВЗаказе
	|ИЗ
	|	&ТоварыВзаказе КАК ТоварыВзаказе
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	МАКСИМУМ(ВЫБОР
	|			КОГДА ВариантыКомплектацииНоменклатурыТовары.Номенклатура ЕСТЬ NULL
	|				ТОГДА ЛОЖЬ
	|			ИНАЧЕ ИСТИНА
	|		КОНЕЦ) КАК ЭтоКомплект,
	|	ВТ_ТоварыВЗаказе.Номенклатура КАК Номенклатура
	|ПОМЕСТИТЬ ВТ_Комплектация
	|ИЗ
	|	ВТ_ТоварыВЗаказе КАК ВТ_ТоварыВЗаказе
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ВариантыКомплектацииНоменклатуры.Товары КАК ВариантыКомплектацииНоменклатурыТовары
	|		ПО (ВТ_ТоварыВЗаказе.Номенклатура = ВариантыКомплектацииНоменклатурыТовары.Ссылка.Владелец
	|				И ВариантыКомплектацииНоменклатурыТовары.Ссылка.Владелец.ТипНоменклатуры <> ЗНАЧЕНИЕ(Перечисление.ТипыНоменклатуры.Набор))
	|
	|СГРУППИРОВАТЬ ПО
	|	ВТ_ТоварыВЗаказе.Номенклатура
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	РаспределениеЗапасов.Свободно КАК КомплектСвободно,
	|	ВТ_Комплектация.Номенклатура КАК Номенклатура
	|ПОМЕСТИТЬ ВТ_КомплектОстаток
	|ИЗ
	|	ВТ_Комплектация КАК ВТ_Комплектация
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.РаспределениеЗапасов КАК РаспределениеЗапасов
	|		ПО ВТ_Комплектация.Номенклатура = РаспределениеЗапасов.Номенклатура
	|ГДЕ
	|	РаспределениеЗапасов.Склад В (&Склад)
	|	И РаспределениеЗапасов.Назначение В(&Назначение)
	|	И РаспределениеЗапасов.Состояние = ЗНАЧЕНИЕ(Перечисление.РаспределениеЗапасовСостояния.ОстатокНаСкладе)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ЕСТЬNULL(ВТ_КомплектОстаток.КомплектСвободно, 0) КАК КомплектСвободно,
	|	ВТ_Комплектация.ЭтоКомплект КАК ЭтоКомплект,
	|	ВТ_Комплектация.Номенклатура КАК Номенклатура
	|ИЗ
	|	ВТ_Комплектация КАК ВТ_Комплектация
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_КомплектОстаток КАК ВТ_КомплектОстаток
	|		ПО ВТ_Комплектация.Номенклатура = ВТ_КомплектОстаток.Номенклатура";
	//- ИнфоСофт Сумин Д.В. 05.07.2023 УА #60128
	
	//- ИнфоСофт Сумин Д.В. 26.04.23 УА #58025
	//Если СкладВБ.НаправлениеДеятельности = Справочники.НаправленияДеятельности.ПустаяСсылка() Тогда
	//Назначение = Справочники.Назначения.ПустаяСсылка();	
	//Иначе	
	//	Назначение = Справочники.Назначения.НайтиПоРеквизиту("НаправлениеДеятельности", СкладВБ.НаправлениеДеятельности); 
	//КонецЕсли;
	//- ИнфоСофт Сумин Д.В. 26.04.23 УА #58025
	Запрос.УстановитьПараметр("ТоварыВЗаказе", ЗаказКлиента.Товары);
	Запрос.УстановитьПараметр("Склад", ЗаказКлиента.Склад);
	Запрос.УстановитьПараметр("Назначение", Назначения);
	
	РезультатЗапроса = Запрос.Выполнить();	
	
	ДанныеКомплектов = РезультатЗапроса.Выгрузить();
	
	Если Не ДанныеКомплектов[0].ЭтоКомплект Или ДанныеКомплектов[0].КомплектСвободно > 0 Тогда
		Возврат;	
	КонецЕсли;
	
	СоздатьЗаказНаСборкуКомплектов(ЗаказКлиента, СкладВБ);	
	
КонецПроцедуры //- ИнфоСофт Сумин Д.В. 13.03.23 УА #54516 

//+ ИнфоСофт Сумин Д.В. 29.06.2023 УА #59111
Процедура СоздатьЗаказНаСборкуКомплектов(ЗаказКлиента, СкладВБ)
	
	ЗаказНаСборку = Документы.ЗаказНаСборку.СоздатьДокумент(); 
	ЗаказНаСборку.Комментарий = ЗаказКлиента.Комментарий; 
	ЗаказНаСборку.Дата = ЗаказКлиента.Дата;
	ЗаказНаСборку.Подразделение = ЗаказКлиента.Подразделение;  
	
	СтруктураДанных = Новый Структура;
	СтруктураДанных.Вставить("АдресТовары", ПоместитьВоВременноеХранилище(ЗаказКлиента.Товары.Выгрузить(), Новый УникальныйИдентификатор)); 
	СтруктураДанных.Вставить("Основание", ЗаказКлиента.Ссылка);
	СтруктураДанных.Вставить("Склад", ЗаказКлиента.Склад);
	
	ЗаказНаСборку.Заполнить(СтруктураДанных);
	
	ЗаказНаСборку.Организация = ЗаказКлиента.Организация;
	
	ЗаказНаСборку.Статус = Перечисления.СтатусыВнутреннихЗаказов.КВыполнению;  
	
	ЗаказНаСборку.ДокументОснование = ЗаказКлиента.Ссылка;
	
	ЗаказНаСборку.Подразделение = ЗаказКлиента.Подразделение;
	
	ЗаказНаСборку.НачалоСборкиРазборки = ЗаказКлиента.Дата;
	ЗаказНаСборку.ОкончаниеСборкиРазборки = ЗаказКлиента.Дата; 
	
	ОбеспечиватьОбособленно = ЗаказКлиента.Соглашение.ОбеспечиватьЗаказыОбособленно;
	НаправленияДеятельностиИспользуются = СкладВБ.НаправленияДеятельности.Количество() > 0;
	
	Если ОбеспечиватьОбособленно И НаправленияДеятельностиИспользуются Тогда
		ЗаказНаСборку.НаправлениеДеятельности = ЗаказКлиента.Договор.НаправлениеДеятельности;
		
		//+ ИнфоСофт Сумин Д.В. 05.07.2023 УА #60434
		ЗаказНаСборку.Назначение = Справочники.Назначения.НайтиПоРеквизиту("НаправлениеДеятельности", ЗаказКлиента.Договор.НаправлениеДеятельности);
		//ЗаказНаСборку.Назначение = Справочники.Назначения.НайтиПоРеквизиту("НаправлениеДеятельности", СкладВБ.НаправленияДеятельности[0].НаправлениеДеятельности);
		//- ИнфоСофт Сумин Д.В. 05.07.2023 УА #60434
	КонецЕсли;	
	
	Для Каждого Элемент Из ЗаказНаСборку.Товары Цикл
		Элемент.ВариантОбеспечения = Перечисления.ВариантыОбеспечения.Отгрузить;
		Если ОбеспечиватьОбособленно И НаправленияДеятельностиИспользуются Тогда
			Элемент.Обособленно = Истина;		
		КонецЕсли;
	КонецЦикла;
	//Если используется обособление, то сначала выполняется попытка проведения с обособлением товара. При неудаче выполняется поптыка проведения без обособления. 
	Попытка
		ЗаказНаСборку.Записать(РежимЗаписиДокумента.Проведение);	
	Исключение 
		
		Если ОбеспечиватьОбособленно И НаправленияДеятельностиИспользуются Тогда	
			Попытка
				Для Каждого Элемент Из ЗаказНаСборку.Товары Цикл
					Элемент.Обособленно = Ложь;		
				КонецЦикла;	
				ЗаказНаСборку.Записать(РежимЗаписиДокумента.Проведение);
			Исключение
				ЗаказНаСборку.Статус = Перечисления.СтатусыВнутреннихЗаказов.КОбеспечению;
				Для Каждого Элемент Из ЗаказНаСборку.Товары Цикл
					Элемент.ВариантОбеспечения = Перечисления.ВариантыОбеспечения.КОбеспечению;
					Элемент.Обособленно = Ложь;	
					
				КонецЦикла;  
				ЗаписьЖурналаРегистрации("ИС.WB.РазборЗаказов", УровеньЖурналаРегистрации.Ошибка, , , ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
				ЗаказНаСборку.Записать();	
			КонецПопытки;
		Иначе
			ЗаказНаСборку.Статус = Перечисления.СтатусыВнутреннихЗаказов.КОбеспечению;
			Для Каждого Элемент Из ЗаказНаСборку.Товары Цикл
				Элемент.ВариантОбеспечения = Перечисления.ВариантыОбеспечения.КОбеспечению;
				Элемент.Обособленно = Ложь;	
				
			КонецЦикла;  
			ЗаписьЖурналаРегистрации("ИС.WB.РазборЗаказов", УровеньЖурналаРегистрации.Ошибка, , , ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
			ЗаказНаСборку.Записать();
		КонецЕсли;
	КонецПопытки;
	
КонецПроцедуры //- ИнфоСофт Сумин Д.В. 29.06.2023 УА #59111	

//+ ИнфоСофт Сумин Д.В. 07.08.2023 УА #60602
Функция ПолучитьКодыМаркировки(МассивКиз) 
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ШтрихкодыУпаковокТоваров.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.ШтрихкодыУпаковокТоваров КАК ШтрихкодыУпаковокТоваров
	|ГДЕ
	|	ШтрихкодыУпаковокТоваров.ЗначениеШтрихкода В(&МассивКиз)";
	
	Запрос.УстановитьПараметр("МассивКиз", МассивКиз);  
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Выборка = РезультатЗапроса.Выбрать();
	
	МассивКодов = Новый Массив;
	
	Пока Выборка.Следующий() Цикл
		МассивКодов.Добавить(Выборка.Ссылка);	
	КонецЦикла;	
	
	Возврат МассивКодов;
	
КонецФункции //- ИнфоСофт Сумин Д.В. 07.08.2023 УА #60602

//+ ИнфоСофт Сумин Д.В. 08.09.2023 УА #61973
Процедура ВыполнитьСозданиеОтборРазмещениеТоваров(ОформленныеОрдеры) 
	
	Для Каждого Элемент Из ОформленныеОрдеры Цикл  	
		НовыйДокумент = Документы.ОтборРазмещениеТоваров.СоздатьДокумент();
		НовыйДокумент.Заполнить(Элемент.РасходныйОрдер);   	
		Попытка
			НовыйДокумент.Записать(РежимЗаписидокумента.Проведение);
		Исключение 
			НовыйДокумент.Записать(РежимЗаписидокумента.Запись);
			ТекстСообщения = НСтр("ru = 'Не удалось обработать %Документ% фоновым заданием по созданию отбора на размещение: %Причина%'");
			ТекстСообщения = СтрЗаменить(ТекстСообщения, "%Документ%", НовыйДокумент);
			ТекстСообщения = СтрЗаменить(ТекстСообщения, "%Причина%", ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
			ЗаписьЖурналаРегистрации(ОбновлениеИнформационнойБазы.СобытиеЖурналаРегистрации(),
			УровеньЖурналаРегистрации.Ошибка,
			Метаданные.Документы.ОтборРазмещениеТоваров,
			НовыйДокумент,
			ТекстСообщения);
			ВызватьИсключение;	
		КонецПопытки;
	КонецЦикла;	
	
КонецПроцедуры //- ИнфоСофт Сумин Д.В. 08.09.2023 УА #61973	

