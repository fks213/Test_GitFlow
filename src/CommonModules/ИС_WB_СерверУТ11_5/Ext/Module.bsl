Функция ПолучитьАктивныйЗаказКлиентаВБ(СборочноеЗадание)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ                                                                
	|	ИС_WB_ЗаказыВТеченииДня.ЗаказКлиента КАК ЗаказКлиента
	|ИЗ
	|	РегистрСведений.ИС_WB_ЗаказыВТеченииДня КАК ИС_WB_ЗаказыВТеченииДня
	|ГДЕ
	|	ИС_WB_ЗаказыВТеченииДня.ЗаказОткрыт
	|	И ИС_WB_ЗаказыВТеченииДня.Профиль = &Профиль
	|	И ИС_WB_ЗаказыВТеченииДня.СкладМП = &Склад";

	Запрос.УстановитьПараметр("Профиль", 	СборочноеЗадание.Профиль);
	Запрос.УстановитьПараметр("Склад", 		СборочноеЗадание.Склад);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Если РезультатЗапроса.Пустой() Тогда
		Возврат Неопределено;	
	КонецЕсли; 	
	
	ВыборкаДетальныеЗаписи.Следующий();	
	
	Возврат ВыборкаДетальныеЗаписи.ЗаказКлиента;
	
