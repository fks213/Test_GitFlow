//+ ИнфоСофт Ивонин К.А. 20.02.23 УА #53535
Функция ПолучитьПрименениеНДСОрганизации(Организация)
		
	ОрганизацияПименяетУСН = ОрганизацияПименяетУСН(Организация);
		
	Если ОрганизацияПименяетУСН <> Неопределено И ОрганизацияПименяетУСН Тогда
		Возврат Ложь;	
	КонецЕсли;	
		
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	НастройкиУчетаНДССрезПоследних.ПрименяетсяОсвобождениеОтУплатыНДС КАК ПрименяетсяОсвобождениеОтУплатыНДС
	|ИЗ
	|	РегистрСведений.НастройкиУчетаНДС.СрезПоследних(, Организация = &Организация) КАК НастройкиУчетаНДССрезПоследних";
	
	Запрос.УстановитьПараметр("Организация", Организация);
	
	РезультатЗапроса = Запрос.Выполнить();
	Выборка = РезультатЗапроса.Выбрать();
	
	Если Выборка.Следующий() Тогда
		Возврат Не Выборка.ПрименяетсяОсвобождениеОтУплатыНДС;
	Иначе
		Возврат Неопределено;
	КонецЕсли;
		
КонецФункции //- ИнфоСофт Ивонин К.А. 20.02.23 УА #53535

//+ ИнфоСофт Мурсалимов Д.Р. 04.09.24 УА #82005
Функция ПолучитьТаблицуТоваровНабора(ТоварыЗаказа) Экспорт
	
	Запрос = Новый Запрос;		
	Запрос.Текст =
	
	"ВЫБРАТЬ
	|	ТоварыВзаказе.Сумма КАК Сумма,
	|	ТоварыВзаказе.Номенклатура КАК Номенклатура,
	|	ТоварыВзаказе.Характеристика КАК Характеристика,
	|	ТоварыВзаказе.Цена КАК Цена
	|ПОМЕСТИТЬ ВТ_ТоварыВЗаказе
	|ИЗ
	|	&ТоварыВзаказе КАК ТоварыВзаказе
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	СУММА(ВариантыКомплектацииНоменклатурыТовары.ДоляСтоимости) КАК ОбщаяДоляСтоимости,
	|	СУММА(ВариантыКомплектацииНоменклатурыТовары.Количество) КАК Количество,
	|	ВТ_ТоварыВЗаказе.Сумма КАК Сумма,
	|	ВТ_ТоварыВЗаказе.Цена КАК Цена,
	|	ВТ_ТоварыВЗаказе.Номенклатура КАК Набор,
	|	ВТ_ТоварыВЗаказе.Характеристика КАК Характеристика	
	|ПОМЕСТИТЬ ВТ_Количество
	|ИЗ
	|	ВТ_ТоварыВЗаказе КАК ВТ_ТоварыВЗаказе
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ВариантыКомплектацииНоменклатуры.Товары КАК ВариантыКомплектацииНоменклатурыТовары
	|		ПО (ВТ_ТоварыВЗаказе.Номенклатура = ВариантыКомплектацииНоменклатурыТовары.Ссылка.Владелец)
	|			И (ВТ_ТоварыВЗаказе.Характеристика = ВариантыКомплектацииНоменклатурыТовары.Ссылка.Характеристика)
	|
	|СГРУППИРОВАТЬ ПО
	|	ВТ_ТоварыВЗаказе.Номенклатура,
	|	ВТ_ТоварыВЗаказе.Характеристика,
	|	ВТ_ТоварыВЗаказе.Сумма,
	|	ВТ_ТоварыВЗаказе.Цена
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВариантыКомплектацииНоменклатурыТовары.Номенклатура КАК Номенклатура,
	|	ВариантыКомплектацииНоменклатурыТовары.Характеристика КАК Характеристика,
	|	ВариантыКомплектацииНоменклатурыТовары.ДоляСтоимости КАК ДоляСтоимости,
	|	ВариантыКомплектацииНоменклатурыТовары.Количество КАК Количество,
	|	ЕСТЬNULL(ВариантыКомплектацииНоменклатурыТовары.Упаковка, ВариантыКомплектацииНоменклатурыТовары.Номенклатура.ЕдиницаИзмерения) КАК Упаковка,	
	|	ВТ_Количество.ОбщаяДоляСтоимости КАК ОбщаяДоляСтоимости,
	|	ВТ_Количество.Количество КАК КоличествоОбщее,
	|	ВТ_Количество.Набор КАК Набор,
	|	ВТ_Количество.Характеристика КАК ХарактеристикаНабора,
	|	ВТ_Количество.Сумма КАК Сумма, 
	|	ВТ_Количество.Цена КАК Цена,
	|	ВариантыКомплектацииНоменклатурыТовары.Ссылка.ВариантРасчетаЦеныНабора КАК ВариантРасчетаЦеныНабора
	|ИЗ
	|	ВТ_Количество КАК ВТ_Количество
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ВариантыКомплектацииНоменклатуры.Товары КАК ВариантыКомплектацииНоменклатурыТовары
	|		ПО (ВТ_Количество.Набор = ВариантыКомплектацииНоменклатурыТовары.Ссылка.Владелец
	|				И ВТ_Количество.Характеристика = ВариантыКомплектацииНоменклатурыТовары.Ссылка.Характеристика)
	|
	|УПОРЯДОЧИТЬ ПО
	|	Номенклатура";                          
			
	Запрос.УстановитьПараметр("ТоварыВзаказе", ТоварыЗаказа);
	РезультатЗапроса = Запрос.Выполнить();

	Возврат РезультатЗапроса.Выгрузить();
	
КонецФункции //- ИнфоСофт Мурсалимов Д.Р. 04.09.24 УА #82005

//+ ИнфоСофт Ивонин К.А. 20.02.23 УА #53535
Функция РассчитатьСуммуНДС(Сумма, СтавкаНДС, СуммаВключаетНДС = Истина) Экспорт
	
	Если СуммаВключаетНДС Тогда
		СуммаНДС = Окр(Сумма - 100 * Сумма / (100 + СтавкаНДС), 2, РежимОкругления.Окр15как20);
	Иначе
		СуммаНДС = Окр(Сумма * СтавкаНДС / 100, 2, РежимОкругления.Окр15как20);
	КонецЕсли;
	
	Возврат СуммаНДС;
	
КонецФункции //- ИнфоСофт Ивонин К.А. 20.02.23 УА #53535

//+ ИнфоСофт Ивонин К.А. 21.02.23 УА #53535
Функция РассчитатьДолюСтоимости(ТоварыЗаказаТЗ, ВидЦены, Дата) Экспорт
	
	Доля = Неопределено;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ЦеныНоменклатурыСрезПоследних.Номенклатура КАК Номенклатура,
	|	ЦеныНоменклатурыСрезПоследних.Характеристика КАК Характеристика,
	|	ЦеныНоменклатурыСрезПоследних.Цена КАК Цена
	|ИЗ
	|	РегистрСведений.ЦеныНоменклатуры.СрезПоследних(
	|			&Период,
	|			ВидЦены = &ВидЦены
	|				И Номенклатура В(&Номенклатура)
	|				И Характеристика В(&Характеристика)) КАК ЦеныНоменклатурыСрезПоследних
	//+ ИнфоСофт Стояк Ю.К. 19.03.2024 УА #72423
	|
	|УПОРЯДОЧИТЬ ПО
	|	Номенклатура";                                                                    
	//- ИнфоСофт Стояк Ю.К. 19.03.2024 УА #72423
	
	
	Запрос.УстановитьПараметр("ВидЦены", ВидЦены);
	Запрос.УстановитьПараметр("Номенклатура", ТоварыЗаказаТЗ.ВыгрузитьКолонку("Номенклатура"));
	Запрос.УстановитьПараметр("Характеристика", ТоварыЗаказаТЗ.ВыгрузитьКолонку("Характеристика"));
	Запрос.УстановитьПараметр("Период", Дата);
	
	РезультатЗапроса = Запрос.Выполнить();
	Таблица = РезультатЗапроса.Выгрузить(); 
	
	ОбщаяЦена = 0;
	ЦенаЭлемента = 0;
	
	Для Каждого Элемент Из Таблица Цикл		
		Строка = ТоварыЗаказаТЗ.Найти(Элемент.Номенклатура, "Номенклатура");
		//+ ИнфоСофт Стояк Ю.К. 12.10.2023 УА #64691		
		Если ЗначениеЗаполнено(Строка) Тогда
			ОбщаяЦена = ОбщаяЦена + Элемент.Цена * Строка.Количество;
		Иначе
			ОбщегоНазначения.СообщитьПользователю("Проверьте наличие цены на комплектующую " + Элемент.Номенклатура + "по виду цен " + ВидЦены + " на дату " + Дата);
			Возврат Неопределено;
		КонецЕсли;                                  
		//- ИнфоСофт Стояк Ю.К. 12.10.2023 УА #64691
	КонецЦикла; 
	
	МассивКоэффициентов = Новый Массив;
	
	//+ ИнфоСофт Сумин Д.В. 12.01.2024 УА #68609
	Если ТоварыЗаказаТЗ.Количество() <> Таблица.Количество() Тогда
		Для Каждого Строка Из ТоварыЗаказаТЗ Цикл 
			МассивКоэффициентов.Добавить(Строка.Количество);
		КонецЦикла;	
	Иначе	
		Если ОбщаяЦена <> 0 Тогда
			Для Каждого Элемент Из Таблица Цикл
				Строка = ТоварыЗаказаТЗ.Найти(Элемент.Номенклатура, "Номенклатура"); 
				МассивКоэффициентов.Добавить((Элемент.Цена * Строка.Количество) / ОбщаяЦена);
			КонецЦикла;              
		Иначе
			//+ ИнфоСофт Стояк Ю.К. 14.11.2023 УА #65997		
			ОбщегоНазначения.СообщитьПользователю("Проверьте заполненность вида цен в профиле или наличие цены на набор / комплектующие набора " + ТоварыЗаказаТЗ[0].Набор + " по виду цен " + ВидЦены + " на дату " + Дата);
			//- ИнфоСофт Стояк Ю.К. 14.11.2023 УА #65997
			Возврат Неопределено;
		КонецЕсли;
	КонецЕсли;
	//Если ОбщаяЦена <> 0 Тогда
	//	Для Каждого Элемент Из Таблица Цикл
	//		Строка = ТоварыЗаказаТЗ.Найти(Элемент.Номенклатура, "Номенклатура"); 
	//		МассивКоэффициентов.Добавить((Элемент.Цена * Строка.Количество) / ОбщаяЦена);
	//	КонецЦикла;              
	//Иначе
	//	//+ ИнфоСофт Стояк Ю.К. 14.11.2023 УА #65997		
	//	ОбщегоНазначения.СообщитьПользователю("Проверьте заполненность вида цен в профиле или наличие цены на набор / комплектующие набора " + ТоварыЗаказаТЗ[0].Набор + " по виду цен " + ВидЦены + " на дату " + Дата);
	//	//- ИнфоСофт Стояк Ю.К. 14.11.2023 УА #65997
	//	Возврат Неопределено;
	//КонецЕсли;
	//- ИнфоСофт Сумин Д.В. 12.01.2024 УА #68609 
	
	Возврат МассивКоэффициентов;
	
КонецФункции //- ИнфоСофт Ивонин К.А. 21.02.23 УА #53535

