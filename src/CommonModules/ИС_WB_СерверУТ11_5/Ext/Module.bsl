Функция СоздатьИзменитьОприходованиеИзлишковТоваров(Профиль, ДанныеДокумента, ДопПараметры = Неопределено) Экспорт
	
	Если ТипЗнч(ДопПараметры) = Тип("Структура") И ДопПараметры.Свойство("ДокументСсылка") Тогда
		ДокументОбъект = ДопПараметры.ДокументСсылка.ПолучитьОбъект();
	Иначе	
		ДокументОбъект = Документы.ОприходованиеИзлишковТоваров.СоздатьДокумент();
	КонецЕсли;
	
	ДокументОбъект.Дата          = ДанныеДокумента.Дата;
	ДокументОбъект.Комментарий   = ДанныеДокумента.Комментарий;
	ДокументОбъект.Организация   = ДанныеДокумента.Организация;
	ДокументОбъект.Подразделение = ДанныеДокумента.Подразделение;
	ДокументОбъект.Склад         = ДанныеДокумента.Склад;
	ДокументОбъект.СтатьяДоходов = ДанныеДокумента.СтатьяДоходов;
	ДокументОбъект.Комментарий   = ДанныеДокумента.Комментарий;
	ДокументОбъект.Валюта        = Константы.ВалютаРегламентированногоУчета.Получить();
	ДокументОбъект.Ответственный = Пользователи.АвторизованныйПользователь();
	ДокументОбъект.Автор         = ДокументОбъект.Ответственный;
	
	ДокументОбъект.АналитикаДоходов = ПланыВидовХарактеристик.СтатьиДоходов.ПолучитьАналитикуДоходовПоУмолчанию(ДокументОбъект.СтатьяДоходов, 
										ДанныеДокумента, ДанныеДокумента.Подразделение);
	
	ДокументОбъект.Товары.Очистить();
	
	Для Каждого Строка Из ДанныеДокумента.Товары Цикл
		
		Если Строка.ЭтоНабор Тогда
			
			ТоварыНабора = ПолучитьТаблицуТоваровНабораNew(Профиль, Строка.Номенклатура, Строка.Характеристика);	
					
	  		Для Каждого ЭлементНабора Из ТоварыНабора Цикл 
				
				НоваяСтрока = ДокументОбъект.Товары.Добавить();
				
				НоваяСтрока.Номенклатура   = ЭлементНабора.Номенклатура;
				НоваяСтрока.Характеристика = ЭлементНабора.Характеристика;
				НоваяСтрока.Количество     = ЭлементНабора.КоличествоУпаковок;
				НоваяСтрока.Цена           = ЭлементНабора.КомплектующиеЦена;
				НоваяСтрока.Сумма          = НоваяСтрока.Цена * НоваяСтрока.Количество;
	
			КонецЦикла;
			
		Иначе	
			
			НоваяСтрока = ДокументОбъект.Товары.Добавить();
			
			НоваяСтрока.Номенклатура   = Строка.Номенклатура;
			НоваяСтрока.Характеристика = Строка.Характеристика;
			НоваяСтрока.Количество     = 1;
			НоваяСтрока.Цена           = Строка.Цена;
			НоваяСтрока.Сумма          = НоваяСтрока.Цена * НоваяСтрока.Количество;
			
		КонецЕсли;	
		
	КонецЦикла;
	
	Попытка	
		ДокументОбъект.Записать(РежимЗаписиДокумента.Проведение);	
	Исключение
		
		ТекстСообщения = "Не удалось провести оприходование излишков товаров.";
		ТекстОшибки    = ОписаниеОшибки();
		ОбщегоНазначения.СообщитьПользователю(СтрШаблон("%1|%2", ТекстСообщения, ТекстОшибки));
		
		Попытка	
			ДокументОбъект.Записать(РежимЗаписиДокумента.Запись);	
		Исключение
			
			ТекстСообщения = "Не удалось записать оприходование излишков товаров.";
			ТекстОшибки    = ОписаниеОшибки();
			ОбщегоНазначения.СообщитьПользователю(СтрШаблон("%1|%2", ТекстСообщения, ТекстОшибки));
			
			Возврат Неопределено;
			
		КонецПопытки;
		
	КонецПопытки;
	
	Возврат ДокументОбъект.Ссылка;
	
КонецФункции //- ИнфоСофт Власова И.С. 14.03.25 УА #83865

