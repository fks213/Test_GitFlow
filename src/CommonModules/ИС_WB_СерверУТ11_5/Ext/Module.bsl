Процедура УстановитьПараметрыЗапросаЦен(Запрос, Профиль) Экспорт
	
	Событие = ПолучитьИмяСобытия("УстановитьПараметрыЗапросаЦен");
	
	МассивПараметров = ИС_WB_Сервер.ПолучитьСписокПараметровЦен();
	
	Результат = ИС_MP_Сервер.ПолучитьЗначениеНастроек(Профиль, Перечисления.ИС_МП_Маркетплейсы.ВБ, МассивПараметров);
	
	СтруктураЦен = ИС_WB_Сервер.ПолучитьСтруктуруПараметровЦен();
	
	ЗаполнитьЗначенияСвойств(СтруктураЦен, Результат);
	
	Запрос.УстановитьПараметр("Маркетплейс"			, Перечисления.ИС_МП_Маркетплейсы.ВБ);
	Запрос.УстановитьПараметр("ВидЦены"				, СтруктураЦен.ВидЦены); 
	Запрос.УстановитьПараметр("ВидЦеныСоСкидкой"	, СтруктураЦен.ВидЦеныСоСкидкой);
	Запрос.УстановитьПараметр("ВидЦеныМинимальный"	, Справочники.ВидыЦен.ПустаяСсылка());
	//+ ИнфоСофт Заварин К.В. 03.09.24 УА #72696
	Запрос.УстановитьПараметр("ВидЦеныFBO"			, СтруктураЦен.ВидЦеныFBO);
	//- ИнфоСофт Заварин К.В. 03.09.24 УА #72696
	Запрос.УстановитьПараметр("Профиль"				, Профиль); 
	Запрос.УстановитьПараметр("ПустаяУпаковка"		, ИС_MP_СерверЛокализация.ПустаяСсылкаУпаковка());
		
КонецПроцедуры //- ИнфоСофт Мурсалимов Д.Р. 03.05.24 УА #66901

//+ ИнфоСофт Стояк Ю.К. 18.04.2025 УА #98648
Процедура ВыполнитьЗакрытиеЗаказов(Профиль) Экспорт
	
	Событие = ПолучитьИмяСобытия("ВыполнитьЗакрытиеЗаказов");
	
	ФукнциональныеОпции = ИС_WB_СерверПовтИсп.ПолучитьНастройкиФункциональностиСборочныхЗвданий(Профиль);
	
	Если Не ФукнциональныеОпции.ИспользоватьРазбиениеПоСкладам Тогда 
		
		Если Не ЗначениеЗаполнено(Профиль.АктивныйЗаказКлиента) Тогда
			Возврат;
		КонецЕсли;  
		
		Если Профиль.АвтоматическиСоздаватьРеализации Тогда
			СоздатьРеализациюПоЗакрытиюЗаказа(Профиль, Профиль.АктивныйЗаказКлиента);	
		КонецЕсли;
		
		ПрофильОбъект = Профиль.ПолучитьОбъект();
		ПрофильОбъект.АктивныйЗаказКлиента = Документы.ЗаказКлиента.ПустаяСсылка();		
		ПрофильОбъект.Поставка = Справочники.ИС_ВБ_ПоставкиFBS.ПустаяСсылка();                                    
		ПрофильОбъект.ПоставкаКГТ = Справочники.ИС_ВБ_ПоставкиFBS.ПустаяСсылка();
		ПрофильОбъект.ПоставкаСГТ = Справочники.ИС_ВБ_ПоставкиFBS.ПустаяСсылка();
		
		Попытка
			ПрофильОбъект.Записать();
		Исключение
			ИС_MP_Сервер.ЗаписатьВЖРИСообщитьПользователю(Событие, ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));	
		КонецПопытки;
		
		Возврат; 
		
	Иначе			
		
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ
		//+ ИнфоСофт Мурсалимов Д.Р. 23.04.25 УА #99629
		|	ИС_WB_ЗаказыВТечениеДня.СкладМП КАК СкладМП, 
		//- ИнфоСофт Мурсалимов Д.Р. 23.04.25 УА #99629
		|	ИС_WB_ЗаказыВТечениеДня.Профиль КАК Профиль,
		|	ИС_WB_ЗаказыВТечениеДня.ЗаказКлиента КАК ЗаказКлиента,
		|	ЕСТЬNULL(ИС_WB_СборочноеЗадание.Склад.АвтоматическиСоздаватьОрдерНаОтгрузку, ЛОЖЬ) КАК АвтоматическиСоздаватьОрдерНаОтгрузку
		|ПОМЕСТИТЬ ВТ_УникальныеЗаписи
		|ИЗ
		|	РегистрСведений.ИС_WB_ЗаказыВТеченииДня КАК ИС_WB_ЗаказыВТечениеДня
		|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ИС_WB_СборочноеЗадание КАК ИС_WB_СборочноеЗадание
		|		ПО ИС_WB_ЗаказыВТечениеДня.ЗаказКлиента = ИС_WB_СборочноеЗадание.Заказ
		|ГДЕ
		|	ИС_WB_ЗаказыВТечениеДня.Профиль = &Профиль
		|	И ИС_WB_ЗаказыВТечениеДня.ЗаказОткрыт
		|
		|СГРУППИРОВАТЬ ПО
		|	ИС_WB_ЗаказыВТечениеДня.СкладМП,
		|	ИС_WB_ЗаказыВТечениеДня.Профиль,
		|	ИС_WB_ЗаказыВТечениеДня.ЗаказКлиента,
		|	ЕСТЬNULL(ИС_WB_СборочноеЗадание.Склад.АвтоматическиСоздаватьОрдерНаОтгрузку, ЛОЖЬ)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		//+ ИнфоСофт Мурсалимов Д.Р. 23.04.25 УА #99629
		|	ВТ_УникальныеЗаписи.СкладМП КАК СкладМП, 
