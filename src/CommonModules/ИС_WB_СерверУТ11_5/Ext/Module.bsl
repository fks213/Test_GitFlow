				//	НДС = ЭлементНабора.Номенклатура.СтавкаНДС.Ставка;
				//	НоваяСтрока.СтавкаНДС = ЭлементНабора.Номенклатура.СтавкаНДС; 
				//	Если НДС = Неопределено Или НДС = 0 Тогда 
				//		НоваяСтрока.СуммаНДС = 0;		
