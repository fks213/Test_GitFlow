	//ПараметрыРасходногоОрдера.Вставить("ЗонаОтгрузки", ПараметрыНастроек.СкладВБ.СкладскаяЯчейкаОтгрузки); 
	//ПараметрыРасходногоОрдера.Вставить("ФоновоеЗадание", Истина);
	//- ИнфоСофт Сумин Д.В. 11.12.2023 #61973
	РаспоряженияНаОтгрузку = Новый Массив();
