//+ ИнфоСофт Власова И.С. 08.04.25 УА #78061
Функция СоздатьИзменитьВзаимозачетЗадолженности(Профиль, ДанныеДокумента, ДопПараметры = Неопределено) Экспорт
	
	Если ТипЗнч(ДопПараметры) = Тип("Структура") И ДопПараметры.Свойство("ДокументСсылка") Тогда
		ДокументОбъект = ДопПараметры.ДокументСсылка.ПолучитьОбъект();
	Иначе	
		ДокументОбъект = Документы.ВзаимозачетЗадолженности.СоздатьДокумент();
	КонецЕсли;
	
	ЗаполнитьЗначенияСвойств(ДокументОбъект, ДанныеДокумента);
	
	ДокументОбъект.Ответственный = Пользователи.АвторизованныйПользователь();
	ДокументОбъект.Валюта        = Константы.ВалютаРегламентированногоУчета.Получить();
	
	СуммаКредитор = ДанныеДокумента.КредиторскаяЗадолженность.Итог("Сумма");
	СуммаДебитор  = ДанныеДокумента.ДебиторскаяЗадолженность.Итог("Сумма");
	
	СуммаВзаимозачета = Мин(СуммаКредитор, СуммаДебитор);
	
	СуммаДебитор  = СуммаВзаимозачета;
	СуммаКредитор = СуммаВзаимозачета;
	
	ДокументОбъект.ДебиторскаяЗадолженность.Очистить();
	
	Для Каждого Строка Из ДанныеДокумента.ДебиторскаяЗадолженность Цикл
		
		Если СуммаДебитор = 0 Тогда
			Прервать;
		КонецЕсли;
		
		НоваяСтрока = ДокументОбъект.ДебиторскаяЗадолженность.Добавить();	
		ЗаполнитьЗначенияСвойств(НоваяСтрока, Строка);
		
		НоваяСтрока.Сумма                = ?(Строка.Сумма > СуммаДебитор, СуммаДебитор, Строка.Сумма);
		НоваяСтрока.СуммаВзаиморасчетов  = ПересчитатьВСуммуВзаиморасчетов(НоваяСтрока.Сумма, ДокументОбъект.Валюта, ДокументОбъект.Дата);
		НоваяСтрока.СуммаРегл            = ПересчитатьВСуммуРегл(НоваяСтрока.Сумма, ДокументОбъект.Валюта, ДокументОбъект.Дата);
		НоваяСтрока.СуммаУпр             = ПересчитатьВСуммуУпр(НоваяСтрока.Сумма, ДокументОбъект.Валюта, ДокументОбъект.Дата);
		
		СуммаДебитор = СуммаДебитор - НоваяСтрока.Сумма;
		
	КонецЦикла;
	
	ДокументОбъект.КредиторскаяЗадолженность.Очистить();
	
	Для Каждого Строка Из ДанныеДокумента.КредиторскаяЗадолженность Цикл
		
		Если СуммаКредитор = 0 Тогда
			Прервать;
		КонецЕсли;
		
		НоваяСтрока = ДокументОбъект.КредиторскаяЗадолженность.Добавить();	
		ЗаполнитьЗначенияСвойств(НоваяСтрока, Строка);
		
		НоваяСтрока.Сумма                = ?(Строка.Сумма > СуммаКредитор, СуммаКредитор, Строка.Сумма);
		НоваяСтрока.СуммаВзаиморасчетов  = ПересчитатьВСуммуВзаиморасчетов(НоваяСтрока.Сумма, ДокументОбъект.Валюта, ДокументОбъект.Дата);
		НоваяСтрока.СуммаРегл            = ПересчитатьВСуммуРегл(НоваяСтрока.Сумма, ДокументОбъект.Валюта, ДокументОбъект.Дата);
		НоваяСтрока.СуммаУпр             = ПересчитатьВСуммуУпр(НоваяСтрока.Сумма, ДокументОбъект.Валюта, ДокументОбъект.Дата);
		
		СуммаКредитор = СуммаКредитор - НоваяСтрока.Сумма;
		
	КонецЦикла;
	
	ДокументОбъект.СуммаДокумента = ДокументОбъект.ДебиторскаяЗадолженность.Итог("СуммаВзаиморасчетов");
	ДокументОбъект.СуммаРегл      = ДокументОбъект.ДебиторскаяЗадолженность.Итог("СуммаРегл");
	ДокументОбъект.СуммаУпр       = ДокументОбъект.ДебиторскаяЗадолженность.Итог("СуммаУпр");
	
	Попытка	
		ДокументОбъект.Записать(РежимЗаписиДокумента.Проведение);	
	Исключение
		
		ТекстСообщения = "Не удалось провести взаимозачет задолженности.";
		ТекстОшибки    = ОписаниеОшибки();
		ОбщегоНазначения.СообщитьПользователю(СтрШаблон("%1|%2", ТекстСообщения, ТекстОшибки));
		
		Попытка	
			ДокументОбъект.Записать(РежимЗаписиДокумента.Запись);	
		Исключение
			
			ТекстСообщения = "Не удалось записать взаимозачет задолженности.";
			ТекстОшибки    = ОписаниеОшибки();
			ОбщегоНазначения.СообщитьПользователю(СтрШаблон("%1|%2", ТекстСообщения, ТекстОшибки));
			
			Возврат Неопределено;
			
		КонецПопытки;
		
	КонецПопытки;
	
	Возврат ДокументОбъект.Ссылка;
	
КонецФункции //- ИнфоСофт Власова И.С. 08.04.25 УА #78061

//+ ИнфоСофт Власова И.С. 08.04.25 УА #78061
Функция ПолучитьСтруктуруВзаимозачетаЗадолженности() Экспорт

	СтруктураДокумента = Новый Структура;
	СтруктураДокумента.Вставить("Дата");
	СтруктураДокумента.Вставить("Комментарий");
	СтруктураДокумента.Вставить("Организация");
	СтруктураДокумента.Вставить("Подразделение");
	СтруктураДокумента.Вставить("КонтрагентДебитор");
	СтруктураДокумента.Вставить("КонтрагентКредитор");
	СтруктураДокумента.Вставить("ВидОперации");
	СтруктураДокумента.Вставить("ТипДебитора");
	СтруктураДокумента.Вставить("ТипКредитора");
	
	ДебиторскаяЗадолженностьТЧ = Новый ТаблицаЗначений;
	ДебиторскаяЗадолженностьТЧ.Колонки.Добавить("ТипРасчетов");
	ДебиторскаяЗадолженностьТЧ.Колонки.Добавить("Партнер");
	ДебиторскаяЗадолженностьТЧ.Колонки.Добавить("Организация");
	ДебиторскаяЗадолженностьТЧ.Колонки.Добавить("Сумма");
	ДебиторскаяЗадолженностьТЧ.Колонки.Добавить("ВалютаВзаиморасчетов");
	ДебиторскаяЗадолженностьТЧ.Колонки.Добавить("ОбъектРасчетов");
	
	СтруктураДокумента.Вставить("ДебиторскаяЗадолженность", ДебиторскаяЗадолженностьТЧ);
	
	КредиторскаяЗадолженностьТЧ = Новый ТаблицаЗначений;
	КредиторскаяЗадолженностьТЧ.Колонки.Добавить("ТипРасчетов");
	КредиторскаяЗадолженностьТЧ.Колонки.Добавить("Партнер");
	КредиторскаяЗадолженностьТЧ.Колонки.Добавить("Организация");
	КредиторскаяЗадолженностьТЧ.Колонки.Добавить("Сумма");
	КредиторскаяЗадолженностьТЧ.Колонки.Добавить("ВалютаВзаиморасчетов");
	КредиторскаяЗадолженностьТЧ.Колонки.Добавить("ОбъектРасчетов");
	
	СтруктураДокумента.Вставить("КредиторскаяЗадолженность", КредиторскаяЗадолженностьТЧ);
	
	Возврат СтруктураДокумента;
	
КонецФункции //- ИнфоСофт Власова И.С. 08.04.25 УА #78061

//+ ИнфоСофт Власова И.С. 08.04.25 УА #78061
Функция ЗаполнитьДанныеВзаимозачетЗадолженности(Профиль, ДокументыДебитор, ДокументыКредитор, ЭтоПродажиЮрЛицам = Ложь) Экспорт
		
	ДанныеДокумента = ПолучитьСтруктуруВзаимозачетаЗадолженности();	
		
	Настройки = ИС_WB_СерверПовтИсп.ПолучитьНастройкиФункциональностиСборочныхЗвданий(Профиль);
	ЗаполнитьЗначенияСвойств(ДанныеДокумента, Настройки);
	
	Если Не ЭтоПродажиЮрЛицам Тогда
		
		ДанныеДокумента.КонтрагентДебитор  = Настройки.Контрагент;
		ДанныеДокумента.КонтрагентКредитор = Настройки.Контрагент;
		ДанныеДокумента.ВидОперации 	   = Перечисления.ВидыОперацийВзаимозачетаЗадолженности.Произвольный;
		ДанныеДокумента.ТипДебитора        = Перечисления.ТипыУчастниковВзаимозачета.Клиент;
		ДанныеДокумента.ТипКредитора       = Перечисления.ТипыУчастниковВзаимозачета.Поставщик;
		
		Для Каждого Документ Из ДокументыДебитор Цикл
			
			НоваяСтрока = ДанныеДокумента.ДебиторскаяЗадолженность.Добавить();
			
			НоваяСтрока.ТипРасчетов = Перечисления.ТипыРасчетовСПартнерами.РасчетыСКлиентом;
			НоваяСтрока.Партнер     = Настройки.Партнер;
			НоваяСтрока.Организация = Настройки.Организация;
			
			Если ТипЗнч(Документ) = Тип("ДокументСсылка.ОтчетКомиссионера") Тогда
				
				РеквизитыДокумента = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Документ,
					"Валюта, СуммаДокумента, Договор, Соглашение");
				
				НоваяСтрока.ВалютаВзаиморасчетов = РеквизитыДокумента.Валюта;
				НоваяСтрока.Сумма                = РеквизитыДокумента.СуммаДокумента;
				
				ПорядокРасчетов = ВзаиморасчетыСервер.ПорядокРасчетов(Ложь, , РеквизитыДокумента.Соглашение, РеквизитыДокумента.Договор);
				
				Если ПорядокРасчетов = Перечисления.ПорядокРасчетов.ПоНакладным Тогда
					НоваяСтрока.ОбъектРасчетов = Справочники.ОбъектыРасчетов.НайтиПоРеквизиту("Объект", Документ);
				ИначеЕсли ПорядокРасчетов = Перечисления.ПорядокРасчетов.ПоДоговорамКонтрагентов Тогда
					НоваяСтрока.ОбъектРасчетов = Справочники.ОбъектыРасчетов.НайтиПоРеквизиту("Объект", РеквизитыДокумента.Договор);
				КонецЕсли;
				
			ИначеЕсли ТипЗнч(Документ) = Тип("ДокументСсылка.КорректировкаЗадолженности") Тогда	
				
				СуммаЗадолженности   = Документ.Задолженность.Итог("Сумма"); 
				ВалютаВзаиморасчетов = Документ.Задолженность[0].ВалютаВзаиморасчетов;
				
				НоваяСтрока.ВалютаВзаиморасчетов = ВалютаВзаиморасчетов;
				НоваяСтрока.Сумма                = СуммаЗадолженности;
				НоваяСтрока.ОбъектРасчетов       = Справочники.ОбъектыРасчетов.НайтиПоРеквизиту("Объект", Настройки.Договор);
				
			КонецЕсли;
			
		КонецЦикла;
		
		Для Каждого Документ Из ДокументыКредитор Цикл
			
			НоваяСтрока = ДанныеДокумента.КредиторскаяЗадолженность.Добавить();
			
			НоваяСтрока.ТипРасчетов = Перечисления.ТипыРасчетовСПартнерами.РасчетыСПоставщиком;
			НоваяСтрока.Партнер     = Настройки.Партнер;
			НоваяСтрока.Организация = Настройки.Организация;
			
			Если ТипЗнч(Документ) = Тип("ДокументСсылка.ПриобретениеТоваровУслуг") Тогда
				
				РеквизитыДокумента = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Документ,
					"ВалютаВзаиморасчетов, СуммаДокумента, Договор, Соглашение");
				
				НоваяСтрока.ВалютаВзаиморасчетов = РеквизитыДокумента.Валюта;
				НоваяСтрока.Сумма                = РеквизитыДокумента.СуммаДокумента;
				
				ПорядокРасчетов = ВзаиморасчетыСервер.ПорядокРасчетов(Ложь, , РеквизитыДокумента.Соглашение, РеквизитыДокумента.Договор);
				
				Если ПорядокРасчетов = Перечисления.ПорядокРасчетов.ПоНакладным Тогда
					НоваяСтрока.ОбъектРасчетов = Справочники.ОбъектыРасчетов.НайтиПоРеквизиту("Объект", Документ);
				ИначеЕсли ПорядокРасчетов = Перечисления.ПорядокРасчетов.ПоДоговорамКонтрагентов Тогда
					НоваяСтрока.ОбъектРасчетов = Справочники.ОбъектыРасчетов.НайтиПоРеквизиту("Объект", РеквизитыДокумента.Договор);
				КонецЕсли;
				
			ИначеЕсли ТипЗнч(Документ) = Тип("ДокументСсылка.КорректировкаЗадолженности") Тогда	
				
				СуммаЗадолженности   = Документ.Задолженность.Итог("Сумма"); 
				ВалютаВзаиморасчетов = Документ.Задолженность[0].ВалютаВзаиморасчетов;
				
				НоваяСтрока.ВалютаВзаиморасчетов = ВалютаВзаиморасчетов;
				НоваяСтрока.Сумма                = СуммаЗадолженности;
				НоваяСтрока.ОбъектРасчетов       = Справочники.ОбъектыРасчетов.НайтиПоРеквизиту("Объект", Настройки.Договор);
				
			КонецЕсли;
			
		КонецЦикла;
		
