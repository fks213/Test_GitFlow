//+ ИнфоСофт Ивонин К.А. 20.02.23 УА #53535
Функция ПолучитьЗначенияСтатусовЗаказа() 
	
	РасширенныеВозможностиЗаказа = Константы.ИспользоватьРасширенныеВозможностиЗаказаКлиента.Получить();
	ИспользоватьПострочнуюОтгрузку = Константы.ИспользоватьПострочнуюОтгрузкуВЗаказеКлиента.Получить(); 
	
	Статусы = Новый Структура;
	
	Если РасширенныеВозможностиЗаказа И ИспользоватьПострочнуюОтгрузку Тогда
	               
		Статусы.Вставить("СтатусЗаказа", Перечисления.СтатусыЗаказовКлиентов.КОбеспечению);	
		Статусы.Вставить("СтатусСтроки", Перечисления.ВариантыОбеспечения.Отгрузить);
		
	ИначеЕсли РасширенныеВозможностиЗаказа И Не ИспользоватьПострочнуюОтгрузку Тогда
	
		Статусы.Вставить("СтатусЗаказа", Перечисления.СтатусыЗаказовКлиентов.КОтгрузке);	
		Статусы.Вставить("СтатусСтроки", Перечисления.ВариантыОбеспечения.Отгрузить);
		
	Иначе             
	
		Статусы.Вставить("СтатусЗаказа", Перечисления.СтатусыЗаказовКлиентов.НеСогласован);	
		Статусы.Вставить("СтатусСтроки", Перечисления.ВариантыОбеспечения.НеТребуется)
		
	КонецЕсли;
			
	Возврат Статусы;
	
КонецФункции //- ИнфоСофт Ивонин К.А. 20.02.23 УА #53535

//+ ИнфоСофт Ивонин К.А. 21.02.23 УА #53535
Функция ОрганизацияПименяетУСН(Организация)
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	НастройкиСистемыНалогообложенияСрезПоследних.СистемаНалогообложения КАК СистемаНалогообложения
	|ИЗ
	//+ ИнфоСофт Заварин К.В. 24.12.24 УА #90141
	//|	РегистрСведений.НастройкиСистемыНалогообложения.СрезПоследних(, Организация = &Организация) КАК НастройкиСистемыНалогообложенияСрезПоследних";
	|	РегистрСведений.НастройкиСистемыНалогообложения.СрезПоследних(&Период, Организация = &Организация) КАК НастройкиСистемыНалогообложенияСрезПоследних";
	//- ИнфоСофт Заварин К.В. 24.12.24 УА #90141
	
	Запрос.УстановитьПараметр("Организация", Организация);
	
	//+ ИнфоСофт Заварин К.В. 24.12.24 УА #90141
	Запрос.УстановитьПараметр("Период", ТекущаяДатаСеанса());
	//- ИнфоСофт Заварин К.В. 24.12.24 УА #90141
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Выборка = РезультатЗапроса.Выбрать();
	
	Если Выборка.Следующий() Тогда
	
		Если Выборка.СистемаНалогообложения = Перечисления.СистемыНалогообложения.Упрощенная Тогда
			Возврат Истина;
		Иначе
			Возврат Ложь;
		КонецЕсли;
		
	Иначе
		Возврат Неопределено;
	КонецЕсли;	
	
КонецФункции //- ИнфоСофт Ивонин К.А. 21.02.23 УА #53535

