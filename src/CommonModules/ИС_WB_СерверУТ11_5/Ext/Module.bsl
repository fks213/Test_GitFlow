		СтрокаЗадолженность.Партнер     = ДанныеОбработки.СтруктураДанных.Партнер;
		СтрокаЗадолженность.Сумма       = СуммаУдержаний;
		
		СтрокаДоходыРасходыАктивыПассивы = ДанныеКорректировки.ДоходыРасходыАктивыПассивы.Добавить();
		СтрокаДоходыРасходыАктивыПассивы.Статья        = НастройкиОК.СтатьяПрочихРасходов;
		СтрокаДоходыРасходыАктивыПассивы.Подразделение = ДанныеОбработки.СтруктураДанных.Подразделение;
		СтрокаДоходыРасходыАктивыПассивы.Сумма         = СуммаУдержаний;
		
		КорректировкаЗадолженности = СоздатьИзменитьКорректировкуЗадолженности(Профиль, ДанныеКорректировки);
		МассивДокументов.Добавить(КорректировкаЗадолженности);
		
	КонецЕсли;
	
	// Создание документа отчет комиссионера 
	ОтчетКомиссионера = СоздатьДокументОтчетКомиссионераNew(СтруктураДанных);
	МассивДокументов.Добавить(ОтчетКомиссионера.Ссылка);
	
	//Создание документов списания комиссионного товара по потерям
	Если ТаблицаПотерь.Количество() > 0 Тогда
		
		Если КомиссионныеПродажи25 Тогда
			
			ДанныеДокумента = ПолучитьСтруктуруОтчетаОСписанииТоваровУХранителя();
			
			ДанныеДокумента.Дата          		  = КонецДня(СтруктураДанных.ДатаОкончания);
			ДанныеДокумента.Партнер       		  = ДанныеОбработки.СтруктураДанных.Партнер;
			ДанныеДокумента.Контрагент    		  = ДанныеОбработки.СтруктураДанных.Контрагент;
			ДанныеДокумента.Соглашение    		  = ДанныеОбработки.СтруктураДанных.Соглашение;
			ДанныеДокумента.Организация           = ДанныеОбработки.СтруктураДанных.Организация;
			ДанныеДокумента.Договор               = ДанныеОбработки.СтруктураДанных.Договор;
			ДанныеДокумента.Комментарий           = ДанныеОбработки.СтруктураДанных.Комментарий;
			ДанныеДокумента.Подразделение         = ДанныеОбработки.СтруктураДанных.Подразделение;
			ДанныеДокумента.ХозяйственнаяОперация = ПолучитьХозОперациюСписаниеНедостачЗаСчетКомитента();
			ДанныеДокумента.СтатьяРасходов        = НастройкиОК.СтатьяПрочихРасходов;
			
			ДанныеДокумента.Товары = ТаблицаПотерь.Скопировать();
			
			ОтчетКомиссионераОСписании = СоздатьИзменитьОтчетОСписанииТоваровУХранителя(Профиль, ДанныеДокумента);
			
			Если Не ОтчетКомиссионераОСписании = Неопределено Тогда
				
				МассивДокументов.Добавить(ОтчетКомиссионераОСписании);
				
				Претензия = Неопределено;
				
				Если Константы.ФиксироватьПретензии.Получить() Тогда
					
					ДанныеЭлемента = ПолучитьСтруктуруПретензии();
					ЗаполнитьЗначенияСвойств(ДанныеЭлемента, ДанныеДокумента);
					
					ДанныеЭлемента.ДатаРегистрации		   = ДанныеДокумента.Дата;
	                ДанныеЭлемента.Наименование			   = ДанныеЭлемента.Комментарий;
					ДанныеЭлемента.ОписаниеПретензии	   = ДанныеЭлемента.Комментарий;
					ДанныеЭлемента.Сумма				   = СуммаКомпенсаций;
					ДанныеЭлемента.ЭтоПретензияПоставщику  = Истина;
					ДанныеЭлемента.ВестиРасчетыПоПретензии = Истина;
					
					Претензия = СоздатьИзменитьПретензиюКомиссионеру(Профиль, ДанныеЭлемента);
					
				КонецЕсли;
				
				ДанныеКорректировки = ПолучитьСтруктуруКорректировкиЗадолженности();
				
				ДанныеКорректировки.Дата          		     = КонецДня(СтруктураДанных.ДатаОкончания);
				ДанныеКорректировки.Комментарий   		     = ДанныеОбработки.СтруктураДанных.Комментарий;
				ДанныеКорректировки.Организация   		     = ДанныеОбработки.СтруктураДанных.Организация;
				ДанныеКорректировки.Контрагент   		     = ДанныеОбработки.СтруктураДанных.Контрагент;
				ДанныеКорректировки.Договор   		         = ДанныеОбработки.СтруктураДанных.Договор;
				ДанныеКорректировки.Соглашение   		     = ДанныеОбработки.СтруктураДанных.Соглашение;
				ДанныеКорректировки.ХозяйственнаяОперация    = ПолучитьХозОперациюСписаниеКредиторскойЗадолженности();
				ДанныеКорректировки.КорреспонденцияСДоходами = Истина;
				
				Если Не Претензия = Неопределено Тогда
					ДанныеКорректировки.Вставить("Претензия", Претензия);
				КонецЕсли;	 
					 
				СтрокаЗадолженность = ДанныеКорректировки.Задолженность.Добавить();
				СтрокаЗадолженность.ТипРасчетов = ПолучитьТипРасчетовСПартнерамиРасчетыСПоставщиком();
				СтрокаЗадолженность.Партнер     = ДанныеОбработки.СтруктураДанных.Партнер;
				СтрокаЗадолженность.Сумма       = СуммаКомпенсаций;
				
				СтрокаДоходыРасходыАктивыПассивы = ДанныеКорректировки.ДоходыРасходыАктивыПассивы.Добавить();
				СтрокаДоходыРасходыАктивыПассивы.Статья        = НастройкиОК.СтатьяПрочихДоходов;
				СтрокаДоходыРасходыАктивыПассивы.Подразделение = ДанныеОбработки.СтруктураДанных.Подразделение;
				СтрокаДоходыРасходыАктивыПассивы.Сумма         = СуммаКомпенсаций;
				
				КорректировкаЗадолженности = СоздатьИзменитьКорректировкуЗадолженности(Профиль, ДанныеКорректировки);
				МассивДокументов.Добавить(КорректировкаЗадолженности);
				
			КонецЕсли;
			
		Иначе	
			
			ТаблицаПотерь = СвернутьТаблицуПотерь(ТаблицаПотерь);
			
			СтруктураПотерь = Новый Структура;
			СтруктураПотерь.Вставить("ТаблицаПотерь", 		ТаблицаПотерь);
			СтруктураПотерь.Вставить("ОтчетКомиссионера", 	ОтчетКомиссионера.Ссылка);
			СтруктураПотерь.Вставить("Профиль", 			ДанныеОбработки.СтруктураДанных.Профиль);
			СтруктураПотерь.Вставить("СтатьяДоходов", 		НастройкиОК.СтатьяПрочихДоходов);
			СтруктураПотерь.Вставить("СтатьяРасходов", 		НастройкиОК.СтатьяПрочихРасходов);
			
			ОтчетКомиссионераОСписании = ПолучитьДокументСписанияТоваровКомиссионера(СтруктураПотерь);
			МассивДокументов.Добавить(ОтчетКомиссионераОСписании.Ссылка);
			
		КонецЕсли;
		
	КонецЕсли;	
	//- ИнфоСофт Власова И.С. 14.03.25 УА #83865	
	
	//Создание документа корректировки задолженности по браку
	Взаимозачет = Неопределено;
	Если СуммаБрака > 0 Тогда 
		
		//+ ИнфоСофт Заварин К.В. 14.10.24 УА #85478
		//Взаимозачет = ПолучитьДокументКорректировкиЗадолженности(ОтчетКомиссионера.Ссылка, СуммаБрака);    
		Взаимозачет = ПолучитьДокументКорректировкиЗадолженности(ДанныеОбработки.СтруктураДанных, ОтчетКомиссионера.Ссылка, СуммаБрака);
		//- ИнфоСофт Заварин К.В. 14.10.24 УА #85478
		
		МассивДокументов.Добавить(Взаимозачет.Ссылка);
	КонецЕсли;
	
	УстановитьПривилегированныйРежим(Ложь);
	
	Результат.Вставить("МассивДокументов", МассивДокументов);
	
	Возврат Результат;
	
КонецФункции //- ИнфоСофт Сумин Д.В. 01.03.2024 УА #71107

//+ ИнфоСофт Сумин Д.В. 05.03.2024 УА #71107
Функция СвернутьТаблицуПотерь(ТаблицаПотерь)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ТаблицаПотерь.Номенклатура КАК Номенклатура,
	|	ТаблицаПотерь.Характеристика КАК Характеристика,
	|	ТаблицаПотерь.ЭтоНабор КАК ЭтоНабор,
	|	ТаблицаПотерь.Сумма КАК Сумма,
	|	ТаблицаПотерь.Упаковка КАК Упаковка
	|ПОМЕСТИТЬ ВТ_Потери
	|ИЗ
	|	&ТаблицаПотерь КАК ТаблицаПотерь
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_Потери.Номенклатура КАК Номенклатура,
	|	ВТ_Потери.Характеристика КАК Характеристика,
	|	МАКСИМУМ(ВТ_Потери.ЭтоНабор) КАК ЭтоНабор,
	|	СУММА(ВТ_Потери.Сумма) КАК Сумма,
	|	МАКСИМУМ(ВТ_Потери.Упаковка) КАК Упаковка
	|ИЗ
	|	ВТ_Потери КАК ВТ_Потери
	|
	|СГРУППИРОВАТЬ ПО
	|	ВТ_Потери.Номенклатура,
	|	ВТ_Потери.Характеристика";
	
	Запрос.УстановитьПараметр("ТаблицаПотерь", ТаблицаПотерь);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Возврат РезультатЗапроса.Выгрузить();
	
КонецФункции //- ИнфоСофт Сумин Д.В. 05.03.2024 УА #71107

//+ ИнфоСофт Сумин Д.В. 28.02.2024 УА #71107
Функция ПодготовитьДанныеОПродажах(ДанныеОбработки) Экспорт
	
	//Получение данных продаж
	ДанныеПродаж = ДанныеОбработки.СтруктураДанных.СписокТранзакций;
	ВидОтчета = ДанныеОбработки.СтруктураДанных.ВидОтчета; 
	Профиль = ДанныеОбработки.СтруктураДанных.Профиль;
	
	МассивКолонок = Новый Массив;
	
	Для Каждого Элемент Из ДанныеПродаж.Колонки Цикл
		МассивКолонок.Добавить(Элемент.Имя);	
	КонецЦикла;	
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ИС_WB_ДанныеОтчетовОПродажах.Параметр КАК Параметр,
	|	ИС_WB_ДанныеОтчетовОПродажах.Параметр.Наименование КАК ПараметрНаименование,
	|	ИС_WB_ДанныеОтчетовОПродажах.ЗначениеПараметра КАК ЗначениеПараметра,
	|	ИС_WB_ДанныеОтчетовОПродажах.СтрокаНомер КАК СтрокаНомер,
	|	ИС_WB_ДанныеОтчетовОПродажах.Профиль КАК Профиль,
	|	ИС_WB_ДанныеОтчетовОПродажах.НомерОтчета КАК НомерОтчета
	|ИЗ
	|	РегистрСведений.ИС_WB_ДанныеОтчетовОПродажах КАК ИС_WB_ДанныеОтчетовОПродажах
	|ГДЕ
	|	ИС_WB_ДанныеОтчетовОПродажах.НомерОтчета = &НомерОтчета
	|   И ИС_WB_ДанныеОтчетовОПродажах.Параметр.Наименование В (&МассивНаименований)
	|
	|УПОРЯДОЧИТЬ ПО
	|	СтрокаНомер
	|ИТОГИ ПО
	|	СтрокаНомер";
	
	Запрос.УстановитьПараметр("НомерОтчета", ДанныеОбработки.СтруктураДанных.НомерОтчета); 
	Запрос.УстановитьПараметр("МассивНаименований", МассивКолонок);
	Запрос.УстановитьПараметр("Профиль", ДанныеОбработки.СтруктураДанных.Профиль);
	
	РезультатЗапроса = Запрос.Выполнить(); 
	
	ВыборкаСтрокаНомер = РезультатЗапроса.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	Пока ВыборкаСтрокаНомер.Следующий() Цикл
		НоваяСтрока = ДанныеПродаж.Добавить();
		
		НоваяСтрока.ВидОтчета = ВидОтчета;
		ВыборкаДетальныеЗаписи = ВыборкаСтрокаНомер.Выбрать();
		
		Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
			Если ДанныеПродаж.Колонки.Найти(ВыборкаДетальныеЗаписи.ПараметрНаименование) <> Неопределено Тогда
				НоваяСтрока[ВыборкаДетальныеЗаписи.ПараметрНаименование] = ВыборкаДетальныеЗаписи.ЗначениеПараметра; 			
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	
	//Добавление сопоставления
	Запрос = Новый Запрос;
	Запрос.Текст = 
	
	//+ ИнфоСофт Мурсалимов Д.Р. 08.10.24 УА #84956
	"ВЫБРАТЬ
	|	ДанныеПродаж.ЦенаРеализация КАК ЦенаРеализация,
	|	ДанныеПродаж.Кол_во КАК Кол_во,
	|	ДанныеПродаж.ЦенаРозничная КАК ЦенаРозничная,
	|	ДанныеПродаж.ВайлдберризРеализовалТовар_Пр_ КАК ВайлдберризРеализовалТовар_Пр_,
	|	ДанныеПродаж.Название КАК Название,
	|	ДанныеПродаж.Баркод КАК Баркод,
	|	ДанныеПродаж._ КАК _,
	|	ДанныеПродаж.КодНоменклатуры КАК КодНоменклатуры,
	|	ДанныеПродаж.АртикулПоставщика КАК АртикулПоставщика,
	|	ДанныеПродаж.Размер КАК Размер,
	|	ДанныеПродаж.ТипДокумента КАК ТипДокумента,
	|	ДанныеПродаж.ОбоснованиеДляОплаты КАК ОбоснованиеДляОплаты,
	|	ДанныеПродаж.КПеречислениюПродавцуЗаРеализованныйТовар КАК КПеречислениюПродавцуЗаРеализованныйТовар,
	|	ДанныеПродаж.УслугиПоДоставкеТовараПокупателю КАК УслугиПоДоставкеТовараПокупателю,
	|	ДанныеПродаж.ВидыЛогистики_ШтрафовИДоплат КАК ВидыЛогистики_ШтрафовИДоплат,
	|	ДанныеПродаж.Srid КАК Srid,
	|	ДанныеПродаж.ВидОтчета КАК ВидОтчета
	|ПОМЕСТИТЬ ВТ_ДанныеПродаж
	|ИЗ
	|	&ДанныеПродаж КАК ДанныеПродаж
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_ДанныеПродаж.Баркод КАК Баркод,
	|	МАКСИМУМ(ЕСТЬNULL(ИС_WB_ШтрихкодыРазмеров.Размер, ЗНАЧЕНИЕ(Справочник.ИС_WB_РазмерыНоменклатур.ПустаяСсылка))) КАК Размер
	|ПОМЕСТИТЬ ВТ_Размеры
	|ИЗ
	|	ВТ_ДанныеПродаж КАК ВТ_ДанныеПродаж
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ИС_WB_ШтрихкодыРазмеров КАК ИС_WB_ШтрихкодыРазмеров
	|		ПО ВТ_ДанныеПродаж.Баркод = ИС_WB_ШтрихкодыРазмеров.Штрихкод
	|			И (ИС_WB_ШтрихкодыРазмеров.Профиль = &Профиль)
	|
	|СГРУППИРОВАТЬ ПО
	|	ВТ_ДанныеПродаж.Баркод
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_Размеры.Баркод КАК Баркод,
	|	МАКСИМУМ(ЕСТЬNULL(ИС_WB_СоответствиеРазмеров.Номенклатура, ЗНАЧЕНИЕ(Справочник.Номенклатура.ПустаяСсылка))) КАК Номенклатура,
	|	МАКСИМУМ(ЕСТЬNULL(ИС_WB_СоответствиеРазмеров.Характеристика, ЗНАЧЕНИЕ(Справочник.ХарактеристикиНоменклатуры.ПустаяСсылка))) КАК Характеристика,
	|	МАКСИМУМ(ВЫБОР
	|			КОГДА ИС_WB_СоответствиеРазмеров.Номенклатура.ТипНоменклатуры = ЗНАЧЕНИЕ(Перечисление.ТипыНоменклатуры.Набор)
	|				ТОГДА ИСТИНА
	|			ИНАЧЕ ЛОЖЬ
	|		КОНЕЦ) КАК ЭтоНабор,
	|	МАКСИМУМ(ИС_WB_СоответствиеРазмеров.Упаковка) КАК Упаковка,
	|	МАКСИМУМ(ВЫБОР
	|			КОГДА ИС_WB_СоответствиеРазмеров.Упаковка ЕСТЬ NULL
	|					ИЛИ ИС_WB_СоответствиеРазмеров.Упаковка.Числитель = 0
	|				ТОГДА 1
	|			ИНАЧЕ ИС_WB_СоответствиеРазмеров.Упаковка.Числитель
	|		КОНЕЦ / ВЫБОР
	|			КОГДА ИС_WB_СоответствиеРазмеров.Упаковка ЕСТЬ NULL
	|					ИЛИ ИС_WB_СоответствиеРазмеров.Упаковка.Знаменатель = 0
	|				ТОГДА 1
	|			ИНАЧЕ ИС_WB_СоответствиеРазмеров.Упаковка.Знаменатель
	|		КОНЕЦ) КАК КоэффициентУпаковки
	|ПОМЕСТИТЬ ВТ_Сопоставление
	|ИЗ
	|	ВТ_Размеры КАК ВТ_Размеры
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ИС_WB_СоответствиеРазмеров КАК ИС_WB_СоответствиеРазмеров
	|		ПО ВТ_Размеры.Размер = ИС_WB_СоответствиеРазмеров.РазмерWB
	|			И (ИС_WB_СоответствиеРазмеров.Профиль = &Профиль)
	|
	|СГРУППИРОВАТЬ ПО
	|	ВТ_Размеры.Баркод
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_Размеры.Размер КАК РазмерВБ,
	|	ВТ_Сопоставление.Номенклатура КАК Номенклатура,
