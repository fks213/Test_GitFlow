	//- ИнфоСофт Мурсалимов Д.Р. 07.10.24 УА #84813
	//- ИнфоСофт Конышев А.Е. 26.11.24 УА #88616	
	
	//+ ИнфоСофт Тимофеева А.А. 09.04.2025 УА #97337
	//ПродажаОблагаетсяНДС = ПолучитьРезультатПроверкиУчетаНДС(Профиль.Организация);
	//- ИнфоСофт Тимофеева А.А. 09.04.2025 УА #97337
	
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("Партнер", Профиль.Партнер);
	ПараметрыФормы.Вставить("Контрагент", Профиль.Контрагент);
	
	Если КомиссионнаяОперация Тогда
		ПараметрыФормы.Вставить("Договор", Профиль.Договор);
		Документ.Заполнить(ПараметрыФормы);
		Документ.Договор = Профиль.Договор; 
		Документ.Соглашение = Профиль.Соглашение;
		Документ.ХозяйственнаяОперация = Перечисления.ХозяйственныеОперации.ПередачаНаКомиссию;
	Иначе
		ПараметрыФормы.Вставить("Договор", Профиль.ДоговорРеализации);
		Документ.Заполнить(ПараметрыФормы);
		Документ.Договор = Профиль.ДоговорРеализации; 
		Документ.Соглашение = Профиль.СоглашениеРеализации;
		Документ.ХозяйственнаяОперация = Перечисления.ХозяйственныеОперации.РеализацияКлиенту;
	КонецЕсли;
	
	//+ ИнфоСофт Сумин Д.В. 22.03.2024 УА #70680	
	ИспользоватьСоглашенияСКлиентами = ПолучитьФункциональнуюОпцию("ИспользоватьСоглашенияСКлиентами");
	ИспользоватьДоговорыСКлиентами = ПолучитьФункциональнуюОпцию("ИспользоватьДоговорыСКлиентами");
	
	ЗаполнитьВалюту = Истина;
	
	Если ИспользоватьСоглашенияСКлиентами Тогда 
		Валюта = Профиль.Соглашение.Валюта;
		ЗаполнитьВалюту = Ложь;
	КонецЕсли;
	
	Если ЗаполнитьВалюту И ИспользоватьДоговорыСКлиентами Тогда 
		Валюта = Профиль.Договор.ВалютаВзаиморасчетов;
	КонецЕсли;
	
	Документ.Валюта = Валюта;

	//+ ИнфоСофт Сумин Д.В. 17.07.2023 УА #60941
	//Документ.Валюта = Документ.Договор.ВалютаВзаиморасчетов;
	//
	//Документ.ВалютаВзаиморасчетов = Документ.Договор.ВалютаВзаиморасчетов;
	//- ИнфоСофт Сумин Д.В. 17.07.2023 УА #60941
	//- ИнфоСофт Сумин Д.В. 22.03.2024 УА #70680
	
	Документ.Контрагент = Профиль.Контрагент;
	
	Документ.Комментарий = ЗаголовокСтруктура.Комментарий;
	
	Документ.Организация = Профиль.Организация;    
	
	Документ.Склад = Профиль.Склад; 
		
	Документ.Подразделение = Профиль.Подразделение;
	
