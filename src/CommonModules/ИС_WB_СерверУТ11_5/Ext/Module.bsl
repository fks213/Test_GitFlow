		//- ИнфоСофт Заварин К.В. 04.10.24 УА #85085		 
		
		//+ ИнфоСофт Заварин К.В. 04.10.24 УА #85085
		//Если ИспользоватьДоговорыСКлиентами И 
		//	(Не ИспользоватьСоглашенияСКлиентами И Не ЗначениеЗаполнено(Выборка.Договор))
		//	Или (Не ЗначениеЗаполнено(Выборка.Договор) И ИспользоватьСоглашенияСКлиентами И ЗначениеЗаполнено(Выборка.Соглашение) И Выборка.СоглашениеИспользуютсяДоговорыКонтрагентов) Тогда
		Если ИспользоватьДоговорыСПоставщиками И 
			(Не ИспользоватьСоглашенияСПоставщиками И Не ЗначениеЗаполнено(Выборка.ДоговорЗакупки))
			Или (Не ЗначениеЗаполнено(Выборка.ДоговорЗакупки) И ИспользоватьСоглашенияСПоставщиками 
			И ЗначениеЗаполнено(Выборка.СоглашениеЗакупки) И Выборка.СоглашениеИспользуютсяДоговорыКонтрагентов) Тогда
		//- ИнфоСофт Заварин К.В. 04.10.24 УА #85085
			
			МассивНезаполненныхНастроек.Добавить(НСтр("ru = 'Договор закупки'"));
			
		КонецЕсли;
		
		ИспользоватьПодразделения = ПолучитьФункциональнуюОпцию("ИспользоватьПодразделения");
		
		Если ИспользоватьПодразделения И Выборка.РаспределятьРасходыПоАртикулам И Не ЗначениеЗаполнено(Выборка.Подразделение) Тогда
			МассивНезаполненныхНастроек.Добавить(НСтр("ru = 'Подразделение'"));
		КонецЕсли;	
		
		Если МассивНезаполненныхНастроек.Количество() > 0 Тогда
			
			РезультатПроверки = Ложь;
			
			Для Каждого Настройка Из МассивНезаполненныхНастроек Цикл
				ИС_MP_Сервер.ПоказатьСообщениеОтсутствияЗаполненияНастройки(Настройка, Профиль, Маркетплейс); 
			КонецЦикла;
			
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат РезультатПроверки;	
	
КонецФункции //- ИнфоСофт Власова И.С. 22.08.24 УА #61503

//+ ИнфоСофт Власова И.С. 14.03.25 УА #68471
Функция СоздатьИзменитьКорректировкуЗадолженности(Профиль, ДанныеДокумента, ДопПараметры = Неопределено) Экспорт
	
	Если ТипЗнч(ДопПараметры) = Тип("Структура") И ДопПараметры.Свойство("ДокументСсылка") Тогда
		ДокументОбъект = ДопПараметры.ДокументСсылка.ПолучитьОбъект();
	Иначе	
		ДокументОбъект = Документы.КорректировкаЗадолженности.СоздатьДокумент();
	КонецЕсли;
	
	ЗаполнитьЗначенияСвойств(ДокументОбъект, ДанныеДокумента);
	
	ДокументОбъект.Автор = Пользователи.АвторизованныйПользователь();
	
	ДокументОбъект.Задолженность.Очистить();
	
	ПорядокРасчетов = ВзаиморасчетыСервер.ПорядокРасчетов(Ложь, , ДанныеДокумента.Соглашение, ДанныеДокумента.Договор);
	
	Валюты = ПолучитьВалютыЗаполненияДокумента(ДанныеДокумента.Организация, ДанныеДокумента.Договор, ДанныеДокумента.Соглашение);
	
	Валюта = Валюты.Валюта;
	ВалютаВзаиморасчетов = Валюты.ВалютаВзаиморасчетов;		
	
	Для Каждого Строка Из ДанныеДокумента.Задолженность Цикл
		
		НоваяСтрока = ДокументОбъект.Задолженность.Добавить();
		
		НоваяСтрока.ТипРасчетов          = Строка.ТипРасчетов;
		НоваяСтрока.Партнер              = Строка.Партнер;
		НоваяСтрока.ВалютаВзаиморасчетов = ВалютаВзаиморасчетов;
		НоваяСтрока.Сумма                = Строка.Сумма;
		
		Если ЗначениеЗаполнено(ДокументОбъект.Претензия) Тогда
			
			НоваяСтрока.ОбъектРасчетов = Справочники.ОбъектыРасчетов.НайтиПоРеквизиту("Объект", ДокументОбъект.Претензия);
			Продолжить;
			
		КонецЕсли;
		
		Если ПорядокРасчетов = Перечисления.ПорядокРасчетов.ПоНакладным 
			И ДопПараметры.Свойство("ДокументНакладная") Тогда
			
			НоваяСтрока.ОбъектРасчетов = ОбъектыРасчетовСервер.ПолучитьОбъектРасчетовПоСсылке(ДопПараметры.ДокументНакладная, ДанныеДокумента.Организация);
			
		Иначе
			НоваяСтрока.ОбъектРасчетов = ОбъектыРасчетовСервер.ПолучитьОбъектРасчетовПоСсылке(ДанныеДокумента.Договор, ДанныеДокумента.Организация);
		КонецЕсли;
		
	КонецЦикла;
	
	ДокументОбъект.ДоходыРасходыАктивыПассивы.Очистить();
	
	Для Каждого Строка Из ДанныеДокумента.ДоходыРасходыАктивыПассивы Цикл
		
		НоваяСтрока = ДокументОбъект.ДоходыРасходыАктивыПассивы.Добавить();
		
		НоваяСтрока.Статья        = Строка.Статья;
		НоваяСтрока.Подразделение = Строка.Подразделение;
		НоваяСтрока.Валюта        = Валюта;
		НоваяСтрока.Сумма         = Строка.Сумма;
		
		Если ЗначениеЗаполнено(Строка.Статья) Тогда
			
			РеквизитыСтатьи = ДоходыИРасходыВызовСервераПовтИсп.ЗначенияРеквизитовСтатьи(Строка.Статья);
			
			Аналитика = ДоходыИРасходыКлиентСервер.ПолучитьАналитикуПоУмолчанию(РеквизитыСтатьи, ДокументОбъект.Ссылка);
			
			ТипЗначенияСтатьи = ТипЗнч(НоваяСтрока.Статья);
			
			Если ТипЗначенияСтатьи = Тип("ПланВидовХарактеристикСсылка.СтатьиРасходов") Тогда
				НоваяСтрока.АналитикаРасходов        = Аналитика;
			ИначеЕсли ТипЗначенияСтатьи = Тип("ПланВидовХарактеристикСсылка.СтатьиДоходов") Тогда
				НоваяСтрока.АналитикаДоходов         = Аналитика;
			Иначе
				НоваяСтрока.АналитикаАктивовПассивов = Аналитика;
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЦикла;
	
	Попытка	
		ДокументОбъект.Записать(РежимЗаписиДокумента.Проведение);	
	Исключение
		
		ТекстСообщения = "Не удалось провести документ корректировки задолженности.";
		ТекстОшибки    = ОписаниеОшибки();
		ОбщегоНазначения.СообщитьПользователю(СтрШаблон("%1|%2", ТекстСообщения, ТекстОшибки));
		
		Попытка	
			ДокументОбъект.Записать(РежимЗаписиДокумента.Запись);	
		Исключение
			
			ТекстСообщения = "Не удалось записать документ корректировки задолженности.";
			ТекстОшибки    = ОписаниеОшибки();
			ОбщегоНазначения.СообщитьПользователю(СтрШаблон("%1|%2", ТекстСообщения, ТекстОшибки));
			
			Возврат Неопределено;
			
		КонецПопытки;
		
	КонецПопытки;
	
	Возврат ДокументОбъект.Ссылка; 
	
КонецФункции //- ИнфоСофт Власова И.С. 14.03.25 УА #68471

