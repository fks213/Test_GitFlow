	СгруппироватьПоНоменклатуре = ДанныеОбработки.СтруктураДанных.СгруппироватьПоНоменклатуре;
	
	СписыватьУтраченныеТовары   = ?(НастройкиОК.СписыватьУтраченныеТовары = Неопределено, Ложь, НастройкиОК.СписыватьУтраченныеТовары);
	ОприходоватьНайденныеТовары = ?(НастройкиОК.ОприходоватьНайденныеТовары = Неопределено, Ложь, НастройкиОК.ОприходоватьНайденныеТовары);
	
	СуммаУдержаний   = 0;
	СуммаКомпенсаций = 0;
	//- ИнфоСофт Власова И.С. 14.03.25 УА #83865
	
	Для Каждого Строка Из СписокТранзакций Цикл
		
		Коэффициент = -1;
		
		Если НРег(Строка.ТипДокумента) = "продажа" Тогда	
			Коэффициент = 1;
		КонецЕсли;
		
		Если Нрег(Строка.ОбоснованиеДляОплаты) = "частичная компенсация брака" 
			Или Нрег(Строка.ОбоснованиеДляОплаты) = "оплата брака" Тогда  
