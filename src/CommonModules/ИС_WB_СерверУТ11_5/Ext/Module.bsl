		Если РассчитатьКомиссионноеВознаграждение Тогда 
			Итератор = Итератор + 1;
		КонецЕсли;
		
	КонецЦикла;
	//- ИнфоСофт Мурсалимов Д.Р. 01.11.24 УА #85693
	
	//+ ИнфоСофт Власова И.С. 03.04.25 УА #98046
	Если РассчитатьКомиссионноеВознаграждение Тогда
		
		ПогрешностьКомиссии = СуммаУслугВБ - ДокОтчет.Товары.Итог("СуммаВознаграждения");
		
		Если Не ПогрешностьКомиссии = 0 Тогда	
			
			Для Каждого Строка Из ДокОтчет.Товары Цикл	
				
				Если Строка.Количество > 0 И Строка.СуммаВознаграждения > ПогрешностьКомиссии Тогда	
					Строка.СуммаВознаграждения = Строка.СуммаВознаграждения + ПогрешностьКомиссии;
					Прервать;	
				КонецЕсли;
				
			КонецЦикла;
			
		КонецЕсли;
		
	КонецЕсли;
	//- ИнфоСофт Власова И.С. 03.04.25 УА #98046
	
	ДокОтчет.СуммаДокумента = СуммаДокумента;
	Если РассчитатьКомиссионноеВознаграждение Тогда 
		ДокОтчет.СуммаВознаграждения = СтруктураДанных.СуммаУслугВБ;
		ДокОтчет.ПроцентВознаграждения = ДокОтчет.СуммаВознаграждения * 100 / ДокОтчет.СуммаДокумента;
		ДокОтчет.Услуга = СтруктураДанных.НоменклатураУслугиВБ;
		Если ПродажаОблагаетсяНДС Тогда
			ДокОтчет.СтавкаНДСВознаграждения = СтруктураДанных.НоменклатураУслугиВБ.СтавкаНДС;
			ДокОтчет.СуммаНДСВознаграждения = РассчитатьСуммуНДС(ДокОтчет.СуммаВознаграждения, СтруктураДанных.НоменклатураУслугиВБ.СтавкаНДС.Ставка, Истина);		
		Иначе
			ДокОтчет.СтавкаНДСВознаграждения = Справочники.СтавкиНДС.НайтиПоНаименованию("Без НДС");
			ДокОтчет.СуммаНДСВознаграждения = 0;
		КонецЕсли;	
	КонецЕсли;
	
	//+ ИнфоСофт Мурсалимов Д.Р. 25.02.25 УА #92506
	////+ Инфосотф Сумин Д.В. 25.04.2024 УА #72843
	//СтруктураДействий = Новый Структура;
	//СтруктураДействий.Вставить("ПересчитатьСуммуНДС", ОбработкаТабличнойЧастиКлиентСервер.ПараметрыПересчетаСуммыНДСВСтрокеТЧ(ДокОтчет));	
	//СтруктураДействий.Вставить("ПересчитатьСуммуПродажиНДС");
	//ОбработкаТабличнойЧастиСервер.ОбработатьТЧ(ДокОтчет.Товары, СтруктураДействий, Неопределено);
	////- Инфосотф Сумин Д.В. 25.04.2024 УА #72843
	
	СтруктураДействий = Новый Структура;
	СтруктураДействий.Вставить("СкорректироватьСтавкуНДС", ОбработкаТабличнойЧастиКлиентСервер.ПараметрыЗаполненияСтавкиНДС(ДокОтчет));
	
	ОбработкаТабличнойЧастиСервер.ОбработатьТЧ(ДокОтчет.Товары, СтруктураДействий, Неопределено);
	//- ИнфоСофт Мурсалимов Д.Р. 25.02.25 УА #92506
	
	//+ ИнфоСофт Мурсалимов Д.Р. 24.04.25 УА #99478
	ДокументЗаписан = Ложь;
	
	Если СтруктураДанных.ВариантСозданияОтчета = Истина Тогда
		
		Попытка
			ДокОтчет.Записать(РежимЗаписиДокумента.Проведение);
			ДокументЗаписан = Истина;
		Исключение
			ДокОтчет.Записать();
			ДокументЗаписан = Истина;
		КонецПопытки;
		
	Иначе
		
		ДокОтчет.Записать();
		ДокументЗаписан = Истина;
		
	КонецЕсли;
	
	Если СтруктураДанных.Свойство("ОчиститьРегистрыОК") И СтруктураДанных.ОчиститьРегистрыОК Тогда
		
		Если СтруктураДанных.Свойство("НомерОтчета")
			И ЗначениеЗаполнено(СтруктураДанных.НомерОтчета)
			И ДокументЗаписан Тогда
			
			НаборЗаписей = РегистрыСведений.ИС_WB_ДанныеОтчетовОПродажах.СоздатьНаборЗаписей();
			
			НаборЗаписей.Отбор.Профиль.Установить(СтруктураДанных.Профиль); 
			НаборЗаписей.Отбор.НомерОтчета.Установить(СтруктураДанных.НомерОтчета);
			
			НаборЗаписей.Записать();
			
		КонецЕсли;  
		
	КонецЕсли;
	//- ИнфоСофт Мурсалимов Д.Р. 24.04.25 УА #99478
	
	Возврат ДокОтчет.Ссылка;
	
КонецФункции //- ИнфоСофт Сумин Д.В. 04.03.2024 УА #71107

//+ ИнфоСофт Сумин Д.В. 05.03.2024 УА #71107
Функция ПолучитьДокументСписанияТоваровКомиссионера(СтруктураДанных)
	
	Профиль 		= СтруктураДанных.Профиль;
	ДокОтчет 		= СтруктураДанных.ОтчетКомиссионера; 
	ТаблицаПотерь 	= СтруктураДанных.ТаблицаПотерь;
	
	ДокументСписания = Документы.ОтчетКомиссионераОСписании.СоздатьДокумент();
	
	ДокументСписания.Дата = ДокОтчет.Дата;
	
	ДокументСписания.Организация = ДокОтчет.Организация;
	
	ДокументСписания.Партнер = ДокОтчет.Партнер;
	
	ДокументСписания.Контрагент = ДокОтчет.Контрагент; 
	
	ДокументСписания.Соглашение = ДокОтчет.Соглашение;
	
	ДокументСписания.Валюта = ДокОтчет.Валюта;
	
	ДокументСписания.НалогообложениеНДС = ДокОтчет.НалогообложениеНДС;
	
	ДокументСписания.ЦенаВключаетНДС = ДокОтчет.ЦенаВключаетНДС;
	
	ДокументСписания.ДатаПлатежа = ТекущаяДатаСеанса();
	
	ДокументСписания.Договор = ДокОтчет.Договор; 
	
	ДокументСписания.ПорядокРасчетов = ДокОтчет.ПорядокРасчетов;
	
	ДокументСписания.ПорядокРасчетов = ДокОтчет.ПорядокРасчетов;
	
	Если ДокументСписания.НалогообложениеНДС = Перечисления.ТипыНалогообложенияНДС.ПродажаОблагаетсяНДС Тогда
		ПродажаОблагаетсяНДС = Истина;
	Иначе
		ПродажаОблагаетсяНДС = Ложь;
	КонецЕсли;	
	
	//+ ИнфоСофт Власова И.С. 14.03.25 УА #83865
	ДокументСписания.СтатьяДоходов  = СтруктураДанных.СтатьяДоходов;
	ДокументСписания.СтатьяРасходов = СтруктураДанных.СтатьяРасходов;
	//- ИнфоСофт Власова И.С. 14.03.25 УА #83865
	
	Для Каждого Элемент Из ТаблицаПотерь Цикл
		
		Если Элемент.ЭтоНабор Тогда
			
			//+ ИнфоСофт Мурсалимов Д.Р. 11.11.24 УА #85693
			//ТоварыНабора = ПолучитьТаблицуТоваровНабораNew(Элемент.Номенклатура, Элемент.Характеристика, Профиль);
			ТоварыНабора = ПолучитьТаблицуТоваровНабораNew(Профиль, Элемент.Номенклатура, Элемент.Характеристика);	
			//- ИнфоСофт Мурсалимов Д.Р. 11.11.24 УА #85693 
			
			Если ТоварыНабора[0].ВариантРасчетаЦены = Перечисления.ВариантыРасчетаЦенНаборов.РассчитываетсяИзЦенКомплектующих Или
				ТоварыНабора[0].ВариантРасчетаЦены = Перечисления.ВариантыРасчетаЦенНаборов.ЦенаЗадаетсяЗаНаборРаспределяетсяПоЦенам Тогда
				
				МассивКоэффициентов = РассчитатьКоэффициентыИзЦен(ТоварыНабора.ВыгрузитьКолонку("КомплектующиеЦена"), Элемент.Номенклатура);
			Иначе
				МассивКоэффициентов = ТоварыНабора.ВыгрузитьКолонку("ДоляСтоимости");
			КонецЕсли;
			
			СуммыПродажи = ОбщегоНазначения.РаспределитьСуммуПропорциональноКоэффициентам(Элемент.Сумма, МассивКоэффициентов);
				
	  		Для Каждого ЭлементНабора Из ТоварыНабора Цикл 
				
				НоваяСтрока = ДокументСписания.Товары.Добавить();
				
				НоваяСтрока.Номенклатура = ЭлементНабора.Номенклатура;
				НоваяСтрока.Характеристика = ЭлементНабора.Характеристика;
				НоваяСтрока.Количество = ЭлементНабора.КоличествоУпаковок;
				НоваяСтрока.КоличествоУпаковок = ЭлементНабора.КоличествоУпаковок;
								
				НоваяСтрока.Цена = СуммыПродажи[0] / ЭлементНабора.КоличествоУпаковок;
				НоваяСтрока.Сумма = СуммыПродажи[0];
				НоваяСтрока.СуммаСНДС = СуммыПродажи[0];			 
				НоваяСтрока.СтавкаНДС = ЭлементНабора.Номенклатура.СтавкаНДС;
				НоваяСтрока.Упаковка = ЭлементНабора.Упаковка;
				
				СуммыПродажи.Удалить(0);
	
			КонецЦикла;	
		Иначе	
			НоваяСтрока = ДокументСписания.Товары.Добавить();
			НоваяСтрока.Номенклатура = Элемент.Номенклатура;
			НоваяСтрока.Характеристика = Элемент.Характеристика;
			НоваяСтрока.Упаковка = Элемент.Упаковка;
			НоваяСтрока.КоличествоУпаковок = 1;
			Если Элемент.Упаковка.Числитель = 0 Тогда
				НоваяСтрока.Количество = 1;	
			Иначе	
				НоваяСтрока.Количество = Элемент.Упаковка.Числитель; 
			КонецЕсли;
			НоваяСтрока.Цена = Элемент.Сумма;
			НоваяСтрока.Сумма = Элемент.Сумма;
			НоваяСтрока.СуммаСНДС = Элемент.Сумма;
			НоваяСтрока.СтавкаНДС = Элемент.Номенклатура.СтавкаНДС;
		КонецЕсли;
	КонецЦикла;	
	
	Если ПродажаОблагаетсяНДС Тогда 
		СтруктураДействий = Новый Структура;
		СтруктураДействий.Вставить("ПересчитатьСуммуНДС", ОбработкаТабличнойЧастиКлиентСервер.ПараметрыПересчетаСуммыНДСВСтрокеТЧ(ДокументСписания));	
		ОбработкаТабличнойЧастиСервер.ОбработатьТЧ(ДокументСписания.Товары, СтруктураДействий, Неопределено);	
	КонецЕсли;	
	
	Попытка
		ДокументСписания.Записать(РежимЗаписиДокумента.Проведение);	
	Исключение	
		ДокументСписания.Записать(РежимЗаписиДокумента.Запись);
	КонецПопытки;
	
	Возврат ДокументСписания;
	
КонецФункции //- ИнфоСофт Сумин Д.В. 05.03.2024 УА #71107

//+ ИнфоСофт Сумин Д.В. 05.03.2024 УА #69374
//+ ИнфоСофт Заварин К.В. 14.10.24 УА #85478 
//Добавлена Структура данных 
Функция ПолучитьДокументКорректировкиЗадолженности(СтруктураДанных, ДокОтчет, Сумма) Экспорт 
//- ИнфоСофт Заварин К.В. 14.10.24 УА #85478  
	
	Корректировка = Документы.КорректировкаЗадолженности.СоздатьДокумент();	
	
	Корректировка.Дата = ДокОтчет.Дата;
	
	Корректировка.Организация = ДокОтчет.Организация;
	
	Корректировка.Контрагент = ДокОтчет.Контрагент;
	
	Корректировка.ХозяйственнаяОперация = Перечисления.ХозяйственныеОперации.НачислениеДебиторскойЗадолженности; 
	
	Корректировка.ЭтоНачисление = Истина;
	
	Корректировка.КорреспонденцияСДоходами = Ложь;
	
	Корректировка.РасчетыМеждуОрганизациями = Ложь;
	
	СтрокаТЧ = Корректировка.Задолженность.Добавить();
	
	СтрокаТЧ.ТипРасчетов = Перечисления.ТипыРасчетовСПартнерами.РасчетыСКлиентом;
	
	СтрокаТЧ.Партнер = Докотчет.Партнер;
	
	СтрокаТЧ.ВалютаВзаиморасчетов = Докотчет.Валюта; 
	
	СтрокаТЧ.Сумма = Сумма;
	
	//+ ИнфоСофт Заварин К.В. 14.10.24 УА #85478
	Если СтруктураДанных.Свойство("СтатьяЗадолженности") И ЗначениеЗаполнено(СтруктураДанных.СтатьяЗадолженности) Тогда
		
		СтрокаТЧРасчет = Корректировка.ДоходыРасходыАктивыПассивы.Добавить();
		
		СтрокаТЧРасчет.Статья = СтруктураДанных.СтатьяЗадолженности;
		
		//+ ИнфоСофт Власова И.С. 14.03.25 УА #89596
		СтрокаТЧРасчет.Подразделение = СтруктураДанных.Подразделение;
		
		Если ТипЗнч(СтрокаТЧРасчет.Статья) = Тип("ПланВидовХарактеристикСсылка.СтатьиРасходов") Тогда
			
			РеквизитыСтатьи = ДоходыИРасходыВызовСервераПовтИсп.ЗначенияРеквизитовСтатьи(СтрокаТЧРасчет.Статья);
			СтрокаТЧРасчет.АналитикаРасходов = ДоходыИРасходыКлиентСервер.ПолучитьАналитикуПоУмолчанию(РеквизитыСтатьи, Корректировка);
			
		КонецЕсли;
		//- ИнфоСофт Власова И.С. 14.03.25 УА #89596
		
	КонецЕсли;	
	//- ИнфоСофт Заварин К.В. 14.10.24 УА #85478

	
	Если ЗначениеЗаполнено(ДокОтчет.Соглашение) И ЗначениеЗаполнено(ДокОтчет.Соглашение.ПорядокРасчетов) Тогда
		ПорядокРасчетов = ДокОтчет.Соглашение.ПорядокРасчетов;
	Иначе
		ПорядокРасчетов = ДокОтчет.Договор.ПорядокРасчетов;	
	КонецЕсли;
	
	Если ПорядокРасчетов = Перечисления.ПорядокРасчетов.ПоНакладным Тогда
		ОбъектРасчетов = Справочники.ОбъектыРасчетов.НайтиПоРеквизиту("Объект", Докотчет.Ссылка);	
	Иначе
		ОбъектРасчетов = Справочники.ОбъектыРасчетов.НайтиПоРеквизиту("Объект", ДокОтчет.Договор);	
	КонецЕсли;	
	
	СтрокаТЧ.ОбъектРасчетов = ОбъектРасчетов;
	
	Если ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(СтрокаТЧ, "ДатаПлатежа") Тогда
		СтрокаТЧ.ДатаПлатежа = Корректировка.Дата;
	КонецЕсли;
	
	Попытка
		Корректировка.Записать(РежимЗаписиДокумента.Проведение);	
	Исключение	
		Корректировка.Записать(РежимЗаписиДокумента.Запись);
	КонецПопытки;  
	
	Возврат Корректировка.Ссылка;
	
КонецФункции //- ИнфоСофт Сумин Д.В. 05.03.2024 УА #69374

//+ ИнфоСофт Мурсалимов Д.Р. 09.09.24 УА #82005
Функция СгруппироватьТаблицуПродажПоНоменклатуре(СписокТранзакций)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ТаблицаПродаж.Номенклатура КАК Номенклатура,
	|	ТаблицаПродаж.Характеристика КАК Характеристика,
	|	ТаблицаПродаж.Баркод КАК Баркод,
	|	ТаблицаПродаж.Количество КАК Количество,
	|	ТаблицаПродаж.КоэффициентУпаковки КАК КоэффициентУпаковки,
	|	ТаблицаПродаж.Упаковка КАК Упаковка,
	|	ТаблицаПродаж.ЭтоНабор КАК ЭтоНабор,
	|	ТаблицаПродаж.СуммаПродажи КАК СуммаПродажи,
	|	ТаблицаПродаж.ЦенаРозничная КАК ЦенаРозничная
	|ПОМЕСТИТЬ ВТ_Продажи
	|ИЗ
	|	&ТаблицаПродаж КАК ТаблицаПродаж
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_Продажи.Номенклатура КАК Номенклатура,
	|	ВТ_Продажи.Характеристика КАК Характеристика,
	|	ВТ_Продажи.Баркод КАК Баркод,
	|	СУММА(ВТ_Продажи.Количество) КАК Количество,
	|	СУММА(ВТ_Продажи.СуммаПродажи) КАК СуммаПродажи,
	|	МАКСИМУМ(ВТ_Продажи.КоэффициентУпаковки) КАК КоэффициентУпаковки,
	|	МАКСИМУМ(ВТ_Продажи.Упаковка) КАК Упаковка,
	|	МАКСИМУМ(ВТ_Продажи.ЭтоНабор) КАК ЭтоНабор,
	|	МАКСИМУМ(ВТ_Продажи.ЦенаРозничная) КАК ЦенаРозничная
	|ИЗ
	|	ВТ_Продажи КАК ВТ_Продажи
	|
	|СГРУППИРОВАТЬ ПО
	|	ВТ_Продажи.Баркод,
	|	ВТ_Продажи.Номенклатура,
	|	ВТ_Продажи.Характеристика";
	
	Запрос.УстановитьПараметр("ТаблицаПродаж", СписокТранзакций);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Выборка = РезультатЗапроса.Выбрать();
	
	Результат = СписокТранзакций.Скопировать();
	Результат.Очистить();
	
	Пока Выборка.Следующий() Цикл
		НоваяСтрока = Результат.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, Выборка);
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции //- ИнфоСофт Мурсалимов Д.Р. 09.09.24 УА #82005

