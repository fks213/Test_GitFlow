	|	И ВТ_Статусы.СтатусWB = ЗНАЧЕНИЕ(Перечисление.ИС_WB_СтатусыСборочныхЗаданийВСистемеWildBerries.ПустаяСсылка)";
	//- ИнфоСофт Власова И.С. 18.12.24 УА #89287
	
	Запрос.УстановитьПараметр("МассивСсылок", МассивЗаданий);
	Запрос.УстановитьПараметр("Статусы", МассивСтатусов);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Выборка = РезультатЗапроса.Выбрать();
	
	МассивКСозданию = Новый Массив();
	Пока Выборка.Следующий() Цикл
		МассивКСозданию.Добавить(Выборка.Ссылка);	
	КонецЦикла;
	
	ФукнциональныеОпции = ИС_WB_СерверПовтИсп.ПолучитьНастройкиФункциональностиСборочныхЗвданий(Профиль);
	//+ ИнфоСофт Макарова Н.Е. 04.04.2025 УА #88298
	АктивныйЗаказКлиента = ИС_WB_Сервер.ПолучитьАктивныйЗаказКлиента(Профиль);
	
	Если АктивныйЗаказКлиента <> Неопределено Тогда
		
		ФукнциональныеОпции.Вставить("АктивныйЗаказКлиента", АктивныйЗаказКлиента);
		
	КонецЕсли;
	//- ИнфоСофт Макарова Н.Е. 04.04.2025 УА #88298
	
	Если ФукнциональныеОпции.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	Если МассивКСозданию.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	Если ФукнциональныеОпции.РежимСозданияЗаказов = 0 Тогда // Один к одному
		
		Для Каждого СборочноеЗадание Из МассивКСозданию Цикл
			
			Заказ = СоздатьИлиДополнитьЗаказУТ11_5(СборочноеЗадание, ФукнциональныеОпции);
			
			Если Не Заказ.Пустая() Тогда
				
				ДокОбъект = СборочноеЗадание.ПолучитьОбъект();
				ДокОбъект.Заказ = Заказ;
				
				Попытка
					ДокОбъект.Записать();
					
					//+ ИнфоСофт Заварин К.В. 01.11.24 УА #86746
					ИС_MP_РаботаСЗаказами.ЗаписатьЗаказОтчетаКомиссионера(Профиль
					, Перечисления.ИС_МП_Маркетплейсы.ВБ
					, СборочноеЗадание.rid
					, СборочноеЗадание
					, Заказ);
					//- ИнфоСофт Заварин К.В. 01.11.24 УА #86746
					
				Исключение
					Текст = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
					ИС_MP_Сервер.ЗаписатьВЖРИСообщитьПользователю(Событие, Текст);
				КонецПопытки;
				
			КонецЕсли; 	
			
		КонецЦикла;
		
		Возврат;
		
	КонецЕсли;
	
	Если ФукнциональныеОпции.РежимСозданияЗаказов = 1 Тогда // Пакетный режим
		
		//+ ИнфоСофт Сумин Д.В. 25.05.23 УА #59052
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	ИС_WB_СборочноеЗадание.Ссылка КАК СборочноеЗадание,
		|	ИС_WB_СборочноеЗадание.Склад КАК Склад
		|ИЗ
		|	Документ.ИС_WB_СборочноеЗадание КАК ИС_WB_СборочноеЗадание
		|ГДЕ
		|	ИС_WB_СборочноеЗадание.Ссылка В(&МассивСсылок)
		|ИТОГИ ПО
		|	Склад";
		Запрос.УстановитьПараметр("МассивСсылок", МассивКСозданию);
		
		РезультатЗапроса = Запрос.Выполнить();
		
		Выборка = РезультатЗапроса.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
		
		Пока Выборка.Следующий() Цикл
			ВыборкаДетальныеЗаписи = Выборка.Выбрать();
			Заказ = Неопределено;
			Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
				Заказ = СоздатьИлиДополнитьЗаказУТ11_5(ВыборкаДетальныеЗаписи.СборочноеЗадание, ФукнциональныеОпции, Заказ);
				
				Если Не Заказ.Пустая() И Заказ <> Неопределено Тогда	
					ДокОбъект = ВыборкаДетальныеЗаписи.СборочноеЗадание.ПолучитьОбъект();
					ДокОбъект.Заказ = Заказ;
					
					Попытка
						ДокОбъект.Записать();
						
						//+ ИнфоСофт Заварин К.В. 01.11.24 УА #86746
						ИС_MP_РаботаСЗаказами.ЗаписатьЗаказОтчетаКомиссионера(Профиль
						, Перечисления.ИС_МП_Маркетплейсы.ВБ
						
						//+ ИнфоСофт Заварин К.В. 10.12.24 УА #89234
						//, СборочноеЗадание.rid
						//, СборочноеЗадание
						//, Заказ);
						, ВыборкаДетальныеЗаписи.СборочноеЗадание.rid
						, ВыборкаДетальныеЗаписи.СборочноеЗадание
						, Заказ);
						//- ИнфоСофт Заварин К.В. 10.12.24 УА #89234
						
						//- ИнфоСофт Заварин К.В. 01.11.24 УА #86746
						
					Исключение
						Текст = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
						ИС_MP_Сервер.ЗаписатьВЖРИСообщитьПользователю(Событие, Текст);
					КонецПопытки; 
				КонецЕсли;	
			КонецЦикла;	
		КонецЦикла;	
		
		//Заказ = СоздатьИлиДополнитьЗаказУТ11_5(МассивКСозданию[0], ФукнциональныеОпции);
		//	
		//Если Не Заказ.Пустая() Тогда
		//
		//	ДокОбъект = МассивКСозданию[0].ПолучитьОбъект();
		//	ДокОбъект.Заказ = Заказ;
		//	
		//	Попытка
		//		ДокОбъект.Записать();
		//	Исключение
		//		Текст = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
		//		ИС_MP_Сервер.ЗаписатьВЖРИСообщитьПользователю(Событие, Текст);
		//	КонецПопытки;
		//
		//КонецЕсли;
		//		
		//МассивКСозданию.Удалить(0);
		//
		//Для Каждого СборочноеЗадание Из МассивКСозданию Цикл
		//	
		//	Заказ = СоздатьИлиДополнитьЗаказУТ11_5(СборочноеЗадание, ФукнциональныеОпции, Заказ);
		//	
		//	Если Не Заказ.Пустая() Тогда
		//	
		//		ДокОбъект = СборочноеЗадание.ПолучитьОбъект();
		//		ДокОбъект.Заказ = Заказ;
		//		
		//		Попытка
		//			ДокОбъект.Записать();
		//		Исключение
		//			Текст = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
		//			ИС_MP_Сервер.ЗаписатьВЖРИСообщитьПользователю(Событие, Текст);
		//		КонецПопытки;
		//	
		//	КонецЕсли; 	
		//	
		//КонецЦикла;
		//
		//- ИнфоСофт Сумин Д.В. 25.05.23 УА #59052
		
		Возврат;
		
	КонецЕсли;
	

	Если ФукнциональныеОпции.РежимСозданияЗаказов = 2 Тогда // Формирование в течение дня
		
		//+ ИнфоСофт Макарова Н.Е. 01.04.2025 УА #77424
		Если НЕ ФукнциональныеОпции.ИспользоватьРазбиениеПоСкладам Тогда // без разбиения, создается только 1 заказ
			
			Если ФукнциональныеОпции.АктивныйЗаказКлиента.Пустая() Тогда
				
				Заказ = СоздатьИлиДополнитьЗаказУТ11_5(МассивКСозданию[0], ФукнциональныеОпции);
				
				Если Не Заказ.Пустая() Тогда
					
					ДокОбъект = МассивКСозданию[0].ПолучитьОбъект();
					ДокОбъект.Заказ = Заказ;
					
					Попытка
						ДокОбъект.Записать();
					Исключение
						Текст = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
						ИС_MP_Сервер.ЗаписатьВЖРИСообщитьПользователю(Событие, Текст);
					КонецПопытки;
					
				КонецЕсли;
				
				ПрофильОбъект = Профиль.ПолучитьОбъект();
				ПрофильОбъект.АктивныйЗаказКлиента = Заказ;
				
				Попытка
					ПрофильОбъект.Записать();
				Исключение
					Текст = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
					ИС_MP_Сервер.ЗаписатьВЖРИСообщитьПользователю(Событие, Текст);
				КонецПопытки;
				
				МассивКСозданию.Удалить(0);
				
			Иначе
				Заказ = ФукнциональныеОпции.АктивныйЗаказКлиента;
			КонецЕсли;
			
			Для Каждого СборочноеЗадание Из МассивКСозданию Цикл
				
				БуферЗаказа = СоздатьИлиДополнитьЗаказУТ11_5(СборочноеЗадание, ФукнциональныеОпции, Заказ);
				
				Если Не БуферЗаказа.Пустая() Тогда 
					
					ДокОбъект = СборочноеЗадание.ПолучитьОбъект();
					ДокОбъект.Заказ = Заказ;
					
					Попытка
						ДокОбъект.Записать(); 
						
						//+ ИнфоСофт Заварин К.В. 01.11.24 УА #86746
						ИС_MP_РаботаСЗаказами.ЗаписатьЗаказОтчетаКомиссионера(Профиль
						, Перечисления.ИС_МП_Маркетплейсы.ВБ
						, СборочноеЗадание.rid
						, СборочноеЗадание
						, Заказ);
						//- ИнфоСофт Заварин К.В. 01.11.24 УА #86746
						
					Исключение
						Текст = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
						ИС_MP_Сервер.ЗаписатьВЖРИСообщитьПользователю(Событие, Текст);
					КонецПопытки;    
					
				КонецЕсли;
				//- ИнфоСофт Стояк Ю.К. 02.02.2024 УА #70111
				
			КонецЦикла;
			
			Возврат;
			
		Иначе 
			
			Для Каждого СборочноеЗадание Из МассивКСозданию Цикл 
				
				ДобавитьЗапись = Ложь;
				
				АктивныйЗаказ = ПолучитьАктивныйЗаказКлиентаВБ(СборочноеЗадание);
				
				Если АктивныйЗаказ = Неопределено Тогда
					ДобавитьЗапись = Истина;	
				КонецЕсли;	
				
				Заказ = СоздатьИлиДополнитьЗаказУТ11_5(СборочноеЗадание, ФукнциональныеОпции, АктивныйЗаказ); 
				
				Если Заказ = Документы.ЗаказКлиента.ПустаяСсылка() Тогда
					Текст = "Отсутствует сопоставление по заказу. Номер: " + СокрЛП(СборочноеЗадание.Номер); 
					ОбщегоНазначения.СообщитьПользователю(Текст);
					ИС_MP_Сервер.ЗаписатьВЖРИСообщитьПользователю(Событие, Текст);
					Продолжить;	
				КонецЕсли;	
				
				Если ДобавитьЗапись Тогда
					ДобавитьЗаписьВРегистрЗаказовВБ(Заказ, СборочноеЗадание);	
				КонецЕсли;	
				
				ДокОбъект = СборочноеЗадание.ПолучитьОбъект();
				ДокОбъект.Заказ = Заказ;
				
				Попытка
					ДокОбъект.Записать(); 
					//+ ИнфоСофт Стояк Ю.К. 18.04.2025 УА #98648					
					ИС_MP_РаботаСЗаказами.ЗаписатьЗаказОтчетаКомиссионера(Профиль
					, Перечисления.ИС_МП_Маркетплейсы.ВБ
					, СборочноеЗадание.rid
					, СборочноеЗадание					
					, Заказ);
                    //- ИнфоСофт Стояк Ю.К. 18.04.2025 УА #98648
				Исключение
					Текст = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
					ИС_MP_Сервер.ЗаписатьВЖРИСообщитьПользователю(Событие, Текст);
				КонецПопытки;	
			КонецЦикла;
			
			Возврат;
			
		КонецЕсли;
	КонецЕсли;
	//- ИнфоСофт Макарова Н.Е. 01.04.2025 УА #77424
	
	ВызватьИсключение("Неизвестный режим формирования заказов");
	
КонецПроцедуры //- ИнфоСофт Ивонин К.А. 19.02.23 УА #53535

