	ПараметрыРасходногоОрдера.Вставить("РаспоряженияНаОтгрузку", РаспоряженияНаОтгрузку);
	ПараметрыРасходногоОрдера.Вставить("ЗаданиеНаПеревозку", Неопределено);
	
	РасходныйОрдерСтруктура = СкладыСервер.ПереоформитьРасходныеОрдера(ПараметрыРасходногоОрдера);	
	
	ВыполнитьИзменениеСтатусаРасходныхОрдеров(РасходныйОрдерСтруктура.ОформленныеОрдера, Перечисления.СтатусыРасходныхОрдеров.Отгружен, Перечисления.ДействияСоСтрокамиОрдеровНаОтгрузку.Отгрузить);
		
КонецПроцедуры //- ИнфоСофт Сумин Д.В. 08.09.2023 УА #61973

//+ ИнфоСофт Сумин Д.В. 08.09.2023 УА #61973
Процедура ВыполнитьИзменениеСтатусаРасходныхОрдеров(ОформленныеОрдеры, Статус, СтатусСтроки)  
		
	Для Каждого Строка Из ОформленныеОрдеры Цикл
		
		НачатьТранзакцию();
		
		Попытка
			Блокировка = Новый БлокировкаДанных;
			
			ЭлементБлокировки = Блокировка.Добавить("Документ.РасходныйОрдерНаТовары");
			ЭлементБлокировки.УстановитьЗначение("Ссылка", Строка.РасходныйОрдер);
			Блокировка.Заблокировать();
			
			РасходныйОрдерОбъект = Строка.РасходныйОрдер.ПолучитьОбъект(); // ДокументОбъект.РасходныйОрдерНаТовары
			РасходныйОрдерОбъект.ОтгрузкаПоЗаданиюНаПеревозку = Ложь;
			РасходныйОрдерОбъект.Статус = Статус;   
			
			Для Каждого Элемент Из РасходныйОрдерОбъект.ОтгружаемыеТовары Цикл
				Элемент.Действие = СтатусСтроки;		
			КонецЦикла;
			
			РасходныйОрдерОбъект.ДатаОтгрузки = НачалоДня(ТекущаяДатаСеанса());
			РасходныйОрдерОбъект.Записать(РежимЗаписиДокумента.Проведение);
			
			ЗафиксироватьТранзакцию();
		Исключение
			ОтменитьТранзакцию();
			
			ТекстСообщения = НСтр("ru = 'Не удалось обработать %Документ% фоновым заданием изменения статуса по причине: %Причина%'");
			ТекстСообщения = СтрЗаменить(ТекстСообщения, "%Документ%", Строка.РасходныйОрдер);
			ТекстСообщения = СтрЗаменить(ТекстСообщения, "%Причина%", ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
			ЗаписьЖурналаРегистрации(ОбновлениеИнформационнойБазы.СобытиеЖурналаРегистрации(),
			УровеньЖурналаРегистрации.Предупреждение,
			Метаданные.Документы.РасходныйОрдерНаТовары,
			Строка.РасходныйОрдер,
			ТекстСообщения);
			ВызватьИсключение;
		КонецПопытки;
		
	КонецЦикла;
	
КонецПроцедуры //- ИнфоСофт Сумин Д.В. 08.09.2023 УА #61973

//+ ИнфоСофт Ивонин К.А. 21.02.23 УА #53535
Функция ПроверитьОстаткиТваровНаСервере(ТоварыЗаказаТЗ, Склад, Организация) Экспорт  
	
	КоличестваХватает = Ложь;
	
	ДанныеПроверки = Новый Структура;
	ДанныеПроверки.Вставить("КоличестваХватает", КоличестваХватает);
	ДанныеПроверки.Вставить("Номенклатура", Неопределено);
	ДанныеПроверки.Вставить("Характеристика", Неопределено);	
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"
	|ВЫБРАТЬ
	|	Товары.Номенклатура КАК НоменклатураВЗаказе,
	|	Товары.Характеристика КАК ХарактеристикаВЗаказе,
	|	Товары.Количество КАК КоличествоВЗаказе
	|ПОМЕСТИТЬ ВТ_Товары
	|ИЗ
	|	&Товары КАК Товары
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ЕСТЬNULL(РаспределениеЗапасов.Свободно, 0) КАК ВНаличииОстаток,
	|	ВТ_Товары.НоменклатураВЗаказе КАК НоменклатураВЗаказе,
	|	ВТ_Товары.ХарактеристикаВЗаказе КАК ХарактеристикаВЗаказе,
	|	ВТ_Товары.КоличествоВЗаказе КАК КоличествоВЗаказе,
	|	ВЫБОР
	|		КОГДА ВТ_Товары.КоличествоВЗаказе > ЕСТЬNULL(РаспределениеЗапасов.Свободно, 0)
	|			ТОГДА ЛОЖЬ
	|		ИНАЧЕ ИСТИНА
	|	КОНЕЦ КАК КоличестваХватает
	|ИЗ
	|	ВТ_Товары КАК ВТ_Товары
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.РаспределениеЗапасов КАК РаспределениеЗапасов
	|		ПО ВТ_Товары.НоменклатураВЗаказе = РаспределениеЗапасов.Номенклатура
	|			И ВТ_Товары.ХарактеристикаВЗаказе = РаспределениеЗапасов.Характеристика
	|ГДЕ
	|	РаспределениеЗапасов.Номенклатура В
	|			(ВЫБРАТЬ
	|				ВТ_Товары.НоменклатураВЗаказе КАК НоменклатураВЗаказе
	|			ИЗ
	|				ВТ_Товары КАК ВТ_Товары)
	|	И РаспределениеЗапасов.Склад = &Склад
	|	И РаспределениеЗапасов.Состояние = ЗНАЧЕНИЕ(Перечисление.РаспределениеЗапасовСостояния.ОстатокНаСкладе)
	|	И РаспределениеЗапасов.Характеристика В
	|			(ВЫБРАТЬ
	|				ВТ_Товары.ХарактеристикаВЗаказе КАК ХарактеристикаВЗаказе
	|			ИЗ
	|				ВТ_Товары КАК ВТ_Товары)
	|";
	
	Запрос.УстановитьПараметр("Товары", ТоварыЗаказаТЗ);
	Запрос.УстановитьПараметр("Склад", Склад);
	Запрос.УстановитьПараметр("Организация", Организация);
	
	РезультатЗапроса = Запрос.Выполнить(); 
	
	Если РезультатЗапроса.Пустой() Тогда
		ДанныеПроверки.Вставить("КоличестваХватает", КоличестваХватает); 		
		Возврат ДанныеПроверки;	
	КонецЕсли;	
	
	Выборка = РезультатЗапроса.Выбрать();
	
	КоличестваХватает = Истина;
	
	Пока Выборка.Следующий() Цикл 
		
		Если Не Выборка.КоличестваХватает Тогда
			КоличестваХватает = Ложь;
			ДанныеПроверки.Вставить("Номенклатура", Выборка.НоменклатураВЗаказе);
			ДанныеПроверки.Вставить("Характеристика", Выборка.ХарактеристикаВЗаказе);
		КонецЕсли;
		
	КонецЦикла;
	
	ДанныеПроверки.Вставить("КоличестваХватает", КоличестваХватает);  
	
	Возврат ДанныеПроверки;	
	
КонецФункции //- ИнфоСофт Ивонин К.А. 21.02.23 УА #53535

//+ ИнфоСофт Сумин Д.В. 20.04.23 УА #57217
Функция СоздатьИлиДополнитьЗаказУТ11_5(СборочноеЗадание, ФукнциональныеОпции, Заказ = Неопределено)
	
	Событие = ПолучитьИмяСобытия("СоздатьИлиДополнитьЗаказУТ11_5");
	
	Запрос = Новый Запрос;
	
	Запрос.Текст = 
	
	//+ ИнфоСофт Мурсалимов Д.Р. 09.09.24 УА #82005
