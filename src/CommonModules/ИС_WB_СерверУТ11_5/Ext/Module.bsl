//+ ИнфоСофт Сумин Д.В. 11.03.2024 УА #71107
Функция ПолучитьДокументыОснованияДляВозвратов(ТаблицаРезультирующаяВозвраты)
		
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ИС_WB_ДанныеОтчетовОПродажах.НомерОтчета КАК НомерОтчета,
	|	ИС_WB_ДанныеОтчетовОПродажах.Параметр КАК Параметр,
	|	ИС_WB_ДанныеОтчетовОПродажах.ЗначениеПараметра КАК Srid,
	|	ИС_WB_ДанныеОтчетовОПродажах.СтрокаНомер КАК СтрокаНомер
	|ПОМЕСТИТЬ ВТ_НомерОтчета
	|ИЗ
	|	РегистрСведений.ИС_WB_ДанныеОтчетовОПродажах КАК ИС_WB_ДанныеОтчетовОПродажах
	|ГДЕ
	|	ИС_WB_ДанныеОтчетовОПродажах.ЗначениеПараметра В(&МассивSrid)
	|	И ИС_WB_ДанныеОтчетовОПродажах.НомерОтчета.ВидОтчета = ЗНАЧЕНИЕ(Перечисление.ИС_WB_ВидыОТчетов.Иностранный)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	МАКСИМУМ(ВТ_НомерОтчета.НомерОтчета) КАК НомерОтчета,
	|	ВТ_НомерОтчета.Srid КАК Srid
	|ПОМЕСТИТЬ ВТ_НомерОтчетаПродажи
	|ИЗ
	|	ВТ_НомерОтчета КАК ВТ_НомерОтчета
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ИС_WB_ДанныеОтчетовОПродажах КАК ИС_WB_ДанныеОтчетовОПродажах
	|		ПО ВТ_НомерОтчета.НомерОтчета = ИС_WB_ДанныеОтчетовОПродажах.НомерОтчета
	|			И ВТ_НомерОтчета.СтрокаНомер = ИС_WB_ДанныеОтчетовОПродажах.СтрокаНомер
	|ГДЕ
	|	ИС_WB_ДанныеОтчетовОПродажах.Параметр.Наименование = ""ОбоснованиеДляОплаты""
	|	И ИС_WB_ДанныеОтчетовОПродажах.ЗначениеПараметра = ""Продажа""
	|
	|СГРУППИРОВАТЬ ПО
	|	ВТ_НомерОтчета.Srid
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	МАКСИМУМ(ИС_WB_НомерацияОтчетовОПродажахДокументы.Документ) КАК Документ,
	|	ВТ_НомерОтчетаПродажи.Srid КАК Srid
	|ИЗ
	|	ВТ_НомерОтчетаПродажи КАК ВТ_НомерОтчетаПродажи
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ИС_WB_НомерацияОтчетовОПродажах.Документы КАК ИС_WB_НомерацияОтчетовОПродажахДокументы
	|		ПО (ВТ_НомерОтчетаПродажи.НомерОтчета = ИС_WB_НомерацияОтчетовОПродажахДокументы.Ссылка)
	|ГДЕ
	|	ТИПЗНАЧЕНИЯ(ИС_WB_НомерацияОтчетовОПродажахДокументы.Документ.Ссылка) = ТИП(Документ.реализацияТоваровУслуг)
	|	И ИС_WB_НомерацияОтчетовОПродажахДокументы.Документ.ХозяйственнаяОперация = ЗНАЧЕНИЕ(Перечисление.ХозяйственныеОперации.РеализацияКлиенту)
	|
	|СГРУППИРОВАТЬ ПО
	|	ВТ_НомерОтчетаПродажи.Srid";
	
	Запрос.УстановитьПараметр("МассивSrid", ТаблицаРезультирующаяВозвраты.ВыгрузитьКолонку("Srid"));
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Выборка = РезультатЗапроса.Выбрать();
	
	РезультирующаяТЗ = Новый ТаблицаЗначений;
	РезультирующаяТЗ.Колонки.Добавить("Документ");
	РезультирующаяТЗ.Колонки.Добавить("Srid");
	
	Пока Выборка.Следующий() Цикл
		НоваяСтрока = РезультирующаяТЗ.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, Выборка);
	КонецЦикла;
	
	Возврат РезультирующаяТЗ;
	
КонецФункции //- ИнфоСофт Сумин Д.В. 11.03.2024 УА #71107	

//+ ИнфоСофт Мурсалимов Д.Р. 13.06.24 УА #77595
Процедура СоздатьРеализацию(Выборка, ФукнциональныеОпции, Комиссия25, МассивДляЗаполнения = Неопределено)
	
	Событие = ПолучитьИмяСобытия("СоздатьРеализации1С");
	
	Если Комиссия25 Тогда
		ДокументРеализация = Документы.ПередачаТоваровХранителю.СоздатьДокумент();	
	Иначе
		ДокументРеализация = Документы.РеализацияТоваровУслуг.СоздатьДокумент();
	КонецЕсли;
	
	Если Не МассивДляЗаполнения = Неопределено Тогда
		
		Попытка	
			
			Если Комиссия25 Тогда
				СтруктураЗаполнения = СозданиеНаОснованииУТВызовСервера.ПередачаТоваровХранителюПараметрыОткрытияФормы(МассивДляЗаполнения);
			Иначе
				СтруктураЗаполнения = СозданиеНаОснованииУТВызовСервера.РеализацияТоваровУслугПараметрыОткрытияФормы(МассивДляЗаполнения);
			КонецЕсли;
			
			Если СтруктураЗаполнения = Неопределено Тогда
				Возврат;
			КонецЕсли;
			
			ДокументРеализация.Заполнить(СтруктураЗаполнения.Основание); 
			
		Исключение
			Текст = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
			ИС_MP_Сервер.ЗаписатьВЖРИСообщитьПользователю(Событие, Текст);
		КонецПопытки; 
		
	Иначе
		
		Попытка
			ДокументРеализация.Заполнить(Выборка.Заказ); 
		Исключение
			Возврат;
		КонецПопытки;
		
	КонецЕсли;
	
	//+ ИнфоСофт Мурсалимов Д.Р. 04.03.25 УА #95186
	Если ДокументРеализация.Товары.Количество() = 0 Тогда
		
		ДокументРеализация.ЗаказКлиента 	= Неопределено;
		ДокументРеализация.ПометкаУдаления 	= Истина;
		 
		Попытка
			ДокументРеализация.Записать(РежимЗаписиДокумента.Запись);			
		Исключение
			Текст = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
			ИС_MP_Сервер.ЗаписатьВЖРИСообщитьПользователю(Событие, Текст);
		КонецПопытки;
			
	КонецЕсли;
	//- ИнфоСофт Мурсалимов Д.Р. 04.03.25 УА #95186
	
	ДокументРеализация.Дата = Выборка.Дата + ФукнциональныеОпции.КоличествоДнейКРеализации * 86400;
	ДокументРеализация.Комментарий = Выборка.Комментарий;
	
	Если Не Комиссия25 Тогда
		ДокументРеализация.СкидкиРассчитаны = Истина;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ФукнциональныеОпции.Подразделение) Тогда  
		ДокументРеализация.Подразделение = ФукнциональныеОпции.Подразделение;
	КонецЕсли;
	
	ЗаписыватьДокумент = Ложь;
	
	Если ФукнциональныеОпции.ПроводитьРеализации Тогда
		
		Попытка
			ДокументРеализация.Записать(РежимЗаписиДокумента.Проведение);
		Исключение
			ЗаписыватьДокумент = Истина;
			Текст = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
			ИС_MP_Сервер.ЗаписатьВЖРИСообщитьПользователю(Событие, Текст); 
		КонецПопытки;
		
	Иначе
		ЗаписыватьДокумент = Истина;	
	КонецЕсли;
	
	Если ЗаписыватьДокумент Тогда	
		
		Попытка
			ДокументРеализация.Записать();			
		Исключение
			Текст = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
			ИС_MP_Сервер.ЗаписатьВЖРИСообщитьПользователю(Событие, Текст);
		КонецПопытки;
		
	КонецЕсли;
	
КонецПроцедуры //- ИнфоСофт Мурсалимов Д.Р. 13.06.24 УА #77595

//+ ИнфоСофт Власова И.С. 22.08.24 УА #61503
Функция ПроверитьЗаполнениеНастроекКомиссии(Профиль) Экспорт
	
	РезультатПроверки = Истина;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ИС_WB_Профили.Контрагент КАК Контрагент,
		|	ИС_WB_Профили.Партнер КАК Партнер,
		|	ИС_WB_Профили.Договор КАК Договор,
		|	ИС_WB_Профили.Соглашение КАК Соглашение,
		|	ИС_WB_Профили.Соглашение.ИспользуютсяДоговорыКонтрагентов КАК СоглашениеИспользуютсяДоговорыКонтрагентов,
		|	ИС_WB_Профили.Подразделение КАК Подразделение
		|ИЗ
		|	Справочник.ИС_WB_Профили КАК ИС_WB_Профили
		|ГДЕ
		|	ИС_WB_Профили.Ссылка = &Профиль";
	
	Запрос.УстановитьПараметр("Профиль", Профиль);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Выборка = РезультатЗапроса.Выбрать();
	
	Если Выборка.Следующий() Тогда
		
		Маркетплейс = Перечисления.ИС_МП_Маркетплейсы.ВБ;
		
		МассивНезаполненныхНастроек = Новый Массив;
		
		Если Не ЗначениеЗаполнено(Выборка.Контрагент) Тогда 
			МассивНезаполненныхНастроек.Добавить(НСтр("ru = 'Контрагент'"));	
		КонецЕсли;
		
		ИспользоватьПартнеровИКонтрагентов = Константы.ИспользоватьПартнеровИКонтрагентов.Получить();
		
		Если ИспользоватьПартнеровИКонтрагентов И Не ЗначениеЗаполнено(Выборка.Партнер) Тогда
			МассивНезаполненныхНастроек.Добавить(НСтр("ru = 'Партнер'"));	
		КонецЕсли;
		
		ИспользоватьСоглашенияСКлиентами = ПолучитьФункциональнуюОпцию("ИспользоватьСоглашенияСКлиентами");
				
		Если ИспользоватьСоглашенияСКлиентами И Не ЗначениеЗаполнено(Выборка.Соглашение) Тогда
			МассивНезаполненныхНастроек.Добавить(НСтр("ru = 'Соглашение закупки'"));	
		КонецЕсли;
		
		ИспользоватьДоговорыСКлиентами = ПолучитьФункциональнуюОпцию("ИспользоватьДоговорыСКлиентами"); 
		
		Если ИспользоватьДоговорыСКлиентами И 
			(Не ИспользоватьСоглашенияСКлиентами И Не ЗначениеЗаполнено(Выборка.Договор))
			Или (Не ЗначениеЗаполнено(Выборка.Договор) И ИспользоватьСоглашенияСКлиентами И ЗначениеЗаполнено(Выборка.Соглашение) И Выборка.СоглашениеИспользуютсяДоговорыКонтрагентов) Тогда
		
		МассивНезаполненныхНастроек.Добавить(НСтр("ru = 'Договор'"));
			
		КонецЕсли;	
		
		Если МассивНезаполненныхНастроек.Количество() > 0 Тогда
			
			РезультатПроверки = Ложь;
			
			Для Каждого Настройка Из МассивНезаполненныхНастроек Цикл
				ИС_MP_Сервер.ПоказатьСообщениеОтсутствияЗаполненияНастройки(Настройка, Профиль, Маркетплейс); 
			КонецЦикла;
			
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат РезультатПроверки;	
	
КонецФункции //- ИнфоСофт Власова И.С. 22.08.24 УА #61503

//+ ИнфоСофт Власова И.С. 22.08.24 УА #61503
Функция ПроверитьЗаполнениеНастроекЗакупки(Профиль) Экспорт
	
	РезультатПроверки = Истина;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ИС_WB_Профили.Контрагент КАК Контрагент,
		|	ИС_WB_Профили.Партнер КАК Партнер,
		|	ИС_WB_Профили.ДоговорЗакупки КАК ДоговорЗакупки,
