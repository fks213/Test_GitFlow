	|	ВЫБОР
	|		КОГДА ИС_WB_СоответствиеРазмеров.Упаковка ЕСТЬ NULL 
	|			ТОГДА 1
	|		КОГДА ИС_WB_СоответствиеРазмеров.Упаковка.Числитель = 0
	|			ТОГДА 1 
	|		КОГДА ИС_WB_СоответствиеРазмеров.Упаковка = &ПустаяУпаковка
	|			ТОГДА 1
	|		ИНАЧЕ ИС_WB_СоответствиеРазмеров.Упаковка.Числитель
	|	КОНЕЦ / ВЫБОР
	|		КОГДА ИС_WB_СоответствиеРазмеров.Упаковка ЕСТЬ NULL
	|		ТОГДА 1
	|		КОГДА ИС_WB_СоответствиеРазмеров.Упаковка.Знаменатель = 0
	|			ТОГДА 1
	|		КОГДА ИС_WB_СоответствиеРазмеров.Упаковка = &ПустаяУпаковка
	|			ТОГДА 1
	|		ИНАЧЕ ИС_WB_СоответствиеРазмеров.Упаковка.Знаменатель
	|	КОНЕЦ КАК КоэффициентУпаковки,
	|	ИС_WB_СборочноеЗадание.Склад.Склад КАК СкладУТ,
	|	ИС_WB_СборочноеЗадание.Склад.ОбщаяГруппаСкладов КАК ОбщаяГруппаСкладов,
	|	ИС_WB_СборочноеЗадание.Склад.АдресДоставки КАК АдресДоставки,
	|	ИС_WB_СборочноеЗадание.Склад.СпособДоставки КАК СпособДоставки,
	|	ИС_WB_СборочноеЗадание.Склад.ЗонаДоставки КАК ЗонаДоставки,
	|	ИС_WB_СборочноеЗадание.Склад.ВыгружатьОстаткиИзГруппыСкладов КАК ВыгружатьОстаткиИзГруппыСкладов,
	|	ИС_WB_СборочноеЗадание.Склад.АдресДоставкиЗначенияПолей КАК АдресДоставкиЗначенияПолей,
	|	ИС_WB_СборочноеЗадание.Склад.АдресДоставкиЗначение КАК АдресДоставкиЗначение,
	|	ИС_WB_СборочноеЗадание.Склад.Грузополучатель КАК Грузополучатель,
	|	ИС_WB_СборочноеЗадание.Склад.Грузоотправитель КАК Грузоотправитель,
	|	ИС_WB_СборочноеЗадание.Склад.ПеревозчикПартнер КАК ПеревозчикПартнер,
	|	ИС_WB_СборочноеЗадание.Ссылка КАК СборочноеЗадание
	|ИЗ
	|	Документ.ИС_WB_СборочноеЗадание КАК ИС_WB_СборочноеЗадание
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ИС_WB_СоответствиеРазмеров КАК ИС_WB_СоответствиеРазмеров
	|		ПО ИС_WB_СборочноеЗадание.РазмерWB = ИС_WB_СоответствиеРазмеров.РазмерWB
	|ГДЕ
	|	ИС_WB_СборочноеЗадание.Ссылка В (&Ссылка)"; 	
	//- ИнфоСофт Мурсалимов Д.Р. 09.09.24 УА #82005 
	
	Запрос.УстановитьПараметр("Ссылка", СборочноеЗадание);
	Запрос.УстановитьПараметр("ПустаяУпаковка", ИС_МП_СерверЛокализация.ПустаяСсылкаУпаковка());
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Выборка = РезультатЗапроса.Выбрать();
	
	Выборка.Следующий(); 
	 
	Если Выборка.СкладУТ = Null Тогда
		ОбщегоНазначения.СообщитьПользователю("В личном кабинете Wildberries были созданы новые склады. Необходимо выполнить их загрузку.");
		Возврат Документы.ЗаказКлиента.ПустаяСсылка();	
	КонецЕсли;	
	
	Если Выборка.Номенклатура = NULL Тогда
		ОбщегоНазначения.СообщитьПользователю("Отсутствует сопоставление");
		Возврат Документы.ЗаказКлиента.ПустаяСсылка();
	КонецЕсли;
    
	//+ ИнфоСофт Сумин Д.В. 05.05.23 УА #58412
	Если Заказ = Неопределено Или Заказ = Документы.ЗаказКлиента.ПустаяСсылка() Тогда
		//Если Заказ = Неопределено Тогда
		//- ИнфоСофт Сумин Д.В. 05.05.23 УА #58412
		НовыйДокумент = Документы.ЗаказКлиента.СоздатьДокумент();
	Иначе
		НовыйДокумент = Заказ.ПолучитьОбъект();
		//+ ИнфоСофт Стояк Ю.К. 01.08.2024 УА #80362		
		Попытка
			НовыйДокумент.Заблокировать();    
		Исключение   
			Текст = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
			ИС_MP_Сервер.ЗаписатьВЖРИСообщитьПользователю("Создание заказа", Текст + " Заказ " + НовыйДокумент.Ссылка);
			Возврат Неопределено;
		КонецПопытки;                               
		//- ИнфоСофт Стояк Ю.К. 01.08.2024 УА #80362		
	КонецЕсли;
	
	ГруппаСкладов = Выборка.ОбщаяГруппаСкладов;	
	Организация = ФукнциональныеОпции.Организация; 
	Партнер = ФукнциональныеОпции.Партнер; 
	Соглашение = ФукнциональныеОпции.Соглашение;
	Контрагент = ФукнциональныеОпции.Контрагент;
	Договор = ФукнциональныеОпции.Договор;
	
	ПродажаОблагаетсяНДС = ПолучитьПрименениеНДСОрганизации(Организация);
		
	Если Заказ = Неопределено Тогда					
		
		Если ФукнциональныеОпции.РежимСозданияЗаказов = 2 Тогда
			НовыйДокумент.Дата = ТекущаяДатаСеанса();
		Иначе
			НовыйДокумент.Дата = Выборка.Дата;
		КонецЕсли;
		
		//НовыйДокумент.Заполнить(ФукнциональныеОпции.Партнер);
				
		НовыйДокумент.Организация = Организация;
		НовыйДокумент.Подразделение = ФукнциональныеОпции.Подразделение; 
		
		НовыйДокумент.Партнер = Партнер;
		НовыйДокумент.Контрагент = Контрагент;      
		
		НовыйДокумент.НеОтгружатьЧастями = Ложь;
		//+ ИнфоСофт Сумин Д.В. 21.11.2023 УА #61641
		ИспользоватьСоглашенияСКлиентами = ПолучитьФункциональнуюОпцию("ИспользоватьСоглашенияСКлиентами");
		
		Если ИспользоватьСоглашенияСКлиентами Тогда
			НовыйДокумент.ПорядокРасчетов = Соглашение.ПорядокРасчетов;
			НовыйДокумент.Менеджер = Соглашение.Менеджер;
			//+ ИнфоСофт Стояк Ю.К. 27.11.2024 УА #87103
			Если ЗначениеЗаполнено(Соглашение.НаправлениеДеятельности) Тогда
				НовыйДокумент.НаправлениеДеятельности 			= Соглашение.НаправлениеДеятельности;            
			КонецЕсли;
			//- ИнфоСофт Стояк Ю.К. 27.11.2024 УА #87103
		Иначе
			НовыйДокумент.Менеджер = Договор.Менеджер;
			//+ ИнфоСофт Стояк Ю.К. 27.11.2024 УА #87103
			Если ЗначениеЗаполнено(Договор.НаправлениеДеятельности) Тогда
				НовыйДокумент.НаправлениеДеятельности 			= Договор.НаправлениеДеятельности;            
			КонецЕсли;
			//- ИнфоСофт Стояк Ю.К. 27.11.2024 УА #87103
		КонецЕсли; 
		
		НовыйДокумент.Договор = Договор;
		НовыйДокумент.Соглашение = Соглашение;
		//Если Соглашение.ИспользуютсяДоговорыКонтрагентов Тогда
		//	НовыйДокумент.Договор = Договор;
		//	НовыйДокумент.Соглашение = Соглашение;
		//	НовыйДокумент.Менеджер = НовыйДокумент.Договор.Менеджер;
		//Иначе
		//	НовыйДокумент.Соглашение = Соглашение;
		//	НовыйДокумент.ПорядокРасчетов = Соглашение.ПорядокРасчетов;
		//	НовыйДокумент.Менеджер = НовыйДокумент.Соглашение.Менеджер;
		//КонецЕсли;	 
		//- ИнфоСофт Сумин Д.В. 21.11.2023 УА #61641
		НовыйДокумент.Статус = ФукнциональныеОпции.СтатусЗаказаКлиента; 
		НовыйДокумент.Приоритет = ФукнциональныеОпции.ПриоритетЗаказа;
		
		НовыйДокумент.ЦенаВключаетНДС = Соглашение.ЦенаВключаетНДС;
		
		Если ЗначениеЗаполнено(Соглашение.Валюта) Тогда
			НовыйДокумент.Валюта = Соглашение.Валюта;
		ИначеЕсли ЗначениеЗаполнено(Договор.ВалютаВзаиморасчетов) Тогда
			НовыйДокумент.Валюта = Договор.ВалютаВзаиморасчетов;
		Иначе
			НовыйДокумент.Валюта = Справочники.Валюты.НайтиПоКоду("643");
		КонецЕсли;
		
		//+ ИнфоСофт Стояк Ю.К. 28.09.2023 УА #61974		
