	//- ИнфоСофт Сумин Д.В. 15.03.2024 УА #71773 
	
	//+ ИнфоСофт Власова И.С. 03.04.25 УА #98046
	//МассивСуммПродаж = Новый Массив;
	
	СуммаПродажи = 0;
	//- ИнфоСофт Власова И.С. 03.04.25 УА #98046
	
	//+ ИнфоСофт Власова И.С. 14.03.25 УА #83865
