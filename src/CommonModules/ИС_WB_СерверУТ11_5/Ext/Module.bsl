					НоваяСтрока.КоличествоУпаковок = ЭлементНабора.КоличествоУпаковок; 
					НоваяСтрока.Цена = СуммыПродажи[0] / НоваяСтрока.Количество; 
					НоваяСтрока.Сумма = СуммыПродажи[0]; 					
					НоваяСтрока.Упаковка = ЭлементНабора.Номенклатура.ЕдиницаИзмерения;					
										
					СуммыПродажи.Удалить(0);
					
				КонецЦикла;	
				
			Иначе
				НоваяСтрока = Документ.Товары.Добавить();
				НоваяСтрока.Номенклатура = Элемент.Номенклатура;
				НоваяСтрока.Характеристика = Элемент.Характеристика;				
				НоваяСтрока.Количество = Элемент.УпаковкаКоличество;
				НоваяСтрока.КоличествоУпаковок = Элемент.Количество;
				НоваяСтрока.Цена = Элемент.КПеречислениюПродавцуЗаРеализованныйТовар / Элемент.Количество;  
				НоваяСтрока.Сумма =  Элемент.КПеречислениюПродавцуЗаРеализованныйТовар;
				
			КонецЕсли;	
			
			Если Не Элемент.ЭтоНабор Тогда
				НоваяСтрока.Упаковка = Элемент.Упаковка; 
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЕсли;
	//- ИнфоСофт Стояк Ю.К. 23.11.2023 УА #64836
	
	//+ ИнфоСофт Сумин Д.В. 27.03.23 УА #56728
	Попытка
		Документ.Записать(РежимЗаписиДокумента.Проведение); 
	Исключение
		Документ.Записать();
	КонецПопытки; 
	//Документ.Записать(РежимЗаписиДокумента.Проведение); 
	//- ИнфоСофт Сумин Д.В. 27.03.23 УА #56728  
	
	Возврат Документ;  
	
КонецФункции //- ИнфоСофт Сумин Д.В. 06.03.23 УА #55086

