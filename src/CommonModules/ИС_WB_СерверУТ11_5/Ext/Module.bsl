//+ ИнфоСофт Сумин Д.В. 16.11.2023 УА #60080
Функция КоэффициентыРаспределенияПоДолям(ТабличнаяЧасть, Параметры)
	
	Запрос = Новый Запрос("ВЫБРАТЬ
	|	Таблица.НомерСтроки                                       КАК НомерСтроки,
	|	Таблица.НоменклатураНабора                                КАК НоменклатураНабора,
	|	Таблица.ХарактеристикаНабора                              КАК ХарактеристикаНабора,
	|	Таблица.Номенклатура                                      КАК Номенклатура,
	|	Таблица.Характеристика                                    КАК Характеристика,
	|	Таблица.Упаковка                                          КАК Упаковка,
	|	Таблица.Количество                                        КАК Количество,
	|	Таблица.КоличествоУпаковок                                КАК КоличествоУпаковок
	|ПОМЕСТИТЬ Таблица
	|ИЗ
	|	&ТабличнаяЧасть КАК Таблица
	|;
	|
	|//////////////////////////
	|ВЫБРАТЬ
	|	Таблица.НомерСтроки                                       КАК НомерСтроки,
	|	Таблица.НоменклатураНабора                                КАК НоменклатураНабора,
	|	Таблица.ХарактеристикаНабора                              КАК ХарактеристикаНабора,
	|	Таблица.Номенклатура                                      КАК Номенклатура,
	|	Таблица.Характеристика                                    КАК Характеристика,
	|	Таблица.Упаковка                                          КАК Упаковка,
	|	Таблица.Количество                                        КАК Количество,
	|	Таблица.КоличествоУпаковок                                КАК КоличествоУпаковок,
	|	ВариантыКомплектацииНоменклатуры.Ссылка                   КАК ВариантыКомплектацииНоменклатуры,
	|	ВариантыКомплектацииНоменклатуры.ВариантРасчетаЦеныНабора КАК ВариантРасчетаЦеныНабора
	|ПОМЕСТИТЬ ТаблицаСВариантамиКомплектации
	|ИЗ
	|	Таблица КАК Таблица
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ВариантыКомплектацииНоменклатуры КАК ВариантыКомплектацииНоменклатуры
	|		ПО Таблица.НоменклатураНабора = ВариантыКомплектацииНоменклатуры.Владелец
	|			И Таблица.ХарактеристикаНабора = ВариантыКомплектацииНоменклатуры.Характеристика
	|			И ВариантыКомплектацииНоменклатуры.Основной
	|;
	|
	|/////
	|ВЫБРАТЬ
	|	Товары.Ссылка            КАК ВариантыКомплектацииНоменклатуры,
	|	Товары.Номенклатура      КАК Номенклатура,
	|	Товары.Характеристика    КАК Характеристика,
	|	СУММА(ВЫБОР
	|			КОГДА Товары.Количество <> 0
	|				ТОГДА Выбор Когда Товары.ДоляСтоимости = 0 Тогда 1 Иначе  Товары.ДоляСтоимости Конец/ Товары.Количество
	|			ИНАЧЕ 0
	|		КОНЕЦ) КАК ДоляСтоимости
	|ПОМЕСТИТЬ ДолиСтоимости
	|ИЗ
	|	Справочник.ВариантыКомплектацииНоменклатуры.Товары КАК Товары
	|
	|СГРУППИРОВАТЬ ПО
	|	Товары.Номенклатура,
	|	Товары.Характеристика,
	|	Товары.Ссылка
	|;
	|
	|/////
	|ВЫБРАТЬ
	|	Таблица.НомерСтроки                                           КАК НомерСтроки,
	|	Таблица.НоменклатураНабора                                    КАК НоменклатураНабора,
	|	Таблица.ХарактеристикаНабора                                  КАК ХарактеристикаНабора,
	|	Таблица.Номенклатура                                          КАК Номенклатура,
	|	Таблица.Характеристика                                        КАК Характеристика,
	|	Таблица.Упаковка                                              КАК Упаковка,
	|	Таблица.Количество                                            КАК Количество,
	|	Таблица.КоличествоУпаковок                                    КАК КоличествоУпаковок,
	|	ВЫРАЗИТЬ(Таблица.Количество * ЕСТЬNULL(ДолиСтоимости.ДоляСтоимости, 0) КАК Число(15,2)) КАК Цена,
	|	Таблица.ВариантыКомплектацииНоменклатуры                      КАК ВариантыКомплектацииНоменклатуры,
	|	Таблица.ВариантРасчетаЦеныНабора                              КАК ВариантРасчетаЦеныНабора
	|ИЗ
	|	ТаблицаСВариантамиКомплектации КАК Таблица
	|		ЛЕВОЕ СОЕДИНЕНИЕ ДолиСтоимости КАК ДолиСтоимости
	|		ПО ДолиСтоимости.ВариантыКомплектацииНоменклатуры = Таблица.ВариантыКомплектацииНоменклатуры
	|			И Таблица.Номенклатура = ДолиСтоимости.Номенклатура
	|			И Таблица.Характеристика = ДолиСтоимости.Характеристика
	|");
	
	// Выгрузить из таблицы источника
	Если ТипЗнч(ТабличнаяЧасть) = Тип("ТаблицаЗначений") Тогда
		Запрос.Параметры.Вставить("ТабличнаяЧасть", ТабличнаяЧасть.Скопировать());
	Иначе
		Запрос.Параметры.Вставить("ТабличнаяЧасть", ТабличнаяЧасть.Выгрузить());
	КонецЕсли;
	
	ПараметрыРасчета = Новый Структура;
	Для Каждого Параметр Из Параметры Цикл
		ПараметрыРасчета.Вставить(Параметр.Ключ, Параметр.Значение);
	КонецЦикла;
	ПараметрыРасчета.Вставить("РассчитыватьНаборы", Ложь);
	
	ТЧ = Запрос.Выполнить().Выгрузить();
	
	Для Каждого СтрокаТЧ Из ТЧ Цикл
		СтрокаТЧ.Цена = Окр(СтрокаТЧ.Цена * СтрокаТЧ.КоличествоУпаковок, 2);
	КонецЦикла;
	
	Возврат ТЧ;
	
КонецФункции //- ИнфоСофт Сумин Д.В. 16.11.2023 УА #60080 

//+ ИнфоСофт Сумин Д.В. 16.11.2023 УА #60080
Функция ВариантКомплектацииНоменклатурыПоУмолчанию(Знач Номенклатура, Знач Характеристика)

	ВариантКомплектацииНоменклатуры = Неопределено;

	Если Характеристика = Неопределено Тогда
		Характеристика = ПредопределенноеЗначение("Справочник.ХарактеристикиНоменклатуры.ПустаяСсылка");
	КонецЕсли;

	Запрос = Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ 1
						  |	ВариантыКомплектацииНоменклатуры.Ссылка КАК ВариантКомплектацииНоменклатуры
						  |ИЗ
						  |	Справочник.ВариантыКомплектацииНоменклатуры КАК ВариантыКомплектацииНоменклатуры
						  |ГДЕ
						  |	ВариантыКомплектацииНоменклатуры.Владелец = &Владелец
						  |	И ВариантыКомплектацииНоменклатуры.Характеристика = &Характеристика
						  |
						  |УПОРЯДОЧИТЬ ПО
						  |	ВариантыКомплектацииНоменклатуры.Основной УБЫВ,
						  |	ВариантыКомплектацииНоменклатуры.ПометкаУдаления");

	Запрос.УстановитьПараметр("Владелец", Номенклатура);
	Запрос.УстановитьПараметр("Характеристика", Характеристика);

	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		ВариантКомплектацииНоменклатуры = Выборка.ВариантКомплектацииНоменклатуры;
	КонецЕсли;

	Возврат ВариантКомплектацииНоменклатуры;

КонецФункции //- ИнфоСофт Сумин Д.В. 16.11.2023 УА #60080 

//+ ИнфоСофт Сумин Д.В. 04.03.2024 УА #71107
Функция СоздатьДокументОтчетКомиссионераNew(СтруктураДанных) Экспорт 
	
	//+ ИнфоСофт Макарова Н.Е. 10.04.2025 УА #76491
	Если СтруктураДанных.Свойство("ОтчетКомиссионераСсылка") Тогда
		
		ДокОтчет = СтруктураДанных.ОтчетКомиссионераСсылка.ПолучитьОбъект();
		ДокОтчет.УстановитьПометкуУдаления(Ложь);
		
	Иначе
		
		ДокОтчет = Документы.ОтчетКомиссионера.СоздатьДокумент();
		
	КонецЕсли;
	//- ИнфоСофт Макарова Н.Е. 10.04.2025 УА #76491
		
	ПараметрыФормы = Новый Структура;
	
	ПараметрыФормы.Вставить("Партнер", 		СтруктураДанных.Партнер); 
	ПараметрыФормы.Вставить("Контрагент",   СтруктураДанных.Контрагент);
	ПараметрыФормы.Вставить("Организация",  СтруктураДанных.Организация);	
	ПараметрыФормы.Вставить("КонецПериода", СтруктураДанных.ДатаОкончания);
	
	//+ ИнфоСофт Заварин К.В. 02.11.24 УА #86389
	//ДокОтчет.Заполнить(ПараметрыФормы);	
	//- ИнфоСофт Заварин К.В. 02.11.24 УА #86389
	
	//+ ИнфоСофт Мурсалимов Д.Р. 16.06.24 УА #77666
	ДокОтчет.Партнер = СтруктураДанных.Партнер; 
	ДокОтчет.Контрагент = СтруктураДанных.Контрагент;
	ДокОтчет.Организация = СтруктураДанных.Организация;	
	ДокОтчет.КонецПериода = СтруктураДанных.ДатаОкончания;
	//- ИнфоСофт Мурсалимов Д.Р. 16.06.24 УА #77666
	
	ДокОтчет.Дата = КонецДня(СтруктураДанных.ДатаОкончания);
	ДокОтчет.НачалоПериода = НачалоДня(СтруктураДанных.ДатаНачала);
	ДокОтчет.КонецПериода = НачалоДня(СтруктураДанных.ДатаОкончания);
	
	//+ ИнфоСофт Мурсалимов Д.Р. 27.02.25 УА #92506
	//ПродажаОблагаетсяНДС = ИС_WB_СерверУТ11_5.ПолучитьРезультатПроверкиУчетаНДС(СтруктураДанных.Организация); 
	//+ ИнфоСофт Тимофеева А.А. 09.04.2025 УА #95713 
	//ПродажаОблагаетсяНДС = ИС_МП_УправлениеОтчетами.ПолучитьПрименениеНДСОрганизации(СтруктураДанных.Организация);
	//- ИнфоСофт Тимофеева А.А. 09.04.2025 УА #95713 
	//- ИнфоСофт Мурсалимов Д.Р. 27.02.25 УА #92506
	
	//+ ИнфоСофт Тимофеева А.А. 09.04.2025 УА #95713
	//Если ПродажаОблагаетсяНДС Тогда 
	//	ДокОтчет.НалогообложениеНДС = Перечисления.ТипыНалогообложенияНДС.ПродажаОблагаетсяНДС;  		
	//Иначе
	//	ДокОтчет.НалогообложениеНДС = Перечисления.ТипыНалогообложенияНДС.ПродажаНеОблагаетсяНДС;	
	//КонецЕсли;
	
	//- ИнфоСофт Тимофеева А.А. 09.04.2025 УА #95713
	
	ДокОтчет.ДатаПлатежа = СтруктураДанных.ДатаОкончания;
	
	//+ ИнфоСофт Заварин К.В. 02.04.24 УА #66208
	ДокОтчет.НомерВходящегоДокумента = Формат(СтруктураДанных.НомерВходящегоДокумента, "ЧГ=");
	ДокОтчет.ДатаВходящегоДокумента = СтруктураДанных.ДатаВходящегоДокумента;
	//- ИнфоСофт Заварин К.В. 02.04.24 УА #66208
	
	ДокОтчет.Соглашение = СтруктураДанных.Соглашение; 
	ДокОтчет.Договор = СтруктураДанных.Договор;	  
	
	ИспользоватьСоглашенияСКлиентами = ПолучитьФункциональнуюОпцию("ИспользоватьСоглашенияСКлиентами");
	ИспользоватьДоговорыСКлиентами = ПолучитьФункциональнуюОпцию("ИспользоватьДоговорыСКлиентами");
	
	//+ ИнфоСофт Заварин К.В. 02.11.24 УА #86389
	Если ИспользоватьСоглашенияСКлиентами Тогда
		ПараметрыФормы.Вставить("Соглашение", СтруктураДанных.Соглашение); 
		ПараметрыФормы.Вставить("ЗаполнятьПоСоглашению", Истина); 
	КонецЕсли; 

	ДокОтчет.Заполнить(ПараметрыФормы);
	//- ИнфоСофт Заварин К.В. 02.11.24 УА #86389
	
	//+ ИнфоСофт Тимофеева А.А. 09.04.2025 УА #95713 
	НастройкиУчета = УчетНДСУП.ПараметрыУчетаПоОрганизации(СтруктураДанных.Организация, ТекущаяДатаСеанса());	
	ДокОтчет.НалогообложениеНДС = НастройкиУчета.ОсновноеНалогообложениеНДСПродажи;
	
	Если ДокОтчет.НалогообложениеНДС = Перечисления.ТипыНалогообложенияНДС.ПродажаОблагаетсяНДС Тогда  	
		ПродажаОблагаетсяНДС = Истина;
	ИначеЕсли ДокОтчет.НалогообложениеНДС = Перечисления.ТипыНалогообложенияНДС.ЛьготноеНалогообложениеНДСНаУСН Тогда
		ПродажаОблагаетсяНДС = Истина;
	Иначе
		ПродажаОблагаетсяНДС = Ложь;
	КонецЕсли;	
	//- ИнфоСофт Тимофеева А.А. 09.04.2025 УА #95713
	
	//+ ИнфоСофт Стояк Ю.К. 01.07.2024 УА #78655
	ИспользоватьПодразделения = ПолучитьФункциональнуюОпцию("ИспользоватьПодразделения");
	
	Если ИспользоватьПодразделения Тогда
		ДокОтчет.Подразделение = СтруктураДанных.Подразделение;
	КонецЕсли;
	//- ИнфоСофт Стояк Ю.К. 01.07.2024 УА #78655
	
	ЗаполнитьХозОперацию = Истина;
	
	Если ИспользоватьСоглашенияСКлиентами И ДокОтчет.Соглашение.КомиссионныеПродажи25 Тогда 
		ДокОтчет.ХозяйственнаяОперация = Перечисления.ХозяйственныеОперации.РеализацияЧерезКомиссионера;
		ЗаполнитьХозОперацию = Ложь;
	КонецЕсли;
	
	Если ЗаполнитьХозОперацию И ИспользоватьДоговорыСКлиентами И ДокОтчет.Договор.КомиссионныеПродажи25 Тогда 
		ДокОтчет.ХозяйственнаяОперация = Перечисления.ХозяйственныеОперации.РеализацияЧерезКомиссионера;
		ЗаполнитьХозОперацию = Ложь;
	КонецЕсли;
	
	Если ЗаполнитьХозОперацию Тогда
		ДокОтчет.ХозяйственнаяОперация = Перечисления.ХозяйственныеОперации.ПередачаНаКомиссию;
	КонецЕсли;
	
	РассчитатьКомиссионноеВознаграждение = СтруктураДанных.РассчитатьКомиссионноеВознаграждение;
	
	ЦеныВозвратаПоВидуЦен = ?(СтруктураДанных.ВариантФормированияЦеныВозврата = 1, Истина, Ложь);
	
	ВидЦены = СтруктураДанных.ВидЦеныВозврата;
	
	ТаблицаПродаж = СтруктураДанных.ТаблицаПродаж; 
	
	Если РассчитатьКомиссионноеВознаграждение Тогда 
		
		ДокОтчет.УдержатьВознаграждение = Истина; 
		ДокОтчет.СпособРасчетаВознаграждения = Перечисления.СпособыРасчетаКомиссионногоВознаграждения.ПроцентОтСуммыПродажи;
		СуммаУслугВБ = СтруктураДанных.СуммаУслугВБ;
		
		//+ ИнфоСофт Власова И.С. 03.04.25 УА #98046
