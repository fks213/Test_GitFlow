		|				ИНАЧЕ ЕСТЬNULL(УпаковкиЕдиницыИзмерения.Знаменатель, 1)
		|			КОНЕЦ * ВЫБОР
		|				КОГДА ЕСТЬNULL(УпаковкиЕдиницыИзмерения.Числитель, 1) = 0
		|					ТОГДА 1
		|				ИНАЧЕ ЕСТЬNULL(УпаковкиЕдиницыИзмерения.Числитель, 1)
		|			КОНЕЦ
		|	КОНЕЦ КАК Цена
		|ИЗ
		|	вт_ТаблицаНоменклатурыДополненная КАК вт_ТаблицаНоменклатурыДополненная
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.УпаковкиЕдиницыИзмерения КАК УпаковкиЕдиницыИзмерения
		|		ПО (вт_ТаблицаНоменклатурыДополненная.Упаковка = УпаковкиЕдиницыИзмерения.Ссылка)
		|		ЛЕВОЕ СОЕДИНЕНИЕ вт_ЦеныНоменклатуры КАК вт_цены_price"
		
		+ ?(ИспользуетсяЦенообразование25, 
		
		"
		|		ПО (вт_ТаблицаНоменклатурыДополненная.Номенклатура = вт_цены_price.Номенклатура)
		|			И (ВЫБОР
		|				КОГДА вт_ТаблицаНоменклатурыДополненная.Характеристика = ЗНАЧЕНИЕ(Справочник.ХарактеристикиНоменклатуры.ПустаяСсылка)
		|					ТОГДА ЗНАЧЕНИЕ(Справочник.ХарактеристикиНоменклатурыДляЦенообразования.ПустаяСсылка) = вт_цены_price.Характеристика
		|				ИНАЧЕ вт_ТаблицаНоменклатурыДополненная.Характеристика.ХарактеристикаНоменклатурыДляЦенообразования = вт_цены_price.Характеристика
		|			КОНЕЦ)
		|			И (ВЫБОР 
		|				КОГДА вт_ТаблицаНоменклатурыДополненная.Номенклатура.ВидНоменклатуры.НастройкиКлючаЦенПоУпаковке =  Значение(Перечисление.ВариантОтбораДляКлючаЦен.Использовать) 
		|					ТОГДА вт_ТаблицаНоменклатурыДополненная.Упаковка =  вт_цены_price.Упаковка
		|				ИНАЧЕ
		|					Истина
		|				КОНЕЦ)
		|			И (вт_цены_price.ВидЦены = &price)"
		
		,
		
		"
		|		ПО (вт_ТаблицаНоменклатурыДополненная.Номенклатура = вт_цены_price.Номенклатура)
		|			И (вт_ТаблицаНоменклатурыДополненная.Характеристика = вт_цены_price.Характеристика)
		|			И (вт_цены_price.ВидЦены = &price)");
		
	
	Запрос.УстановитьПараметр("ТаблицаНоменклатуры", ТаблицаНоменклатуры);
	Запрос.УстановитьПараметр("price", ВидЦены);	

	РезультатЗапроса = Запрос.Выполнить();

	Выборка = РезультатЗапроса.Выбрать();
	
	Пока Выборка.Следующий() Цикл
		Возврат Выборка.Цена;
	КонецЦикла;
	
