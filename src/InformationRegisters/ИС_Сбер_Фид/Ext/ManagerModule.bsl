//+ ИнфоСофт Стояк Ю.К. 19.08.2024 УА #707356
Функция СформироватьЗаписиПоТовару(парНоменклатура, парЛичныйКабинет, парХарактеристика = Неопределено, парУпаковка = Неопределено) Экспорт
//Функция СформироватьЗаписиПоТовару(парНоменклатура, парЛичныйКабинет) Экспорт
//- ИнфоСофт Стояк Ю.К. 19.08.2024 УА #70735	
	РезультатФормирования	= Ложь;
	СтруктураЗаполнения		= Новый Структура;
	СтруктураЗаполнения.Вставить("Номенклатура",	парНоменклатура);
	СтруктураЗаполнения.Вставить("Профиль",	парЛичныйКабинет); 
	//+ ИнфоСофт Заварин К.В. 13.09.24 УА #68384
	СтруктураЗаполнения.Вставить("Характеристика",	парХарактеристика);
	//- ИнфоСофт Заварин К.В. 13.09.24 УА #68384

	
	СтруктураЗаполнения.Вставить("offer_id");
	СтруктураЗаполнения.Вставить("available");
	СтруктураЗаполнения.Вставить("category");
	СтруктураЗаполнения.Вставить("vendor");
	СтруктураЗаполнения.Вставить("vendor_code");
	СтруктураЗаполнения.Вставить("model");
	СтруктураЗаполнения.Вставить("name");
	СтруктураЗаполнения.Вставить("vat");
	
	//+ ИнфоСофт Стояк Ю.К. 19.08.2024 УА #70735
	СтруктураЗаполнения.Вставить("price");
	//- ИнфоСофт Стояк Ю.К. 19.08.2024 УА #70735
	СтруктураЗаполнения.Вставить("old_price");
	СтруктураЗаполнения.Вставить("barcode");
	СтруктураЗаполнения.Вставить("picture");
	СтруктураЗаполнения.Вставить("description");
	СтруктураЗаполнения.Вставить("url");
	СтруктураЗаполнения.Вставить("order_before");
	СтруктураЗаполнения.Вставить("days");
	
	
	ЗапросНастроек = Новый Запрос;
	ЗапросНастроек.УстановитьПараметр("ЛичныйКабинет",парЛичныйКабинет);
	ЗапросНастроек.Текст = 
		"ВЫБРАТЬ
		|	sberНастройкиПолей.Поле					КАК Поле,
		|	sberНастройкиПолей.ЗначениеПоля			КАК ЗначениеПоля,
		|	sberНастройкиПолей.Настройка			КАК Настройка,
		|	sberНастройкиПолей.ЗначениеПоУмолчанию	КАК ЗначениеПоУмолчанию
		|ИЗ
		|	Справочник.ИС_Сбер_НастройкиВыгрузки.НастройкиПолей КАК sberНастройкиПолей
		|ГДЕ
		|	sberНастройкиПолей.Ссылка.Профиль = &ЛичныйКабинет";
	
	ВыборкаНастроек = ЗапросНастроек.Выполнить().Выбрать();
	Пока ВыборкаНастроек.Следующий() Цикл
		ИмяНастройки = СтрЗаменить(ВыборкаНастроек.Поле,"-","_");
		Если НЕ СтруктураЗаполнения.Свойство(ИмяНастройки) Тогда
			Продолжить;
		КонецЕсли;
		
		Если ИмяНастройки = "barcode" Тогда //Уникальное поле
			ЗапросШК = Новый Запрос;
			ЗапросШК.УстановитьПараметр("Номенклатура",СтруктураЗаполнения.Номенклатура);
			//+ ИнфоСофт Заварин К.В. 16.09.24 УА #68384
			ЗапросШК.УстановитьПараметр("Характеристика", СтруктураЗаполнения.Характеристика); 
			//- ИнфоСофт Заварин К.В. 16.09.24 УА #68384
			ЗапросШК.Текст = 
				"ВЫБРАТЬ ПЕРВЫЕ 5
				|	ШтрихкодыНоменклатуры.Штрихкод КАК Штрихкод
				|ИЗ
				|	РегистрСведений.ШтрихкодыНоменклатуры КАК ШтрихкодыНоменклатуры
				|ГДЕ
				|	ШтрихкодыНоменклатуры.Номенклатура = &Номенклатура 
				//+ ИнфоСофт Заварин К.В. 16.09.24 УА #68384
				|И 	ШтрихкодыНоменклатуры.Характеристика = &Характеристика
				//- ИнфоСофт Заварин К.В. 16.09.24 УА #68384
				|УПОРЯДОЧИТЬ ПО Штрихкод";
			ВыборкаНоменклатуры = ЗапросШК.Выполнить().Выбрать();
			
			МассивШтрихКодов = Новый Массив;
			Пока ВыборкаНоменклатуры.Следующий() Цикл
				МассивШтрихКодов.Добавить(ВыборкаНоменклатуры.Штрихкод);
			КонецЦикла;
			СтруктураЗаполнения[ИмяНастройки] = СтрСоединить(МассивШтрихКодов,", ");
		ИначеЕсли ИмяНастройки = "offer_id" Тогда
			СтруктураЗаполнения[ИмяНастройки] = ОпределитьЗначениеРеквизитаИлиСвойстваНоменклатуры(парНоменклатура,ВыборкаНастроек.Настройка);
		//+ ИнфоСофт Заварин К.В. 16.09.24 УА #68384
		ИначеЕсли ИмяНастройки = "vendor_code" И ВыборкаНастроек.ЗначениеПоля = "Артикул + Характеристика" Тогда
			СтруктураЗаполнения[ИмяНастройки] = ОпределитьЗначениеРеквизитаИлиСвойстваНоменклатуры(парНоменклатура,ВыборкаНастроек.Настройка) 
												+ СтрШаблон("%1", СтруктураЗаполнения.Характеристика);
		ИначеЕсли ИмяНастройки = "name" И ВыборкаНастроек.ЗначениеПоля = "Наименование + Характеристика" Тогда
			СтруктураЗаполнения[ИмяНастройки] = ОпределитьЗначениеРеквизитаИлиСвойстваНоменклатуры(парНоменклатура,ВыборкаНастроек.Настройка) 
												+ СтрШаблон(" %1", СтруктураЗаполнения.Характеристика);
		//- ИнфоСофт Заварин К.В. 16.09.24 УА #68384
		ИначеЕсли ИмяНастройки = "available" Тогда	//Уникальное поле
			СтруктураЗаполнения[ИмяНастройки] = ?(ВыборкаНастроек.ЗначениеПоля = "Доступен",Истина,Ложь);
		ИначеЕсли ИмяНастройки = "vat" Тогда		//Уникальное поле
			СтруктураЗаполнения[ИмяНастройки] = ОпределитьЗначениеРеквизитаИлиСвойстваНоменклатуры(парНоменклатура,ВыборкаНастроек.Настройка,,,Истина);
		ИначеЕсли ВыборкаНастроек.ЗначениеПоУмолчанию Тогда
			СтруктураЗаполнения[ИмяНастройки] = ВыборкаНастроек.ЗначениеПоля;
		//+ ИнфоСофт Стояк Ю.К. 19.08.2024 УА #70735
		ИначеЕсли ИмяНастройки = "price" И ВыборкаНастроек.ЗначениеПоля <> "Ручной ввод" Тогда
			СтруктураЗаполнения[ИмяНастройки] = ЗаполнитьЦену(парНоменклатура, парХарактеристика, парУпаковка, ВыборкаНастроек.ЗначениеПоля, парЛичныйКабинет);
		ИначеЕсли ИмяНастройки = "old_price" И ВыборкаНастроек.ЗначениеПоля <> "Ручной ввод" Тогда
		//ИначеЕсли ИмяНастройки = "old_price" Тогда	//Ведро гвоздей
				//СтруктураЗаполнения[ИмяНастройки] = ОпределитьЗначениеРеквизитаИлиСвойстваНоменклатуры(парНоменклатура,ВыборкаНастроек.Настройка);
			СтруктураЗаполнения[ИмяНастройки] = ЗаполнитьЦену(парНоменклатура, парХарактеристика, парУпаковка, ВыборкаНастроек.ЗначениеПоля, парЛичныйКабинет);
		//- ИнфоСофт Стояк Ю.К. 19.08.2024 УА #70735
		Иначе
			СтруктураЗаполнения[ИмяНастройки] = ОпределитьЗначениеРеквизитаИлиСвойстваНоменклатуры(парНоменклатура,ВыборкаНастроек.Настройка);
		КонецЕсли;
	КонецЦикла;
	
	НоваяЗапись = СоздатьМенеджерЗаписи();
	ЗаполнитьЗначенияСвойств(НоваяЗапись,СтруктураЗаполнения);
	НоваяЗапись.Записать(Истина);
	
	РезультатФормирования = Истина;
	
	Возврат РезультатФормирования;
КонецФункции 

Функция ОпределитьЗначениеРеквизитаИлиСвойстваНоменклатуры(МассивНоменклатуры, 
															ОписаниеПоляЗначения, 
															МножественныйОтвет = Ложь,
															РасширенныйПоиск = Ложь,
															ВозвращатьЗначение = Ложь) Экспорт
	
	ВозвращаемоеЗначение = Новый Массив;
	
	Если ВероятноJSON(ОписаниеПоляЗначения) Тогда
		СтруктураОпределения = Прочитать(ОписаниеПоляЗначения);
		НаборОпределения	= ЗначениеИзСтрокиВнутр(СтруктураОпределения.Набор);
		СвойствоОпределения	= ЗначениеИзСтрокиВнутр(СтруктураОпределения.Свойство);
		
		ДопРеквизит = НаборОпределения.ДополнительныеРеквизиты.Найти(СвойствоОпределения,"Свойство");
		ДопСвойство = НаборОпределения.ДополнительныеСведения.Найти(СвойствоОпределения,"Свойство");
		
		Запрос = Новый Запрос;
		Запрос.УстановитьПараметр("Свойство",	СвойствоОпределения);
		Запрос.УстановитьПараметр("Объект",		МассивНоменклатуры);
		
		Если ДопРеквизит <> Неопределено Тогда
			Запрос.Текст = ТекстЗапросаДополнительногоРеквизитаНоменклатуры(РасширенныйПоиск);
			ВыборкаЗапроса = Запрос.Выполнить().Выбрать();
			Пока ВыборкаЗапроса.Следующий() Цикл
				ВозвращаемоеЗначение.Добавить(ВыборкаЗапроса.Значение);
			КонецЦикла;
		ИначеЕсли ДопСвойство <> Неопределено Тогда
			Запрос.Текст = ТекстЗапросаДополнительногоСвойстваНоменклатуры(РасширенныйПоиск);
			ВыборкаЗапроса = Запрос.Выполнить().Выбрать();
			Пока ВыборкаЗапроса.Следующий() Цикл
				ВозвращаемоеЗначение.Добавить(ВыборкаЗапроса.Значение);
			КонецЦикла;
		КонецЕсли;
	Иначе
		
		Запрос = Новый Запрос;
		Запрос.УстановитьПараметр("Объект",		МассивНоменклатуры);
		Запрос.Текст = 
			"ВЫБРАТЬ
			|	Номенклатура.%1 КАК Значение
			|ИЗ
			|	Справочник.Номенклатура КАК Номенклатура
			|ГДЕ
			|	Ссылка В(&Объект)";
		Запрос.Текст = СтрШаблон(Запрос.Текст,ОписаниеПоляЗначения);
		
		Попытка 
			ВыборкаЗапроса = Запрос.Выполнить().Выбрать();
			Пока ВыборкаЗапроса.Следующий() Цикл
				ВозвращаемоеЗначение.Добавить(ВыборкаЗапроса.Значение);
			КонецЦикла;
		Исключение 
			ИнформацияОбОшибке = ИнформацияОбОшибке();
		КонецПопытки;
		//Для Каждого элНоменклатура Из МассивНоменклатуры Цикл
		//	Попытка
		//		ЗначениеРеквизита = элНоменклатура[ОписаниеПоляЗначения];
		//		Если ТипЗнч(ЗначениеРеквизита) = Тип("Число") Тогда
		//			ВозвращаемоеЗначение.Добавить(Формат(ЗначениеРеквизита,"ЧГ=0"));
		//		Иначе
		//			ВозвращаемоеЗначение.Добавить(ЗначениеРеквизита);
		//		КонецЕсли;
		//	Исключение КонецПопытки;
		//КонецЦикла;
	КонецЕсли;
	
	МассивПриведения = Новый Массив;
	Для Каждого элНоменклатура Из ВозвращаемоеЗначение Цикл
		Если ВозвращатьЗначение Тогда
			МассивПриведения.Добавить(элНоменклатура);
		ИначеЕсли ТипЗнч(элНоменклатура) = Тип("Число") Тогда
			МассивПриведения.Добавить(Формат(элНоменклатура,"ЧГ=0"));
		Иначе
			МассивПриведения.Добавить(СокрЛП(Строка(элНоменклатура)));
		КонецЕсли;
	КонецЦикла;
	
	Если МассивПриведения.Количество() = 0 Тогда
		Возврат Неопределено;
	ИначеЕсли МножественныйОтвет Тогда
		Возврат МассивПриведения;
	Иначе
		Возврат МассивПриведения[0];
	КонецЕсли;
КонецФункции

Функция ВероятноJSON(знач входСтрока) Экспорт
	входСтрока = СокрЛП(входСтрока);
	
	СоответствиеПроверки = Новый Соответствие;
	СоответствиеПроверки.Вставить("{",0);
	СоответствиеПроверки.Вставить("}",0);
	СоответствиеПроверки.Вставить("[",0);
	СоответствиеПроверки.Вставить("]",0);
	
	Для Каждого ЭлементСоответствия Из СоответствиеПроверки Цикл
		СоответствиеПроверки.Вставить(ЭлементСоответствия.Ключ,СтрЧислоВхождений(входСтрока,ЭлементСоответствия.Ключ));
	КонецЦикла;
	
	ПохожеНаJSON = (СоответствиеПроверки.Получить("{") + СоответствиеПроверки.Получить("}") + СоответствиеПроверки.Получить("[") + СоответствиеПроверки.Получить("]") > 1);
	
	Если ПохожеНаJSON Тогда
		ПохожеНаJSON = СоответствиеПроверки.Получить("{") = СоответствиеПроверки.Получить("}");
	КонецЕсли;
	
	Если ПохожеНаJSON Тогда
		ПохожеНаJSON = СоответствиеПроверки.Получить("[") = СоответствиеПроверки.Получить("]");
	КонецЕсли;
	
	Если ПохожеНаJSON Тогда
		ПохожеНаJSON = СоответствиеПроверки.Получить(Лев(входСтрока,1)) <> Неопределено;
	КонецЕсли;
	
	Если ПохожеНаJSON Тогда
		ПохожеНаJSON = СоответствиеПроверки.Получить(Прав(входСтрока,1)) <> Неопределено;
	КонецЕсли;
	
	Возврат ПохожеНаJSON;
КонецФункции 

//Возвращает объект
Функция Прочитать(Знач Строка,СтрДат="",ФлагСоответствие=Ложь) Экспорт
	
	Если ЗначениеЗаполнено(Строка) Тогда
		ВозвращаемоеЗначение = Строка;
		Если ВероятноJSON(Строка) Тогда
			Строка = СтрЗаменить(Строка, "¶", "");
			ЧтениеJSON = Новый ЧтениеJSON;
			ЧтениеJSON.УстановитьСтроку(Строка);
			ВозвращаемоеЗначение = ПрочитатьJSON(ЧтениеJSON,ФлагСоответствие,СтрДат);
		КонецЕсли;
	Иначе
		ВозвращаемоеЗначение = Новый Структура;
	КонецЕсли;
		
	Возврат ВозвращаемоеЗначение;
	
КонецФункции

//Возвращает строку
Функция Записать(Структура,
				ПереносСтрок = Неопределено, 
				Экранирование = Неопределено) Экспорт 
	
	Если ПереносСтрок = Неопределено Тогда	
		ПереносСтрок = ПереносСтрокJSON.Авто;
	КонецЕсли;
	Если Экранирование = Неопределено Тогда
		Экранирование = ЭкранированиеСимволовJSON.СимволыВнеASCII;
	КонецЕсли;
	
	ЗаписьJSON = Новый ЗаписьJSON;
	ПараметрыЗаписи = Новый ПараметрыЗаписиJSON(ПереносСтрок , Символы.Таб,,Экранирование);
	ЗаписьJSON.УстановитьСтроку(ПараметрыЗаписи);
	ЗаписьJSON.ПроверятьСтруктуру = Ложь;
	ЗаписатьJSON(ЗаписьJSON, Структура);
	
	Попытка 
		ВозвращаемоеЗначение = ЗаписьJSON.Закрыть();
	Исключение
		ВозвращаемоеЗначение = Неопределено;
	КонецПопытки;
	
	Возврат ВозвращаемоеЗначение;
	
КонецФункции

Функция ТекстЗапросаДополнительногоРеквизитаНоменклатуры(РасширенныйПоиск = Ложь)
	Если РасширенныйПоиск Тогда
		ВозвращаемыйТекст = 
			"ВЫБРАТЬ
			|	НоменклатураДополнительныеРеквизиты.Ссылка КАК Объект,
			|	НоменклатураДополнительныеРеквизиты.Значение КАК Значение
			|ИЗ
			|	Справочник.Номенклатура.ДополнительныеРеквизиты КАК НоменклатураДополнительныеРеквизиты
			|ГДЕ
			|	НоменклатураДополнительныеРеквизиты.Свойство = &Свойство
			|	И НоменклатураДополнительныеРеквизиты.Ссылка В(&Объект)
			|
			|ОБЪЕДИНИТЬ ВСЕ
			|
			|ВЫБРАТЬ
			|	ХарактеристикиНоменклатурыДополнительныеРеквизиты.Ссылка,
			|	ХарактеристикиНоменклатурыДополнительныеРеквизиты.Значение
			|ИЗ
			|	Справочник.ХарактеристикиНоменклатуры.ДополнительныеРеквизиты КАК ХарактеристикиНоменклатурыДополнительныеРеквизиты
			|ГДЕ
			|	ХарактеристикиНоменклатурыДополнительныеРеквизиты.Свойство = &Свойство
			|	И ХарактеристикиНоменклатурыДополнительныеРеквизиты.Ссылка.Владелец В(&Объект)
			|
			|
			|
			|";
			
	Иначе
		ВозвращаемыйТекст = 
			"ВЫБРАТЬ
			|	НоменклатураДополнительныеРеквизиты.Ссылка КАК Объект,
			|	НоменклатураДополнительныеРеквизиты.Значение КАК Значение
			|ИЗ
			|	Справочник.Номенклатура.ДополнительныеРеквизиты КАК НоменклатураДополнительныеРеквизиты
			|ГДЕ
			|	НоменклатураДополнительныеРеквизиты.Свойство = &Свойство
			|	И НоменклатураДополнительныеРеквизиты.Ссылка В(&Объект)
			|
			|ОБЪЕДИНИТЬ ВСЕ
			|
			|ВЫБРАТЬ
