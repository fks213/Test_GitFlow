&НаКлиенте
Процедура Выбрать(Команда)
	ЭтоВыбор = Истина;
	Закрыть();	
КонецПроцедуры //- ИнфоСофт Ивонин К.А. 29.09.23 УА #64020

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

//+ ИнфоСофт Ивонин К.А. 29.09.23 УА #64020
&НаСервереБезКонтекста   
Функция ПолучитьСписокМагазиновНаСервере(Профиль)
	Возврат ИС_ЯМ_Сервер.ПолучитьСписокМагазинов(Профиль);	
КонецФункции //- ИнфоСофт Ивонин К.А. 29.09.23 УА #64020

//+ ИнфоСофт Ивонин К.А. 29.09.23 УА #64020
&НаСервере   
Процедура ЗаполнитьТаблицуМагазинов(СписокМагазинов)
	
	ТаблицаМагазинов.Очистить();
	
	Для Каждого Магазин Из СписокМагазинов Цикл
		
		НоваяСтрока = ТаблицаМагазинов.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, Магазин);
		
		Если Магазин.Свойство("business") Тогда
			
			Если Магазин.business.Свойство("id") Тогда
				НоваяСтрока.BusinessID = Магазин.business.id;
			КонецЕсли;	
			
		КонецЕсли;
			
	КонецЦикла;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ИС_MP_Настройки.ЛичныйКабинет КАК Профиль,
	|	ИС_MP_Настройки.Значение КАК Значение
	|ИЗ
	|	Справочник.ИС_MP_Настройки КАК ИС_MP_Настройки
	|ГДЕ
	|	ИС_MP_Настройки.Наименование = ""ЯМКампанияID""";
		
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаПараметров = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаПараметров.Следующий() Цикл
	    
	    Если Не ЗначениеЗаполнено(ВыборкаПараметров.Значение) Тогда
	    	Продолжить;
	    КонецЕсли;
	    
	    Попытка 
	    	ИД = Число(ВыборкаПараметров.Значение);
	    Исключение
	    	Продолжить;
	    КонецПопытки;
	    
		НайденныеСтроки = ТаблицаМагазинов.НайтиСтроки(Новый Структура("id", ИД));
		
		Для Каждого Строка Из НайденныеСтроки Цикл
			Строка.Профиль = ВыборкаПараметров.Профиль;
		КонецЦикла;
	
	КонецЦикла;
		
КонецПроцедуры //- ИнфоСофт Ивонин К.А. 29.09.23 УА #64020

#КонецОбласти
