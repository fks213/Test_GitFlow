
#Область ОбработчикиСобытийФормы

//+ ИнфоСофт Ивонин К.А. 28.09.23 УА #64020
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Если Не Параметры.Свойство("Профиль") Тогда
		Отказ = Истина;
		ОбщегоНазначения.СообщитьПользователю("Не выбран профиль");
		Возврат;
	КонецЕсли;
	
	Профиль = Параметры.Профиль;
	
	СписокМагазинов = ПолучитьСписокМагазиновНаСервере(Профиль);
	
	Если СписокМагазинов = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
    ЗаполнитьТаблицуМагазинов(СписокМагазинов);
	
КонецПроцедуры //- ИнфоСофт Ивонин К.А. 28.09.23 УА #64020

//+ ИнфоСофт Ивонин К.А. 29.09.23 УА #64020
&НаКлиенте
Процедура ПриЗакрытии(ЗавершениеРаботы)
	
	Если ЭтоВыбор Тогда
		
		ТекДанные = Элементы.ТаблицаМагазинов.ТекущиеДанные;
		
		Если ТекДанные = Неопределено Тогда
			Возврат;
		КонецЕсли;
		
		ПараметрыЗакрытия = Новый Структура;
		ПараметрыЗакрытия.Вставить("CampaignID", ТекДанные.id);
		ПараметрыЗакрытия.Вставить("BusinessID", ТекДанные.BusinessID);
		
		//+ ИнфоСофт Мурсалимов Д.Р. 10.09.24 УА #83277
		ПараметрыЗакрытия.Вставить("МодельРаботы", ТекДанные.placementType);
		//- ИнфоСофт Мурсалимов Д.Р. 10.09.24 УА #83277

		Оповестить("ВыборМагазина", ПараметрыЗакрытия, ЭтотОбъект);
		
	КонецЕсли;

КонецПроцедуры //- ИнфоСофт Ивонин К.А. 29.09.23 УА #64020

#КонецОбласти

#Область ОбработчикиКомандФормы

