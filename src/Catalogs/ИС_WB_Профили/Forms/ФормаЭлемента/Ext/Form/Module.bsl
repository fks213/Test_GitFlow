//+ ИнфоСофт Ивонин К.А. 21.10.24 УА #68001
&НаКлиенте
Процедура ИнтеграцияПриИзменении(Элемент)
	
	Маркетплейс = СтрЗаменить(Элемент.Имя, "Интеграция", "");
	Элементы["Страница" + Маркетплейс].Видимость = Объект[Элемент.Имя];
	Если Объект[Элемент.Имя] Тогда
		ЗаполнитьПоУмолчаниюНажатие(Элементы["ЗаполнитьПоУмолчанию" + Маркетплейс]);
	КонецЕсли;
	
КонецПроцедуры //- ИнфоСофт Ивонин К.А. 21.10.24 УА #68001

//+ ИнфоСофт Ивонин К.А. 21.10.24 УА #68001
&НаКлиенте
Процедура ЗаполнитьПоУмолчаниюНажатие(Элемент)
	Маркетплейс = СтрЗаменить(Элемент.Имя, "ЗаполнитьПоУмолчанию", "");
	СтруктураНастроек = ИС_МП_Клиент.НастройкиСоединенияПоУмолчанию(Маркетплейс);
	ЗаполнитьЗначенияСвойств(ЭтотОбъект, СтруктураНастроек);
	Модифицированность = Истина;
КонецПроцедуры //- ИнфоСофт Ивонин К.А. 21.10.24 УА #68001

//+ ИнфоСофт Ивонин К.А. 22.10.24 УА #68001
&НаКлиенте
Процедура ТестПодключенияНажатие(Элемент)
	
	ОчиститьСообщения();
	
	Если Не ЗначениеЗаполнено(Объект.Ссылка) Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю("Перед проведением теста необходимо записать Профиль");
		Возврат;	
	КонецЕсли;
	
	Маркетплейс = СтрЗаменить(Элемент.Имя, "ТестПодключения", "");
	ПараметрыТеста = ИС_МП_Клиент.ПараметрыТестаПодключения(Маркетплейс, ЭтотОбъект);
	
	Если ПараметрыТеста = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Результат = ТестПодключенияМаркетплейсов(Объект.Ссылка, Маркетплейс, ПараметрыТеста);
	
	ОбщегоНазначенияКлиент.СообщитьПользователю(Результат);
	
КонецПроцедуры //- ИнфоСофт Ивонин К.А. 22.10.24 УА #68001

//+ ИнфоСофт Ивонин К.А. 01.03.25 УА #92887
&НаКлиенте
Процедура ДанныеОтладкиНажатие(Элемент)
	
	Если Не ЗначениеЗаполнено(Объект.Ссылка) Тогда
		Возврат;	
	КонецЕсли;
	
	Маркетплейс = ПредопределенноеЗначение("Перечисление.ИС_МП_Маркетплейсы." 
		+ СтрЗаменить(Элемент.Имя, "ДанныеОтладки", ""));
	
	Отбор = Новый Структура;
	Отбор.Вставить("Профиль", Объект.Ссылка);
	Отбор.Вставить("Маркетплейс", Маркетплейс);
	
	ПараметрыФормы = Новый Структура;
	
	ПараметрыФормы.Вставить("Отбор", Отбор);
	
	ОткрытьФорму("РегистрСведений.ИС_МП_ДанныеОтладки.Форма.ФормаСписка", ПараметрыФормы, ЭтотОбъект);

КонецПроцедуры //- ИнфоСофт Ивонин К.А. 01.03.25 УА #92887

//+ ИнфоСофт Ивонин К.А. 22.04.25 УА #96894
&НаКлиенте
Процедура ВБАвтоматическиСопоставлятьПриИзменении(Элемент)
	
	Если ВБАвтоматическиСопоставлять И Не ЗначениеЗаполнено(ВБСопоставлятьПо) Тогда
