//+ ИнфоСофт Ивонин К.А. 22.01.23 УА #53535
&НаСервере
Процедура ОбновитьОбработкуЗапускаРегламентныхЗаданийНаСервере()
	
	Результат = ИС_MP_РаботаСРегламентнымиЗаданиями.ЗагрузитьОбработкуЗапускаРегламентныхЗаданий();
	ОбработкаСсылка = Результат.ОбработкаСсылка;
	
	ОбработкаОбъект = ОбработкаСсылка.ПолучитьОбъект();
	ОбработкаОбъект.Команды.Очистить();
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ИС_WB_РегламентныеЗадания.Профиль КАК Профиль,
	|	ИС_WB_РегламентныеЗадания.ИдентификаторКоманды КАК ИдентификаторКоманды,
	|	ИС_WB_РегламентныеЗадания.ИдентификаторЗадания КАК ИдентификаторЗадания
	|ИЗ
	|	РегистрСведений.ИС_WB_РегламентныеЗадания КАК ИС_WB_РегламентныеЗадания";
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Выборка = РезультатЗапроса.Выбрать();
	
	Пока Выборка.Следующий() Цикл 
		
		НоваяКоманда = ОбработкаОбъект.Команды.Добавить();
		НоваяКоманда.Представление  = СтрШаблон("Профиль (%1): %2", Выборка.Профиль, Выборка.ИдентификаторКоманды);
		НоваяКоманда.Идентификатор 	= Выборка.ИдентификаторКоманды;
		НоваяКоманда.ВариантЗапуска = Перечисления.СпособыВызоваДополнительныхОбработок.ВызовСерверногоМетода;
		НоваяКоманда.РегламентноеЗаданиеGUID = Выборка.ИдентификаторЗадания;
		
	КонецЦикла;
	
	Попытка
		ОбработкаОбъект.Записать();
	Исключение
		ОбщегоНазначения.СообщитьПользователю(ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;
	
КонецПроцедуры //- ИнфоСофт Ивонин К.А. 22.01.23 УА #53535

