//+ ИнфоСофт Ивонин К.А. 17.01.25 УА #89159
&НаКлиенте
Асинх Процедура УдалитьТокенВБ(Команда)
	
	ТекущиеДанные = Элементы.ТокеныВБ.ТекущиеДанные;
	
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Ответ = Ждать ВопросАсинх("Уверены что хотите удалить токен?", РежимДиалогаВопрос.ДаНет, 10, КодВозвратаДиалога.Нет,
		"Удаление токена", КодВозвратаДиалога.Нет);
	
	Если Ответ = КодВозвратаДиалога.Нет Тогда
        Возврат;
	КонецЕсли;
	
	УдалитьТокенНаСервере(ТекущиеДанные.Ссылка);
	ОбновитьТаблицуТокеновВБ();
	
