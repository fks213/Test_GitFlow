&НаКлиенте
Процедура ЗаполнитьНастройки()

	Если Не ЗначениеЗаполнено(Объект.Ссылка) Тогда
		Возврат;
	КонецЕсли;
    
    МассивНаименованийРеквизитов = ПолучитьМассивНаименованийНастраиваемыхРеквизитов();

	Настройки = ПолучитьНастройки(Объект.Ссылка, МассивНаименованийРеквизитов);
	
	Если Настройки = Неопределено Тогда
		
		Для Каждого Элемент Из МассивНаименованийРеквизитов Цикл
			ЭтотОбъект[Элемент] = Неопределено;
		КонецЦикла;
		
	Иначе
		
		Для Каждого Элемент Из МассивНаименованийРеквизитов Цикл
			ЭтотОбъект[Элемент] = Настройки[Элемент];
		КонецЦикла;
	
	КонецЕсли;
	
	//+ ИнфоСофт Сумин Д.В. 17.02.2024 УА #65888	
    ЗаполнитьНазначенияНаСервере();
	//- ИнфоСофт Сумин Д.В. 17.02.2024 УА #65888
	
	//+ ИнфоСофт Мурсалимов Д.Р. 04.07.24 УА #66901 
	ПолучитьРеквизитыЦенНаСервере();
	//- ИнфоСофт Мурсалимов Д.Р. 04.07.24 УА #66901
	
	//+ ИнфоСофт Мурсалимов Д.Р. 10.09.24 УА #83277
	ПолучитьРеквизитыЗаказовНаСервере();           
	//- ИнфоСофт Мурсалимов Д.Р. 10.09.24 УА #83277
	
КонецПроцедуры //- ИнфоСофт Стояк Ю.К. 21.02.2023 УА #54628

