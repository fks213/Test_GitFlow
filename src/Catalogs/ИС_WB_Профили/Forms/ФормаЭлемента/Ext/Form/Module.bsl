&НаСервере
Процедура ЗаполнитьНастройкуРегламентныхЗаданий(ИдентификаторКоманды) 
		
	РегламентноеЗаданиеGUID = 
		ИС_MP_РаботаСРегламентнымиЗаданиями.ПолучитьGUIDЗадания(Объект.Ссылка, ИдентификаторКоманды);
	
	УстановитьПривилегированныйРежим(Истина);
	
	Задание = РегламентныеЗадания.НайтиПоУникальномуИдентификатору(РегламентноеЗаданиеGUID);
	
	УстановитьПривилегированныйРежим(Ложь);
	
	Если Задание = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ЭлементФормы = Элементы["Расписание" + ИдентификаторКоманды];
	
	ЭтотОбъект[ИдентификаторКоманды] = Задание.Использование;
	Если ЭтотОбъект[ИдентификаторКоманды] Тогда
		ЭлементФормы.Видимость = Истина;
		ЭлементФормы.Заголовок = Задание.Расписание;
	КонецЕсли;
	
	Если Задание.ПоследнееЗадание <> Неопределено Тогда
		
		Элементы["Дата" + ИдентификаторКоманды].Видимость = Истина;
		Элементы["Состояние" + ИдентификаторКоманды].Видимость = Истина;  
		
		Если Задание.ПоследнееЗадание.Конец <> Неопределено Тогда 
			ЭтотОбъект["Дата" + ИдентификаторКоманды] = ИС_МП_Сервер.ЛокализоватьДату(Задание.ПоследнееЗадание.Конец);
		КонецЕсли;
		
		Если Задание.ПоследнееЗадание.Состояние = СостояниеФоновогоЗадания.Активно Тогда
			Элементы["Состояние" + ИдентификаторКоманды].Картинка = БиблиотекаКартинок.ОформлениеКругЗаполненный;
		ИначеЕсли Задание.ПоследнееЗадание.Состояние = СостояниеФоновогоЗадания.Завершено Тогда
			Элементы["Состояние" + ИдентификаторКоманды].Картинка = БиблиотекаКартинок.ОформлениеКругЗеленый;
		ИначеЕсли Задание.ПоследнееЗадание.Состояние = СостояниеФоновогоЗадания.ЗавершеноАварийно Тогда
			Элементы["Состояние" + ИдентификаторКоманды].Картинка = БиблиотекаКартинок.ОформлениеКругКрасный;
		Иначе
			Элементы["Состояние" + ИдентификаторКоманды].Картинка = БиблиотекаКартинок.ОформлениеКругЖелтый;
		КонецЕсли;
			
	КонецЕсли; 

КонецПроцедуры //- ИнфоСофт Ивонин К.А. 22.01.23 УА #53535

//+ ИнфоСофт Ивонин К.А. 07.12.22 УА #52566
