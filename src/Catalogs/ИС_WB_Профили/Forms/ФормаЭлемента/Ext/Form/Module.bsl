//+ ИнфоСофт Стояк Ю.К. 27.10.2023 УА #65146
&НаКлиенте
Процедура ФормироватьЕдиныйЗаказБезРазбиенияПриИзменении(Элемент)
	
	//+ ИнфоСофт Макарова Н.Е. 01.04.2025 УА #77424
	Если ФормироватьЕдиныйЗаказБезРазбиенияOzon И НЕ ИспользоватьРазбиениеПоСкладамOzon Тогда
		Элементы.АктивныйЗаказКлиентаOzon.Видимость = Истина;
	Иначе
		Элементы.АктивныйЗаказКлиентаOzon.Видимость = Ложь; 
	КонецЕсли;
	
	Если НЕ Объект.ИспользоватьРазбиениеПоСкладам Тогда
		Элементы.АктивныйЗаказКлиента.Видимость = Истина;
	Иначе
		Элементы.АктивныйЗаказКлиента.Видимость = Ложь; 
	КонецЕсли;
	
	Если ФормироватьЕдиныйЗаказБезРазбиенияЯМ И НЕ ИспользоватьРазбиениеПоСкладамЯМ Тогда
		Элементы.АктивныйЗаказКлиентаЯМ.Видимость = Истина;
	Иначе
		Элементы.АктивныйЗаказКлиентаЯМ.Видимость = Ложь; 
	КонецЕсли;
	//- ИнфоСофт Макарова Н.Е. 01.04.2025 УА #77424  
	
	Если ФормироватьЕдиныйЗаказБезРазбиенияАли Тогда
		Элементы.АктивныйЗаказКлиентаАли.Видимость = Истина;
	Иначе
		Элементы.АктивныйЗаказКлиентаАли.Видимость = Ложь; 
	КонецЕсли;
	
	//+ ИнфоСофт Стояк Ю.К. 09.04.2024 УА #73643
	Если СберФормироватьЕдиныйЗаказБезРазбиения Тогда
		Элементы.СберАктивныйЗаказКлиента.Видимость = Истина;
	Иначе
		Элементы.СберАктивныйЗаказКлиента.Видимость = Ложь; 
	КонецЕсли;  
	//- ИнфоСофт Стояк Ю.К. 09.04.2024 УА #73643 
	
КонецПроцедуры //- ИнфоСофт Стояк Ю.К. 27.10.2023 УА #65146

//+ ИнфоСофт Стояк Ю.К. 13.11.2023 УА #62353
&НаКлиенте
Процедура АвтоматическиДобавлятьВПоставкуПриИзменении(Элемент)
	
	Если Объект.АвтоматическиДобавлятьВПоставку И Объект.РежимСозданияЗаказов = 2 Тогда				
		Элементы.Поставка.Видимость = Истина;
		Элементы.ПоставкаКГТ.Видимость = Истина;
		Элементы.ПоставкаСГТ.Видимость = Истина;
	Иначе
		Элементы.Поставка.Видимость = Ложь;
		Элементы.ПоставкаКГТ.Видимость = Ложь;
		Элементы.ПоставкаСГТ.Видимость = Ложь;
	КонецЕсли;
	
КонецПроцедуры //- ИнфоСофт Стояк Ю.К. 13.11.2023 УА #62353

