//+ ИнфоСофт Ивонин К.А. 22.01.23 УА #53535
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	УстановитьУсловноеОформление();
	ОпределитьИнтегрируемыеМаркетплейсы();
	ПолучитьНастройкиМаркетплейсов();
	
	УправлениеФормойНаСервере();
	ЗаполнитьНастройкиРегламентныхЗаданий();
	
КонецПроцедуры //- ИнфоСофт Ивонин К.А. 22.01.23 УА #53535

//+ ИнфоСофт Ивонин К.А. 24.06.22 УА #46999
&НаКлиенте
Процедура ПриОткрытии(Отказ)

	Если Не ЗначениеЗаполнено(Объект.Ссылка) Тогда
		УстановитьНастройкиСоединенияПоУмолчанию();
	КонецЕсли;
	                   
	ЗаполнитьНастройки();
	УправлениеФормой();
	РежимТехническогоСпециалиста(Неопределено);

КонецПроцедуры //- ИнфоСофт Ивонин К.А. 24.06.22 УА #46999

//+ ИнфоСофт Ивонин К.А. 27.06.22 УА #46999
&НаКлиенте
Процедура ПослеЗаписи(ПараметрыЗаписи)
	
	ТекущееАктивноеОкно = АктивноеОкно();
	ОбновитьИнтерфейс();
	Если ТекущееАктивноеОкно <> Неопределено Тогда
		ТекущееАктивноеОкно.Активизировать();
	КонецЕсли;
	
	ОбновитьПовторноИспользуемыеЗначения(); 
	
	ЗаписатьНаСервере();

КонецПроцедуры //- ИнфоСофт Ивонин К.А. 27.06.22 УА #46999

