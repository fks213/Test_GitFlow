&НаКлиенте
Процедура ИзменитьЗначениеСкрываемогоОстатка()
		
	Если ВБРежимСокрытияОстатков Тогда
		Элементы.ВБСкрываемыйОстаток.МаксимальноеЗначение = 100;
	Иначе
		Элементы.ВБСкрываемыйОстаток.МаксимальноеЗначение = Неопределено;	
	КонецЕсли;
	
	Если ОзонРежимСокрытияОстатков Тогда
		Элементы.ОзонСкрываемыйОстаток.МаксимальноеЗначение = 100;
	Иначе
		Элементы.ОзонСкрываемыйОстаток.МаксимальноеЗначение = Неопределено;
	КонецЕсли;
	
	Если ЯМРежимСокрытияОстатков Тогда
		Элементы.ЯМСкрываемыйОстаток.МаксимальноеЗначение = 100;
	Иначе
		Элементы.ЯМСкрываемыйОстаток.МаксимальноеЗначение = Неопределено;
	КонецЕсли;
	
	Если СберРежимСокрытияОстатков Тогда
		Элементы.СберСкрываемыйОстаток.МаксимальноеЗначение = 100;
	Иначе
		Элементы.СберСкрываемыйОстаток.МаксимальноеЗначение = Неопределено;
	КонецЕсли;
	
	Если АлиРежимСокрытияОстатков Тогда
		Элементы.АлиСкрываемыйОстаток.МаксимальноеЗначение = 100;
	Иначе
		Элементы.АлиСкрываемыйОстаток.МаксимальноеЗначение = Неопределено;
	КонецЕсли;

КонецПроцедуры //- ИнфоСофт Ивонин К.А. 18.10.23 УА #61108

