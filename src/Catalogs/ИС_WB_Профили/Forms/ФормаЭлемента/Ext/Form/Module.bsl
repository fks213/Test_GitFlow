//+ ИнфоСофт Ивонин К.А. 21.02.23 УА #53535
&НаКлиенте
Процедура РежимСозданияЗаказовПриИзменении(Элемент)

	//+ ИнфоСофт Макарова Н.Е. 01.04.2025 УА #77424
	Если Объект.РежимСозданияЗаказов = 2 Тогда
		
		Элементы.ИспользоватьРазбиениеПоСкладамВБ.Видимость = Истина;
		
		Если НЕ Объект.ИспользоватьРазбиениеПоСкладам Тогда
			Элементы.АктивныйЗаказКлиента.Видимость = Истина;	
		Иначе
			Элементы.АктивныйЗаказКлиента.Видимость = Ложь;
		КонецЕсли;
		//+ ИнфоСофт Стояк Ю.К. 13.11.2023 УА #62353		
		Если Объект.АвтоматическиДобавлятьВПоставку Тогда  
			Элементы.Поставка.Видимость = Истина;
			Элементы.ПоставкаКГТ.Видимость = Истина;
		КонецЕсли;                                  
		//- ИнфоСофт Стояк Ю.К. 13.11.2023 УА #62353
	Иначе
		Элементы.ИспользоватьРазбиениеПоСкладамВБ.Видимость = Ложь;
		Элементы.АктивныйЗаказКлиента.Видимость = Ложь;
		//+ ИнфоСофт Стояк Ю.К. 13.11.2023 УА #62353
		Элементы.Поставка.Видимость = Ложь;
		Элементы.ПоставкаКГТ.Видимость = Ложь;
		//- ИнфоСофт Стояк Ю.К. 13.11.2023 УА #62353
	КонецЕсли;
	//- ИнфоСофт Макарова Н.Е. 01.04.2025 УА #77424  
	
	//+ ИнфоСофт Стояк Ю.К. 27.10.2023 УА #65146	
	Если РежимСозданияЗаказовOzon = 2 Тогда
		Элементы.ФормироватьЕдиныйЗаказБезРазбиенияOzon.Видимость = Истина;
		//+ ИнфоСофт Заварин К.В. 26.04.24 УА #74175
		Элементы.ЗакрытиеЗаказаПоДатеОтгрузкиOzon.Видимость = Истина;
		//- ИнфоСофт Заварин К.В. 26.04.24 УА #74175
		//+ ИнфоСофт Макарова Н.Е. 01.04.2025 УА #77424
		Элементы.ИспользоватьРазбиениеПоСкладамOzon.Видимость = Истина;
		//- ИнфоСофт Макарова Н.Е. 01.04.2025 УА #77424
	Иначе
		Элементы.ФормироватьЕдиныйЗаказБезРазбиенияOzon.Видимость = Ложь;
		//+ ИнфоСофт Заварин К.В. 26.04.24 УА #74175
		Элементы.ЗакрытиеЗаказаПоДатеОтгрузкиOzon.Видимость = Ложь;
		//- ИнфоСофт Заварин К.В. 26.04.24 УА #74175
		//+ ИнфоСофт Макарова Н.Е. 01.04.2025 УА #77424
		Элементы.ИспользоватьРазбиениеПоСкладамOzon.Видимость = Ложь;
		//- ИнфоСофт Макарова Н.Е. 01.04.2025 УА #77424
	КонецЕсли; 
	
	Если РежимСозданияЗаказовЯМ = 2 Тогда
		Элементы.ФормироватьЕдиныйЗаказБезРазбиенияЯМ.Видимость = Истина;
		//+ ИнфоСофт Заварин К.В. 26.04.24 УА #74175
		Элементы.ЗакрытиеЗаказаПоДатеОтгрузкиЯМ.Видимость = Истина;
		//- ИнфоСофт Заварин К.В. 26.04.24 УА #74175
		//+ ИнфоСофт Макарова Н.Е. 01.04.2025 УА #77424
		Элементы.ИспользоватьРазбиениеПоСкладамЯМ.Видимость = Истина;
		//- ИнфоСофт Макарова Н.Е. 01.04.2025 УА #77424
	Иначе
		Элементы.ФормироватьЕдиныйЗаказБезРазбиенияЯМ.Видимость = Ложь;
		//+ ИнфоСофт Заварин К.В. 26.04.24 УА #74175
		Элементы.ЗакрытиеЗаказаПоДатеОтгрузкиЯМ.Видимость = Ложь;
		//- ИнфоСофт Заварин К.В. 26.04.24 УА #74175
		//+ ИнфоСофт Макарова Н.Е. 01.04.2025 УА #77424
		Элементы.ИспользоватьРазбиениеПоСкладамЯМ.Видимость = Ложь;
		//- ИнфоСофт Макарова Н.Е. 01.04.2025 УА #77424
	КонецЕсли; 
	
	Если РежимСозданияЗаказовАли = 2 Тогда
		Элементы.ФормироватьЕдиныйЗаказБезРазбиенияАли.Видимость = Истина;
	Иначе
		Элементы.ФормироватьЕдиныйЗаказБезРазбиенияАли.Видимость = Ложь; 
	КонецЕсли;
	//- ИнфоСофт Стояк Ю.К. 27.10.2023 УА #65146
	
	//+ ИнфоСофт Стояк Ю.К. 09.04.2024 УА #73643
	Если СберРежимСозданияЗаказов = 2 Тогда 
		
		Элементы.СберФормироватьЕдиныйЗаказБезРазбиения.Видимость = Истина; 
		//+ ИнфоСофт Заварин К.В. 26.04.24 УА #74175
		Элементы.СберЗакрытиеЗаказаПоДатеОтгрузки.Видимость = Истина;
		//- ИнфоСофт Заварин К.В. 26.04.24 УА #74175
		Если СберФормироватьЕдиныйЗаказБезРазбиения Тогда
			Элементы.СберАктивныйЗаказКлиента.Видимость = Истина;
		Иначе
			Элементы.СберАктивныйЗаказКлиента.Видимость = Ложь; 
		КонецЕсли; 
		
	Иначе
		Элементы.СберФормироватьЕдиныйЗаказБезРазбиения.Видимость = Ложь;
		//+ ИнфоСофт Заварин К.В. 26.04.24 УА #74175
		Элементы.СберЗакрытиеЗаказаПоДатеОтгрузки.Видимость = Ложь;
		//- ИнфоСофт Заварин К.В. 26.04.24 УА #74175
	КонецЕсли;	
	//- ИнфоСофт Стояк Ю.К. 09.04.2024 УА #73643
	
КонецПроцедуры //- ИнфоСофт Ивонин К.А. 21.02.23 УА #53535

