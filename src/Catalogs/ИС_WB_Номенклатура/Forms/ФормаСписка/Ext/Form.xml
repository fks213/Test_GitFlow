			<ShowTitle>false</ShowTitle>
			<ExtendedTooltip name="ГруппаОборачиваемостьРасширеннаяПодсказка" id="53"/>
			<ChildItems>
				<LabelDecoration name="ОборачиваемостьПодсказка" id="47">
					<Title formatted="false">
						<v8:item>
							<v8:lang>ru</v8:lang>
							<v8:content>Что такое оборачиваемость</v8:content>
						</v8:item>
					</Title>
					<ToolTipRepresentation>Button</ToolTipRepresentation>
					<ContextMenu name="ОборачиваемостьПодсказкаКонтекстноеМеню" id="48"/>
					<ExtendedTooltip name="ОборачиваемостьПодсказкаРасширеннаяПодсказка" id="49">
						<Title formatted="true">
							<v8:item>
								<v8:lang>ru</v8:lang>
								<v8:content>&lt;fontsize 12&gt;&lt;bgcolor #ffffe9&gt;&lt;color #000000&gt;Оборачиваемость – это тот период времени, за который продаётся средний запас товара, находящегося на складе. Чем ниже оборачиваемость в днях, тем за меньшее время средний остаток товара реализуется, тем лучше этот показатель.&lt;/&gt;&lt;/&gt;&lt;/&gt;

&lt;fontsize 12&gt;&lt;bgcolor #ffffe9&gt;&lt;color #ff0000&gt;500 и более н&lt;/&gt;&lt;/&gt;&lt;/&gt;&lt;fontsize 12&gt;&lt;bgcolor #ffffe9&gt;&lt;color #ff0000&gt;еликвид &lt;/&gt;&lt;/&gt;&lt;/&gt;&lt;fontsize 12&gt;&lt;bgcolor #ffffe9&gt;&lt;color #ff0000&gt;100%&lt;/&gt;&lt;/&gt;&lt;/&gt;&lt;font Almarai&gt;&lt;fontsize 12&gt;&lt;bgcolor #ffffe9&gt;&lt;color #000000&gt;   &lt;/&gt;&lt;/&gt;&lt;/&gt;&lt;/&gt;
&lt;font Almarai&gt;&lt;fontsize 12&gt;&lt;bgcolor #ffffe9&gt;&lt;color #000000&gt;предоставить максимальную скидку от 70% до 95%, везти   только хорошооборачиваемые топ-позиции&lt;/&gt;&lt;/&gt;&lt;/&gt;&lt;/&gt;
&lt;font Almarai&gt;&lt;fontsize 12&gt;&lt;bgcolor #ffffe9&gt;&lt;color #000000&gt;  &lt;/&gt;&lt;/&gt;&lt;/&gt;&lt;/&gt;&lt;font Almarai&gt;&lt;fontsize 12&gt;&lt;bgcolor #ffffe9&gt;&lt;color #000000&gt;  &lt;/&gt;&lt;/&gt;&lt;/&gt;&lt;/&gt;&lt;font Almarai&gt;&lt;fontsize 12&gt;&lt;bgcolor #ffffe9&gt;&lt;color #000000&gt;   &lt;/&gt;&lt;/&gt;&lt;/&gt;&lt;/&gt;
&lt;font Almarai&gt;&lt;fontsize 12&gt;&lt;bgcolor #ffffe9&gt;&lt;color #833c0b&gt;300 - 499 &lt;/&gt;&lt;/&gt;&lt;/&gt;&lt;/&gt;&lt;font Almarai&gt;&lt;fontsize 12&gt;&lt;bgcolor #ffffe9&gt;&lt;color #833c0b&gt;неликвид  &lt;/&gt;&lt;/&gt;&lt;/&gt;&lt;/&gt;&lt;font Almarai&gt;&lt;fontsize 12&gt;&lt;bgcolor #ffffe9&gt;&lt;color #833c0b&gt;80%&lt;/&gt;&lt;/&gt;&lt;/&gt;&lt;/&gt;
&lt;font Almarai&gt;&lt;fontsize 12&gt;&lt;bgcolor #ffffe9&gt;&lt;color #000000&gt;предоставить максимально выгодное предложение Клиенту   (скидки примерно до 80-90%), распродать старый и неликвидный товар, везти   только хорошооборачиваемые топ-позиции&lt;/&gt;&lt;/&gt;&lt;/&gt;&lt;/&gt;
&lt;font Almarai&gt;&lt;fontsize 12&gt;&lt;bgcolor #ffffe9&gt;&lt;color #000000&gt;  &lt;/&gt;&lt;/&gt;&lt;/&gt;&lt;/&gt;&lt;font Almarai&gt;&lt;fontsize 12&gt;&lt;bgcolor #ffffe9&gt;&lt;color #000000&gt;  &lt;/&gt;&lt;/&gt;&lt;/&gt;&lt;/&gt;&lt;font Almarai&gt;&lt;fontsize 12&gt;&lt;bgcolor #ffffe9&gt;&lt;color #000000&gt;   &lt;/&gt;&lt;/&gt;&lt;/&gt;&lt;/&gt;&lt;font Almarai&gt;&lt;fontsize 12&gt;&lt;bgcolor #ffffe9&gt;&lt;color #000000&gt;   &lt;/&gt;&lt;/&gt;&lt;/&gt;&lt;/&gt;
&lt;font Almarai&gt;&lt;fontsize 12&gt;&lt;bgcolor #ffffe9&gt;&lt;color #9f853e&gt;180 - 299 &lt;/&gt;&lt;/&gt;&lt;/&gt;&lt;/&gt;&lt;font Almarai&gt;&lt;fontsize 12&gt;&lt;bgcolor #ffffe9&gt;&lt;color #9f853e&gt;неактуальный товар &lt;/&gt;&lt;/&gt;&lt;/&gt;&lt;/&gt;&lt;font Almarai&gt;&lt;fontsize 12&gt;&lt;bgcolor #ffffe9&gt;&lt;color #9f853e&gt;100%&lt;/&gt;&lt;/&gt;&lt;/&gt;&lt;/&gt;&lt;font Almarai&gt;&lt;fontsize 12&gt;&lt;bgcolor #ffffe9&gt;&lt;color #9f853e&gt;   &lt;/&gt;&lt;/&gt;&lt;/&gt;&lt;/&gt;
&lt;font Almarai&gt;&lt;fontsize 12&gt;&lt;bgcolor #ffffe9&gt;&lt;color #000000&gt;предоставить еще большие скидки (до 70%), участвовать в   акциях и маркетинге&lt;/&gt;&lt;/&gt;&lt;/&gt;&lt;/&gt;
&lt;font Almarai&gt;&lt;fontsize 12&gt;&lt;bgcolor #ffffe9&gt;&lt;color #000000&gt;  &lt;/&gt;&lt;/&gt;&lt;/&gt;&lt;/&gt;&lt;font Almarai&gt;&lt;fontsize 12&gt;&lt;bgcolor #ffffe9&gt;&lt;color #000000&gt;  &lt;/&gt;&lt;/&gt;&lt;/&gt;&lt;/&gt;&lt;font Almarai&gt;&lt;fontsize 12&gt;&lt;bgcolor #ffffe9&gt;&lt;color #000000&gt;   &lt;/&gt;&lt;/&gt;&lt;/&gt;&lt;/&gt;
&lt;font Almarai&gt;&lt;fontsize 12&gt;&lt;bgcolor #ffffe9&gt;&lt;color #ae9e43&gt;120 - 179 &lt;/&gt;&lt;/&gt;&lt;/&gt;&lt;/&gt;&lt;font Almarai&gt;&lt;fontsize 12&gt;&lt;bgcolor #ffffe9&gt;&lt;color #ae9e43&gt;неактуальный товар &lt;/&gt;&lt;/&gt;&lt;/&gt;&lt;/&gt;&lt;font Almarai&gt;&lt;fontsize 12&gt;&lt;bgcolor #ffffe9&gt;&lt;color #ae9e43&gt;80%&lt;/&gt;&lt;/&gt;&lt;/&gt;&lt;/&gt;&lt;font Almarai&gt;&lt;fontsize 12&gt;&lt;bgcolor #ffffe9&gt;&lt;color #000000&gt;   &lt;/&gt;&lt;/&gt;&lt;/&gt;&lt;/&gt;
&lt;font Almarai&gt;&lt;fontsize 12&gt;&lt;bgcolor #ffffe9&gt;&lt;color #000000&gt;усилить предложение по скидкам, расширив их на весь   ассортимент, распродать старый и неликвидный товар, участвовать в   маркетинговых активностях, везти только топ-позиции&lt;/&gt;&lt;/&gt;&lt;/&gt;&lt;/&gt;
&lt;font Almarai&gt;&lt;fontsize 12&gt;&lt;bgcolor #ffffe9&gt;&lt;color #000000&gt;  &lt;/&gt;&lt;/&gt;&lt;/&gt;&lt;/&gt;&lt;font Almarai&gt;&lt;fontsize 12&gt;&lt;bgcolor #ffffe9&gt;&lt;color #000000&gt;  &lt;/&gt;&lt;/&gt;&lt;/&gt;&lt;/&gt;&lt;font Almarai&gt;&lt;fontsize 12&gt;&lt;bgcolor #ffffe9&gt;&lt;color #000000&gt;   &lt;/&gt;&lt;/&gt;&lt;/&gt;&lt;/&gt;&lt;font Almarai&gt;&lt;fontsize 12&gt;&lt;bgcolor #ffffe9&gt;&lt;color #000000&gt;   &lt;/&gt;&lt;/&gt;&lt;/&gt;&lt;/&gt;
&lt;font Almarai&gt;&lt;fontsize 12&gt;&lt;bgcolor #ffffe9&gt;&lt;color #89b516&gt;80 - 119 &lt;/&gt;&lt;/&gt;&lt;/&gt;&lt;/&gt;&lt;font Almarai&gt;&lt;fontsize 12&gt;&lt;bgcolor #ffffe9&gt;&lt;color #89b516&gt;дефицит &lt;/&gt;&lt;/&gt;&lt;/&gt;&lt;/&gt;&lt;font Almarai&gt;&lt;fontsize 12&gt;&lt;bgcolor #ffffe9&gt;&lt;color #89b516&gt;70%&lt;/&gt;&lt;/&gt;&lt;/&gt;&lt;/&gt;&lt;font Almarai&gt;&lt;fontsize 12&gt;&lt;bgcolor #ffffe9&gt;&lt;color #000000&gt;   &lt;/&gt;&lt;/&gt;&lt;/&gt;&lt;/&gt;
&lt;font Almarai&gt;&lt;fontsize 12&gt;&lt;bgcolor #ffffe9&gt;&lt;color #000000&gt;распродать старый/неликвидный товар путем предоставления   дисконта, завозить только хорошооборачиваемый + новинки /"сильных"   групп, участвовать в маркетинговых активностях&lt;/&gt;&lt;/&gt;&lt;/&gt;&lt;/&gt;&lt;font Almarai&gt;&lt;fontsize 12&gt;&lt;bgcolor #ffffe9&gt;&lt;color #000000&gt;  &lt;/&gt;&lt;/&gt;&lt;/&gt;&lt;/&gt;

&lt;font Almarai&gt;&lt;fontsize 12&gt;&lt;bgcolor #ffffe9&gt;&lt;color #1faa12&gt;60 - 79  рекомендуемый показатель&lt;/&gt;&lt;/&gt;&lt;/&gt;&lt;/&gt;&lt;font Almarai&gt;&lt;fontsize 12&gt;&lt;bgcolor #ffffe9&gt;&lt;color #1faa12&gt;   &lt;/&gt;&lt;/&gt;&lt;/&gt;&lt;/&gt;&lt;font Almarai&gt;&lt;fontsize 12&gt;&lt;bgcolor #ffffe9&gt;&lt;color #1faa12&gt; &lt;/&gt;&lt;/&gt;&lt;/&gt;&lt;/&gt;&lt;font Almarai&gt;&lt;fontsize 12&gt;&lt;bgcolor #ffffe9&gt;&lt;color #000000&gt;  &lt;/&gt;&lt;/&gt;&lt;/&gt;&lt;/&gt;
&lt;font Almarai&gt;&lt;fontsize 12&gt;&lt;bgcolor #ffffe9&gt;&lt;color #000000&gt;распродать старый/неликвидный товар путем предоставления   дисконта, завозить только хорошооборачиваемый + новинки /"сильных"   групп, участвовать в маркетинговых активностях&lt;/&gt;&lt;/&gt;&lt;/&gt;&lt;/&gt;

&lt;font Almarai&gt;&lt;fontsize 12&gt;&lt;bgcolor #ffffe9&gt;&lt;color #89b516&gt;40 - 59 &lt;/&gt;&lt;/&gt;&lt;/&gt;&lt;/&gt;&lt;font Almarai&gt;&lt;fontsize 12&gt;&lt;bgcolor #ffffe9&gt;&lt;color #89b516&gt;средний дефицит&lt;/&gt;&lt;/&gt;&lt;/&gt;&lt;/&gt;&lt;font Almarai&gt;&lt;fontsize 12&gt;&lt;bgcolor #ffffe9&gt;&lt;color #000000&gt;   &lt;/&gt;&lt;/&gt;&lt;/&gt;&lt;/&gt;
&lt;font Almarai&gt;&lt;fontsize 12&gt;&lt;bgcolor #ffffe9&gt;&lt;color #000000&gt;подсортировывать актуальные модели, завозить новинки&lt;/&gt;&lt;/&gt;&lt;/&gt;&lt;/&gt;
&lt;font Almarai&gt;&lt;fontsize 12&gt;&lt;bgcolor #ffffe9&gt;&lt;color #000000&gt;  &lt;/&gt;&lt;/&gt;&lt;/&gt;&lt;/&gt;&lt;font Almarai&gt;&lt;fontsize 12&gt;&lt;bgcolor #ffffe9&gt;&lt;color #000000&gt;  &lt;/&gt;&lt;/&gt;&lt;/&gt;&lt;/&gt;&lt;font Almarai&gt;&lt;fontsize 12&gt;&lt;bgcolor #ffffe9&gt;&lt;color #000000&gt;   &lt;/&gt;&lt;/&gt;&lt;/&gt;&lt;/&gt;
&lt;font Almarai&gt;&lt;fontsize 12&gt;&lt;bgcolor #ffffe9&gt;&lt;color #ae9e43&gt;1 - 39&lt;/&gt;&lt;/&gt;&lt;/&gt;&lt;/&gt;&lt;font Almarai&gt;&lt;fontsize 12&gt;&lt;bgcolor #ffffe9&gt;&lt;color #ae9e43&gt;  &lt;/&gt;&lt;/&gt;&lt;/&gt;&lt;/&gt;&lt;font Almarai&gt;&lt;fontsize 12&gt;&lt;bgcolor #ffffe9&gt;&lt;color #ae9e43&gt;сильный дефицит&lt;/&gt;&lt;/&gt;&lt;/&gt;&lt;/&gt;&lt;font Almarai&gt;&lt;fontsize 12&gt;&lt;bgcolor #ffffe9&gt;&lt;color #ae9e43&gt; &lt;/&gt;&lt;/&gt;&lt;/&gt;&lt;/&gt;&lt;font Almarai&gt;&lt;fontsize 12&gt;&lt;bgcolor #ffffe9&gt;&lt;color #000000&gt;  &lt;/&gt;&lt;/&gt;&lt;/&gt;&lt;/&gt;
&lt;font Almarai&gt;&lt;fontsize 12&gt;&lt;bgcolor #ffffe9&gt;&lt;color #000000&gt;усилить завоз новинок, топ-ы в глубину&lt;/&gt;&lt;/&gt;&lt;/&gt;&lt;/&gt;
&lt;font Almarai&gt;&lt;fontsize 12&gt;&lt;bgcolor #ffffe9&gt;&lt;color #000000&gt;  &lt;/&gt;&lt;/&gt;&lt;/&gt;&lt;/&gt;&lt;font Almarai&gt;&lt;fontsize 12&gt;&lt;bgcolor #ffffe9&gt;&lt;color #000000&gt; &lt;/&gt;&lt;/&gt;&lt;/&gt;&lt;/&gt;</v8:content>
							</v8:item>
						</Title>
					</ExtendedTooltip>
