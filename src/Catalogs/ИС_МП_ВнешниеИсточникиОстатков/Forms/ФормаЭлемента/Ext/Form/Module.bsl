#Область СлужебныеПроцедурыИФункции
  
//+ ИнфоСофт Ивонин К.А. 23.07.24 УА #77582
&НаСервере
Процедура ИнициализироватьРегламентыеОперации()
	
	СписокРегламентныхЗаданий = ИС_МП_УправлениеОстатками.СписокРегламентныхЗаданий();
	
	ДобавляемыеРеквизиты = Новый Массив;
	
	Для Каждого Задание Из СписокРегламентныхЗаданий Цикл
		ДобавитьРеквизитРегламентнойОперации(Задание, ДобавляемыеРеквизиты);
	КонецЦикла;
	
	ИзменитьРеквизиты(ДобавляемыеРеквизиты);
	
	Для Каждого Задание Из СписокРегламентныхЗаданий Цикл
		ДобавитьЭлементыРегламентнойОперации(Задание);
	КонецЦикла;
		
КонецПроцедуры //- ИнфоСофт Ивонин К.А. 23.07.24 УА #77582

//+ ИнфоСофт Ивонин К.А. 23.07.24 УА #77582
&НаСервере
Процедура ДобавитьРеквизитРегламентнойОперации(СтруктураРеквизита, ДобавляемыеРеквизиты)
	
	НовыйРеквизит = Новый РеквизитФормы(СтруктураРеквизита.Ключ, 
		Новый ОписаниеТипов("Булево"), , СтруктураРеквизита.Значение);	
	
	ДобавляемыеРеквизиты.Добавить(НовыйРеквизит);

КонецПроцедуры //- ИнфоСофт Ивонин К.А. 23.07.24 УА #77582

//+ ИнфоСофт Ивонин К.А. 23.07.24 УА #77582
&НаСервере   
Процедура ДобавитьЭлементыРегламентнойОперации(СтруктураЭлемента)
    
    Имя = СтруктураЭлемента.Ключ;
    
    ГруппаФормы = Элементы.Добавить("Группа" + Имя, Тип("ГруппаФормы"), Элементы["ГруппаРегламентныеОперации"]); 
    ГруппаФормы.Вид = ВидГруппыФормы.ОбычнаяГруппа;
    ГруппаФормы.Объединенная = Ложь;
    ГруппаФормы.ОтображатьЗаголовок = Ложь;
    
	ЭлементФормы = Элементы.Добавить(Имя, Тип("ПолеФормы"), ГруппаФормы);        
	ЭлементФормы.Вид = ВидПоляФормы.ПолеФлажка;
	ЭлементФормы.ВидФлажка = ВидФлажка.Выключатель;
	ЭлементФормы.ПоложениеЗаголовка = ПоложениеЗаголовкаЭлементаФормы.Право;
	ЭлементФормы.ПутьКДанным = Имя;
	ЭлементФормы.УстановитьДействие("ПриИзменении", "РегламентнаяОперацияПриИзменении");
	
	ЭлементФормы = Элементы.Добавить("Расписание" + Имя, Тип("ДекорацияФормы"), ГруппаФормы);        
	ЭлементФормы.Вид = ВидДекорацииФормы.Надпись;
	ЭлементФормы.Гиперссылка = Истина;
	ЭлементФормы.Заголовок = "Настроить расписание";
	ЭлементФормы.Видимость = Ложь;
	ЭлементФормы.УстановитьДействие("Нажатие", "РасписанияНажатие");
    
	РегламентноеЗаданиеGUID = 
		ИС_MP_РаботаСРегламентнымиЗаданиями.ПолучитьGUIDЗадания(Объект.Ссылка, СтруктураЭлемента.Ключ);
	
	УстановитьПривилегированныйРежим(Истина);

	Задание = РегламентныеЗадания.НайтиПоУникальномуИдентификатору(РегламентноеЗаданиеGUID);
	
	УстановитьПривилегированныйРежим(Ложь);
	
	Если Задание = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ЭлементФормы = Элементы["Расписание" + Имя];
	
	ЭтотОбъект[Имя] = Задание.Использование;
	
	Если ЭтотОбъект[Имя] Тогда
		ЭлементФормы.Видимость = Истина;
		ЭлементФормы.Заголовок = Задание.Расписание;
	КонецЕсли;
	
	Если Задание.ПоследнееЗадание <> Неопределено Тогда
		
		ЭлементФормы = Элементы.Добавить("Дата" + Имя, Тип("ДекорацияФормы"), ГруппаФормы);        
		ЭлементФормы.Вид = ВидДекорацииФормы.Надпись;
		ЭлементФормы.Заголовок = Задание.ПоследнееЗадание.Конец;
		
		ЭлементФормы = Элементы.Добавить("Состояние" + Имя, Тип("ДекорацияФормы"), ГруппаФормы);        
		ЭлементФормы.Вид = ВидДекорацииФормы.Картинка;
		
		Если Задание.ПоследнееЗадание.Состояние = СостояниеФоновогоЗадания.Активно Тогда
			ЭлементФормы.Картинка = БиблиотекаКартинок.ОформлениеКругЗаполненный;
		ИначеЕсли Задание.ПоследнееЗадание.Состояние = СостояниеФоновогоЗадания.Завершено Тогда
			ЭлементФормы.Картинка = БиблиотекаКартинок.ОформлениеКругЗеленый;
		ИначеЕсли Задание.ПоследнееЗадание.Состояние = СостояниеФоновогоЗадания.ЗавершеноАварийно Тогда
			ЭлементФормы.Картинка = БиблиотекаКартинок.ОформлениеКругКрасный;
		Иначе
			ЭлементФормы.Картинка = БиблиотекаКартинок.ОформлениеКругЖелтый;
		КонецЕсли;
			
	КонецЕсли; 
	
КонецПроцедуры //- ИнфоСофт Ивонин К.А. 23.07.24 УА #77582

//+ ИнфоСофт Ивонин К.А. 23.07.24 УА #77582
&НаСервере   
Функция ПолучитьФайлXlsx()

	ПараметрыЗапроса = ИС_MP_РаботаСHTTPЗапросамиСервер.ПолучитьСтруктуруHTTPЗапроса();
    ЗаполнитьЗначенияСвойств(ПараметрыЗапроса,
    	ИС_MP_РаботаСHTTPЗапросамиСервер.РазобратьURLНаПараметрыЗапроса(Объект.АдресСервиса));
    
	ПараметрыЗапроса.Вставить("ФорматОтвета", "ДвоичныеДанные");
	
	РезультатЗапроса = ИС_MP_РаботаСHTTPЗапросамиСервер.ОтправитьGETЗапрос(ПараметрыЗапроса);
		
	Если РезультатЗапроса.ЕстьОшибки Тогда
		Текст = СтрШаблон("Произошла ошибка при отправке запроса: %1",	РезультатЗапроса.ИнформацияОбОшибке.Описание);
		ОбщегоНазначения.СообщитьПользователю(Текст); 	
	Иначе
	
		Если РезультатЗапроса.КодОтвета = 200 Тогда
            
            Адрес = ПоместитьВоВременноеХранилище(РезультатЗапроса.Ответ);   
			
		ИначеЕсли РезультатЗапроса.КодОтвета = 400 Тогда
             
            Текст = СтрШаблон("Неверная форма запроса: %1", РезультатЗапроса.Ответ); 
      		ОбщегоНазначения.СообщитьПользователю(Текст);
	      					
		Иначе
			Текст = СтрШаблон("Произошла неизвестная ошибка, код ответа: %1, ошибка: %2", 
				РезультатЗапроса.КодОтвета, РезультатЗапроса.Ответ);			
			ОбщегоНазначения.СообщитьПользователю(Текст);	
				
		КонецЕсли;
			
	КонецЕсли;
	
	Если Адрес = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;  
	
	Возврат Адрес;
	
КонецФункции //- ИнфоСофт Ивонин К.А. 23.07.24 УА #77582

//+ ИнфоСофт Ивонин К.А. 23.07.24 УА #77582
&НаСервере
Функция ПолучитьТабличныйДокумент()

    Адрес = ПолучитьФайлXlsx();
    
    Если Адрес = Неопределено Тогда 
    	Возврат Неопределено;
    КонецЕсли;
	
	ФайлВременногоХранилища = ПолучитьИзВременногоХранилища(Адрес);
	Имя = ПолучитьИмяВременногоФайла("xlsx");
	ФайлВременногоХранилища.Записать(Имя);
	
	ТабличныйДокумент = Новый ТабличныйДокумент;
	ТабличныйДокумент.Прочитать(Имя);
	
	Попытка
		УдалитьФайлы(Имя);
	Исключение
		// Действие не требуется
	КонецПопытки;
	
	ТабличныйДокумент.Область().Разъединить();
	
	Возврат ТабличныйДокумент;
		 
КонецФункции //- ИнфоСофт Ивонин К.А. 23.07.24 УА #77582

//+ ИнфоСофт Ивонин К.А. 23.07.24 УА #77582
&НаСервере
Процедура ПолучитьЗначенияКолонокНаСервере()
    
    Элементы.ПолеСопоставления.КнопкаВыпадающегоСписка = Ложь;
    Элементы.ПолеСопоставления.СписокВыбора.Очистить();
    
    Элементы.ПолеОстатка.КнопкаВыпадающегоСписка = Ложь;
    Элементы.ПолеОстатка.СписокВыбора.Очистить();
    
    Элементы.ПолеЦены.КнопкаВыпадающегоСписка = Ложь;
    Элементы.ПолеЦены.СписокВыбора.Очистить();
    
    Адрес = ПолучитьФайлXlsx();
    
    Если Адрес = Неопределено Тогда 
    	Возврат;
    КонецЕсли;
	
	ПараметрыТаблицы = Новый Структура;
	ПараметрыТаблицы.Вставить("ПерваяСтрока", Объект.ПерваяСтрока);
	ПараметрыТаблицы.Вставить("ПерваяКолонка", Объект.ПерваяКолонка);
	ПараметрыТаблицы.Вставить("ПоследняяСтрока", Объект.ПоследняяСтрока);
	ПараметрыТаблицы.Вставить("ПоследняяКолонка", Объект.ПоследняяКолонка);
    
    Результат = ИС_MP_Сервер.ПолучитьТаблицуЗначенийИзExcel(Адрес, ПараметрыТаблицы);
    
    Если Результат = Неопределено Тогда 
    	Возврат;
    КонецЕсли;
    
	Элементы.ПолеСопоставления.КнопкаВыпадающегоСписка = Истина;
	Элементы.ПолеОстатка.КнопкаВыпадающегоСписка = Истина;   
	Элементы.ПолеЦены.КнопкаВыпадающегоСписка = Истина;
        
    Для Каждого Элемент Из Результат.Колонки Цикл 
    	Элементы.ПолеСопоставления.СписокВыбора.Добавить(Элемент.Имя);
    	Элементы.ПолеОстатка.СписокВыбора.Добавить(Элемент.Имя);
    	Элементы.ПолеЦены.СписокВыбора.Добавить(Элемент.Имя);
    КонецЦикла;
    
КонецПроцедуры //- ИнфоСофт Ивонин К.А. 23.07.24 УА #77582

