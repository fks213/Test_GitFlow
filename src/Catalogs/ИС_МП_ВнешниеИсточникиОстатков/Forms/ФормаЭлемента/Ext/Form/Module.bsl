&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Если Не ЗначениеЗаполнено(Объект.ФорматДанных) Тогда
		Объект.ФорматДанных = "xlsx";
	КонецЕсли; 
	
	Если Не ЗначениеЗаполнено(Объект.СопоставлятьПо) Тогда
		Объект.СопоставлятьПо = "Баркод";
	КонецЕсли;
	
	ИнициализироватьРегламентыеОперации();
	
КонецПроцедуры //- ИнфоСофт Ивонин К.А. 23.07.24 УА #77582

//+ ИнфоСофт Ивонин К.А. 22.01.23 УА #53535
&НаКлиенте
Процедура РегламентнаяОперацияПриИзменении(Элемент)

	ИдентификаторКоманды = Элемент.Имя;	
	
	ИзменитьРеглЗаданиеНаСервере(Объект.Ссылка, ИдентификаторКоманды, ЭтотОбъект[ИдентификаторКоманды]);
	
