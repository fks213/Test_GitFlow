//+ ИнфоСофт Ивонин К.А. 22.01.23 УА #53535
&НаКлиенте
Процедура УстановитьРасписание(ИдентификаторКоманды) 
	
	РегламентноеЗаданиеGUID = 
		ИС_MP_РаботаСРегламентнымиЗаданиями.ПолучитьGUIDЗадания(Объект.Ссылка, ИдентификаторКоманды);
	Расписание = ПолучитьРасписаниеВыгрузки(РегламентноеЗаданиеGUID);
	
	ДопПараметры = Новый Структура;
	ДопПараметры.Вставить("ИдентификаторКоманды", ИдентификаторКоманды);
	ДопПараметры.Вставить("РегламентноеЗаданиеGUID", РегламентноеЗаданиеGUID);
	
	ОписаниеОповещения = Новый ОписаниеОповещения("ПослеИзмененияРасписания", ЭтотОбъект, ДопПараметры);
				
	ДиалогРасписания = Новый ДиалогРасписанияРегламентногоЗадания(Расписание);
	ДиалогРасписания.Показать(ОписаниеОповещения);
	
КонецПроцедуры //- ИнфоСофт Ивонин К.А. 22.01.23 УА #53535

//+ ИнфоСофт Ивонин К.А. 22.01.23 УА #53535
&НаСервереБезКонтекста
Функция ПолучитьРасписаниеВыгрузки(РегламентноеЗаданиеGUID) 

	УстановитьПривилегированныйРежим(Истина);
		
	Расписание = Новый РасписаниеРегламентногоЗадания;
	РегламентноеЗадание = РегламентныеЗадания.НайтиПоУникальномуИдентификатору(РегламентноеЗаданиеGUID);
	
	Если РегламентноеЗадание <> Неопределено Тогда
		Расписание = РегламентноеЗадание.Расписание;
	КонецЕсли;
	
	Возврат Расписание;
	
	УстановитьПривилегированныйРежим(Ложь);
	
КонецФункции //- ИнфоСофт Ивонин К.А. 22.01.23 УА #53535

//+ ИнфоСофт Ивонин К.А. 22.01.23 УА #53535
&НаКлиенте
Процедура ПослеИзмененияРасписания(Расписание, ДопПараметры) Экспорт
	
	Если Расписание = Неопределено Тогда 
		Возврат;
	КонецЕсли;
	
	Представление = ИзменитьРасписание(ДопПараметры.РегламентноеЗаданиеGUID, Расписание);
	
	ЭлементФормы = Элементы["Расписание" + ДопПараметры.ИдентификаторКоманды];
	ЭлементФормы.Заголовок = Представление;
	
КонецПроцедуры //- ИнфоСофт Ивонин К.А. 22.01.23 УА #53535

//+ ИнфоСофт Ивонин К.А. 22.01.23 УА #53535
&НаСервереБезКонтекста
Функция ИзменитьРасписание(РегламентноеЗаданиеGUID, Расписание) 
	
	Представление = ИС_MP_РаботаСРегламентнымиЗаданиями.ИзменитьРасписание(РегламентноеЗаданиеGUID, Расписание);
	
	Возврат Представление;
	
КонецФункции //- ИнфоСофт Ивонин К.А. 22.01.23 УА #53535

