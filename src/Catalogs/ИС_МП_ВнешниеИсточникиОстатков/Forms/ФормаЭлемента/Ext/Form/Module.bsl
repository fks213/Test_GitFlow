//+ ИнфоСофт Ивонин К.А. 23.07.24 УА #77582
&НаКлиенте
Процедура Предпросмотр(Команда)

	ТабДок = ПолучитьТабличныйДокумент();
	
	Если ТабДок = Неопределено Тогда
		Возврат;
	КонецЕсли;

    КоллекцияПечатныхФорм = УправлениеПечатьюКлиент.НоваяКоллекцияПечатныхФорм("ПредпросмотрXlsx");    
